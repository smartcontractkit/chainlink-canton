-- | Daml Script setup for the test/demo coin package.
-- This package exercises Token Standard flows in tests and local development;
-- it is not the production token implementation used by CCIP deployments.
module Main where

import Daml.Script

import Splice.Api.Token.HoldingV1
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV1
import Splice.Api.Token.BurnMintV1

import DA.TextMap qualified as TextMap
import DA.Optional

import Coin.Registry

setup = script do
    issuer <- allocateParty "issuer"
    alice <- allocateParty "alice"
    bob <- allocateParty "bob"
    charlie <- allocateParty "charlie"
    mindy <- allocateParty "mindy"

    let instrumentId = InstrumentId {
        admin = issuer,
        id = "LINK"
    }

    -- Create Registry
    registry <- submit issuer do
        -- toInterfaceContractId @BurnMintFactory <$>
        createCmd CoinRegistry with
            issuer = issuer
            instrumentId = instrumentId
            instanceId = "main-registry"
            meta = emptyMetadata

    -- query the contract disclosure to allow parties to interact with the registry without being observers
    disclosedRegistry <- fromSome <$> queryDisclosure issuer registry

    -- alice creates MintPreapproval
    alicePreApproval <- submit alice do
        createCmd MintPreapproval with
            sender = issuer
            receiver = alice

    -- mint to alice
    bmResult <- submit issuer do
        exerciseCmd (toInterfaceContractId @BurnMintFactory registry) BurnMintFactory_BurnMint with
            expectedAdmin = issuer
            instrumentId = instrumentId
            inputHoldingCids = []
            outputs = [
                BurnMintOutput {
                    owner = alice,
                    amount = 42.00,
                    context = ChoiceContext with -- add pre-approval cid to choice context
                        values = TextMap.fromList [(mintPreapprovalContextKey, AV_ContractId $ coerceContractId alicePreApproval)]
                }]
            extraActors = []
            extraArgs = ExtraArgs with
                context = emptyChoiceContext
                meta = emptyMetadata

    now <- getTime

    -- alice transfers part of their holdings to bob
    transferResult <- trySubmit (actAs alice <> disclose disclosedRegistry) do
        exerciseCmd (toInterfaceContractId @TransferFactory registry) TransferFactory_Transfer with
            expectedAdmin = issuer
            transfer = Splice.Api.Token.TransferInstructionV1.Transfer with
                sender = alice
                receiver = bob
                amount = 10.00
                instrumentId = instrumentId
                requestedAt = now
                executeBefore = now
                inputHoldingCids = bmResult.outputCids
                meta = emptyMetadata
            extraArgs = ExtraArgs with
                context = emptyChoiceContext
                meta = emptyMetadata
    Right transferResult <- pure transferResult

    -- bob accepts the pending transfer, thereby gaining access to the holdings
    TransferInstructionResult_Pending pendingTransferAtoB <- pure transferResult.output
    transferResult <- submit bob do
        exerciseCmd pendingTransferAtoB TransferInstruction_Accept with
            extraArgs = ExtraArgs with
                context = emptyChoiceContext
                meta = emptyMetadata

    -- bob tries to send more assets than they have available to charlie, should fail
    TransferInstructionResult_Completed bobHoldings <- pure transferResult.output
    transferResult <- submitMustFail (actAs bob <> disclose disclosedRegistry) do
        exerciseCmd (toInterfaceContractId @TransferFactory registry) TransferFactory_Transfer with
            expectedAdmin = issuer
            transfer = Splice.Api.Token.TransferInstructionV1.Transfer with
                sender = bob
                receiver = charlie
                amount = 100.00
                instrumentId = instrumentId
                requestedAt = now
                executeBefore = now
                inputHoldingCids = bobHoldings
                meta = emptyMetadata
            extraArgs = ExtraArgs with
                context = emptyChoiceContext
                meta = emptyMetadata

    -- issuer grants mint rights to mindy
    role <- submit issuer do
        createCmd MintRole with
            issuer = issuer
            minter = mindy
            registry = registry

    -- charlie creates MintPreapproval
    charliePreApproval <- submit charlie do
        createCmd MintPreapproval with
            sender = issuer
            receiver = charlie
    disclosedCharliePreapproval <- fromSome <$> queryDisclosure issuer charliePreApproval

    -- mindy uses the granted MintRole to mint to charlie
    result <- trySubmit (actAs mindy <> disclose disclosedRegistry <> disclose disclosedCharliePreapproval) do
        exerciseCmd role MintRole_Mint with
            instrumentId = instrumentId
            outputs = [
                BurnMintOutput {
                    owner = charlie,
                    amount = 77.77,
                    context = ChoiceContext with -- add pre-approval cid to choice context
                        values = TextMap.fromList [(mintPreapprovalContextKey, AV_ContractId $ coerceContractId charliePreApproval)]
                }]

    pure()
