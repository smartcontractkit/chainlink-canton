-- | Codec module for OffRamp MCMS parameter encoding/decoding
-- Used by the MCMSReceiver interface implementation to decode operationData
module CCIP.OffRampCodec
  ( encodeOffRampDeps
  , decodeOffRampDepsAt
  , encodeSetDepsParams
  , decodeSetDepsParams
  ) where

import CCIP.MCMSCodecUtils
  ( encodeRawInstanceAddress
  , decodeRawInstanceAddressAt
  )

import DA.Crypto.Text (BytesHex)
import CCIP.OffRampTypes (OffRampDeps(..))

-- ===========================================================================
-- DECODE FUNCTIONS (for MCMSReceiver entrypoint)
-- ===========================================================================

-- | Decode SetDeps params
-- Format: [OffRampDeps]
decodeSetDepsParams : BytesHex -> Optional OffRampDeps
decodeSetDepsParams encoded = do
  (deps, _) <- decodeOffRampDepsAt encoded 0
  Some deps

-- | Decode OffRampDeps at offset
-- Format: [RIA globalConfig][RIA rmnRemote][RIA tokenAdminRegistry]
decodeOffRampDepsAt : BytesHex -> Int -> Optional (OffRampDeps, Int)
decodeOffRampDepsAt encoded offset = do
  (globalConfig, offset1) <- decodeRawInstanceAddressAt encoded offset
  (rmnRemote, offset2) <- decodeRawInstanceAddressAt encoded offset1
  (tokenAdminRegistry, offset3) <- decodeRawInstanceAddressAt encoded offset2
  Some (OffRampDeps globalConfig rmnRemote tokenAdminRegistry, offset3)

-- ===========================================================================
-- ENCODE FUNCTIONS (for tests and Go integration)
-- ===========================================================================

-- | Encode SetDeps params
encodeSetDepsParams : OffRampDeps -> BytesHex
encodeSetDepsParams = encodeOffRampDeps

-- | Encode OffRampDeps
encodeOffRampDeps : OffRampDeps -> BytesHex
encodeOffRampDeps deps =
  encodeRawInstanceAddress deps.globalConfig <>
  encodeRawInstanceAddress deps.rmnRemote <>
  encodeRawInstanceAddress deps.tokenAdminRegistry
