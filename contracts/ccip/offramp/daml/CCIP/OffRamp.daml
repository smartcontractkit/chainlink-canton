-- | OffRamp for CCIP message execution, called by PerPartyRouter.
module CCIP.OffRamp where

import DA.Foldable qualified as Foldable
import DA.Crypto.Text (BytesHex, keccak256)
import DA.List (dedup, unique)
import DA.Map qualified as Map
import DA.Optional (fromOptional, fromSomeNote, isSome)

import qualified CCIP.Events
import qualified CCIP.ExecutingMessageV1
import qualified CCIP.GlobalConfig
import qualified CCIP.MessageCodecV1
import qualified CCIP.Context
import CCIP.RawInstanceAddress (RawInstanceAddress)
import qualified CCIP.RawInstanceAddress
import qualified CCIP.RMNRemote
import qualified CCIP.Tickets
import qualified CCIP.TokenAdminRegistry
import CCIP.Codec
  ( encodeRawInstanceAddress
  , decodeRawInstanceAddressAt
  , encodeOptionalRawInstanceAddress
  , decodeOptionalRawInstanceAddressAt
  )
import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiverView(..))

offRampKey : Text
offRampKey = "off-ramp"

lookupOffRampCid : CCIP.Context.CCIPContext -> Update (ContractId OffRamp)
lookupOffRampCid ctx = CCIP.Context.getFromContextU ctx offRampKey

rawInstanceAddress : OffRamp -> CCIP.RawInstanceAddress.RawInstanceAddress
rawInstanceAddress offRamp = CCIP.RawInstanceAddress.make offRamp.instanceId offRamp.ccipOwner

data OffRampDeps = OffRampDeps
    with
        globalConfig : RawInstanceAddress
        rmnRemote : RawInstanceAddress
        tokenAdminRegistry : RawInstanceAddress
    deriving (Eq, Show)

data SetDepsParams = SetDepsParams
    with
        globalConfig : Optional RawInstanceAddress
        rmnRemote : Optional RawInstanceAddress
        tokenAdminRegistry : Optional RawInstanceAddress
    deriving (Eq, Show)


-- | OffRamp contract for PerPartyRouter architecture.
template OffRamp
    with
        instanceId : Text
        ccipOwner : Party
        deps : OffRampDeps
    where
        signatory ccipOwner

        choice SetDeps : ContractId OffRamp
            with
                newDeps : SetDepsParams
            controller ccipOwner
            do
                let mergedDeps = OffRampDeps with
                        globalConfig = fromOptional deps.globalConfig newDeps.globalConfig
                        rmnRemote = fromOptional deps.rmnRemote newDeps.rmnRemote
                        tokenAdminRegistry = fromOptional deps.tokenAdminRegistry newDeps.tokenAdminRegistry
                create this with deps = mergedDeps

        -- | Get required CCV raw instance addresses for inbound message execution.
        -- Returns lane-mandated + receiver + default CCVs. Pool CCVs are handled
        -- separately via the pool → TAR → ExecutingMessageV1 path.
        -- TODO: this should return lane-mandated and default CCVs separately
        nonconsuming choice GetRequiredCCVsForExecute : [CCIP.RawInstanceAddress.RawInstanceAddress]
            with
                globalConfigCid : ContractId CCIP.GlobalConfig.GlobalConfig
                receiverRequiredCCVs : [CCIP.RawInstanceAddress.RawInstanceAddress]
                sourceChainSelector : Numeric 0
            controller ccipOwner
            do
                globalConfig <- fetch globalConfigCid
                CCIP.RawInstanceAddress.assertEqual "offramp: globalconfig instance address mismatch"
                    globalConfig.instanceId globalConfig.ccipOwner deps.globalConfig

                -- The receiver required CCVs are passed in and cannot contain duplicates
                assertMsg "DuplicateCCVNotAllowed: duplicate CCVs in receiver required CCVs" (unique receiverRequiredCCVs)

                -- Get lane-mandated CCVs from GlobalConfig
                sourceConfigOpt <- exercise globalConfigCid
                    CCIP.GlobalConfig.GetSourceChainConfig with
                        sourceChainSelector = sourceChainSelector
                        caller = ccipOwner
                let laneMandatedCCVs = case sourceConfigOpt of
                        None -> []
                        Some config -> config.laneMandatedCCVs

                -- Get default CCVs (if no other CCVs specified)
                let defaultCCVs = case sourceConfigOpt of
                        None -> []
                        Some config ->
                            if null laneMandatedCCVs && null receiverRequiredCCVs
                            then config.defaultCCVs
                            else []

                -- Combine and dedupe
                pure (dedup (laneMandatedCCVs ++ receiverRequiredCCVs ++ defaultCCVs))

        -- | Decode and validate an inbound message, creating an ExecutingMessageV1.
        -- Performs party address validation and RMN curse check.
        nonconsuming choice PrepareExecute : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
            with
                encodedMessage : BytesHex
                rmnRemoteCid : ContractId CCIP.RMNRemote.RMNRemote
                receiverParty : Party
                tokenReceiverParty : Optional Party
                caller : Party
            controller ccipOwner
            do
                -- Decode message
                let message = fromSomeNote "prepareExecute: failed to decode message"
                        (CCIP.MessageCodecV1.decodeMessageV1 encodedMessage)
                let messageId = keccak256 encodedMessage

                -- Validate receiver address matches provided party
                let expectedReceiverAddr = CCIP.MessageCodecV1.encodePartyAddress receiverParty
                assertMsg "prepareExecute: receiver address mismatch"
                    (message.receiver == expectedReceiverAddr)

                -- Resolve tokenReceiver: defaults to receiverParty if not provided
                let resolvedTokenReceiver = case (message.tokenTransfer, tokenReceiverParty) of
                        (Some _, Some trParty) -> Some trParty
                        (Some _, None) -> Some receiverParty
                        (None, _) -> None

                -- Validate tokenReceiver address if token transfer present
                case (message.tokenTransfer, resolvedTokenReceiver) of
                    (Some tt, Some trParty) ->
                        let expectedAddr = CCIP.MessageCodecV1.encodePartyAddress trParty
                        in assertMsg "prepareExecute: tokenReceiver address mismatch"
                            (tt.tokenReceiver == expectedAddr)
                    _ -> pure ()

                -- Validate RMN instance address and check curse
                rmnRemote <- fetch rmnRemoteCid
                CCIP.RawInstanceAddress.assertEqual "prepareExecute: rmn mismatch"
                    rmnRemote.instanceId rmnRemote.rmnOwner deps.rmnRemote
                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = ccipOwner
                    chainSelector = message.sourceChainSelector
                assertMsg "prepareExecute: source chain is cursed" (not isCursed)

                -- Build observer list
                let observers = CCIP.ExecutingMessageV1.buildObservingParties
                        receiverParty resolvedTokenReceiver caller

                create CCIP.ExecutingMessageV1.ExecutingMessageV1 with
                    ccipOwner = ccipOwner
                    message = message
                    messageId = messageId
                    receiver = receiverParty
                    tokenReceiver = resolvedTokenReceiver
                    executor = caller
                    observingParties = observers
                    ccvVerifications = []
                    ccvOwners = []
                    inboundPoolCCVs = None
                    deps = CCIP.ExecutingMessageV1.ExecutingMessageDeps with
                        offRamp = rawInstanceAddress this
                        globalConfig = deps.globalConfig
                        rmnRemote = deps.rmnRemote
                        tokenAdminRegistry = deps.tokenAdminRegistry
                    state = CCIP.ExecutingMessageV1.ExecutingMessageState_Prepared

        -- | Process a CCIP execute request from a PerPartyRouter.
        -- Reads CCV verifications and pool verification state from the ExecutingMessageV1
        -- collecting contract.
        nonconsuming choice ExecuteFromRouter : ExecuteFromRouterResult
            with
                routerPartyOwner : Party
                receiverRequiredCCVs : [CCIP.RawInstanceAddress.RawInstanceAddress]
                receiverMinBlockDepth : Int

                executingMessageCid : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1

                globalConfigCid : ContractId CCIP.GlobalConfig.GlobalConfig
                tokenAdminRegistryCid : ContractId CCIP.TokenAdminRegistry.TokenAdminRegistry
                rmnRemoteCid : ContractId CCIP.RMNRemote.RMNRemote

            controller ccipOwner
            do
                -- Fetch ExecutingMessageV1 (ccipOwner is signatory, always visible)
                execMsg <- fetch executingMessageCid
                let message = execMsg.message
                let messageId = execMsg.messageId

                -- Verify the ExecutingMessageV1 was created by this OffRamp's ccipOwner
                assertMsg "offramp: executingMessage ccipOwner mismatch"
                    (execMsg.ccipOwner == ccipOwner)
                CCIP.RawInstanceAddress.assertEqual "offramp: executingMessage offRamp mismatch"
                    instanceId ccipOwner execMsg.deps.offRamp
                assertMsg "offramp: executingMessage globalConfig mismatch"
                    (execMsg.deps.globalConfig == deps.globalConfig)
                assertMsg "offramp: executingMessage rmnRemote mismatch"
                    (execMsg.deps.rmnRemote == deps.rmnRemote)
                assertMsg "offramp: executingMessage tokenAdminRegistry mismatch"
                    (execMsg.deps.tokenAdminRegistry == deps.tokenAdminRegistry)

                -- Verify receiver matches router's party owner
                assertMsg "offramp: executingMessage receiver mismatch"
                    (execMsg.receiver == routerPartyOwner)

                -- Re-check RMN curse (PrepareExecute may not have been atomic with Execute)
                rmnRemote <- fetch rmnRemoteCid
                CCIP.RawInstanceAddress.assertEqual "offramp: rmn mismatch"
                    rmnRemote.instanceId rmnRemote.rmnOwner execMsg.deps.rmnRemote
                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = ccipOwner
                    chainSelector = message.sourceChainSelector
                assertMsg "offramp: source chain is cursed" (not isCursed)

                -- Validate dependency instance addresses
                globalConfig <- fetch globalConfigCid
                CCIP.RawInstanceAddress.assertEqual "offramp: globalconfig instance address mismatch"
                    globalConfig.instanceId globalConfig.ccipOwner execMsg.deps.globalConfig

                tokenAdminRegistry <- fetch tokenAdminRegistryCid
                CCIP.RawInstanceAddress.assertEqual "offramp: tokenadminregistry instance address mismatch"
                    tokenAdminRegistry.instanceId tokenAdminRegistry.owner execMsg.deps.tokenAdminRegistry

                sourceConfigOpt <- exercise globalConfigCid
                    CCIP.GlobalConfig.GetSourceChainConfig with
                        sourceChainSelector = message.sourceChainSelector
                        caller = ccipOwner
                sourceConfig <- case sourceConfigOpt of
                    None -> abort "offramp: unknown source chain"
                    Some c -> do
                        assertMsg "offramp: source chain disabled" c.isEnabled
                        assertMsg "offramp: invalid source onramp"
                            (message.onRampAddress `elem` c.onRampAddresses)
                        pure c

                -- The receiver required CCVs are passed in and cannot contain duplicates
                assertMsg "DuplicateCCVNotAllowed: duplicate CCVs in receiver required CCVs" (unique receiverRequiredCCVs)

                -- Get pool's declared CCV requirements from ExecutingMessageV1.
                -- Pool records these via SetInboundPoolCCVs; None means pool wasn't called.
                poolCCVs <- case execMsg.tokenReceiver of
                    None -> pure []
                    Some _ -> case execMsg.inboundPoolCCVs of
                        None -> abort "offramp: pool CCVs not set for token transfer"
                        Some ccvs -> pure ccvs

                -- Token-only: no message data, no receiver callback gas limit,
                -- but has a token transfer. A no-op (no data, no token) falls
                -- back to defaults instead.
                let isTokenOnlyTransfer =
                        message.messageData == ""
                        && message.ccipReceiveGasLimit == 0
                        && isSome message.tokenTransfer
                if isTokenOnlyTransfer
                    then pure ()
                    else if message.finality /= 0
                        then do
                            assertMsg "offramp: finalized-only receiver rejects FTF messages"
                                (receiverMinBlockDepth /= 0)
                            assertMsg "offramp: message finality below receiver minBlockDepth"
                                (message.finality >= receiverMinBlockDepth)
                        else pure ()
                let resolvedReceiverRequiredCCVs = if isTokenOnlyTransfer
                        then []
                        else receiverRequiredCCVs

                -- Defaults apply when any source (receiver or pool) lacks specific
                -- requirements, matching EVM's address(0) sentinel logic.
                -- Token-only transfers skip defaults since only the token
                -- issuer/pool takes risk.
                let resolvedDefaultCCVs = if isTokenOnlyTransfer
                        || (not (null resolvedReceiverRequiredCCVs) && not (null poolCCVs))
                        then []
                        else sourceConfig.defaultCCVs

                -- Unified CCV list matches EVM merge order:
                -- receiver + pool + lane-mandated + defaults
                let allRawAddrs = resolvedReceiverRequiredCCVs ++ poolCCVs ++ sourceConfig.laneMandatedCCVs ++ resolvedDefaultCCVs
                let requiredCCVAddresses = dedup $
                        map CCIP.RawInstanceAddress.toInstanceAddress allRawAddrs

                -- Compute provided CCV addresses from ExecutingMessageV1's ccvVerifications
                let providedCCVAddresses =
                        map (\v -> CCIP.MessageCodecV1.encodeInstanceAddress v.ccvInstanceId v.ccvOwner)
                            execMsg.ccvVerifications

                -- Validate all required CCVs are covered
                Foldable.forA_ requiredCCVAddresses $ \requiredAddr ->
                    assertMsg ("offramp: missing required CCV address " <> requiredAddr)
                        (requiredAddr `elem` providedCCVAddresses)

                -- Validate owner signatory aggregation matches ccvVerifications
                let ownersFromVerifications = dedup (map (.ccvOwner) execMsg.ccvVerifications)
                assertMsg "offramp: owner signatory aggregation mismatch"
                    (dedup execMsg.ccvOwners == ownersFromVerifications)

                finalizeResult <- case execMsg.tokenReceiver of
                    None ->
                        exercise executingMessageCid
                            CCIP.ExecutingMessageV1.FinalizeExecute with
                                tokenAdminRegistryInstanceId = tokenAdminRegistry.instanceId
                                maybePoolOwner = None
                                maybeTicketReceiver = None
                                maybeTokenReceiver = None
                                maybeInstrumentId = None
                                maybeAmount = None
                                returnData = ""
                    Some _ ->
                        exercise tokenAdminRegistryCid
                            CCIP.TokenAdminRegistry.TokenAdminRegistry_FinalizeExecute with
                                executingMessageCid = executingMessageCid
                                ticketReceiver = routerPartyOwner
                                returnData = ""
                                caller = ccipOwner

                pure ExecuteFromRouterResult with
                    messageId = messageId
                    message = message
                    sourceChainSelector = message.sourceChainSelector
                    sequenceNumber = message.sequenceNumber
                    tokenReceiveTicket = finalizeResult.tokenReceiveTicket
                    executionStateChanged = finalizeResult.executionStateChanged

        interface instance MCMSReceiver for OffRamp where
          view = MCMSReceiverView with
            mcmsController = ccipOwner
            instanceId

          mcmsEntrypoint functionName operationData contractIds = do
            let instAddr = instanceId <> "@" <> partyToText ccipOwner
            selfCid <- case Map.lookup instAddr contractIds of
              None -> abort $ "E_SELF_CID_NOT_IN_MAP: " <> instAddr
              Some cid -> pure (coerceContractId cid : ContractId OffRamp)

            case functionName of
              "SetDeps" -> do
                case decodeSetDepsParams operationData of
                  None -> abort "E_INVALID_PARAMS: SetDeps"
                  Some newDeps -> do
                    newCid <- exercise selfCid SetDeps with newDeps
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              _ -> abort $ "E_UNKNOWN_FUNCTION: " <> functionName


data ExecuteFromRouterResult = ExecuteFromRouterResult
    with
        messageId : BytesHex
        message : CCIP.MessageCodecV1.MessageV1
        sourceChainSelector : Numeric 0
        sequenceNumber : Numeric 0
        tokenReceiveTicket : Optional (ContractId CCIP.Tickets.TokenReceiveTicket)
        executionStateChanged : ContractId CCIP.Events.ExecutionStateChanged
    deriving (Eq, Show)

-- ===========================================================================
-- CODEC: SetDeps parameter encoding/decoding for MCMSReceiver entrypoint
-- ===========================================================================

-- | Decode SetDeps params (Optional fields)
-- Format: [OptRIA globalConfig][OptRIA rmnRemote][OptRIA tokenAdminRegistry]
decodeSetDepsParams : BytesHex -> Optional SetDepsParams
decodeSetDepsParams encoded = do
  (globalConfig, offset1) <- decodeOptionalRawInstanceAddressAt encoded 0
  (rmnRemote, offset2) <- decodeOptionalRawInstanceAddressAt encoded offset1
  (tokenAdminRegistry, _offset3) <- decodeOptionalRawInstanceAddressAt encoded offset2
  Some (SetDepsParams globalConfig rmnRemote tokenAdminRegistry)

-- | Encode SetDeps params (Optional fields)
encodeSetDepsParams : SetDepsParams -> BytesHex
encodeSetDepsParams params =
  encodeOptionalRawInstanceAddress params.globalConfig <>
  encodeOptionalRawInstanceAddress params.rmnRemote <>
  encodeOptionalRawInstanceAddress params.tokenAdminRegistry

-- | Decode OffRampDeps at offset (full, non-optional)
-- Format: [RIA globalConfig][RIA rmnRemote][RIA tokenAdminRegistry]
decodeOffRampDepsAt : BytesHex -> Int -> Optional (OffRampDeps, Int)
decodeOffRampDepsAt encoded offset = do
  (globalConfig, offset1) <- decodeRawInstanceAddressAt encoded offset
  (rmnRemote, offset2) <- decodeRawInstanceAddressAt encoded offset1
  (tokenAdminRegistry, offset3) <- decodeRawInstanceAddressAt encoded offset2
  Some (OffRampDeps globalConfig rmnRemote tokenAdminRegistry, offset3)

-- | Encode OffRampDeps (full, non-optional)
encodeOffRampDeps : OffRampDeps -> BytesHex
encodeOffRampDeps deps =
  encodeRawInstanceAddress deps.globalConfig <>
  encodeRawInstanceAddress deps.rmnRemote <>
  encodeRawInstanceAddress deps.tokenAdminRegistry
