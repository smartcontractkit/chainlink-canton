-- | OffRamp for CCIP message execution, called by PerPartyRouter.
module CCIP.OffRamp where

import DA.Foldable qualified as Foldable
import DA.Crypto.Text (BytesHex, keccak256)
import DA.List (dedup)
import DA.Optional (fromSomeNote)

import qualified CCIP.ExecutingMessageV1
import qualified CCIP.GlobalConfig
import qualified CCIP.MessageCodecV1
import CCIP.RawInstanceAddress (RawInstanceAddress)
import qualified CCIP.RawInstanceAddress
import qualified CCIP.RMNRemote
import qualified CCIP.Tickets
import qualified CCIP.TokenAdminRegistry

import qualified Splice.Api.Token.HoldingV1


-- | OffRamp contract for PerPartyRouter architecture.
template OffRamp
    with
        instanceId : Text
        ccipOwner : Party
        globalConfigInstanceAddress : CCIP.RawInstanceAddress.RawInstanceAddress
        rmnRemoteInstanceAddress : CCIP.RawInstanceAddress.RawInstanceAddress
        tokenAdminRegistryInstanceAddress : CCIP.RawInstanceAddress.RawInstanceAddress
    where
        signatory ccipOwner

        -- | Get required CCV raw instance addresses for inbound message execution.
        -- Controller is ccipOwner - users access via PerPartyRouter wrapper.
        -- Includes receiver's required CCVs since they're executing the message.
        -- Note: pool CCVs are now managed by pools themselves via TokenPool_GetRequiredCCVs.
        nonconsuming choice GetRequiredCCVsForExecute : [CCIP.RawInstanceAddress.RawInstanceAddress]
            with
                globalConfigCid : ContractId CCIP.GlobalConfig.GlobalConfig
                tokenAdminRegistryCid : ContractId CCIP.TokenAdminRegistry.TokenAdminRegistry
                receiverRequiredCCVs : [CCIP.RawInstanceAddress.RawInstanceAddress]
                sourceChainSelector : Numeric 0
                hasTokenTransfer : Bool
                instrumentId : Optional Splice.Api.Token.HoldingV1.InstrumentId
            controller ccipOwner
            do
                -- Get lane-mandated CCVs from GlobalConfig
                sourceConfigOpt <- exercise globalConfigCid
                    CCIP.GlobalConfig.GetSourceChainConfig with
                        sourceChainSelector = sourceChainSelector
                        caller = ccipOwner
                let laneMandatedCCVs = case sourceConfigOpt of
                        None -> []
                        Some config -> config.laneMandatedCCVs

                -- Get default CCVs (if no other CCVs specified)
                let defaultCCVs = case sourceConfigOpt of
                        None -> []
                        Some config ->
                            if null laneMandatedCCVs && null receiverRequiredCCVs
                            then config.defaultCCVs
                            else []

                -- Combine and dedupe
                pure (dedup (laneMandatedCCVs ++ receiverRequiredCCVs ++ defaultCCVs))

        -- | Decode and validate an inbound message, creating an ExecutingMessageV1.
        -- Performs party address validation and RMN curse check.
        nonconsuming choice PrepareExecute : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
            with
                encodedMessage : BytesHex
                rmnRemoteCid : ContractId CCIP.RMNRemote.RMNRemote
                receiverParty : Party
                tokenReceiverParty : Optional Party
                caller : Party
            controller ccipOwner
            do
                -- Decode message
                let message = fromSomeNote "prepareExecute: failed to decode message"
                        (CCIP.MessageCodecV1.decodeMessageV1 encodedMessage)
                let messageId = keccak256 encodedMessage

                -- Validate receiver address matches provided party
                let expectedReceiverAddr = CCIP.MessageCodecV1.encodePartyAddress receiverParty
                assertMsg "prepareExecute: receiver address mismatch"
                    (message.receiver == expectedReceiverAddr)

                -- Resolve tokenReceiver: defaults to receiverParty if not provided
                let resolvedTokenReceiver = case (message.tokenTransfer, tokenReceiverParty) of
                        (Some _, Some trParty) -> Some trParty
                        (Some _, None) -> Some receiverParty
                        (None, _) -> None

                -- Validate tokenReceiver address if token transfer present
                case (message.tokenTransfer, resolvedTokenReceiver) of
                    (Some tt, Some trParty) ->
                        let expectedAddr = CCIP.MessageCodecV1.encodePartyAddress trParty
                        in assertMsg "prepareExecute: tokenReceiver address mismatch"
                            (tt.tokenReceiver == expectedAddr)
                    _ -> pure ()

                -- Validate RMN instance address and check curse
                rmnRemote <- fetch rmnRemoteCid
                CCIP.RawInstanceAddress.assertEqual "prepareExecute: rmn instance address mismatch"
                    rmnRemote.instanceId rmnRemote.rmnOwner rmnRemoteInstanceAddress
                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = ccipOwner
                    chainSelector = message.sourceChainSelector
                assertMsg "prepareExecute: source chain is cursed" (not isCursed)

                -- Build observer list
                let observers = CCIP.ExecutingMessageV1.buildObservingParties
                        receiverParty resolvedTokenReceiver caller

                create CCIP.ExecutingMessageV1.ExecutingMessageV1 with
                    ccipOwner = ccipOwner
                    message = message
                    messageId = messageId
                    receiver = receiverParty
                    tokenReceiver = resolvedTokenReceiver
                    executor = caller
                    observingParties = observers
                    ccvVerifications = []
                    poolCCVsVerified = False

        -- | Process a CCIP execute request from a PerPartyRouter.
        -- Reads CCV verifications and pool verification state from the ExecutingMessageV1
        -- collecting contract.
        nonconsuming choice ExecuteFromRouter : ExecuteFromRouterResult
            with
                routerPartyOwner : Party
                receiverRequiredCCVs : [CCIP.RawInstanceAddress.RawInstanceAddress]

                executingMessageCid : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1

                globalConfigCid : ContractId CCIP.GlobalConfig.GlobalConfig
                tokenAdminRegistryCid : ContractId CCIP.TokenAdminRegistry.TokenAdminRegistry
                rmnRemoteCid : ContractId CCIP.RMNRemote.RMNRemote

            controller ccipOwner
            do
                -- Fetch ExecutingMessageV1 (ccipOwner is signatory, always visible)
                execMsg <- fetch executingMessageCid
                let message = execMsg.message
                let messageId = execMsg.messageId

                -- Verify the ExecutingMessageV1 was created by this OffRamp's ccipOwner
                assertMsg "offramp: executingMessage ccipOwner mismatch"
                    (execMsg.ccipOwner == ccipOwner)

                -- Verify receiver matches router's party owner
                assertMsg "offramp: executingMessage receiver mismatch"
                    (execMsg.receiver == routerPartyOwner)

                -- Re-check RMN curse (PrepareExecute may not have been atomic with Execute)
                rmnRemote <- fetch rmnRemoteCid
                CCIP.RawInstanceAddress.assertEqual "offramp: rmn instance address mismatch"
                    rmnRemote.instanceId rmnRemote.rmnOwner rmnRemoteInstanceAddress
                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = ccipOwner
                    chainSelector = message.sourceChainSelector
                assertMsg "offramp: source chain is cursed" (not isCursed)

                -- Validate dependency instance addresses
                globalConfig <- fetch globalConfigCid
                CCIP.RawInstanceAddress.assertEqual "offramp: globalconfig instance address mismatch"
                    globalConfig.instanceId globalConfig.ccipOwner globalConfigInstanceAddress

                tokenAdminRegistry <- fetch tokenAdminRegistryCid
                CCIP.RawInstanceAddress.assertEqual "offramp: tokenadminregistry instance address mismatch"
                    tokenAdminRegistry.instanceId tokenAdminRegistry.owner tokenAdminRegistryInstanceAddress

                sourceConfigOpt <- exercise globalConfigCid
                    CCIP.GlobalConfig.GetSourceChainConfig with
                        sourceChainSelector = message.sourceChainSelector
                        caller = ccipOwner
                sourceConfig <- case sourceConfigOpt of
                    None -> abort "offramp: unknown source chain"
                    Some c -> do
                        assertMsg "offramp: source chain disabled" c.isEnabled
                        pure c

                -- Decode instrument ID from token transfer (used for pool identity validation)
                let optInstrumentId = case message.tokenTransfer of
                        None -> None
                        Some tt -> CCIP.MessageCodecV1.decodeInstrumentId tt.destTokenAddress

                -- Validate pool CCV verification when token transfer exists.
                -- Pool exercises MarkPoolCCVsVerified when called, so if token
                -- transfer exists the flag must be True.
                poolHasRequirements <- case execMsg.tokenReceiver of
                    None -> pure False
                    Some _ -> do
                        assertMsg "offramp: pool CCVs not verified for token transfer"
                            execMsg.poolCCVsVerified
                        -- Check if pool actually had requirements (for default CCV logic)
                        case optInstrumentId of
                            Some instId -> do
                                configOpt <- exercise tokenAdminRegistryCid
                                    CCIP.TokenAdminRegistry.TokenAdminRegistry_GetTokenConfig with
                                        instrumentId = instId
                                        caller = ccipOwner
                                case configOpt of
                                    Some config -> case config.tokenPool of
                                        Some _ -> pure True
                                        None -> abort "offramp: no pool registered for instrument"
                                    None -> abort "offramp: no token config for instrument"
                            None -> pure False

                -- Determine if defaults should apply
                let hasSpecificRequirements =
                        not (null sourceConfig.laneMandatedCCVs) ||
                        not (null receiverRequiredCCVs) ||
                        poolHasRequirements

                -- Get default CCVs if no specific requirements
                let defaultCCVs = if hasSpecificRequirements
                        then []
                        else sourceConfig.defaultCCVs

                -- Combine all raw addresses and convert to hashed addresses
                let allRawAddrs = sourceConfig.laneMandatedCCVs ++ receiverRequiredCCVs ++ defaultCCVs
                let requiredCCVAddresses = dedup $
                        map CCIP.RawInstanceAddress.toInstanceAddress allRawAddrs

                -- Compute provided CCV addresses from ExecutingMessageV1's ccvVerifications
                let providedCCVAddresses =
                        map (\v -> CCIP.MessageCodecV1.encodeInstanceAddress v.ccvInstanceId v.ccvOwner)
                            execMsg.ccvVerifications

                -- Validate all required CCVs are covered
                Foldable.forA_ requiredCCVAddresses $ \requiredAddr ->
                    assertMsg ("offramp: missing required CCV address " <> requiredAddr)
                        (requiredAddr `elem` providedCCVAddresses)

                -- Issue token receive ticket if tokenReceiver is set.
                -- PrepareExecute guarantees tokenReceiver <-> tokenTransfer consistency.
                tokenReceiveTicketCid <- case execMsg.tokenReceiver of
                    None -> pure None
                    Some tokenReceiver -> do
                        let tt = fromSomeNote
                                "offramp: tokenReceiver set but no tokenTransfer"
                                message.tokenTransfer
                        let instId = fromSomeNote "offramp: failed to decode destTokenAddress"
                                (CCIP.MessageCodecV1.decodeInstrumentId tt.destTokenAddress)
                        configOpt <- exercise tokenAdminRegistryCid
                            CCIP.TokenAdminRegistry.TokenAdminRegistry_GetTokenConfig with
                                instrumentId = instId
                                caller = ccipOwner
                        poolOwner <- case configOpt of
                            None -> abort "offramp: no token config for instrument"
                            Some config -> case config.tokenPool of
                                None -> abort "offramp: no pool registered for instrument"
                                Some pool -> pure pool.poolOwner

                        ticketCid <- exercise tokenAdminRegistryCid
                            CCIP.TokenAdminRegistry.TokenAdminRegistry_IssueReceiveTicket with
                                instrumentId = instId
                                poolOwner = poolOwner
                                receiver = routerPartyOwner
                                tokenReceiver = tokenReceiver
                                amount = tt.amount
                                messageHash = messageId
                                sourceChainSelector = message.sourceChainSelector
                        pure (Some ticketCid)

                -- Consume the ExecutingMessageV1
                exercise executingMessageCid CCIP.ExecutingMessageV1.ExecutingMessageV1_Archive with
                    caller = ccipOwner

                pure ExecuteFromRouterResult with
                    messageId = messageId
                    message = message
                    sourceChainSelector = message.sourceChainSelector
                    sequenceNumber = message.sequenceNumber
                    tokenReceiveTicket = tokenReceiveTicketCid


data ExecuteFromRouterResult = ExecuteFromRouterResult
    with
        messageId : BytesHex
        message : CCIP.MessageCodecV1.MessageV1
        sourceChainSelector : Numeric 0
        sequenceNumber : Numeric 0
        tokenReceiveTicket : Optional (ContractId CCIP.Tickets.TokenReceiveTicket)
    deriving (Eq, Show)
