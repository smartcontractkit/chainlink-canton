-- | offramp for ccip message execution, called by perpartyrouter.
module CCIP.OffRamp where

import DA.Foldable qualified as Foldable
import DA.Crypto.Text (BytesHex, keccak256)
import DA.Optional (fromSomeNote)

import qualified CCIP.CCVId
import qualified CCIP.GlobalConfig
import qualified CCIP.MessageCodecV1
import qualified CCIP.Tickets
import qualified CCIP.TokenAdminRegistry

import qualified Splice.Api.Token.HoldingV1


-- | offramp contract for perpartyrouter architecture.
template OffRamp
    with
        ccipOwner : Party
        instanceId : Text
    where
        signatory ccipOwner

        -- | Get required CCVs for inbound message execution.
        -- Controller is ccipOwner - users access via PerPartyRouter wrapper.
        -- Includes receiver's required CCVs since they're executing the message.
        -- Note: pool CCVs are now managed by pools themselves via TokenPool_GetRequiredCCVs.
        nonconsuming choice GetRequiredCCVsForExecute : [CCIP.CCVId.CCVId]
            with
                globalConfigCid : ContractId CCIP.GlobalConfig.GlobalConfig
                tokenAdminRegistryCid : ContractId CCIP.TokenAdminRegistry.TokenAdminRegistry
                receiverRequiredCCVs : [CCIP.CCVId.CCVId]  -- Passed from PerPartyRouter
                sourceChainSelector : Numeric 0
                hasTokenTransfer : Bool
                instrumentId : Optional Splice.Api.Token.HoldingV1.InstrumentId
            controller ccipOwner
            do
                -- Get lane-mandated CCVs from GlobalConfig
                sourceConfigOpt <- exercise globalConfigCid
                    CCIP.GlobalConfig.GetSourceChainConfig with
                        sourceChainSelector = sourceChainSelector
                        caller = ccipOwner
                let laneMandatedCCVs = case sourceConfigOpt of
                        None -> []
                        Some config -> config.laneMandatedCCVs

                -- Receiver's required CCVs (passed from PerPartyRouter)
                let receiverCCVs = receiverRequiredCCVs

                -- Get default CCVs (if no other CCVs specified)
                let defaultCCVs = case sourceConfigOpt of
                        None -> []
                        Some config ->
                            if null laneMandatedCCVs && null receiverCCVs
                            then config.defaultCCVs
                            else []

                -- Combine and dedupe
                pure (CCIP.CCVId.dedupCCVIds (laneMandatedCCVs ++ receiverCCVs ++ defaultCCVs))

        -- | Process a ccip execute request from a perpartyrouter.
        nonconsuming choice ExecuteFromRouter : ExecuteFromRouterResult
            with
                routerPartyOwner : Party
                receiverRequiredCCVs : [CCIP.CCVId.CCVId]

                globalConfigCid : ContractId CCIP.GlobalConfig.GlobalConfig
                tokenAdminRegistryCid : ContractId CCIP.TokenAdminRegistry.TokenAdminRegistry

                encodedMessage : BytesHex
                ccvVerifyTickets : [ContractId CCIP.Tickets.CCVVerifyTicket]
                tokenPoolCCVTicket : Optional (ContractId CCIP.Tickets.TokenPoolCCVVerifiedTicket)

            controller ccipOwner
            do

                -- decode message
                let message = fromSomeNote "offramp: failed to decode message"
                        (CCIP.MessageCodecV1.decodeMessageV1 encodedMessage)
                let messageHash = keccak256 encodedMessage

                -- verify receiver is this party
                let receiverParty = fromSomeNote "offramp: failed to decode receiver"
                        (CCIP.MessageCodecV1.decodePartyId message.receiver)
                assertMsg "offramp: message not for this party"
                    (receiverParty == routerPartyOwner)

                -- fetch and verify global config
                globalConfig <- fetch globalConfigCid
                assertMsg "offramp: globalconfig ccipowner mismatch"
                    (globalConfig.ccipOwner == ccipOwner)

                sourceConfigOpt <- exercise globalConfigCid
                    CCIP.GlobalConfig.GetSourceChainConfig with
                        sourceChainSelector = message.sourceChainSelector
                        caller = ccipOwner
                sourceConfig <- case sourceConfigOpt of
                    None -> abort "offramp: unknown source chain"
                    Some c -> do
                        assertMsg "offramp: source chain disabled" c.isEnabled
                        pure c

                -- extract token transfer info
                let (hasTokenTransfer, tokenAmount, destTokenAddr, tokenReceiverParty, instrumentId) =
                        case message.tokenTransfer of
                            None -> (False, None, None, None, None)
                            Some tt ->
                                let trParty = CCIP.MessageCodecV1.decodePartyId tt.tokenReceiver
                                    instId = CCIP.MessageCodecV1.decodeInstrumentId tt.destTokenAddress
                                in (True, Some tt.amount, Some tt.destTokenAddress, trParty, instId)

                -- Consume tokenPoolCCVTicket if provided to get pool's verified CCVs
                poolVerifiedCCVIds <- case tokenPoolCCVTicket of
                    None -> pure []
                    Some ticketCid -> do
                        ticket <- fetch ticketCid
                        assertMsg "offramp: tokenPoolCCVTicket ccipOwner mismatch"
                            (ticket.ccipOwner == ccipOwner)
                        assertMsg "offramp: tokenPoolCCVTicket messageHash mismatch"
                            (ticket.messageHash == messageHash)
                        assertMsg "offramp: tokenPoolCCVTicket sourceChainSelector mismatch"
                            (ticket.sourceChainSelector == message.sourceChainSelector)
                        exercise ticketCid CCIP.Tickets.TokenPoolCCVVerifiedTicket_Consume

                -- Get lane-mandated CCVs
                let laneMandatedCCVs = sourceConfig.laneMandatedCCVs

                -- Determine if defaults should apply
                let hasSpecificRequirements =
                        not (null laneMandatedCCVs) ||
                        not (null receiverRequiredCCVs) ||
                        not (null poolVerifiedCCVIds)

                let defaultCCVs = if hasSpecificRequirements
                        then []
                        else sourceConfig.defaultCCVs

                -- Combine all required CCVs
                let requiredCCVIds = CCIP.CCVId.dedupCCVIds $
                        laneMandatedCCVs ++ receiverRequiredCCVs ++ poolVerifiedCCVIds ++ defaultCCVs

                -- consume ccv verification tickets and collect CCVIds
                providedCCVIds <- forA ccvVerifyTickets $ \ticketCid -> do
                    ticket <- fetch ticketCid
                    assertMsg "offramp: ccvverifyticket ccipowner mismatch"
                        (ticket.ccipOwner == ccipOwner)
                    assertMsg "offramp: ccvverifyticket messagehash mismatch"
                        (ticket.messageHash == messageHash)
                    exercise ticketCid CCIP.Tickets.CCVVerifyTicket_Consume

                -- validate all required CCVs are covered
                Foldable.forA_ requiredCCVIds $ \requiredId ->
                    assertMsg ("offramp: missing required CCV " <> requiredId)
                        (requiredId `elem` providedCCVIds)

                -- Issue token receive ticket only if there's a token transfer
                tokenReceiveTicketCid <- case (hasTokenTransfer, instrumentId, tokenAmount, tokenReceiverParty) of
                    (True, Some instId, Some amount, Some tokenReceiver) -> do
                        -- Look up pool owner for the instrument
                        configOpt <- exercise tokenAdminRegistryCid
                            CCIP.TokenAdminRegistry.TokenAdminRegistry_GetTokenConfig with
                                instrumentId = instId
                                caller = ccipOwner
                        poolOwner <- case configOpt of
                            None -> abort "offramp: no token config for instrument"
                            Some config -> case config.tokenPoolOwner of
                                None -> abort "offramp: no pool registered for instrument"
                                Some po -> pure po

                        ticketCid <- exercise tokenAdminRegistryCid
                            CCIP.TokenAdminRegistry.TokenAdminRegistry_IssueReceiveTicket with
                                instrumentId = instId
                                poolOwner = poolOwner
                                receiver = routerPartyOwner
                                tokenReceiver = tokenReceiver
                                amount = amount
                                messageHash = messageHash
                                sourceChainSelector = message.sourceChainSelector
                                caller = ccipOwner
                        pure (Some ticketCid)
                    _ -> pure None

                pure ExecuteFromRouterResult with
                    messageHash = messageHash
                    message = message
                    sourceChainSelector = message.sourceChainSelector
                    sequenceNumber = message.sequenceNumber
                    tokenReceiveTicket = tokenReceiveTicketCid


data ExecuteFromRouterResult = ExecuteFromRouterResult
    with
        messageHash : BytesHex
        message : CCIP.MessageCodecV1.MessageV1
        sourceChainSelector : Numeric 0
        sequenceNumber : Numeric 0
        tokenReceiveTicket : Optional (ContractId CCIP.Tickets.TokenReceiveTicket)
    deriving (Eq, Show)
