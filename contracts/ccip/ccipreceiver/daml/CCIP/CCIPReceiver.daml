-- | Receiver-side entry point for CCIP message execution.
-- Calls PrepareExecute to create an ExecutingMessageV1, then threads it
-- through CCV verification and pool verification via foldlA, and
-- finally calls Execute.
--
-- Only `owner` is a signatory. The CCIP participant does not need this DAR
-- because ccipOwner is not a party on this contract.
module CCIP.CCIPReceiver where

import DA.Crypto.Text (BytesHex)
import DA.Action (foldlA)
import DA.List (dedup)
import DA.Optional (isSome)

import qualified CCIP.Context
import qualified CCIP.Interfaces.CrossChainVerifier
import qualified CCIP.Interfaces.TokenPool
import qualified CCIP.MessageCodecV1
import qualified CCIP.PerPartyRouter
import CCIP.RawInstanceAddress (RawInstanceAddress)
import qualified CCIP.TokenAdminRegistry

-- | Per-CCV verification input. Pairs a verifier contract (via interface)
-- with the attestation data and per-CCV extra context.
data CCVInput = CCVInput
    with
        ccvCid : ContractId CCIP.Interfaces.CrossChainVerifier.ICrossChainVerifier
        verifierResults : BytesHex
        ccvExtraContext : CCIP.Context.CCIPContext
    deriving (Eq, Show)

-- | Token transfer input, provided only when the message includes a
-- token transfer. Mirrors how TokenReceiveTicket is Optional on the OffRamp.
data TokenTransferInput = TokenTransferInput
    with
        tokenPoolCid : ContractId CCIP.Interfaces.TokenPool.ITokenPool
        tokenReceiverParty : Party
        tokenInput : CCIP.Interfaces.TokenPool.TokenInput
        poolExtraContext : CCIP.Context.CCIPContext
    deriving (Eq, Show)

template CCIPReceiver
    with
        instanceId : Text
        owner : Party
        -- Receiver's required CCV instance addresses, analogous to
        -- IAny2EVMMessageReceiverV2.getCCVs() in the EVM implementation.
        -- Passed to PerPartyRouter.Execute as receiverRequiredCCVs.
        requiredCCVs : [RawInstanceAddress]
        -- Minimum source-chain block depth this receiver will accept for FTF messages.
        -- A value of 0 means finalized-only and rejects FTF.
        minBlockDepth : Int
    where
        signatory owner

        -- | Query the receiver's CCV requirements. Off-chain code calls this
        -- to discover which CCVs need verification inputs before calling
        -- Execute. Analogous to IAny2EVMMessageReceiverV2.getCCVs().
        -- TODO: consider combining all CCV requirements
        nonconsuming choice GetRequiredCCVs : [RawInstanceAddress]
            with
                caller : Party
            controller caller
            do pure requiredCCVs

        -- | Update CCV requirements.
        choice UpdateRequiredCCVs : ContractId CCIPReceiver
            with
                newRequiredCCVs : [RawInstanceAddress]
            controller owner
            do create this with requiredCCVs = newRequiredCCVs


        -- | Executes an inbound CCIP message end-to-end.
        -- TODO: consider allowing arbitrary callers
        nonconsuming choice Execute : ContractId CCIPMessageReceived
            with
                -- CCIP context for internal orchestration (PerPartyRouter calls).
                context : CCIP.Context.CCIPContext

                -- CCIP contract IDs
                routerCid : ContractId CCIP.PerPartyRouter.PerPartyRouter

                -- The encoded CCIP message (hex-encoded bytes)
                encodedMessage : BytesHex

                -- None for message-only, Some for token transfers.
                tokenTransfer : Optional TokenTransferInput

                -- One entry per CCV that should verify this message.
                -- Accepts any ICrossChainVerifier implementation.
                ccvInputs : [CCVInput]

                -- Per-execute receiver CCV requirements, combined with the template's
                -- requiredCCVs.
                additionalRequiredCCVs : [RawInstanceAddress]
            controller owner
            do
                -- Extract CIDs from context using typed accessors for pool/CCV calls.
                rmnRemoteCid <- CCIP.Context.lookupRmnRemoteCid context
                tokenAdminRegistryCid <- CCIP.TokenAdminRegistry.lookupTokenAdminRegistryCid context

                -- PrepareExecute: decode, validate, create ExecutingMessageV1
                emCid <- exercise routerCid CCIP.PerPartyRouter.PrepareExecute with
                    context = context
                    encodedMessage = encodedMessage
                    receiverParty = owner
                    tokenReceiverParty = fmap (.tokenReceiverParty) tokenTransfer
                    caller = owner

                em <- fetch emCid
                let isTokenOnlyTransfer =
                        em.message.messageData == ""
                        && em.message.ccipReceiveGasLimit == 0
                        && isSome em.message.tokenTransfer
                if isTokenOnlyTransfer
                    then pure ()
                    else if em.message.finality /= 0
                        then do
                            assertMsg "receiver: finalized-only receiver rejects FTF messages"
                                (minBlockDepth /= 0)
                            assertMsg "receiver: message finality below receiver minBlockDepth"
                                (em.message.finality >= minBlockDepth)
                        else pure ()

                -- CCV verification: thread executingMessageCid through each CCV
                emCid <- foldlA (\cid input ->
                    exercise input.ccvCid
                        CCIP.Interfaces.CrossChainVerifier.CrossChainVerifier_VerifyMessage with
                            rmnRemoteCid = rmnRemoteCid
                            extraContext = input.ccvExtraContext
                            executingMessageCid = cid
                            verifierResults = input.verifierResults
                            caller = owner
                    ) emCid ccvInputs

                -- Pool CCV verification: confirm that CCV results contain token pool required CCVs
                emCid <- case tokenTransfer of
                    None -> pure emCid
                    Some tt -> exercise tt.tokenPoolCid
                        CCIP.Interfaces.TokenPool.TokenPool_VerifyInboundMessage with
                            tokenAdminRegistryCid = tokenAdminRegistryCid
                            extraContext = tt.poolExtraContext
                            executingMessageCid = emCid
                            caller = owner

                -- Execute with the final executingMessageCid
                let allRequiredCCVs = dedup (requiredCCVs ++ additionalRequiredCCVs)

                result <- exercise routerCid CCIP.PerPartyRouter.Execute with
                    context = context
                    executingMessageCid = emCid
                    receiverRequiredCCVs = allRequiredCCVs
                    receiverMinBlockDepth = minBlockDepth

                -- Token release
                tokenReleaseResult <- case (tokenTransfer, result.tokenReceiveTicket) of
                    (Some tt, Some ticketCid) -> do
                        releaseResult <- exercise tt.tokenPoolCid
                            CCIP.Interfaces.TokenPool.TokenPool_ReleaseFromTicket with
                                tokenAdminRegistryCid = tokenAdminRegistryCid
                                rmnRemoteCid = rmnRemoteCid
                                extraContext = tt.poolExtraContext
                                tokenReceiveTicketCid = ticketCid
                                tokenInput = tt.tokenInput
                                caller = owner
                        pure (Some releaseResult)
                    _ -> pure None

                -- Receivers that need custom behavior can fork this receiver and add
                -- business logic here, e.g., parse and act on the message or
                -- programmatic token transfers.

                create CCIPMessageReceived with
                    owner
                    router = result.router
                    messageId = result.messageId
                    message = result.message
                    tokenReleaseResult

-- | Record of a successfully received CCIP message.
template CCIPMessageReceived
    with
        owner : Party
        router : ContractId CCIP.PerPartyRouter.PerPartyRouter
        messageId : BytesHex
        message : CCIP.MessageCodecV1.MessageV1
        tokenReleaseResult : Optional CCIP.Interfaces.TokenPool.ReleaseOrMintResult
    where
        signatory owner
