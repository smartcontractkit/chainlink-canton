            outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-out@owner" -- placeholder
    tokenPool <- submit poolOwner do
        createCmd LockReleaseTokenPool.LockReleaseTokenPool with
            ccipOwner = ccipOwner
            poolOwner = poolOwner
            instanceId = "test-lock-release-pool-override"
            instrumentId = testInstrumentId
            decimals = 6
            remoteChainConfigs = Map.fromList [(destChainSelector, existingConfig)]
            tokenTransferFeeConfigs = Map.fromList [(destChainSelector, LockReleaseTokenPool.TokenTransferFeeConfig with
                isEnabled = True
                feeUSDCents = cents 2.0
                feeBps = 0.0
                destGasOverhead = 50000
                destBytesOverhead = 32)]
            poolReceiveContext = CCIP.Context.emptyCCIPContext
            transferTimeout = LockReleaseTokenPool.Indefinite
            deps = mkPoolDeps "test-tar-override" "test-rmn-override" "test-feequoter-pool-override" ccipOwner ccipOwner

    let senderAddr = MessageCodecV1.encodePartyAddress sender
    sendingMessageCid <- submit ccipOwner do
        createCmd SendingMessageV1.SendingMessageV1 with
            ccipOwner = ccipOwner
            sender = sender
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "test-router-override" sender
                onRamp = RawInstanceAddress.make "test-onramp-override" ccipOwner
                globalConfig = RawInstanceAddress.make "test-globalconfig-override" ccipOwner
                rmnRemote = RawInstanceAddress.make "test-rmn-override" ccipOwner
                tokenAdminRegistry = RawInstanceAddress.make "test-tar-override" ccipOwner
                feeQuoter = RawInstanceAddress.make "test-feequoter-pool-override" ccipOwner
            destChainSelector = destChainSelector
            sequenceNumber = 1.0
            requiredCCVs = []
            executorAddress = RawInstanceAddress.make "default-executor-override" ccipOwner
            sourceChainSelector = 123.0
            senderAddress = senderAddr
            receiver = "0000000000000000000000000000000000000001"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 100000
            ccvAndExecutorHash = ""
            onRampAddress = "0000000000000000000000000000000000000001"
            offRampAddress = "0000000000000000000000000000000000000002"
            tokenReceiver = "0000000000000000000000000000000000000001"
            tokenArgs = ""
            message = None
            encodedMessage = ""
            messageId = ""
            feeToken = feeTokenId
            networkFeeUSDCents = cents 0.0
            expectedTokenInstrumentId = Some testInstrumentId
            outboundPoolCCVs = Some []
            executorArgs = ""
            executorFee = None
            executorFeeTokenAmount = 0.0
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            verifierData = []
            ccvOwners = []
            tokenSendData = None
            observingParties = [sender]
            state = SendingMessageV1.SendingMessageState_Prepared

    disclosedPool <- fromSome <$> queryDisclosure poolOwner tokenPool
    disclosedTar <- fromSome <$> queryDisclosure ccipOwner tokenAdminRegistry
    disclosedFq <- fromSome <$> queryDisclosure ccipOwner feeQuoter
    disclosedSm <- fromSome <$> queryDisclosure ccipOwner sendingMessageCid
    sendingMessageCid <- submit (actAs sender <> disclose disclosedPool <> disclose disclosedTar <> disclose disclosedFq <> disclose disclosedSm) do
        exerciseCmd (toInterfaceContractId @ITokenPool.ITokenPool tokenPool)
            ITokenPool.TokenPool_CalculateFee with
                tokenAdminRegistryCid = tokenAdminRegistry
                sendingMessageCid = sendingMessageCid
                feeQuoterCid = feeQuoter
                tokenInstrumentId = testInstrumentId
                caller = sender

    Some sm <- queryContractId ccipOwner sendingMessageCid
    let tokenSendFee = fromSome sm.tokenSendFee
    tokenSendFee.feeUSDCents === cents 2.0
    tokenSendFee.destGasOverhead === 50000
    tokenSendFee.destBytesOverhead === 32

    debug "testCalculateFeePrefersPoolOverride: PASSED"

