    let existingConfig = LockReleaseTokenPool.RemoteChainConfig with
            remotePools = [allowedSourcePool]
            remoteTokenAddress = "dde9af410cc4f737a136d87d3d4a4deeff1d26fc"
            inboundCCVs = [ccvAddr]
            outboundCCVs = []
            finalityConfig = safeFinality
            inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-in-safe@owner"
            inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-in-safe@owner"
            outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-out-safe@owner"
    tokenPool <- submit poolOwner do
        createCmd LockReleaseTokenPool.LockReleaseTokenPool with
            poolOwner = poolOwner
            ccipOwner = ccipOwner
