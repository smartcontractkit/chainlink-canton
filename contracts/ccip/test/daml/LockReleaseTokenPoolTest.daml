            deps = CCIP.CoreV1.SendingMessage.SendingMessageDeps with
                router = Chainlink.InstanceAddress.make "test-router-disabled" sender
                onRamp = Chainlink.InstanceAddress.make "test-onramp-disabled" ccipOwner
                globalConfig = Chainlink.InstanceAddress.make "test-globalconfig-disabled" ccipOwner
