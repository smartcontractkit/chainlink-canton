import TestToken qualified

usd : Decimal -> Numeric 0
usd d = intToNumeric (truncate (d * 100000000.0))

cents : Decimal -> Numeric 0
cents c = intToNumeric (truncate c)

usdToCents : Decimal -> Numeric 0
usdToCents d = intToNumeric (truncate (d * 100.0))

mult : Decimal -> Numeric 0
mult m = intToNumeric (truncate (m * 100000000.0))

finalityConfig n =
    if n == 0
    then FinalityCodec.WaitForFinality
    else FinalityCodec.BlockDepth n

rawFinalityConfig n =
    if n == 0
    then FinalityCodec.waitForFinalityFlag
    else fromSome do
        flagsHex <- MessageCodecV1.encodeUint16 0
        blockConfirmationsHex <- MessageCodecV1.encodeUint16 n
        pure (flagsHex <> blockConfirmationsHex)

unsafeDecodeRequestedFinality finalityConfig =
    fromSomeNote "unsafeDecodeRequestedFinality: invalid finality config"
        (FinalityCodec.decodeRequestedFinality finalityConfig)

messageFinality n = unsafeDecodeRequestedFinality (rawFinalityConfig n)

mkPoolContext : ContractId RateLimiter.RateLimiter -> ContractId TransferInstructionV1.TransferFactory -> [ContractId HoldingV1.Holding] -> MetadataV1.ChoiceContext
mkPoolContext rateLimiterCid burnMintFactoryCid tokenPoolHoldings = MetadataV1.ChoiceContext with
  values = TextMap.fromList
    [ (RateLimiter.rateLimiterKey, CCIP.Context.toAnyValue rateLimiterCid)
    , (LockReleaseTokenPool.transferFactoryContextKey, CCIP.Context.toAnyValue burnMintFactoryCid)
    , (LockReleaseTokenPool.tokenPoolHoldingsContextKey, CCIP.Context.toAnyValue tokenPoolHoldings)
    ]

template ParseSourcePoolDecimalsHarness
  with
    owner : Party
  where
    signatory owner

    choice ParseSourcePoolDecimals : Int
      with
        localDecimals : Int
        sourcePoolData : BytesHex
      controller owner
      do pure (LockReleaseTokenPool.parseSourcePoolDecimals localDecimals sourcePoolData)

template CalculateLocalAmountHarness
  with
    owner : Party
  where
    signatory owner

    nonconsuming choice CalculateLocalAmount : Numeric 0
      with
        amount : Numeric 0
        remoteDecimals : Int
        localDecimals : Int
      controller owner
      do
        pure (LockReleaseTokenPool.calculateLocalAmount amount remoteDecimals localDecimals)


mkPoolDeps : Text -> Text -> Text -> Party -> Party -> LockReleaseTokenPool.LockReleaseTokenPoolDeps
mkPoolDeps tokenAdminRegistryInstanceId rmnInstanceId feeQuoterInstanceId ccipOwner rmnOwner =
    LockReleaseTokenPool.LockReleaseTokenPoolDeps with
        tokenAdminRegistry = RawInstanceAddress.make tokenAdminRegistryInstanceId ccipOwner
        rmnRemote = RawInstanceAddress.make rmnInstanceId rmnOwner
        feeQuoter = RawInstanceAddress.make feeQuoterInstanceId ccipOwner

createRateLimiter
    : Party
    -> Text
    -> Numeric 0
    -> RateLimiter.RateLimitDirection
    -> Numeric 0
    -> Numeric 0
    -> Script (ContractId RateLimiter.RateLimiter, RawInstanceAddress.RawInstanceAddress)
createRateLimiter poolOwner poolInstanceId remoteChainSelector direction capacity rate = do
    now <- getTime
    let instanceId = poolInstanceId <> "-"
            <> (case direction of
                    RateLimiter.RateLimitDirection_Outbound -> "outbound"
                    RateLimiter.RateLimitDirection_Inbound -> "inbound")
            <> "-"
            <> show remoteChainSelector
    rateLimiterCid <- submit poolOwner do
        createCmd RateLimiter.RateLimiter with
            instanceId = instanceId
            poolInstanceId = poolInstanceId
            poolOwner = poolOwner
            remoteChainSelector = remoteChainSelector
            direction = direction
            mode = RateLimiter.RateLimitMode_DefaultFinality
            isEnabled = True
            capacity = capacity
            rate = rate
            tokens = capacity
            lastUpdated = now
    pure (rateLimiterCid, RawInstanceAddress.make instanceId poolOwner)

setupTokenAdminRegistryWithPool
    : Party
    -> Party
    -> Text
    -> HoldingV1.InstrumentId
    -> Text
    -> Script (ContractId TokenAdminRegistry.TokenAdminRegistry, ContractId TokenAdminRegistry.TokenConfig)
setupTokenAdminRegistryWithPool ccipOwner poolOwner tokenAdminRegistryInstanceId instrumentId tokenPoolInstanceId = do
    tokenAdminRegistry0 <- submit ccipOwner do
        createCmd TokenAdminRegistry.TokenAdminRegistry with
            owner = ccipOwner
            instanceId = tokenAdminRegistryInstanceId
            entryCount = 0

    proposeResult <- submit ccipOwner do
        exerciseCmd tokenAdminRegistry0 TokenAdminRegistry.ProposeAdministrator with
            tokenConfigCid = None
            instrumentId = instrumentId
            newAdmin = poolOwner
            caller = ccipOwner
    let tokenAdminRegistry = proposeResult.tokenAdminRegistryCid
        tokenConfigCid0 = proposeResult.tokenConfigCid

    disclosedTar <- fromSome <$> queryDisclosure ccipOwner tokenAdminRegistry
    tokenConfigCid1 <- submit (actAs poolOwner <> disclose disclosedTar) do
        exerciseCmd tokenAdminRegistry TokenAdminRegistry.AcceptAdminRole with
            tokenConfigCid = tokenConfigCid0
            instrumentId = instrumentId
            caller = poolOwner

    disclosedTar <- fromSome <$> queryDisclosure ccipOwner tokenAdminRegistry
    tokenConfigCid2 <- submit (actAs poolOwner <> disclose disclosedTar) do
        exerciseCmd tokenAdminRegistry TokenAdminRegistry.SetPool with
            tokenConfigCid = tokenConfigCid1
            instrumentId = instrumentId
            tokenPool = Some TokenAdminRegistryTypes.PoolRegistration with
                poolOwner = poolOwner
                poolInstanceId = tokenPoolInstanceId
            caller = poolOwner

    pure (tokenAdminRegistry, tokenConfigCid2)

-- | Test LockOrBurn transfers tokens from sender to pool.
testLockOrBurn : Script ()
testLockOrBurn = script do
    ccipOwner <- allocateParty "ccip-owner"
    rmnOwner <- allocateParty "rmn-owner"
    ccvOwner <- allocateParty "ccv-owner"
    poolOwner <- allocateParty "pool-owner"
    sender <- allocateParty "sender"

    let rmnInstanceId = "test-rmn"
    let feeQuoterInstanceId = "test-feequoter"
    let ccvInstanceId = "test-ccv"
    let tokenAdminRegistryInstanceId = "test-tar"
    let tokenPoolInstanceId = "test-lock-release-pool"

    let destChainSelector : Numeric 0 = 456.0
    let sourceChainSelector : Numeric 0 = 123.0

    let linkToken = HoldingV1.InstrumentId with
            admin = ccipOwner
            id = "LINK"
    let testInstrumentId = HoldingV1.InstrumentId with
            admin = ccipOwner
            id = "TestToken"

    -- Deploy RMNRemote
    rmnRemote <- submit rmnOwner do
        createCmd RMNRemote.RMNRemote with
            instanceId = rmnInstanceId
            rmnOwner = rmnOwner
            ccipOwner = ccipOwner
            customObservers = []
            cursedSubjects = []

    -- Deploy TokenAdminRegistry and register pool
    (tokenAdminRegistry, tokenConfigCid) <- setupTokenAdminRegistryWithPool
        ccipOwner
        poolOwner
        tokenAdminRegistryInstanceId
        testInstrumentId
        tokenPoolInstanceId

    -- Create sender's token holding (10 tokens)
    senderHolding <- submit (actAs sender <> actAs ccipOwner) do
        createCmd TestToken.TestHolding with
            owner = sender
            admin = ccipOwner
            instrumentId = testInstrumentId
            amount = 10.0

    -- Create preapproval for pool to receive tokens directly
    poolPreapproval <- submit (actAs poolOwner <> actAs ccipOwner) do
        createCmd TestToken.TestTransferPreapproval with
            admin = ccipOwner
            receiver = poolOwner

    -- Create TransferFactory with pool's preapproval
    transferFactory <- submit ccipOwner do
        createCmd TestToken.TestTransferFactory with
            admin = ccipOwner
            preapprovalCid = Some poolPreapproval

    (outboundRateLimiter, outboundRateLimiterAddr) <- createRateLimiter
        poolOwner
        tokenPoolInstanceId
        destChainSelector
        RateLimiter.RateLimitDirection_Outbound
        100000000000.0
        10000000.0

    -- Deploy LockReleaseTokenPool with remote chain config
    let existingConfig = LockReleaseTokenPool.RemoteChainConfig with
            remotePools = ["d2ff32a3f0bb7b9b5afcfbaaa9ae629449ef2ff0"]
            remoteTokenAddress = "dde9af410cc4f737a136d87d3d4a4deeff1d26fc"
            inboundCCVs = []
            outboundCCVs = []
            finalityConfig = finalityConfig 0
            inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-in@owner" -- placeholder
            inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-in@owner" -- placeholder
            outboundRateLimiter = outboundRateLimiterAddr
    tokenPool <- submit poolOwner do
        createCmd LockReleaseTokenPool.LockReleaseTokenPool with
            poolOwner = poolOwner
            ccipOwner = ccipOwner
            instanceId = tokenPoolInstanceId
            instrumentId = testInstrumentId
            decimals = 10
            rateLimitAdmin = None
            remoteChainConfigs = Map.fromList [(destChainSelector, existingConfig)]
            tokenTransferFeeConfigs = Map.fromList [(destChainSelector, LockReleaseTokenPool.TokenTransferFeeConfig with
                isEnabled = False
                feeUSDCents = cents 0.0
                feeBps = 750.0
                destGasOverhead = 0
                destBytesOverhead = 32)]
            poolReceiveContext = MetadataV1.emptyChoiceContext
            transferTimeout = LockReleaseTokenPool.Indefinite
            deps = mkPoolDeps tokenAdminRegistryInstanceId rmnInstanceId feeQuoterInstanceId ccipOwner rmnOwner

    -- Create SendingMessageV1 with token transfer fields.
    -- LockOrBurn reads dest chain, token amount, and receiver from here.
    let senderAddr = MessageCodecV1.encodePartyAddress sender
    sendingMessageCid <- submit ccipOwner do
        createCmd SendingMessageV1.SendingMessageV1 with
            ccipOwner = ccipOwner
            sender = sender
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "test-router" sender
                onRamp = RawInstanceAddress.make "test-onramp" ccipOwner
                globalConfig = RawInstanceAddress.make "test-globalconfig" ccipOwner
                rmnRemote = RawInstanceAddress.make rmnInstanceId rmnOwner
                tokenAdminRegistry = RawInstanceAddress.make tokenAdminRegistryInstanceId ccipOwner
                feeQuoter = RawInstanceAddress.make feeQuoterInstanceId ccipOwner
            destChainSelector = destChainSelector
            sequenceNumber = 1.0
            requiredCCVs = []
            destDefaultCCVs = []
            requiredExecutor = None
            executorAddress = RawInstanceAddress.toInstanceAddress (RawInstanceAddress.make "default-executor" ccipOwner)
            executionMode = Some SendingMessageV1.ExecutionMode_NoExecutor
            sourceChainSelector = sourceChainSelector
            senderAddress = senderAddr
            receiver = "0000000000000000000000000000000000000001"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 100000
            ccvAndExecutorHash = ""
            onRampAddress = "0000000000000000000000000000000000000001"
            offRampAddress = "0000000000000000000000000000000000000002"
            tokenReceiver = "0000000000000000000000000000000000000001"
            tokenArgs = ""
            message = None
            encodedMessage = ""
            messageId = ""
            feeToken = testInstrumentId
            networkFeeUSDCents = cents 0.0
            expectedTokenInstrumentId = Some testInstrumentId
            outboundPoolCCVs = Some []
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            ccvFees = []
            tokenSendFee = Some (SendingMessageV1.TokenSendFee with
                poolInstanceId = "test-lock-release-pool"
                poolOwner = poolOwner
                feeUSDCents = cents 0.0
                destGasOverhead = 0
                destBytesOverhead = 64)
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            verifierData = []
            ccvOwners = []
            tokenSendData = None
            observingParties = [sender]
            state = SendingMessageV1.SendingMessageState_FeeFinalized

    -- Disclose contracts
    disclosedPool <- fromSome <$> queryDisclosure poolOwner tokenPool
    disclosedTar <- fromSome <$> queryDisclosure ccipOwner tokenAdminRegistry
    disclosedTokenConfig <- fromSome <$> queryDisclosure ccipOwner tokenConfigCid
    disclosedFactory <- fromSome <$> queryDisclosure ccipOwner transferFactory
    disclosedPreapproval <- fromSome <$> queryDisclosure poolOwner poolPreapproval
    disclosedRmn <- fromSome <$> queryDisclosure rmnOwner rmnRemote
    disclosedRateLimiter <- fromSome <$> queryDisclosure poolOwner outboundRateLimiter

    -- Test that LockOrBurn with 0 amount fails.
    submitMustFail (actAs sender
                      <> disclose disclosedPool <> disclose disclosedTar <> disclose disclosedTokenConfig
                      <> disclose disclosedFactory <> disclose disclosedPreapproval
                      <> disclose disclosedRmn <> disclose disclosedRateLimiter) do
        exerciseCmd tokenPool LockReleaseTokenPool.LockOrBurn with
            tokenAdminRegistryCid = tokenAdminRegistry
            tokenConfigCid = tokenConfigCid
            sendingMessageCid = sendingMessageCid
            senderInputCids = [toInterfaceContractId senderHolding]
            amount = 0.0 
            rmnRemoteCid = rmnRemote
            extraContext = mkPoolContext outboundRateLimiter (toInterfaceContractId transferFactory) []
            caller = sender

    -- Test that LockOrBurn with a negative amount fails.
    submitMustFail (actAs sender
                      <> disclose disclosedPool <> disclose disclosedTar <> disclose disclosedTokenConfig
                      <> disclose disclosedFactory <> disclose disclosedPreapproval
                      <> disclose disclosedRmn <> disclose disclosedRateLimiter) do
        exerciseCmd tokenPool LockReleaseTokenPool.LockOrBurn with
            tokenAdminRegistryCid = tokenAdminRegistry
            tokenConfigCid = tokenConfigCid
            sendingMessageCid = sendingMessageCid
            senderInputCids = [toInterfaceContractId senderHolding]
            amount = -5.0
            rmnRemoteCid = rmnRemote
            extraContext = mkPoolContext outboundRateLimiter (toInterfaceContractId transferFactory) []
            caller = sender

    -- LockOrBurn stores token data via AddTokenSend
    result <- submit (actAs sender
                      <> disclose disclosedPool <> disclose disclosedTar <> disclose disclosedTokenConfig
                      <> disclose disclosedFactory <> disclose disclosedPreapproval
                      <> disclose disclosedRmn <> disclose disclosedRateLimiter) do
        exerciseCmd tokenPool LockReleaseTokenPool.LockOrBurn with
            tokenAdminRegistryCid = tokenAdminRegistry
            tokenConfigCid = tokenConfigCid
            sendingMessageCid = sendingMessageCid
            senderInputCids = [toInterfaceContractId senderHolding]
            amount = 5.0
            rmnRemoteCid = rmnRemote
            extraContext = mkPoolContext outboundRateLimiter (toInterfaceContractId transferFactory) []
            caller = sender

    -- Verify pool received tokens (5 tokens)
    assertMsg "Pool should have 1 holding" (length result.poolChangeCids == 1)
    poolHolding <- queryContractId poolOwner (fromInterfaceContractId @TestToken.TestHolding (head result.poolChangeCids))
    assertMsg "Pool holding should exist" (isSome poolHolding)
    let poolH = fromSome poolHolding
    poolH.amount === 5.0
    poolH.owner === poolOwner

    -- Verify sender got change (5 tokens)
    assertMsg "Sender should have 1 change holding" (length result.senderChangeCids == 1)
    senderChange <- queryContractId sender (fromInterfaceContractId @TestToken.TestHolding (head result.senderChangeCids))
    assertMsg "Sender change should exist" (isSome senderChange)
    let senderC = fromSome senderChange
    senderC.amount === 5.0
    senderC.owner === sender

    Some updatedSendingMessage <- queryContractId ccipOwner result.sendingMessageCid
    let tokenSendData = fromSome updatedSendingMessage.tokenSendData
    tokenSendData.amount === 50000000000.0

    debug "testLockOrBurn: PASSED"

-- | Test LockOrBurn validates only newly received holdings, not existing pool holdings.
testLockOrBurnIgnoresExistingPoolHoldingsInValidation : Script ()
testLockOrBurnIgnoresExistingPoolHoldingsInValidation = script do
    ccipOwner <- allocateParty "ccip-owner-existing-pool"
    rmnOwner <- allocateParty "rmn-owner-existing-pool"
    ccvOwner <- allocateParty "ccv-owner-existing-pool"
    poolOwner <- allocateParty "pool-owner-existing-pool"
    sender <- allocateParty "sender-existing-pool"

    let rmnInstanceId = "test-rmn-existing-pool"
    let feeQuoterInstanceId = "test-feequoter-existing-pool"
    let tokenAdminRegistryInstanceId = "test-tar-existing-pool"
    let tokenPoolInstanceId = "test-lock-release-pool-existing-pool"

    let destChainSelector : Numeric 0 = 456.0
    let sourceChainSelector : Numeric 0 = 123.0

    let linkToken = HoldingV1.InstrumentId with
            admin = ccipOwner
            id = "LINK"
    let testInstrumentId = HoldingV1.InstrumentId with
            admin = ccipOwner
            id = "TestToken"
    rmnRemote <- submit rmnOwner do
        createCmd RMNRemote.RMNRemote with
            instanceId = rmnInstanceId
            rmnOwner = rmnOwner
            ccipOwner = ccipOwner
            customObservers = []
            cursedSubjects = []

    (tokenAdminRegistry, tokenConfigCid) <- setupTokenAdminRegistryWithPool
        ccipOwner
        poolOwner
        tokenAdminRegistryInstanceId
        testInstrumentId
        tokenPoolInstanceId

    senderHolding <- submit (actAs sender <> actAs ccipOwner) do
        createCmd TestToken.TestHolding with
            owner = sender
            admin = ccipOwner
            instrumentId = testInstrumentId
            amount = 10.0

    existingPoolHolding <- submit (actAs poolOwner <> actAs ccipOwner) do
        createCmd TestToken.TestHolding with
            owner = poolOwner
            admin = ccipOwner
            instrumentId = testInstrumentId
            amount = 3.0

    poolPreapproval <- submit (actAs poolOwner <> actAs ccipOwner) do
        createCmd TestToken.TestTransferPreapproval with
            admin = ccipOwner
            receiver = poolOwner

    transferFactory <- submit ccipOwner do
        createCmd TestToken.TestTransferFactory with
            admin = ccipOwner
            preapprovalCid = Some poolPreapproval

    (outboundRateLimiter, outboundRateLimiterAddr) <- createRateLimiter
        poolOwner
        tokenPoolInstanceId
        destChainSelector
        RateLimiter.RateLimitDirection_Outbound
        100000000000.0
        10000000.0

    let existingConfig = LockReleaseTokenPool.RemoteChainConfig with
            remotePools = ["d2ff32a3f0bb7b9b5afcfbaaa9ae629449ef2ff0"]
            remoteTokenAddress = "dde9af410cc4f737a136d87d3d4a4deeff1d26fc"
            inboundCCVs = []
            outboundCCVs = []
            finalityConfig = finalityConfig 0
            inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-in@owner"
            inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-in@owner"
            outboundRateLimiter = outboundRateLimiterAddr
    tokenPool <- submit poolOwner do
        createCmd LockReleaseTokenPool.LockReleaseTokenPool with
            poolOwner = poolOwner
            ccipOwner = ccipOwner
            instanceId = tokenPoolInstanceId
            instrumentId = testInstrumentId
            decimals = 10
            rateLimitAdmin = None
            remoteChainConfigs = Map.fromList [(destChainSelector, existingConfig)]
            tokenTransferFeeConfigs = Map.fromList [(destChainSelector, LockReleaseTokenPool.TokenTransferFeeConfig with
                isEnabled = False
                feeUSDCents = cents 0.0
                feeBps = 750.0
                destGasOverhead = 0
                destBytesOverhead = 32)]
            poolReceiveContext = MetadataV1.emptyChoiceContext
            transferTimeout = LockReleaseTokenPool.Indefinite
            deps = mkPoolDeps tokenAdminRegistryInstanceId rmnInstanceId feeQuoterInstanceId ccipOwner rmnOwner

    let senderAddr = MessageCodecV1.encodePartyAddress sender
    sendingMessageCid <- submit ccipOwner do
        createCmd SendingMessageV1.SendingMessageV1 with
            ccipOwner = ccipOwner
            sender = sender
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "test-router" sender
                onRamp = RawInstanceAddress.make "test-onramp" ccipOwner
                globalConfig = RawInstanceAddress.make "test-globalconfig" ccipOwner
                rmnRemote = RawInstanceAddress.make rmnInstanceId rmnOwner
                tokenAdminRegistry = RawInstanceAddress.make tokenAdminRegistryInstanceId ccipOwner
                feeQuoter = RawInstanceAddress.make feeQuoterInstanceId ccipOwner
            destChainSelector = destChainSelector
            sequenceNumber = 1.0
            requiredCCVs = []
            destDefaultCCVs = []
            requiredExecutor = None
            executorAddress = RawInstanceAddress.toInstanceAddress (RawInstanceAddress.make "default-executor" ccipOwner)
            executionMode = Some SendingMessageV1.ExecutionMode_NoExecutor
            sourceChainSelector = sourceChainSelector
            senderAddress = senderAddr
            receiver = "0000000000000000000000000000000000000001"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 100000
            ccvAndExecutorHash = ""
            onRampAddress = "0000000000000000000000000000000000000001"
            offRampAddress = "0000000000000000000000000000000000000002"
            tokenReceiver = "0000000000000000000000000000000000000001"
            tokenArgs = ""
            message = None
            encodedMessage = ""
            messageId = ""
            feeToken = testInstrumentId
            networkFeeUSDCents = cents 0.0
            expectedTokenInstrumentId = Some testInstrumentId
            outboundPoolCCVs = Some []
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            ccvFees = []
            tokenSendFee = Some (SendingMessageV1.TokenSendFee with
                poolInstanceId = tokenPoolInstanceId
                poolOwner = poolOwner
                feeUSDCents = cents 0.0
                destGasOverhead = 0
                destBytesOverhead = 64)
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            verifierData = []
            ccvOwners = []
            tokenSendData = None
            observingParties = [sender]
            state = SendingMessageV1.SendingMessageState_FeeFinalized

    disclosedPool <- fromSome <$> queryDisclosure poolOwner tokenPool
    disclosedTar <- fromSome <$> queryDisclosure ccipOwner tokenAdminRegistry
    disclosedTokenConfig <- fromSome <$> queryDisclosure ccipOwner tokenConfigCid
    disclosedFactory <- fromSome <$> queryDisclosure ccipOwner transferFactory
    disclosedPreapproval <- fromSome <$> queryDisclosure poolOwner poolPreapproval
    disclosedRmn <- fromSome <$> queryDisclosure rmnOwner rmnRemote
    disclosedRateLimiter <- fromSome <$> queryDisclosure poolOwner outboundRateLimiter

    result <- submit (actAs sender
                      <> disclose disclosedPool <> disclose disclosedTar <> disclose disclosedTokenConfig
                      <> disclose disclosedFactory <> disclose disclosedPreapproval
                      <> disclose disclosedRmn <> disclose disclosedRateLimiter) do
        exerciseCmd tokenPool LockReleaseTokenPool.LockOrBurn with
            tokenAdminRegistryCid = tokenAdminRegistry
            tokenConfigCid = tokenConfigCid
            sendingMessageCid = sendingMessageCid
            senderInputCids = [toInterfaceContractId senderHolding]
            amount = 5.0
            rmnRemoteCid = rmnRemote
            extraContext = mkPoolContext outboundRateLimiter (toInterfaceContractId transferFactory) [toInterfaceContractId existingPoolHolding]
            caller = sender

    assertMsg "Pool should see one new holding plus one existing holding" (length result.poolChangeCids == 2)
    newPoolHolding <- queryContractId poolOwner (fromInterfaceContractId @TestToken.TestHolding (head result.poolChangeCids))
    assertMsg "New pool holding should exist" (isSome newPoolHolding)
    let newPoolH = fromSome newPoolHolding
    newPoolH.amount === 5.0

    existingPoolHoldingFetched <- queryContractId poolOwner (fromInterfaceContractId @TestToken.TestHolding (result.poolChangeCids !! 1))
    assertMsg "Existing pool holding should still exist" (isSome existingPoolHoldingFetched)
    let existingPoolH = fromSome existingPoolHoldingFetched
    existingPoolH.amount === 3.0

    Some updatedSendingMessage <- queryContractId ccipOwner result.sendingMessageCid
    let tokenSendData = fromSome updatedSendingMessage.tokenSendData
    tokenSendData.amount === 50000000000.0

    debug "testLockOrBurnIgnoresExistingPoolHoldingsInValidation: PASSED"

-- | Test LockOrBurn deducts proportional feeBps from bridged token amount.
testLockOrBurnDeductsFeeBps : Script ()
testLockOrBurnDeductsFeeBps = script do
    ccipOwner <- allocateParty "ccip-owner-bps"
    rmnOwner <- allocateParty "rmn-owner-bps"
    poolOwner <- allocateParty "pool-owner-bps"
    sender <- allocateParty "sender-bps"

    let rmnInstanceId = "test-rmn-bps"
    let feeQuoterInstanceId = "test-feequoter-bps"
    let tokenAdminRegistryInstanceId = "test-tar-bps"
    let tokenPoolInstanceId = "test-lock-release-pool-bps"

    let destChainSelector : Numeric 0 = 456.0
    let sourceChainSelector : Numeric 0 = 123.0

    let linkToken = HoldingV1.InstrumentId with
            admin = ccipOwner
            id = "LINK"
    let testInstrumentId = HoldingV1.InstrumentId with
            admin = ccipOwner
            id = "TestToken"

    rmnRemote <- submit rmnOwner do
        createCmd RMNRemote.RMNRemote with
            instanceId = rmnInstanceId
            rmnOwner = rmnOwner
            ccipOwner = ccipOwner
            customObservers = []
            cursedSubjects = []

    (tokenAdminRegistry, tokenConfigCid) <- setupTokenAdminRegistryWithPool
        ccipOwner
        poolOwner
        tokenAdminRegistryInstanceId
        testInstrumentId
        tokenPoolInstanceId

    senderHolding <- submit (actAs sender <> actAs ccipOwner) do
        createCmd TestToken.TestHolding with
            owner = sender
            admin = ccipOwner
            instrumentId = testInstrumentId
            amount = 10.0

    poolPreapproval <- submit (actAs poolOwner <> actAs ccipOwner) do
        createCmd TestToken.TestTransferPreapproval with
            admin = ccipOwner
            receiver = poolOwner

    transferFactory <- submit ccipOwner do
        createCmd TestToken.TestTransferFactory with
            admin = ccipOwner
            preapprovalCid = Some poolPreapproval

    (outboundRateLimiter, outboundRateLimiterAddr) <- createRateLimiter
        poolOwner
        tokenPoolInstanceId
        destChainSelector
        RateLimiter.RateLimitDirection_Outbound
        100000000000.0
        10000000.0

    let existingConfig = LockReleaseTokenPool.RemoteChainConfig with
            remotePools = ["d2ff32a3f0bb7b9b5afcfbaaa9ae629449ef2ff0"]
            remoteTokenAddress = "dde9af410cc4f737a136d87d3d4a4deeff1d26fc"
            inboundCCVs = []
            outboundCCVs = []
            finalityConfig = finalityConfig 0
            inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-in@owner"
            inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-in@owner"
            outboundRateLimiter = outboundRateLimiterAddr
    tokenPool <- submit poolOwner do
        createCmd LockReleaseTokenPool.LockReleaseTokenPool with
            poolOwner = poolOwner
            ccipOwner = ccipOwner
            instanceId = tokenPoolInstanceId
            instrumentId = testInstrumentId
            decimals = 10
            rateLimitAdmin = None
            remoteChainConfigs = Map.fromList [(destChainSelector, existingConfig)]
            tokenTransferFeeConfigs = Map.fromList [(destChainSelector, LockReleaseTokenPool.TokenTransferFeeConfig with
                isEnabled = True
                feeUSDCents = cents 0.0
                feeBps = 500.0
                destGasOverhead = 0
                destBytesOverhead = 32)]
            poolReceiveContext = MetadataV1.emptyChoiceContext
            transferTimeout = LockReleaseTokenPool.Indefinite
            deps = mkPoolDeps tokenAdminRegistryInstanceId rmnInstanceId feeQuoterInstanceId ccipOwner rmnOwner

    let senderAddr = MessageCodecV1.encodePartyAddress sender
    sendingMessageCid <- submit ccipOwner do
        createCmd SendingMessageV1.SendingMessageV1 with
            ccipOwner = ccipOwner
            sender = sender
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "test-router-bps" sender
                onRamp = RawInstanceAddress.make "test-onramp-bps" ccipOwner
                globalConfig = RawInstanceAddress.make "test-globalconfig-bps" ccipOwner
                rmnRemote = RawInstanceAddress.make rmnInstanceId rmnOwner
                tokenAdminRegistry = RawInstanceAddress.make tokenAdminRegistryInstanceId ccipOwner
                feeQuoter = RawInstanceAddress.make feeQuoterInstanceId ccipOwner
            destChainSelector = destChainSelector
            sequenceNumber = 1.0
            requiredCCVs = []
            destDefaultCCVs = []
            requiredExecutor = None
            executorAddress = RawInstanceAddress.toInstanceAddress (RawInstanceAddress.make "default-executor-bps" ccipOwner)
            executionMode = Some SendingMessageV1.ExecutionMode_NoExecutor
            sourceChainSelector = sourceChainSelector
            senderAddress = senderAddr
            receiver = "0000000000000000000000000000000000000001"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 100000
            ccvAndExecutorHash = ""
            onRampAddress = "0000000000000000000000000000000000000001"
            offRampAddress = "0000000000000000000000000000000000000002"
            tokenReceiver = "0000000000000000000000000000000000000001"
            tokenArgs = ""
            message = None
            encodedMessage = ""
            messageId = ""
            feeToken = testInstrumentId
            networkFeeUSDCents = cents 0.0
            expectedTokenInstrumentId = Some testInstrumentId
            outboundPoolCCVs = Some []
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            ccvFees = []
            tokenSendFee = Some (SendingMessageV1.TokenSendFee with
                poolInstanceId = "test-lock-release-pool-bps"
                poolOwner = poolOwner
                feeUSDCents = cents 0.0
                destGasOverhead = 0
                destBytesOverhead = 64)
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            verifierData = []
            ccvOwners = []
            tokenSendData = None
            observingParties = [sender]
            state = SendingMessageV1.SendingMessageState_FeeFinalized

    disclosedPool <- fromSome <$> queryDisclosure poolOwner tokenPool
    disclosedTar <- fromSome <$> queryDisclosure ccipOwner tokenAdminRegistry
    disclosedTokenConfig <- fromSome <$> queryDisclosure ccipOwner tokenConfigCid
    disclosedFactory <- fromSome <$> queryDisclosure ccipOwner transferFactory
    disclosedPreapproval <- fromSome <$> queryDisclosure poolOwner poolPreapproval
    disclosedRmn <- fromSome <$> queryDisclosure rmnOwner rmnRemote
    disclosedRateLimiter <- fromSome <$> queryDisclosure poolOwner outboundRateLimiter

    result <- submit (actAs sender
                      <> disclose disclosedPool <> disclose disclosedTar <> disclose disclosedTokenConfig
                      <> disclose disclosedFactory <> disclose disclosedPreapproval
                      <> disclose disclosedRmn <> disclose disclosedRateLimiter) do
        exerciseCmd tokenPool LockReleaseTokenPool.LockOrBurn with
            tokenAdminRegistryCid = tokenAdminRegistry
            tokenConfigCid = tokenConfigCid
            sendingMessageCid = sendingMessageCid
            senderInputCids = [toInterfaceContractId senderHolding]
            amount = 5.0
            rmnRemoteCid = rmnRemote
            extraContext = mkPoolContext outboundRateLimiter (toInterfaceContractId transferFactory) []
            caller = sender

    Some sm <- queryContractId ccipOwner result.sendingMessageCid
    let tokenSendData = fromSome sm.tokenSendData
    -- 5% feeBps deducted from bridged amount.
    tokenSendData.amount === 47500000000.0

    debug "testLockOrBurnDeductsFeeBps: PASSED"

-- | Test ReleaseFromTicket transfers tokens from pool to receiver.
testReleaseFromTicket : Script ()
testReleaseFromTicket = script do
    ccipOwner <- allocateParty "ccip-owner"
    rmnOwner <- allocateParty "rmn-owner"
    poolOwner <- allocateParty "pool-owner"
    receiver <- allocateParty "receiver"

    let tokenAdminRegistryInstanceId = "test-tar-release"
    let tokenPoolInstanceId = "test-lock-release-pool-release"

    let sourceChainSelector : Numeric 0 = 123.0

    let testInstrumentId = HoldingV1.InstrumentId with
            admin = ccipOwner
            id = "TestToken"

    -- Create pool's token holding (10 tokens)
    poolHolding <- submit (actAs poolOwner <> actAs ccipOwner) do
        createCmd TestToken.TestHolding with
            owner = poolOwner
            admin = ccipOwner
            instrumentId = testInstrumentId
            amount = 10.0

    -- Create preapproval for receiver
    receiverPreapproval <- submit (actAs receiver <> actAs ccipOwner) do
        createCmd TestToken.TestTransferPreapproval with
            admin = ccipOwner
            receiver = receiver

    -- Create TransferFactory with receiver's preapproval
    transferFactory <- submit ccipOwner do
        createCmd TestToken.TestTransferFactory with
            admin = ccipOwner
            preapprovalCid = Some receiverPreapproval

    -- Deploy TokenAdminRegistry and register pool
    (tokenAdminRegistry, tokenConfigCid) <- setupTokenAdminRegistryWithPool
        ccipOwner
        poolOwner
        tokenAdminRegistryInstanceId
        testInstrumentId
        tokenPoolInstanceId

    -- Deploy RMNRemote
    rmnRemote <- submit rmnOwner do
        createCmd RMNRemote.RMNRemote with
            instanceId = "test-rmn-release"
            rmnOwner = rmnOwner
            ccipOwner = ccipOwner
            customObservers = []
            cursedSubjects = []

    (inboundRateLimiter, inboundRateLimiterAddr) <- createRateLimiter
        poolOwner
        tokenPoolInstanceId
        sourceChainSelector
        RateLimiter.RateLimitDirection_Inbound
        100000000000.0
        10000000.0

    -- Deploy LockReleaseTokenPool with remote chain config for inbound
    let existingConfig = LockReleaseTokenPool.RemoteChainConfig with
            remotePools = ["d2ff32a3f0bb7b9b5afcfbaaa9ae629449ef2ff0"]
            remoteTokenAddress = "dde9af410cc4f737a136d87d3d4a4deeff1d26fc"
            inboundCCVs = []
            outboundCCVs = []
            finalityConfig = finalityConfig 0
            inboundRateLimiter = inboundRateLimiterAddr
            inboundCustomBlockConfirmationsRateLimiter = inboundRateLimiterAddr
            outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-out@owner" -- placeholder
    tokenPool <- submit poolOwner do
        createCmd LockReleaseTokenPool.LockReleaseTokenPool with
            poolOwner = poolOwner
            ccipOwner = ccipOwner
            instanceId = tokenPoolInstanceId
            instrumentId = testInstrumentId
            decimals = 10
            rateLimitAdmin = None
            remoteChainConfigs = Map.fromList [(sourceChainSelector, existingConfig)]
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = MetadataV1.emptyChoiceContext
            transferTimeout = LockReleaseTokenPool.Indefinite
            deps = mkPoolDeps tokenAdminRegistryInstanceId "test-rmn-release" "test-feequoter-release" ccipOwner rmnOwner

    -- Create TokenReceiveTicket (simulating what OffRamp creates via finalize)
    tokenReceiveTicket <- submit ccipOwner do
        createCmd Tickets.TokenReceiveTicket with
            tokenAdminRegistryInstanceId = tokenAdminRegistryInstanceId
            ccipOwner = ccipOwner
            ccvOwners = []
            verifiedCCVs = []
            requiredInboundPoolCCVs = []
            poolOwner = poolOwner
            receiver = receiver
            tokenReceiver = receiver
            instrumentId = testInstrumentId
            amount = 30000000000.0
            sourcePoolData = ""
            messageId = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            sourceChainSelector = sourceChainSelector
            finality = finalityConfig 0

    -- Disclose contracts
    disclosedPool <- fromSome <$> queryDisclosure poolOwner tokenPool
    disclosedPoolHolding <- fromSome <$> queryDisclosure poolOwner poolHolding
    disclosedTar <- fromSome <$> queryDisclosure ccipOwner tokenAdminRegistry
    disclosedTokenConfig <- fromSome <$> queryDisclosure ccipOwner tokenConfigCid
    disclosedFactory <- fromSome <$> queryDisclosure ccipOwner transferFactory
    disclosedPreapproval <- fromSome <$> queryDisclosure receiver receiverPreapproval
    disclosedRmn <- fromSome <$> queryDisclosure rmnOwner rmnRemote
    disclosedRateLimiter <- fromSome <$> queryDisclosure poolOwner inboundRateLimiter
    disclosedTicket <- fromSome <$> queryDisclosure ccipOwner tokenReceiveTicket

    -- Call ReleaseFromTicket
    result <- submit (actAs receiver
                      <> disclose disclosedPool <> disclose disclosedPoolHolding <> disclose disclosedTar <> disclose disclosedTokenConfig <> disclose disclosedFactory
                      <> disclose disclosedPreapproval <> disclose disclosedRmn
                      <> disclose disclosedRateLimiter <> disclose disclosedTicket) do
        exerciseCmd tokenPool LockReleaseTokenPool.ReleaseFromTicket with
            tokenReceiveTicketCid = tokenReceiveTicket
            tokenAdminRegistryCid = tokenAdminRegistry
            tokenConfigCid = tokenConfigCid
            rmnRemoteCid = rmnRemote
            extraContext = mkPoolContext inboundRateLimiter (toInterfaceContractId transferFactory) [toInterfaceContractId poolHolding]
            caller = receiver

    -- Verify result is completed
    case result.output of
        ITokenPool.ReleaseOrMintResult_Completed receiverCids -> do
            assertMsg "Receiver should have 1 holding" (length receiverCids == 1)
            receiverHolding <- queryContractId receiver (fromInterfaceContractId @TestToken.TestHolding (head receiverCids))
            assertMsg "Receiver holding should exist" (isSome receiverHolding)
            let receiverH = fromSome receiverHolding
            receiverH.amount === 3.0
            receiverH.owner === receiver
        _ -> abort "Expected completed result"

    claimedEvent <- queryContractId receiver result.claimedEventCid
    assertMsg "Claimed event should exist" (isSome claimedEvent)
    let claimed = fromSome claimedEvent
    claimed.tokenReceiveTicketCid === tokenReceiveTicket
    claimed.event.messageId === "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    case claimed.event.output of
        Events.TokenReceiveTicketClaimed_Completed receiverCids ->
            length receiverCids === 1
        _ -> abort "Expected completed claimed event output"

    -- Verify pool got change (7 tokens)
    assertMsg "Pool should have 1 change holding" (length result.poolChangeCids == 1)
    poolChange <- queryContractId poolOwner (fromInterfaceContractId @TestToken.TestHolding (head result.poolChangeCids))
    assertMsg "Pool change should exist" (isSome poolChange)
    let poolC = fromSome poolChange
    poolC.amount === 7.0
    poolC.owner === poolOwner

    debug "testReleaseFromTicket: PASSED"

-- | Test ReleaseFromTicket remains valid after post-ticket inbound CCV config drift.
-- The release path must use ticket.requiredInboundPoolCCVs, not current pool config.
testReleaseFromTicketIgnoresPostTicketInboundConfigDrift : Script ()
testReleaseFromTicketIgnoresPostTicketInboundConfigDrift = script do
    ccipOwner <- allocateParty "ccip-owner-release-drift"
    rmnOwner <- allocateParty "rmn-owner-release-drift"
    poolOwner <- allocateParty "pool-owner-release-drift"
    receiver <- allocateParty "receiver-release-drift"
    ccvOwner <- allocateParty "ccv-owner-release-drift"

    let rmnInstanceId = "test-rmn-release-drift"
    let tokenAdminRegistryInstanceId = "test-tar-release-drift"
    let tokenPoolInstanceId = "test-lock-release-pool-drift"
    let sourceChainSelector : Numeric 0 = 123.0

    let requiredCcv = RawInstanceAddress.make "required-ccv-drift" ccipOwner
    let driftCcv = RawInstanceAddress.make "drift-ccv" ccvOwner

    let testInstrumentId = HoldingV1.InstrumentId with
            admin = ccipOwner
            id = "TestToken"

    poolHolding <- submit (actAs poolOwner <> actAs ccipOwner) do
        createCmd TestToken.TestHolding with
            owner = poolOwner
            admin = ccipOwner
            instrumentId = testInstrumentId
            amount = 10.0

    receiverPreapproval <- submit (actAs receiver <> actAs ccipOwner) do
        createCmd TestToken.TestTransferPreapproval with
            admin = ccipOwner
            receiver = receiver

    transferFactory <- submit ccipOwner do
        createCmd TestToken.TestTransferFactory with
            admin = ccipOwner
            preapprovalCid = Some receiverPreapproval

    (tokenAdminRegistry, tokenConfigCid) <- setupTokenAdminRegistryWithPool
        ccipOwner
        poolOwner
        tokenAdminRegistryInstanceId
        testInstrumentId
        tokenPoolInstanceId

    rmnRemote <- submit rmnOwner do
        createCmd RMNRemote.RMNRemote with
            instanceId = rmnInstanceId
            rmnOwner = rmnOwner
            ccipOwner = ccipOwner
            customObservers = []
            cursedSubjects = []

    (inboundRateLimiter, inboundRateLimiterAddr) <- createRateLimiter
        poolOwner
        tokenPoolInstanceId
        sourceChainSelector
        RateLimiter.RateLimitDirection_Inbound
        100000000000.0
        10000000.0

    let remotePools = ["d2ff32a3f0bb7b9b5afcfbaaa9ae629449ef2ff0"]
    let remoteTokenAddress = "dde9af410cc4f737a136d87d3d4a4deeff1d26fc"
    let initialConfig = LockReleaseTokenPool.RemoteChainConfig with
            remotePools = remotePools
            remoteTokenAddress = remoteTokenAddress
            inboundCCVs = []
            outboundCCVs = []
            finalityConfig = finalityConfig 0
            inboundRateLimiter = inboundRateLimiterAddr
            inboundCustomBlockConfirmationsRateLimiter = inboundRateLimiterAddr
            outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-out@owner"

    tokenPool <- submit poolOwner do
        createCmd LockReleaseTokenPool.LockReleaseTokenPool with
            poolOwner = poolOwner
            ccipOwner = ccipOwner
            instanceId = tokenPoolInstanceId
            instrumentId = testInstrumentId
            decimals = 10
            rateLimitAdmin = None
            remoteChainConfigs = Map.fromList [(sourceChainSelector, initialConfig)]
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = MetadataV1.emptyChoiceContext
            transferTimeout = LockReleaseTokenPool.Indefinite
            deps = mkPoolDeps tokenAdminRegistryInstanceId rmnInstanceId "test-feequoter-release-drift" ccipOwner rmnOwner

    tokenReceiveTicket <- submit (actAs ccipOwner <> actAs ccvOwner) do
        createCmd Tickets.TokenReceiveTicket with
            tokenAdminRegistryInstanceId = tokenAdminRegistryInstanceId
            ccipOwner = ccipOwner
            ccvOwners = []
            verifiedCCVs = [requiredCcv]
            requiredInboundPoolCCVs = [requiredCcv]
            poolOwner = poolOwner
            receiver = receiver
            tokenReceiver = receiver
            instrumentId = testInstrumentId
            amount = 30000000000.0
            sourcePoolData = ""
            messageId = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
            sourceChainSelector = sourceChainSelector
            finality = finalityConfig 0

    let driftUpdate = LockReleaseTokenPool.ChainUpdate with
            remoteChainSelector = sourceChainSelector
            remotePools = remotePools
            remoteTokenAddress = remoteTokenAddress
            inboundCCVs = [driftCcv]
            outboundCCVs = []
            finalityConfig = finalityConfig 0
            inboundRateLimiter = inboundRateLimiterAddr
            inboundCustomBlockConfirmationsRateLimiter = inboundRateLimiterAddr
            outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-out@owner"
    tokenPool <- submit poolOwner do
        exerciseCmd tokenPool LockReleaseTokenPool.ApplyChainUpdates with
            remoteChainSelectorsToRemove = [sourceChainSelector]
            chainsToAdd = [driftUpdate]

    disclosedPool <- fromSome <$> queryDisclosure poolOwner tokenPool
    disclosedPoolHolding <- fromSome <$> queryDisclosure poolOwner poolHolding
    disclosedTar <- fromSome <$> queryDisclosure ccipOwner tokenAdminRegistry
    disclosedTokenConfig <- fromSome <$> queryDisclosure ccipOwner tokenConfigCid
    disclosedFactory <- fromSome <$> queryDisclosure ccipOwner transferFactory
    disclosedPreapproval <- fromSome <$> queryDisclosure receiver receiverPreapproval
    disclosedRmn <- fromSome <$> queryDisclosure rmnOwner rmnRemote
    disclosedRateLimiter <- fromSome <$> queryDisclosure poolOwner inboundRateLimiter
    disclosedTicket <- fromSome <$> queryDisclosure ccipOwner tokenReceiveTicket

    result <- submit (actAs receiver
                      <> disclose disclosedPool <> disclose disclosedPoolHolding <> disclose disclosedTar <> disclose disclosedTokenConfig <> disclose disclosedFactory
                      <> disclose disclosedPreapproval <> disclose disclosedRmn
                      <> disclose disclosedRateLimiter <> disclose disclosedTicket) do
        exerciseCmd tokenPool LockReleaseTokenPool.ReleaseFromTicket with
            tokenReceiveTicketCid = tokenReceiveTicket
            tokenAdminRegistryCid = tokenAdminRegistry
            tokenConfigCid = tokenConfigCid
            rmnRemoteCid = rmnRemote
            extraContext = mkPoolContext inboundRateLimiter (toInterfaceContractId transferFactory) [toInterfaceContractId poolHolding]
            caller = receiver

    case result.output of
        ITokenPool.ReleaseOrMintResult_Completed receiverCids -> do
            assertMsg "receiver should receive one holding" (length receiverCids == 1)
        _ -> abort "Expected completed result despite config drift"

    debug "testReleaseFromTicketIgnoresPostTicketInboundConfigDrift: PASSED"

-- | Test ReleaseFromTicket enforces exact required inbound CCV instances from the
-- ticket snapshot, even when another CCV instance shares the same owner party.
testReleaseFromTicketRejectsWrongCCVInstance : Script ()
testReleaseFromTicketRejectsWrongCCVInstance = script do
    ccipOwner <- allocateParty "ccip-owner-instance"
    rmnOwner <- allocateParty "rmn-owner-instance"
    poolOwner <- allocateParty "pool-owner-instance"
    receiver <- allocateParty "receiver-instance"
    ccvOwner <- allocateParty "ccv-owner-instance"

    let rmnInstanceId = "test-rmn-release-instance-instance"
    let tokenAdminRegistryInstanceId = "test-tar-release-instance"
    let tokenPoolInstanceId = "test-lock-release-pool-instance"

    let sourceChainSelector : Numeric 0 = 123.0

    let requiredCcv = RawInstanceAddress.make "required-ccv" ccvOwner
    let otherCcv = RawInstanceAddress.make "other-ccv" ccvOwner

    let testInstrumentId = HoldingV1.InstrumentId with
            admin = ccipOwner
            id = "TestToken"

    poolHolding <- submit (actAs poolOwner <> actAs ccipOwner) do
        createCmd TestToken.TestHolding with
            owner = poolOwner
            admin = ccipOwner
            instrumentId = testInstrumentId
            amount = 10.0

    receiverPreapproval <- submit (actAs receiver <> actAs ccipOwner) do
        createCmd TestToken.TestTransferPreapproval with
            admin = ccipOwner
            receiver = receiver

    transferFactory <- submit ccipOwner do
        createCmd TestToken.TestTransferFactory with
            admin = ccipOwner
            preapprovalCid = Some receiverPreapproval

    (tokenAdminRegistry, tokenConfigCid) <- setupTokenAdminRegistryWithPool
        ccipOwner
        poolOwner
        tokenAdminRegistryInstanceId
        testInstrumentId
        tokenPoolInstanceId

    rmnRemote <- submit rmnOwner do
        createCmd RMNRemote.RMNRemote with
            instanceId = rmnInstanceId
            rmnOwner = rmnOwner
            ccipOwner = ccipOwner
            customObservers = []
            cursedSubjects = []

    (inboundRateLimiter, inboundRateLimiterAddr) <- createRateLimiter
        poolOwner
        tokenPoolInstanceId
        sourceChainSelector
        RateLimiter.RateLimitDirection_Inbound
        100000000000.0
        10000000.0

    let existingConfig = LockReleaseTokenPool.RemoteChainConfig with
            remotePools = ["d2ff32a3f0bb7b9b5afcfbaaa9ae629449ef2ff0"]
            remoteTokenAddress = "dde9af410cc4f737a136d87d3d4a4deeff1d26fc"
            inboundCCVs = []
            outboundCCVs = []
            finalityConfig = finalityConfig 0
            inboundRateLimiter = inboundRateLimiterAddr
            inboundCustomBlockConfirmationsRateLimiter = inboundRateLimiterAddr
            outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-out@owner"
    tokenPool <- submit poolOwner do
        createCmd LockReleaseTokenPool.LockReleaseTokenPool with
            poolOwner = poolOwner
            ccipOwner = ccipOwner
            instanceId = tokenPoolInstanceId
            instrumentId = testInstrumentId
            decimals = 10
            rateLimitAdmin = None
            remoteChainConfigs = Map.fromList [(sourceChainSelector, existingConfig)]
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = MetadataV1.emptyChoiceContext
            transferTimeout = LockReleaseTokenPool.Indefinite
            deps = mkPoolDeps tokenAdminRegistryInstanceId rmnInstanceId "test-feequoter-release-instance" ccipOwner rmnOwner

    tokenReceiveTicket <- submit (actAs ccipOwner <> actAs ccvOwner) do
        createCmd Tickets.TokenReceiveTicket with
            tokenAdminRegistryInstanceId = tokenAdminRegistryInstanceId
            ccipOwner = ccipOwner
            ccvOwners = [ccvOwner]
            verifiedCCVs = [otherCcv]
            requiredInboundPoolCCVs = [requiredCcv]
            poolOwner = poolOwner
            receiver = receiver
            tokenReceiver = receiver
            instrumentId = testInstrumentId
            amount = 30000000000.0
            sourcePoolData = ""
            messageId = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
            sourceChainSelector = sourceChainSelector
            finality = finalityConfig 0

    disclosedPool <- fromSome <$> queryDisclosure poolOwner tokenPool
    disclosedPoolHolding <- fromSome <$> queryDisclosure poolOwner poolHolding
    disclosedTar <- fromSome <$> queryDisclosure ccipOwner tokenAdminRegistry
    disclosedTokenConfig <- fromSome <$> queryDisclosure ccipOwner tokenConfigCid
    disclosedFactory <- fromSome <$> queryDisclosure ccipOwner transferFactory
    disclosedPreapproval <- fromSome <$> queryDisclosure receiver receiverPreapproval
    disclosedRmn <- fromSome <$> queryDisclosure rmnOwner rmnRemote
    disclosedRateLimiter <- fromSome <$> queryDisclosure poolOwner inboundRateLimiter

    submitMustFail (actAs receiver
                    <> disclose disclosedPool <> disclose disclosedPoolHolding <> disclose disclosedTar <> disclose disclosedTokenConfig <> disclose disclosedFactory
                    <> disclose disclosedPreapproval <> disclose disclosedRmn
                    <> disclose disclosedRateLimiter) do
        exerciseCmd tokenPool LockReleaseTokenPool.ReleaseFromTicket with
            tokenReceiveTicketCid = tokenReceiveTicket
            tokenAdminRegistryCid = tokenAdminRegistry
            tokenConfigCid = tokenConfigCid
            rmnRemoteCid = rmnRemote
            extraContext = mkPoolContext inboundRateLimiter (toInterfaceContractId transferFactory) [toInterfaceContractId poolHolding]
            caller = receiver

-- | Test ReleaseFromTicket converts source decimals to local decimals.
testReleaseFromTicketDecimalConversion : Script ()
testReleaseFromTicketDecimalConversion = script do
    ccipOwner <- allocateParty "ccip-owner-decimals"
    rmnOwner <- allocateParty "rmn-owner-decimals"
    poolOwner <- allocateParty "pool-owner-decimals"
    receiver <- allocateParty "receiver-decimals"

