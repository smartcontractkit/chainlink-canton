-- | Test VerifyInboundMessage fails when sourceTokenAddress does not match
-- the configured remoteTokenAddress for the source chain.
testVerifyInboundMessage_RejectsMismatchedSourceToken : Script ()
testVerifyInboundMessage_RejectsMismatchedSourceToken = script do
    ccipOwner <- allocateParty "ccip-owner-mismatch"
    poolOwner <- allocateParty "pool-owner-mismatch"
    receiver <- allocateParty "receiver-mismatch"

