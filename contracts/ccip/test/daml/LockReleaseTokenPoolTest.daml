-- M-6: when pool custom fees are absent, CalculateFee falls back to FeeQuoter's
-- per-destination token transfer fee config.
testCalculateFeeFallsBackToFeeQuoter : Script ()
testCalculateFeeFallsBackToFeeQuoter = script do
    ccipOwner <- allocateParty "ccip-owner-fee-fallback"
    poolOwner <- allocateParty "pool-owner-fee-fallback"
    sender <- allocateParty "sender-fee-fallback"

    let destChainSelector : Numeric 0 = 456.0
    let sourceChainSelector : Numeric 0 = 123.0
    let feeTokenId = HoldingV1.InstrumentId with
            admin = ccipOwner
            id = "LINK"
    let testInstrumentId = HoldingV1.InstrumentId with
            admin = ccipOwner
            id = "TestToken"

    feeQuoter <- submit ccipOwner do
        createCmd FeeQuoter.FeeQuoter with
            owner = ccipOwner
            instanceId = "test-feequoter-fallback"
            feeTokens = Map.fromList [(feeTokenId, 100000000.0)]
            destChainConfigs = Map.fromList [(destChainSelector, FeeQuoter.DestChainConfig with
                isEnabled = True
                maxDataBytes = 100000
                maxPerMsgGasLimit = 5000000
                destGasOverhead = 0
                destGasPerPayloadByteBase = 0
                chainFamilySelector = "2812d52c"
                defaultTxGasLimit = 200000
                networkFeeUSD = usdToCents 0.0
                defaultTokenFeeUSD = usdToCents 0.5
                defaultTokenDestGasOverhead = 11111)]
            tokenTransferFeeConfigs = Map.fromList [(destChainSelector, Map.fromList [(testInstrumentId, FeeQuoter.TokenTransferFeeConfig with
                isEnabled = True
                feeUSD = usdToCents 3.0
                destGasOverhead = 70000
                destBytesOverhead = 64)])]
            usdPerUnitGasByDestChainSelector = Map.empty
            usdPerToken = Map.fromList [(feeTokenId, FeeQuoter.TimestampedPrice 1500000000.0 (time (date 2026 Jan 1) 0 0 0))]
            linkTokenInstrumentId = feeTokenId
            maxFeeJuelsPerMsg = 1000000000000000000000000.0
            priceUpdaters = [ccipOwner]

    tokenAdminRegistry <- submit ccipOwner do
        createCmd TokenAdminRegistry.TokenAdminRegistry with
            owner = ccipOwner
            instanceId = "test-tar-fallback"
            tokenConfigs = Map.empty

    tokenAdminRegistry <- submit ccipOwner do
        exerciseCmd tokenAdminRegistry TokenAdminRegistry.TokenAdminRegistry_ProposeAdministrator with
            instrumentId = testInstrumentId
            newAdmin = poolOwner
            caller = ccipOwner

    disclosedTar1 <- fromSome <$> queryDisclosure ccipOwner tokenAdminRegistry
    tokenAdminRegistry <- submit (actAs poolOwner <> disclose disclosedTar1) do
        exerciseCmd tokenAdminRegistry TokenAdminRegistry.TokenAdminRegistry_AcceptAdminRole with
            instrumentId = testInstrumentId
            caller = poolOwner

    disclosedTar2 <- fromSome <$> queryDisclosure ccipOwner tokenAdminRegistry
    tokenAdminRegistry <- submit (actAs poolOwner <> disclose disclosedTar2) do
        exerciseCmd tokenAdminRegistry TokenAdminRegistry.TokenAdminRegistry_SetPool with
            instrumentId = testInstrumentId
            tokenPool = Some TokenAdminRegistryTypes.PoolRegistration with
                poolOwner = poolOwner
                poolInstanceId = "test-lock-release-pool-fallback"
            caller = poolOwner

    -- Create token pool
    let existingConfig = LockReleaseTokenPool.RemoteChainConfig with
            remotePools = ["000000000000000000000000aaaaaaaaaaaaaaaa"]
            remoteTokenAddress = "dde9af410cc4f737a136d87d3d4a4deeff1d26fc"
            inboundCCVs = []
            outboundCCVs = []
            minBlockConfirmations = 0
            inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-in@owner" -- placeholder
            inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-in@owner" -- placeholder
            outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "rate-limiter-out@owner" -- placeholder
    tokenPool <- submit poolOwner do
        createCmd LockReleaseTokenPool.LockReleaseTokenPool with
            ccipOwner = ccipOwner
            poolOwner = poolOwner
            instanceId = "test-lock-release-pool-fallback"
            instrumentId = testInstrumentId
            decimals = 6
            remoteChainConfigs = Map.fromList [(sourceChainSelector, existingConfig)]
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = CCIP.Context.emptyCCIPContext
            transferTimeout = LockReleaseTokenPool.Indefinite
            deps = mkPoolDeps "test-tar-fallback" "test-rmn-fallback" "test-feequoter-fallback" ccipOwner ccipOwner

    let senderAddr = MessageCodecV1.encodePartyAddress sender
    sendingMessageCid <- submit ccipOwner do
        createCmd SendingMessageV1.SendingMessageV1 with
            ccipOwner = ccipOwner
            sender = sender
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "test-router-fallback" sender
                onRamp = RawInstanceAddress.make "test-onramp-fallback" ccipOwner
                globalConfig = RawInstanceAddress.make "test-globalconfig-fallback" ccipOwner
                rmnRemote = RawInstanceAddress.make "test-rmn-fallback" ccipOwner
                tokenAdminRegistry = RawInstanceAddress.make "test-tar-fallback" ccipOwner
                feeQuoter = RawInstanceAddress.make "test-feequoter-fallback" ccipOwner
            destChainSelector = destChainSelector
            sequenceNumber = 1.0
            requiredCCVs = []
            executorAddress = RawInstanceAddress.make "default-executor-fallback" ccipOwner
            sourceChainSelector = sourceChainSelector
            senderAddress = senderAddr
            receiver = "0000000000000000000000000000000000000001"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 100000
            ccvAndExecutorHash = ""
            onRampAddress = "0000000000000000000000000000000000000001"
            offRampAddress = "0000000000000000000000000000000000000002"
            tokenReceiver = "0000000000000000000000000000000000000001"
            tokenArgs = ""
            message = None
            encodedMessage = ""
            messageId = ""
            feeToken = feeTokenId
            networkFeeUSDCents = cents 0.0
            expectedTokenInstrumentId = Some testInstrumentId
            outboundPoolCCVs = Some []
            executorArgs = ""
            executorFee = None
            executorFeeTokenAmount = 0.0
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            verifierData = []
            ccvOwners = []
            tokenSendData = None
            observingParties = [sender]
            state = SendingMessageV1.SendingMessageState_Prepared

    disclosedPool <- fromSome <$> queryDisclosure poolOwner tokenPool
    disclosedTar <- fromSome <$> queryDisclosure ccipOwner tokenAdminRegistry
    disclosedFq <- fromSome <$> queryDisclosure ccipOwner feeQuoter
    disclosedSm <- fromSome <$> queryDisclosure ccipOwner sendingMessageCid
    sendingMessageCid <- submit (actAs sender <> disclose disclosedPool <> disclose disclosedTar <> disclose disclosedFq <> disclose disclosedSm) do
        exerciseCmd (toInterfaceContractId @ITokenPool.ITokenPool tokenPool)
            ITokenPool.TokenPool_CalculateFee with
                tokenAdminRegistryCid = tokenAdminRegistry
                sendingMessageCid = sendingMessageCid
                feeQuoterCid = feeQuoter
                tokenInstrumentId = testInstrumentId
                caller = sender

    Some sm <- queryContractId ccipOwner sendingMessageCid
    let tokenSendFee = fromSome sm.tokenSendFee
    tokenSendFee.feeUSDCents === usdToCents 3.0
    tokenSendFee.destGasOverhead === 70000
    tokenSendFee.destBytesOverhead === 64

    debug "testCalculateFeeFallsBackToFeeQuoter: PASSED"

-- M-6: enabled pool fee config overrides FeeQuoter fallback config.
testCalculateFeePrefersPoolOverride : Script ()
testCalculateFeePrefersPoolOverride = script do
    ccipOwner <- allocateParty "ccip-owner-pool-override"
    poolOwner <- allocateParty "pool-owner-pool-override"
    sender <- allocateParty "sender-pool-override"

    let destChainSelector : Numeric 0 = 456.0
    let feeTokenId = HoldingV1.InstrumentId with
            admin = ccipOwner
            id = "LINK"
    let testInstrumentId = HoldingV1.InstrumentId with
            admin = ccipOwner
            id = "TestToken"

    feeQuoter <- submit ccipOwner do
        createCmd FeeQuoter.FeeQuoter with
            owner = ccipOwner
            instanceId = "test-feequoter-pool-override"
            feeTokens = Map.fromList [(feeTokenId, 100000000.0)]
            destChainConfigs = Map.fromList [(destChainSelector, FeeQuoter.DestChainConfig with
                isEnabled = True
                maxDataBytes = 100000
                maxPerMsgGasLimit = 5000000
                destGasOverhead = 0
                destGasPerPayloadByteBase = 0
                chainFamilySelector = "2812d52c"
                defaultTxGasLimit = 200000
                networkFeeUSD = usdToCents 0.0
                defaultTokenFeeUSD = usdToCents 0.5
                defaultTokenDestGasOverhead = 11111)]
            tokenTransferFeeConfigs = Map.fromList [(destChainSelector, Map.fromList [(testInstrumentId, FeeQuoter.TokenTransferFeeConfig with
                isEnabled = True
                feeUSD = usdToCents 9.0
                destGasOverhead = 90000
                destBytesOverhead = 96)])]
            usdPerUnitGasByDestChainSelector = Map.empty
            usdPerToken = Map.fromList [(feeTokenId, FeeQuoter.TimestampedPrice 1500000000.0 (time (date 2026 Jan 1) 0 0 0))]
            linkTokenInstrumentId = feeTokenId
