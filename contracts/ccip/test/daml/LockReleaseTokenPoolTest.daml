        exerciseCmd tokenAdminRegistry TokenAdminRegistry.TokenAdminRegistry_SetPool with
            instrumentId = testInstrumentId
            tokenPool = Some TokenAdminRegistryTypes.PoolRegistration with
                poolOwner = poolOwner
                poolInstanceId = "test-pool-verify-nochain"
            caller = poolOwner

    -- Deploy pool with config for sourceChainSelector only (not unconfiguredChainSelector)
    tokenPool <- submit poolOwner do
        createCmd LockReleaseTokenPool.LockReleaseTokenPool with
            ccipOwner = ccipOwner
            poolOwner = poolOwner
            instanceId = "test-pool-verify-nochain"
            instrumentId = testInstrumentId
            decimals = 6
            chainPoolConfigs = Map.fromList [(sourceChainSelector, LockReleaseTokenPool.ChainPoolConfig with
                inboundCCVs = []
                outboundCCVs = []
