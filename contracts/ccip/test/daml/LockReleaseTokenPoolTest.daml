-- M-6: FeeQuoter should fall back to destination-chain defaults when no token-specific config exists.
testFeeQuoterGetTokenTransferFee_Defaults : Script ()
testFeeQuoterGetTokenTransferFee_Defaults = script do
    owner <- allocateParty "owner-feequoter-defaults"
    let destChainSelector : Numeric 0 = 456.0
    let linkToken = HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"
    let testInstrumentId = HoldingV1.InstrumentId with
            admin = owner
            id = "TestToken"

    feeQuoter <- submit owner do
        createCmd FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter-defaults"
            feeTokens = Map.fromList [(linkToken, 100000000.0)]
            destChainConfigs = Map.fromList [(destChainSelector, FeeQuoter.DestChainConfig with
                isEnabled = True
                maxDataBytes = 100000
                maxPerMsgGasLimit = 5000000
                destGasOverhead = 0
                destGasPerPayloadByteBase = 0
                chainFamilySelector = "2812d52c"
                defaultTxGasLimit = 200000
                networkFeeUSD = usdToCents 0.0
                defaultTokenFeeUSD = usdToCents 0.75
                defaultTokenDestGasOverhead = 12345)]
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.empty
            usdPerToken = Map.fromList [(linkToken, FeeQuoter.TimestampedPrice 1500000000.0 (time (date 2026 Jan 1) 0 0 0))]
            linkTokenInstrumentId = linkToken
            maxFeeJuelsPerMsg = 1000000000000000000000000.0
            priceUpdaters = [owner]

    (feeUSD, destGasOverhead, destBytesOverhead) <- submit owner do
        exerciseCmd feeQuoter FeeQuoter.FeeQuoter_GetTokenTransferFee with
            destChainSelector = destChainSelector
            token = testInstrumentId
            caller = owner

    feeUSD === usdToCents 0.75
    destGasOverhead === 12345
    destBytesOverhead === 32

    debug "testFeeQuoterGetTokenTransferFee_Defaults: PASSED"

-- M-6: FeeQuoter token transfer fee config is destination-chain specific.
testFeeQuoterGetTokenTransferFee_PerDestination : Script ()
testFeeQuoterGetTokenTransferFee_PerDestination = script do
    owner <- allocateParty "owner-feequoter-per-dest"
    let destChainSelector1 : Numeric 0 = 456.0
    let destChainSelector2 : Numeric 0 = 789.0
    let linkToken = HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"
    let testInstrumentId = HoldingV1.InstrumentId with
            admin = owner
            id = "TestToken"

    feeQuoter <- submit owner do
        createCmd FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter-per-dest"
            feeTokens = Map.fromList [(linkToken, 100000000.0)]
            destChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.fromList
                [ (destChainSelector1, Map.fromList [(testInstrumentId, FeeQuoter.TokenTransferFeeConfig with
                    isEnabled = True
                    feeUSD = usdToCents 1.0
                    destGasOverhead = 10000
                    destBytesOverhead = 32)])
                , (destChainSelector2, Map.fromList [(testInstrumentId, FeeQuoter.TokenTransferFeeConfig with
                    isEnabled = True
                    feeUSD = usdToCents 2.0
                    destGasOverhead = 20000
                    destBytesOverhead = 64)])
                ]
            usdPerUnitGasByDestChainSelector = Map.empty
            usdPerToken = Map.fromList [(linkToken, FeeQuoter.TimestampedPrice 1500000000.0 (time (date 2026 Jan 1) 0 0 0))]
            linkTokenInstrumentId = linkToken
            maxFeeJuelsPerMsg = 1000000000000000000000000.0
            priceUpdaters = [owner]

    (fee1, gas1, bytes1) <- submit owner do
        exerciseCmd feeQuoter FeeQuoter.FeeQuoter_GetTokenTransferFee with
            destChainSelector = destChainSelector1
            token = testInstrumentId
            caller = owner
    (fee2, gas2, bytes2) <- submit owner do
        exerciseCmd feeQuoter FeeQuoter.FeeQuoter_GetTokenTransferFee with
            destChainSelector = destChainSelector2
            token = testInstrumentId
            caller = owner

    fee1 === usdToCents 1.0
    gas1 === 10000
    bytes1 === 32
    fee2 === usdToCents 2.0
    gas2 === 20000
    bytes2 === 64

    debug "testFeeQuoterGetTokenTransferFee_PerDestination: PASSED"

testLockReleaseTokenPool_ApplyChainUpdates : Script ()
testLockReleaseTokenPool_ApplyChainUpdates = script do
    owner <- allocateParty "owner"
    ccipOwner <- allocateParty "ccip-owner"
    let instanceId = "lnr-tp-1"

    -- | Create LockReleaseTokenPool without any remote chain configs
    tokenPoolCid <- submit owner do
        createCmd LockReleaseTokenPool.LockReleaseTokenPool with
            ccipOwner = ccipOwner
            poolOwner = owner
            instanceId = "test-lock-release-pool"
            instrumentId = HoldingV1.InstrumentId with
                admin = ccipOwner
                id = "LINK"
            decimals = 8
            remoteChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = CCIP.Context.emptyCCIPContext
            transferTimeout = LockReleaseTokenPool.Indefinite
            deps = mkPoolDeps "test-tar" "test-rmn" "test-feequoter-pool" ccipOwner ccipOwner

    -- | ======== Test 1 ========
    -- | Add multiple chain configs
    -- | ========================
    let remoteChainSelectorsToRemove1 = []
        chainsToAdd1 = [
            LockReleaseTokenPool.ChainUpdate with
                remoteChainSelector = 123.0
                remotePools = []
                remoteTokenAddress = "f43dc4783082e7f5ceb0f5e3bdff4a9acc3b0ace"
                inboundCCVs = []
                outboundCCVs = []
                minBlockConfirmations = 0
                inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"
            ,LockReleaseTokenPool.ChainUpdate with
                remoteChainSelector = 456.0
                remotePools = ["11111111"]
                remoteTokenAddress = "cf383e3c65a8f8ec69b3a4fbdf0ceed7de4cd6a2cdf1ff6f82fa2eb3addf7b2e960f"
                inboundCCVs = []
                outboundCCVs = []
                minBlockConfirmations = 0
                inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"
            ]
    tokenPoolCid <- submit owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.ApplyChainUpdates with
            remoteChainSelectorsToRemove = remoteChainSelectorsToRemove1
            chainsToAdd = chainsToAdd1
    -- Fetch the updated TokenPool and verify the chain configs were added correctly
    tokenPool <- fromSome <$> queryContractId owner tokenPoolCid
    assertMsg "Expected 2 remote chain configs" (Map.size tokenPool.remoteChainConfigs == 2)
    case Map.lookup 123.0 tokenPool.remoteChainConfigs of
        None -> assertMsg "Missing chain config for selector 123.0" False
        Some config -> assertChainUpdateEqual config (head chainsToAdd1)
    case Map.lookup 456.0 tokenPool.remoteChainConfigs of
        None -> assertMsg "Missing chain config for selector 456.0" False
        Some config -> assertChainUpdateEqual config (chainsToAdd1 !! 1)

    -- | ======== Test 2 ========
    -- | Update an existing and add a new chain config
    -- | ========================
    let remoteChainSelectorsToRemove2 = [456.0] -- remove the chain config for 456.0 so we can test that it gets replaced with the updated config
        chainsToAdd2 = [
            LockReleaseTokenPool.ChainUpdate with
                remoteChainSelector = 456.0
                remotePools = ["d4c6971c2ddba89df0e572d6f3bc5369da4af478"]
                remoteTokenAddress = "410933dc7dd6966ba1c875ab1e19a997fd82c968"
                inboundCCVs = [RawInstanceAddress.RawInstanceAddress "inbound-ccv-1@owner"]
                outboundCCVs = [RawInstanceAddress.RawInstanceAddress "outbound-ccv-1@owner"]
                minBlockConfirmations = 12
                inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-updated@owner"
                inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom-updated@owner"
                outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl-updated@owner"
            ,LockReleaseTokenPool.ChainUpdate with
                remoteChainSelector = 789.0
                remotePools = ["0e924f6aa7efe932fab131bfc7baa7a684dbb1f8", "ac5fab2bda87e867accdede1c7ff1eeaadb2dcac"]
                remoteTokenAddress = "f43dc4783082e7f5ceb0f5e3bdff4a9acc3b0ace"
                inboundCCVs = []
                outboundCCVs = []
                minBlockConfirmations = 0
                inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"
            ]
    tokenPoolCid <- submit owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.ApplyChainUpdates with
            remoteChainSelectorsToRemove = remoteChainSelectorsToRemove2
            chainsToAdd = chainsToAdd2
    -- Fetch the updated TokenPool and verify the chain configs were updated/added correctly
    tokenPool <- fromSome <$> queryContractId owner tokenPoolCid
    assertMsg "Expected 3 remote chain configs" (Map.size tokenPool.remoteChainConfigs == 3)
    case Map.lookup 123.0 tokenPool.remoteChainConfigs of
        None -> assertMsg "Missing chain config for selector 123.0" False
        Some config -> assertChainUpdateEqual config (head chainsToAdd1) -- unchanged from Test 1
    case Map.lookup 456.0 tokenPool.remoteChainConfigs of
        None -> assertMsg "Missing chain config for selector 456.0" False
        Some config -> assertChainUpdateEqual config (head chainsToAdd2) -- updated in Test 2
    case Map.lookup 789.0 tokenPool.remoteChainConfigs of
        None -> assertMsg "Missing chain config for selector 789.0" False
        Some config -> assertChainUpdateEqual config (chainsToAdd2 !! 1) -- new in Test 2

    -- | ======== Test 3 ========
    -- | Remove a chain config
    -- | ========================
    let remoteChainSelectorsToRemove3 = [123.0]
        chainsToAdd3 = []
    tokenPoolCid <- submit owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.ApplyChainUpdates with
            remoteChainSelectorsToRemove = remoteChainSelectorsToRemove3
            chainsToAdd = chainsToAdd3
    -- Fetch the updated TokenPool and verify the chain config was removed
    tokenPool <- fromSome <$> queryContractId owner tokenPoolCid
    assertMsg "Expected 2 remote chain configs" (Map.size tokenPool.remoteChainConfigs == 2)
    case Map.lookup 123.0 tokenPool.remoteChainConfigs of
        None -> pure () -- expected to be removed
        Some _ -> assertMsg "Expected chain config for selector 123.0 to be removed" False
    case Map.lookup 456.0 tokenPool.remoteChainConfigs of
        None -> assertMsg "Missing chain config for selector 456.0" False
        Some config -> assertChainUpdateEqual config (head chainsToAdd2) -- unchanged from Test 2
    case Map.lookup 789.0 tokenPool.remoteChainConfigs of
        None -> assertMsg "Missing chain config for selector 789.0" False
        Some config -> assertChainUpdateEqual config (chainsToAdd2 !! 1) -- unchanged from Test 2

    -- | ======== Test 4 ========
    -- | Test invalid updates
    -- | ========================
    -- Attempt to remove a non-existent chain config 
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.ApplyChainUpdates with
            remoteChainSelectorsToRemove = [999.0] -- does not exist
            chainsToAdd = []
    -- Attempt to add a chain that already exists without removing it first
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.ApplyChainUpdates with
            remoteChainSelectorsToRemove = []
            chainsToAdd = [
                LockReleaseTokenPool.ChainUpdate with
                    remoteChainSelector = 456.0 -- already exists from Test 2
                    remotePools = []
                    remoteTokenAddress = "0dc30564e1ee874ad293fe9562714b2d0c2e2b6c"
                    inboundCCVs = []
                    outboundCCVs = []
                    minBlockConfirmations = 0
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"
                ]
    -- Attempt to add a chain with an invalid chain selector (negative)
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.ApplyChainUpdates with
            remoteChainSelectorsToRemove = []
            chainsToAdd = [
                LockReleaseTokenPool.ChainUpdate with
                    remoteChainSelector = -1.0 -- invalid
                    remotePools = []
                    remoteTokenAddress = "0dc30564e1ee874ad293fe9562714b2d0c2e2b6c"
                    inboundCCVs = []
                    outboundCCVs = []
                    minBlockConfirmations = 0
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"
                ]
    -- Attempt to add an invalid chain config (empty remote token address)
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.ApplyChainUpdates with
            remoteChainSelectorsToRemove = []
            chainsToAdd = [
                LockReleaseTokenPool.ChainUpdate with
                    remoteChainSelector = 999.0
                    remotePools = []
                    remoteTokenAddress = "" -- invalid
                    inboundCCVs = []
                    outboundCCVs = []
                    minBlockConfirmations = 0
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"
                ]
    -- Attempt to add an invalid chain config (duplicate CCVs in inboundCCVs)
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.ApplyChainUpdates with
            remoteChainSelectorsToRemove = []
            chainsToAdd = [
                LockReleaseTokenPool.ChainUpdate with
                    remoteChainSelector = 999.0
                    remotePools = []
                    remoteTokenAddress = "c8481ffd74cf5648c48ed4cebabf6c6006d8bffe"
                    inboundCCVs = [RawInstanceAddress.RawInstanceAddress "inbound-ccv-1@owner", RawInstanceAddress.RawInstanceAddress "inbound-ccv-1@owner"] -- duplicate
                    outboundCCVs = []
                    minBlockConfirmations = 0
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"
                ]
    -- Attempt to add an invalid chain config (duplicate CCVs in outboundCCVs)
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.ApplyChainUpdates with
            remoteChainSelectorsToRemove = []
            chainsToAdd = [
                LockReleaseTokenPool.ChainUpdate with
                    remoteChainSelector = 999.0
                    remotePools = []
                    remoteTokenAddress = "c8481ffd74cf5648c48ed4cebabf6c6006d8bffe"
                    inboundCCVs = []
                    outboundCCVs = [RawInstanceAddress.RawInstanceAddress "outbound-ccv-1@owner", RawInstanceAddress.RawInstanceAddress "outbound-ccv-1@owner"] -- duplicate
                    minBlockConfirmations = 0
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"
                ]

    -- Attempt to add an invalid chain config (empty inbound rate limiter address)
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.ApplyChainUpdates with
            remoteChainSelectorsToRemove = []
            chainsToAdd = [
                LockReleaseTokenPool.ChainUpdate with
                    remoteChainSelector = 999.0
                    remotePools = []
                    remoteTokenAddress = "c8481ffd74cf5648c48ed4cebabf6c6006d8bffe"
                    inboundCCVs = []
                    outboundCCVs = []
                    minBlockConfirmations = 0
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "" -- invalid
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"
                ]
    -- Attempt to add an invalid chain config (empty outbound rate limiter address)
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.ApplyChainUpdates with
            remoteChainSelectorsToRemove = []
            chainsToAdd = [
                LockReleaseTokenPool.ChainUpdate with
                    remoteChainSelector = 999.0
                    remotePools = []
                    remoteTokenAddress = "c8481ffd74cf5648c48ed4cebabf6c6006d8bffe"
                    inboundCCVs = []
                    outboundCCVs = []
                    minBlockConfirmations = 0
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "" -- invalid
                ]
    -- Attempt to add an invalid chain config (duplicate remote pool addresses)
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.ApplyChainUpdates with
            remoteChainSelectorsToRemove = []
            chainsToAdd = [
                LockReleaseTokenPool.ChainUpdate with
                    remoteChainSelector = 999.0
                    remotePools = ["11111111", "11111111"] -- duplicate
                    remoteTokenAddress = "c8481ffd74cf5648c48ed4cebabf6c6006d8bffe"
                    inboundCCVs = []
                    outboundCCVs = []
                    minBlockConfirmations = 0
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"
                ]
    -- Attempt to add an invalid chain config (identical rate limiter for inbound and outbound)
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.ApplyChainUpdates with
            remoteChainSelectorsToRemove = []
            chainsToAdd = [
                LockReleaseTokenPool.ChainUpdate with
                    remoteChainSelector = 999.0
                    remotePools = []
                    remoteTokenAddress = "c8481ffd74cf5648c48ed4cebabf6c6006d8bffe"
                    inboundCCVs = []
                    outboundCCVs = []
                    minBlockConfirmations = 0
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "same-rl@owner"
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "same-rl@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "same-rl@owner" -- invalid
                ]

    pure ()

testLockReleaseTokenPool_UpdateRateLimiters : Script ()
testLockReleaseTokenPool_UpdateRateLimiters = script do
    owner <- allocateParty "owner"
    ccipOwner <- allocateParty "ccip-owner"
    let instanceId = "lnr-tp-1"

    -- | Create LockReleaseTokenPool without existing remote chain config
    tokenPoolCid <- submit owner do
        createCmd LockReleaseTokenPool.LockReleaseTokenPool with
            ccipOwner = ccipOwner
            poolOwner = owner
            instanceId = "test-lock-release-pool"
            instrumentId = HoldingV1.InstrumentId with
                admin = ccipOwner
                id = "LINK"
            decimals = 8
            remoteChainConfigs = Map.fromList [
                (123.0, LockReleaseTokenPool.RemoteChainConfig with
                    remotePools = []
                    remoteTokenAddress = "f43dc4783082e7f5ceb0f5e3bdff4a9acc3b0ace"
                    inboundCCVs = []
                    outboundCCVs = []
                    minBlockConfirmations = 0
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner")
                ,(456.0, LockReleaseTokenPool.RemoteChainConfig with
                    remotePools = ["11111111"]
                    remoteTokenAddress = "cf383e3c65a8f8ec69b3a4fbdf0ceed7de4cd6a2cdf1ff6f82fa2eb3addf7b2e960f"
                    inboundCCVs = []
                    outboundCCVs = []
                    minBlockConfirmations = 0
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"
                )
                ]
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = CCIP.Context.emptyCCIPContext
            transferTimeout = LockReleaseTokenPool.Indefinite
            deps = mkPoolDeps "test-tar" "test-rmn" "test-feequoter-pool" ccipOwner ccipOwner

    -- | ========= Test 1 ========
    -- | Update multiple rate limiters for existing chain config
    -- | ========================
    let rateLimiterConfigArgs1 = [
            LockReleaseTokenPool.RateLimiterConfigArgs with
                remoteChainSelector = 123.0
                inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-updated@owner"
                inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom-updated@owner"
                outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl-updated@owner"
            ,LockReleaseTokenPool.RateLimiterConfigArgs with
                remoteChainSelector = 456.0
                inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-updated@owner"
                inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom-updated@owner"
                outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl-updated@owner"
            ]
    tokenPoolCid <- submit owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.UpdateRateLimiters with
            rateLimiterConfigArgs = rateLimiterConfigArgs1
    -- Fetch the updated TokenPool and verify the rate limiters were updated correctly
    tokenPool <- fromSome <$> queryContractId owner tokenPoolCid
    assertMsg "Expected 2 remote chain configs" (Map.size tokenPool.remoteChainConfigs == 2)
    case Map.lookup 123.0 tokenPool.remoteChainConfigs of
        None -> assertMsg "Missing chain config for selector 123.0" False
        Some config -> assertRateLimiterConfigArgsEqual config (head rateLimiterConfigArgs1)
    case Map.lookup 456.0 tokenPool.remoteChainConfigs of
        None -> assertMsg "Missing chain config for selector 456.0" False
        Some config -> assertRateLimiterConfigArgsEqual config (rateLimiterConfigArgs1 !! 1)

    -- | ========= Test 2 ========
    -- | Update a single rate limiter for existing chain config
    -- | ========================
    let rateLimiterConfigArgs2 = [
            LockReleaseTokenPool.RateLimiterConfigArgs with
                remoteChainSelector = 123.0
                inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-updated-again@owner"
                inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom-updated-again@owner"
                outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl-updated@owner" -- unchanged
            ]
    tokenPoolCid <- submit owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.UpdateRateLimiters with
            rateLimiterConfigArgs = rateLimiterConfigArgs2
    -- Fetch the updated TokenPool and verify the rate limiters were updated correctly
    tokenPool <- fromSome <$> queryContractId owner tokenPoolCid
    assertMsg "Expected 2 remote chain configs" (Map.size tokenPool.remoteChainConfigs == 2)
    case Map.lookup 123.0 tokenPool.remoteChainConfigs of
        None -> assertMsg "Missing chain config for selector 123.0" False
        Some config -> assertRateLimiterConfigArgsEqual config (head rateLimiterConfigArgs2)
    case Map.lookup 456.0 tokenPool.remoteChainConfigs of
        None -> assertMsg "Missing chain config for selector 456.0" False
        Some config -> assertRateLimiterConfigArgsEqual config (rateLimiterConfigArgs1 !! 1) -- unchanged from Test 1
    
    -- | ========= Test 3 ========
    -- | Invalid updates
    -- | ========================
    -- Attempt to update rate limiters for a non-existent chain config
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.UpdateRateLimiters with
            rateLimiterConfigArgs = [
                LockReleaseTokenPool.RateLimiterConfigArgs with
                    remoteChainSelector = 999.0 -- does not exist
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"
                ]
    -- Attempt to update with an invalid chain selector (negative)
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.UpdateRateLimiters with
            rateLimiterConfigArgs = [
                LockReleaseTokenPool.RateLimiterConfigArgs with
                    remoteChainSelector = -1.0 -- invalid
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"
                ]
    -- Attempt to update with an invalid inbound rate limiter address (empty)
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.UpdateRateLimiters with
            rateLimiterConfigArgs = [
                LockReleaseTokenPool.RateLimiterConfigArgs with
                    remoteChainSelector = 123.0
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "" -- invalid
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"
                ]
    -- Attempt to update with an invalid outbound rate limiter address (empty)
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.UpdateRateLimiters with
            rateLimiterConfigArgs = [
                LockReleaseTokenPool.RateLimiterConfigArgs with
                    remoteChainSelector = 123.0
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "" -- invalid
                ]   
    -- Attempt to update with an identical rate limiter for both inbound and outbound (invalid)
    submitMustFail owner do
        exerciseCmd tokenPoolCid LockReleaseTokenPool.UpdateRateLimiters with
            rateLimiterConfigArgs = [
                LockReleaseTokenPool.RateLimiterConfigArgs with
                    remoteChainSelector = 123.0
                    inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "same-rl@owner"
                    inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "same-rl@owner"
                    outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "same-rl@owner" -- invalid
                ]

    pure ()

testPoolTokenTransferFeeConfigRejectsInvalidFeeBps : Script ()
testPoolTokenTransferFeeConfigRejectsInvalidFeeBps = script do
    owner <- allocateParty "owner-invalid-fee-bps"

    let testInstrumentId = HoldingV1.InstrumentId with
            admin = owner
            id = "TestToken"
    let existingConfig = LockReleaseTokenPool.RemoteChainConfig with
            remotePools = ["000000000000000000000000aaaaaaaaaaaaaaaa"]
            remoteTokenAddress = "dde9af410cc4f737a136d87d3d4a4deeff1d26fc"
            inboundCCVs = []
            outboundCCVs = []
            minBlockConfirmations = 0
            inboundRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl@owner"
            inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress.RawInstanceAddress "inbound-rl-custom@owner"
            outboundRateLimiter = RawInstanceAddress.RawInstanceAddress "outbound-rl@owner"

    submitMustFail owner do
        createCmd LockReleaseTokenPool.LockReleaseTokenPool with
            ccipOwner = owner
            poolOwner = owner
            instanceId = "test-lock-release-invalid-fee-bps"
            instrumentId = testInstrumentId
            decimals = 6
            remoteChainConfigs = Map.fromList [(123.0, existingConfig)]
            tokenTransferFeeConfigs = Map.fromList [(123.0, LockReleaseTokenPool.TokenTransferFeeConfig with
                isEnabled = True
                feeUSDCents = cents 0.0
                feeBps = 10000.0
                destGasOverhead = 0
                destBytesOverhead = 32)]
            poolReceiveContext = CCIP.Context.emptyCCIPContext
            transferTimeout = LockReleaseTokenPool.Indefinite
            deps = mkPoolDeps "test-tar-invalid-fee-bps" "test-rmn-invalid-fee-bps" "test-fq-invalid-fee-bps" owner owner

    pure ()

