testMessage1 : CCIP.MessageCodecV1.MessageV1
testMessage1 = CCIP.MessageCodecV1.MessageV1 with
    sourceChainSelector = 123.0
    destChainSelector = 456.0
    sequenceNumber = 789.0
    executionGasLimit = 400000
