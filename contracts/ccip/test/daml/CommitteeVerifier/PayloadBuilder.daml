getPubkeysForIndices : [Int] -> [BytesHex]
getPubkeysForIndices indices = map (\i -> pubkeys !! i) indices

getVerifierResultsForIndices : [Int] -> BytesHex
getVerifierResultsForIndices indices =
    let signatures = map (\i -> rValues !! i <> sValues !! i) indices
        concatenatedSignatures = foldl (<>) "" signatures
        signatureLength = byteCount concatenatedSignatures
    in CCIP.CommitteeVerifier.versionTagV1_7_0
       <> fromSome(CCIP.MessageCodecV1.encodeUint16 signatureLength)
       <> concatenatedSignatures