    destBlob = "636f6d706c65782064657374696e6174696f6e20626c6f62"
    tokenTransfer = Some (CCIP.MessageCodecV1.TokenTransferV1 with
        amount = 1000000.0
        sourcePoolAddress = "ed3ee8542acd9e483c658350ad4984483eb0afdc"
