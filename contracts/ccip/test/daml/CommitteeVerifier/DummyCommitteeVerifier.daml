module CommitteeVerifier.DummyCommitteeVerifier where

import DA.Crypto.Text (BytesHex, keccak256)

import qualified CCIP.CCVRegistry
import qualified CCIP.MessageCodecV1
import qualified CCIP.Tickets
import CCIP.Interfaces.CrossChainVerifier

-- | Dummy version tag for testing
dummyVersionTag : BytesHex
dummyVersionTag = "deadbeef"

template DummyCommitteeVerifier
    with
        instanceId : Text
        owner : Party
        ccipOwner : Party
        versionTag : BytesHex
    where
        signatory owner

        interface instance CCIP.Interfaces.CrossChainVerifier.ICrossChainVerifier for DummyCommitteeVerifier where
            view = CCIP.Interfaces.CrossChainVerifier.CrossChainVerifierView with
                ccipOwner = ccipOwner
                storageLocation = "ipfs://dummy"

            crossChainVerifier_verifyMessageImpl self arg = do
                -- verifierResults should start with version tag (first 4 bytes)
                -- For testing, we use "01" as a failure trigger
                case arg.verifierResults of
                    "01" -> error "DummyCommitteeVerifier: Simulated verification failure"
                    _ -> do
                        debug ("DummyCommitteeVerifier: Simulated successful verification")
                        -- Calculate message hash
                        let messageHash = keccak256 (CCIP.MessageCodecV1.encodeMessageV1 arg.message)
                        -- Issue verify ticket via CCVRegistry (registry computes instance address)
                        exercise arg.ccvRegistryCid CCIP.CCVRegistry.CCVRegistry_IssueVerifyTicket with
                            ccvInstanceId = instanceId
                            ccvOwner = owner
                            versionTag = versionTag
                            messageHash = messageHash
                            sourceChainSelector = arg.message.sourceChainSelector
                            sequenceNumber = arg.message.sequenceNumber
                            receiver = arg.receiver

            crossChainVerifier_forwardToVerifierImpl self arg = do
                -- Compute instance address for receipt
                let ccvAddr = CCIP.MessageCodecV1.encodeInstanceAddress instanceId owner

                -- Build verifierBlob with version tag as first 4 bytes
                let verifierBlob = versionTag

                -- Build Receipt with instance address
                let receipt = CCIP.Tickets.Receipt with
                        issuerType = CCIP.Tickets.IssuerType_CCV
                        issuerAddress = ccvAddr
                        versionTag = Some versionTag
                        destGasLimit = 0
                        destBytesOverhead = 0
                        feeTokenAmount = 0.0
                        extraArgs = ""

                -- Issue CCV ticket via CCVRegistry (registry computes instance address)
                exercise arg.ccvRegistryCid CCIP.CCVRegistry.CCVRegistry_IssueCCVTicket with
                    ccvInstanceId = instanceId
                    ccvOwner = owner
                    versionTag = versionTag
                    verifierBlob = verifierBlob
                    messageSentObservers = [owner]
                    sender = arg.caller
                    receipt = receipt
