module CommitteeVerifier.DummyCommitteeVerifier where

import DA.Crypto.Text (BytesHex)

import qualified CCIP.ExecutingMessageV1
import qualified CCIP.SendingMessageV1
import CCIP.Interfaces.CrossChainVerifier
import MCMS.RawInstanceAddress (assertValidInstanceId)

-- | Dummy version tag for testing
dummyVersionTag : BytesHex
dummyVersionTag = "deadbeef"

template DummyCommitteeVerifier
    with
        instanceId : Text
        owner : Party
        ccipOwner : Party
        versionTag : BytesHex
        feeUSDCents : Numeric 0
        destGasLimit : Int
        destBytesOverhead : Int
    where
        signatory owner
        ensure assertValidInstanceId instanceId

        interface instance CCIP.Interfaces.CrossChainVerifier.ICrossChainVerifier for DummyCommitteeVerifier where
            view = CCIP.Interfaces.CrossChainVerifier.CrossChainVerifierView with
                instanceId = instanceId
                owner = owner
                ccipOwner = ccipOwner
                storageLocations = ["ipfs://dummy"]

            crossChainVerifier_verifyMessageImpl self arg = do
                case arg.verifierResults of
                    "01" -> error "DummyCommitteeVerifier: Simulated verification failure"
                    _ -> do
                        debug "DummyCommitteeVerifier: Simulated successful verification"
                        exercise arg.executingMessageCid CCIP.ExecutingMessageV1.AddCCVVerification with
                            ccvInstanceId = instanceId
                            versionTag = versionTag
                            caller = owner

            crossChainVerifier_calculateFeeImpl _self arg = do
                exercise arg.sendingMessageCid CCIP.SendingMessageV1.AddCCVFee with
                    ccvInstanceId = instanceId
                    feeUSDCents = feeUSDCents
                    destGasLimit = destGasLimit
                    destBytesOverhead = destBytesOverhead
                    caller = owner

            crossChainVerifier_getFeeImpl _self _arg = do
                pure CCIP.Interfaces.CrossChainVerifier.CrossChainVerifierFeeQuote with
                    ccv = RawInstanceAddress.make instanceId owner
                    feeUSDCents = feeUSDCents
                    gasForVerification = destGasLimit
                    payloadSizeBytes = destBytesOverhead

            crossChainVerifier_forwardToVerifierImpl self arg = do
                exercise (fromInterfaceContractId @DummyCommitteeVerifier self)
                    DummyCommitteeVerifier_ForwardToVerifier with
                        sendingMessageCid = arg.sendingMessageCid
                        caller = arg.caller

        nonconsuming choice DummyCommitteeVerifier_ForwardToVerifier
                : ContractId CCIP.SendingMessageV1.SendingMessageV1
            with
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
                caller : Party
            controller caller
            do
                let verifierBlob = versionTag

                exercise sendingMessageCid CCIP.SendingMessageV1.AddVerifierData with
                    ccvInstanceId = instanceId
                    versionTag = versionTag
                    verifierBlob = verifierBlob
                    messageSentObservers = [owner]
                    caller = owner
