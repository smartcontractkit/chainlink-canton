module RateLimiterTest where

import Daml.Script

import DA.Assert
import DA.Optional (fromSome)
import DA.Time (seconds)

import qualified CCIP.RateLimiterV2

testRateLimiterConsumeAndRefill = script do
    poolOwner <- allocateParty "pool-owner"

    now <- getTime
    limiter <- submit poolOwner do
        createCmd CCIP.RateLimiterV2.RateLimiter with
            instanceId = "rl-refill"
            poolInstanceId = "pool-1"
            poolOwner = poolOwner
            remoteChainSelector = 123.0
            direction = CCIP.RateLimiterV2.RateLimitDirection_Outbound
            mode = CCIP.RateLimiterV2.RateLimitMode_DefaultFinality
            isEnabled = True
            capacity = 100.0
            rate = 5.0
            tokens = 100.0
            lastUpdated = now

    consumed <- submit poolOwner do
        exerciseCmd limiter CCIP.RateLimiterV2.ConsumeCapacity with
            requested = 90.0
    consumed.availableBeforeConsume === 100.0

    passTime (seconds 10)

    limiterState <- fromSome <$> queryContractId poolOwner consumed.rateLimiterCid
    now2 <- getTime
    CCIP.RateLimiterV2.availableTokensAt now2 limiterState === 60.0

    debug "testRateLimiterConsumeAndRefill: PASSED"

testRateLimiterRejectsOverCapacity = script do
    poolOwner <- allocateParty "pool-owner"

    now <- getTime
    limiter <- submit poolOwner do
        createCmd CCIP.RateLimiterV2.RateLimiter with
            instanceId = "rl-over-cap"
            poolInstanceId = "pool-1"
            poolOwner = poolOwner
            remoteChainSelector = 123.0
            direction = CCIP.RateLimiterV2.RateLimitDirection_Outbound
            mode = CCIP.RateLimiterV2.RateLimitMode_DefaultFinality
            isEnabled = True
            capacity = 100.0
            rate = 5.0
            tokens = 100.0
            lastUpdated = now

    submitMustFail poolOwner do
        exerciseCmd limiter CCIP.RateLimiterV2.ConsumeCapacity with
            requested = 101.0

    debug "testRateLimiterRejectsOverCapacity: PASSED"

testRateLimiterSetConfigResetsBucket = script do
    poolOwner <- allocateParty "pool-owner"

    now <- getTime
    limiter <- submit poolOwner do
        createCmd CCIP.RateLimiterV2.RateLimiter with
            instanceId = "rl-set-config"
            poolInstanceId = "pool-1"
            poolOwner = poolOwner
            remoteChainSelector = 123.0
            direction = CCIP.RateLimiterV2.RateLimitDirection_Inbound
            mode = CCIP.RateLimiterV2.RateLimitMode_DefaultFinality
            isEnabled = True
            capacity = 100.0
            rate = 5.0
            tokens = 20.0
            lastUpdated = now

    limiter <- submit poolOwner do
        exerciseCmd limiter CCIP.RateLimiterV2.SetConfig with
            newIsEnabled = True
            newCapacity = 200.0
            newRate = 10.0

    limiterState <- fromSome <$> queryContractId poolOwner limiter
    limiterState.tokens === 200.0
    limiterState.capacity === 200.0
    limiterState.rate === 10.0

    debug "testRateLimiterSetConfigResetsBucket: PASSED"

testRateLimiterRejectsNegativeRequest = script do
    poolOwner <- allocateParty "pool-owner"

    now <- getTime
    limiter <- submit poolOwner do
        createCmd CCIP.RateLimiterV2.RateLimiter with
            instanceId = "rl-negative"
            poolInstanceId = "pool-1"
            poolOwner = poolOwner
            remoteChainSelector = 123.0
            direction = CCIP.RateLimiterV2.RateLimitDirection_Outbound
            mode = CCIP.RateLimiterV2.RateLimitMode_DefaultFinality
            isEnabled = True
            capacity = 100.0
            rate = 5.0
            tokens = 30.0
            lastUpdated = now

    submitMustFail poolOwner do
        exerciseCmd limiter CCIP.RateLimiterV2.ConsumeCapacity with
            requested = -20.0

    debug "testRateLimiterRejectsNegativeRequest: PASSED"

testRateLimiterRejectsNegativeConfig = script do
    poolOwner <- allocateParty "pool-owner"

    now <- getTime

    -- Negative capacity must be rejected at creation
    submitMustFail poolOwner do
        createCmd CCIP.RateLimiterV2.RateLimiter with
            instanceId = "rl-neg-cap"
            poolInstanceId = "pool-1"
            poolOwner = poolOwner
            remoteChainSelector = 123.0
            direction = CCIP.RateLimiterV2.RateLimitDirection_Outbound
            mode = CCIP.RateLimiterV2.RateLimitMode_DefaultFinality
            isEnabled = True
            capacity = -1.0
            rate = 0.0
            tokens = 0.0
            lastUpdated = now

    -- Negative rate must be rejected at creation
    submitMustFail poolOwner do
        createCmd CCIP.RateLimiterV2.RateLimiter with
            instanceId = "rl-neg-rate"
            poolInstanceId = "pool-1"
            poolOwner = poolOwner
            remoteChainSelector = 123.0
            direction = CCIP.RateLimiterV2.RateLimitDirection_Outbound
            mode = CCIP.RateLimiterV2.RateLimitMode_DefaultFinality
            isEnabled = True
            capacity = 100.0
            rate = -5.0
            tokens = 100.0
            lastUpdated = now

    limiter <- submit poolOwner do
        createCmd CCIP.RateLimiterV2.RateLimiter with
            instanceId = "rl-neg-setconfig"
            poolInstanceId = "pool-1"
            poolOwner = poolOwner
            remoteChainSelector = 123.0
            direction = CCIP.RateLimiterV2.RateLimitDirection_Outbound
            mode = CCIP.RateLimiterV2.RateLimitMode_DefaultFinality
            isEnabled = True
            capacity = 100.0
            rate = 5.0
            tokens = 100.0
            lastUpdated = now

    -- Negative capacity must be rejected by SetConfig
    submitMustFail poolOwner do
        exerciseCmd limiter CCIP.RateLimiterV2.SetConfig with
            newIsEnabled = True
            newCapacity = -1.0
            newRate = 0.0

    -- Negative rate must be rejected by SetConfig
    submitMustFail poolOwner do
        exerciseCmd limiter CCIP.RateLimiterV2.SetConfig with
            newIsEnabled = True
            newCapacity = 100.0
            newRate = -5.0

    debug "testRateLimiterRejectsNegativeConfig: PASSED"
