module BurnMintTokenPoolTest where

import Daml.Script

import DA.Assert
import DA.Map qualified as Map
import DA.Optional (fromSome, fromSomeNote, isSome)
import DA.TextMap qualified as TextMap

import Splice.Api.Token.BurnMintV1
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.MetadataV1

import qualified Chainlink.InstanceAddress

import qualified CCIP.BurnMintTokenPoolV2
import qualified CCIP.CodecV2.FinalityConfig
import qualified CCIP.CodecV2.MessageCodecV1
import qualified CCIP.CodecV2.Uint256
import qualified CCIP.CoreV2.ExecutingMessage
import qualified CCIP.CoreV2.RMNRemote
import qualified CCIP.CoreV2.SendingMessage
