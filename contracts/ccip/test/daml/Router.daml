module Router where

import Daml.Script

import DA.Assert
import DA.Foldable (forA_)
import DA.List
import DA.Map qualified as Map
import DA.TextMap qualified as TextMap
import DA.Optional

import qualified CCIP.Client
import CCIP.FeeQuoter qualified as FeeQuoter
import CCIP.OnRamp qualified as OnRamp
import CCIP.Router qualified as Router
import CCIP.SendRequest qualified as SendRequest

import Splice.Api.Token.TransferInstructionV1
import Splice.Api.Token.BurnMintV1
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.MetadataV1

import Coin.Registry

setup = script do
    owner <- allocateParty "owner"
    issuer <- allocateParty "issuer"
    user <- allocateParty "user"

    let instrumentIdLINK = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = issuer
            id = "LINK"
    let destChainSelector1 : Numeric 0 = 1234567890.0

    -- Create LINK Holding
    -- Create Registry
    registry <- submit issuer do
        createCmd CoinRegistry with
            issuer = issuer
            instrumentId = instrumentIdLINK
            meta = emptyMetadata
    disclosedRegistry <- fromSome <$> queryDisclosure issuer registry

    -- mint to user
    userPreApproval <- submit user do
        createCmd MintPreapproval with
            sender = issuer
            receiver = user
    -- mint to user
    bmResult <- submit issuer do
        exerciseCmd (toInterfaceContractId @BurnMintFactory registry) BurnMintFactory_BurnMint with
            expectedAdmin = issuer
            instrumentId = instrumentIdLINK
            inputHoldingCids = []
            outputs = [
                BurnMintOutput {
                    owner = user,
                    amount = 100.00,
                    context = ChoiceContext with -- add pre-approval cid to choice context
                        values = TextMap.fromList [(mintPreapprovalContextKey, AV_ContractId $ coerceContractId userPreApproval)]
                }]
            extraActors = []
            extraArgs = ExtraArgs with
                context = emptyChoiceContext
                meta = emptyMetadata

    let userHoldingCids = bmResult.outputCids

    -- Deploy FeeQuoter
    fq <- submit owner do
        createCmd FeeQuoter.FeeQuoter with
            owner = owner
            feeTokens = Map.empty
            destChainConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.empty
            usdPerToken = Map.empty
            priceUpdaters = [owner]
    -- Apply price updates for destChainSelector1 and instrumentIdLINK
    fq <- submit owner do
        exerciseCmd fq FeeQuoter.UpdatePrices with
            priceUpdates = FeeQuoter.PriceUpdates with
                tokenPriceUpdates = [
                        FeeQuoter.TokenPriceUpdate with
                            instrumentId = instrumentIdLINK
                            usdPerToken = 20.00
                    ]
                gasPriceUpdates = [
                        FeeQuoter.GasPriceUpdate with
                            destChainSelector = destChainSelector1
                            usdPerUnitGas = 0.045
                    ]
            caller = owner
    -- apply destChainConfig for destChainSelector1
    let destChainConfig1 = FeeQuoter.DestChainConfig with
            isEnabled = True
            maxDataBytes = 5000
            maxPerMsgGasLimit = 2000000
            destGasOverhead = 30000
            destGasPerPayloadByteBase = 12
            defaultTxGasLimit = 500000
            chainFamilySelector = "2812d52c"
            networkFeeUSD = 100.0
            defaultTokenFeeUSD = 0.50
            defaultTokenDestGasOverhead = 0
    fq <- submit owner do
        exerciseCmd fq FeeQuoter.ApplyDestChainConfigUpdates with
            destChainConfigArgs = [
                    (FeeQuoter.DestChainConfigArgs with
                        destChainSelector = destChainSelector1
                        destChainConfig = destChainConfig1)
                ]
    disclosedFeeQuoter <- fromSome <$> queryDisclosure owner fq

    -- Deploy OnRamp
    onRamp <- submit owner do
        createCmd OnRamp.OnRamp with
            owner = owner
            staticConfig = OnRamp.StaticConfig with
                chainSelector = 2222222222.0
            destChainConfigs = Map.empty

    --apply destChainConfig for destChainSelector1
    let destChainConfig = OnRamp.DestChainConfig with
            sequenceNumber = 0.0
            defaultExecutor = ""
            laneMandatedCCVs = []
            defaultCCVs = []
    onRamp <- submit owner do
        exerciseCmd onRamp OnRamp.ApplyDestChainConfigUpdates with
            destChainConfigArgs = [
                    (OnRamp.DestChainConfigArgs with
                        destChainSelector = destChainSelector1
                        destChainConfig = destChainConfig)
                ]
    disclosedOnRamp <- fromSome <$> queryDisclosure owner onRamp

    -- Deploy Router
    router <- submit owner do
        createCmd Router.Router with
            owner = owner
    disclosedRouter <- fromSome <$> queryDisclosure owner router

    -- User sends CCIP message via Router
    now <- getTime
    sendResult <- trySubmit (actAs user <> disclose disclosedRegistry <> disclose disclosedFeeQuoter <> disclose disclosedOnRamp <> disclose disclosedRouter) do
        exerciseCmd router Router.CCIPSend with
            destChainSelector = destChainSelector1
            message = CCIP.Client.Canton2AnyMessage with
                receiver = "0xReceiverAddress"
                payload = "0xPayloadData"
                feeToken = instrumentIdLINK
                extraArgs = ""
            feeInput = Router.FeeInput with
                transferFactory = toInterfaceContractId @TransferFactory registry
                inputHoldingCids = userHoldingCids
                extraArgs = Splice.Api.Token.MetadataV1.ExtraArgs with
                    context = emptyChoiceContext
                    meta = emptyMetadata
            caller = user
            onRamp = onRamp
            feeQuoter = fq
    Right sendResult' <- pure sendResult

    -- refresh onRamp
    let onRamp = sendResult'.onRamp
    disclosedOnRamp <- fromSome <$> queryDisclosure owner onRamp

    let ccipMessageSent : ContractId OnRamp.CCIPMessageSent = sendResult'.ccipMessageSent
    Some res <- user `queryContractId` ccipMessageSent
    res.event.sequenceNumber === 1.0

    -- User had 100 LINK, fee should be 5 LINK, so change holding should be 95 LINK
    let senderChangeCid : ContractId Splice.Api.Token.HoldingV1.Holding = (head sendResult'.senderChangeCids)
    Some change <- user `queryInterfaceContractId` senderChangeCid
    change.amount === 95.00

    -- Send a second message, sequenceNumber should be 2.0
    sendResult2 <- trySubmit (actAs user <> disclose disclosedRegistry <> disclose disclosedFeeQuoter <> disclose disclosedOnRamp <> disclose disclosedRouter) do
        exerciseCmd router Router.CCIPSend with
            destChainSelector = destChainSelector1
            message = CCIP.Client.Canton2AnyMessage with
                receiver = "0xReceiverAddress"
                payload = "0xPayloadData"
                feeToken = instrumentIdLINK
                extraArgs = ""
            feeInput = Router.FeeInput with
                transferFactory = toInterfaceContractId @TransferFactory registry
                inputHoldingCids = sendResult'.senderChangeCids
                extraArgs = Splice.Api.Token.MetadataV1.ExtraArgs with
                    context = emptyChoiceContext
                    meta = emptyMetadata
            caller = user
            onRamp = onRamp
            feeQuoter = fq
    Right sendResult2' <- pure sendResult2

    -- refresh onRamp
    let onRamp = sendResult2'.onRamp
    disclosedOnRamp <- fromSome <$> queryDisclosure owner onRamp

    let ccipMessageSent2 : ContractId OnRamp.CCIPMessageSent = sendResult2'.ccipMessageSent
    Some res2 <- user `queryContractId` ccipMessageSent2
    res2.event.sequenceNumber === 2.0

    -- User had 95 LINK, fee should be 5 LINK, so change holding should be 90 LINK
    let senderChangeCid : ContractId Splice.Api.Token.HoldingV1.Holding = (head sendResult2'.senderChangeCids)
    Some change <- user `queryInterfaceContractId` senderChangeCid
    change.amount === 90.00

    -- Use SendRequest pattern

    -- create two transfers and two SendRequests
    now <- getTime
    transferResult <- trySubmit (actAs user <> disclose disclosedRegistry) do
        exerciseCmd (toInterfaceContractId @TransferFactory registry) TransferFactory_Transfer with
            expectedAdmin = issuer
            transfer = Splice.Api.Token.TransferInstructionV1.Transfer with
                sender = user
                receiver = owner
                amount = 5.00 -- fee amount
                instrumentId = instrumentIdLINK
                requestedAt = now
                executeBefore = now
                inputHoldingCids = sendResult2'.senderChangeCids
                meta = emptyMetadata
            extraArgs = ExtraArgs with
                context = emptyChoiceContext
                meta = emptyMetadata
    Right transferResult' <- pure transferResult
    TransferInstructionResult_Pending pendingTransfer1 <- pure transferResult'.output

    transferResult <- trySubmit (actAs user <> disclose disclosedRegistry) do
        exerciseCmd (toInterfaceContractId @TransferFactory registry) TransferFactory_Transfer with
            expectedAdmin = issuer
            transfer = Splice.Api.Token.TransferInstructionV1.Transfer with
                sender = user
                receiver = owner
                amount = 10.00 -- fee amount
                instrumentId = instrumentIdLINK
                requestedAt = now
                executeBefore = now
                inputHoldingCids = transferResult'.senderChangeCids
                meta = emptyMetadata
            extraArgs = ExtraArgs with
                context = emptyChoiceContext
                meta = emptyMetadata
    Right transferResult' <- pure transferResult
    TransferInstructionResult_Pending pendingTransfer2 <- pure transferResult'.output

    sendRequest <- submit user do
        createCmd SendRequest.CCIPSendRequest with
            ccipOwner = owner
            destChainSelector = destChainSelector1
            message = CCIP.Client.Canton2AnyMessage with
                receiver = "0xReceiverAddress"
                payload = "0xPayloadData123"
                feeToken = instrumentIdLINK
                extraArgs = ""
            feeInput = OnRamp.FeeInput with
                transfer = pendingTransfer1
                extraArgs = Splice.Api.Token.MetadataV1.ExtraArgs with
                    context = emptyChoiceContext
                    meta = emptyMetadata
            sender = user
    sendRequest <- submit user do
        createCmd SendRequest.CCIPSendRequest with
            ccipOwner = owner
            destChainSelector = destChainSelector1
            message = CCIP.Client.Canton2AnyMessage with
                receiver = "0xReceiverAddress"
                payload = "0xPayloadData456"
                feeToken = instrumentIdLINK
                extraArgs = ""
            feeInput = OnRamp.FeeInput with
                transfer = pendingTransfer2
                extraArgs = Splice.Api.Token.MetadataV1.ExtraArgs with
                    context = emptyChoiceContext
                    meta = emptyMetadata
            sender = user


    -- list SendRequests and for each, execute the send
    sendRequests <- query @SendRequest.CCIPSendRequest owner
    forA_ sendRequests \(sendRequestCid, sendRequest) -> do
        -- query current onRamp
        (onRampCid, _) <- head <$> query @OnRamp.OnRamp owner

        sendResult <- trySubmit (actAs owner) do
            exerciseCmd sendRequestCid SendRequest.ExecuteSend with
                caller = owner
                onRamp = onRampCid
                feeQuoter = fq
        Right sendResult' <- pure sendResult
        pure ()

    pure()