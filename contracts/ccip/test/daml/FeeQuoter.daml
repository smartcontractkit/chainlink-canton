module FeeQuoter where

import Daml.Script

import DA.Assert
import DA.Crypto.Text (byteCount)
import DA.Date (Month(Jan), date)
import DA.Map qualified as Map
import DA.Optional (fromSome)
import DA.Set qualified as Set
import DA.Time (time)

import CCIP.FeeQuoter
import CCIP.FinalityCodec qualified as FinalityCodec
import CCIP.MessageCodecV1 qualified as MessageCodecV1
import MCMS.RawInstanceAddress qualified as RawInstanceAddress
import CCIP.SendingMessageV1 qualified as SendingMessageV1

import Splice.Api.Token.HoldingV1

usd : Decimal -> Decimal
usd d = d

cents : Decimal -> Numeric 0
cents c = intToNumeric (truncate c)

usdToCents : Decimal -> Numeric 0
usdToCents d = intToNumeric (truncate (d * 100.0))

mult : Decimal -> Numeric 0
mult m = intToNumeric (truncate (m * 100000000.0))

finalityConfig n =
    if n == 0
    then FinalityCodec.waitForFinalityConfig
    else fromSome do
        flagsHex <- MessageCodecV1.encodeUint16 0
        blockConfirmationsHex <- MessageCodecV1.encodeUint16 n
        pure (flagsHex <> blockConfirmationsHex)

testDestChainConfig : DestChainConfig
testDestChainConfig = DestChainConfig with
    isEnabled = True
    maxDataBytes = 100000
    maxPerMsgGasLimit = 1000000
    destGasOverhead = 0
    destGasPerPayloadByteBase = 0
    defaultTxGasLimit = 50000
    linkFeeMultiplierPercent = 100.0
    defaultTokenFeeUSD = 0.0
    defaultTokenDestGasOverhead = 0

finalizeUsingQuote
    : Party
    -> ContractId CCIP.FeeQuoter.FeeQuoter
    -> ContractId SendingMessageV1.SendingMessageV1
    -> Script (ContractId SendingMessageV1.SendingMessageV1)
finalizeUsingQuote owner feeQuoter sendingMessageCid = do
    Some sm <- queryContractId owner sendingMessageCid
    quote <- submit owner do
        exerciseCmd feeQuoter QuoteGasForExec with
            destChainSelector = sm.destChainSelector
            nonCalldataGas =
                foldl (\acc fee -> acc + fee.destGasLimit) 0 sm.ccvFees
                    + (case sm.tokenSendFee of
                        Some fee -> fee.destGasOverhead
                        None -> 0)
                    + sm.executorDestGasLimit
            calldataSize =
                byteCount sm.payload
                    + foldl (\acc fee -> acc + fee.destBytesOverhead) 0 sm.ccvFees
                    + (case sm.tokenSendFee of
                        Some fee -> fee.destBytesOverhead
                        None -> 0)
                    + sm.executorDestBytesOverhead
            feeToken = sm.feeToken
            caller = owner
    submit owner do
        exerciseCmd sendingMessageCid SendingMessageV1.FinalizeFee with
            feeTokenPrice = quote.feeTokenPrice
            premiumMultiplier = quote.premiumMultiplier
            totalExecutionGasLimit = quote.totalGas
            executorDestGasLimit = sm.executorDestGasLimit
            executorDestBytesOverhead = sm.executorDestBytesOverhead
            executionCostUSDCents =
                case sm.executionMode of
                    Some SendingMessageV1.ExecutionMode_NoExecutor -> 0.0
                    _ -> quote.gasCostUSDCents

setup = script do
    owner <- allocateParty "owner"

    let instrumentIdLINK = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"
    let instrumentIdUSDC = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "USDC"

    let destChainSelector1 : Numeric 0 = 1234567890.0
    let destChainSelector2 : Numeric 0 = 9876543210.0

    -- Create FeeQuoter
    fq <- submit owner do
        createCmd CCIP.FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter"
            feeTokens = Set.empty
            destChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.fromList
                [(456.0, TimestampedPrice 0.0 (time (date 2026 Jan 1) 0 0 0))]
            usdPerToken = Map.empty
            linkTokenInstrumentId = instrumentIdLINK
            priceUpdaters = [owner]

    -- Apply price updates for destChainSelector1 and instrumentIdLINK
    fq <- submit owner do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = [ 
                        TokenPriceUpdate with
                            instrumentId = instrumentIdLINK
                            usdPerToken = 17.77
                    ]
                gasPriceUpdates = [
                        GasPriceUpdate with
                            destChainSelector = destChainSelector1
                            usdPerUnitGas = 0.045
                    ]
            caller = owner

    -- retrieve prices and assert
    result <- submit owner do
        exerciseCmd fq GetTokenPrice with
            instrumentId = instrumentIdLINK
            caller = owner
    debug result
    result.price === 17.77

    result <- submit owner do
        exerciseCmd fq GetDestinationChainGasPrice with
            destChainSelector = destChainSelector1
            caller = owner
    debug result
    result.price === 0.045

    resultFeeTokens <- submit owner do
        exerciseCmd fq GetFeeTokens with caller = owner
    Set.fromList resultFeeTokens === Set.fromList [instrumentIdLINK]

    -- Apply prices again, this time for two chains and two instruments
    fq <- submit owner do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = [ 
                        (TokenPriceUpdate with
                            instrumentId = instrumentIdLINK
                            usdPerToken = 20.0),
                        (TokenPriceUpdate with
                            instrumentId = instrumentIdUSDC
                            usdPerToken = 1.0)
                    ]
                gasPriceUpdates = [
                        (GasPriceUpdate with
                            destChainSelector = destChainSelector1
                            usdPerUnitGas = 0.05),
                        (GasPriceUpdate with
                            destChainSelector = destChainSelector2
                            usdPerUnitGas = 0.075)
                    ]
            caller = owner

    -- retrieve prices for both and assert
    result <- submit owner do
        exerciseCmd fq GetTokenPrice with
            instrumentId = instrumentIdLINK
            caller = owner
    debug result
    result.price === 20.0
    
    result <- submit owner do 
        exerciseCmd fq GetTokenPrice with
            instrumentId = instrumentIdUSDC
            caller = owner
    debug result
    result.price === 1.0

    result <- submit owner do
        exerciseCmd fq GetDestinationChainGasPrice with
            destChainSelector = destChainSelector1
            caller = owner
    debug result
    result.price === 0.05

    result <- submit owner do
        exerciseCmd fq GetDestinationChainGasPrice with
            destChainSelector = destChainSelector2
            caller = owner
    debug result
    result.price === 0.075

    resultFeeTokens <- submit owner do
        exerciseCmd fq GetFeeTokens with caller = owner
    Set.fromList resultFeeTokens === Set.fromList [instrumentIdLINK, instrumentIdUSDC]

    -- test ApplyDestChainConfigUpdates
    let destChainConfig1 = DestChainConfig with
            isEnabled = True
            maxDataBytes = 5000
            destGasOverhead = 30000
            destGasPerPayloadByteBase = 12
            defaultTxGasLimit = 500000
            linkFeeMultiplierPercent = 100.0
            maxPerMsgGasLimit = 2000000
            defaultTokenFeeUSD = usdToCents 0.50
            defaultTokenDestGasOverhead = 0
    let destChainConfig2 = DestChainConfig with
            isEnabled = True
            maxDataBytes = 8000
            destGasOverhead = 40000
            destGasPerPayloadByteBase = 15
            defaultTxGasLimit = 800000
            linkFeeMultiplierPercent = 100.0
            maxPerMsgGasLimit = 3000000
            defaultTokenFeeUSD = usdToCents 0.25
            defaultTokenDestGasOverhead = 0
    fq <- submit owner do
        exerciseCmd fq ApplyDestChainConfigUpdates with
            destChainConfigArgs = [
                    (DestChainConfigArgs with
                        destChainSelector = destChainSelector1
                        destChainConfig = destChainConfig1),
                    (DestChainConfigArgs with
                        destChainSelector = destChainSelector2
                        destChainConfig = destChainConfig2)
                ]

    result <- submit owner do
        exerciseCmd fq GetDestChainConfig with
            destChainSelector = destChainSelector1
            caller = owner
    debug result
    result === destChainConfig1
    result <- submit owner do
        exerciseCmd fq GetDestChainConfig with
            destChainSelector = destChainSelector2
            caller = owner
    debug result
    result === destChainConfig2

    -- try setting an invalid config (destChainSelector = 0.0), should fail
    submitMustFail owner do
        exerciseCmd fq ApplyDestChainConfigUpdates with
            destChainConfigArgs = [
                    (DestChainConfigArgs with
                        destChainSelector = 0.0
                        destChainConfig = destChainConfig1)
                ]

    -- try setting an invalid config (destChainSelector = -123.0), should fail
    submitMustFail owner do
        exerciseCmd fq ApplyDestChainConfigUpdates with
            destChainConfigArgs = [
                    (DestChainConfigArgs with
                        destChainSelector = -123.0
                        destChainConfig = destChainConfig1)
                ]

    -- test AddPriceUpdaters and RemovePriceUpdaters
    updater1 <- allocateParty "updater1"
    updater2 <- allocateParty "updater2"
    updater3 <- allocateParty "updater3"

    -- Add two price updaters
    fq <- submit owner do
        exerciseCmd fq AddPriceUpdaters with
            parties = [updater1, updater2]

    -- Verify updaters can call UpdatePrices
    fq <- submit updater1 do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = [
                        TokenPriceUpdate with
                            instrumentId = instrumentIdLINK
                            usdPerToken = 30.0
                    ]
                gasPriceUpdates = []
            caller = updater1

    result <- submit owner do
        exerciseCmd fq GetTokenPrice with
            instrumentId = instrumentIdLINK
            caller = owner
    result.price === 30.0

    -- Non-updater should fail
    submitMustFail updater3 do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = []
                gasPriceUpdates = []
            caller = updater3

    -- Add another, including a duplicate
    fq <- submit owner do
        exerciseCmd fq AddPriceUpdaters with
            parties = [updater2, updater3]

    -- updater3 should now work
    fq <- submit updater3 do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = [
                        TokenPriceUpdate with
                            instrumentId = instrumentIdLINK
                            usdPerToken = 40.0
                    ]
                gasPriceUpdates = []
            caller = updater3

    -- Remove updater1
    fq <- submit owner do
        exerciseCmd fq RemovePriceUpdaters with
            parties = [updater1]

    -- updater1 should now fail
    submitMustFail updater1 do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = []
                gasPriceUpdates = []
            caller = updater1

    -- updater2 should still work
    fq <- submit updater2 do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = []
                gasPriceUpdates = []
            caller = updater2

    -- Adding owner as price updater should be filtered out
    fq <- submit owner do
        exerciseCmd fq AddPriceUpdaters with
            parties = [owner]

    Some fqData <- queryContractId owner fq
    assertMsg "owner should not be in priceUpdaters" (owner `notElem` fqData.priceUpdaters)

    -- try setting an invalid config (defaultTxGasLimit = 0), should fail
    let invalidDestChainConfig = destChainConfig1 with defaultTxGasLimit = 0
    submitMustFail owner do
        exerciseCmd fq ApplyDestChainConfigUpdates with
            destChainConfigArgs = [
                    (DestChainConfigArgs with
                        destChainSelector = destChainSelector1
                        destChainConfig = invalidDestChainConfig)
                ]

    pure()

testFeeQuoter_ApplyPriceUpdatersUpdate : Script ()
testFeeQuoter_ApplyPriceUpdatersUpdate = script do
    owner <- allocateParty "owner"
    priceUpdater <- allocateParty "price-updater"

    let instrumentIdLINK = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"

    fq <- submit owner do
        createCmd CCIP.FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter"
            feeTokens = Set.empty
            destChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.empty
            usdPerToken = Map.empty
            linkTokenInstrumentId = instrumentIdLINK
            priceUpdaters = []

    -- try updating prices as the owner, without being a price updater, should fail
    submitMustFail owner do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = []
                gasPriceUpdates = []
            caller = owner
    -- try updating prices as the price updater, should fail since not added yet
    submitMustFail owner do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = []
                gasPriceUpdates = []
            caller = priceUpdater

    -- add price updater
    fq <- submit owner do
        exerciseCmd fq ApplyPriceUpdatersUpdate with
            addedPriceUpdaters = [priceUpdater]
            removedPriceUpdaters = []
    
    -- try updating prices as the price updater, should succeed now
    fq <- submit priceUpdater do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = []
                gasPriceUpdates = []
            caller = priceUpdater

    -- add owner as price updater
    fq <- submit owner do
        exerciseCmd fq ApplyPriceUpdatersUpdate with
            addedPriceUpdaters = [owner]
            removedPriceUpdaters = []

    -- test that both owner and priceUpdater can update prices now
    fq <- submit owner do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = []
                gasPriceUpdates = []
            caller = owner
    fq <- submit priceUpdater do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = []
                gasPriceUpdates = []
            caller = priceUpdater

    -- remove price updater
    fq <- submit owner do
        exerciseCmd fq ApplyPriceUpdatersUpdate with
            addedPriceUpdaters = []
            removedPriceUpdaters = [priceUpdater]
    -- try updating prices as the removed price updater, should fail now
    submitMustFail priceUpdater do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = []
                gasPriceUpdates = []
            caller = priceUpdater
    -- owner should still be able to update prices
    fq <- submit owner do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = []
                gasPriceUpdates = []
            caller = owner

    -- test that removing and adding a price updater in the same update works
    fq <- submit owner do
        exerciseCmd fq ApplyPriceUpdatersUpdate with
            addedPriceUpdaters = [priceUpdater]
            removedPriceUpdaters = [priceUpdater, owner] -- also remove owner to test that removing a non-existing price updater is a no-op

    -- priceUpdater should be able to update prices again since re-added
    fq <- submit priceUpdater do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = []
                gasPriceUpdates = []
            caller = priceUpdater

    pure ()


testFinalizeFeeUsesEVMScaledPrices = script do
    owner <- allocateParty "owner-finalize-fee"
    sender <- allocateParty "sender-finalize-fee"
    ccvOwner <- allocateParty "ccv-owner-finalize-fee"
    executor <- allocateParty "executor-finalize-fee"

    let feeToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"

    feeQuoter <- submit owner do
        createCmd CCIP.FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter-finalize"
            feeTokens = Set.fromList [feeToken]
            destChainConfigs = Map.fromList [(456.0, testDestChainConfig)]
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.fromList
                [(456.0, TimestampedPrice 0.0 (time (date 2026 Jan 1) 0 0 0))]
            usdPerToken = Map.fromList [(feeToken, TimestampedPrice 20.0 (time (date 2026 Jan 1) 0 0 0))]
            linkTokenInstrumentId = feeToken
            priceUpdaters = [owner]

    sendingMessageCid <- submit owner do
        createCmd SendingMessageV1.SendingMessageV1 with
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "router-finalize-fee" sender
                onRamp = RawInstanceAddress.make "onramp-finalize-fee" owner
                globalConfig = RawInstanceAddress.make "globalconfig-finalize-fee" owner
                rmnRemote = RawInstanceAddress.make "rmn-finalize-fee" owner
                tokenAdminRegistry = RawInstanceAddress.make "tar-finalize-fee" owner
                feeQuoter = RawInstanceAddress.make "test-feequoter-finalize" owner
            ccipOwner = owner
            sender = sender
            destChainSelector = 456.0
            sequenceNumber = 1.0
            requiredCCVs = [RawInstanceAddress.make "ccv-premium" ccvOwner]
            requiredExecutor = None
            executorAddress = RawInstanceAddress.toInstanceAddress (RawInstanceAddress.make "executor-finalize-fee" executor)
            executionMode = Some SendingMessageV1.ExecutionMode_NoExecutor
            sourceChainSelector = 123.0
            senderAddress = "01"
            receiver = "02"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 0
            ccvAndExecutorHash = ""
            onRampAddress = "03"
            offRampAddress = "04"
            tokenReceiver = ""
            tokenArgs = ""
            feeToken = feeToken
            networkFeeUSDCents = cents 100.0
            expectedTokenInstrumentId = None
            outboundPoolCCVs = None
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            observingParties = [sender]
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            tokenSendData = None
            verifierData = []
            ccvOwners = []
            message = None
            encodedMessage = ""
            messageId = ""
            state = SendingMessageV1.SendingMessageState_Prepared

    sendingMessageCid <- finalizeUsingQuote owner feeQuoter sendingMessageCid

    finalized <- queryContractId owner sendingMessageCid
    let sm = fromSome finalized
    sm.networkFeeTokenAmount === 0.05

    debug "testFinalizeFeeUsesEVMScaledPrices: PASSED"

-- H-1: Non-unity premium (90% = LINK discount) applies only to premium fees.
-- Executor fee is converted at par (no premium).
testAddCCVFeeRejectsWrongRawInstanceAddress : Script ()
testAddCCVFeeRejectsWrongRawInstanceAddress = script do
    owner <- allocateParty "owner-raw-ccv"
    sender <- allocateParty "sender-raw-ccv"
    ccvOwner <- allocateParty "ccv-owner-raw-ccv"

    let feeToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"

    sendingMessageCid <- submit owner do
        createCmd SendingMessageV1.SendingMessageV1 with
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "router-raw-ccv" sender
                onRamp = RawInstanceAddress.make "onramp-raw-ccv" owner
                globalConfig = RawInstanceAddress.make "globalconfig-raw-ccv" owner
                rmnRemote = RawInstanceAddress.make "rmn-raw-ccv" owner
                tokenAdminRegistry = RawInstanceAddress.make "tar-raw-ccv" owner
                feeQuoter = RawInstanceAddress.make "feequoter-raw-ccv" owner
            ccipOwner = owner
            sender = sender
            destChainSelector = 456.0
            sequenceNumber = 1.0
            requiredCCVs = [RawInstanceAddress.make "ccv-allowed" ccvOwner]
            requiredExecutor = None
            executorAddress = RawInstanceAddress.toInstanceAddress (RawInstanceAddress.make "executor-raw-ccv" owner)
            executionMode = Some SendingMessageV1.ExecutionMode_NoExecutor
            sourceChainSelector = 123.0
            senderAddress = "01"
            receiver = "02"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 0
            ccvAndExecutorHash = ""
            onRampAddress = "03"
            offRampAddress = "04"
            tokenReceiver = ""
            tokenArgs = ""
            feeToken = feeToken
            networkFeeUSDCents = cents 0.0
            expectedTokenInstrumentId = None
            outboundPoolCCVs = None
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            observingParties = [sender]
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            tokenSendData = None
            verifierData = []
            ccvOwners = []
            message = None
            encodedMessage = ""
            messageId = ""
            state = SendingMessageV1.SendingMessageState_Prepared

    disclosedSm <- fromSome <$> queryDisclosure owner sendingMessageCid
    submitMustFail (actAs ccvOwner <> disclose disclosedSm) do
        exerciseCmd sendingMessageCid SendingMessageV1.AddCCVFee with
            ccvInstanceId = "ccv-wrong"
            feeUSDCents = cents 1.0
            destGasLimit = 10000
            destBytesOverhead = 0
            caller = ccvOwner

    sendingMessageCid <- submit (actAs ccvOwner <> disclose disclosedSm) do
        exerciseCmd sendingMessageCid SendingMessageV1.AddCCVFee with
            ccvInstanceId = "ccv-allowed"
            feeUSDCents = cents 1.0
            destGasLimit = 10000
            destBytesOverhead = 0
            caller = ccvOwner

    assertMsg "allowed raw instance should be accepted" True
    debug "testAddCCVFeeRejectsWrongRawInstanceAddress: PASSED"

testFinalizeFee_PremiumAndExecutor = script do
    owner <- allocateParty "owner-premium"
    sender <- allocateParty "sender-premium"
    ccvOwner <- allocateParty "ccv-owner-premium"
    executorOwner <- allocateParty "executor-owner-premium"

    let feeToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"

    -- linkFeeMultiplierPercent = 90 means 10% LINK discount.
    -- feeTokenPrice = 20.0 (20 USD per LINK)
    feeQuoter <- submit owner do
        createCmd CCIP.FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter-premium"
            feeTokens = Set.fromList [feeToken]
            destChainConfigs = Map.fromList [(456.0, testDestChainConfig with linkFeeMultiplierPercent = 90.0)]
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.fromList
                [(456.0, TimestampedPrice 0.0 (time (date 2026 Jan 1) 0 0 0))]
            usdPerToken = Map.fromList [(feeToken, TimestampedPrice 20.0 (time (date 2026 Jan 1) 0 0 0))]
            linkTokenInstrumentId = feeToken
            priceUpdaters = [owner]

    let senderAddr = "01"

    sendingMessageCid <- submit owner do
        createCmd SendingMessageV1.SendingMessageV1 with
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "router-premium" sender
                onRamp = RawInstanceAddress.make "onramp-premium" owner
                globalConfig = RawInstanceAddress.make "globalconfig-premium" owner
                rmnRemote = RawInstanceAddress.make "rmn-premium" owner
                tokenAdminRegistry = RawInstanceAddress.make "tar-premium" owner
                feeQuoter = RawInstanceAddress.make "test-feequoter-premium" owner
            ccipOwner = owner
            sender = sender
            destChainSelector = 456.0
            sequenceNumber = 1.0
            requiredCCVs = [RawInstanceAddress.make "ccv-premium" ccvOwner]
            requiredExecutor = Some (RawInstanceAddress.make "executor-premium" executorOwner)
            executorAddress = RawInstanceAddress.toInstanceAddress (RawInstanceAddress.make "executor-premium" executorOwner)
            executionMode = Some SendingMessageV1.ExecutionMode_Executor
            sourceChainSelector = 123.0
            senderAddress = senderAddr
            receiver = "02"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 0
            ccvAndExecutorHash = ""
            onRampAddress = "03"
            offRampAddress = "04"
            tokenReceiver = ""
            tokenArgs = ""
            feeToken = feeToken
            networkFeeUSDCents = cents 100.0
            expectedTokenInstrumentId = None
            outboundPoolCCVs = None
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            observingParties = [sender]
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            tokenSendData = None
            verifierData = []
            ccvOwners = []
            message = None
            encodedMessage = ""
            messageId = ""
            state = SendingMessageV1.SendingMessageState_Prepared

    -- Add CCV fee: 200 USD cents ($2.00)
    disclosedSm <- fromSome <$> queryDisclosure owner sendingMessageCid
    sendingMessageCid <- submit (actAs ccvOwner <> disclose disclosedSm) do
        exerciseCmd sendingMessageCid SendingMessageV1.AddCCVFee with
            ccvInstanceId = "ccv-premium"
            feeUSDCents = cents 200.0
            destGasLimit = 10000
            destBytesOverhead = 0
            caller = ccvOwner

    -- AddExecutorFee: 300 USD cents ($3.00)
    -- After AddCCVFee, ccvOwner is a signatory so query from ccvOwner
    disclosedSm2 <- fromSome <$> queryDisclosure ccvOwner sendingMessageCid
    sendingMessageCid <- submit (actAs executorOwner <> disclose disclosedSm2) do
        exerciseCmd sendingMessageCid SendingMessageV1.AddExecutorFee with
            executorInstanceId = "executor-premium"
            executorArgs = ""
            feeUSDCents = cents 300.0
            caller = executorOwner

    -- Finalize using QuoteGasForExec + SendingMessageV1.FinalizeFee.
    sendingMessageCid <- finalizeUsingQuote owner feeQuoter sendingMessageCid

    finalized <- queryContractId owner sendingMessageCid
    let sm = fromSome finalized

    -- Network fee (premium path): 100 cents = $1, then $1 * 0.9 / $20 = 0.045
    sm.networkFeeTokenAmount === 0.045

    -- CCV fee (premium path): 200 cents = $2, then $2 * 0.9 / $20 = 0.09
    let ccvAmount = case sm.ccvFeeTokenAmounts of
            [a] -> a
            _ -> error "Expected exactly one CCV fee amount"
    ccvAmount === 0.09

    -- Executor fee (direct path, NO premium): 300 cents = $3, then $3 * 1.0 / $20 = 0.15
    sm.executorFeeTokenAmount === 0.15

    debug "testFinalizeFee_PremiumAndExecutor: PASSED"

-- H-1: Small fee edge case with truncation.
-- Verifies that very small USD fees truncate correctly to integer token amounts.
testFinalizeFee_SmallFee = script do
    owner <- allocateParty "owner-small"
    sender <- allocateParty "sender-small"
    executorOwner <- allocateParty "executor-owner-small"

    let feeToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"

    -- feeTokenPrice = $20, non-LINK uses the implicit 100% multiplier.
    feeQuoter <- submit owner do
        createCmd CCIP.FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter-small"
            feeTokens = Set.fromList [feeToken]
            destChainConfigs = Map.fromList [(456.0, testDestChainConfig)]
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.fromList
                [(456.0, TimestampedPrice 0.0 (time (date 2026 Jan 1) 0 0 0))]
            usdPerToken = Map.fromList [(feeToken, TimestampedPrice 20.0 (time (date 2026 Jan 1) 0 0 0))]
            linkTokenInstrumentId = feeToken
            priceUpdaters = [owner]

    sendingMessageCid <- submit owner do
        createCmd SendingMessageV1.SendingMessageV1 with
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "router-small" sender
                onRamp = RawInstanceAddress.make "onramp-small" owner
                globalConfig = RawInstanceAddress.make "globalconfig-small" owner
                rmnRemote = RawInstanceAddress.make "rmn-small" owner
                tokenAdminRegistry = RawInstanceAddress.make "tar-small" owner
                feeQuoter = RawInstanceAddress.make "test-feequoter-small" owner
            ccipOwner = owner
            sender = sender
            destChainSelector = 456.0
            sequenceNumber = 1.0
            requiredCCVs = []
            requiredExecutor = Some (RawInstanceAddress.make "executor-small" executorOwner)
            executorAddress = RawInstanceAddress.toInstanceAddress (RawInstanceAddress.make "executor-small" executorOwner)
            executionMode = Some SendingMessageV1.ExecutionMode_Executor
            sourceChainSelector = 123.0
            senderAddress = "01"
            receiver = "02"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 0
            ccvAndExecutorHash = ""
            onRampAddress = "03"
            offRampAddress = "04"
            tokenReceiver = ""
            tokenArgs = ""
            feeToken = feeToken
            networkFeeUSDCents = cents 1.0
            expectedTokenInstrumentId = None
            outboundPoolCCVs = None
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            observingParties = [sender]
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            tokenSendData = None
            verifierData = []
            ccvOwners = []
            message = None
            encodedMessage = ""
            messageId = ""
            state = SendingMessageV1.SendingMessageState_Prepared

    disclosedSm <- fromSome <$> queryDisclosure owner sendingMessageCid
    sendingMessageCid <- submit (actAs executorOwner <> disclose disclosedSm) do
        exerciseCmd sendingMessageCid SendingMessageV1.AddExecutorFee with
            executorInstanceId = "executor-small"
            executorArgs = ""
            feeUSDCents = cents 1.0
            caller = executorOwner

    sendingMessageCid <- finalizeUsingQuote owner feeQuoter sendingMessageCid

    finalized <- queryContractId owner sendingMessageCid
    let sm = fromSome finalized

    -- 1 cent = $0.01, then $0.01 * 1.0 / $20 = 0.0005
    sm.networkFeeTokenAmount === 0.0005
    -- 1 cent = $0.01, then $0.01 * 1.0 / $20 = 0.0005
    sm.executorFeeTokenAmount === 0.0005

    debug "testFinalizeFee_SmallFee: PASSED"

-- QuoteGasForExec + SendingMessageV1.FinalizeFee should still convert
-- non-LINK fees into the selected fee token correctly.
testFinalizeFee_LinkCapAfterConversion = script do
    owner <- allocateParty "owner-link-cap"
    sender <- allocateParty "sender-link-cap"
    executorOwner <- allocateParty "executor-owner-link-cap"

    let linkToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"
    let feeToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "USDC"

    -- feeToken price = $1 per token
    -- LINK price = $15 per token
    -- network fee = $1.50 -> 1.5 fee tokens -> 0.1 LINK
    feeQuoter <- submit owner do
        createCmd CCIP.FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter-link-cap"
            feeTokens = Set.fromList [feeToken]
            destChainConfigs = Map.fromList [(456.0, testDestChainConfig)]
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.fromList
                [(456.0, TimestampedPrice 0.0 (time (date 2026 Jan 1) 0 0 0))]
            usdPerToken = Map.fromList
                [ (feeToken, TimestampedPrice 1.0 (time (date 2026 Jan 1) 0 0 0))
                , (linkToken, TimestampedPrice 15.0 (time (date 2026 Jan 1) 0 0 0))
                ]
            linkTokenInstrumentId = linkToken
            priceUpdaters = [owner]

    sendingMessageCid <- submit owner do
        createCmd SendingMessageV1.SendingMessageV1 with
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "router-link-cap" sender
                onRamp = RawInstanceAddress.make "onramp-link-cap" owner
                globalConfig = RawInstanceAddress.make "globalconfig-link-cap" owner
                rmnRemote = RawInstanceAddress.make "rmn-link-cap" owner
                tokenAdminRegistry = RawInstanceAddress.make "tar-link-cap" owner
                feeQuoter = RawInstanceAddress.make "test-feequoter-link-cap" owner
            ccipOwner = owner
            sender = sender
            destChainSelector = 456.0
            sequenceNumber = 1.0
            requiredCCVs = []
            requiredExecutor = None
            executorAddress = RawInstanceAddress.toInstanceAddress (RawInstanceAddress.make "executor-link-cap" executorOwner)
            executionMode = Some SendingMessageV1.ExecutionMode_NoExecutor
            sourceChainSelector = 123.0
            senderAddress = "01"
            receiver = "02"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 0
            ccvAndExecutorHash = ""
            onRampAddress = "03"
            offRampAddress = "04"
            tokenReceiver = ""
            tokenArgs = ""
            feeToken = feeToken
            networkFeeUSDCents = cents 150.0
            expectedTokenInstrumentId = None
            outboundPoolCCVs = None
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            observingParties = [sender]
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            tokenSendData = None
            verifierData = []
            ccvOwners = []
            message = None
            encodedMessage = ""
            messageId = ""
            state = SendingMessageV1.SendingMessageState_Prepared

    sendingMessageCid <- finalizeUsingQuote owner feeQuoter sendingMessageCid

    Some sm <- queryContractId owner sendingMessageCid
    sm.networkFeeTokenAmount === 1.5

    debug "testFinalizeFee_LinkCapAfterConversion: PASSED"

