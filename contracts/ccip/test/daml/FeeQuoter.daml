module FeeQuoter where

import Daml.Script

import DA.Assert
import DA.Date (Month(Jan), date)
import DA.Map qualified as Map
import DA.Optional (fromSome)
import DA.Time (time)

import CCIP.FeeQuoter
import CCIP.RawInstanceAddress qualified as RawInstanceAddress
import CCIP.SendingMessageV1 qualified as SendingMessageV1

import Splice.Api.Token.HoldingV1

usd : Decimal -> Numeric 0
usd d = intToNumeric (truncate (d * 100000000.0))

cents : Decimal -> Numeric 0
cents c = intToNumeric (truncate c)

usdToCents : Decimal -> Numeric 0
usdToCents d = intToNumeric (truncate (d * 100.0))

mult : Decimal -> Numeric 0
mult m = intToNumeric (truncate (m * 100000000.0))

testDestChainConfig : DestChainConfig
testDestChainConfig = DestChainConfig with
    isEnabled = True
    maxDataBytes = 100000
    maxPerMsgGasLimit = 1000000
    destGasOverhead = 0
    destGasPerPayloadByteBase = 0
    chainFamilySelector = "01"
    defaultTxGasLimit = 50000
    defaultTokenFeeUSD = 0.0
    defaultTokenDestGasOverhead = 0

setup = script do
    owner <- allocateParty "owner"

    let instrumentIdLINK = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"
    let instrumentIdUSDC = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "USDC"

    let destChainSelector1 : Numeric 0 = 1234567890.0
    let destChainSelector2 : Numeric 0 = 9876543210.0

    -- Create FeeQuoter
    fq <- submit owner do
        createCmd CCIP.FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter"
            feeTokens = Map.empty
            destChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.fromList
                [(456.0, TimestampedPrice 0.0 (time (date 2026 Jan 1) 0 0 0))]
            usdPerToken = Map.empty
            linkTokenInstrumentId = instrumentIdLINK
            priceUpdaters = [owner]

    -- Apply price updates for destChainSelector1 and instrumentIdLINK
    fq <- submit owner do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = [ 
                        TokenPriceUpdate with
                            instrumentId = instrumentIdLINK
                            usdPerToken = 1777000000.0
                    ]
                gasPriceUpdates = [
                        GasPriceUpdate with
                            destChainSelector = destChainSelector1
                            usdPerUnitGas = 4500000.0
                    ]
            caller = owner

    -- retrieve prices and assert
    result <- submit owner do
        exerciseCmd fq GetTokenPrice with
            instrumentId = instrumentIdLINK
            caller = owner
    debug result
    result.price === 1777000000.0

    result <- submit owner do
        exerciseCmd fq GetDestinationChainGasPrice with
            destChainSelector = destChainSelector1
            caller = owner
    debug result
    result.price === 4500000.0

    -- Apply prices again, this time for two chains and two instruments
    fq <- submit owner do
        exerciseCmd fq UpdatePrices with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = [ 
                        (TokenPriceUpdate with
                            instrumentId = instrumentIdLINK
                            usdPerToken = 2000000000.0),
                        (TokenPriceUpdate with
                            instrumentId = instrumentIdUSDC
                            usdPerToken = 100000000.0)
                    ]
                gasPriceUpdates = [
                        (GasPriceUpdate with
                            destChainSelector = destChainSelector1
                            usdPerUnitGas = 5000000.0),
                        (GasPriceUpdate with
                            destChainSelector = destChainSelector2
                            usdPerUnitGas = 7500000.0)
                    ]
            caller = owner

    -- retrieve prices for both and assert
    result <- submit owner do
        exerciseCmd fq GetTokenPrice with
            instrumentId = instrumentIdLINK
            caller = owner
    debug result
    result.price === 2000000000.0
    
    result <- submit owner do 
        exerciseCmd fq GetTokenPrice with
            instrumentId = instrumentIdUSDC
            caller = owner
    debug result
    result.price === 100000000.0

    result <- submit owner do
        exerciseCmd fq GetDestinationChainGasPrice with
            destChainSelector = destChainSelector1
            caller = owner
    debug result
    result.price === 5000000.0

    result <- submit owner do
        exerciseCmd fq GetDestinationChainGasPrice with
            destChainSelector = destChainSelector2
            caller = owner
    debug result
    result.price === 7500000.0

    -- test ApplyDestChainConfigUpdates
    let destChainConfig1 = DestChainConfig with
            isEnabled = True
            maxDataBytes = 5000
            destGasOverhead = 30000
            destGasPerPayloadByteBase = 12
            defaultTxGasLimit = 500000
            maxPerMsgGasLimit = 2000000
            chainFamilySelector = "2812d52c"
            defaultTokenFeeUSD = usdToCents 0.50
            defaultTokenDestGasOverhead = 0
    let destChainConfig2 = DestChainConfig with
            isEnabled = True
            maxDataBytes = 8000
            destGasOverhead = 40000
            destGasPerPayloadByteBase = 15
            defaultTxGasLimit = 800000
            maxPerMsgGasLimit = 3000000
            chainFamilySelector = "ac77ffec"
            defaultTokenFeeUSD = usdToCents 0.25
            defaultTokenDestGasOverhead = 0
    fq <- submit owner do
        exerciseCmd fq ApplyDestChainConfigUpdates with
            destChainConfigArgs = [
                    (DestChainConfigArgs with
                        destChainSelector = destChainSelector1
                        destChainConfig = destChainConfig1),
                    (DestChainConfigArgs with
                        destChainSelector = destChainSelector2
                        destChainConfig = destChainConfig2)
                ]

    result <- submit owner do
        exerciseCmd fq GetDestChainConfig with
            destChainSelector = destChainSelector1
            caller = owner
    debug result
    result === destChainConfig1
    result <- submit owner do
        exerciseCmd fq GetDestChainConfig with
            destChainSelector = destChainSelector2
            caller = owner
    debug result
    result === destChainConfig2

    -- try setting an invalid config (destChainSelector = 0.0), should fail
    submitMustFail owner do
        exerciseCmd fq ApplyDestChainConfigUpdates with
            destChainConfigArgs = [
                    (DestChainConfigArgs with
                        destChainSelector = 0.0
                        destChainConfig = destChainConfig1)
                ]

    -- try setting an invalid config (destChainSelector = -123.0), should fail
    submitMustFail owner do
        exerciseCmd fq ApplyDestChainConfigUpdates with
            destChainConfigArgs = [
                    (DestChainConfigArgs with
                        destChainSelector = -123.0
                        destChainConfig = destChainConfig1)
                ]

    -- try setting an invalid config (defaultTxGasLimit = 0), should fail
    let invalidDestChainConfig = destChainConfig1 with defaultTxGasLimit = 0
    submitMustFail owner do
        exerciseCmd fq ApplyDestChainConfigUpdates with
            destChainConfigArgs = [
                    (DestChainConfigArgs with
                        destChainSelector = destChainSelector1
                        destChainConfig = invalidDestChainConfig)
                ]

    -- try setting an invalid config (invalid chainFamilySelector), should fail
    let invalidDestChainConfig = destChainConfig1 with chainFamilySelector = "12345678"
    submitMustFail owner do
        exerciseCmd fq ApplyDestChainConfigUpdates with
            destChainConfigArgs = [
                    (DestChainConfigArgs with
                        destChainSelector = destChainSelector1
                        destChainConfig = invalidDestChainConfig)
                ]

    pure()

testFinalizeFeeUsesEVMScaledPrices = script do
    owner <- allocateParty "owner-finalize-fee"
    sender <- allocateParty "sender-finalize-fee"
    ccvOwner <- allocateParty "ccv-owner-finalize-fee"
    executor <- allocateParty "executor-finalize-fee"

    let feeToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"

    feeQuoter <- submit owner do
        createCmd CCIP.FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter-finalize"
            feeTokens = Map.fromList [(feeToken, 100000000.0)]
            destChainConfigs = Map.fromList [(456.0, testDestChainConfig)]
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.fromList
                [(456.0, TimestampedPrice 0.0 (time (date 2026 Jan 1) 0 0 0))]
            usdPerToken = Map.fromList [(feeToken, TimestampedPrice 2000000000.0 (time (date 2026 Jan 1) 0 0 0))]
            linkTokenInstrumentId = feeToken
            priceUpdaters = [owner]

    sendingMessageCid <- submit owner do
        createCmd SendingMessageV1.SendingMessageV1 with
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "router-finalize-fee" sender
                onRamp = RawInstanceAddress.make "onramp-finalize-fee" owner
                globalConfig = RawInstanceAddress.make "globalconfig-finalize-fee" owner
                rmnRemote = RawInstanceAddress.make "rmn-finalize-fee" owner
                tokenAdminRegistry = RawInstanceAddress.make "tar-finalize-fee" owner
                feeQuoter = RawInstanceAddress.make "test-feequoter-finalize" owner
            ccipOwner = owner
            sender = sender
            destChainSelector = 456.0
            sequenceNumber = 1.0
            requiredCCVs = [RawInstanceAddress.make "ccv-premium" ccvOwner]
            executorAddress = RawInstanceAddress.make "executor-finalize-fee" executor
            executionMode = Some SendingMessageV1.ExecutionMode_NoExecutor
            sourceChainSelector = 123.0
            senderAddress = "01"
            receiver = "02"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 0
            ccvAndExecutorHash = ""
            onRampAddress = "03"
            offRampAddress = "04"
            tokenReceiver = ""
            tokenArgs = ""
            feeToken = feeToken
            networkFeeUSDCents = cents 100.0
            expectedTokenInstrumentId = None
            outboundPoolCCVs = None
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            observingParties = [sender]
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            tokenSendData = None
            verifierData = []
            ccvOwners = []
            message = None
            encodedMessage = ""
            messageId = ""
            state = SendingMessageV1.SendingMessageState_Prepared

    sendingMessageCid <- submit owner do
        exerciseCmd feeQuoter CCIP.FeeQuoter.FeeQuoter_FinalizeFee with
            sendingMessageCid = sendingMessageCid
            caller = owner

    finalized <- queryContractId owner sendingMessageCid
    let sm = fromSome finalized
    sm.networkFeeTokenAmount === 5000000.0

    debug "testFinalizeFeeUsesEVMScaledPrices: PASSED"

-- H-1: Non-unity premium (90% = LINK discount) applies only to premium fees.
-- Executor fee is converted at par (no premium).
testAddCCVFeeRejectsWrongRawInstanceAddress : Script ()
testAddCCVFeeRejectsWrongRawInstanceAddress = script do
    owner <- allocateParty "owner-raw-ccv"
    sender <- allocateParty "sender-raw-ccv"
    ccvOwner <- allocateParty "ccv-owner-raw-ccv"

    let feeToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"

    sendingMessageCid <- submit owner do
        createCmd SendingMessageV1.SendingMessageV1 with
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "router-raw-ccv" sender
                onRamp = RawInstanceAddress.make "onramp-raw-ccv" owner
                globalConfig = RawInstanceAddress.make "globalconfig-raw-ccv" owner
                rmnRemote = RawInstanceAddress.make "rmn-raw-ccv" owner
                tokenAdminRegistry = RawInstanceAddress.make "tar-raw-ccv" owner
                feeQuoter = RawInstanceAddress.make "feequoter-raw-ccv" owner
            ccipOwner = owner
            sender = sender
            destChainSelector = 456.0
            sequenceNumber = 1.0
            requiredCCVs = [RawInstanceAddress.make "ccv-allowed" ccvOwner]
            executorAddress = RawInstanceAddress.make "executor-raw-ccv" owner
            executionMode = None
            sourceChainSelector = 123.0
            senderAddress = "01"
            receiver = "02"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 0
            ccvAndExecutorHash = ""
            onRampAddress = "03"
            offRampAddress = "04"
            tokenReceiver = ""
            tokenArgs = ""
            feeToken = feeToken
            networkFeeUSDCents = cents 0.0
            expectedTokenInstrumentId = None
            outboundPoolCCVs = None
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            observingParties = [sender]
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            tokenSendData = None
            verifierData = []
            ccvOwners = []
            message = None
            encodedMessage = ""
            messageId = ""
            state = SendingMessageV1.SendingMessageState_Prepared

    disclosedSm <- fromSome <$> queryDisclosure owner sendingMessageCid
    submitMustFail (actAs ccvOwner <> disclose disclosedSm) do
        exerciseCmd sendingMessageCid SendingMessageV1.AddCCVFee with
            ccvInstanceId = "ccv-wrong"
            feeUSDCents = cents 1.0
            destGasLimit = 10000
            destBytesOverhead = 0
            caller = ccvOwner

    sendingMessageCid <- submit (actAs ccvOwner <> disclose disclosedSm) do
        exerciseCmd sendingMessageCid SendingMessageV1.AddCCVFee with
            ccvInstanceId = "ccv-allowed"
            feeUSDCents = cents 1.0
            destGasLimit = 10000
            destBytesOverhead = 0
            caller = ccvOwner

    assertMsg "allowed raw instance should be accepted" True
    debug "testAddCCVFeeRejectsWrongRawInstanceAddress: PASSED"

testFinalizeFee_PremiumAndExecutor = script do
    owner <- allocateParty "owner-premium"
    sender <- allocateParty "sender-premium"
    ccvOwner <- allocateParty "ccv-owner-premium"
    executorOwner <- allocateParty "executor-owner-premium"

    let feeToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"

    -- premiumMultiplier = mult 0.9 means 90% (10% LINK discount) in the E8 scale
    -- feeTokenPrice = usd 20.0 (20 USD per LINK in the usd8 format)
    feeQuoter <- submit owner do
        createCmd CCIP.FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter-premium"
            feeTokens = Map.fromList [(feeToken, 90000000.0)]
            destChainConfigs = Map.fromList [(456.0, testDestChainConfig)]
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.fromList
                [(456.0, TimestampedPrice 0.0 (time (date 2026 Jan 1) 0 0 0))]
            usdPerToken = Map.fromList [(feeToken, TimestampedPrice 2000000000.0 (time (date 2026 Jan 1) 0 0 0))]
            linkTokenInstrumentId = feeToken
            priceUpdaters = [owner]

    let senderAddr = "01"

    sendingMessageCid <- submit owner do
        createCmd SendingMessageV1.SendingMessageV1 with
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "router-premium" sender
                onRamp = RawInstanceAddress.make "onramp-premium" owner
                globalConfig = RawInstanceAddress.make "globalconfig-premium" owner
                rmnRemote = RawInstanceAddress.make "rmn-premium" owner
                tokenAdminRegistry = RawInstanceAddress.make "tar-premium" owner
                feeQuoter = RawInstanceAddress.make "test-feequoter-premium" owner
            ccipOwner = owner
            sender = sender
            destChainSelector = 456.0
            sequenceNumber = 1.0
            requiredCCVs = [RawInstanceAddress.make "ccv-premium" ccvOwner]
            executorAddress = RawInstanceAddress.make "executor-premium" executorOwner
            executionMode = None
            sourceChainSelector = 123.0
            senderAddress = senderAddr
            receiver = "02"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 0
            ccvAndExecutorHash = ""
            onRampAddress = "03"
            offRampAddress = "04"
            tokenReceiver = ""
            tokenArgs = ""
            feeToken = feeToken
            networkFeeUSDCents = cents 100.0
            expectedTokenInstrumentId = None
            outboundPoolCCVs = None
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            observingParties = [sender]
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            tokenSendData = None
            verifierData = []
            ccvOwners = []
            message = None
            encodedMessage = ""
            messageId = ""
            state = SendingMessageV1.SendingMessageState_Prepared

    -- Add CCV fee: 200 USD cents ($2.00)
    disclosedSm <- fromSome <$> queryDisclosure owner sendingMessageCid
    sendingMessageCid <- submit (actAs ccvOwner <> disclose disclosedSm) do
        exerciseCmd sendingMessageCid SendingMessageV1.AddCCVFee with
            ccvInstanceId = "ccv-premium"
            feeUSDCents = cents 200.0
            destGasLimit = 10000
            destBytesOverhead = 0
            caller = ccvOwner

    -- AddExecutorFee: 300 USD cents ($3.00)
    -- After AddCCVFee, ccvOwner is a signatory so query from ccvOwner
    disclosedSm2 <- fromSome <$> queryDisclosure ccvOwner sendingMessageCid
    sendingMessageCid <- submit (actAs executorOwner <> disclose disclosedSm2) do
        exerciseCmd sendingMessageCid SendingMessageV1.AddExecutorFee with
            executorInstanceId = "executor-premium"
            executorArgs = ""
            feeUSDCents = cents 300.0
            caller = executorOwner

    -- FinalizeFee via FeeQuoter
    sendingMessageCid <- submit owner do
        exerciseCmd feeQuoter CCIP.FeeQuoter.FeeQuoter_FinalizeFee with
            sendingMessageCid = sendingMessageCid
            caller = owner

    finalized <- queryContractId owner sendingMessageCid
    let sm = fromSome finalized

    -- Network fee (premium path): 100 cents -> 1e8 usd8, then 1e8 * 0.9e8 / 20e8 = 4.5e6
    sm.networkFeeTokenAmount === 4500000.0

    -- CCV fee (premium path): 200 cents -> 2e8 usd8, then 2e8 * 0.9e8 / 20e8 = 9e6
    let ccvAmount = case sm.ccvFeeTokenAmounts of
            [a] -> a
            _ -> error "Expected exactly one CCV fee amount"
    ccvAmount === 9000000.0

    -- Executor fee (direct path, NO premium): 300 cents -> 3e8 usd8, then 3e8 * 1e8 / 20e8 = 1.5e7
    sm.executorFeeTokenAmount === 15000000.0

    debug "testFinalizeFee_PremiumAndExecutor: PASSED"

-- H-1: Small fee edge case with truncation.
-- Verifies that very small USD fees truncate correctly to integer token amounts.
testFinalizeFee_SmallFee = script do
    owner <- allocateParty "owner-small"
    sender <- allocateParty "sender-small"
    executorOwner <- allocateParty "executor-owner-small"

    let feeToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"

    -- feeTokenPrice = usd 20.0, premiumMultiplier = mult 1.0 (100%)
    feeQuoter <- submit owner do
        createCmd CCIP.FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter-small"
            feeTokens = Map.fromList [(feeToken, 100000000.0)]
            destChainConfigs = Map.fromList [(456.0, testDestChainConfig)]
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.fromList
                [(456.0, TimestampedPrice 0.0 (time (date 2026 Jan 1) 0 0 0))]
            usdPerToken = Map.fromList [(feeToken, TimestampedPrice 2000000000.0 (time (date 2026 Jan 1) 0 0 0))]
            linkTokenInstrumentId = feeToken
            priceUpdaters = [owner]

    sendingMessageCid <- submit owner do
        createCmd SendingMessageV1.SendingMessageV1 with
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "router-small" sender
                onRamp = RawInstanceAddress.make "onramp-small" owner
                globalConfig = RawInstanceAddress.make "globalconfig-small" owner
                rmnRemote = RawInstanceAddress.make "rmn-small" owner
                tokenAdminRegistry = RawInstanceAddress.make "tar-small" owner
                feeQuoter = RawInstanceAddress.make "test-feequoter-small" owner
            ccipOwner = owner
            sender = sender
            destChainSelector = 456.0
            sequenceNumber = 1.0
            requiredCCVs = []
            executorAddress = RawInstanceAddress.make "executor-small" executorOwner
            executionMode = None
            sourceChainSelector = 123.0
            senderAddress = "01"
            receiver = "02"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 0
            ccvAndExecutorHash = ""
            onRampAddress = "03"
            offRampAddress = "04"
            tokenReceiver = ""
            tokenArgs = ""
            feeToken = feeToken
            networkFeeUSDCents = cents 1.0
            expectedTokenInstrumentId = None
            outboundPoolCCVs = None
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            observingParties = [sender]
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            tokenSendData = None
            verifierData = []
            ccvOwners = []
            message = None
            encodedMessage = ""
            messageId = ""
            state = SendingMessageV1.SendingMessageState_Prepared

    disclosedSm <- fromSome <$> queryDisclosure owner sendingMessageCid
    sendingMessageCid <- submit (actAs executorOwner <> disclose disclosedSm) do
        exerciseCmd sendingMessageCid SendingMessageV1.AddExecutorFee with
            executorInstanceId = "executor-small"
            executorArgs = ""
            feeUSDCents = cents 1.0
            caller = executorOwner

    sendingMessageCid <- submit owner do
        exerciseCmd feeQuoter CCIP.FeeQuoter.FeeQuoter_FinalizeFee with
            sendingMessageCid = sendingMessageCid
            caller = owner

    finalized <- queryContractId owner sendingMessageCid
    let sm = fromSome finalized

    -- 1 cent -> 1e6 usd8, then 1e6 * 1e8 / 20e8 = 5e4
    sm.networkFeeTokenAmount === 50000.0
    -- 1 cent -> 1e6 usd8, then 1e6 * 1e8 / 20e8 = 5e4
    sm.executorFeeTokenAmount === 50000.0

    debug "testFinalizeFee_SmallFee: PASSED"

-- FeeQuoter_FinalizeFee no longer applies a LINK-denominated cap.
-- It should still convert non-LINK fees into the selected fee token correctly.
testFinalizeFee_LinkCapAfterConversion = script do
    owner <- allocateParty "owner-link-cap"
    sender <- allocateParty "sender-link-cap"
    executorOwner <- allocateParty "executor-owner-link-cap"

    let linkToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"
    let feeToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "USDC"

    -- feeToken price = usd 1.0 ($1 per token in usd8)
    -- LINK price = usd 15.0 ($15 per token in usd8)
    -- network fee = $1.50 -> 1.5 fee tokens -> 0.1 LINK
    feeQuoter <- submit owner do
        createCmd CCIP.FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter-link-cap"
            feeTokens = Map.fromList [(feeToken, 100000000.0)]
            destChainConfigs = Map.fromList [(456.0, testDestChainConfig)]
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.fromList
                [(456.0, TimestampedPrice 0.0 (time (date 2026 Jan 1) 0 0 0))]
            usdPerToken = Map.fromList
                [ (feeToken, TimestampedPrice 100000000.0 (time (date 2026 Jan 1) 0 0 0))
                , (linkToken, TimestampedPrice 1500000000.0 (time (date 2026 Jan 1) 0 0 0))
                ]
            linkTokenInstrumentId = linkToken
            priceUpdaters = [owner]

    sendingMessageCid <- submit owner do
        createCmd SendingMessageV1.SendingMessageV1 with
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "router-link-cap" sender
                onRamp = RawInstanceAddress.make "onramp-link-cap" owner
                globalConfig = RawInstanceAddress.make "globalconfig-link-cap" owner
                rmnRemote = RawInstanceAddress.make "rmn-link-cap" owner
                tokenAdminRegistry = RawInstanceAddress.make "tar-link-cap" owner
                feeQuoter = RawInstanceAddress.make "test-feequoter-link-cap" owner
            ccipOwner = owner
            sender = sender
            destChainSelector = 456.0
            sequenceNumber = 1.0
            requiredCCVs = []
            executorAddress = RawInstanceAddress.make "executor-link-cap" executorOwner
            executionMode = Some SendingMessageV1.ExecutionMode_NoExecutor
            sourceChainSelector = 123.0
            senderAddress = "01"
            receiver = "02"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 0
            ccvAndExecutorHash = ""
            onRampAddress = "03"
            offRampAddress = "04"
            tokenReceiver = ""
            tokenArgs = ""
            feeToken = feeToken
            networkFeeUSDCents = cents 150.0
            expectedTokenInstrumentId = None
            outboundPoolCCVs = None
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            observingParties = [sender]
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            tokenSendData = None
            verifierData = []
            ccvOwners = []
            message = None
            encodedMessage = ""
            messageId = ""
            state = SendingMessageV1.SendingMessageState_Prepared

    sendingMessageCid <- submit owner do
        exerciseCmd feeQuoter CCIP.FeeQuoter.FeeQuoter_FinalizeFee with
            sendingMessageCid = sendingMessageCid
            caller = owner

    Some sm <- queryContractId owner sendingMessageCid
    sm.networkFeeTokenAmount === 150000000.0

    debug "testFinalizeFee_LinkCapAfterConversion: PASSED"

-- FeeQuoter_FinalizeFee should convert direct LINK fees at par when LINK is the fee token.
testFinalizeFee_LinkCapDirect = script do
    owner <- allocateParty "owner-link-direct-cap"
    sender <- allocateParty "sender-link-direct-cap"
    executorOwner <- allocateParty "executor-owner-link-direct-cap"

    let linkToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"

    -- $1.50 fee at $15/LINK -> 0.1 LINK = 1e7 local LINK units = 1e17 juels
    feeQuoter <- submit owner do
        createCmd CCIP.FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter-link-direct-cap"
            feeTokens = Map.fromList [(linkToken, 100000000.0)]
            destChainConfigs = Map.fromList [(456.0, testDestChainConfig)]
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.fromList
                [(456.0, TimestampedPrice 0.0 (time (date 2026 Jan 1) 0 0 0))]
            usdPerToken = Map.fromList
                [ (linkToken, TimestampedPrice 1500000000.0 (time (date 2026 Jan 1) 0 0 0)) ]
            linkTokenInstrumentId = linkToken
            priceUpdaters = [owner]

    sendingMessageCid <- submit owner do
        createCmd SendingMessageV1.SendingMessageV1 with
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "router-link-direct-cap" sender
                onRamp = RawInstanceAddress.make "onramp-link-direct-cap" owner
                globalConfig = RawInstanceAddress.make "globalconfig-link-direct-cap" owner
                rmnRemote = RawInstanceAddress.make "rmn-link-direct-cap" owner
                tokenAdminRegistry = RawInstanceAddress.make "tar-link-direct-cap" owner
                feeQuoter = RawInstanceAddress.make "test-feequoter-link-direct-cap" owner
            ccipOwner = owner
            sender = sender
            destChainSelector = 456.0
            sequenceNumber = 1.0
            requiredCCVs = []
            executorAddress = RawInstanceAddress.make "executor-link-direct-cap" executorOwner
            executionMode = Some SendingMessageV1.ExecutionMode_NoExecutor
            sourceChainSelector = 123.0
            senderAddress = "01"
            receiver = "02"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 0
            ccvAndExecutorHash = ""
            onRampAddress = "03"
            offRampAddress = "04"
            tokenReceiver = ""
            tokenArgs = ""
            feeToken = linkToken
            networkFeeUSDCents = cents 150.0
            expectedTokenInstrumentId = None
            outboundPoolCCVs = None
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            observingParties = [sender]
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            tokenSendData = None
            verifierData = []
            ccvOwners = []
            message = None
            encodedMessage = ""
            messageId = ""
            state = SendingMessageV1.SendingMessageState_Prepared

    sendingMessageCid <- submit owner do
        exerciseCmd feeQuoter CCIP.FeeQuoter.FeeQuoter_FinalizeFee with
            sendingMessageCid = sendingMessageCid
            caller = owner

    Some sm <- queryContractId owner sendingMessageCid
    sm.networkFeeTokenAmount === 10000000.0

    debug "testFinalizeFee_LinkCapDirect: PASSED"

-- FeeQuoter_FinalizeFee should still sum all converted fee components correctly.
testFinalizeFee_LinkCapMixedFees = script do
    owner <- allocateParty "owner-link-mixed-cap"
    sender <- allocateParty "sender-link-mixed-cap"
    ccvOwner <- allocateParty "ccv-link-mixed-cap"
    poolOwner <- allocateParty "pool-link-mixed-cap"
    executorOwner <- allocateParty "executor-link-mixed-cap"

    let linkToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"

    feeQuoter <- submit owner do
        createCmd CCIP.FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter-link-mixed-cap"
            feeTokens = Map.fromList [(linkToken, 100000000.0)]
            destChainConfigs = Map.fromList [(456.0, testDestChainConfig)]
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.fromList
                [(456.0, TimestampedPrice 0.0 (time (date 2026 Jan 1) 0 0 0))]
            usdPerToken = Map.fromList
                [ (linkToken, TimestampedPrice 2000000000.0 (time (date 2026 Jan 1) 0 0 0)) ]
            linkTokenInstrumentId = linkToken
            priceUpdaters = [owner]

    sendingMessageCid <- submit owner do
        createCmd SendingMessageV1.SendingMessageV1 with
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "router-link-mixed-cap" sender
                onRamp = RawInstanceAddress.make "onramp-link-mixed-cap" owner
                globalConfig = RawInstanceAddress.make "globalconfig-link-mixed-cap" owner
                rmnRemote = RawInstanceAddress.make "rmn-link-mixed-cap" owner
                tokenAdminRegistry = RawInstanceAddress.make "tar-link-mixed-cap" owner
                feeQuoter = RawInstanceAddress.make "test-feequoter-link-mixed-cap" owner
            ccipOwner = owner
            sender = sender
            destChainSelector = 456.0
            sequenceNumber = 1.0
            requiredCCVs = [RawInstanceAddress.make "ccv-link-mixed-cap" ccvOwner]
            executorAddress = RawInstanceAddress.make "executor-link-mixed-cap" executorOwner
            executionMode = None
            sourceChainSelector = 123.0
            senderAddress = "01"
            receiver = "02"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 0
            ccvAndExecutorHash = ""
            onRampAddress = "03"
            offRampAddress = "04"
            tokenReceiver = ""
            tokenArgs = ""
            feeToken = linkToken
            networkFeeUSDCents = cents 100.0
            expectedTokenInstrumentId = Some linkToken
            outboundPoolCCVs = Some []
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            observingParties = [sender]
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            tokenSendData = None
            verifierData = []
            ccvOwners = []
            message = None
            encodedMessage = ""
            messageId = ""
            state = SendingMessageV1.SendingMessageState_Prepared

    disclosedSm <- fromSome <$> queryDisclosure owner sendingMessageCid
    sendingMessageCid <- submit (actAs ccvOwner <> disclose disclosedSm) do
        exerciseCmd sendingMessageCid SendingMessageV1.AddCCVFee with
            ccvInstanceId = "ccv-link-mixed-cap"
            feeUSDCents = cents 100.0
            destGasLimit = 10000
            destBytesOverhead = 0
            caller = ccvOwner

    sendingMessageCid <- submit owner do
        exerciseCmd sendingMessageCid SendingMessageV1.AddTokenSendFee with
            poolInstanceId = "pool-link-mixed-cap"
            poolOwner = poolOwner
            feeUSDCents = cents 100.0
            destGasOverhead = 50000
            destBytesOverhead = 0

    disclosedSm <- fromSome <$> queryDisclosure ccvOwner sendingMessageCid
    sendingMessageCid <- submit (actAs executorOwner <> disclose disclosedSm) do
        exerciseCmd sendingMessageCid SendingMessageV1.AddExecutorFee with
            executorInstanceId = "executor-link-mixed-cap"
            executorArgs = ""
            feeUSDCents = cents 100.0
            caller = executorOwner

    sendingMessageCid <- submit owner do
        exerciseCmd feeQuoter CCIP.FeeQuoter.FeeQuoter_FinalizeFee with
            sendingMessageCid = sendingMessageCid
            caller = owner

    Some sm <- queryContractId owner sendingMessageCid
    sm.ccvFeeTokenAmounts === [5000000.0]
    sm.tokenSendFeeTokenAmount === 5000000.0
    sm.executorFeeTokenAmount === 5000000.0
    sm.networkFeeTokenAmount === 5000000.0

    debug "testFinalizeFee_LinkCapMixedFees: PASSED"
