-- QuoteGasForExec + SendingMessageV1.FinalizeFee should still sum all
-- converted fee components correctly.
testFinalizeFee_LinkCapMixedFees = script do
    owner <- allocateParty "owner-link-mixed-cap"
    sender <- allocateParty "sender-link-mixed-cap"
    ccvOwner <- allocateParty "ccv-link-mixed-cap"
    poolOwner <- allocateParty "pool-link-mixed-cap"
    executorOwner <- allocateParty "executor-link-mixed-cap"

    let linkToken = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = owner
            id = "LINK"

    feeQuoter <- submit owner do
        createCmd CCIP.FeeQuoter.FeeQuoter with
            owner = owner
            instanceId = "test-feequoter-link-mixed-cap"
            feeTokens = Set.fromList [linkToken]
            destChainConfigs = Map.fromList [(456.0, testDestChainConfig)]
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.fromList
                [(456.0, TimestampedPrice 0.0 (time (date 2026 Jan 1) 0 0 0))]
            usdPerToken = Map.fromList
                [ (linkToken, TimestampedPrice 20.0 (time (date 2026 Jan 1) 0 0 0)) ]
            linkTokenInstrumentId = linkToken
            priceUpdaters = [owner]

    sendingMessageCid <- submit owner do
        createCmd SendingMessageV1.SendingMessageV1 with
            deps = SendingMessageV1.SendingMessageDeps with
                router = RawInstanceAddress.make "router-link-mixed-cap" sender
                onRamp = RawInstanceAddress.make "onramp-link-mixed-cap" owner
                globalConfig = RawInstanceAddress.make "globalconfig-link-mixed-cap" owner
                rmnRemote = RawInstanceAddress.make "rmn-link-mixed-cap" owner
                tokenAdminRegistry = RawInstanceAddress.make "tar-link-mixed-cap" owner
                feeQuoter = RawInstanceAddress.make "test-feequoter-link-mixed-cap" owner
            ccipOwner = owner
            sender = sender
            destChainSelector = 456.0
            sequenceNumber = 1.0
            requiredCCVs = [RawInstanceAddress.make "ccv-link-mixed-cap" ccvOwner]
            requiredExecutor = Some (RawInstanceAddress.make "executor-link-mixed-cap" executorOwner)
            executorAddress = RawInstanceAddress.toInstanceAddress(RawInstanceAddress.make "executor-link-mixed-cap" executorOwner)
            executionMode = Some SendingMessageV1.ExecutionMode_Executor
            sourceChainSelector = 123.0
            senderAddress = "01"
            receiver = "02"
            payload = ""
            executionGasLimit = 0
            ccipReceiveGasLimit = 0
            ccvAndExecutorHash = ""
            onRampAddress = "03"
            offRampAddress = "04"
            tokenReceiver = ""
            tokenArgs = ""
            feeToken = linkToken
            networkFeeUSDCents = cents 100.0
            expectedTokenInstrumentId = Some linkToken
            outboundPoolCCVs = Some []
            executorArgs = ""
            executorFee = None
            executorDestGasLimit = 0
            executorDestBytesOverhead = 0
            executorFeeTokenAmount = 0.0
            observingParties = [sender]
            ccvFees = []
            tokenSendFee = None
            ccvFeeTokenAmounts = []
            tokenSendFeeTokenAmount = 0.0
            networkFeeTokenAmount = 0.0
            tokenSendData = None
            verifierData = []
            ccvOwners = []
            message = None
            encodedMessage = ""
            messageId = ""
            state = SendingMessageV1.SendingMessageState_Prepared

    disclosedSm <- fromSome <$> queryDisclosure owner sendingMessageCid
    sendingMessageCid <- submit (actAs ccvOwner <> disclose disclosedSm) do
        exerciseCmd sendingMessageCid SendingMessageV1.AddCCVFee with
            ccvInstanceId = "ccv-link-mixed-cap"
            feeUSDCents = cents 100.0
            destGasLimit = 10000
            destBytesOverhead = 0
            caller = ccvOwner

    sendingMessageCid <- submit owner do
        exerciseCmd sendingMessageCid SendingMessageV1.AddTokenSendFee with
            poolInstanceId = "pool-link-mixed-cap"
            poolOwner = poolOwner
            feeUSDCents = cents 100.0
            destGasOverhead = 50000
            destBytesOverhead = 0

    disclosedSm <- fromSome <$> queryDisclosure ccvOwner sendingMessageCid
    sendingMessageCid <- submit (actAs executorOwner <> disclose disclosedSm) do
        exerciseCmd sendingMessageCid SendingMessageV1.AddExecutorFee with
            executorInstanceId = "executor-link-mixed-cap"
            executorArgs = ""
            feeUSDCents = cents 100.0
            caller = executorOwner

    sendingMessageCid <- finalizeUsingQuote owner feeQuoter sendingMessageCid

    Some sm <- queryContractId owner sendingMessageCid
    sm.ccvFeeTokenAmounts === [0.05]
    sm.tokenSendFeeTokenAmount === 0.05
    sm.executorFeeTokenAmount === 0.05
    sm.networkFeeTokenAmount === 0.05

    debug "testFinalizeFee_LinkCapMixedFees: PASSED"
