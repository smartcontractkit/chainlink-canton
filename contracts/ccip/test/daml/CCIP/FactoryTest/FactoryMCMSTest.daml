-- | Test duplicate singleton deployment rejection
testDeployGlobalConfig_Duplicate_Rejected : Script ()
testDeployGlobalConfig_Duplicate_Rejected = script do
  mcmsParty <- allocateParty "mcms_party"

  let factoryInstanceId = "factory-gc-dup"

  factoryCid <- submit mcmsParty do
    createCmd CCIPFactory with
      instanceId = factoryInstanceId
      owner = mcmsParty
      mcmsParty
      usedInstanceIds = Map.empty
      deployedContracts = Map.empty
      perPartyRouterFactoryDeployed = False

  let instAddr = RawInstanceAddress.makeText factoryInstanceId mcmsParty
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver factoryCid
  let params1 = DeployGlobalConfigParams with
        instanceId = "gc-1"
        chainSelector = 123.0
      encoded1 = encodeDeployGlobalConfigParams params1

  -- First deployment succeeds
  newContractIds <- submit mcmsParty do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "DeployGlobalConfig"
      operationData = encoded1
      contractIds = Map.fromList [(instAddr, toAnyContractId factoryCid)]

  -- Get updated factory CID
  factories <- query @CCIPFactory mcmsParty
  case filter (\(_, f) -> f.instanceId == factoryInstanceId) factories of
    [(newCid, _)] -> do
      let targetAsMcmsReceiver2 = toInterfaceContractId @MCMSReceiver newCid
      let params2 = DeployGlobalConfigParams with
            instanceId = "gc-2"
            chainSelector = 456.0
          encoded2 = encodeDeployGlobalConfigParams params2

      -- Second deployment should fail (singleton already deployed)
      submitMustFail mcmsParty do
        exerciseCmd targetAsMcmsReceiver2 MCMSReceiver_Entrypoint with
          functionName = "DeployGlobalConfig"
          operationData = encoded2
          contractIds = Map.fromList [(instAddr, toAnyContractId newCid)]

    _ -> abort "Expected factory contract"

  pure ()

-- | Test instanceId collision rejection
testInstanceIdCollision_Rejected : Script ()
testInstanceIdCollision_Rejected = script do
  mcmsParty <- allocateParty "mcms_party"

  let factoryInstanceId = "factory-collision"
      sharedInstanceId = "shared-inst-id"

  factoryCid <- submit mcmsParty do
    createCmd CCIPFactory with
      instanceId = factoryInstanceId
      owner = mcmsParty
      mcmsParty
      usedInstanceIds = Map.fromList [(sharedInstanceId, True)]
      deployedContracts = Map.empty
      perPartyRouterFactoryDeployed = False

  let instAddr = RawInstanceAddress.makeText factoryInstanceId mcmsParty
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver factoryCid
  let params = DeployGlobalConfigParams with
        instanceId = sharedInstanceId
        chainSelector = 123.0
      encoded = encodeDeployGlobalConfigParams params

  submitMustFail mcmsParty do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "DeployGlobalConfig"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId factoryCid)]

