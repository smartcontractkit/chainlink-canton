      perPartyRouterFactoryDeployed = False

  let instAddr = Chainlink.InstanceAddress.makeText factoryInstanceId mcmsParty
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver factoryCid
  let params = CCIP.FactoryV1.DeployExecutorParams with
        instanceId = "executor-1"
        owner = mcmsParty
        maxCCVsPerMsg = 10
        allowedFinalityConfig = finalityConfig 0
        ccvAllowlistEnabled = False
      encoded = encodeDeployExecutorParams params

  submit mcmsParty do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "DeployExecutor"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId factoryCid)]

  pure ()

-- | Test DeployRateLimiter via MCMS entrypoint
-- RateLimiter has poolOwner as signatory, so mcmsParty is used as poolOwner
testDeployRateLimiter_MCMS : Script ()
testDeployRateLimiter_MCMS = script do
  mcmsParty <- allocateParty "mcms_party"

  let factoryInstanceId = "factory-rl"

  factoryCid <- submit mcmsParty do
    createCmd CCIP.FactoryV1.CCIPFactory with
      instanceId = factoryInstanceId
      owner = mcmsParty
      mcmsParty
      usedInstanceIds = Map.empty
      deployedContracts = Map.empty
      perPartyRouterFactoryDeployed = False

  let instAddr = Chainlink.InstanceAddress.makeText factoryInstanceId mcmsParty
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver factoryCid
  -- Use mcmsParty as poolOwner so authorization works within single party
  let params = CCIP.FactoryV1.DeployRateLimiterParams with
        instanceId = "rl-1"
        poolInstanceId = "pool-1"
        poolOwner = mcmsParty
        remoteChainSelector = 137.0
        direction = CCIP.RateLimiterV1.RateLimitDirection_Outbound
        mode = CCIP.RateLimiterV1.RateLimitMode_DefaultFinality
        isEnabled = True
        capacity = 1000000.0
        rate = 100.0
      encoded = encodeDeployRateLimiterParams params

  submit mcmsParty do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "DeployRateLimiter"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId factoryCid)]

  pure ()

-- | Test multiple non-singleton deployments with different instanceIds
-- Uses mcmsParty as poolOwner for authorization simplicity
testMultipleNonSingletonDeployments : Script ()
testMultipleNonSingletonDeployments = script do
  mcmsParty <- allocateParty "mcms_party"

  let factoryInstanceId = "factory-multi"

  factoryCid <- submit mcmsParty do
    createCmd CCIP.FactoryV1.CCIPFactory with
      instanceId = factoryInstanceId
      owner = mcmsParty
      mcmsParty
      usedInstanceIds = Map.empty
      deployedContracts = Map.empty
      perPartyRouterFactoryDeployed = False

  let instAddr = Chainlink.InstanceAddress.makeText factoryInstanceId mcmsParty

  -- Deploy first rate limiter
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver factoryCid
  let params1 = CCIP.FactoryV1.DeployRateLimiterParams with
        instanceId = "rl-outbound"
        poolInstanceId = "pool-1"
        poolOwner = mcmsParty
        remoteChainSelector = 137.0
        direction = CCIP.RateLimiterV1.RateLimitDirection_Outbound
        mode = CCIP.RateLimiterV1.RateLimitMode_DefaultFinality
        isEnabled = True
        capacity = 1000000.0
        rate = 100.0
      encoded1 = encodeDeployRateLimiterParams params1

  submit mcmsParty do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "DeployRateLimiter"
      operationData = encoded1
      contractIds = Map.fromList [(instAddr, toAnyContractId factoryCid)]

  -- Get updated factory
  factories <- query @CCIP.FactoryV1.CCIPFactory mcmsParty
  case filter (\(_, f) -> f.instanceId == factoryInstanceId) factories of
    [(newCid, _)] -> do
      -- Deploy second rate limiter with different instanceId
      let targetAsMcmsReceiver2 = toInterfaceContractId @MCMSReceiver newCid
      let params2 = CCIP.FactoryV1.DeployRateLimiterParams with
            instanceId = "rl-inbound"
            poolInstanceId = "pool-1"
            poolOwner = mcmsParty
            remoteChainSelector = 137.0
            direction = CCIP.RateLimiterV1.RateLimitDirection_Inbound
            mode = CCIP.RateLimiterV1.RateLimitMode_CustomFinality
            isEnabled = False
            capacity = 500000.0
            rate = 50.0
          encoded2 = encodeDeployRateLimiterParams params2

      submit mcmsParty do
        exerciseCmd targetAsMcmsReceiver2 MCMSReceiver_Entrypoint with
          functionName = "DeployRateLimiter"
          operationData = encoded2
          contractIds = Map.fromList [(instAddr, toAnyContractId newCid)]

    _ -> abort "Expected factory contract"

  pure ()

