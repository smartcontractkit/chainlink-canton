-- ===========================================================================

-- | Test unknown function rejection
testUnknownFunction_Rejected : Script ()
testUnknownFunction_Rejected = script do
  mcmsParty <- allocateParty "mcms_party"

  let factoryInstanceId = "factory-unknown"

  factoryCid <- submit mcmsParty do
    createCmd CCIPFactory with
      instanceId = factoryInstanceId
      owner = mcmsParty
      mcmsParty
      usedInstanceIds = Map.empty
      deployedContracts = Map.empty
      perPartyRouterFactoryDeployed = False

  let instAddr = RawInstanceAddress.makeText factoryInstanceId mcmsParty
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver factoryCid

  submitMustFail mcmsParty do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "NonExistentFunction"
      operationData = ""
      contractIds = Map.fromList [(instAddr, toAnyContractId factoryCid)]

  pure ()

-- | Test invalid params rejection
testInvalidParams_Rejected : Script ()
testInvalidParams_Rejected = script do
  mcmsParty <- allocateParty "mcms_party"

  let factoryInstanceId = "factory-invalid"

  factoryCid <- submit mcmsParty do
    createCmd CCIPFactory with
      instanceId = factoryInstanceId
      owner = mcmsParty
      mcmsParty
      usedInstanceIds = Map.empty
      deployedContracts = Map.empty
      perPartyRouterFactoryDeployed = False

  let instAddr = RawInstanceAddress.makeText factoryInstanceId mcmsParty
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver factoryCid

  submitMustFail mcmsParty do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "DeployGlobalConfig"
      operationData = "ff"  -- Invalid data
      contractIds = Map.fromList [(instAddr, toAnyContractId factoryCid)]

  pure ()

-- | Test missing self CID rejection
testMissingSelfCid_Rejected : Script ()
testMissingSelfCid_Rejected = script do
  mcmsParty <- allocateParty "mcms_party"

  let factoryInstanceId = "factory-missing-cid"

  factoryCid <- submit mcmsParty do
    createCmd CCIPFactory with
      instanceId = factoryInstanceId
      owner = mcmsParty
      mcmsParty
      usedInstanceIds = Map.empty
      deployedContracts = Map.empty
      perPartyRouterFactoryDeployed = False

  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver factoryCid
  let params = DeployGlobalConfigParams with
        instanceId = "gc-1"
        chainSelector = 123.0
      encoded = encodeDeployGlobalConfigParams params

  submitMustFail mcmsParty do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "DeployGlobalConfig"
      operationData = encoded
      contractIds = Map.empty  -- Missing self CID

  pure ()

-- ===========================================================================
-- HELPERS
-- ===========================================================================

toAnyContractId : ContractId a -> ContractId ()
toAnyContractId = coerceContractId
