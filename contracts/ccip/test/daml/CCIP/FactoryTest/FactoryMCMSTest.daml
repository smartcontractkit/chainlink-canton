-- | Test DeployRMNRemote via MCMS entrypoint
-- RMNRemote has rmnOwner as signatory, so mcmsParty is used as rmnOwner
testDeployRMNRemote_MCMS : Script ()
testDeployRMNRemote_MCMS = script do
  mcmsParty <- allocateParty "mcms_party"

  let factoryInstanceId = "factory-rmn"

  factoryCid <- submit mcmsParty do
    createCmd CCIP.FactoryV1.CCIPFactory with
      instanceId = factoryInstanceId
      owner = mcmsParty
      mcmsParty
      usedInstanceIds = Map.empty
      deployedContracts = Map.empty
      perPartyRouterFactoryDeployed = False

  let instAddr = Chainlink.InstanceAddress.makeText factoryInstanceId mcmsParty
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver factoryCid
  -- Use mcmsParty as rmnOwner so authorization works within single party
  let params = CCIP.FactoryV1.DeployRMNRemoteParams with
        instanceId = "rmn-1"
        rmnOwner = mcmsParty
        ccipOwner = mcmsParty
        customObservers = []
        cursedSubjects = ["deadbeef"]
      encoded = encodeDeployRMNRemoteParams params

  submit mcmsParty do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "DeployRMNRemote"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId factoryCid)]

  pure ()

-- | Test DeployCommitteeVerifier via MCMS entrypoint
