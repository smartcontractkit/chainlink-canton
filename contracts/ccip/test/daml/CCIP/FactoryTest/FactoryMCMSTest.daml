  submit mcmsParty do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "DeployCommitteeVerifier"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId factoryCid)]

  pure ()

-- | Test DeployLockReleaseTokenPool via MCMS entrypoint
-- LockReleaseTokenPool has poolOwner as signatory, so mcmsParty is used as poolOwner
testDeployLockReleaseTokenPool_MCMS : Script ()
testDeployLockReleaseTokenPool_MCMS = script do
  mcmsParty <- allocateParty "mcms_party"
  rateLimitAdmin <- allocateParty "rate_limit_admin"

  let factoryInstanceId = "factory-lrtp"

  factoryCid <- submit mcmsParty do
    createCmd CCIPFactory with
      instanceId = factoryInstanceId
      owner = mcmsParty
      mcmsParty
      usedInstanceIds = Map.empty
      deployedContracts = Map.empty
      perPartyRouterFactoryDeployed = False

  let instAddr = RawInstanceAddress.makeText factoryInstanceId mcmsParty
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver factoryCid
  -- Use mcmsParty as poolOwner so authorization works within single party
  let params = DeployLockReleaseTokenPoolParams with
        instanceId = "lrtp-1"
        poolOwner = mcmsParty
        ccipOwner = mcmsParty
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId mcmsParty "USDC"
        decimals = 6
        rateLimitAdmin = Some rateLimitAdmin
        tokenAdminRegistry = RawInstanceAddress.make "tar-1" mcmsParty
        feeQuoter = RawInstanceAddress.make "fq-1" mcmsParty
        rmnRemote = RawInstanceAddress.make "rmn-1" mcmsParty
        poolReceiveContext = emptyCCIPContext
        transferTimeout = RelativeHours 24
      encoded = encodeDeployLockReleaseTokenPoolParams params

  submit mcmsParty do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "DeployLockReleaseTokenPool"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId factoryCid)]

  pure ()

