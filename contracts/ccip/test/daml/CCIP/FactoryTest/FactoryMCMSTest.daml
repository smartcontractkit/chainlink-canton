-- | Test DeployLinkToken via MCMS entrypoint
-- LinkRegistry has registryAdmin as signatory, so the factory owner is used as registryAdmin.
testDeployLinkToken_MCMS : Script ()
testDeployLinkToken_MCMS = script do
  mcmsParty <- allocateParty "mcms_party"

  let factoryInstanceId = "factory-link"
      linkInstanceId = "link-token-1"
      instrumentId = Splice.Api.Token.HoldingV1.InstrumentId mcmsParty "LINK"

  factoryCid <- submit mcmsParty do
    createCmd CCIP.FactoryV1.CCIPFactory with
      instanceId = factoryInstanceId
      owner = mcmsParty
      mcmsParty
      usedInstanceIds = Map.empty
      deployedContracts = Map.empty
      perPartyRouterFactoryDeployed = False

  let instAddr = Chainlink.InstanceAddress.makeText factoryInstanceId mcmsParty
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver factoryCid
  let params = CCIP.FactoryV1.DeployLinkTokenParams with
        instanceId = linkInstanceId
        instrumentId
      encoded = encodeDeployLinkTokenParams params

  submit mcmsParty do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "DeployLinkToken"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId factoryCid)]

  registries <- query @Link.Token.LinkRegistry mcmsParty
  case filter (\(_, registry) -> registry.instanceId == linkInstanceId) registries of
    [(_, registry)] -> do
      registry.registryAdmin === mcmsParty
      registry.registryInstrumentId === instrumentId
    _ -> abort "Expected exactly one deployed LinkRegistry"

  pure ()

