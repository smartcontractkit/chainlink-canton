      perPartyRouterFactoryDeployed = False

  let instAddr = Chainlink.InstanceAddress.makeText factoryInstanceId mcmsParty
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver factoryCid
  -- Use mcmsParty for all signatory roles to avoid authorization issues
  let params = CCIP.FactoryV1.DeployCommitteeVerifierParams with
        instanceId = "ccv-1"
        owner = mcmsParty
        ccipOwner = mcmsParty
        versionTag = CCIP.CommitteeVerifierV1.versionTagV2_0_0
