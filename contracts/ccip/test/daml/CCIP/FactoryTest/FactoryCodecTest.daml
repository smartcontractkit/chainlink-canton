testDecodeDeployExecutorParams : Script ()
testDecodeDeployExecutorParams = script do
  owner <- allocateParty "ExecutorOwner"

  let params = CCIP.FactoryV1.DeployExecutorParams with
        instanceId = "executor-1"
        owner
        maxCCVsPerMsg = 10
        allowedFinalityConfig = finalityConfig 0
        ccvAllowlistEnabled = False
      encoded = encodeDeployExecutorParams params

  case CCIP.FactoryV1.decodeDeployExecutorParams encoded of
    None -> abort "Failed to decode DeployExecutorParams"
    Some decoded -> do
      decoded.instanceId === params.instanceId
      decoded.owner === params.owner
      decoded.maxCCVsPerMsg === params.maxCCVsPerMsg
      decoded.allowedFinalityConfig === params.allowedFinalityConfig
      decoded.ccvAllowlistEnabled === params.ccvAllowlistEnabled

  pure ()

testDecodeDeployExecutorParamsRejectsNonPositiveBlockDepth : Script ()
testDecodeDeployExecutorParamsRejectsNonPositiveBlockDepth = script do
  owner <- allocateParty "ExecutorOwner"

  let encodeWith finality =
        encodeDeployExecutorParams (CCIP.FactoryV1.DeployExecutorParams with
          instanceId = "executor-1"
          owner
          maxCCVsPerMsg = 10
          allowedFinalityConfig = finality
          ccvAllowlistEnabled = False)
      assertDecodeFails finality =
        case CCIP.FactoryV1.decodeDeployExecutorParams (encodeWith finality) of
          None -> pure ()
          Some _ -> abort "expected DeployExecutorParams decode to reject non-positive BlockDepth"

  assertDecodeFails (CCIP.CodecV1.FinalityConfig.BlockDepth 0)
  assertDecodeFails (CCIP.CodecV1.FinalityConfig.BlockDepth (-1))

testDecodeDeployLockReleaseTokenPoolParams : Script ()
testDecodeDeployLockReleaseTokenPoolParams = script do
  poolOwner <- allocateParty "pool_owner"
  ccipOwner <- allocateParty "ccip_owner"
  tokenAdmin <- allocateParty "token_admin"
  rateLimitAdmin <- allocateParty "rate_limit_admin"
  feeOwner <- allocateParty "fee_owner"
  rmnOwner <- allocateParty "rmn_owner"

  let params = CCIP.FactoryV1.DeployLockReleaseTokenPoolParams with
        instanceId = "lrtp-1"
        poolOwner
        ccipOwner
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "USDC"
        decimals = 6
        rateLimitAdmin = Some rateLimitAdmin
        tokenAdminRegistry = Chainlink.InstanceAddress.make "tar-1" tokenAdmin
        feeQuoter = Chainlink.InstanceAddress.make "fq-1" feeOwner
        rmnRemote = Chainlink.InstanceAddress.make "rmn-1" rmnOwner
        poolReceiveContext = Splice.Api.Token.MetadataV1.emptyChoiceContext
        transferTimeout = CCIP.LockReleaseTokenPoolV1.RelativeHours 24
      encoded = encodeDeployLockReleaseTokenPoolParams params

  case CCIP.FactoryV1.decodeDeployLockReleaseTokenPoolParams encoded of
    None -> abort "Failed to decode DeployLockReleaseTokenPoolParams"
    Some decoded -> do
      decoded.instanceId === params.instanceId
      decoded.poolOwner === params.poolOwner
      decoded.ccipOwner === params.ccipOwner
      decoded.instrumentId === params.instrumentId
      decoded.decimals === params.decimals
      decoded.rateLimitAdmin === params.rateLimitAdmin
      decoded.tokenAdminRegistry === params.tokenAdminRegistry
      decoded.feeQuoter === params.feeQuoter
      decoded.rmnRemote === params.rmnRemote
      decoded.poolReceiveContext === params.poolReceiveContext
      decoded.transferTimeout === params.transferTimeout

  pure ()

