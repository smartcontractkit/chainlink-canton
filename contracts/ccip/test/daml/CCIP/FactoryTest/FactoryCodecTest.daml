testDecodeDeployCommitteeVerifierParams : Script ()
testDecodeDeployCommitteeVerifierParams = script do
  owner <- allocateParty "owner"
  ccipOwner <- allocateParty "ccip_owner"
  messageSentObserver <- allocateParty "msg_observer"
  storageAdmin <- allocateParty "storage_admin"
  pendingAdmin <- allocateParty "pending_admin"
  allowListAdmin <- allocateParty "allow_list_admin"

  let params = DeployCommitteeVerifierParams with
        instanceId = "ccv-1"
        owner
        ccipOwner
        versionTag = CCIP.CommitteeVerifier.versionTagV2_0_0
        allowListAdmin = Some allowListAdmin
        --allowListAdmin = None
        messageSentObservers = [messageSentObserver]
        rmnRemote = RawInstanceAddress "rmn@owner"
        storageLocations = ["loc1", "loc2", "loc3"]
        storageLocationsAdmin = storageAdmin
        pendingStorageLocationsAdmin = pendingAdmin
      encoded = encodeDeployCommitteeVerifierParams params

  case decodeDeployCommitteeVerifierParams encoded of
    None -> abort "Failed to decode DeployCommitteeVerifierParams"
    Some decoded -> do
      decoded.instanceId === params.instanceId
      decoded.owner === params.owner
      decoded.ccipOwner === params.ccipOwner
      decoded.versionTag === params.versionTag
      decoded.allowListAdmin === params.allowListAdmin
      decoded.messageSentObservers === params.messageSentObservers
      decoded.rmnRemote === params.rmnRemote
      decoded.storageLocations === params.storageLocations
      decoded.storageLocationsAdmin === params.storageLocationsAdmin
      decoded.pendingStorageLocationsAdmin === params.pendingStorageLocationsAdmin

  pure ()

