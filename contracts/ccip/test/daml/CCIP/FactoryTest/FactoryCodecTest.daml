testDecodeDeployLockReleaseTokenPoolParams : Script ()
testDecodeDeployLockReleaseTokenPoolParams = script do
  poolOwner <- allocateParty "pool_owner"
  ccipOwner <- allocateParty "ccip_owner"
  tokenAdmin <- allocateParty "token_admin"
  rateLimitAdmin <- allocateParty "rate_limit_admin"
  feeOwner <- allocateParty "fee_owner"
  rmnOwner <- allocateParty "rmn_owner"

  let params = DeployLockReleaseTokenPoolParams with
        instanceId = "lrtp-1"
        poolOwner
        ccipOwner
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "USDC"
        decimals = 6
        rateLimitAdmin = Some rateLimitAdmin
        tokenAdminRegistry = RawInstanceAddress.make "tar-1" tokenAdmin
        feeQuoter = RawInstanceAddress.make "fq-1" feeOwner
        rmnRemote = RawInstanceAddress.make "rmn-1" rmnOwner
        poolReceiveContext = MetadataV1.emptyChoiceContext
        transferTimeout = RelativeHours 24
      encoded = encodeDeployLockReleaseTokenPoolParams params

  case decodeDeployLockReleaseTokenPoolParams encoded of
    None -> abort "Failed to decode DeployLockReleaseTokenPoolParams"
    Some decoded -> do
      decoded.instanceId === params.instanceId
      decoded.poolOwner === params.poolOwner
      decoded.ccipOwner === params.ccipOwner
      decoded.instrumentId === params.instrumentId
      decoded.decimals === params.decimals
      decoded.rateLimitAdmin === params.rateLimitAdmin
      decoded.tokenAdminRegistry === params.tokenAdminRegistry
      decoded.feeQuoter === params.feeQuoter
      decoded.rmnRemote === params.rmnRemote
      decoded.poolReceiveContext === params.poolReceiveContext
      decoded.transferTimeout === params.transferTimeout

  pure ()

testDecodeDeployLockReleaseTokenPoolParams_Indefinite : Script ()
testDecodeDeployLockReleaseTokenPoolParams_Indefinite = script do
  poolOwner <- allocateParty "pool_owner"
  ccipOwner <- allocateParty "ccip_owner"
  tokenAdmin <- allocateParty "token_admin"
  feeOwner <- allocateParty "fee_owner"
  rmnOwner <- allocateParty "rmn_owner"

  let params = DeployLockReleaseTokenPoolParams with
        instanceId = "lrtp-indefinite"
        poolOwner
        ccipOwner
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "LINK"
        decimals = 18
        rateLimitAdmin = None
        tokenAdminRegistry = RawInstanceAddress.make "tar-1" tokenAdmin
        feeQuoter = RawInstanceAddress.make "fq-1" feeOwner
        rmnRemote = RawInstanceAddress.make "rmn-1" rmnOwner
        poolReceiveContext = MetadataV1.emptyChoiceContext
        transferTimeout = Indefinite
      encoded = encodeDeployLockReleaseTokenPoolParams params

  case decodeDeployLockReleaseTokenPoolParams encoded of
    None -> abort "Failed to decode DeployLockReleaseTokenPoolParams with Indefinite"
    Some decoded -> do
      decoded.transferTimeout === Indefinite
      decoded.poolReceiveContext === MetadataV1.emptyChoiceContext
      decoded.rateLimitAdmin === None

  pure ()

