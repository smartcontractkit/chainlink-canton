      decoded.instanceId === params.instanceId
      decoded.poolInstanceId === params.poolInstanceId
      decoded.poolOwner === params.poolOwner
      decoded.remoteChainSelector === params.remoteChainSelector
      decoded.direction === params.direction
      decoded.mode === params.mode
      decoded.isEnabled === params.isEnabled
      decoded.capacity === params.capacity
      decoded.rate === params.rate

  pure ()

