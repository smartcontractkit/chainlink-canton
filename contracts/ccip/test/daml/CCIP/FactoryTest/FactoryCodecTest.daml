testDecodeDeployRMNRemoteParams : Script ()
testDecodeDeployRMNRemoteParams = script do
  rmnOwner <- allocateParty "rmn_owner"
  ccipOwner <- allocateParty "ccip_owner"
  observer1 <- allocateParty "observer1"
  observer2 <- allocateParty "observer2"

  let params = DeployRMNRemoteParams with
        instanceId = "rmn-1"
        rmnOwner
        ccipOwner
        customObservers = [observer1, observer2]
        cursedSubjects = ["deadbeef", "cafebabe"]
      encoded = encodeDeployRMNRemoteParams params

  case decodeDeployRMNRemoteParams encoded of
    None -> abort "Failed to decode DeployRMNRemoteParams"
    Some decoded -> do
      decoded.instanceId === params.instanceId
      decoded.rmnOwner === params.rmnOwner
      decoded.ccipOwner === params.ccipOwner
      decoded.customObservers === params.customObservers
      decoded.cursedSubjects === params.cursedSubjects

  pure ()

