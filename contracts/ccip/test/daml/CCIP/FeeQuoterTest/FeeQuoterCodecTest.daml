-- | Round-trip tests for FeeQuoter codec functions
module CCIP.FeeQuoterTest.FeeQuoterCodecTest where

import Daml.Script
import DA.Assert ((===))
import DA.Optional (fromSome)

import qualified Splice.Api.Token.HoldingV1

import qualified CCIP.CoreV2.FeeQuoter
import qualified CCIP.CoreV2.FeeQuoterCodecGen

usdToCents : Decimal -> Numeric 0
usdToCents d = intToNumeric (truncate (d * 100.0))

-- ===============================================
-- |          ApplyPriceUpdatersUpdate           |
-- ===============================================

testApplyPriceUpdatersUpdateRoundtrip : Script ()
testApplyPriceUpdatersUpdateRoundtrip = do
    -- Empty lists
    let args = CCIP.CoreV2.FeeQuoter.ApplyPriceUpdatersUpdateParams with
            addedPriceUpdaters = []
            removedPriceUpdaters = []
    let encoded = CCIP.CoreV2.FeeQuoterCodecGen.encodeApplyPriceUpdatersUpdateParams args
    fst (fromSome (CCIP.CoreV2.FeeQuoterCodecGen.decodeApplyPriceUpdatersUpdateParamsAt encoded 0)) === args
    -- Non-empty lists
    party1 <- allocateParty "party1"
    party2 <- allocateParty "party2"
    party3 <- allocateParty "party3"
    let args = CCIP.CoreV2.FeeQuoter.ApplyPriceUpdatersUpdateParams with
            addedPriceUpdaters = [party1, party2]
            removedPriceUpdaters = [party3]
    let encoded = CCIP.CoreV2.FeeQuoterCodecGen.encodeApplyPriceUpdatersUpdateParams args
    fst (fromSome (CCIP.CoreV2.FeeQuoterCodecGen.decodeApplyPriceUpdatersUpdateParamsAt encoded 0)) === args

-- ===============================================
-- |                UpdatePrices                 |
-- ===============================================

testApplyUpdatePricesRoundtrip : Script ()
testApplyUpdatePricesRoundtrip = do
    caller <- allocateParty "caller"
    -- Empty updates
    let args = CCIP.CoreV2.FeeQuoter.UpdatePricesParams with
            priceUpdates = CCIP.CoreV2.FeeQuoter.PriceUpdates with
                tokenPriceUpdates = []
                gasPriceUpdates = []
            caller
    let encoded = CCIP.CoreV2.FeeQuoterCodecGen.encodeUpdatePricesParams args
    fst (fromSome (CCIP.CoreV2.FeeQuoterCodecGen.decodeUpdatePricesParamsAt encoded 0)) === args

    -- Non-empty updates
    issuer1 <- allocateParty "issuer1"
    issuer2 <- allocateParty "issuer2"
    let args = CCIP.CoreV2.FeeQuoter.UpdatePricesParams with
            priceUpdates = CCIP.CoreV2.FeeQuoter.PriceUpdates with
                tokenPriceUpdates = [
                    CCIP.CoreV2.FeeQuoter.TokenPriceUpdate with
                        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId issuer1 "USDC"
                        usdPerToken = 1.0
                    , CCIP.CoreV2.FeeQuoter.TokenPriceUpdate with
                        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId issuer2 "LINK"
                        usdPerToken = 25.0
                    ]
                gasPriceUpdates = [
                    CCIP.CoreV2.FeeQuoter.GasPriceUpdate with
                        destChainSelector = 1.0
                        usdPerUnitGas = 0.00000002
                    , CCIP.CoreV2.FeeQuoter.GasPriceUpdate with
                        destChainSelector = 18446744073709551615.0 -- max uint64
                        usdPerUnitGas = 0.00000003
                    ]
            caller
    let encoded = CCIP.CoreV2.FeeQuoterCodecGen.encodeUpdatePricesParams args
    fst (fromSome (CCIP.CoreV2.FeeQuoterCodecGen.decodeUpdatePricesParamsAt encoded 0)) === args

-- ===============================================
-- |              RemoveFeeTokens               |
-- ===============================================

testRemoveFeeTokensRoundtrip : Script ()
testRemoveFeeTokensRoundtrip = do
    -- Empty list
    let args = CCIP.CoreV2.FeeQuoter.RemoveFeeTokensParams with
            feeTokensToRemove = []
    let encoded = CCIP.CoreV2.FeeQuoterCodecGen.encodeRemoveFeeTokensParams args
    fst (fromSome (CCIP.CoreV2.FeeQuoterCodecGen.decodeRemoveFeeTokensParamsAt encoded 0)) === args
    -- Non-empty list
    issuer1 <- allocateParty "issuer1"
    issuer2 <- allocateParty "issuer2"
    let args = CCIP.CoreV2.FeeQuoter.RemoveFeeTokensParams with
            feeTokensToRemove =
                [ Splice.Api.Token.HoldingV1.InstrumentId issuer1 "USDC"
                , Splice.Api.Token.HoldingV1.InstrumentId issuer2 "LINK"
                ]
    let encoded = CCIP.CoreV2.FeeQuoterCodecGen.encodeRemoveFeeTokensParams args
    fst (fromSome (CCIP.CoreV2.FeeQuoterCodecGen.decodeRemoveFeeTokensParamsAt encoded 0)) === args

-- ===============================================
-- |         ApplyFeeQuoterDestChainConfigUpdates         |
-- ===============================================

testApplyFeeQuoterDestChainConfigUpdatesRoundtrip : Script ()
testApplyFeeQuoterDestChainConfigUpdatesRoundtrip = do
    let config1 = CCIP.CoreV2.FeeQuoter.FeeQuoterDestChainConfig True 1024 500000 21000 16 300000 90.0 (usdToCents 0.50) 25000
        config2 = CCIP.CoreV2.FeeQuoter.FeeQuoterDestChainConfig False 2048 1000000 30000 32 500000 100.0 (usdToCents 1.00) 35000
        configArgs1 = CCIP.CoreV2.FeeQuoter.FeeQuoterDestChainConfigArgs 1.0 config1
        configArgs2 = CCIP.CoreV2.FeeQuoter.FeeQuoterDestChainConfigArgs 18446744073709551615.0 config2  -- max uint64
        args = CCIP.CoreV2.FeeQuoter.ApplyFeeQuoterDestChainConfigUpdatesParams with
            destChainConfigArgs = [configArgs1, configArgs2]
    let encoded = CCIP.CoreV2.FeeQuoterCodecGen.encodeApplyFeeQuoterDestChainConfigUpdatesParams args
    fst (fromSome (CCIP.CoreV2.FeeQuoterCodecGen.decodeApplyFeeQuoterDestChainConfigUpdatesParamsAt encoded 0)) === args

-- ===========================================================================
-- INVALID DATA REJECTION TESTS
-- ===========================================================================

testInvalidDataRejection : Script ()
testInvalidDataRejection = do
  -- Empty data should fail
    case CCIP.CoreV2.FeeQuoterCodecGen.decodeRemoveFeeTokensParamsAt "" 0 of
        None -> pure ()  -- Expected
        Some _ -> abort "Expected decodeRemoveFeeTokensParams to fail on empty data"

  -- Truncated data should fail
    case CCIP.CoreV2.FeeQuoterCodecGen.decodeApplyFeeQuoterDestChainConfigUpdatesParamsAt "00" 0 of
        None -> pure ()  -- Expected - count says 0 items but might be truncated
        Some (CCIP.CoreV2.FeeQuoter.ApplyFeeQuoterDestChainConfigUpdatesParams{..}, _) -> destChainConfigArgs === []  -- Also valid - 0 items

    pure ()
