-- | Round-trip tests for FeeQuoter codec functions
module CCIP.FeeQuoterTest.FeeQuoterCodecTest where

import Daml.Script
import DA.Assert ((===))
import DA.Optional (fromSome)

import qualified Splice.Api.Token.HoldingV1

import CCIP.FeeQuoterCodecGen qualified as FeeQuoterCodec
import CCIP.FeeQuoterTypes (
    PriceUpdates(..),
    TokenPriceUpdate(..),
    GasPriceUpdate(..),
    FeeTokenArgs(..),
    DestChainConfigArgs(..),
    DestChainConfig(..),
    ApplyPriceUpdatersUpdateParams(..),
    UpdatePricesParams(..),
    ApplyFeeTokenUpdatesParams(..),
    ApplyDestChainConfigUpdatesParams(..),
    )

usdToCents : Decimal -> Numeric 0
usdToCents d = intToNumeric (truncate (d * 100.0))

-- ===============================================
-- |          ApplyPriceUpdatersUpdate           |
-- ===============================================

testApplyPriceUpdatersUpdateRoundtrip : Script ()
testApplyPriceUpdatersUpdateRoundtrip = do
    -- Empty lists
    let args = ApplyPriceUpdatersUpdateParams with
            addedPriceUpdaters = []
            removedPriceUpdaters = []
    let encoded = FeeQuoterCodec.encodeApplyPriceUpdatersUpdateParams args
    fst (fromSome (FeeQuoterCodec.decodeApplyPriceUpdatersUpdateParamsAt encoded 0)) === args
    -- Non-empty lists
    party1 <- allocateParty "party1"
    party2 <- allocateParty "party2"
    party3 <- allocateParty "party3"
    let args = ApplyPriceUpdatersUpdateParams with
            addedPriceUpdaters = [party1, party2]
            removedPriceUpdaters = [party3]
    let encoded = FeeQuoterCodec.encodeApplyPriceUpdatersUpdateParams args
    fst (fromSome (FeeQuoterCodec.decodeApplyPriceUpdatersUpdateParamsAt encoded 0)) === args

-- ===============================================
-- |                UpdatePrices                 |
-- ===============================================

testApplyUpdatePricesRoundtrip : Script ()
testApplyUpdatePricesRoundtrip = do
    caller <- allocateParty "caller"
    -- Empty updates
    let args = UpdatePricesParams with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = []
                gasPriceUpdates = []
            caller
    let encoded = FeeQuoterCodec.encodeUpdatePricesParams args
    fst (fromSome (FeeQuoterCodec.decodeUpdatePricesParamsAt encoded 0)) === args

    -- Non-empty updates
    issuer1 <- allocateParty "issuer1"
    issuer2 <- allocateParty "issuer2"
    let args = UpdatePricesParams with
            priceUpdates = PriceUpdates with
                tokenPriceUpdates = [
                    TokenPriceUpdate with
                        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId issuer1 "USDC"
                        usdPerToken = usdToCents 1.0
                    , TokenPriceUpdate with
                        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId issuer2 "LINK"
                        usdPerToken = usdToCents 25.0
                    ]
                gasPriceUpdates = [
                    GasPriceUpdate with
                        destChainSelector = 1.0
                        usdPerUnitGas = usdToCents 0.00000002
                    , GasPriceUpdate with
                        destChainSelector = 18446744073709551615.0 -- max uint64
                        usdPerUnitGas = usdToCents 0.00000003
                    ]
            caller
    let encoded = FeeQuoterCodec.encodeUpdatePricesParams args
    fst (fromSome (FeeQuoterCodec.decodeUpdatePricesParamsAt encoded 0)) === args

-- ===============================================
-- |            ApplyFeeTokenUpdates             |
-- ===============================================

testApplyFeeTokenUpdatesRoundtrip : Script ()
testApplyFeeTokenUpdatesRoundtrip = do
    -- Empty lists
    let args = ApplyFeeTokenUpdatesParams with
            feeTokensToRemove = []
            feeTokensToAdd = []
    let encoded = FeeQuoterCodec.encodeApplyFeeTokenUpdatesParams args
    fst (fromSome (FeeQuoterCodec.decodeApplyFeeTokenUpdatesParamsAt encoded 0)) === args
    -- Non-empty lists
    issuer1 <- allocateParty "issuer1"
    issuer2 <- allocateParty "issuer2"
    let instrumentId1 = Splice.Api.Token.HoldingV1.InstrumentId issuer1 "USDC"
        instrumentId2 = Splice.Api.Token.HoldingV1.InstrumentId issuer2 "LINK"
        args = ApplyFeeTokenUpdatesParams with
            feeTokensToRemove = [instrumentId1, instrumentId2]
            feeTokensToAdd = [FeeTokenArgs instrumentId1, FeeTokenArgs instrumentId2]
    let encoded = FeeQuoterCodec.encodeApplyFeeTokenUpdatesParams args
    fst (fromSome (FeeQuoterCodec.decodeApplyFeeTokenUpdatesParamsAt encoded 0)) === args

-- ===============================================
-- |         ApplyDestChainConfigUpdates         |
-- ===============================================

testApplyDestChainConfigUpdatesRoundtrip : Script ()
testApplyDestChainConfigUpdatesRoundtrip = do
    let config1 = DestChainConfig True 1024 500000 21000 16 300000 90.0 (usdToCents 0.50) 25000
        config2 = DestChainConfig False 2048 1000000 30000 32 500000 100.0 (usdToCents 1.00) 35000
        configArgs1 = DestChainConfigArgs 1.0 config1
        configArgs2 = DestChainConfigArgs 18446744073709551615.0 config2  -- max uint64
        args = ApplyDestChainConfigUpdatesParams with
            destChainConfigArgs = [configArgs1, configArgs2]
    let encoded = FeeQuoterCodec.encodeApplyDestChainConfigUpdatesParams args
    fst (fromSome (FeeQuoterCodec.decodeApplyDestChainConfigUpdatesParamsAt encoded 0)) === args

-- ===========================================================================
-- INVALID DATA REJECTION TESTS
-- ===========================================================================

testInvalidDataRejection : Script ()
testInvalidDataRejection = do
  -- Empty data should fail
    case FeeQuoterCodec.decodeApplyFeeTokenUpdatesParamsAt "" 0 of
        None -> pure ()  -- Expected
        Some _ -> abort "Expected decodeApplyFeeTokenUpdatesParams to fail on empty data"

  -- Truncated data should fail
    case FeeQuoterCodec.decodeApplyDestChainConfigUpdatesParamsAt "00" 0 of
        None -> pure ()  -- Expected - count says 0 items but might be truncated
        Some (ApplyDestChainConfigUpdatesParams{..}, _) -> destChainConfigArgs === []  -- Also valid - 0 items

    pure ()
