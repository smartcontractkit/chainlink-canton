-- | Round-trip tests for FeeQuoter codec functions
module CCIP.FeeQuoterTest.FeeQuoterCodecTest where

import Daml.Script
import DA.Assert ((===))
import DA.Optional (fromSome)

import qualified Splice.Api.Token.HoldingV1

import CCIP.FeeQuoterCodec qualified as FeeQuoterCodec
import CCIP.FeeQuoterTypes qualified as FeeQuoterTypes

usdToCents : Decimal -> Numeric 0
usdToCents d = intToNumeric (truncate (d * 100.0))

mult : Decimal -> Numeric 0
mult m = intToNumeric (truncate (m * 100000000.0))

-- ===============================================
-- |          ApplyPriceUpdatersUpdate           |
-- ===============================================

testApplyPriceUpdatersUpdateRoundtrip : Script ()
testApplyPriceUpdatersUpdateRoundtrip = do
    -- Empty lists
    let args = ([], [])
    let encoded = FeeQuoterCodec.encodeApplyPriceUpdatersUpdateParams args
    fst (fromSome (FeeQuoterCodec.decodeApplyPriceUpdatersUpdateParams encoded)) === args
    -- Non-empty lists
    party1 <- allocateParty "party1"
    party2 <- allocateParty "party2"
    party3 <- allocateParty "party3"
    let args = ([party1, party2], [party3])
    let encoded = FeeQuoterCodec.encodeApplyPriceUpdatersUpdateParams args
    fst (fromSome (FeeQuoterCodec.decodeApplyPriceUpdatersUpdateParams encoded)) === args

-- ===============================================
-- |                UpdatePrices                 |
-- ===============================================

testApplyUpdatePricesRoundtrip : Script ()
testApplyUpdatePricesRoundtrip = do
    caller <- allocateParty "caller"
    -- Empty updates
    let args = (FeeQuoterTypes.PriceUpdates with
                    tokenPriceUpdates = []
                    gasPriceUpdates = []
                , caller
            )
    let encoded = FeeQuoterCodec.encodeUpdatePricesParams args
    fst (fromSome (FeeQuoterCodec.decodeUpdatePricesParams encoded)) === args

    -- Non-empty updates
    issuer1 <- allocateParty "issuer1"
    issuer2 <- allocateParty "issuer2"
    let args = (FeeQuoterTypes.PriceUpdates with
                tokenPriceUpdates = [
                    FeeQuoterTypes.TokenPriceUpdate with
                        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId issuer1 "USDC"
                        usdPerToken = usdToCents 1.0
                    , FeeQuoterTypes.TokenPriceUpdate with  
                        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId issuer2 "LINK"
                        usdPerToken = usdToCents 25.0
                    ]
                gasPriceUpdates = [
                    FeeQuoterTypes.GasPriceUpdate with
                        destChainSelector = 1.0
                        usdPerUnitGas = usdToCents 0.00000002
                    , FeeQuoterTypes.GasPriceUpdate with
                        destChainSelector = 18446744073709551615.0 -- max uint64
                        usdPerUnitGas = usdToCents 0.00000003
                    ]
            ,caller
            )
    let encoded = FeeQuoterCodec.encodeUpdatePricesParams args
    fst (fromSome (FeeQuoterCodec.decodeUpdatePricesParams encoded)) === args

-- ===============================================
-- |            ApplyFeeTokenUpdates             |
-- ===============================================

testApplyFeeTokenUpdatesRoundtrip : Script ()
testApplyFeeTokenUpdatesRoundtrip = do
    -- Empty lists
    let args = ([], [])
    let encoded = FeeQuoterCodec.encodeApplyFeeTokenUpdatesParams args
    fst (fromSome (FeeQuoterCodec.decodeApplyFeeTokenUpdatesParams encoded)) === args
    -- Non-empty lists
    issuer1 <- allocateParty "issuer1"
    issuer2 <- allocateParty "issuer2"
    let args = (
            [
                Splice.Api.Token.HoldingV1.InstrumentId issuer1 "USDC",
                Splice.Api.Token.HoldingV1.InstrumentId issuer2 "LINK"
            ],
            [
                FeeQuoterTypes.FeeTokenArgs with
                    instrumentId = Splice.Api.Token.HoldingV1.InstrumentId issuer1 "USDC"
                    premiumMultiplier = mult 1.5
                , FeeQuoterTypes.FeeTokenArgs with
                    instrumentId = Splice.Api.Token.HoldingV1.InstrumentId issuer2 "LINK"
                    premiumMultiplier = mult 2.0
            ]
            )
    let encoded = FeeQuoterCodec.encodeApplyFeeTokenUpdatesParams args
    fst (fromSome (FeeQuoterCodec.decodeApplyFeeTokenUpdatesParams encoded)) === args

-- ===============================================
-- |         ApplyDestChainConfigUpdates         |
-- ===============================================

testApplyDestChainConfigUpdatesRoundtrip : Script ()
testApplyDestChainConfigUpdatesRoundtrip = do
    let args = ([
            FeeQuoterTypes.DestChainConfigArgs with
                destChainSelector = 1.0
                destChainConfig = FeeQuoterTypes.DestChainConfig with
                    isEnabled = True
                    maxDataBytes = 1024
                    maxPerMsgGasLimit = 500000
                    destGasOverhead = 21000
                    destGasPerPayloadByteBase = 16
                    defaultTxGasLimit = 300000
                    defaultTokenFeeUSD = usdToCents 0.50
                    defaultTokenDestGasOverhead = 25000
            , FeeQuoterTypes.DestChainConfigArgs with
                destChainSelector = 18446744073709551615.0 -- max uint64
                destChainConfig = FeeQuoterTypes.DestChainConfig with
                    isEnabled = False
                    maxDataBytes = 2048
                    maxPerMsgGasLimit = 1000000
                    destGasOverhead = 30000
                    destGasPerPayloadByteBase = 32
                    defaultTxGasLimit = 500000
                    defaultTokenFeeUSD = usdToCents 1.00
                    defaultTokenDestGasOverhead = 35000
            ])
    let encoded = FeeQuoterCodec.encodeApplyDestChainConfigUpdatesParams args
    fst (fromSome (FeeQuoterCodec.decodeApplyDestChainConfigUpdatesParams encoded)) === args

-- ===========================================================================
-- INVALID DATA REJECTION TESTS
-- ===========================================================================

testInvalidDataRejection : Script ()
testInvalidDataRejection = do
  -- Empty data should fail
    case FeeQuoterCodec.decodeApplyFeeTokenUpdatesParams "" of
        None -> pure ()  -- Expected
        Some _ -> abort "Expected decodeApplyFeeTokenUpdatesParams to fail on empty data"

  -- Truncated data should fail
    case FeeQuoterCodec.decodeApplyDestChainConfigUpdatesParams "00" of
        None -> pure ()  -- Expected - count says 0 items but might be truncated
        Some ((configs), _) -> configs === []  -- Also valid - 0 items

    pure ()
