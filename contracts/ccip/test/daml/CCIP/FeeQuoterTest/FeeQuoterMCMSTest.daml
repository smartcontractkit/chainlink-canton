-- | MCMS entrypoint tests for FeeQuoter
-- Tests the MCMSReceiver interface implementation by calling mcmsEntrypoint directly
module CCIP.FeeQuoterTest.FeeQuoterMCMSTest where

import Daml.Script
import DA.Assert ((===))
import DA.Map qualified as Map

import qualified Splice.Api.Token.HoldingV1
import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiver_Entrypoint(..), makeInstanceAddress)
import MCMS.Codec (encodePartyList)
import CCIP.FeeQuoter
import CCIP.FeeQuoterCodec

usd : Decimal -> Numeric 0
usd d = intToNumeric (truncate (d * 100000000.0))

usdToCents : Decimal -> Numeric 0
usdToCents d = intToNumeric (truncate (d * 100.0))

mult : Decimal -> Numeric 0
mult m = intToNumeric (truncate (m * 100000000.0))

-- ========================================================
-- |        MCMS Entrypoint - ApplyFeeTokenUpdates        |
-- ========================================================

-- | Test MCMSReceiver entrypoint for ApplyFeeTokenUpdates function
testFeeQuoterMCMSEntrypoint_ApplyFeeTokenUpdates : Script ()
testFeeQuoterMCMSEntrypoint_ApplyFeeTokenUpdates = script do
    owner <- allocateParty "ccip_owner"
    tokenAdmin <- allocateParty "TokenAdmin"

    let instanceId = "feequoter-test"
        instrumentId1 = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "USDC"
        instrumentId2 = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "LINK"

    -- Create FeeQuoter with one existing fee token
    fqCid <- submit owner do
        createCmd FeeQuoter with
            instanceId
            owner
            feeTokens = Map.fromList [(instrumentId1, mult 1.0)]
            destChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.empty
            usdPerToken = Map.empty
            linkTokenInstrumentId = instrumentId2
            priceUpdaters = []

    let instAddr = makeInstanceAddress instanceId owner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver fqCid

    -- Encode ApplyFeeTokenUpdates params: remove USDC, add LINK
    let feeTokensToRemove = [instrumentId1]
        feeTokensToAdd = [FeeTokenArgs instrumentId2 (mult 1.5)]
        encoded = encodeApplyFeeTokenUpdatesParams (feeTokensToRemove, feeTokensToAdd)

    -- Call mcmsEntrypoint
    newContractIds <- submit owner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "ApplyFeeTokenUpdates"
            operationData = encoded
            contractIds = Map.fromList [(instAddr, toAnyContractId fqCid)]

    -- Verify state changed
    contracts <- query @FeeQuoter owner
    case filter (\(_, fq) -> fq.instanceId == instanceId) contracts of
        [(_, fq)] -> do
            -- USDC should be removed
            Map.lookup instrumentId1 fq.feeTokens === None
            -- LINK should be added
            Map.lookup instrumentId2 fq.feeTokens === Some (mult 1.5)
        _ -> abort "Expected exactly one FeeQuoter contract"

    pure ()

-- | Test adding multiple fee tokens
testFeeQuoterMCMSEntrypoint_ApplyFeeTokenUpdates_Multiple : Script ()
testFeeQuoterMCMSEntrypoint_ApplyFeeTokenUpdates_Multiple = script do
    owner <- allocateParty "ccip_owner"
    tokenAdmin <- allocateParty "TokenAdmin"

    let instanceId = "feequoter-multi-test"
        instrumentId1 = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "USDC"
        instrumentId2 = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "LINK"
        instrumentId3 = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "WETH"

    -- Create FeeQuoter with no fee tokens
    fqCid <- submit owner do
        createCmd FeeQuoter with
            instanceId
            owner
            feeTokens = Map.empty
            destChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.empty
            usdPerToken = Map.empty
            linkTokenInstrumentId = instrumentId2
            priceUpdaters = []

    let instAddr = makeInstanceAddress instanceId owner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver fqCid

    -- Add multiple fee tokens
    let feeTokensToRemove : [Splice.Api.Token.HoldingV1.InstrumentId] = []
        feeTokensToAdd = [
            FeeTokenArgs instrumentId1 (mult 1.0),
            FeeTokenArgs instrumentId2 (mult 1.25),
            FeeTokenArgs instrumentId3 (mult 0.9)
            ]
        encoded = encodeApplyFeeTokenUpdatesParams (feeTokensToRemove, feeTokensToAdd)

    -- Call mcmsEntrypoint
    newContractIds <- submit owner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "ApplyFeeTokenUpdates"
            operationData = encoded
            contractIds = Map.fromList [(instAddr, toAnyContractId fqCid)]

    -- Verify all tokens added
    contracts <- query @FeeQuoter owner
    case filter (\(_, fq) -> fq.instanceId == instanceId) contracts of
        [(_, fq)] -> do
            Map.size fq.feeTokens === 3
            Map.lookup instrumentId1 fq.feeTokens === Some (mult 1.0)
            Map.lookup instrumentId2 fq.feeTokens === Some (mult 1.25)
            Map.lookup instrumentId3 fq.feeTokens === Some (mult 0.9)
        _ -> abort "Expected exactly one FeeQuoter contract"

    pure ()

-- ========================================================
-- |    MCMS Entrypoint - ApplyDestChainConfigUpdates     |
-- ========================================================

-- | Test MCMSReceiver entrypoint for ApplyDestChainConfigUpdates function
testFeeQuoterMCMSEntrypoint_ApplyDestChainConfigUpdates : Script ()
testFeeQuoterMCMSEntrypoint_ApplyDestChainConfigUpdates = script do
    owner <- allocateParty "ccip_owner"

    let instanceId = "feequoter-dest-test"

    -- Create FeeQuoter with no dest chain configs
    fqCid <- submit owner do
        createCmd FeeQuoter with
            instanceId
            owner
            feeTokens = Map.empty
            destChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.empty
            usdPerToken = Map.empty
            linkTokenInstrumentId = Splice.Api.Token.HoldingV1.InstrumentId owner "LINK"
            priceUpdaters = []

    let instAddr = makeInstanceAddress instanceId owner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver fqCid

    -- Create dest chain config
    let destConfig = DestChainConfig with
            isEnabled = True
            maxDataBytes = 65535
            maxPerMsgGasLimit = 3000000
            destGasOverhead = 100000
            destGasPerPayloadByteBase = 16
            defaultTxGasLimit = 200000
            defaultTokenFeeUSD = usdToCents 0.5
            defaultTokenDestGasOverhead = 50000

        configArgs = [DestChainConfigArgs 1.0 destConfig]
        encoded = encodeApplyDestChainConfigUpdatesParams configArgs

    -- Call mcmsEntrypoint
    newContractIds <- submit owner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "ApplyDestChainConfigUpdates"
            operationData = encoded
            contractIds = Map.fromList [(instAddr, toAnyContractId fqCid)]

    -- Verify dest chain config was added
    contracts <- query @FeeQuoter owner
    case filter (\(_, fq) -> fq.instanceId == instanceId) contracts of
        [(_, fq)] -> do
            Map.size fq.destChainConfigs === 1
            case Map.lookup 1.0 fq.destChainConfigs of
                None -> abort "Expected dest chain config for chain 1"
                Some config -> do
                    config.isEnabled === True
                    config.maxDataBytes === 65535
                    config.maxPerMsgGasLimit === 3000000
        _ -> abort "Expected exactly one FeeQuoter contract"

    pure ()

-- | Test adding multiple dest chain configs
testFeeQuoterMCMSEntrypoint_ApplyDestChainConfigUpdates_Multiple : Script ()
testFeeQuoterMCMSEntrypoint_ApplyDestChainConfigUpdates_Multiple = script do
    owner <- allocateParty "ccip_owner"

    let instanceId = "feequoter-multi-dest-test"

    -- Create FeeQuoter
    fqCid <- submit owner do
        createCmd FeeQuoter with
            instanceId
            owner
            feeTokens = Map.empty
            destChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.empty
            usdPerToken = Map.empty
            linkTokenInstrumentId = Splice.Api.Token.HoldingV1.InstrumentId owner "LINK"
            priceUpdaters = []

    let instAddr = makeInstanceAddress instanceId owner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver fqCid

    -- Create multiple dest chain configs
    let config1 = DestChainConfig True 65535 3000000 100000 16 200000 (usdToCents 0.5) 50000
        config2 = DestChainConfig True 32768 1500000 50000 8 100000 (usdToCents 1.0) 25000

        configArgs = [
            DestChainConfigArgs 1.0 config1,
            DestChainConfigArgs 137.0 config2
            ]
        encoded = encodeApplyDestChainConfigUpdatesParams configArgs

    -- Call mcmsEntrypoint
    newContractIds <- submit owner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "ApplyDestChainConfigUpdates"
            operationData = encoded
            contractIds = Map.fromList [(instAddr, toAnyContractId fqCid)]

    -- Verify both configs were added
    contracts <- query @FeeQuoter owner
    case filter (\(_, fq) -> fq.instanceId == instanceId) contracts of
        [(_, fq)] -> do
            Map.size fq.destChainConfigs === 2
            case Map.lookup 1.0 fq.destChainConfigs of
                None -> abort "Expected config for chain 1"
                Some c -> c.maxDataBytes === 65535
            case Map.lookup 137.0 fq.destChainConfigs of
                None -> abort "Expected config for chain 137"
                Some c -> c.maxDataBytes === 32768
        _ -> abort "Expected exactly one FeeQuoter contract"

    pure ()

-- ===========================================================================
-- MCMS ENTRYPOINT TESTS - ADD/REMOVE PRICE UPDATERS
-- ===========================================================================

-- | Test MCMSReceiver entrypoint for AddPriceUpdaters function
testFeeQuoterMCMSEntrypoint_AddPriceUpdaters : Script ()
testFeeQuoterMCMSEntrypoint_AddPriceUpdaters = script do
  owner <- allocateParty "ccip_owner"
  updater1 <- allocateParty "updater1"
  updater2 <- allocateParty "updater2"

  let instanceId = "feequoter-add-updaters-test"

  -- Create FeeQuoter with no price updaters
  fqCid <- submit owner do
    createCmd FeeQuoter with
      instanceId
      owner
      feeTokens = Map.empty
      destChainConfigs = Map.empty
      tokenTransferFeeConfigs = Map.empty
      usdPerUnitGasByDestChainSelector = Map.empty
      usdPerToken = Map.empty
      linkTokenInstrumentId = Splice.Api.Token.HoldingV1.InstrumentId owner "LINK"
      priceUpdaters = []

  let instAddr = makeInstanceAddress instanceId owner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver fqCid

  -- Encode AddPriceUpdaters params
  let encoded = encodePartyList [updater1, updater2]

  -- Call mcmsEntrypoint
  newContractIds <- submit owner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "AddPriceUpdaters"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId fqCid)]

  -- Verify updaters were added
  contracts <- query @FeeQuoter owner
  case filter (\(_, fq) -> fq.instanceId == instanceId) contracts of
    [(_, fq)] -> do
      length fq.priceUpdaters === 2
      assertMsg "updater1 should be in priceUpdaters" (updater1 `elem` fq.priceUpdaters)
      assertMsg "updater2 should be in priceUpdaters" (updater2 `elem` fq.priceUpdaters)
    _ -> abort "Expected exactly one FeeQuoter contract"

  pure ()

-- | Test MCMSReceiver entrypoint for RemovePriceUpdaters function
testFeeQuoterMCMSEntrypoint_RemovePriceUpdaters : Script ()
testFeeQuoterMCMSEntrypoint_RemovePriceUpdaters = script do
  owner <- allocateParty "ccip_owner"
  updater1 <- allocateParty "updater1"
  updater2 <- allocateParty "updater2"

  let instanceId = "feequoter-remove-updaters-test"

  -- Create FeeQuoter with two price updaters
  fqCid <- submit owner do
    createCmd FeeQuoter with
      instanceId
      owner
      feeTokens = Map.empty
      destChainConfigs = Map.empty
      tokenTransferFeeConfigs = Map.empty
      usdPerUnitGasByDestChainSelector = Map.empty
      usdPerToken = Map.empty
      linkTokenInstrumentId = Splice.Api.Token.HoldingV1.InstrumentId owner "LINK"

      priceUpdaters = [updater1, updater2]

  let instAddr = makeInstanceAddress instanceId owner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver fqCid

  -- Encode RemovePriceUpdaters params: remove updater1
  let encoded = encodePartyList [updater1]

  -- Call mcmsEntrypoint
  newContractIds <- submit owner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "RemovePriceUpdaters"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId fqCid)]

  -- Verify updater1 was removed
  contracts <- query @FeeQuoter owner
  case filter (\(_, fq) -> fq.instanceId == instanceId) contracts of
    [(_, fq)] -> do
      length fq.priceUpdaters === 1
      assertMsg "updater1 should not be in priceUpdaters" (updater1 `notElem` fq.priceUpdaters)
      assertMsg "updater2 should still be in priceUpdaters" (updater2 `elem` fq.priceUpdaters)
    _ -> abort "Expected exactly one FeeQuoter contract"

  pure ()

-- | Test that owner is filtered out when added as price updater via MCMS
testFeeQuoterMCMSEntrypoint_AddPriceUpdaters_FiltersOwner : Script ()
testFeeQuoterMCMSEntrypoint_AddPriceUpdaters_FiltersOwner = script do
  owner <- allocateParty "ccip_owner"
  updater1 <- allocateParty "updater1"

  let instanceId = "feequoter-filter-owner-test"

  fqCid <- submit owner do
    createCmd FeeQuoter with
      instanceId
      owner
      feeTokens = Map.empty
      destChainConfigs = Map.empty
      tokenTransferFeeConfigs = Map.empty
      usdPerUnitGasByDestChainSelector = Map.empty
      usdPerToken = Map.empty
      linkTokenInstrumentId = Splice.Api.Token.HoldingV1.InstrumentId owner "LINK"

      priceUpdaters = []

  let instAddr = makeInstanceAddress instanceId owner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver fqCid

  -- Try to add owner and updater1 - owner should be filtered out
  let encoded = encodePartyList [owner, updater1]

  newContractIds <- submit owner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "AddPriceUpdaters"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId fqCid)]

  contracts <- query @FeeQuoter owner
  case filter (\(_, fq) -> fq.instanceId == instanceId) contracts of
    [(_, fq)] -> do
      length fq.priceUpdaters === 1
      assertMsg "owner should not be in priceUpdaters" (owner `notElem` fq.priceUpdaters)
      assertMsg "updater1 should be in priceUpdaters" (updater1 `elem` fq.priceUpdaters)
    _ -> abort "Expected exactly one FeeQuoter contract"

  pure ()

-- ===========================================================================
-- ERROR CASE TESTS
-- ===========================================================================

-- | Test that unknown function name returns E_UNKNOWN_FUNCTION
testFeeQuoterMCMSEntrypoint_UnknownFunction : Script ()
testFeeQuoterMCMSEntrypoint_UnknownFunction = script do
    owner <- allocateParty "ccip_owner"

    let instanceId = "feequoter-error-test"

    fqCid <- submit owner do
        createCmd FeeQuoter with
            instanceId
            owner
            feeTokens = Map.empty
            destChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.empty
            usdPerToken = Map.empty
            linkTokenInstrumentId = Splice.Api.Token.HoldingV1.InstrumentId owner "LINK"
            priceUpdaters = []

    let instAddr = makeInstanceAddress instanceId owner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver fqCid

    -- Call with unknown function name - should fail
    submitMustFail owner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "NonExistentFunction"
            operationData = ""
            contractIds = Map.fromList [(instAddr, toAnyContractId fqCid)]

    pure ()

-- | Test that invalid params returns E_INVALID_PARAMS
testFeeQuoterMCMSEntrypoint_InvalidParams : Script ()
testFeeQuoterMCMSEntrypoint_InvalidParams = script do
    owner <- allocateParty "ccip_owner"

    let instanceId = "feequoter-invalid-test"

    fqCid <- submit owner do
        createCmd FeeQuoter with
            instanceId
            owner
            feeTokens = Map.empty
            destChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.empty
            usdPerToken = Map.empty
            linkTokenInstrumentId = Splice.Api.Token.HoldingV1.InstrumentId owner "LINK"
            priceUpdaters = []

    let instAddr = makeInstanceAddress instanceId owner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver fqCid

    -- Call with invalid operationData - should fail
    submitMustFail owner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "ApplyFeeTokenUpdates"
            operationData = "invalid"  -- Not valid encoded data
            contractIds = Map.fromList [(instAddr, toAnyContractId fqCid)]

    pure ()

-- | Test that missing self CID returns E_SELF_CID_NOT_IN_MAP
testFeeQuoterMCMSEntrypoint_MissingSelfCid : Script ()
testFeeQuoterMCMSEntrypoint_MissingSelfCid = script do
    owner <- allocateParty "ccip_owner"

    let instanceId = "feequoter-missing-cid-test"

    fqCid <- submit owner do
        createCmd FeeQuoter with
            instanceId
            owner
            feeTokens = Map.empty
            destChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.empty
            usdPerToken = Map.empty
            linkTokenInstrumentId = Splice.Api.Token.HoldingV1.InstrumentId owner "LINK"
            priceUpdaters = []

    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver fqCid

    -- Encode valid params
    let encoded = encodeApplyDestChainConfigUpdatesParams []

    -- Call with empty contractIds map - should fail
    submitMustFail owner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "ApplyDestChainConfigUpdates"
            operationData = encoded
            contractIds = Map.empty  -- Missing self CID

    pure ()

-- Helper to convert ContractId to AnyContractId for the map
toAnyContractId : ContractId a -> ContractId ()
toAnyContractId = coerceContractId
