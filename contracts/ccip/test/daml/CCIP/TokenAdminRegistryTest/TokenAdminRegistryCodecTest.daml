-- | Round-trip tests for TokenAdminRegistry codec functions
module CCIP.TokenAdminRegistryTest.TokenAdminRegistryCodecTest where

import Daml.Script
import DA.Assert ((===))

import qualified Splice.Api.Token.HoldingV1
import CCIP.TokenAdminRegistryCodecGen (
    encodePoolRegistration,
    decodePoolRegistrationAt,
    encodeSetPoolParams,
    decodeSetPoolParamsAt,
    encodeSetTransferFactoryParams,
    decodeSetTransferFactoryParamsAt,
    encodeSetBurnMintFactoryParams,
    decodeSetBurnMintFactoryParamsAt,
    encodeProposeAdminParams,
    decodeProposeAdminParamsAt,
    encodeTransferAdminParams,
    decodeTransferAdminParamsAt,
    encodeAcceptAdminParams,
    decodeAcceptAdminParamsAt,
    )
import CCIP.TokenAdminRegistryTypes (
    PoolRegistration(..),
    SetPoolParams(..),
    SetTransferFactoryParams(..),
    SetBurnMintFactoryParams(..),
    ProposeAdminParams(..),
    TransferAdminParams(..),
    AcceptAdminParams(..),
    )
import MCMS.Codec (encodeText, decodeTextAt)
import Chainlink.InstanceAddress qualified as RawInstanceAddress

-- ===========================================================================
-- TEXT ENCODING/DECODING TESTS
-- ===========================================================================

testTextRoundtrip : Script ()
testTextRoundtrip = do
  -- Empty string
  let emptyText = ""
      encodedEmpty = encodeText emptyText
  case decodeTextAt encodedEmpty 0 of
    None -> abort "Failed to decode empty text"
    Some (decoded, _) -> decoded === emptyText

  -- Normal text
  let normalText = "hello-world"
      encodedNormal = encodeText normalText
  case decodeTextAt encodedNormal 0 of
    None -> abort "Failed to decode normal text"
    Some (decoded, _) -> decoded === normalText

  -- Text with special chars
  let specialText = "pool-instance-123"
      encodedSpecial = encodeText specialText
  case decodeTextAt encodedSpecial 0 of
    None -> abort "Failed to decode special text"
    Some (decoded, _) -> decoded === specialText

  pure ()

-- ===========================================================================
-- POOL REGISTRATION ENCODING/DECODING TESTS
-- ===========================================================================

testPoolRegistrationRoundtrip : Script ()
testPoolRegistrationRoundtrip = do
  alice <- allocateParty "Alice"

  let poolReg = PoolRegistration with
        poolOwner = alice
        poolInstanceId = "pool-instance-v1"

      encoded = encodePoolRegistration poolReg

  case decodePoolRegistrationAt encoded 0 of
    None -> abort "Failed to decode PoolRegistration"
    Some (decoded, _) -> do
      decoded.poolOwner === poolReg.poolOwner
      decoded.poolInstanceId === poolReg.poolInstanceId

  pure ()

testPoolRegistrationEmptyInstanceId : Script ()
testPoolRegistrationEmptyInstanceId = do
  alice <- allocateParty "Alice"

  let poolReg = PoolRegistration with
        poolOwner = alice
        poolInstanceId = ""

      encoded = encodePoolRegistration poolReg

  case decodePoolRegistrationAt encoded 0 of
    None -> abort "Failed to decode PoolRegistration with empty instanceId"
    Some (decoded, _) -> do
      decoded.poolOwner === poolReg.poolOwner
      decoded.poolInstanceId === ""

  pure ()

-- ===========================================================================
-- SET_POOL PARAMS TESTS
-- ===========================================================================

testSetPoolParamsWithPool : Script ()
testSetPoolParamsWithPool = do
  alice <- allocateParty "Alice"
  tokenAdmin <- allocateParty "TokenAdmin"

  let instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "USDC"
      poolReg = PoolRegistration with
        poolOwner = alice
        poolInstanceId = "lock-release-pool-v1"
      params = SetPoolParams with instrumentId, tokenPool = Some poolReg
      encoded = encodeSetPoolParams params

  case decodeSetPoolParamsAt encoded 0 of
    None -> abort "Failed to decode set_pool params with pool"
    Some (decoded, _) -> do
      decoded.instrumentId === instrumentId
      case decoded.tokenPool of
        None -> abort "Expected Some pool, got None"
        Some p -> do
          p.poolOwner === poolReg.poolOwner
          p.poolInstanceId === poolReg.poolInstanceId

  pure ()

testSetPoolParamsNoPool : Script ()
testSetPoolParamsNoPool = do
  tokenAdmin <- allocateParty "TokenAdmin"

  let instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "USDC"
      params = SetPoolParams with instrumentId, tokenPool = None
      encoded = encodeSetPoolParams params

  case decodeSetPoolParamsAt encoded 0 of
    None -> abort "Failed to decode set_pool params without pool"
    Some (decoded, _) -> do
      decoded.instrumentId === instrumentId
      decoded.tokenPool === None

  pure ()

