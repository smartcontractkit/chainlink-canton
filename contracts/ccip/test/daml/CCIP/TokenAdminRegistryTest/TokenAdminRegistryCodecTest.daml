testAcceptAdminParamsRoundtrip : Script ()
testAcceptAdminParamsRoundtrip = do
  tokenAdmin <- allocateParty "TokenAdmin"

  let instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "TOKEN"
