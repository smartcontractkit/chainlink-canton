  let instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "TOKEN"
      encoded = encodeProposeAdminParams instrumentId newAdmin

  case decodeProposeAdminParams encoded of
    None -> abort "Failed to decode propose_admin params"
    Some (decodedInstrumentId, decodedAdmin) -> do
      decodedInstrumentId === instrumentId
      decodedAdmin === newAdmin

  pure ()

