testSetTransferFactoryParamsWithAddress : Script ()
testSetTransferFactoryParamsWithAddress = do
  tokenAdmin <- allocateParty "TokenAdmin"

  let instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "LINK"
      factoryAddress = RawInstanceAddress.make "link-transfer-factory" tokenAdmin
      params = SetTransferFactoryParams with
        instrumentId
        transferFactoryAddress = Some factoryAddress
      encoded = encodeSetTransferFactoryParams params

  case decodeSetTransferFactoryParamsAt encoded 0 of
    None -> abort "Failed to decode set_transfer_factory params with address"
    Some (decoded, _) -> do
      decoded.instrumentId === instrumentId
      decoded.transferFactoryAddress === Some factoryAddress

  pure ()

