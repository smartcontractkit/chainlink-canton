-- ===========================================================================
-- INVALID DATA REJECTION TESTS
-- ===========================================================================

testInvalidDataRejection : Script ()
testInvalidDataRejection = do
  -- Empty data should fail
  case decodeSetPoolParams "" of
    None -> pure ()  -- Expected
    Some _ -> abort "Expected decodeSetPoolParams to fail on empty data"

  -- Truncated data should fail
  case decodeSetPoolParams "00" of
    None -> pure ()  -- Expected
    Some _ -> abort "Expected decodeSetPoolParams to fail on truncated data"

  -- Invalid bool value should fail (neither 00 nor 01)
  -- First need valid instrumentId, then invalid bool
  tokenAdmin <- allocateParty "TokenAdmin"
  let instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "T"
      validInstrumentIdEncoded = encodeAcceptAdminParams instrumentId
      -- Append invalid bool (02 instead of 00 or 01)
      invalidData = validInstrumentIdEncoded <> "02"

  case decodeSetPoolParams invalidData of
    None -> pure ()  -- Expected - should fail on invalid bool
    Some _ -> abort "Expected decodeSetPoolParams to fail on invalid bool"

  pure ()
