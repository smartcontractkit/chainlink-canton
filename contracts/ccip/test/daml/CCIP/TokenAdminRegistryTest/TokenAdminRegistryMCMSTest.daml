-- | Test MCMSReceiver entrypoint for AcceptAdminRole function
testTokenAdminRegistryMCMSEntrypoint_AcceptAdminRole : Script ()
testTokenAdminRegistryMCMSEntrypoint_AcceptAdminRole = script do
  owner <- allocateParty "ccip_owner"
  tokenAdmin <- allocateParty "TokenAdmin"

  let instanceId = "tar-accept-test"
      instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "DAI"
      encodedInstrumentId = CCIP.MessageCodecV1.encodeInstrumentId instrumentId

  -- Create TokenAdminRegistry with pending admin set to owner
  tarCid <- submit owner do
    createCmd TokenAdminRegistry with
      instanceId
      owner
      tokenConfigs = Map.fromList [
        (encodedInstrumentId, TokenConfig instrumentId None (Some owner) None)
        ]

  let instAddr = makeInstanceAddress instanceId owner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver tarCid

  -- Encode AcceptAdminRole params
  let encoded = encodeAcceptAdminParams instrumentId

  -- Call mcmsEntrypoint
  newContractIds <- submit owner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "AcceptAdminRole"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId tarCid)]

  -- Verify admin was accepted
  contracts <- query @TokenAdminRegistry owner
  case filter (\(_, tar) -> tar.instanceId == instanceId) contracts of
    [(_, tar)] ->
      case Map.lookup encodedInstrumentId tar.tokenConfigs of
        None -> abort "Expected token config"
        Some config -> do
          config.admin === Some owner
          config.pendingAdmin === None
    _ -> abort "Expected exactly one TokenAdminRegistry contract"

  pure ()

-- ===========================================================================
-- ERROR CASE TESTS
-- ===========================================================================

-- | Test that unknown function name returns E_UNKNOWN_FUNCTION
testTokenAdminRegistryMCMSEntrypoint_UnknownFunction : Script ()
testTokenAdminRegistryMCMSEntrypoint_UnknownFunction = script do
  owner <- allocateParty "ccip_owner"

  let instanceId = "tar-error-test"

  tarCid <- submit owner do
    createCmd TokenAdminRegistry with
      instanceId
      owner
      tokenConfigs = Map.empty

  let instAddr = makeInstanceAddress instanceId owner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver tarCid

  -- Call with unknown function name - should fail
  submitMustFail owner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "NonExistentFunction"
      operationData = ""
      contractIds = Map.fromList [(instAddr, toAnyContractId tarCid)]

  pure ()

-- | Test that invalid params returns E_INVALID_PARAMS
testTokenAdminRegistryMCMSEntrypoint_InvalidParams : Script ()
testTokenAdminRegistryMCMSEntrypoint_InvalidParams = script do
  owner <- allocateParty "ccip_owner"

  let instanceId = "tar-invalid-test"

  tarCid <- submit owner do
    createCmd TokenAdminRegistry with
      instanceId
      owner
      tokenConfigs = Map.empty

  let instAddr = makeInstanceAddress instanceId owner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver tarCid

  -- Call with invalid/truncated operationData - should fail
  submitMustFail owner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "SetPool"
      operationData = "00"  -- Too short to decode
      contractIds = Map.fromList [(instAddr, toAnyContractId tarCid)]

  pure ()

-- | Test that missing self CID returns E_SELF_CID_NOT_IN_MAP
testTokenAdminRegistryMCMSEntrypoint_MissingSelfCid : Script ()
testTokenAdminRegistryMCMSEntrypoint_MissingSelfCid = script do
  owner <- allocateParty "ccip_owner"
  tokenAdmin <- allocateParty "TokenAdmin"

  let instanceId = "tar-missing-cid-test"
      instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "TEST"

  tarCid <- submit owner do
    createCmd TokenAdminRegistry with
      instanceId
      owner
      tokenConfigs = Map.empty

  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver tarCid

  -- Encode valid params
  let encoded = encodeAcceptAdminParams instrumentId

  -- Call with empty contractIds map - should fail
  submitMustFail owner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "AcceptAdminRole"
      operationData = encoded
      contractIds = Map.empty  -- Missing self CID

  pure ()

-- Helper to convert ContractId to AnyContractId for the map
toAnyContractId : ContractId a -> ContractId ()
toAnyContractId = coerceContractId
