-- | MCMS entrypoint tests for TokenAdminRegistry
-- Tests the MCMSReceiver interface implementation by calling mcmsEntrypoint directly
module CCIP.TokenAdminRegistryTest.TokenAdminRegistryMCMSTest where

import Daml.Script
import DA.Assert ((===))
import DA.Map qualified as Map
import DA.Optional (isSome)

import qualified Splice.Api.Token.HoldingV1
import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiver_Entrypoint(..), makeInstanceAddress)
import qualified CCIP.MessageCodecV1
import CCIP.TokenAdminRegistry
import CCIP.TokenAdminRegistryCodec
import CCIP.TokenAdminRegistryTypes (PoolRegistration(..), TokenConfig(..))

-- ===========================================================================
-- MCMS ENTRYPOINT TESTS - SET POOL
-- ===========================================================================

-- | Test MCMSReceiver entrypoint for SetPool function
testTokenAdminRegistryMCMSEntrypoint_SetPool : Script ()
testTokenAdminRegistryMCMSEntrypoint_SetPool = script do
  owner <- allocateParty "ccip_owner"
  tokenAdmin <- allocateParty "TokenAdmin"
  poolOwner <- allocateParty "PoolOwner"

  let instanceId = "tar-test-instance"
      instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "USDC"
      encodedInstrumentId = CCIP.MessageCodecV1.encodeInstrumentId instrumentId

  -- Create TokenAdminRegistry with a token config that has an admin set
  tarCid <- submit owner do
    createCmd TokenAdminRegistry with
      instanceId
      owner
      tokenConfigs = Map.fromList [
        (encodedInstrumentId, TokenConfig instrumentId (Some owner) None None)
        ]

  let instAddr = makeInstanceAddress instanceId owner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver tarCid

  -- Encode SetPool params
  let poolReg = PoolRegistration poolOwner "pool-v1"
      encoded = encodeSetPoolParams instrumentId (Some poolReg)

  -- Call mcmsEntrypoint directly via MCMSReceiver interface
  newContractIds <- submit owner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "SetPool"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId tarCid)]

  -- Verify state changed
  contracts <- query @TokenAdminRegistry owner
  case filter (\(_, tar) -> tar.instanceId == instanceId) contracts of
    [(_, tar)] -> do
      case Map.lookup encodedInstrumentId tar.tokenConfigs of
        None -> abort "Expected token config"
        Some config -> do
          isSome config.tokenPool === True
          case config.tokenPool of
            None -> abort "Expected pool to be set"
            Some pool -> do
              pool.poolOwner === poolOwner
              pool.poolInstanceId === "pool-v1"
    _ -> abort "Expected exactly one TokenAdminRegistry contract"

  pure ()

-- | Test MCMSReceiver entrypoint for SetPool to remove pool (None)
testTokenAdminRegistryMCMSEntrypoint_SetPoolNone : Script ()
testTokenAdminRegistryMCMSEntrypoint_SetPoolNone = script do
  owner <- allocateParty "ccip_owner"
  tokenAdmin <- allocateParty "TokenAdmin"
  poolOwner <- allocateParty "PoolOwner"

  let instanceId = "tar-test-instance"
      instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "LINK"
      encodedInstrumentId = CCIP.MessageCodecV1.encodeInstrumentId instrumentId
      existingPool = PoolRegistration poolOwner "old-pool"

  -- Create TokenAdminRegistry with existing pool
  tarCid <- submit owner do
    createCmd TokenAdminRegistry with
      instanceId
      owner
      tokenConfigs = Map.fromList [
        (encodedInstrumentId, TokenConfig instrumentId (Some owner) None (Some existingPool))
        ]

  let instAddr = makeInstanceAddress instanceId owner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver tarCid

  -- Encode SetPool params with None (remove pool)
  let encoded = encodeSetPoolParams instrumentId None

  -- Call mcmsEntrypoint
  newContractIds <- submit owner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "SetPool"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId tarCid)]

  -- Verify pool was removed
  contracts <- query @TokenAdminRegistry owner
  case filter (\(_, tar) -> tar.instanceId == instanceId) contracts of
    [(_, tar)] ->
      case Map.lookup encodedInstrumentId tar.tokenConfigs of
        None -> abort "Expected token config"
        Some config -> config.tokenPool === None
    _ -> abort "Expected exactly one TokenAdminRegistry contract"

  pure ()

-- ===========================================================================
-- MCMS ENTRYPOINT TESTS - PROPOSE ADMINISTRATOR
-- ===========================================================================

-- | Test MCMSReceiver entrypoint for ProposeAdministrator function
testTokenAdminRegistryMCMSEntrypoint_ProposeAdministrator : Script ()
testTokenAdminRegistryMCMSEntrypoint_ProposeAdministrator = script do
  owner <- allocateParty "ccip_owner"
  tokenAdmin <- allocateParty "TokenAdmin"
  newAdmin <- allocateParty "NewAdmin"

  let instanceId = "tar-propose-test"
      instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "TOKEN"
      encodedInstrumentId = CCIP.MessageCodecV1.encodeInstrumentId instrumentId

  -- Create TokenAdminRegistry with no config for this instrument
  tarCid <- submit owner do
    createCmd TokenAdminRegistry with
      instanceId
      owner
      tokenConfigs = Map.empty

  let instAddr = makeInstanceAddress instanceId owner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver tarCid

  -- Encode ProposeAdministrator params
  let encoded = encodeProposeAdminParams instrumentId newAdmin

  -- Call mcmsEntrypoint
  newContractIds <- submit owner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "ProposeAdministrator"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId tarCid)]

  -- Verify pendingAdmin was set
  contracts <- query @TokenAdminRegistry owner
  case filter (\(_, tar) -> tar.instanceId == instanceId) contracts of
    [(_, tar)] ->
      case Map.lookup encodedInstrumentId tar.tokenConfigs of
        None -> abort "Expected token config to be created"
        Some config -> do
          config.admin === None
          config.pendingAdmin === Some newAdmin
    _ -> abort "Expected exactly one TokenAdminRegistry contract"

  pure ()

