-- | Test MCMSReceiver entrypoint for TransferAdminRole function
testTokenAdminRegistryMCMSEntrypoint_TransferAdminRole : Script ()
testTokenAdminRegistryMCMSEntrypoint_TransferAdminRole = script do
  owner <- allocateParty "ccip_owner"
  tokenAdmin <- allocateParty "TokenAdmin"
  newAdmin <- allocateParty "NewAdmin"

  let instanceId = "tar-transfer-test"
      instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "WETH"
      encodedInstrumentId = CCIP.MessageCodecV1.encodeInstrumentId instrumentId

  -- Create TokenAdminRegistry with admin set to owner
  tarCid <- submit owner do
    createCmd TokenAdminRegistry with
      instanceId
      owner
      tokenConfigs = Map.fromList [
        (encodedInstrumentId, TokenConfig instrumentId (Some owner) None None)
        ]

  let instAddr = makeInstanceAddress instanceId owner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver tarCid

  -- Encode TransferAdminRole params
  let encoded = encodeTransferAdminParams instrumentId newAdmin

  -- Call mcmsEntrypoint
  newContractIds <- submit owner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "TransferAdminRole"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId tarCid)]

  -- Verify admin was transferred
  contracts <- query @TokenAdminRegistry owner
  case filter (\(_, tar) -> tar.instanceId == instanceId) contracts of
    [(_, tar)] ->
      case Map.lookup encodedInstrumentId tar.tokenConfigs of
        None -> abort "Expected token config"
        Some config -> config.admin === Some newAdmin
    _ -> abort "Expected exactly one TokenAdminRegistry contract"

  pure ()

