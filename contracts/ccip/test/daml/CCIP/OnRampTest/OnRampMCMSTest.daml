testOnRampMCMSEntrypoint_MissingSelfCid : Script ()
testOnRampMCMSEntrypoint_MissingSelfCid = script do
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "onramp-missing-cid-test"
      deps = CCIP.RuntimeV2.OnRamp.OnRampDeps with
        globalConfig = Chainlink.InstanceAddress.RawInstanceAddress "gc@owner"
        rmnRemote = Chainlink.InstanceAddress.RawInstanceAddress "rmn@owner"
        tokenAdminRegistry = Chainlink.InstanceAddress.RawInstanceAddress "tar@owner"
        feeQuoter = Chainlink.InstanceAddress.RawInstanceAddress "fq@owner"

  onRampCid <- submit ccipOwner do
    createCmd CCIP.RuntimeV2.OnRamp.OnRamp with
      instanceId
      ccipOwner
      maxUSDCentsPerMsg = 1000000000.0
      deps

  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver onRampCid

  let encoded = CCIP.RuntimeV2.OnRampCodecGen.encodeSetDepsParams (CCIP.RuntimeV2.OnRamp.SetDepsParams with
        globalConfig = Some deps.globalConfig
        rmnRemote = Some deps.rmnRemote
        tokenAdminRegistry = Some deps.tokenAdminRegistry
        feeQuoter = Some deps.feeQuoter)

  submitMustFail ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "SetDeps"
      operationData = encoded
      contractIds = Map.empty

  pure ()

toAnyContractId : ContractId a -> ContractId ()
toAnyContractId = coerceContractId
