-- | MCMS entrypoint tests for OnRamp
-- Tests the MCMSReceiver interface implementation by calling mcmsEntrypoint directly
module CCIP.OnRampTest.OnRampMCMSTest where

import Daml.Script
import DA.Assert ((===))
import DA.Map qualified as Map

import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiver_Entrypoint(..))

import qualified Chainlink.InstanceAddress

import qualified CCIP.RuntimeV2.OnRamp
import qualified CCIP.RuntimeV2.OnRampCodecGen

-- ===========================================================================
-- MCMS ENTRYPOINT TESTS - SET DEPS
-- ===========================================================================

-- | Test MCMSReceiver entrypoint for SetDeps function (all fields updated)
testOnRampMCMSEntrypoint_SetDeps : Script ()
testOnRampMCMSEntrypoint_SetDeps = script do
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "onramp-test"
      initialDeps = CCIP.RuntimeV2.OnRamp.OnRampDeps with
        globalConfig = Chainlink.InstanceAddress.RawInstanceAddress "gc-old@owner"
        rmnRemote = Chainlink.InstanceAddress.RawInstanceAddress "rmn-old@owner"
        tokenAdminRegistry = Chainlink.InstanceAddress.RawInstanceAddress "tar-old@owner"
        feeQuoter = Chainlink.InstanceAddress.RawInstanceAddress "fq-old@owner"

  onRampCid <- submit ccipOwner do
    createCmd CCIP.RuntimeV2.OnRamp.OnRamp with
      instanceId
      ccipOwner
      maxUSDCentsPerMsg = 1000000000.0
      deps = initialDeps

  let instAddr = Chainlink.InstanceAddress.makeText instanceId ccipOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver onRampCid

  let newDeps = CCIP.RuntimeV2.OnRamp.SetDepsParams with
        globalConfig = Some (Chainlink.InstanceAddress.RawInstanceAddress "gc-new@owner")
        rmnRemote = Some (Chainlink.InstanceAddress.RawInstanceAddress "rmn-new@owner")
        tokenAdminRegistry = Some (Chainlink.InstanceAddress.RawInstanceAddress "tar-new@owner")
        feeQuoter = Some (Chainlink.InstanceAddress.RawInstanceAddress "fq-new@owner")

      encoded = CCIP.RuntimeV2.OnRampCodecGen.encodeSetDepsParams newDeps

  newContractIds <- submit ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "SetDeps"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId onRampCid)]

  contracts <- query @CCIP.RuntimeV2.OnRamp.OnRamp ccipOwner
  case filter (\(_, onRamp) -> onRamp.instanceId == instanceId) contracts of
    [(_, onRamp)] -> do
      onRamp.deps.globalConfig === Chainlink.InstanceAddress.RawInstanceAddress "gc-new@owner"
      onRamp.deps.rmnRemote === Chainlink.InstanceAddress.RawInstanceAddress "rmn-new@owner"
      onRamp.deps.tokenAdminRegistry === Chainlink.InstanceAddress.RawInstanceAddress "tar-new@owner"
      onRamp.deps.feeQuoter === Chainlink.InstanceAddress.RawInstanceAddress "fq-new@owner"
    _ -> abort "Expected exactly one OnRamp contract"

  pure ()

-- | Test partial update: only update feeQuoter
testOnRampMCMSEntrypoint_SetDeps_Partial : Script ()
testOnRampMCMSEntrypoint_SetDeps_Partial = script do
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "onramp-partial-test"
      initialDeps = CCIP.RuntimeV2.OnRamp.OnRampDeps with
        globalConfig = Chainlink.InstanceAddress.RawInstanceAddress "gc-old@owner"
        rmnRemote = Chainlink.InstanceAddress.RawInstanceAddress "rmn-old@owner"
        tokenAdminRegistry = Chainlink.InstanceAddress.RawInstanceAddress "tar-old@owner"
        feeQuoter = Chainlink.InstanceAddress.RawInstanceAddress "fq-old@owner"

  onRampCid <- submit ccipOwner do
    createCmd CCIP.RuntimeV2.OnRamp.OnRamp with
      instanceId
      ccipOwner
      maxUSDCentsPerMsg = 1000000000.0
      deps = initialDeps

  let instAddr = Chainlink.InstanceAddress.makeText instanceId ccipOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver onRampCid

  let partialDeps = CCIP.RuntimeV2.OnRamp.SetDepsParams with
        globalConfig = None
        rmnRemote = None
        tokenAdminRegistry = None
        feeQuoter = Some (Chainlink.InstanceAddress.RawInstanceAddress "fq-new@owner")

      encoded = CCIP.RuntimeV2.OnRampCodecGen.encodeSetDepsParams partialDeps

  submit ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "SetDeps"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId onRampCid)]

  contracts <- query @CCIP.RuntimeV2.OnRamp.OnRamp ccipOwner
  case filter (\(_, onRamp) -> onRamp.instanceId == instanceId) contracts of
    [(_, onRamp)] -> do
      onRamp.deps.globalConfig === Chainlink.InstanceAddress.RawInstanceAddress "gc-old@owner"
      onRamp.deps.rmnRemote === Chainlink.InstanceAddress.RawInstanceAddress "rmn-old@owner"
      onRamp.deps.tokenAdminRegistry === Chainlink.InstanceAddress.RawInstanceAddress "tar-old@owner"
      onRamp.deps.feeQuoter === Chainlink.InstanceAddress.RawInstanceAddress "fq-new@owner"
    _ -> abort "Expected exactly one OnRamp contract"

  pure ()

-- | Test replacing existing deps sequentially
testOnRampMCMSEntrypoint_SetDeps_Replace : Script ()
testOnRampMCMSEntrypoint_SetDeps_Replace = script do
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "onramp-replace-test"
      initialDeps = CCIP.RuntimeV2.OnRamp.OnRampDeps with
        globalConfig = Chainlink.InstanceAddress.RawInstanceAddress "gc1@owner"
        rmnRemote = Chainlink.InstanceAddress.RawInstanceAddress "rmn1@owner"
        tokenAdminRegistry = Chainlink.InstanceAddress.RawInstanceAddress "tar1@owner"
        feeQuoter = Chainlink.InstanceAddress.RawInstanceAddress "fq1@owner"

  onRampCid <- submit ccipOwner do
    createCmd CCIP.RuntimeV2.OnRamp.OnRamp with
      instanceId
      ccipOwner
      maxUSDCentsPerMsg = 1000000000.0
      deps = initialDeps

  let instAddr = Chainlink.InstanceAddress.makeText instanceId ccipOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver onRampCid

  let deps2 = CCIP.RuntimeV2.OnRamp.SetDepsParams with
        globalConfig = Some (Chainlink.InstanceAddress.RawInstanceAddress "gc2@owner")
        rmnRemote = Some (Chainlink.InstanceAddress.RawInstanceAddress "rmn2@owner")
        tokenAdminRegistry = Some (Chainlink.InstanceAddress.RawInstanceAddress "tar2@owner")
        feeQuoter = Some (Chainlink.InstanceAddress.RawInstanceAddress "fq2@owner")
      encoded1 = CCIP.RuntimeV2.OnRampCodecGen.encodeSetDepsParams deps2

  newContractIds1 <- submit ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "SetDeps"
      operationData = encoded1
      contractIds = Map.fromList [(instAddr, toAnyContractId onRampCid)]

  contracts1 <- query @CCIP.RuntimeV2.OnRamp.OnRamp ccipOwner
  case filter (\(_, onRamp) -> onRamp.instanceId == instanceId) contracts1 of
    [(newCid, onRamp1)] -> do
      onRamp1.deps.globalConfig === Chainlink.InstanceAddress.RawInstanceAddress "gc2@owner"

      let targetAsMcmsReceiver2 = toInterfaceContractId @MCMSReceiver newCid
      let deps3 = CCIP.RuntimeV2.OnRamp.SetDepsParams with
            globalConfig = Some (Chainlink.InstanceAddress.RawInstanceAddress "gc3@owner")
            rmnRemote = Some (Chainlink.InstanceAddress.RawInstanceAddress "rmn3@owner")
            tokenAdminRegistry = Some (Chainlink.InstanceAddress.RawInstanceAddress "tar3@owner")
            feeQuoter = Some (Chainlink.InstanceAddress.RawInstanceAddress "fq3@owner")
          encoded2 = CCIP.RuntimeV2.OnRampCodecGen.encodeSetDepsParams deps3

      newContractIds2 <- submit ccipOwner do
        exerciseCmd targetAsMcmsReceiver2 MCMSReceiver_Entrypoint with
          functionName = "SetDeps"
          operationData = encoded2
          contractIds = Map.fromList [(instAddr, toAnyContractId newCid)]

      contracts2 <- query @CCIP.RuntimeV2.OnRamp.OnRamp ccipOwner
      case filter (\(_, onRamp) -> onRamp.instanceId == instanceId) contracts2 of
        [(_, onRamp2)] -> do
          onRamp2.deps.globalConfig === Chainlink.InstanceAddress.RawInstanceAddress "gc3@owner"
          onRamp2.deps.rmnRemote === Chainlink.InstanceAddress.RawInstanceAddress "rmn3@owner"
        _ -> abort "Expected exactly one OnRamp contract after second update"

    _ -> abort "Expected exactly one OnRamp contract after first update"

  pure ()

-- ===========================================================================
-- ERROR CASE TESTS
-- ===========================================================================

testOnRampMCMSEntrypoint_UnknownFunction : Script ()
testOnRampMCMSEntrypoint_UnknownFunction = script do
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "onramp-error-test"
      deps = CCIP.RuntimeV2.OnRamp.OnRampDeps with
        globalConfig = Chainlink.InstanceAddress.RawInstanceAddress "gc@owner"
        rmnRemote = Chainlink.InstanceAddress.RawInstanceAddress "rmn@owner"
        tokenAdminRegistry = Chainlink.InstanceAddress.RawInstanceAddress "tar@owner"
        feeQuoter = Chainlink.InstanceAddress.RawInstanceAddress "fq@owner"

  onRampCid <- submit ccipOwner do
    createCmd CCIP.RuntimeV2.OnRamp.OnRamp with
      instanceId
      ccipOwner
      maxUSDCentsPerMsg = 1000000000.0
      deps

  let instAddr = Chainlink.InstanceAddress.makeText instanceId ccipOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver onRampCid

  submitMustFail ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "NonExistentFunction"
      operationData = ""
      contractIds = Map.fromList [(instAddr, toAnyContractId onRampCid)]

  pure ()

