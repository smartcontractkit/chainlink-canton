-- | Test that missing self CID returns E_SELF_CID_NOT_IN_MAP
testLockReleaseTokenPoolMCMSEntrypoint_MissingSelfCid : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_MissingSelfCid = script do
    ccipOwner <- allocateParty "ccip_owner"
    poolOwner <- allocateParty "pool_owner"
    tokenAdmin <- allocateParty "token_admin"

    let instanceId = "pool-missing-cid-test"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "TEST"

    poolCid <- submit poolOwner do
        createCmd LockReleaseTokenPool with
            instanceId
            poolOwner
            ccipOwner
            instrumentId
            decimals = 18
            rateLimitAdmin = None
            remoteChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = MetadataV1.ChoiceContext (TextMap.empty)
            transferTimeout = Indefinite
            deps = dummyPoolDeps ccipOwner

    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

  -- Encode valid params
    let args = [
            ChainUpdate with
                remoteChainSelector = 123.0
                remotePools = ["1fb477ac89df394bead4f46ad754f8aec70cc0e4", "d7e508a1d4ba82aed19fadcbf6ebd81d2c9b173a"]
                remoteTokenAddress = "cbae4ea0c4c503a582af009bb2b30b75badc1e32"
                inboundCCVs = [RawInstanceAddress "in1@owner", RawInstanceAddress "in2@owner"]
                outboundCCVs = []
                finalityConfig = mkFinalityConfig 0
                inboundRateLimiter = RawInstanceAddress "rate-limiter-in-new@owner"
                inboundCustomBlockConfirmationsRateLimiter = RawInstanceAddress "rate-limiter-in-custom-new@owner"
                outboundRateLimiter = RawInstanceAddress "rate-limiter-out-new@owner"
            ]

        encoded = encodeApplyChainUpdatesParams (ApplyChainUpdatesParams with
            remoteChainSelectorsToRemove = [123.0]
            chainsToAdd = args)

  -- Call with empty contractIds map - should fail
    submitMustFail poolOwner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "ApplyChainUpdates"
            operationData = encoded
            contractIds = Map.empty  -- Missing self CID

    pure ()

-- Helper to convert ContractId to AnyContractId for the map
toAnyContractId : ContractId a -> ContractId ()
toAnyContractId = coerceContractId

-- Assertion helpers

assertChainUpdateEqual : RemoteChainConfig -> ChainUpdate -> Script ()
assertChainUpdateEqual got expected = do
    assertMsg ("remotePools mismatch, got: " <> show got.remotePools <> ", expected: " <> show expected.remotePools) (got.remotePools == expected.remotePools)
    assertMsg ("remoteTokenAddress mismatch, got: " <> show got.remoteTokenAddress <> ", expected: " <> show expected.remoteTokenAddress) (got.remoteTokenAddress == expected.remoteTokenAddress)
    assertMsg ("inboundCCVs mismatch, got: " <> show got.inboundCCVs <> ", expected: " <> show expected.inboundCCVs) (got.inboundCCVs == expected.inboundCCVs)
    assertMsg ("outboundCCVs mismatch, got: " <> show got.outboundCCVs <> ", expected: " <> show expected.outboundCCVs) (got.outboundCCVs == expected.outboundCCVs)
    assertMsg ("inboundRateLimiter mismatch, got: " <> show got.inboundRateLimiter <> ", expected: " <> show expected.inboundRateLimiter) (got.inboundRateLimiter == expected.inboundRateLimiter)
    assertMsg ("outboundRateLimiter mismatch, got: " <> show got.outboundRateLimiter <> ", expected: " <> show expected.outboundRateLimiter) (got.outboundRateLimiter == expected.outboundRateLimiter)

assertTokenTransferFeeConfigEqual : TokenTransferFeeConfig -> TokenTransferFeeConfigArgs -> Script ()
assertTokenTransferFeeConfigEqual got expected = do
    assertMsg ("isEnabled mismatch, got: " <> show got.isEnabled <> ", expected: " <> show expected.isEnabled) (got.isEnabled == expected.isEnabled)
    assertMsg ("destGasOverhead mismatch, got: " <> show got.destGasOverhead <> ", expected: " <> show expected.destGasOverhead) (got.destGasOverhead == expected.destGasOverhead)
    assertMsg ("destBytesOverhead mismatch, got: " <> show got.destBytesOverhead <> ", expected: " <> show expected.destBytesOverhead) (got.destBytesOverhead == expected.destBytesOverhead)
    assertMsg ("feeUSDCents mismatch, got: " <> show got.feeUSDCents <> ", expected: " <> show expected.feeUSDCents) (got.feeUSDCents == expected.feeUSDCents)
    assertMsg ("feeBps mismatch, got: " <> show got.feeBps <> ", expected: " <> show expected.feeBps) (got.feeBps == expected.feeBps)

assertRateLimitConfigArgsEqual : RemoteChainConfig -> RateLimitConfigArgs -> Script ()
assertRateLimitConfigArgsEqual got expected = do
    assertMsg ("inboundRateLimiter mismatch, got: " <> show got.inboundRateLimiter <> ", expected: " <> show expected.inboundRateLimiter) (got.inboundRateLimiter == expected.inboundRateLimiter)
    assertMsg ("outboundRateLimiter mismatch, got: " <> show got.outboundRateLimiter <> ", expected: " <> show expected.outboundRateLimiter) (got.outboundRateLimiter == expected.outboundRateLimiter)

-- ========================================================
-- |   MCMS Entrypoint - pool receive context  |
-- ========================================================

testLockReleaseTokenPoolMCMSEntrypoint_AddPoolReceiveContextNonContractValue : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_AddPoolReceiveContextNonContractValue = script do
    ccipOwner <- allocateParty "ccip_owner"
    poolOwner <- allocateParty "pool_owner"
    tokenAdmin <- allocateParty "token_admin"

    let instanceId = "pool-context-test"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "USDC"

    poolCid <- submit poolOwner do
        createCmd LockReleaseTokenPool with
            instanceId
            poolOwner
            ccipOwner
            instrumentId
            decimals = 6
            rateLimitAdmin = None
            remoteChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = MetadataV1.emptyChoiceContext
            transferTimeout = Indefinite
            deps = dummyPoolDeps ccipOwner

    let instAddr = RawInstanceAddress.makeText instanceId poolOwner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

    let newContext = MetadataV1.ChoiceContext (TextMap.fromList [("key1", MetadataV1.AV_Text "value1"), ("key2", MetadataV1.AV_Int 42)])
    let encoded1 = encodeAddPoolReceiveContextNonContractValueParams (AddPoolReceiveContextNonContractValueParams with contextKey = "key1", valuePayload = encodeAnyValue (MetadataV1.AV_Text "value1"))
    cidMap1 <- submit poolOwner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "AddPoolReceiveContextNonContractValue"
            operationData = encoded1
            contractIds = Map.fromList [(instAddr, toAnyContractId poolCid)]

    let poolCid2 = coerceContractId (fromSome (Map.lookup instAddr cidMap1)) : ContractId LockReleaseTokenPool
    let target2 = toInterfaceContractId @MCMSReceiver poolCid2
    let encoded2 = encodeAddPoolReceiveContextNonContractValueParams (AddPoolReceiveContextNonContractValueParams with contextKey = "key2", valuePayload = encodeAnyValue (MetadataV1.AV_Int 42))
    _ <- submit poolOwner do
        exerciseCmd target2 MCMSReceiver_Entrypoint with
            functionName = "AddPoolReceiveContextNonContractValue"
            operationData = encoded2
            contractIds = Map.fromList [(instAddr, toAnyContractId poolCid2)]

    contracts <- query @LockReleaseTokenPool poolOwner
    case filter (\(_, pool) -> pool.instanceId == instanceId) contracts of
        [(_, pool)] -> do
            assertMsg ("poolReceiveContext mismatch, got: " <> show pool.poolReceiveContext <> ", expected: " <> show newContext) (pool.poolReceiveContext == newContext)
        _ -> abort "Expected exactly one LockReleaseTokenPool contract"

testLockReleaseTokenPoolMCMSEntrypoint_ClearPoolReceiveContext : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_ClearPoolReceiveContext = script do
    ccipOwner <- allocateParty "ccip_owner"
    poolOwner <- allocateParty "pool_owner"
    tokenAdmin <- allocateParty "token_admin"

    let instanceId = "pool-context-empty-test"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "LINK"
        initialContext = MetadataV1.ChoiceContext (TextMap.fromList [("existing", MetadataV1.AV_Text "data")])

    poolCid <- submit poolOwner do
        createCmd LockReleaseTokenPool with
            instanceId
            poolOwner
            ccipOwner
            instrumentId
            decimals = 18
            rateLimitAdmin = None
            remoteChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = initialContext
            transferTimeout = Indefinite
            deps = dummyPoolDeps ccipOwner

    let instAddr = RawInstanceAddress.makeText instanceId poolOwner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

    let emptyContext = MetadataV1.emptyChoiceContext
    _ <- submit poolOwner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "ClearPoolReceiveContext"
            operationData = ""
            contractIds = Map.fromList [(instAddr, toAnyContractId poolCid)]

    contracts <- query @LockReleaseTokenPool poolOwner
    case filter (\(_, pool) -> pool.instanceId == instanceId) contracts of
        [(_, pool)] -> do
            assertMsg ("poolReceiveContext should be empty") (pool.poolReceiveContext == emptyContext)
        _ -> abort "Expected exactly one LockReleaseTokenPool contract"

testLockReleaseTokenPoolMCMSEntrypoint_AddPoolReceiveContextContractValue : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_AddPoolReceiveContextContractValue = script do
    ccipOwner <- allocateParty "ccip_owner"
    poolOwner <- allocateParty "pool_owner"
    tokenAdmin <- allocateParty "token_admin"

    let instanceId = "pool-context-contract-ref-test"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "USDC"

    poolCid <- submit poolOwner do
        createCmd LockReleaseTokenPool with
            instanceId
            poolOwner
            ccipOwner
            instrumentId
            decimals = 6
            rateLimitAdmin = None
            remoteChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = MetadataV1.emptyChoiceContext
            transferTimeout = Indefinite
            deps = dummyPoolDeps ccipOwner

    let instAddr = RawInstanceAddress.makeText instanceId poolOwner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid
    let encoded = encodeAddPoolReceiveContextContractValueParams (AddPoolReceiveContextContractValueParams with contextKey = "selfRef", referentInstanceAddress = RawInstanceAddress instAddr)

    _ <- submit poolOwner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "AddPoolReceiveContextContractValue"
            operationData = encoded
            contractIds = Map.fromList [(instAddr, toAnyContractId poolCid)]

    contracts <- query @LockReleaseTokenPool poolOwner
    case filter (\(_, pool) -> pool.instanceId == instanceId) contracts of
        [(_, pool)] -> do
            let expected = MetadataV1.ChoiceContext (TextMap.fromList [("selfRef", MetadataV1.AV_ContractId (coerceContractId poolCid))])
            assertMsg ("poolReceiveContext mismatch, got: " <> show pool.poolReceiveContext) (pool.poolReceiveContext == expected)
        _ -> abort "Expected exactly one LockReleaseTokenPool contract"

testLockReleaseTokenPoolMCMSEntrypoint_RemovePoolReceiveContextValue : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_RemovePoolReceiveContextValue = script do
    ccipOwner <- allocateParty "ccip_owner"
    poolOwner <- allocateParty "pool_owner"
    tokenAdmin <- allocateParty "token_admin"

    let instanceId = "pool-context-remove-test"
