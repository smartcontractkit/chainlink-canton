testLockReleaseTokenPoolMCMSEntrypoint_SetTransferTimeout_Indefinite : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_SetTransferTimeout_Indefinite = script do
    ccipOwner <- allocateParty "ccip_owner"
    poolOwner <- allocateParty "pool_owner"
    tokenAdmin <- allocateParty "token_admin"

    let instanceId = "pool-timeout-indefinite-test"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "USDC"

    -- Create LockReleaseTokenPool with RelativeHours timeout
    poolCid <- submit poolOwner do
        createCmd LockReleaseTokenPool with
            instanceId
            poolOwner
            ccipOwner
            instrumentId
            decimals = 6
            rateLimitAdmin = None
            remoteChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = CCIP.Context.emptyCCIPContext
            transferTimeout = RelativeHours 24
            deps = dummyPoolDeps ccipOwner

    let instAddr = RawInstanceAddress.makeText instanceId poolOwner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

    -- Change to Indefinite
    let newTimeout = Indefinite
    let encodedParams = encodeSetTransferTimeoutParams (SetTransferTimeoutParams with transferTimeout = newTimeout)

    newContractIds <- submit poolOwner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "SetTransferTimeout"
            operationData = encodedParams
            contractIds = Map.fromList [(instAddr, toAnyContractId poolCid)]

    -- Verify timeout was updated
    contracts <- query @LockReleaseTokenPool poolOwner
    case filter (\(_, pool) -> pool.instanceId == instanceId) contracts of
        [(_, pool)] -> do
            assertMsg ("transferTimeout mismatch, got: " <> show pool.transferTimeout <> ", expected: " <> show newTimeout) (pool.transferTimeout == newTimeout)
        _ -> abort "Expected exactly one LockReleaseTokenPool contract"

testLockReleaseTokenPoolMCMSEntrypoint_SetTransferTimeout_RelativeHours : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_SetTransferTimeout_RelativeHours = script do
    ccipOwner <- allocateParty "ccip_owner"
    poolOwner <- allocateParty "pool_owner"
    tokenAdmin <- allocateParty "token_admin"

    let instanceId = "pool-timeout-hours-test"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "LINK"

    -- Create LockReleaseTokenPool with Indefinite timeout
    poolCid <- submit poolOwner do
        createCmd LockReleaseTokenPool with
            instanceId
            poolOwner
            ccipOwner
            instrumentId
            decimals = 18
            rateLimitAdmin = None
            remoteChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = CCIP.Context.emptyCCIPContext
            transferTimeout = Indefinite
            deps = dummyPoolDeps ccipOwner

    let instAddr = RawInstanceAddress.makeText instanceId poolOwner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

    -- Change to RelativeHours 48
    let newTimeout = RelativeHours 48
    let encodedParams = encodeSetTransferTimeoutParams (SetTransferTimeoutParams with transferTimeout = newTimeout)

    newContractIds <- submit poolOwner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "SetTransferTimeout"
            operationData = encodedParams
            contractIds = Map.fromList [(instAddr, toAnyContractId poolCid)]

    -- Verify timeout was updated
    contracts <- query @LockReleaseTokenPool poolOwner
    case filter (\(_, pool) -> pool.instanceId == instanceId) contracts of
        [(_, pool)] -> do
            assertMsg ("transferTimeout mismatch, got: " <> show pool.transferTimeout <> ", expected: " <> show newTimeout) (pool.transferTimeout == newTimeout)
        _ -> abort "Expected exactly one LockReleaseTokenPool contract"

-- | Test SetTransferTimeout with invalid data
testLockReleaseTokenPoolMCMSEntrypoint_SetTransferTimeout_InvalidData : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_SetTransferTimeout_InvalidData = script do
    ccipOwner <- allocateParty "ccip_owner"
    poolOwner <- allocateParty "pool_owner"
    tokenAdmin <- allocateParty "token_admin"

    let instanceId = "pool-timeout-invalid-test"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "TEST"

    poolCid <- submit poolOwner do
        createCmd LockReleaseTokenPool with
            instanceId
            poolOwner
            ccipOwner
            instrumentId
            decimals = 18
            rateLimitAdmin = None
            remoteChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = CCIP.Context.emptyCCIPContext
            transferTimeout = Indefinite
            deps = dummyPoolDeps ccipOwner

    let instAddr = RawInstanceAddress.makeText instanceId poolOwner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

    -- Call with invalid tag byte - should fail
    submitMustFail poolOwner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "SetTransferTimeout"
            operationData = "ff"  -- Invalid tag byte
            contractIds = Map.fromList [(instAddr, toAnyContractId poolCid)]

    pure ()
