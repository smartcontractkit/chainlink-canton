-- | MCMS entrypoint tests for LockReleaseTokenPool
-- Tests the MCMSReceiver interface implementation by calling mcmsEntrypoint directly
module CCIP.LockReleaseTokenPoolTest.LockReleaseTokenPoolMCMSTest where

import Daml.Script
import DA.Assert ((===))
import DA.List
import DA.Map qualified as Map
import DA.TextMap qualified as TextMap

import qualified Splice.Api.Token.HoldingV1
import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiver_Entrypoint(..), makeInstanceAddress)
import CCIP.LockReleaseTokenPool
import CCIP.LockReleaseTokenPoolCodec
import CCIP.RawInstanceAddress (RawInstanceAddress(..))
import qualified CCIP.Context

dummyPoolDeps : Party -> LockReleaseTokenPoolDeps
dummyPoolDeps ccipOwner =
  LockReleaseTokenPoolDeps with
    tokenAdminRegistry = RawInstanceAddress ("dummy-tar@" <> partyToText ccipOwner)
    rmnRemote = RawInstanceAddress ("dummy-rmn@" <> partyToText ccipOwner)
    feeQuoter = RawInstanceAddress ("dummy-fq@" <> partyToText ccipOwner)


-- ===========================================================================
-- MCMS ENTRYPOINT TESTS - ApplyChainUpdates
-- ===========================================================================

-- | Test MCMSReceiver entrypoint for ApplyChainUpdates function
testLockReleaseTokenPoolMCMSEntrypoint_ApplyChainUpdates : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_ApplyChainUpdates = script do
    ccipOwner <- allocateParty "ccip_owner"
    poolOwner <- allocateParty "pool_owner"
    tokenAdmin <- allocateParty "token_admin"

    let instanceId = "pool-test"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "USDC"

    -- Create LockReleaseTokenPool with no remote chain configs
    poolCid <- submit poolOwner do
        createCmd LockReleaseTokenPool with
            instanceId
            ccipOwner
            poolOwner
            instrumentId
            decimals = 6
            remoteChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = CCIP.Context.CCIPContext (TextMap.empty)
            transferTimeout = Indefinite
            deps = dummyPoolDeps ccipOwner

    let instAddr = makeInstanceAddress instanceId poolOwner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

    -- Create remote chain config
    let args = [
            ChainUpdate with
                remoteChainSelector = 123.0
                remotePools = ["1fb477ac89df394bead4f46ad754f8aec70cc0e4", "d7e508a1d4ba82aed19fadcbf6ebd81d2c9b173a"]
                remoteTokenAddress = "cbae4ea0c4c503a582af009bb2b30b75badc1e32"
                inboundCCVs = [RawInstanceAddress "in1@owner", RawInstanceAddress "in2@owner"]
                outboundCCVs = []
                minBlockDepth = 0
                inboundRateLimiter = RawInstanceAddress "rate-limiter-in-new@owner"
                inboundCustomRateLimiter = RawInstanceAddress "rate-limiter-in-custom-new@owner"
                outboundRateLimiter = RawInstanceAddress "rate-limiter-out-new@owner"
            ]

        encoded = encodeApplyChainUpdatesParams ([], args)

    -- Call mcmsEntrypoint
    newContractIds <- submit poolOwner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "ApplyChainUpdates"
            operationData = encoded
            contractIds = Map.fromList [(instAddr, toAnyContractId poolCid)]

    -- Verify chain pool config was added
    contracts <- query @LockReleaseTokenPool poolOwner
    case filter (\(_, pool) -> pool.instanceId == instanceId) contracts of
        [(_, pool)] -> do
            Map.size pool.remoteChainConfigs === 1
            case Map.lookup 123.0 pool.remoteChainConfigs of
                None -> abort "Expected chain pool config for chain 123"
                Some got -> do
                    assertChainUpdateEqual got (head args)
        _ -> abort "Expected exactly one LockReleaseTokenPool contract"

    pure ()

-- | Test updating existing remote chain config
testLockReleaseTokenPoolMCMSEntrypoint_UpdateChainPoolConfigs_Multiple : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_UpdateChainPoolConfigs_Multiple = script do
    ccipOwner <- allocateParty "ccip_owner"
    poolOwner <- allocateParty "pool_owner"
    tokenAdmin <- allocateParty "token_admin"

    let instanceId = "pool-multi-test"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "LINK"
        existingConfig = RemoteChainConfig with
            remotePools = ["d2ff32a3f0bb7b9b5afcfbaaa9ae629449ef2ff0"]
            remoteTokenAddress = "dde9af410cc4f737a136d87d3d4a4deeff1d26fc"
            inboundCCVs = [RawInstanceAddress "in1@owner"]
            outboundCCVs = [RawInstanceAddress "out1@owner"]
            minBlockDepth = 0
            inboundRateLimiter = RawInstanceAddress "rate-limiter-in@owner"
            inboundCustomRateLimiter = RawInstanceAddress "rate-limiter-in-custom@owner"
            outboundRateLimiter = RawInstanceAddress "rate-limiter-out@owner"

    -- Create LockReleaseTokenPool with existing remote chain config
    poolCid <- submit poolOwner do
        createCmd LockReleaseTokenPool with
            instanceId
            ccipOwner
            poolOwner
            instrumentId
            decimals = 18
            remoteChainConfigs = Map.fromList [(123.0, existingConfig)]
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = CCIP.Context.CCIPContext (TextMap.empty)
            transferTimeout = RelativeHours 24
            deps = dummyPoolDeps ccipOwner

    let instAddr = makeInstanceAddress instanceId poolOwner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

    -- Create multiple chain pool configs, one to replace existing
    let args = [
            ChainUpdate with
                remoteChainSelector = 123.0
                remotePools = ["1fb477ac89df394bead4f46ad754f8aec70cc0e4", "d7e508a1d4ba82aed19fadcbf6ebd81d2c9b173a"]
                remoteTokenAddress = "cbae4ea0c4c503a582af009bb2b30b75badc1e32"
                inboundCCVs = [RawInstanceAddress "in1@owner", RawInstanceAddress "in2@owner"]
                outboundCCVs = []
                minBlockDepth = 12
                inboundRateLimiter = RawInstanceAddress "rate-limiter-in-new@owner"
                inboundCustomRateLimiter = RawInstanceAddress "rate-limiter-in-custom-new@owner"
                outboundRateLimiter = RawInstanceAddress "rate-limiter-out-new@owner"
            ,ChainUpdate with
                remoteChainSelector = 456.0
                remotePools = ["d3704b816babab425caa936be1eb5b5a9bfb59c7"]
                remoteTokenAddress = "cf9a923ab9efa0e261608dbd3c40fc0cfabade92"
                inboundCCVs = [RawInstanceAddress "in4@owner", RawInstanceAddress "in5@owner"]
                outboundCCVs = []
                minBlockDepth = 0
                inboundRateLimiter = RawInstanceAddress "rate-limiter-in-2@owner"
                inboundCustomRateLimiter = RawInstanceAddress "rate-limiter-in-custom-2@owner"
                outboundRateLimiter = RawInstanceAddress "rate-limiter-out-2@owner"
            ]

        encoded = encodeApplyChainUpdatesParams ([123.0], args) -- Remove existing chain (123) and add new ones

    -- Call mcmsEntrypoint
    newContractIds <- submit poolOwner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "ApplyChainUpdates"
            operationData = encoded
            contractIds = Map.fromList [(instAddr, toAnyContractId poolCid)]

    -- Verify all configs were added/replaced
    contracts <- query @LockReleaseTokenPool poolOwner
    case filter (\(_, pool) -> pool.instanceId == instanceId) contracts of
        [(_, pool)] -> do
            Map.size pool.remoteChainConfigs === 2
            case Map.lookup 123.0 pool.remoteChainConfigs of
                None -> abort "Expected config for chain 123"
                Some got -> assertChainUpdateEqual got (head args)
            case Map.lookup 456.0 pool.remoteChainConfigs of
                None -> abort "Expected config for chain 456"
                Some got -> assertChainUpdateEqual got (args !! 1)
        _ -> abort "Expected exactly one LockReleaseTokenPool contract"

    pure ()

-- ===========================================================================
-- MCMS ENTRYPOINT TESTS - UpdateRateLimiters
-- ===========================================================================

testLockReleaseTokenPoolMCMSEntrypoint_UpdateRateLimiters : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_UpdateRateLimiters = script do
    ccipOwner <- allocateParty "ccip_owner"
    poolOwner <- allocateParty "pool_owner"
    tokenAdmin <- allocateParty "token_admin"

    let instanceId = "pool-multi-test"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "LINK"
        existingConfig = RemoteChainConfig with
            remotePools = ["d2ff32a3f0bb7b9b5afcfbaaa9ae629449ef2ff0"]
            remoteTokenAddress = "dde9af410cc4f737a136d87d3d4a4deeff1d26fc"
            inboundCCVs = [RawInstanceAddress "in1@owner"]
            outboundCCVs = [RawInstanceAddress "out1@owner"]
            minBlockDepth = 0
            inboundRateLimiter = RawInstanceAddress "rate-limiter-in@owner"
            inboundCustomRateLimiter = RawInstanceAddress "rate-limiter-in-custom@owner"
            outboundRateLimiter = RawInstanceAddress "rate-limiter-out@owner"

  -- Create LockReleaseTokenPool with existing config
    poolCid <- submit poolOwner do
        createCmd LockReleaseTokenPool with
            instanceId
            ccipOwner
            poolOwner
            instrumentId
            decimals = 18
            remoteChainConfigs = Map.fromList [(123.0, existingConfig)]
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = CCIP.Context.CCIPContext (TextMap.empty)
            transferTimeout = Indefinite
            deps = dummyPoolDeps ccipOwner

    let instAddr = makeInstanceAddress instanceId poolOwner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

    -- Create rate limiter config update for existing chain
    let args = [
            RateLimiterConfigArgs with
                remoteChainSelector = 123.0
                inboundRateLimiter = RawInstanceAddress "rate-limiter-in-updated@owner"
                inboundCustomRateLimiter = RawInstanceAddress "rate-limiter-in-custom-updated@owner"
                outboundRateLimiter = RawInstanceAddress "rate-limiter-out-updated@owner"
            ]

        encoded = encodeUpdateRateLimitersParams args

    -- Call mcmsEntrypoint
    newContractIds <- submit poolOwner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "UpdateRateLimiters"
            operationData = encoded
            contractIds = Map.fromList [(instAddr, toAnyContractId poolCid)]

    -- Verify config was updated
    contracts <- query @LockReleaseTokenPool poolOwner
    case filter (\(_, pool) -> pool.instanceId == instanceId) contracts of
        [(_, pool)] -> do
            case Map.lookup 123.0 pool.remoteChainConfigs of
                None -> abort "Expected config for chain 123"
                Some got -> do
                    assertRateLimiterConfigArgsEqual got (head args)
        _ -> abort "Expected exactly one LockReleaseTokenPool contract"

    pure ()

