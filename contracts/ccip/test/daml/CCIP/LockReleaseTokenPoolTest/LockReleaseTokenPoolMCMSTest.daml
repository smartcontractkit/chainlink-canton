-- | Test that unknown function name returns E_UNKNOWN_FUNCTION
testLockReleaseTokenPoolMCMSEntrypoint_UnknownFunction : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_UnknownFunction = script do
  ccipOwner <- allocateParty "ccip_owner"
  poolOwner <- allocateParty "pool_owner"
  tokenAdmin <- allocateParty "token_admin"

  let instanceId = "pool-error-test"
      instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "TEST"

  poolCid <- submit poolOwner do
    createCmd LockReleaseTokenPool with
      instanceId
      ccipOwner
      poolOwner
      instrumentId
      decimals = 18
      chainPoolConfigs = Map.empty
      chainFeeConfigs = Map.empty
      remoteTokens = Map.empty
      outboundRateLimiters = Map.empty
      inboundRateLimiters = Map.empty
      inboundCustomRateLimiters = Map.empty
      poolReceiveContext = CCIP.Context.CCIPContext (TextMap.empty)
      transferTimeout = Indefinite

  let instAddr = makeInstanceAddress instanceId poolOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

  -- Call with unknown function name - should fail
  submitMustFail poolOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "NonExistentFunction"
      operationData = ""
      contractIds = Map.fromList [(instAddr, toAnyContractId poolCid)]

  pure ()

-- | Test that invalid params returns E_INVALID_PARAMS
testLockReleaseTokenPoolMCMSEntrypoint_InvalidParams : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_InvalidParams = script do
  ccipOwner <- allocateParty "ccip_owner"
  poolOwner <- allocateParty "pool_owner"
  tokenAdmin <- allocateParty "token_admin"

  let instanceId = "pool-invalid-test"
      instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "TEST"

  poolCid <- submit poolOwner do
    createCmd LockReleaseTokenPool with
      instanceId
      ccipOwner
      poolOwner
      instrumentId
      decimals = 18
      chainPoolConfigs = Map.empty
      chainFeeConfigs = Map.empty
      remoteTokens = Map.empty
      outboundRateLimiters = Map.empty
      inboundRateLimiters = Map.empty
      inboundCustomRateLimiters = Map.empty
      poolReceiveContext = CCIP.Context.CCIPContext (TextMap.empty)
      transferTimeout = Indefinite

  let instAddr = makeInstanceAddress instanceId poolOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

  -- Call with invalid operationData - should fail
  submitMustFail poolOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "UpdateChainPoolConfigs"
      operationData = "invalid"  -- Not valid encoded data
      contractIds = Map.fromList [(instAddr, toAnyContractId poolCid)]

  pure ()

-- | Test that missing self CID returns E_SELF_CID_NOT_IN_MAP
testLockReleaseTokenPoolMCMSEntrypoint_MissingSelfCid : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_MissingSelfCid = script do
  ccipOwner <- allocateParty "ccip_owner"
  poolOwner <- allocateParty "pool_owner"
  tokenAdmin <- allocateParty "token_admin"

  let instanceId = "pool-missing-cid-test"
      instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "TEST"

  poolCid <- submit poolOwner do
    createCmd LockReleaseTokenPool with
      instanceId
      ccipOwner
      poolOwner
      instrumentId
      decimals = 18
      chainPoolConfigs = Map.empty
      chainFeeConfigs = Map.empty
      remoteTokens = Map.empty
      outboundRateLimiters = Map.empty
      inboundRateLimiters = Map.empty
      inboundCustomRateLimiters = Map.empty
      poolReceiveContext = CCIP.Context.CCIPContext (TextMap.empty)
      transferTimeout = Indefinite

  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

  -- Encode valid params
  let encoded = encodeUpdateChainPoolConfigsParams Map.empty

  -- Call with empty contractIds map - should fail
  submitMustFail poolOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "UpdateChainPoolConfigs"
      operationData = encoded
      contractIds = Map.empty  -- Missing self CID

  pure ()

-- Helper to convert ContractId to AnyContractId for the map
toAnyContractId : ContractId a -> ContractId ()
toAnyContractId = coerceContractId
