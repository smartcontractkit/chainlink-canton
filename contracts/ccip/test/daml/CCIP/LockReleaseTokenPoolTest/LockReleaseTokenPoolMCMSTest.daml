-- ERROR CASE TESTS
-- ===========================================================================

-- | Test that unknown function name returns E_UNKNOWN_FUNCTION
testLockReleaseTokenPoolMCMSEntrypoint_UnknownFunction : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_UnknownFunction = script do
    ccipOwner <- allocateParty "ccip_owner"
    poolOwner <- allocateParty "pool_owner"
    tokenAdmin <- allocateParty "token_admin"

    let instanceId = "pool-error-test"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "TEST"

    poolCid <- submit poolOwner do
        createCmd LockReleaseTokenPool with
            instanceId
            ccipOwner
            poolOwner
            instrumentId
            decimals = 18
            remoteChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = CCIP.Context.CCIPContext (TextMap.empty)
            transferTimeout = Indefinite
            deps = dummyPoolDeps ccipOwner

    let instAddr = makeInstanceAddress instanceId poolOwner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

  -- Call with unknown function name - should fail
    submitMustFail poolOwner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "NonExistentFunction"
            operationData = ""
            contractIds = Map.fromList [(instAddr, toAnyContractId poolCid)]

    pure ()

-- | Test that invalid params returns E_INVALID_PARAMS
testLockReleaseTokenPoolMCMSEntrypoint_InvalidParams : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_InvalidParams = script do
    ccipOwner <- allocateParty "ccip_owner"
    poolOwner <- allocateParty "pool_owner"
    tokenAdmin <- allocateParty "token_admin"

    let instanceId = "pool-invalid-test"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "TEST"

    poolCid <- submit poolOwner do
        createCmd LockReleaseTokenPool with
            instanceId
            ccipOwner
            poolOwner
            instrumentId
            decimals = 18
            remoteChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = CCIP.Context.CCIPContext (TextMap.empty)
            transferTimeout = Indefinite
            deps = dummyPoolDeps ccipOwner

    let instAddr = makeInstanceAddress instanceId poolOwner
    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

  -- Call with invalid operationData - should fail
    submitMustFail poolOwner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "ApplyChainUpdates"
            operationData = "invalid"  -- Not valid encoded data
            contractIds = Map.fromList [(instAddr, toAnyContractId poolCid)]

    pure ()

-- | Test that missing self CID returns E_SELF_CID_NOT_IN_MAP
testLockReleaseTokenPoolMCMSEntrypoint_MissingSelfCid : Script ()
testLockReleaseTokenPoolMCMSEntrypoint_MissingSelfCid = script do
    ccipOwner <- allocateParty "ccip_owner"
    poolOwner <- allocateParty "pool_owner"
    tokenAdmin <- allocateParty "token_admin"

    let instanceId = "pool-missing-cid-test"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId tokenAdmin "TEST"

    poolCid <- submit poolOwner do
        createCmd LockReleaseTokenPool with
            instanceId
            ccipOwner
            poolOwner
            instrumentId
            decimals = 18
            remoteChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = CCIP.Context.CCIPContext (TextMap.empty)
            transferTimeout = Indefinite
            deps = dummyPoolDeps ccipOwner

    let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver poolCid

  -- Encode valid params
    let args = [
            ChainUpdate with
                remoteChainSelector = 123.0
                remotePools = ["1fb477ac89df394bead4f46ad754f8aec70cc0e4", "d7e508a1d4ba82aed19fadcbf6ebd81d2c9b173a"]
                remoteTokenAddress = "cbae4ea0c4c503a582af009bb2b30b75badc1e32"
                inboundCCVs = [RawInstanceAddress "in1@owner", RawInstanceAddress "in2@owner"]
                outboundCCVs = []
                minBlockDepth = 0
                inboundRateLimiter = RawInstanceAddress "rate-limiter-in-new@owner"
                inboundCustomRateLimiter = RawInstanceAddress "rate-limiter-in-custom-new@owner"
                outboundRateLimiter = RawInstanceAddress "rate-limiter-out-new@owner"
            ]

        encoded = encodeApplyChainUpdatesParams ([123.0], args)

  -- Call with empty contractIds map - should fail
    submitMustFail poolOwner do
        exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
            functionName = "ApplyChainUpdates"
            operationData = encoded
            contractIds = Map.empty  -- Missing self CID

    pure ()

-- Helper to convert ContractId to AnyContractId for the map
toAnyContractId : ContractId a -> ContractId ()
toAnyContractId = coerceContractId

-- Assertion helpers

assertChainUpdateEqual : RemoteChainConfig -> ChainUpdate -> Script ()
assertChainUpdateEqual got expected = do
    assertMsg ("remotePools mismatch, got: " <> show got.remotePools <> ", expected: " <> show expected.remotePools) (got.remotePools == expected.remotePools)
    assertMsg ("remoteTokenAddress mismatch, got: " <> show got.remoteTokenAddress <> ", expected: " <> show expected.remoteTokenAddress) (got.remoteTokenAddress == expected.remoteTokenAddress)
    assertMsg ("inboundCCVs mismatch, got: " <> show got.inboundCCVs <> ", expected: " <> show expected.inboundCCVs) (got.inboundCCVs == expected.inboundCCVs)
    assertMsg ("outboundCCVs mismatch, got: " <> show got.outboundCCVs <> ", expected: " <> show expected.outboundCCVs) (got.outboundCCVs == expected.outboundCCVs)
    assertMsg ("inboundRateLimiter mismatch, got: " <> show got.inboundRateLimiter <> ", expected: " <> show expected.inboundRateLimiter) (got.inboundRateLimiter == expected.inboundRateLimiter)
    assertMsg ("outboundRateLimiter mismatch, got: " <> show got.outboundRateLimiter <> ", expected: " <> show expected.outboundRateLimiter) (got.outboundRateLimiter == expected.outboundRateLimiter)

assertRateLimiterConfigArgsEqual : RemoteChainConfig -> RateLimiterConfigArgs -> Script ()
assertRateLimiterConfigArgsEqual got expected = do
    assertMsg ("inboundRateLimiter mismatch, got: " <> show got.inboundRateLimiter <> ", expected: " <> show expected.inboundRateLimiter) (got.inboundRateLimiter == expected.inboundRateLimiter)
    assertMsg ("outboundRateLimiter mismatch, got: " <> show got.outboundRateLimiter <> ", expected: " <> show expected.outboundRateLimiter) (got.outboundRateLimiter == expected.outboundRateLimiter)
