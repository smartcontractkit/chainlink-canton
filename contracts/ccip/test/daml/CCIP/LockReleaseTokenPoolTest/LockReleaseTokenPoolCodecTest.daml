-- | Round-trip tests for LockReleaseTokenPool codec functions
module CCIP.LockReleaseTokenPoolTest.LockReleaseTokenPoolCodecTest where

import Daml.Script
import DA.Assert ((===))
import DA.Map qualified as Map

import CCIP.LockReleaseTokenPoolCodec
import CCIP.LockReleaseTokenPool (ChainPoolConfig(..))
import CCIP.RawInstanceAddress (RawInstanceAddress(..))

-- ===========================================================================
-- CHAIN POOL CONFIG ENCODING/DECODING TESTS
-- ===========================================================================

testUpdateChainPoolConfigsParamsRoundtrip : Script ()
testUpdateChainPoolConfigsParamsRoundtrip = do
  let config1 = ChainPoolConfig with
        inboundCCVs = [RawInstanceAddress "ccv-inbound@party1"]
        outboundCCVs = [RawInstanceAddress "ccv-outbound@party1", RawInstanceAddress "ccv-out2@party2"]
        remotePools = ["1234567890abcdef", "fedcba0987654321"]

      config2 = ChainPoolConfig with
        inboundCCVs = []
        outboundCCVs = [RawInstanceAddress "single-ccv@owner"]
        remotePools = ["deadbeef"]

      configs = Map.fromList [
        (1.0, config1),
        (137.0, config2)
        ]

      encoded = encodeUpdateChainPoolConfigsParams configs

  case decodeUpdateChainPoolConfigsParams encoded of
    None -> abort "Failed to decode UpdateChainPoolConfigs params"
    Some decodedConfigs -> do
      Map.size decodedConfigs === 2

      case Map.lookup 1.0 decodedConfigs of
        None -> abort "Expected config for chain 1"
        Some c -> do
          length c.inboundCCVs === 1
          length c.outboundCCVs === 2
          length c.remotePools === 2

      case Map.lookup 137.0 decodedConfigs of
        None -> abort "Expected config for chain 137"
        Some c -> do
          c.inboundCCVs === []
          length c.outboundCCVs === 1
          length c.remotePools === 1

  pure ()

testUpdateChainPoolConfigsEmptyMap : Script ()
testUpdateChainPoolConfigsEmptyMap = do
  let configs : Map.Map (Numeric 0) ChainPoolConfig = Map.empty
      encoded = encodeUpdateChainPoolConfigsParams configs

  case decodeUpdateChainPoolConfigsParams encoded of
    None -> abort "Failed to decode empty UpdateChainPoolConfigs params"
    Some decodedConfigs ->
      Map.size decodedConfigs === 0

  pure ()

testUpdateChainPoolConfigsSingleEntry : Script ()
testUpdateChainPoolConfigsSingleEntry = do
  let config = ChainPoolConfig with
        inboundCCVs = [RawInstanceAddress "in@p1", RawInstanceAddress "in@p2"]
        outboundCCVs = [RawInstanceAddress "out@p1"]
        remotePools = ["aabb", "ccdd", "eeff"]

      configs = Map.fromList [(42161.0, config)]  -- Arbitrum

      encoded = encodeUpdateChainPoolConfigsParams configs

  case decodeUpdateChainPoolConfigsParams encoded of
    None -> abort "Failed to decode single entry UpdateChainPoolConfigs params"
    Some decodedConfigs -> do
      Map.size decodedConfigs === 1
      case Map.lookup 42161.0 decodedConfigs of
        None -> abort "Expected config for chain 42161"
        Some c -> do
          length c.inboundCCVs === 2
          length c.outboundCCVs === 1
          length c.remotePools === 3

  pure ()

-- ===========================================================================
-- CHAIN POOL CONFIG WITH LARGE CHAIN SELECTOR TESTS
-- ===========================================================================

testUpdateChainPoolConfigsLargeSelector : Script ()
testUpdateChainPoolConfigsLargeSelector = do
  -- Test with CCIP-style large chain selector
  let largeSelector : Numeric 0 = 16015286601757825753.0
      config = ChainPoolConfig with
        inboundCCVs = []
        outboundCCVs = []
        remotePools = ["00112233"]

      configs = Map.fromList [(largeSelector, config)]
      encoded = encodeUpdateChainPoolConfigsParams configs

  case decodeUpdateChainPoolConfigsParams encoded of
    None -> abort "Failed to decode large selector UpdateChainPoolConfigs params"
    Some decodedConfigs -> do
      Map.size decodedConfigs === 1
      case Map.lookup largeSelector decodedConfigs of
        None -> abort "Expected config for large selector"
        Some c -> c.remotePools === ["00112233"]

  pure ()

testUpdateChainPoolConfigsEdgeCases : Script ()
testUpdateChainPoolConfigsEdgeCases = do
  let emptyConfig = ChainPoolConfig [] [] []

  -- Test zero selector
  let zeroSelector : Numeric 0 = 0.0
      zeroConfigs = Map.fromList [(zeroSelector, emptyConfig)]
      encodedZero = encodeUpdateChainPoolConfigsParams zeroConfigs
  case decodeUpdateChainPoolConfigsParams encodedZero of
    None -> abort "Failed to decode zero selector"
    Some decoded -> case Map.lookup zeroSelector decoded of
      None -> abort "Expected config for zero selector"
      Some _ -> pure ()

  -- Test max uint64 selector
  let maxUint64 : Numeric 0 = 18446744073709551615.0
      maxConfigs = Map.fromList [(maxUint64, emptyConfig)]
      encodedMax = encodeUpdateChainPoolConfigsParams maxConfigs
  case decodeUpdateChainPoolConfigsParams encodedMax of
    None -> abort "Failed to decode max uint64 selector"
    Some decoded -> case Map.lookup maxUint64 decoded of
      None -> abort "Expected config for max uint64 selector"
      Some _ -> pure ()

  pure ()

-- ===========================================================================
-- RAW INSTANCE ADDRESS LIST TESTS
-- ===========================================================================

testChainPoolConfigWithManyAddresses : Script ()
testChainPoolConfigWithManyAddresses = do
  let addresses = [
        RawInstanceAddress "ccv1@party1",
        RawInstanceAddress "ccv2@party2",
        RawInstanceAddress "ccv3@party3",
        RawInstanceAddress "ccv4@party4",
        RawInstanceAddress "ccv5@party5"
        ]

      config = ChainPoolConfig with
        inboundCCVs = addresses
        outboundCCVs = addresses
        remotePools = ["aabb01", "ccdd02", "eeff03", "112233", "445566"]

      configs = Map.fromList [(1.0, config)]
      encoded = encodeUpdateChainPoolConfigsParams configs

  case decodeUpdateChainPoolConfigsParams encoded of
    None -> abort "Failed to decode config with many addresses"
    Some decodedConfigs ->
      case Map.lookup 1.0 decodedConfigs of
        None -> abort "Expected config"
        Some c -> do
          length c.inboundCCVs === 5
          length c.outboundCCVs === 5
          length c.remotePools === 5

  pure ()

-- ===========================================================================
-- BYTES HEX LIST (REMOTE POOLS) TESTS
-- ===========================================================================

testRemotePoolsVariousLengths : Script ()
testRemotePoolsVariousLengths = do
  let config = ChainPoolConfig with
        inboundCCVs = []
        outboundCCVs = []
        remotePools = [
          "00",                                  -- 1 byte
          "0011",                                -- 2 bytes
          "001122334455",                        -- 6 bytes
          "00112233445566778899aabbccddeeff",   -- 16 bytes
          "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"  -- 32 bytes
          ]

      configs = Map.fromList [(1.0, config)]
      encoded = encodeUpdateChainPoolConfigsParams configs

  case decodeUpdateChainPoolConfigsParams encoded of
    None -> abort "Failed to decode config with various pool lengths"
    Some decodedConfigs ->
      case Map.lookup 1.0 decodedConfigs of
        None -> abort "Expected config"
        Some c -> do
          length c.remotePools === 5
          -- Verify pools are decoded correctly
          case c.remotePools of
            [p1, p2, p3, p4, p5] -> do
              p1 === "00"
              p2 === "0011"
              p3 === "001122334455"
              p4 === "00112233445566778899aabbccddeeff"
              p5 === "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"
            _ -> abort "Expected 5 remote pools"

  pure ()

-- ===========================================================================
-- INVALID DATA REJECTION TESTS
-- ===========================================================================

testInvalidDataRejection : Script ()
testInvalidDataRejection = do
  -- Empty data should fail
  case decodeUpdateChainPoolConfigsParams "" of
    None -> pure ()  -- Expected
    Some _ -> abort "Expected decodeUpdateChainPoolConfigsParams to fail on empty data"

  -- Truncated count should handle gracefully (0 items)
  case decodeUpdateChainPoolConfigsParams "00" of
    None -> abort "Should decode 0-count as empty map"
    Some configs -> Map.size configs === 0

  pure ()
