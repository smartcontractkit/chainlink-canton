-- | Round-trip tests for LockReleaseTokenPool codec functions
module CCIP.LockReleaseTokenPoolTest.LockReleaseTokenPoolCodecTest where

import Daml.Script
import DA.Assert ((===))
import DA.Foldable

import CCIP.LockReleaseTokenPoolCodec
import CCIP.LockReleaseTokenPoolTypes (ChainUpdate(..), RateLimiterConfigArgs(..))
import CCIP.RawInstanceAddress (RawInstanceAddress(..))

-- ===========================================================================
-- CHAIN UPDATE ENCODING/DECODING TESTS
-- ===========================================================================

testApplyChainUpdatesParamsRoundtrip : Script ()
testApplyChainUpdatesParamsRoundtrip = do
    let args = (
            [2.0, 3.0],  -- remoteChainSelectorsToRemove
            [ 
                ChainUpdate with
                    remoteChainSelector = 1.0
                    remotePools = ["1234567890abcdef", "fedcba0987654321"]
                    remoteTokenAddress = "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"
                    inboundCCVs = [RawInstanceAddress "ccv-inbound@party1", RawInstanceAddress "ccv-inbound2@party2"]
                    outboundCCVs = [RawInstanceAddress "ccv-outbound@party1"]
                    minBlockDepth = 0
                    inboundRateLimiter = RawInstanceAddress "rate-limiter-in@party1"
                    inboundCustomRateLimiter = RawInstanceAddress "rate-limiter-in-custom@party1"
                    outboundRateLimiter = RawInstanceAddress "rate-limiter-out@party1"
                ,ChainUpdate with
                    remoteChainSelector = 18446744073709551615.0 -- max uint64
                    remotePools = []
                    remoteTokenAddress = ""
                    inboundCCVs = []
                    outboundCCVs = []
                    minBlockDepth = 7
                    inboundRateLimiter = RawInstanceAddress "rate-limiter-in@party1"
                    inboundCustomRateLimiter = RawInstanceAddress "rate-limiter-in-custom@party1"
                    outboundRateLimiter = RawInstanceAddress "rate-limiter-out@party1"
                ,ChainUpdate with
                    remoteChainSelector = 0.0
                    remotePools = []
                    remoteTokenAddress = "c44879cc487d6ed2fdda5dfbebace4d430bd3f5a"
                    inboundCCVs = []
                    outboundCCVs = []
                    minBlockDepth = 3
                    inboundRateLimiter = RawInstanceAddress "rate-limiter-in@party1"
                    inboundCustomRateLimiter = RawInstanceAddress "rate-limiter-in-custom@party1"
                    outboundRateLimiter = RawInstanceAddress "rate-limiter-out@party1"
            ]
            )
  
    let encoded = encodeApplyChainUpdatesParams args

    case decodeApplyChainUpdatesParams encoded of
        None -> abort "Failed to decode ApplyChainUpdates params"
        Some (decodedSelectorsToRemove, decodedChainUpdates) -> do
            decodedSelectorsToRemove === fst args
            forA_ (zip decodedChainUpdates (snd args)) $ uncurry assertChainUpdateEqual

-- ===========================================================================
-- RATE LIMITER CONFIG ENCODING/DECODING TESTS
-- ===========================================================================

testRateLimiterConfigArgsRoundtrip : Script ()
testRateLimiterConfigArgsRoundtrip = do
    let args = [
            RateLimiterConfigArgs with
                remoteChainSelector = 1.0
                inboundRateLimiter = RawInstanceAddress "rate-limiter-in@party1"
                inboundCustomRateLimiter = RawInstanceAddress "rate-limiter-in-custom@party1"
                outboundRateLimiter = RawInstanceAddress "rate-limiter-out@party1"
            ,RateLimiterConfigArgs with
                remoteChainSelector = 18446744073709551615.0 -- max uint64
                inboundRateLimiter = RawInstanceAddress "rate-limiter-in@party2"
                inboundCustomRateLimiter = RawInstanceAddress "rate-limiter-in-custom@party2"
                outboundRateLimiter = RawInstanceAddress "rate-limiter-out@party2"
            ,RateLimiterConfigArgs with
                remoteChainSelector = 0.0
                inboundRateLimiter = RawInstanceAddress "rate-limiter-in@party3"
                inboundCustomRateLimiter = RawInstanceAddress "rate-limiter-in-custom@party3"
                outboundRateLimiter = RawInstanceAddress "rate-limiter-out@party3"
            ]
    
    let encoded = encodeUpdateRateLimitersParams args

    case decodeUpdateRateLimitersParams encoded of
        None -> abort "Failed to decode RateLimiterConfigArgs list"
        Some decodedArgs -> do
            forA_ (zip decodedArgs args) $ uncurry assertRateLimiterConfigArgsEqual


-- ===========================================================================
-- INVALID DATA REJECTION TESTS
-- ===========================================================================

testInvalidDataRejection : Script ()
testInvalidDataRejection = do
  -- Empty data should fail
  case decodeApplyChainUpdatesParams "" of
    None -> pure ()  -- Expected
    Some _ -> abort "Expected decodeApplyChainUpdatesParams to fail on empty data"

  pure ()


-- Assertion helpers
assertChainUpdateEqual : ChainUpdate -> ChainUpdate -> Script ()
assertChainUpdateEqual got expected = do
    assertMsg ("remoteChainSelector mismatch, got: " <> show got.remoteChainSelector <> ", expected: " <> show expected.remoteChainSelector) (got.remoteChainSelector == expected.remoteChainSelector)
    assertMsg ("remotePools mismatch, got: " <> show got.remotePools <> ", expected: " <> show expected.remotePools) (got.remotePools == expected.remotePools)
    assertMsg ("remoteTokenAddress mismatch, got: " <> show got.remoteTokenAddress <> ", expected: " <> show expected.remoteTokenAddress) (got.remoteTokenAddress == expected.remoteTokenAddress) 
    assertMsg ("inboundCCVs mismatch, got: " <> show got.inboundCCVs <> ", expected: " <> show expected.inboundCCVs) (got.inboundCCVs == expected.inboundCCVs)
    assertMsg ("outboundCCVs mismatch, got: " <> show got.outboundCCVs <> ", expected: " <> show expected.outboundCCVs) (got.outboundCCVs == expected.outboundCCVs)
    assertMsg ("minBlockDepth mismatch, got: " <> show got.minBlockDepth <> ", expected: " <> show expected.minBlockDepth) (got.minBlockDepth == expected.minBlockDepth)
    assertMsg ("inboundRateLimiter mismatch, got: " <> show got.inboundRateLimiter <> ", expected: " <> show expected.inboundRateLimiter) (got.inboundRateLimiter == expected.inboundRateLimiter)
    assertMsg ("inboundCustomRateLimiter mismatch, got: " <> show got.inboundCustomRateLimiter <> ", expected: " <> show expected.inboundCustomRateLimiter) (got.inboundCustomRateLimiter == expected.inboundCustomRateLimiter)
    assertMsg ("outboundRateLimiter mismatch, got: " <> show got.outboundRateLimiter <> ", expected: " <> show expected.outboundRateLimiter) (got.outboundRateLimiter == expected.outboundRateLimiter)

assertRateLimiterConfigArgsEqual : RateLimiterConfigArgs -> RateLimiterConfigArgs -> Script ()
assertRateLimiterConfigArgsEqual got expected = do
    assertMsg ("remoteChainSelector mismatch, got: " <> show got.remoteChainSelector <> ", expected: " <> show expected.remoteChainSelector) (got.remoteChainSelector == expected.remoteChainSelector)
    assertMsg ("inboundRateLimiter mismatch, got: " <> show got.inboundRateLimiter <> ", expected: " <> show expected.inboundRateLimiter) (got.inboundRateLimiter == expected.inboundRateLimiter)
    assertMsg ("inboundCustomRateLimiter mismatch, got: " <> show got.inboundCustomRateLimiter <> ", expected: " <> show expected.inboundCustomRateLimiter) (got.inboundCustomRateLimiter == expected.inboundCustomRateLimiter)
    assertMsg ("outboundRateLimiter mismatch, got: " <> show got.outboundRateLimiter <> ", expected: " <> show expected.outboundRateLimiter) (got.outboundRateLimiter == expected.outboundRateLimiter)
