-- | Direct choice tests for RMNRemote
module CCIP.RMNTest.RMNRemoteTest where

import Daml.Script
import DA.Assert ((===))

import CCIP.RMNRemote

-- Numeric 0 rendering remains canonical for RMN curse subjects.
testRMNRemote_NumericRenderingIsCanonical : Script ()
testRMNRemote_NumericRenderingIsCanonical = script do
  numeric0IntegerText "test" 0.0 === "0"
  numeric0IntegerText "test" 123456789.0 === "123456789"
  numericToDecimalString 4660.0 === "4660"
  chainSelectorToSubject 4660.0 === "00000000000000000000000000001234"

-- RMN creation rejects redundant custom observers.
testRMNRemote_RejectsRedundantCustomObservers : Script ()
testRMNRemote_RejectsRedundantCustomObservers = script do
  rmnOwner <- allocateParty "rmn_owner"
  ccipOwner <- allocateParty "ccip_owner"
  observer <- allocateParty "observer"

  submitMustFail rmnOwner do
    createCmd RMNRemote with
      instanceId = "rmn-dup-observer-test"
      rmnOwner
      ccipOwner
      customObservers = [observer, observer]
      cursedSubjects = []

  submitMustFail rmnOwner do
    createCmd RMNRemote with
      instanceId = "rmn-owner-observer-test"
      rmnOwner
      ccipOwner
      customObservers = [rmnOwner]
      cursedSubjects = []

  submitMustFail rmnOwner do
    createCmd RMNRemote with
      instanceId = "rmn-ccip-observer-test"
      rmnOwner
      ccipOwner
      customObservers = [ccipOwner]
      cursedSubjects = []

-- ===========================================================================
-- UNCURSE MULTIPLE VALIDATION TESTS
-- ===========================================================================

-- | UncurseMultiple rejects duplicate subjects in the input list
testRMNRemote_UncurseMultipleRejectsDuplicateSubjects : Script ()
testRMNRemote_UncurseMultipleRejectsDuplicateSubjects = script do
  rmnOwner <- allocateParty "rmn_owner"
  ccipOwner <- allocateParty "ccip_owner"

  let subject = "01000000000000000000000000000001"

  rmnCid <- submit rmnOwner do
    createCmd RMNRemote with
      instanceId = "rmn-uncurse-dup-test"
      rmnOwner
      ccipOwner
      customObservers = []
      cursedSubjects = [subject]

  submitMustFail rmnOwner do
    exerciseCmd rmnCid UncurseMultiple with
      subjects = [subject, subject]

  pure ()

-- | UncurseMultiple rejects subjects that are not currently cursed
testRMNRemote_UncurseMultipleRejectsNotCursedSubject : Script ()
testRMNRemote_UncurseMultipleRejectsNotCursedSubject = script do
  rmnOwner <- allocateParty "rmn_owner"
  ccipOwner <- allocateParty "ccip_owner"

  let cursedSubject = "01000000000000000000000000000001"
      notCursedSubject = "00000000000000000000000000000089"

  rmnCid <- submit rmnOwner do
    createCmd RMNRemote with
      instanceId = "rmn-uncurse-not-cursed-test"
      rmnOwner
      ccipOwner
      customObservers = []
      cursedSubjects = [cursedSubject]

  submitMustFail rmnOwner do
    exerciseCmd rmnCid UncurseMultiple with
      subjects = [cursedSubject, notCursedSubject]

  pure ()

-- | UncurseMultiple succeeds with valid, currently-cursed subjects
testRMNRemote_UncurseMultipleSucceeds : Script ()
testRMNRemote_UncurseMultipleSucceeds = script do
  rmnOwner <- allocateParty "rmn_owner"
  ccipOwner <- allocateParty "ccip_owner"

  let subject1 = "01000000000000000000000000000001"
      subject2 = "00000000000000000000000000000089"

  rmnCid <- submit rmnOwner do
    createCmd RMNRemote with
      instanceId = "rmn-uncurse-success-test"
      rmnOwner
      ccipOwner
      customObservers = []
      cursedSubjects = [subject1, subject2]

  rmnCid' <- submit rmnOwner do
    exerciseCmd rmnCid UncurseMultiple with
      subjects = [subject1, subject2]

  rmn <- queryContractId rmnOwner rmnCid'
  case rmn of
    None -> abort "Contract not found"
    Some r -> r.cursedSubjects === []

-- | UncurseMultiple rejects empty-looking valid call when subject not cursed
testRMNRemote_UncurseMultipleRejectsAllNotCursed : Script ()
testRMNRemote_UncurseMultipleRejectsAllNotCursed = script do
  rmnOwner <- allocateParty "rmn_owner"
  ccipOwner <- allocateParty "ccip_owner"

  rmnCid <- submit rmnOwner do
    createCmd RMNRemote with
      instanceId = "rmn-uncurse-none-cursed-test"
      rmnOwner
      ccipOwner
      customObservers = []
      cursedSubjects = []

  submitMustFail rmnOwner do
    exerciseCmd rmnCid UncurseMultiple with
      subjects = ["01000000000000000000000000000001"]

  pure ()

-- ===========================================================================
-- CURSE SUBJECT COLLISION TESTS
-- ===========================================================================
-- The chain-selector-to-subject conversion produces
-- bytes16(uint128(chainSelector)), and selector 1329227995784915872903807060280344577
-- maps exactly to globalCurseSubject. The CurseChain/UncurseChain/IsCursedForChain
-- paths must reject this selector so per-chain curse state cannot collide with
-- the global curse subject.

collidingChainSelector : Numeric 0
collidingChainSelector = 1329227995784915872903807060280344577.0

-- | CurseChain rejects the selector whose subject aliases globalCurseSubject.
testRMNRemote_CurseChainRejectsGlobalCollision : Script ()
testRMNRemote_CurseChainRejectsGlobalCollision = script do
  rmnOwner <- allocateParty "rmn_owner"
  ccipOwner <- allocateParty "ccip_owner"

  rmnCid <- submit rmnOwner do
    createCmd RMNRemote with
      instanceId = "rmn-curse-collision-test"
      rmnOwner
      ccipOwner
      customObservers = []
      cursedSubjects = []

  submitMustFail rmnOwner do
    exerciseCmd rmnCid CurseChain with
      chainSelector = collidingChainSelector

  pure ()

-- | UncurseChain rejects the colliding selector even if its subject happens to be present.
testRMNRemote_UncurseChainRejectsGlobalCollision : Script ()
testRMNRemote_UncurseChainRejectsGlobalCollision = script do
  rmnOwner <- allocateParty "rmn_owner"
  ccipOwner <- allocateParty "ccip_owner"

  rmnCid <- submit rmnOwner do
    createCmd RMNRemote with
      instanceId = "rmn-uncurse-collision-test"
      rmnOwner
      ccipOwner
      customObservers = []
      cursedSubjects = [globalCurseSubject]

  submitMustFail rmnOwner do
    exerciseCmd rmnCid UncurseChain with
      chainSelector = collidingChainSelector

  pure ()

-- | IsCursedForChain rejects the colliding selector rather than silently conflating
-- global curse status with a per-chain query.
testRMNRemote_IsCursedForChainRejectsGlobalCollision : Script ()
testRMNRemote_IsCursedForChainRejectsGlobalCollision = script do
  rmnOwner <- allocateParty "rmn_owner"
  ccipOwner <- allocateParty "ccip_owner"

  rmnCid <- submit rmnOwner do
    createCmd RMNRemote with
      instanceId = "rmn-iscursed-collision-test"
      rmnOwner
      ccipOwner
      customObservers = []
      cursedSubjects = []

  submitMustFail rmnOwner do
    exerciseCmd rmnCid IsCursedForChain with
      caller = rmnOwner
      chainSelector = collidingChainSelector

  pure ()
