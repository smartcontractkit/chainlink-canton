-- | Round-trip tests for RMNRemote codec functions
module CCIP.RMNTest.RMNRemoteCodecTest where

import Daml.Script
import DA.Assert ((===))

import CCIP.RMNRemoteCodec

-- ===========================================================================
-- CURSE PARAMS ENCODING/DECODING TESTS
-- ===========================================================================

testCurseParamsRoundtrip : Script ()
testCurseParamsRoundtrip = do
  -- Test with global curse subject
  let globalSubject = "01000000000000000000000000000001"
      encoded = encodeCurseParams globalSubject

  case decodeCurseParams encoded of
    None -> abort "Failed to decode Curse params"
    Some decoded -> decoded === globalSubject

  -- Test with chain-specific subject
  let chainSubject = "00000000000000000000000000000089"  -- Chain 137
      encodedChain = encodeCurseParams chainSubject

  case decodeCurseParams encodedChain of
    None -> abort "Failed to decode chain Curse params"
    Some decoded -> decoded === chainSubject

  pure ()

testUncurseParamsRoundtrip : Script ()
testUncurseParamsRoundtrip = do
  let subject = "01000000000000000000000000000001"
      encoded = encodeUncurseParams subject

  case decodeUncurseParams encoded of
    None -> abort "Failed to decode Uncurse params"
    Some decoded -> decoded === subject

  pure ()

-- ===========================================================================
-- CURSE CHAIN PARAMS ENCODING/DECODING TESTS
-- ===========================================================================

testCurseChainParamsRoundtrip : Script ()
testCurseChainParamsRoundtrip = do
  -- Test with chain selector 1 (Ethereum mainnet)
  let chainSelector1 : Numeric 0 = 1.0
      encoded1 = encodeCurseChainParams chainSelector1

  case decodeCurseChainParams encoded1 of
    None -> abort "Failed to decode CurseChain params for chain 1"
    Some decoded -> decoded === chainSelector1

  -- Test with larger chain selector (137 = Polygon)
  let chainSelector137 : Numeric 0 = 137.0
      encoded137 = encodeCurseChainParams chainSelector137

  case decodeCurseChainParams encoded137 of
    None -> abort "Failed to decode CurseChain params for chain 137"
    Some decoded -> decoded === chainSelector137

  -- Test with very large chain selector
  let largeSelector : Numeric 0 = 16015286601757825753.0  -- Avalanche Fuji testnet selector
      encodedLarge = encodeCurseChainParams largeSelector

  case decodeCurseChainParams encodedLarge of
    None -> abort "Failed to decode CurseChain params for large selector"
    Some decoded -> decoded === largeSelector

  -- Test zero selector
  let zeroSelector : Numeric 0 = 0.0
      encodedZero = encodeCurseChainParams zeroSelector
  case decodeCurseChainParams encodedZero of
    None -> abort "Failed to decode CurseChain params for zero selector"
    Some decoded -> decoded === zeroSelector

  -- Test max uint64 selector
  let maxUint64 : Numeric 0 = 18446744073709551615.0
      encodedMax = encodeCurseChainParams maxUint64
  case decodeCurseChainParams encodedMax of
    None -> abort "Failed to decode CurseChain params for max uint64 selector"
    Some decoded -> decoded === maxUint64

  pure ()

testUncurseChainParamsRoundtrip : Script ()
testUncurseChainParamsRoundtrip = do
  let chainSelector : Numeric 0 = 42161.0  -- Arbitrum One
      encoded = encodeUncurseChainParams chainSelector

  case decodeUncurseChainParams encoded of
    None -> abort "Failed to decode UncurseChain params"
    Some decoded -> decoded === chainSelector

  pure ()

-- ===========================================================================
-- CURSE MULTIPLE PARAMS ENCODING/DECODING TESTS
-- ===========================================================================

testCurseMultipleParamsRoundtrip : Script ()
testCurseMultipleParamsRoundtrip = do
  let subjects = [
        "01000000000000000000000000000001",  -- Global
        "00000000000000000000000000000001",  -- Chain 1
        "00000000000000000000000000000089"   -- Chain 137
        ]
      encoded = encodeCurseMultipleParams subjects

  case decodeCurseMultipleParams encoded of
    None -> abort "Failed to decode CurseMultiple params"
    Some decoded -> do
      length decoded === 3
      decoded === subjects

  pure ()

testCurseMultipleParamsEmptyList : Script ()
testCurseMultipleParamsEmptyList = do
  let subjects : [Text] = []
      encoded = encodeCurseMultipleParams subjects

  case decodeCurseMultipleParams encoded of
    None -> abort "Failed to decode empty CurseMultiple params"
    Some decoded -> decoded === []

  pure ()

testUncurseMultipleParamsRoundtrip : Script ()
testUncurseMultipleParamsRoundtrip = do
  let subjects = [
        "00000000000000000000000000000001",
        "00000000000000000000000000000002"
        ]
      encoded = encodeUncurseMultipleParams subjects

  case decodeUncurseMultipleParams encoded of
    None -> abort "Failed to decode UncurseMultiple params"
    Some decoded -> decoded === subjects

  pure ()

-- ===========================================================================
-- ADD/REMOVE CUSTOM OBSERVERS PARAMS ENCODING/DECODING TESTS
-- ===========================================================================

testAddCustomObserversParamsRoundtrip : Script ()
testAddCustomObserversParamsRoundtrip = do
  party1 <- allocateParty "Observer1"
  party2 <- allocateParty "Observer2"
  party3 <- allocateParty "Observer3"

  let parties = [party1, party2, party3]
      encoded = encodeAddCustomObserversParams parties

  case decodeAddCustomObserversParams encoded of
    None -> abort "Failed to decode AddCustomObservers params"
    Some decoded -> do
      length decoded === 3
      decoded === parties

  pure ()

testAddCustomObserversParamsEmptyList : Script ()
testAddCustomObserversParamsEmptyList = do
  let parties : [Party] = []
      encoded = encodeAddCustomObserversParams parties

  case decodeAddCustomObserversParams encoded of
    None -> abort "Failed to decode empty AddCustomObservers params"
    Some decoded -> decoded === []

  pure ()

testRemoveCustomObserversParamsRoundtrip : Script ()
testRemoveCustomObserversParamsRoundtrip = do
  party1 <- allocateParty "Observer1"
  party2 <- allocateParty "Observer2"

  let parties = [party1, party2]
      encoded = encodeRemoveCustomObserversParams parties

  case decodeRemoveCustomObserversParams encoded of
    None -> abort "Failed to decode RemoveCustomObservers params"
    Some decoded -> decoded === parties

  pure ()

-- ===========================================================================
-- INVALID DATA REJECTION TESTS
-- ===========================================================================

testInvalidDataRejection : Script ()
testInvalidDataRejection = do
  -- Empty data should fail for curse params
  case decodeCurseParams "" of
    None -> pure ()  -- Expected
    Some _ -> abort "Expected decodeCurseParams to fail on empty data"

  -- Truncated chain selector should fail
  case decodeCurseChainParams "0001" of
    None -> pure ()  -- Expected - need 8 bytes
    Some _ -> abort "Expected decodeCurseChainParams to fail on truncated data"

  pure ()
