-- | Round-trip tests for RMNRemote codec functions
module CCIP.RMNTest.RMNRemoteCodecTest where

import Daml.Script
import DA.Assert ((===))
import DA.Optional (fromSome)

import qualified CCIP.CoreV2.RMNRemote
import qualified CCIP.CoreV2.RMNRemoteCodecGen

-- ===========================================================================
-- CURSE PARAMS ENCODING/DECODING TESTS
-- ===========================================================================

testCurseParamsRoundtrip : Script ()
testCurseParamsRoundtrip = do
  -- Test with global curse subject
  let globalSubject = "01000000000000000000000000000001"
      params = CCIP.CoreV2.RMNRemote.CurseParams with subject = globalSubject
      encoded = CCIP.CoreV2.RMNRemoteCodecGen.encodeCurseParams params
  fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeCurseParamsAt encoded 0)) === params

  -- Test with chain-specific subject
  let chainSubject = "00000000000000000000000000000089"  -- Chain 137
      params2 = CCIP.CoreV2.RMNRemote.CurseParams with subject = chainSubject
      encodedChain = CCIP.CoreV2.RMNRemoteCodecGen.encodeCurseParams params2
  fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeCurseParamsAt encodedChain 0)) === params2

  pure ()

testUncurseParamsRoundtrip : Script ()
testUncurseParamsRoundtrip = do
  let subject = "01000000000000000000000000000001"
      params = CCIP.CoreV2.RMNRemote.UncurseParams with subject
      encoded = CCIP.CoreV2.RMNRemoteCodecGen.encodeUncurseParams params
  fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeUncurseParamsAt encoded 0)) === params

  pure ()

-- ===========================================================================
-- CURSE CHAIN PARAMS ENCODING/DECODING TESTS
-- ===========================================================================

testCurseChainParamsRoundtrip : Script ()
testCurseChainParamsRoundtrip = do
  -- Test with chain selector 1 (Ethereum mainnet)
  let chainSelector1 : Numeric 0 = 1.0
      params1 = CCIP.CoreV2.RMNRemote.CurseChainParams with chainSelector = chainSelector1
      encoded1 = CCIP.CoreV2.RMNRemoteCodecGen.encodeCurseChainParams params1
  fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeCurseChainParamsAt encoded1 0)) === params1

  -- Test with larger chain selector (137 = Polygon)
  let chainSelector137 : Numeric 0 = 137.0
      params137 = CCIP.CoreV2.RMNRemote.CurseChainParams with chainSelector = chainSelector137
      encoded137 = CCIP.CoreV2.RMNRemoteCodecGen.encodeCurseChainParams params137
  fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeCurseChainParamsAt encoded137 0)) === params137

  -- Test with very large chain selector
  let largeSelector : Numeric 0 = 16015286601757825753.0  -- Avalanche Fuji testnet selector
      paramsLarge = CCIP.CoreV2.RMNRemote.CurseChainParams with chainSelector = largeSelector
      encodedLarge = CCIP.CoreV2.RMNRemoteCodecGen.encodeCurseChainParams paramsLarge
  fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeCurseChainParamsAt encodedLarge 0)) === paramsLarge

  -- Test zero selector
  let zeroSelector : Numeric 0 = 0.0
      paramsZero = CCIP.CoreV2.RMNRemote.CurseChainParams with chainSelector = zeroSelector
      encodedZero = CCIP.CoreV2.RMNRemoteCodecGen.encodeCurseChainParams paramsZero
  fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeCurseChainParamsAt encodedZero 0)) === paramsZero

  -- Test max uint64 selector
  let maxUint64 : Numeric 0 = 18446744073709551615.0
      paramsMax = CCIP.CoreV2.RMNRemote.CurseChainParams with chainSelector = maxUint64
      encodedMax = CCIP.CoreV2.RMNRemoteCodecGen.encodeCurseChainParams paramsMax
  fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeCurseChainParamsAt encodedMax 0)) === paramsMax

  pure ()

testUncurseChainParamsRoundtrip : Script ()
testUncurseChainParamsRoundtrip = do
  let chainSelector : Numeric 0 = 42161.0  -- Arbitrum One
      params = CCIP.CoreV2.RMNRemote.UncurseChainParams with chainSelector
      encoded = CCIP.CoreV2.RMNRemoteCodecGen.encodeUncurseChainParams params
  fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeUncurseChainParamsAt encoded 0)) === params

  pure ()

-- ===========================================================================
-- CURSE MULTIPLE PARAMS ENCODING/DECODING TESTS
-- ===========================================================================

testCurseMultipleParamsRoundtrip : Script ()
testCurseMultipleParamsRoundtrip = do
  let subjects = [
        "01000000000000000000000000000001",  -- Global
        "00000000000000000000000000000001",  -- Chain 1
        "00000000000000000000000000000089"   -- Chain 137
        ]
      params = CCIP.CoreV2.RMNRemote.CurseMultipleParams with subjects
      encoded = CCIP.CoreV2.RMNRemoteCodecGen.encodeCurseMultipleParams params
      decoded = fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeCurseMultipleParamsAt encoded 0))
  length decoded.subjects === 3
  decoded === params

  pure ()

testCurseMultipleParamsEmptyList : Script ()
testCurseMultipleParamsEmptyList = do
  let params = CCIP.CoreV2.RMNRemote.CurseMultipleParams with subjects = []
      encoded = CCIP.CoreV2.RMNRemoteCodecGen.encodeCurseMultipleParams params
  fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeCurseMultipleParamsAt encoded 0)) === params

  pure ()

testUncurseMultipleParamsRoundtrip : Script ()
testUncurseMultipleParamsRoundtrip = do
  let subjects = [
        "00000000000000000000000000000001",
        "00000000000000000000000000000002"
        ]
      params = CCIP.CoreV2.RMNRemote.UncurseMultipleParams with subjects
      encoded = CCIP.CoreV2.RMNRemoteCodecGen.encodeUncurseMultipleParams params
  fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeUncurseMultipleParamsAt encoded 0)) === params

  pure ()

-- ===========================================================================
-- ADD/REMOVE CUSTOM OBSERVERS PARAMS ENCODING/DECODING TESTS
-- ===========================================================================

testAddCustomObserversParamsRoundtrip : Script ()
testAddCustomObserversParamsRoundtrip = do
  party1 <- allocateParty "Observer1"
  party2 <- allocateParty "Observer2"
  party3 <- allocateParty "Observer3"

  let parties = [party1, party2, party3]
      params = CCIP.CoreV2.RMNRemote.AddCustomObserversParams with parties
      encoded = CCIP.CoreV2.RMNRemoteCodecGen.encodeAddCustomObserversParams params
      decoded = fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeAddCustomObserversParamsAt encoded 0))
  length decoded.parties === 3
  decoded === params

  pure ()

testAddCustomObserversParamsEmptyList : Script ()
testAddCustomObserversParamsEmptyList = do
  let params = CCIP.CoreV2.RMNRemote.AddCustomObserversParams with parties = []
      encoded = CCIP.CoreV2.RMNRemoteCodecGen.encodeAddCustomObserversParams params
  fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeAddCustomObserversParamsAt encoded 0)) === params

  pure ()

testRemoveCustomObserversParamsRoundtrip : Script ()
testRemoveCustomObserversParamsRoundtrip = do
  party1 <- allocateParty "Observer1"
  party2 <- allocateParty "Observer2"

  let parties = [party1, party2]
      params = CCIP.CoreV2.RMNRemote.RemoveCustomObserversParams with parties
      encoded = CCIP.CoreV2.RMNRemoteCodecGen.encodeRemoveCustomObserversParams params
  fst (fromSome (CCIP.CoreV2.RMNRemoteCodecGen.decodeRemoveCustomObserversParamsAt encoded 0)) === params

  pure ()

-- ===========================================================================
-- INVALID DATA REJECTION TESTS
-- ===========================================================================

testInvalidDataRejection : Script ()
testInvalidDataRejection = do
  -- Empty data should fail for curse params
  case CCIP.CoreV2.RMNRemoteCodecGen.decodeCurseParamsAt "" 0 of
    None -> pure ()  -- Expected
    Some _ -> abort "Expected decodeCurseParamsAt to fail on empty data"

  -- Truncated chain selector should fail
  case CCIP.CoreV2.RMNRemoteCodecGen.decodeCurseChainParamsAt "0001" 0 of
    None -> pure ()  -- Expected - need 8 bytes
    Some _ -> abort "Expected decodeCurseChainParamsAt to fail on truncated data"

  pure ()
