-- | Test MCMSReceiver entrypoint for CurseMultiple function
testRMNRemoteMCMSEntrypoint_CurseMultiple : Script ()
testRMNRemoteMCMSEntrypoint_CurseMultiple = script do
  rmnOwner <- allocateParty "rmn_owner"
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "rmn-cursemultiple-test"
      subjects = [
        "01000000000000000000000000000001",  -- Global
        "00000000000000000000000000000001",  -- Chain 1
        "00000000000000000000000000000089"   -- Chain 137
        ]

  -- Create RMNRemote
  rmnCid <- submit rmnOwner do
    createCmd RMNRemote with
      instanceId
      rmnOwner
      ccipOwner
      customObservers = []
      cursedSubjects = []

  let instAddr = RawInstanceAddress.makeText instanceId rmnOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver rmnCid

  -- Encode CurseMultiple params
  let encoded = encodeCurseMultipleParams subjects

  -- Call mcmsEntrypoint
  newContractIds <- submit rmnOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "CurseMultiple"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId rmnCid)]

  -- Verify all subjects were cursed
  contracts <- query @RMNRemote rmnOwner
  case filter (\(_, rmn) -> rmn.instanceId == instanceId) contracts of
    [(_, rmn)] -> length rmn.cursedSubjects === 3
    _ -> abort "Expected exactly one RMNRemote contract"

  pure ()

