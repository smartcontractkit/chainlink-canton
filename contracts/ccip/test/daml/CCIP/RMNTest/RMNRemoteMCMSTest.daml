-- | MCMS entrypoint tests for RMNRemote
-- Tests the MCMSReceiver interface implementation by calling mcmsEntrypoint directly
module CCIP.RMNTest.RMNRemoteMCMSTest where

import Daml.Script
import DA.Assert ((===))
import DA.Map qualified as Map

import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiver_Entrypoint(..))
import MCMS.RawInstanceAddress qualified as RawInstanceAddress
import CCIP.RMNRemote
import CCIP.RMNRemoteCodec

-- ===========================================================================
-- MCMS ENTRYPOINT TESTS - CURSE
-- ===========================================================================

-- | Test MCMSReceiver entrypoint for Curse function
testRMNRemoteMCMSEntrypoint_Curse : Script ()
testRMNRemoteMCMSEntrypoint_Curse = script do
  rmnOwner <- allocateParty "rmn_owner"
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "rmn-test"
      globalSubject = "01000000000000000000000000000001"

  -- Create RMNRemote with no cursed subjects
  rmnCid <- submit rmnOwner do
    createCmd RMNRemote with
      instanceId
      rmnOwner
      ccipOwner
      customObservers = []
      cursedSubjects = []

  let instAddr = RawInstanceAddress.makeText instanceId rmnOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver rmnCid

  -- Encode Curse params
  let encoded = encodeCurseParams globalSubject

  -- Call mcmsEntrypoint
  newContractIds <- submit rmnOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "Curse"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId rmnCid)]

  -- Verify subject was cursed
  contracts <- query @RMNRemote rmnOwner
  case filter (\(_, rmn) -> rmn.instanceId == instanceId) contracts of
    [(_, rmn)] -> do
      length rmn.cursedSubjects === 1
      (globalSubject `elem` rmn.cursedSubjects) === True
    _ -> abort "Expected exactly one RMNRemote contract"

  pure ()

-- | Test MCMSReceiver entrypoint for Uncurse function
testRMNRemoteMCMSEntrypoint_Uncurse : Script ()
testRMNRemoteMCMSEntrypoint_Uncurse = script do
  rmnOwner <- allocateParty "rmn_owner"
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "rmn-uncurse-test"
      subject = "01000000000000000000000000000001"

  -- Create RMNRemote with subject already cursed
  rmnCid <- submit rmnOwner do
    createCmd RMNRemote with
      instanceId
      rmnOwner
      ccipOwner
      customObservers = []
      cursedSubjects = [subject]

  let instAddr = RawInstanceAddress.makeText instanceId rmnOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver rmnCid

  -- Encode Uncurse params
  let encoded = encodeUncurseParams subject

  -- Call mcmsEntrypoint
  newContractIds <- submit rmnOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "Uncurse"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId rmnCid)]

  -- Verify subject was uncursed
  contracts <- query @RMNRemote rmnOwner
  case filter (\(_, rmn) -> rmn.instanceId == instanceId) contracts of
    [(_, rmn)] -> rmn.cursedSubjects === []
    _ -> abort "Expected exactly one RMNRemote contract"

  pure ()

-- ===========================================================================
-- MCMS ENTRYPOINT TESTS - CURSE CHAIN
-- ===========================================================================

-- | Test MCMSReceiver entrypoint for CurseChain function
testRMNRemoteMCMSEntrypoint_CurseChain : Script ()
testRMNRemoteMCMSEntrypoint_CurseChain = script do
  rmnOwner <- allocateParty "rmn_owner"
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "rmn-cursechain-test"
      chainSelector : Numeric 0 = 137.0

  -- Create RMNRemote
  rmnCid <- submit rmnOwner do
    createCmd RMNRemote with
      instanceId
      rmnOwner
      ccipOwner
      customObservers = []
      cursedSubjects = []

  let instAddr = RawInstanceAddress.makeText instanceId rmnOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver rmnCid

  -- Encode CurseChain params
  let encoded = encodeCurseChainParams chainSelector

  -- Call mcmsEntrypoint
  newContractIds <- submit rmnOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "CurseChain"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId rmnCid)]

  -- Verify chain was cursed
  contracts <- query @RMNRemote rmnOwner
  case filter (\(_, rmn) -> rmn.instanceId == instanceId) contracts of
    [(newCid, rmn)] -> do
      length rmn.cursedSubjects === 1
      -- Verify IsCursedForChain returns True
      isCursed <- submit rmnOwner do
        exerciseCmd newCid IsCursedForChain with
          caller = rmnOwner
          chainSelector = chainSelector
      isCursed === True
    _ -> abort "Expected exactly one RMNRemote contract"

  pure ()

-- | Test MCMSReceiver entrypoint for UncurseChain function
