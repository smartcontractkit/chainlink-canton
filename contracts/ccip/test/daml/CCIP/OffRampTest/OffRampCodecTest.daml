-- | Round-trip tests for OffRamp codec functions
module CCIP.OffRampTest.OffRampCodecTest where

import Daml.Script
import DA.Assert ((===))

import qualified Chainlink.InstanceAddress

import qualified CCIP.RuntimeV1.OffRamp
import qualified CCIP.RuntimeV1.OffRampCodecGen

-- ===========================================================================
-- SETDEPSPARAMS ENCODING/DECODING TESTS (Optional fields)
-- ===========================================================================

testSetDepsParamsRoundtrip_AllSome : Script ()
testSetDepsParamsRoundtrip_AllSome = do
  let params = CCIP.RuntimeV1.OffRamp.SetDepsParams with
        globalConfig = Some (Chainlink.InstanceAddress.RawInstanceAddress "gc-instance@party::namespace")
        rmnRemote = Some (Chainlink.InstanceAddress.RawInstanceAddress "rmn-instance@another-party")
        tokenAdminRegistry = Some (Chainlink.InstanceAddress.RawInstanceAddress "tar-instance@yet-another")

      encoded = CCIP.RuntimeV1.OffRampCodecGen.encodeSetDepsParams params

  case fst <$> CCIP.RuntimeV1.OffRampCodecGen.decodeSetDepsParamsAt encoded 0 of
    None -> abort "Failed to decode SetDepsParams (all Some)"
    Some decoded -> decoded === params

  pure ()

testSetDepsParamsRoundtrip_AllNone : Script ()
testSetDepsParamsRoundtrip_AllNone = do
  let params = CCIP.RuntimeV1.OffRamp.SetDepsParams with
        globalConfig = None
        rmnRemote = None
        tokenAdminRegistry = None

      encoded = CCIP.RuntimeV1.OffRampCodecGen.encodeSetDepsParams params

  case fst <$> CCIP.RuntimeV1.OffRampCodecGen.decodeSetDepsParamsAt encoded 0 of
    None -> abort "Failed to decode SetDepsParams (all None)"
    Some decoded -> decoded === params

  pure ()

testSetDepsParamsRoundtrip_Mixed : Script ()
testSetDepsParamsRoundtrip_Mixed = do
  let params = CCIP.RuntimeV1.OffRamp.SetDepsParams with
        globalConfig = Some (Chainlink.InstanceAddress.RawInstanceAddress "gc@owner")
        rmnRemote = None
        tokenAdminRegistry = Some (Chainlink.InstanceAddress.RawInstanceAddress "tar@owner")

      encoded = CCIP.RuntimeV1.OffRampCodecGen.encodeSetDepsParams params

  case fst <$> CCIP.RuntimeV1.OffRampCodecGen.decodeSetDepsParamsAt encoded 0 of
    None -> abort "Failed to decode SetDepsParams (mixed)"
    Some decoded -> decoded === params

  pure ()

-- ===========================================================================
-- OFFRAMP DEPS ENCODING/DECODING TESTS (full, non-optional)
-- ===========================================================================

testOffRampDepsRoundtrip : Script ()
testOffRampDepsRoundtrip = do
  let deps = CCIP.RuntimeV1.OffRamp.OffRampDeps with
        globalConfig = Chainlink.InstanceAddress.RawInstanceAddress "globalconfig@ccip_owner"
        rmnRemote = Chainlink.InstanceAddress.RawInstanceAddress "rmnremote@ccip_owner"
        tokenAdminRegistry = Chainlink.InstanceAddress.RawInstanceAddress "tar@ccip_owner"

      encoded = CCIP.RuntimeV1.OffRampCodecGen.encodeOffRampDeps deps

  case CCIP.RuntimeV1.OffRampCodecGen.decodeOffRampDepsAt encoded 0 of
    None -> abort "Failed to decode OffRampDeps"
    Some (decoded, _) -> do
      decoded.globalConfig === deps.globalConfig
      decoded.rmnRemote === deps.rmnRemote
      decoded.tokenAdminRegistry === deps.tokenAdminRegistry

  pure ()

testOffRampDepsSpecialCharacters : Script ()
testOffRampDepsSpecialCharacters = do
  let deps = CCIP.RuntimeV1.OffRamp.OffRampDeps with
        globalConfig = Chainlink.InstanceAddress.RawInstanceAddress "config-with-dashes@party1::namespace1"
        rmnRemote = Chainlink.InstanceAddress.RawInstanceAddress "rmn_with_underscores@party2::namespace2"
        tokenAdminRegistry = Chainlink.InstanceAddress.RawInstanceAddress "tar.with.dots@party3"

      encoded = CCIP.RuntimeV1.OffRampCodecGen.encodeOffRampDeps deps

  case CCIP.RuntimeV1.OffRampCodecGen.decodeOffRampDepsAt encoded 0 of
    None -> abort "Failed to decode OffRampDeps with special characters"
    Some (decoded, _) -> do
      decoded.globalConfig === deps.globalConfig
      decoded.rmnRemote === deps.rmnRemote
      decoded.tokenAdminRegistry === deps.tokenAdminRegistry

  pure ()

-- ===========================================================================
-- INVALID DATA REJECTION TESTS
-- ===========================================================================

testInvalidDataRejection : Script ()
testInvalidDataRejection = do
  case CCIP.RuntimeV1.OffRampCodecGen.decodeSetDepsParamsAt "" 0 of
    None -> pure ()
    Some _ -> abort "Expected decodeSetDepsParamsAt to fail on empty data"

  case CCIP.RuntimeV1.OffRampCodecGen.decodeSetDepsParamsAt "ff" 0 of
    None -> pure ()
    Some _ -> abort "Expected decodeSetDepsParamsAt to fail on invalid tag"

  pure ()
