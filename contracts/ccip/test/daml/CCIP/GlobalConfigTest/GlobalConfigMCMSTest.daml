-- | MCMS entrypoint tests for GlobalConfig
-- Tests the MCMSReceiver interface implementation by calling mcmsEntrypoint directly
module CCIP.GlobalConfigTest.GlobalConfigMCMSTest where

import Daml.Script
import DA.Assert ((===))
import DA.Map qualified as Map

import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiver_Entrypoint(..), makeInstanceAddress)
import CCIP.GlobalConfig
import CCIP.GlobalConfigCodec
import CCIP.GlobalConfigTypes (DestChainConfig(..), SourceChainConfig(..))
import CCIP.RawInstanceAddress (RawInstanceAddress(..))

-- ===========================================================================
-- MCMS ENTRYPOINT TESTS - UPDATE DEST CHAIN CONFIG
-- ===========================================================================

-- | Test MCMSReceiver entrypoint for UpdateDestChainConfig function
testGlobalConfigMCMSEntrypoint_UpdateDestChainConfig : Script ()
testGlobalConfigMCMSEntrypoint_UpdateDestChainConfig = script do
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "globalconfig-test"
      chainSelector : Numeric 0 = 1.0

  -- Create GlobalConfig with no dest chain configs
  gcCid <- submit ccipOwner do
    createCmd GlobalConfig with
      instanceId
      ccipOwner
      chainSelector = 42161.0  -- Local chain
      onRampAddress = "1234"
      destChainConfigs = Map.empty
      sourceChainConfigs = Map.empty

  let instAddr = makeInstanceAddress instanceId ccipOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver gcCid

  -- Create dest chain config
  let destConfig = DestChainConfig with
        isEnabled = True
        offRampAddress = "abcdef1234567890"
        laneMandatedCCVs = [RawInstanceAddress "ccv@owner"]
        defaultCCVs = []
        messageNetworkFeeUSDCents = 10.0
        tokenNetworkFeeUSDCents = 5.0

      encoded = encodeUpdateDestChainConfigParams 1.0 destConfig

  -- Call mcmsEntrypoint
  newContractIds <- submit ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "UpdateDestChainConfig"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId gcCid)]

  -- Verify dest chain config was added
  contracts <- query @GlobalConfig ccipOwner
  case filter (\(_, gc) -> gc.instanceId == instanceId) contracts of
    [(_, gc)] -> do
      Map.size gc.destChainConfigs === 1
      case Map.lookup 1.0 gc.destChainConfigs of
        None -> abort "Expected dest chain config for chain 1"
        Some config -> do
          config.isEnabled === True
          config.offRampAddress === "abcdef1234567890"
          length config.laneMandatedCCVs === 1
          config.messageNetworkFeeUSDCents === 10.0
    _ -> abort "Expected exactly one GlobalConfig contract"

  pure ()

-- | Test updating existing dest chain config
testGlobalConfigMCMSEntrypoint_UpdateDestChainConfig_Replace : Script ()
testGlobalConfigMCMSEntrypoint_UpdateDestChainConfig_Replace = script do
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "globalconfig-replace-test"
      existingConfig = DestChainConfig True "abcd" [] [] 1.0 1.0

  -- Create GlobalConfig with existing dest chain config
  gcCid <- submit ccipOwner do
    createCmd GlobalConfig with
      instanceId
      ccipOwner
      chainSelector = 1.0
      onRampAddress = "1234"
      destChainConfigs = Map.fromList [(137.0, existingConfig)]
      sourceChainConfigs = Map.empty

  let instAddr = makeInstanceAddress instanceId ccipOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver gcCid

  -- Create new config to replace existing
  let newConfig = DestChainConfig with
        isEnabled = False
        offRampAddress = "deadbeef12345678"
        laneMandatedCCVs = []
        defaultCCVs = [RawInstanceAddress "default@party"]
        messageNetworkFeeUSDCents = 20.0
        tokenNetworkFeeUSDCents = 10.0

      encoded = encodeUpdateDestChainConfigParams 137.0 newConfig

  -- Call mcmsEntrypoint
  newContractIds <- submit ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "UpdateDestChainConfig"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId gcCid)]

  -- Verify config was replaced
  contracts <- query @GlobalConfig ccipOwner
  case filter (\(_, gc) -> gc.instanceId == instanceId) contracts of
    [(_, gc)] ->
      case Map.lookup 137.0 gc.destChainConfigs of
        None -> abort "Expected dest chain config"
        Some config -> do
          config.isEnabled === False
          config.offRampAddress === "deadbeef12345678"
          config.messageNetworkFeeUSDCents === 20.0
    _ -> abort "Expected exactly one GlobalConfig contract"

  pure ()

-- ===========================================================================
-- MCMS ENTRYPOINT TESTS - UPDATE SOURCE CHAIN CONFIG
