-- | MCMS entrypoint tests for GlobalConfig
-- Tests the MCMSReceiver interface implementation by calling mcmsEntrypoint directly
module CCIP.GlobalConfigTest.GlobalConfigMCMSTest where

import Daml.Script
import DA.Assert ((===))
import DA.List
import DA.Map qualified as Map

import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiver_Entrypoint(..))
import MCMS.RawInstanceAddress qualified as RawInstanceAddress
import CCIP.GlobalConfig
import CCIP.GlobalConfigCodec
import MCMS.RawInstanceAddress (RawInstanceAddress(..))

cents : Decimal -> Numeric 0
cents c = intToNumeric (truncate c)

-- ===========================================================================
-- MCMS ENTRYPOINT TESTS - APPLY DEST CHAIN CONFIG UPDATES
-- ===========================================================================

-- | Test MCMSReceiver entrypoint for ApplyDestChainConfigUpdates function
testGlobalConfigMCMSEntrypoint_ApplyDestChainConfigUpdates : Script ()
testGlobalConfigMCMSEntrypoint_ApplyDestChainConfigUpdates = script do
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "globalconfig-test"
      chainSelector : Numeric 0 = 1.0

  -- Create GlobalConfig with no dest chain configs
  gcCid <- submit ccipOwner do
    createCmd GlobalConfig with
      instanceId
      ccipOwner
      chainSelector = 123.0  -- Local chain
      destChainConfigs = Map.empty
      sourceChainConfigs = Map.empty

  let instAddr = RawInstanceAddress.makeText instanceId ccipOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver gcCid

  -- Create dest chain config update
  let args = [
        DestChainConfigArgs with
          destChainSelector = 456.0
          isEnabled = True
          addressBytesLength = 20
          baseExecutionGasCost = 0
          offRampAddress = "d589cf1d9ddc38d0aff8f324ed5d16d220f0fdbe"
          laneMandatedCCVs = [RawInstanceAddress "ccv@owner"]
          defaultCCVs = []
          messageNetworkFeeUSDCents = 10.0
          tokenNetworkFeeUSDCents = 5.0
        ]

      encoded = encodeApplyDestChainConfigUpdatesParams args

  -- Call mcmsEntrypoint
  newContractIds <- submit ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "ApplyDestChainConfigUpdates"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId gcCid)]

  -- Verify dest chain config was added
  contracts <- query @GlobalConfig ccipOwner
  case filter (\(_, gc) -> gc.instanceId == instanceId) contracts of
    [(_, gc)] -> do
      Map.size gc.destChainConfigs === 1
      case Map.lookup 456.0 gc.destChainConfigs of
        None -> abort "Expected dest chain config for chain 456"
        Some got -> do
          assertDestChainConfigsEqual got (head args)
    _ -> abort "Expected exactly one GlobalConfig contract"

  pure ()

-- | Test updating existing dest chain config
testGlobalConfigMCMSEntrypoint_ApplyDestChainConfigUpdates_Replace : Script ()
testGlobalConfigMCMSEntrypoint_ApplyDestChainConfigUpdates_Replace = script do
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "globalconfig-replace-test"
      existingConfig = DestChainConfig True 20 0 "abcd" [] [] (cents 1.0) (cents 1.0)

  -- Create GlobalConfig with existing dest chain config
  gcCid <- submit ccipOwner do
    createCmd GlobalConfig with
      instanceId
      ccipOwner
      chainSelector = 123.0
      destChainConfigs = Map.fromList [(456.0, existingConfig)]
      sourceChainConfigs = Map.empty

  let instAddr = RawInstanceAddress.makeText instanceId ccipOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver gcCid

  -- Create multiple new configs, one to replace existing
  let args = [
        DestChainConfigArgs with
          destChainSelector = 456.0
          isEnabled = False
          addressBytesLength = 20
          baseExecutionGasCost = 0
          offRampAddress = "b70fd68ac42892c71b3f9df7dde8efcafcfa82fe"
          laneMandatedCCVs = []
          defaultCCVs = [RawInstanceAddress "default@party"]
          messageNetworkFeeUSDCents = 20.0
          tokenNetworkFeeUSDCents = 10.0
        ,DestChainConfigArgs with
          destChainSelector = 789.0
          isEnabled = True
          addressBytesLength = 32
          baseExecutionGasCost = 0
          offRampAddress = "fdd0a23462dbe0f8cd1dfb5afdb61ffa9dccdfab1dcfcb0ee87aec14269fe8b5"
          laneMandatedCCVs = [RawInstanceAddress "ccv@owner"]
          defaultCCVs = [RawInstanceAddress "default@party"]
          messageNetworkFeeUSDCents = 300.0
          tokenNetworkFeeUSDCents = 777.0
        ]

      encoded = encodeApplyDestChainConfigUpdatesParams args

  -- Call mcmsEntrypoint
  newContractIds <- submit ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "ApplyDestChainConfigUpdates"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId gcCid)]

  -- Verify config was replaced
  contracts <- query @GlobalConfig ccipOwner
  case filter (\(_, gc) -> gc.instanceId == instanceId) contracts of
    [(_, gc)] -> do
      Map.size gc.destChainConfigs === 2
      case Map.lookup 456.0 gc.destChainConfigs of
        None -> abort "Expected dest chain config for chain 456"
        Some config -> do
          assertDestChainConfigsEqual config (head args)
      case Map.lookup 789.0 gc.destChainConfigs of
        None -> abort "Expected dest chain config for chain 789"
        Some config -> do
          assertDestChainConfigsEqual config (args !! 1)
    _ -> abort "Expected exactly one GlobalConfig contract"

  pure ()

