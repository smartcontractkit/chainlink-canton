-- | Test MCMSReceiver entrypoint for ApplySourceChainConfigUpdates function
testGlobalConfigMCMSEntrypoint_ApplySourceChainConfigUpdates : Script ()
testGlobalConfigMCMSEntrypoint_ApplySourceChainConfigUpdates = script do
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "globalconfig-source-test"

  -- Create GlobalConfig with no source chain configs
  gcCid <- submit ccipOwner do
    createCmd GlobalConfig with
      instanceId
      ccipOwner
      chainSelector = 123.0
      destChainConfigs = Map.empty
      sourceChainConfigs = Map.empty

  let instAddr = RawInstanceAddress.makeText instanceId ccipOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver gcCid

  -- Create source chain config
  let args = [
        SourceChainConfigArgs with
          sourceChainSelector = 456.0
          isEnabled = True
          onRampAddresses = ["fedcba0987654321"]
          laneMandatedCCVs = [RawInstanceAddress "src-ccv@party1"]
          defaultCCVs = [RawInstanceAddress "src-default@party2"]
        ]

      encoded = encodeApplySourceChainConfigUpdatesParams args

  -- Call mcmsEntrypoint
  newContractIds <- submit ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "ApplySourceChainConfigUpdates"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId gcCid)]

  -- Verify source chain config was added
  contracts <- query @GlobalConfig ccipOwner
  case filter (\(_, gc) -> gc.instanceId == instanceId) contracts of
    [(_, gc)] -> do
      Map.size gc.sourceChainConfigs === 1
      case Map.lookup 456.0 gc.sourceChainConfigs of
        None -> abort "Expected source chain config for chain 456"
        Some config -> do
          assertSourceChainConfigsEqual config (head args)
    _ -> abort "Expected exactly one GlobalConfig contract"

  let instanceId = "globalconfig-source-replace-test"

  -- Create GlobalConfig with existing source chain config
  gcCid <- submit ccipOwner do
    createCmd GlobalConfig with
      instanceId
      ccipOwner
      chainSelector = 123.0
      destChainConfigs = Map.empty
      sourceChainConfigs = Map.fromList [(456.0, SourceChainConfig True ["abcd"] [] [])]

  let instAddr = RawInstanceAddress.makeText instanceId ccipOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver gcCid

  -- Create multiple new configs, one to replace existing
  let args = [
        SourceChainConfigArgs with
          sourceChainSelector = 456.0
          isEnabled = True
          onRampAddresses = ["fedcba0987654321"]
          laneMandatedCCVs = [RawInstanceAddress "src-ccv@party1"]
          defaultCCVs = [RawInstanceAddress "src-default@party2"]
        ,SourceChainConfigArgs with
          sourceChainSelector = 789.0
          isEnabled = True
          onRampAddresses = ["cafe5678"]
          laneMandatedCCVs = [RawInstanceAddress "src-ccv@party1"]
          defaultCCVs = []
        ]

      encoded = encodeApplySourceChainConfigUpdatesParams args

  -- Call mcmsEntrypoint
  newContractIds <- submit ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "ApplySourceChainConfigUpdates"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId gcCid)]

  -- Verify source chain config was added
  contracts <- query @GlobalConfig ccipOwner
  case filter (\(_, gc) -> gc.instanceId == instanceId) contracts of
    [(_, gc)] -> do
      Map.size gc.sourceChainConfigs === 2
      case Map.lookup 456.0 gc.sourceChainConfigs of
        None -> abort "Expected source chain config for chain 456"
        Some config -> do
          assertSourceChainConfigsEqual config (head args)
      case Map.lookup 789.0 gc.sourceChainConfigs of
        None -> abort "Expected source chain config for chain 789"
        Some config -> do
          assertSourceChainConfigsEqual config (args !! 1)
    _ -> abort "Expected exactly one GlobalConfig contract"

  pure ()

-- ===========================================================================
-- ERROR CASE TESTS
-- ===========================================================================

-- | Test that unknown function name returns E_UNKNOWN_FUNCTION
testGlobalConfigMCMSEntrypoint_UnknownFunction : Script ()
testGlobalConfigMCMSEntrypoint_UnknownFunction = script do
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "globalconfig-error-test"

  gcCid <- submit ccipOwner do
    createCmd GlobalConfig with
      instanceId
      ccipOwner
      chainSelector = 1.0
      destChainConfigs = Map.empty
      sourceChainConfigs = Map.empty

  let instAddr = RawInstanceAddress.makeText instanceId ccipOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver gcCid

  -- Call with unknown function name - should fail
  submitMustFail ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "NonExistentFunction"
      operationData = ""
      contractIds = Map.fromList [(instAddr, toAnyContractId gcCid)]

  pure ()

-- | Test that invalid params returns E_INVALID_PARAMS
testGlobalConfigMCMSEntrypoint_InvalidParams : Script ()
testGlobalConfigMCMSEntrypoint_InvalidParams = script do
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "globalconfig-invalid-test"

  gcCid <- submit ccipOwner do
    createCmd GlobalConfig with
      instanceId
      ccipOwner
      chainSelector = 1.0
      destChainConfigs = Map.empty
      sourceChainConfigs = Map.empty

  let instAddr = RawInstanceAddress.makeText instanceId ccipOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver gcCid

  -- Call with invalid operationData - should fail
  submitMustFail ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "ApplyDestChainConfigUpdates"
      operationData = "1234"  -- Invalid encoded data
      contractIds = Map.fromList [(instAddr, toAnyContractId gcCid)]

  pure ()

-- | Test that missing self CID returns E_SELF_CID_NOT_IN_MAP
testGlobalConfigMCMSEntrypoint_MissingSelfCid : Script ()
testGlobalConfigMCMSEntrypoint_MissingSelfCid = script do
  ccipOwner <- allocateParty "ccip_owner"

  let instanceId = "globalconfig-missing-cid-test"

  gcCid <- submit ccipOwner do
    createCmd GlobalConfig with
      instanceId
      ccipOwner
      chainSelector = 1.0
      destChainConfigs = Map.empty
      sourceChainConfigs = Map.empty

  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver gcCid

  -- Encode valid params
  let args = [
        DestChainConfigArgs with
          destChainSelector = 456.0
          isEnabled = True
          addressBytesLength = 20
          baseExecutionGasCost = 0
          offRampAddress = "abcdef1234567890"
          laneMandatedCCVs = [RawInstanceAddress "ccv@owner"]
          defaultCCVs = []
          messageNetworkFeeUSDCents = 10.0
          tokenNetworkFeeUSDCents = 5.0
        ]

      encoded = encodeApplyDestChainConfigUpdatesParams args

  -- Call with empty contractIds map - should fail
  submitMustFail ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "UpdateDestChainConfig"
      operationData = encoded
      contractIds = Map.empty  -- Missing self CID

  pure ()

-- Helper to convert ContractId to AnyContractId for the map
toAnyContractId : ContractId a -> ContractId ()
toAnyContractId = coerceContractId

-- Assertion helpers
-- These compare Config <> Args, and therefore cannot assert on the chain selector since it's not part of the config itself, but rather the key in the map. The rest of the fields can be compared directly.

assertDestChainConfigsEqual : DestChainConfig -> DestChainConfigArgs -> Script ()
assertDestChainConfigsEqual got expected = do
  assertMsg ("isEnabled mismatch, got: " <> show got.isEnabled <> ", expected: " <> show expected.isEnabled) (got.isEnabled == expected.isEnabled)
  assertMsg ("offRampAddress mismatch, got: " <> show got.offRampAddress <> ", expected: " <> show expected.offRampAddress) (got.offRampAddress == expected.offRampAddress)
  assertMsg ("laneMandatedCCVs mismatch, got: " <> show got.laneMandatedCCVs <> ", expected: " <> show expected.laneMandatedCCVs) (got.laneMandatedCCVs == expected.laneMandatedCCVs)
  assertMsg ("defaultCCVs mismatch, got: " <> show got.defaultCCVs <> ", expected: " <> show expected.defaultCCVs) (got.defaultCCVs == expected.defaultCCVs)
  assertMsg ("messageNetworkFeeUSDCents mismatch, got: " <> show got.messageNetworkFeeUSDCents <> ", expected: " <> show expected.messageNetworkFeeUSDCents) (got.messageNetworkFeeUSDCents == expected.messageNetworkFeeUSDCents)
  assertMsg ("tokenNetworkFeeUSDCents mismatch, got: " <> show got.tokenNetworkFeeUSDCents <> ", expected: " <> show expected.tokenNetworkFeeUSDCents) (got.tokenNetworkFeeUSDCents == expected.tokenNetworkFeeUSDCents)

assertSourceChainConfigsEqual : SourceChainConfig -> SourceChainConfigArgs -> Script ()
assertSourceChainConfigsEqual got expected = do
  assertMsg ("isEnabled mismatch, got: " <> show got.isEnabled <> ", expected: " <> show expected.isEnabled) (got.isEnabled == expected.isEnabled)
  assertMsg ("onRampAddresses mismatch, got: " <> show got.onRampAddresses <> ", expected: " <> show expected.onRampAddresses) (got.onRampAddresses == expected.onRampAddresses)
  assertMsg ("laneMandatedCCVs mismatch, got: " <> show got.laneMandatedCCVs <> ", expected: " <> show expected.laneMandatedCCVs) (got.laneMandatedCCVs == expected.laneMandatedCCVs)
  assertMsg ("defaultCCVs mismatch, got: " <> show got.defaultCCVs <> ", expected: " <> show expected.defaultCCVs) (got.defaultCCVs == expected.defaultCCVs)
