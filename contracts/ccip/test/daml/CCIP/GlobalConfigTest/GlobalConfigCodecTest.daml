-- | Round-trip tests for GlobalConfig codec functions
module CCIP.GlobalConfigTest.GlobalConfigCodecTest where

import DA.Foldable
import Daml.Script

import CCIP.GlobalConfigCodec
import CCIP.GlobalConfigTypes (DestChainConfigArgs(..), SourceChainConfigArgs(..))
import CCIP.RawInstanceAddress (RawInstanceAddress(..))

cents : Decimal -> Numeric 0
cents c = intToNumeric (truncate c)

-- ===========================================================================
-- DEST CHAIN CONFIG ENCODING/DECODING TESTS
-- ===========================================================================

testApplyDestChainConfigUpdateParamsRoundtrip : Script ()
testApplyDestChainConfigUpdateParamsRoundtrip = do
  let args = [
        DestChainConfigArgs with
          destChainSelector = 1.0
          isEnabled = True
          addressBytesLength = 20
          offRampAddress = "e95aad72f136c035ecc1cabf477fcdeedace3bce"
          laneMandatedCCVs = [RawInstanceAddress "ccv1@party1", RawInstanceAddress "ccv2@party2"]
          defaultCCVs = [RawInstanceAddress "default-ccv@party3"]
          messageNetworkFeeUSDCents = 10.0
          tokenNetworkFeeUSDCents = 5.0
        ,DestChainConfigArgs with
          destChainSelector = 18446744073709551615.0 -- max uint64
          isEnabled = False
          addressBytesLength = 32
          offRampAddress = "78d10cee9ec94b0bc1da62fa3eaeca1bc85c78abee0eafeab7a20bd12c877cd1"
          laneMandatedCCVs = [RawInstanceAddress "ccv2@party2"]
          defaultCCVs = []
          messageNetworkFeeUSDCents = 1.0
          tokenNetworkFeeUSDCents = 1000.0
        ,DestChainConfigArgs with
          destChainSelector = 0.0 -- edge case: zero selector
          isEnabled = False
          addressBytesLength = 20
          offRampAddress = "41c8c7184de518bcaaf75f3aea14c3bccb256f97"
          laneMandatedCCVs = [RawInstanceAddress "ccv2@party2"]
          defaultCCVs = []
          messageNetworkFeeUSDCents = 1.0
          tokenNetworkFeeUSDCents = 1000.0
        ]

  let encoded = encodeApplyDestChainConfigUpdatesParams args

  case decodeApplyDestChainConfigUpdatesParams encoded of
    Some (decodedConfig) -> do
      forA_ (zip decodedConfig args) $ uncurry assertDestChainConfigArgsEqual

    _ -> abort "Failed to decode UpdateDestChainConfig params"

  pure ()

-- ===========================================================================
-- SOURCE CHAIN CONFIG ENCODING/DECODING TESTS
-- ===========================================================================

testApplySourceChainConfigUpdatesParamsRoundtrip : Script ()
testApplySourceChainConfigUpdatesParamsRoundtrip = do
  let args = [
        SourceChainConfigArgs with
          sourceChainSelector = 1.0
          isEnabled = True
          onRampAddresses = ["abcdef1234567890"]
          laneMandatedCCVs = [RawInstanceAddress "src-ccv1@partyA", RawInstanceAddress "src-ccv2@partyB"]
          defaultCCVs = [RawInstanceAddress "src-default@partyC"]
        ,SourceChainConfigArgs with
          sourceChainSelector = 18446744073709551615.0 -- max uint64
          isEnabled = False
          onRampAddresses = ["feedface"]
          laneMandatedCCVs = [RawInstanceAddress "src-ccv2@partyB"]
          defaultCCVs = []
        ,SourceChainConfigArgs with
          sourceChainSelector = 0.0 -- edge case: zero selector
          isEnabled = False
          onRampAddresses = ["feedface"]
          laneMandatedCCVs = [RawInstanceAddress "src-ccv2@partyB"]
          defaultCCVs = []
        ]

  let encoded = encodeApplySourceChainConfigUpdatesParams args

  case decodeApplySourceChainConfigUpdatesParams encoded of
    Some (decodedConfig) -> do
      forA_ (zip decodedConfig args) $ uncurry assertSourceChainConfigArgsEqual

    _ -> abort "Failed to decode ApplySourceChainConfigUpdates params"

  pure ()

-- ===========================================================================
-- INVALID DATA REJECTION TESTS
-- ===========================================================================

testInvalidDataRejection : Script ()
testInvalidDataRejection = do
  -- Empty data should fail
  case decodeApplyDestChainConfigUpdatesParams "" of
    None -> pure ()  -- Expected
    Some _ -> abort "Expected decodeApplyDestChainConfigUpdatesParams to fail on empty data"

  case decodeApplyDestChainConfigUpdatesParams "00" of
    Some _ -> pure () -- Expected (an empty list of updates is technically valid, so we should get Some [])
    None -> abort "Expected decodeApplyDestChainConfigUpdatesParams to succeed on empty list data"

  -- Invalid data should fail
  case decodeApplySourceChainConfigUpdatesParams "1234" of
    None -> pure ()  -- Expected
    Some got -> abort ("Expected decodeApplySourceChainConfigUpdatesParams to fail on invalid data, got: " <> show got)

  pure ()


-- Assertion helpers

assertDestChainConfigArgsEqual : DestChainConfigArgs -> DestChainConfigArgs -> Script ()
assertDestChainConfigArgsEqual got expected = do
  assertMsg ("DestChainSelector mismatch, got: " <> show got.destChainSelector <> ", expected: " <> show expected.destChainSelector) (got.destChainSelector == expected.destChainSelector)
  assertMsg ("isEnabled mismatch, got: " <> show got.isEnabled <> ", expected: " <> show expected.isEnabled) (got.isEnabled == expected.isEnabled)
  assertMsg ("offRampAddress mismatch, got: " <> show got.offRampAddress <> ", expected: " <> show expected.offRampAddress) (got.offRampAddress == expected.offRampAddress)
  assertMsg ("laneMandatedCCVs mismatch, got: " <> show got.laneMandatedCCVs <> ", expected: " <> show expected.laneMandatedCCVs) (got.laneMandatedCCVs == expected.laneMandatedCCVs)
  assertMsg ("defaultCCVs mismatch, got: " <> show got.defaultCCVs <> ", expected: " <> show expected.defaultCCVs) (got.defaultCCVs == expected.defaultCCVs)
  assertMsg ("messageNetworkFeeUSDCents mismatch, got: " <> show got.messageNetworkFeeUSDCents <> ", expected: " <> show expected.messageNetworkFeeUSDCents) (got.messageNetworkFeeUSDCents == expected.messageNetworkFeeUSDCents)
  assertMsg ("tokenNetworkFeeUSDCents mismatch, got: " <> show got.tokenNetworkFeeUSDCents <> ", expected: " <> show expected.tokenNetworkFeeUSDCents) (got.tokenNetworkFeeUSDCents == expected.tokenNetworkFeeUSDCents)

assertSourceChainConfigArgsEqual : SourceChainConfigArgs -> SourceChainConfigArgs -> Script ()
assertSourceChainConfigArgsEqual got expected = do
  assertMsg ("SourceChainSelector mismatch, got: " <> show got.sourceChainSelector <> ", expected: " <> show expected.sourceChainSelector) (got.sourceChainSelector == expected.sourceChainSelector)
  assertMsg ("isEnabled mismatch, got: " <> show got.isEnabled <> ", expected: " <> show expected.isEnabled) (got.isEnabled == expected.isEnabled)
  assertMsg ("onRampAddresses mismatch, got: " <> show got.onRampAddresses <> ", expected: " <> show expected.onRampAddresses) (got.onRampAddresses == expected.onRampAddresses)
  assertMsg ("laneMandatedCCVs mismatch, got: " <> show got.laneMandatedCCVs <> ", expected: " <> show expected.laneMandatedCCVs) (got.laneMandatedCCVs == expected.laneMandatedCCVs)
  assertMsg ("defaultCCVs mismatch, got: " <> show got.defaultCCVs <> ", expected: " <> show expected.defaultCCVs) (got.defaultCCVs == expected.defaultCCVs)
