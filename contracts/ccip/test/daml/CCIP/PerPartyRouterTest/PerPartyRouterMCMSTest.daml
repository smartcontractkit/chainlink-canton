-- | MCMS entrypoint tests for PerPartyRouter and PerPartyRouterFactory
-- Tests the MCMSReceiver interface implementation by calling mcmsEntrypoint directly
module CCIP.PerPartyRouterTest.PerPartyRouterMCMSTest where

import Daml.Script
import DA.Assert ((===))
import DA.Map qualified as Map
import DA.Set qualified as Set

import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiver_Entrypoint(..))

import qualified Chainlink.InstanceAddress

import qualified CCIP.RuntimeV2.PerPartyRouter
import qualified CCIP.RuntimeV2.PerPartyRouterCodecGen

-- ===========================================================================
-- PERPARTYROUTER MCMS ENTRYPOINT TESTS - SET DEPS
-- ===========================================================================

-- | Test MCMSReceiver entrypoint for SetDeps function on PerPartyRouter (all fields)
testPerPartyRouterMCMSEntrypoint_SetDeps : Script ()
testPerPartyRouterMCMSEntrypoint_SetDeps = script do
  ccipOwner <- allocateParty "ccip_owner"
  partyOwner <- allocateParty "party_owner"

  let instanceId = "router-test"
      initialDeps = CCIP.RuntimeV2.PerPartyRouter.PerPartyRouterDeps with
        onRamp = Chainlink.InstanceAddress.RawInstanceAddress "onramp-old@owner"
        offRamp = Chainlink.InstanceAddress.RawInstanceAddress "offramp-old@owner"
        globalConfig = Chainlink.InstanceAddress.RawInstanceAddress "gc-old@owner"
        tokenAdminRegistry = Chainlink.InstanceAddress.RawInstanceAddress "tar-old@owner"
        feeQuoter = Chainlink.InstanceAddress.RawInstanceAddress "fq-old@owner"
        rmnRemote = Chainlink.InstanceAddress.RawInstanceAddress "rmn-old@owner"

  routerCid <- submit ccipOwner do
    createCmd CCIP.RuntimeV2.PerPartyRouter.PerPartyRouter with
      instanceId
      ccipOwner
      partyOwner
      deps = initialDeps
      outboundSequenceNumbers = Map.empty
      executedMessages = Set.empty
      archivedExecutionContractIds = []
      customObservers = []

  let instAddr = Chainlink.InstanceAddress.makeText instanceId ccipOwner
  let targetAsMcmsReceiver = toInterfaceContractId @MCMSReceiver routerCid

  let newDeps = CCIP.RuntimeV2.PerPartyRouter.SetDepsParams with
        onRamp = Some (Chainlink.InstanceAddress.RawInstanceAddress "onramp-new@owner")
        offRamp = Some (Chainlink.InstanceAddress.RawInstanceAddress "offramp-new@owner")
        globalConfig = Some (Chainlink.InstanceAddress.RawInstanceAddress "gc-new@owner")
        tokenAdminRegistry = Some (Chainlink.InstanceAddress.RawInstanceAddress "tar-new@owner")
        feeQuoter = Some (Chainlink.InstanceAddress.RawInstanceAddress "fq-new@owner")
        rmnRemote = Some (Chainlink.InstanceAddress.RawInstanceAddress "rmn-new@owner")

      encoded = CCIP.RuntimeV2.PerPartyRouterCodecGen.encodeSetDepsParams newDeps

  newContractIds <- submit ccipOwner do
    exerciseCmd targetAsMcmsReceiver MCMSReceiver_Entrypoint with
      functionName = "SetDeps"
      operationData = encoded
      contractIds = Map.fromList [(instAddr, toAnyContractId routerCid)]

  contracts <- query @CCIP.RuntimeV2.PerPartyRouter.PerPartyRouter ccipOwner
  case filter (\(_, router) -> router.instanceId == instanceId) contracts of
    [(_, router)] -> do
      router.deps.onRamp === Chainlink.InstanceAddress.RawInstanceAddress "onramp-new@owner"
      router.deps.offRamp === Chainlink.InstanceAddress.RawInstanceAddress "offramp-new@owner"
      router.deps.globalConfig === Chainlink.InstanceAddress.RawInstanceAddress "gc-new@owner"
      router.deps.tokenAdminRegistry === Chainlink.InstanceAddress.RawInstanceAddress "tar-new@owner"
      router.deps.feeQuoter === Chainlink.InstanceAddress.RawInstanceAddress "fq-new@owner"
      router.deps.rmnRemote === Chainlink.InstanceAddress.RawInstanceAddress "rmn-new@owner"
    _ -> abort "Expected exactly one PerPartyRouter contract"

  pure ()

