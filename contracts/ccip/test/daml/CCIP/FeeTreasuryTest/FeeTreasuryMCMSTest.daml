-- ========================================================
-- |   WithdrawAuthorization (cancel)                      |
-- ========================================================

testFeeTreasury_WithdrawAuthorization : Script ()
testFeeTreasury_WithdrawAuthorization = script do
    feeOwner  <- allocateParty "fee_owner"
    recipient <- allocateParty "recipient"

    let instrumentId = InstrumentId feeOwner "FeeToken"

    treasuryCid <- submit feeOwner do
        createCmd MCMSFeeTreasury with
            instanceId = "fee-treasury-cancel-test"
            feeOwner; mcmsController = feeOwner

    authCid <- authorizeViaEntrypoint feeOwner "fee-treasury-cancel-test" treasuryCid
        AuthorizeFeeWithdrawalParams with
            authorizationId = "fee-withdrawal-cancel-test"
            recipient; instrumentId; maxAmount = 100.0; validitySecs = 3600

    submit feeOwner do
        exerciseCmd authCid WithdrawAuthorization

    auths <- query @FeeWithdrawalAuthorization feeOwner
    length auths === 0

-- ========================================================
-- |   MCMS Entrypoint: WithdrawAuthorization              |
-- ========================================================

testFeeTreasuryMCMSEntrypoint_WithdrawAuthorization : Script ()
testFeeTreasuryMCMSEntrypoint_WithdrawAuthorization = script do
    feeOwner  <- allocateParty "fee_owner"
    recipient <- allocateParty "recipient"

    let treasuryInstanceId = "fee-treasury-mcms-cancel-test"
        authorizationId    = "fee-withdrawal-mcms-cancel-test"
        instrumentId       = InstrumentId feeOwner "FeeToken"
        authInstAddr       = RawInstanceAddress.makeText authorizationId feeOwner

    treasuryCid <- submit feeOwner do
        createCmd MCMSFeeTreasury with
            instanceId = treasuryInstanceId
            feeOwner; mcmsController = feeOwner

    authCid <- authorizeViaEntrypoint feeOwner treasuryInstanceId treasuryCid
        AuthorizeFeeWithdrawalParams with
            authorizationId
            recipient; instrumentId; maxAmount = 100.0; validitySecs = 3600

    submitMustFail feeOwner do
        exerciseCmd (toInterfaceContractId @MCMSReceiver authCid) MCMSReceiver_Entrypoint with
            functionName  = "WithdrawAuthorization"
            operationData = "00"
            contractIds   = Map.fromList [(authInstAddr, coerceContractId authCid)]

    updatedMap <- submit feeOwner do
        exerciseCmd (toInterfaceContractId @MCMSReceiver authCid) MCMSReceiver_Entrypoint with
            functionName  = "WithdrawAuthorization"
            operationData = ""
            contractIds   = Map.fromList [(authInstAddr, coerceContractId authCid)]

    case Map.lookup authInstAddr updatedMap of
        None -> pure ()
        Some _ -> abort "Expected consumed authorization CID to be removed from map"

    auths <- query @FeeWithdrawalAuthorization feeOwner
    length auths === 0

-- ========================================================
-- |   CleanupExpiredAuthorization                        |
-- ========================================================

testFeeTreasury_CleanupExpiredAuthorization : Script ()
testFeeTreasury_CleanupExpiredAuthorization = script do
    feeOwner     <- allocateParty "fee_owner"
    recipient    <- allocateParty "recipient"
    cleanupParty <- allocateParty "cleanup_party"

    let treasuryInstanceId = "fee-treasury-cleanup-test"
        instrumentId       = InstrumentId feeOwner "FeeToken"

    treasuryCid <- submit feeOwner do
        createCmd MCMSFeeTreasury with
            instanceId = treasuryInstanceId
            feeOwner; mcmsController = feeOwner

    authCid <- authorizeViaEntrypoint feeOwner treasuryInstanceId treasuryCid
        AuthorizeFeeWithdrawalParams with
            authorizationId = "fee-withdrawal-cleanup-test"
            recipient; instrumentId; maxAmount = 100.0; validitySecs = 1

    disclosedAuth <- fromSome <$> queryDisclosure feeOwner authCid

    submitMustFail (actAs cleanupParty <> disclose disclosedAuth) do
        exerciseCmd authCid CleanupExpiredAuthorization with submitter = cleanupParty

    passTime (seconds 2)

    submit (actAs cleanupParty <> disclose disclosedAuth) do
        exerciseCmd authCid CleanupExpiredAuthorization with submitter = cleanupParty

    auths <- query @FeeWithdrawalAuthorization feeOwner
    length auths === 0

