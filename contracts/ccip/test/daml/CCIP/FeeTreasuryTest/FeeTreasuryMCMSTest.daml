            instanceId = "fee-treasury-cap-test"
            feeOwner; mcmsController = feeOwner

    authCid <- authorizeViaEntrypoint feeOwner "fee-treasury-cap-test" treasuryCid
        AuthorizeFeeWithdrawalParams with
