-- | Simplified test token implementation following Canton Coin (Splice) patterns.
-- Provides Holding, TransferPreapproval, TransferInstruction, and TransferFactory
-- for CCIP token pool testing without fees or expiry.
module TestToken where

import DA.Action (foldlA)
import DA.Optional (fromOptional)
import DA.TextMap qualified as TextMap

import qualified Splice.Api.Token.BurnMintV1
import qualified Splice.Api.Token.HoldingV1
import qualified Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.TransferInstructionV1

-- | Token holding template (like Amulet but simplified).
-- No expiry, no fees - just a simple UTXO holding.
template TestHolding
  with
    owner : Party
    admin : Party  -- Registry admin (like DSO in Canton Coin)
    instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
    amount : Decimal
  where
    signatory owner, admin

    interface instance Splice.Api.Token.HoldingV1.Holding for TestHolding where
      view = Splice.Api.Token.HoldingV1.HoldingView with
        owner
        instrumentId
        amount
        lock = None
        meta = Splice.Api.Token.MetadataV1.emptyMetadata

-- | Holding fixture for malicious backend tests. The viewed owner does not need
-- to be a signatory, which lets tests model a bad token backend returning
-- inconsistent generic Holding views.
template BadHolding
  with
    admin : Party
    owner : Party
    instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
    amount : Decimal
  where
    signatory admin
    observer owner

    interface instance Splice.Api.Token.HoldingV1.Holding for BadHolding where
      view = Splice.Api.Token.HoldingV1.HoldingView with
        owner
        instrumentId
        amount
        lock = None
        meta = Splice.Api.Token.MetadataV1.emptyMetadata

-- | Transfer Preapproval (like Canton Coin's TransferPreapproval).
-- Receiver + admin create this to allow ANY sender to send tokens directly.
template TestTransferPreapproval
  with
    admin : Party
    receiver : Party
  where
    signatory receiver, admin

    -- Direct send to receiver (like TransferPreapproval_Send).
    -- Controller is SENDER - any party can send if receiver has preapproved.
    nonconsuming choice Send : Splice.Api.Token.TransferInstructionV1.TransferInstructionResult
      with
        sender : Party
        amount : Decimal
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        inputHoldingCids : [ContractId Splice.Api.Token.HoldingV1.Holding]
      controller sender
      do
        -- Sum and validate inputs
        inputTotal <- sumAndArchiveInputs admin sender instrumentId inputHoldingCids

        assertMsg ("insufficient input: have " <> show inputTotal <> ", need " <> show amount)
          (inputTotal >= amount)

        -- Create receiver holding
        receiverCid <- create TestHolding with owner = receiver, admin, instrumentId, amount

        -- Create change for sender
        let change = inputTotal - amount
        senderChangeCids <- createChangeIfNeeded admin sender instrumentId change

        pure Splice.Api.Token.TransferInstructionV1.TransferInstructionResult with
          senderChangeCids
          output = Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Completed with
            receiverHoldingCids = [toInterfaceContractId receiverCid]
          meta = Splice.Api.Token.MetadataV1.emptyMetadata

-- | Pending Transfer Instruction (like AmuletTransferInstruction).
-- Created when receiver doesn't have preapproval.
template TestTransferInstruction
  with
    admin : Party
    transfer : Splice.Api.Token.TransferInstructionV1.Transfer
    lockedHoldingCid : ContractId TestHolding  -- Sender's funds locked pending acceptance
  where
    signatory admin, transfer.sender
    observer transfer.receiver

    interface instance Splice.Api.Token.TransferInstructionV1.TransferInstruction for TestTransferInstruction where
      view = Splice.Api.Token.TransferInstructionV1.TransferInstructionView with
        originalInstructionCid = None
        transfer
        status = Splice.Api.Token.TransferInstructionV1.TransferPendingReceiverAcceptance
        meta = Splice.Api.Token.MetadataV1.emptyMetadata

      -- Receiver accepts: unlock and transfer
      transferInstruction_acceptImpl _self _arg = do
        lockedHolding <- fetch lockedHoldingCid
        archive lockedHoldingCid

        -- Create holding for receiver
        receiverCid <- create TestHolding with
          owner = transfer.receiver
          admin
          instrumentId = transfer.instrumentId
          amount = transfer.amount

        pure Splice.Api.Token.TransferInstructionV1.TransferInstructionResult with
          senderChangeCids = []  -- Change was already returned when instruction created
          output = Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Completed with
            receiverHoldingCids = [toInterfaceContractId receiverCid]
          meta = Splice.Api.Token.MetadataV1.emptyMetadata

      -- Receiver rejects: return funds to sender
      transferInstruction_rejectImpl _self _arg = do
        lockedHolding <- fetch lockedHoldingCid
        archive lockedHoldingCid

        -- Return funds to sender
        senderCid <- create TestHolding with
          owner = transfer.sender
          admin
          instrumentId = transfer.instrumentId
          amount = lockedHolding.amount

        pure Splice.Api.Token.TransferInstructionV1.TransferInstructionResult with
          senderChangeCids = [toInterfaceContractId senderCid]
          output = Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Failed
          meta = Splice.Api.Token.MetadataV1.emptyMetadata

      -- Sender withdraws: return funds
      transferInstruction_withdrawImpl _self _arg = do
        lockedHolding <- fetch lockedHoldingCid
        archive lockedHoldingCid

        senderCid <- create TestHolding with
          owner = transfer.sender
          admin
          instrumentId = transfer.instrumentId
          amount = lockedHolding.amount

        pure Splice.Api.Token.TransferInstructionV1.TransferInstructionResult with
          senderChangeCids = [toInterfaceContractId senderCid]
          output = Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Failed
          meta = Splice.Api.Token.MetadataV1.emptyMetadata

      transferInstruction_updateImpl _self _arg =
        abort "TestTransferInstruction: update not supported"

-- Looks up the preapproval CID from extraArgs.context keyed by show(receiver).
-- Callers pass preapprovals via feeTokenExtraArgs.context (CCIPSend) or via the
-- transfer-factory-extra-args-context-values entry in the pool's context (LockOrBurn).
template TestTransferFactory
  with
    admin : Party
  where
    signatory admin

    interface instance Splice.Api.Token.TransferInstructionV1.TransferFactory for TestTransferFactory where
      view = Splice.Api.Token.TransferInstructionV1.TransferFactoryView with admin, meta = Splice.Api.Token.MetadataV1.emptyMetadata

      transferFactory_transferImpl _self arg = do
        let transfer = arg.transfer
        assertMsg "expectedAdmin mismatch" (arg.expectedAdmin == admin)

        -- Check if this is a self-transfer or has preapproval
        let isSelfTransfer = transfer.sender == transfer.receiver
        let preapprovalOpt = case TextMap.lookup (show transfer.receiver) arg.extraArgs.context.values of
              Some (Splice.Api.Token.MetadataV1.AV_ContractId cid) -> Some (coerceContractId cid : ContractId TestTransferPreapproval)
              _ -> None

        case (isSelfTransfer, preapprovalOpt) of
          -- Self-transfer: direct (like Canton Coin)
          (True, _) -> executeDirect admin transfer

          -- Has preapproval in context: use it for direct transfer
          (False, Some paCid) -> do
            exercise paCid Send with
              sender = transfer.sender
              amount = transfer.amount
              instrumentId = transfer.instrumentId
              inputHoldingCids = transfer.inputHoldingCids

          -- No preapproval: create pending TransferInstruction
          (False, None) -> createPendingTransfer admin transfer

      transferFactory_publicFetchImpl _self _arg =
        pure (view (toInterface @Splice.Api.Token.TransferInstructionV1.TransferFactory this))

template BadTransferInstruction
  with
    admin : Party
    transfer : Splice.Api.Token.TransferInstructionV1.Transfer
  where
    signatory admin
    observer transfer.sender, transfer.receiver

    interface instance Splice.Api.Token.TransferInstructionV1.TransferInstruction for BadTransferInstruction where
      view = Splice.Api.Token.TransferInstructionV1.TransferInstructionView with
        originalInstructionCid = None
        transfer
        status = Splice.Api.Token.TransferInstructionV1.TransferPendingReceiverAcceptance
        meta = Splice.Api.Token.MetadataV1.emptyMetadata

      transferInstruction_acceptImpl _self _arg =
        abort "BadTransferInstruction: accept not supported"

      transferInstruction_rejectImpl _self _arg =
        abort "BadTransferInstruction: reject not supported"

      transferInstruction_withdrawImpl _self _arg =
        abort "BadTransferInstruction: withdraw not supported"

      transferInstruction_updateImpl _self _arg =
        abort "BadTransferInstruction: update not supported"

template BadTransferFactory
  with
    admin : Party
    completedOwner : Optional Party
    completedInstrumentId : Optional Splice.Api.Token.HoldingV1.InstrumentId
    completedAmount : Optional Decimal
    pendingTransfer : Optional Splice.Api.Token.TransferInstructionV1.Transfer
  where
    signatory admin

    interface instance Splice.Api.Token.TransferInstructionV1.TransferFactory for BadTransferFactory where
      view = Splice.Api.Token.TransferInstructionV1.TransferFactoryView with admin, meta = Splice.Api.Token.MetadataV1.emptyMetadata

      transferFactory_transferImpl _self arg = do
        assertMsg "BadTransferFactory: expectedAdmin mismatch" (arg.expectedAdmin == admin)
        let transfer = arg.transfer
        case pendingTransfer of
          Some pending -> do
            instrCid <- create BadTransferInstruction with
              admin
              transfer = pending
            pure Splice.Api.Token.TransferInstructionV1.TransferInstructionResult with
              senderChangeCids = []
              output = Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Pending with
                transferInstructionCid = toInterfaceContractId instrCid
              meta = Splice.Api.Token.MetadataV1.emptyMetadata
          None -> do
            receiverCid <- create BadHolding with
              admin
              owner = fromOptional transfer.receiver completedOwner
              instrumentId = fromOptional transfer.instrumentId completedInstrumentId
              amount = fromOptional transfer.amount completedAmount
            pure Splice.Api.Token.TransferInstructionV1.TransferInstructionResult with
              senderChangeCids = []
              output = Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Completed with
                receiverHoldingCids = [toInterfaceContractId receiverCid]
              meta = Splice.Api.Token.MetadataV1.emptyMetadata

      transferFactory_publicFetchImpl _self _arg =
        pure (view (toInterface @Splice.Api.Token.TransferInstructionV1.TransferFactory this))

data BadBurnMintOutput = BadBurnMintOutput
  with
    owner : Party
    instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
    amount : Decimal
  deriving (Eq, Show)

template BadBurnMintFactory
  with
    admin : Party
    outputs : [BadBurnMintOutput]
  where
    signatory admin

    interface instance Splice.Api.Token.BurnMintV1.BurnMintFactory for BadBurnMintFactory where
      view = Splice.Api.Token.BurnMintV1.BurnMintFactoryView with admin, meta = Splice.Api.Token.MetadataV1.emptyMetadata

      burnMintFactory_burnMintImpl _self arg = do
        assertMsg "BadBurnMintFactory: expectedAdmin mismatch" (arg.expectedAdmin == admin)
        outputCids <- foldlA
          (\acc output -> do
            cid <- create BadHolding with
              admin
              owner = output.owner
              instrumentId = output.instrumentId
              amount = output.amount
            pure (acc ++ [toInterfaceContractId cid]))
          []
          outputs
        pure Splice.Api.Token.BurnMintV1.BurnMintFactory_BurnMintResult with
          outputCids

      burnMintFactory_publicFetchImpl _self _arg =
        pure (view (toInterface @Splice.Api.Token.BurnMintV1.BurnMintFactory this))

-- Helper: Sum inputs, validate ownership/instrument, and archive them.
sumAndArchiveInputs : Party -> Party -> Splice.Api.Token.HoldingV1.InstrumentId -> [ContractId Splice.Api.Token.HoldingV1.Holding] -> Update Decimal
sumAndArchiveInputs admin sender instrumentId cids =
  foldlA
    (\acc cid -> do
      h <- fetch cid
      let hv = view h
      assertMsg "input instrumentId mismatch" (hv.instrumentId == instrumentId)
      assertMsg "input owner mismatch" (hv.owner == sender)
      archive (coerceContractId cid : ContractId TestHolding)
      pure (acc + hv.amount))
    0.0
    cids

-- Helper: Create change holding if amount > 0.
createChangeIfNeeded : Party -> Party -> Splice.Api.Token.HoldingV1.InstrumentId -> Decimal -> Update [ContractId Splice.Api.Token.HoldingV1.Holding]
createChangeIfNeeded admin owner instrumentId change =
  if change > 0.0
    then do
      changeCid <- create TestHolding with owner, admin, instrumentId, amount = change
      pure [toInterfaceContractId changeCid]
    else pure []

-- Helper: Execute direct self-transfer.
executeDirect : Party -> Splice.Api.Token.TransferInstructionV1.Transfer -> Update Splice.Api.Token.TransferInstructionV1.TransferInstructionResult
executeDirect admin transfer = do
  inputTotal <- sumAndArchiveInputs admin transfer.sender transfer.instrumentId transfer.inputHoldingCids
  assertMsg "insufficient input" (inputTotal >= transfer.amount)

  receiverCid <- create TestHolding with
    owner = transfer.receiver, admin, instrumentId = transfer.instrumentId, amount = transfer.amount

  senderChangeCids <- createChangeIfNeeded admin transfer.sender transfer.instrumentId (inputTotal - transfer.amount)

  pure Splice.Api.Token.TransferInstructionV1.TransferInstructionResult with
    senderChangeCids
    output = Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Completed with
      receiverHoldingCids = [toInterfaceContractId receiverCid]
    meta = Splice.Api.Token.MetadataV1.emptyMetadata

-- Helper: Create pending transfer instruction when no preapproval.
createPendingTransfer : Party -> Splice.Api.Token.TransferInstructionV1.Transfer -> Update Splice.Api.Token.TransferInstructionV1.TransferInstructionResult
createPendingTransfer admin transfer = do
  inputTotal <- sumAndArchiveInputs admin transfer.sender transfer.instrumentId transfer.inputHoldingCids
  assertMsg "insufficient input" (inputTotal >= transfer.amount)

  -- Create locked holding for the transfer amount (admin holds it)
  lockedCid <- create TestHolding with
    owner = admin  -- Admin holds locked funds (like LockedAmulet pattern)
    admin
    instrumentId = transfer.instrumentId
    amount = transfer.amount

  -- Create change for sender
  senderChangeCids <- createChangeIfNeeded admin transfer.sender transfer.instrumentId (inputTotal - transfer.amount)

  -- Create pending instruction
  instrCid <- create TestTransferInstruction with admin, transfer, lockedHoldingCid = lockedCid

  pure Splice.Api.Token.TransferInstructionV1.TransferInstructionResult with
    senderChangeCids
    output = Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Pending with
      transferInstructionCid = toInterfaceContractId instrCid
    meta = Splice.Api.Token.MetadataV1.emptyMetadata
