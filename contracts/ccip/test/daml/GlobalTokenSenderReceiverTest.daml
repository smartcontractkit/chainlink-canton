    let message = (tokenOnlyAnyMessage s s.user) with
        extraArgs = CCIP.ClientV2.V3 CCIP.ClientV2.GenericExtraArgsV3 with
            gasLimit = 100000
            ccvs = []
            executor = CCIP.ClientV2.Executor_NoExecutor
            tokenReceiver = ""
            tokenArgs = ""

    submitMustFail (actAs s.user <> disclose s.disclosedGlobal) do
        exerciseCmd s.globalContract CCIP.GlobalTokenSenderReceiver.Send with
            senderParty = s.user
            destinationChainSelector = s.destChainSelector
            message = message
            routerCid = s.userRouter
            feeTokenInput = dummyFeeTokenInput s.globalContract
            ccvSendInputs = []
            tokenTransferInput = dummyTokenTransferInput s.globalContract
            executorInput = None
            context = Splice.Api.Token.MetadataV1.emptyChoiceContext

