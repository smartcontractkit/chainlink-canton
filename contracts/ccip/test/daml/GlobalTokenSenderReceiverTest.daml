-- | Execute must reject message-only messages (no token transfer).
testGlobalExecuteRejectsMessageOnly : Script ()
testGlobalExecuteRejectsMessageOnly = script do
    s <- setup "execute-message-only"
    let message = messageOnlyMessage s s.receiver
    let context = receiverExecuteContext s
    disclosures <- receiverDisclosures s

    submitMustFail (actAs s.receiver <> discloseMany disclosures) do
        exerciseCmd s.globalContract CCIP.GlobalTokenSenderReceiver.Execute with
            receiverParty = s.receiver
            routerCid = s.router
            encodedMessage = CCIP.CodecV2.MessageCodecV1.encodeMessageV1 message
            tokenTransfer = CCIP.UserV1.Receiver.ReceiverTokenTransferInput with
                tokenPoolCid = coerceContractId s.globalContract -- unused: guard aborts first
                tokenReceiverParty = s.receiver
                context = Splice.Api.Token.MetadataV1.emptyChoiceContext
            ccvInputs = []
            context = context

-- | Execute must reject payload-bearing messages.
testGlobalExecuteRejectsPayload : Script ()
testGlobalExecuteRejectsPayload = script do
    s <- setup "execute-payload"
    let message = (tokenOnlyMessage s s.receiver) with
        messageData = "48656c6c6f20576f726c64"
    let context = receiverExecuteContext s
    disclosures <- receiverDisclosures s

    submitMustFail (actAs s.receiver <> discloseMany disclosures) do
        exerciseCmd s.globalContract CCIP.GlobalTokenSenderReceiver.Execute with
            receiverParty = s.receiver
            routerCid = s.router
            encodedMessage = CCIP.CodecV2.MessageCodecV1.encodeMessageV1 message
            tokenTransfer = CCIP.UserV1.Receiver.ReceiverTokenTransferInput with
                tokenPoolCid = coerceContractId s.globalContract -- unused: guard aborts first
                tokenReceiverParty = s.receiver
                context = Splice.Api.Token.MetadataV1.emptyChoiceContext
            ccvInputs = []
            context = context

-- | Execute with a receiverParty that does not match the message's encoded
-- receiver must be rejected by the OffRamp.
testGlobalExecuteRejectsMisdirectedReceiverParty : Script ()
testGlobalExecuteRejectsMisdirectedReceiverParty = script do
    s <- setup "execute-misdirect"
    let message = tokenOnlyMessage s s.receiver
    let context = receiverExecuteContext s
    disclosures <- receiverDisclosures s

    submitMustFail (actAs s.receiver <> discloseMany disclosures) do
        exerciseCmd s.globalContract CCIP.GlobalTokenSenderReceiver.Execute with
            receiverParty = s.user -- not the message receiver
            routerCid = s.router
            encodedMessage = CCIP.CodecV2.MessageCodecV1.encodeMessageV1 message
            tokenTransfer = CCIP.UserV1.Receiver.ReceiverTokenTransferInput with
                tokenPoolCid = coerceContractId s.globalContract -- unused: OffRamp rejects first
                tokenReceiverParty = s.receiver
                context = Splice.Api.Token.MetadataV1.emptyChoiceContext
            ccvInputs = []
            context = context

