-- | GetRequiredCCVsForSend must reject message-only messages (no token
-- transfer); the pool is never dereferenced.
testGlobalGetRequiredCCVsForSendRejectsMessageOnly : Script ()
testGlobalGetRequiredCCVsForSendRejectsMessageOnly = script do
    s <- setup "gccvs-send-message-only"

    submitMustFail (actAs s.user <> disclose s.disclosedGlobal) do
        exerciseCmd s.globalContract CCIP.GlobalTokenSenderReceiver.GetRequiredCCVsForSend with
            senderParty = s.user
            destinationChainSelector = s.destChainSelector
            message = messageOnlyAnyMessage s s.user
            routerCid = s.userRouter
            tokenPoolCid = coerceContractId s.globalContract -- unused: guard aborts first
            context = Splice.Api.Token.MetadataV1.emptyChoiceContext

-- | Send must reject messages with a non-zero callback gas limit (pure token
