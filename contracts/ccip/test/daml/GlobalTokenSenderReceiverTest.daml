-- | The ICCIPSender interface dispatch must reject message-only messages
-- (pure token transfers only). The shared interface's optional tokenPoolCid is
-- unwrapped strictly; a dummy Some is passed so the choice body's guard is
-- what aborts.
testGlobalInterfaceSenderGetRequiredCCVsRejectsMessageOnly : Script ()
testGlobalInterfaceSenderGetRequiredCCVsRejectsMessageOnly = script do
    s <- setup "iface-sender"
    let message = messageOnlyAnyMessage s s.user
    let context = senderSendContext s
    disclosures <- senderDisclosures s

    submitMustFail (actAs s.user <> discloseMany disclosures) do
        exerciseCmd (toInterfaceContractId @CCIP.UserV1.Sender.ICCIPSender s.globalContract)
            CCIP.UserV1.Sender.ICCIPSender_GetRequiredCCVs with
                senderParty = s.user
                destinationChainSelector = s.destChainSelector
                message = message
                routerCid = s.userRouter
                tokenPoolCid = Some (coerceContractId s.globalContract) -- unused: guard aborts first
                context = context

-- | The ICCIPReceiver interface dispatch must reject message-only messages
-- (pure token transfers only). The shared interface's optional tokenPoolCid is
-- unwrapped strictly; a dummy Some is passed so the choice body's guard is
-- what aborts.
testGlobalInterfaceReceiverGetRequiredCCVsRejectsMessageOnly : Script ()
testGlobalInterfaceReceiverGetRequiredCCVsRejectsMessageOnly = script do
    s <- setup "iface-receiver"
    let message = messageOnlyMessage s s.receiver
    let context = receiverExecuteContext s
    disclosures <- receiverDisclosures s

    submitMustFail (actAs s.receiver <> discloseMany disclosures) do
        exerciseCmd (toInterfaceContractId @CCIP.UserV1.Receiver.ICCIPReceiver s.globalContract)
            CCIP.UserV1.Receiver.ICCIPReceiver_GetRequiredCCVs with
                receiverParty = s.receiver
                routerCid = s.router
                encodedMessage = CCIP.CodecV2.MessageCodecV1.encodeMessageV1 message
                tokenPoolCid = Some (coerceContractId s.globalContract) -- unused: guard aborts first
                context = context

-- | The client interfaces on the global contract must surface the baked-in
-- state through their views.
testGlobalInterfaceViews : Script ()
testGlobalInterfaceViews = script do
    s <- setup "iface-views"

    Some senderView <- queryInterfaceContractId s.ccipOwner (toInterfaceContractId @CCIP.UserV1.Sender.ICCIPSender s.globalContract)
    CCIP.UserV1.Sender.ccipOwner senderView === s.ccipOwner

    Some receiverView <- queryInterfaceContractId s.ccipOwner (toInterfaceContractId @CCIP.UserV1.Receiver.ICCIPReceiver s.globalContract)
    CCIP.UserV1.Receiver.ccipOwner receiverView === s.ccipOwner
    CCIP.UserV1.Receiver.requiredCCVs receiverView === []
    CCIP.UserV1.Receiver.receiverFinalityConfig receiverView === bakedInReceiverFinalityConfig
