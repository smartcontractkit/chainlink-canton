module MathTest where

import Daml.Script

import DA.Assert

import qualified CCIP.Math as Math

usd8 : Decimal -> Numeric 0
usd8 d = intToNumeric (truncate (d * 100000000.0))

-- mulDivDown: basic exactness

testMulDivDown_SmallValues = script do
    Math.mulDivDown 7.0 3.0 2.0 === 10.0
    Math.mulDivDown 5.0 3.0 2.0 === 7.0
    Math.mulDivDown 1.0 1.0 3.0 === 0.0
    Math.mulDivDown 10.0 10.0 3.0 === 33.0
    Math.mulDivDown 123.0 456.0 1.0 === 56088.0

-- E8 fee math: $1 fee at $20/token -> 0.05 token = 5_000_000 local units.
testMulDivDown_E8Scale = script do
    let oneDollarInCents : Numeric 0 = 100.0
    let usd8PerUsdCent : Numeric 0 = 1000000.0
    let premiumIdentity : Numeric 0 = 100000000.0
    let feeUsd8 = Math.mulDivDown oneDollarInCents usd8PerUsdCent 1.0
    feeUsd8 === 100000000.0
    Math.mulDivDown feeUsd8 premiumIdentity (usd8 20.0) === 5000000.0

-- Large value regression: E8 pricing should comfortably support a $10,000,000
-- token price without overflowing the exact helper.
testMulDivDown_LargePrice = script do
    let feeUsd8 = Math.mulDivDown 250.0 1000000.0 1.0 -- $2.50
    let veryLargePrice = usd8 10000000.0
    Math.mulDivDown feeUsd8 100000000.0 veryLargePrice === 25.0

-- LINK cap checks now compare local LINK units against a juels cap converted at
-- the boundary: floor(maxFeeJuelsPerMsg / 1e10).
testNormalizedFeeWithinCapBoundary = script do
    let feeTokenAmount = 150000000.0 -- 1.5 USDC local units
        feeTokenPrice = usd8 1.0
        linkTokenPrice = usd8 15.0
        exactLocalLinkFee = 10000000.0 -- 0.1 LINK local units

    assert (Math.normalizedFeeWithinCap feeTokenAmount feeTokenPrice linkTokenPrice 100000000000000000.0)
    assert (not (Math.normalizedFeeWithinCap feeTokenAmount feeTokenPrice linkTokenPrice 99999999999999999.0))
    assert (Math.integerAmountWithinCap exactLocalLinkFee 100000000000000000.0)
    assert (not (Math.integerAmountWithinCap exactLocalLinkFee 99999999999999999.0))

-- Exact comparison should not be sensitive to divide-first rounding. This case
-- sits close to the cap boundary and must still pass.
testNormalizedFeeWithinCap_CloseBoundary = script do
    let feeTokenAmount = 100000001.0
        feeTokenPrice = usd8 1.0
        linkTokenPrice = usd8 15.0
        capJuels = 66666670000000000.0
    assert (Math.normalizedFeeWithinCap feeTokenAmount feeTokenPrice linkTokenPrice capJuels)

-- Decimal boundary helpers

testCanFitInDecimal = script do
    assert (Math.canFitInDecimal 0.0)
    assert (Math.canFitInDecimal 9999999999999999999999999999.0)
    assert (not (Math.canFitInDecimal 10000000000000000000000000000.0))
    assert (not (Math.canFitInDecimal (-1.0)))

testNumeric0ToDecimalChecked = script do
    Math.numeric0ToDecimalChecked "test" 0.0 === 0.0
    Math.numeric0ToDecimalChecked "test" 100000000.0 === 100000000.0
    Math.numeric0ToDecimalChecked "test" 9999999999999999999999999999.0 === 9999999999999999999999999999.0
