module ExtraArgsCodec where

import Daml.Script

import DA.Assert ((===))

import CCIP.ExtraArgsCodec qualified as ExtraArgsCodec

testExtraArgsV3Codec : Script ()
testExtraArgsV3Codec = do
    let extraArgs = ExtraArgsCodec.GenericExtraArgsV3
            with
                gasLimit = 500000
                blockConfirmations = 12
                ccvs = ["bf9f84ade4dfe17de8e6ccfcb543f7fcddfced84", "dcaf44b3cca7a8a50feaae70d3b7aaec2f040d09"]
                ccvArgs = ["6578656375746f7220617267756d656e742031", "746869732069732061206d756368206c6f6e67657220617267756d656e7420666f72206578656375746f72206e756d6265722074776f"]
                executor = "b3db8bbdbfee9b6cd2368f0dcbbf8314ec25fc0d"
                executorArgs = ""
                tokenReceiver = "9b618e642add81cf490b4bdfc2cfc163dcf8e0a7"
                tokenArgs = "68656c6c6f20776f726c64"
    let encoded = ExtraArgsCodec.encodeGenericExtraArgsV3 extraArgs
    debug ("Encoded extraArgs:" <> show encoded)
    let decoded = ExtraArgsCodec.decodeGenericExtraArgsV3 encoded
    decoded === Some extraArgs

testDecode : Script ()
testDecode = do
    let encoded = ""
    let decoded = ExtraArgsCodec.decodeGenericExtraArgsV3 encoded
    debug ("Decoded extraArgs:" <> show decoded)