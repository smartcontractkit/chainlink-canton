module OnRamp where

import Daml.Script

import DA.Map qualified as Map
import DA.Optional

import qualified CCIP.Client
import CCIP.FeeQuoter qualified as FeeQuoter
import CCIP.OnRamp qualified as OnRamp

import Splice.Api.Token.TransferInstructionV1
import Splice.Api.Token.BurnMintV1
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.MetadataV1

import Coin.Registry

setup = script do
    owner <- allocateParty "owner"
    issuer <- allocateParty "issuer"
    user <- allocateParty "user"

    let instrumentIdLINK = Splice.Api.Token.HoldingV1.InstrumentId with
            admin = issuer
            id = "LINK"
    let destChainSelector1 : Numeric 0 = 1234567890.0

    -- Create LINK Holding
    -- Create Registry
    registry <- submit issuer do
        createCmd CoinRegistry with
            issuer = issuer
            instrumentId = instrumentIdLINK
            meta = emptyMetadata
    disclosedRegistry <- fromSome <$> queryDisclosure issuer registry

    -- mint to user
    userPreApproval <- submit user do
        createCmd MintPreapproval with
            sender = issuer
            receiver = user
    -- mint to user
    bmResult <- submit issuer do
        exerciseCmd (toInterfaceContractId @BurnMintFactory registry) BurnMintFactory_BurnMint with
            expectedAdmin = issuer
            sender = issuer
            instrumentId = instrumentIdLINK
            inputHoldingCids = []
            outputs = [
                BurnMintOutput {
                    owner = user,
                    amount = 1000.00,
                    context = ChoiceContext with -- add pre-approval cid to choice context
                        values = Map.fromList [(mintPreapprovalContextKey, AV_ContractId $ coerceContractId userPreApproval)]
                }]
            extraActors = []
            extraArgs = ExtraArgs with
                context = emptyChoiceContext
                meta = emptyMetadata

    let userHoldingCids = bmResult.outputCids

    -- Deploy FeeQuoter
    fq <- submit owner do
        createCmd FeeQuoter.FeeQuoter with
            owner = owner
            feeTokens = Map.empty
            destChainConfigs = Map.empty
            usdPerUnitGasByDestChainSelector = Map.empty
            usdPerToken = Map.empty
            priceUpdaters = [owner]
    -- Apply price updates for destChainSelector1 and instrumentIdLINK
    fq <- submit owner do
        exerciseCmd fq FeeQuoter.UpdatePrices with
            priceUpdates = FeeQuoter.PriceUpdates with
                tokenPriceUpdates = [
                        FeeQuoter.TokenPriceUpdate with
                            instrumentId = instrumentIdLINK
                            usdPerToken = 20.00
                    ]
                gasPriceUpdates = [
                        FeeQuoter.GasPriceUpdate with
                            destChainSelector = destChainSelector1
                            usdPerUnitGas = 0.045
                    ]
            caller = owner
    -- apply destChainConfig for destChainSelector1
    let destChainConfig1 = FeeQuoter.DestChainConfig with
            isEnabled = True
            maxDataBytes = 5000
            destGasOverhead = 30000
            destGasPerPayloadByteBase = 12
            defaultTxGasLimit = 500000
            maxPerMsgGasLimit = 2000000
            chainFamilySelector = "2812d52c"
            networkFeeUSD = 1.0
            defaultTokenFeeUSD = 0.50
            defaultTokenDestGasOverhead = 0
    fq <- submit owner do
        exerciseCmd fq FeeQuoter.ApplyDestChainConfigUpdates with
            destChainConfigArgs = [
                    (FeeQuoter.DestChainConfigArgs with
                        destChainSelector = destChainSelector1
                        destChainConfig = destChainConfig1)
                ]

    -- Deploy OnRamp
    onRamp <- submit owner do
        createCmd OnRamp.OnRamp with
            owner = owner
            staticConfig = OnRamp.StaticConfig with
                chainSelector = 2222222222.0
            destChainConfigs = Map.empty

    --apply destChainConfig for destChainSelector1
    let destChainConfig = OnRamp.DestChainConfig with
            sequenceNumber = 0.0
            defaultExecutor = ""
            laneMandatedCCVs = []
            defaultCCVs = []
    onRamp <- submit owner do
        exerciseCmd onRamp OnRamp.ApplyDestChainConfigUpdates with
            destChainConfigArgs = [
                    (OnRamp.DestChainConfigArgs with
                        destChainSelector = destChainSelector1
                        destChainConfig = destChainConfig)
                ]

    -- user creates TransferInstruction to owner
    now <- getTime
    transferResult <- trySubmit (actAs user <> disclose disclosedRegistry) do
        exerciseCmd (toInterfaceContractId @TransferFactory registry) TransferFactory_Transfer with
            expectedAdmin = issuer
            transfer = Splice.Api.Token.TransferInstructionV1.Transfer with
                sender = user
                receiver = owner
                amount = 0.10 -- @ $20 per LINK = $2.00
                instrumentId = instrumentIdLINK
                requestedAt = now
                executeBefore = now
                inputHoldingCids = userHoldingCids
                meta = emptyMetadata
            extraArgs = ExtraArgs with
                context = emptyChoiceContext
                meta = emptyMetadata
    Right transferResult' <- pure transferResult
    TransferInstructionResult_Pending pendingTransfer <- pure transferResult'.output

    let userHoldingCids = transferResult'.senderChangeCids

    -- call CCIPSend on OnRamp
    result <- submit owner do
        exerciseCmd onRamp OnRamp.CCIPSend with
            destChainSelector = destChainSelector1
            message = CCIP.Client.Canton2AnyMessage with
                receiver = "0xReceiverAddress"
                payload = "0xPayloadData"
                feeToken = instrumentIdLINK
                extraArgs = ""
            feeInput = pendingTransfer
            caller = owner
            feeQuoter = fq
    
    debug ("CCIPSend result: " <> show result)

    -- OnRamp will have changed
    onRamp <- pure result.onRamp

    -- create new TransferInstruction to owner
    transferResult <- trySubmit (actAs user <> disclose disclosedRegistry) do
        exerciseCmd (toInterfaceContractId @TransferFactory registry) TransferFactory_Transfer with
            expectedAdmin = issuer
            transfer = Splice.Api.Token.TransferInstructionV1.Transfer with
                sender = user
                receiver = owner
                amount = 0.01 -- @ $20 per LINK = $0.20
                instrumentId = instrumentIdLINK
                requestedAt = now
                executeBefore = now
                inputHoldingCids = userHoldingCids
                meta = emptyMetadata
            extraArgs = ExtraArgs with
                context = emptyChoiceContext
                meta = emptyMetadata
    Right transferResult' <- pure transferResult
    TransferInstructionResult_Pending pendingTransfer <- pure transferResult'.output

    -- send should fail due to insufficient fee
    result <- submitMustFail owner do
        exerciseCmd onRamp OnRamp.CCIPSend with
            destChainSelector = destChainSelector1
            message = CCIP.Client.Canton2AnyMessage with
                receiver = "0xReceiverAddress"
                payload = "0xPayloadData"
                feeToken = instrumentIdLINK
                extraArgs = ""
            feeInput = pendingTransfer
            caller = owner
            feeQuoter = fq

    pure()