module CCIP.API.RMNRemoteV1 where

import DA.Crypto.Text (BytesHex)

import qualified Splice.Api.Token.MetadataV1

interface RMNRemote where
    viewtype RMNRemoteView

    rmnRemote_isCursedImpl : ContractId RMNRemote -> RMNRemote_IsCursed -> Update Bool
    rmnRemote_isCursedForChainImpl : ContractId RMNRemote -> RMNRemote_IsCursedForChain -> Update Bool
    rmnRemote_getCursedSubjectsImpl : ContractId RMNRemote -> RMNRemote_GetCursedSubjects -> Update [BytesHex]

    -- | Check if globally cursed
    nonconsuming choice RMNRemote_IsCursed : Bool
        with
            context : Splice.Api.Token.MetadataV1.ChoiceContext
            caller : Party
        controller caller
        do rmnRemote_isCursedImpl this self arg

    -- | Check if cursed for specific chain (global OR chain-specific)
    nonconsuming choice RMNRemote_IsCursedForChain : Bool
        with
            chainSelector : Numeric 0
            context : Splice.Api.Token.MetadataV1.ChoiceContext
            caller : Party
        controller caller
        do rmnRemote_isCursedForChainImpl this self arg

    -- | Get all cursed subjects
    nonconsuming choice RMNRemote_GetCursedSubjects : [BytesHex]
        with
            context : Splice.Api.Token.MetadataV1.ChoiceContext
            caller : Party
        controller caller
        do rmnRemote_getCursedSubjectsImpl this self arg

data RMNRemoteView = RMNRemoteView
    with
        ccipOwner : Party
        rmnOwner : Party
        instanceId : Text
    deriving (Eq, Show)