            destGasOverhead : Int
            destBytesOverhead : Int
            context : Splice.Api.Token.MetadataV1.ChoiceContext
            caller : Party
        controller caller
        do tokenAdminRegistry_addTokenSendFeeImpl this self arg

    nonconsuming choice TokenAdminRegistry_ConsumeReceiveTicket : ()
        with
