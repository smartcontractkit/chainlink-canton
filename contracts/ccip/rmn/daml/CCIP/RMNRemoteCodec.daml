-- | Codec module for RMNRemote MCMS parameter encoding/decoding
-- Used by the MCMSReceiver interface implementation to decode operationData
module CCIP.RMNRemoteCodec
  ( decodeCurseParams
  , decodeCurseParamsWithOffset
  , encodeCurseParams
  , decodeUncurseParams
  , decodeUncurseParamsWithOffset
  , encodeUncurseParams
  , decodeCurseChainParams
  , decodeCurseChainParamsWithOffset
  , encodeCurseChainParams
  , decodeUncurseChainParams
  , decodeUncurseChainParamsWithOffset
  , encodeUncurseChainParams
  , decodeCurseMultipleParams
  , decodeCurseMultipleParamsWithOffset
  , encodeCurseMultipleParams
  , decodeUncurseMultipleParams
  , decodeUncurseMultipleParamsWithOffset
  , encodeUncurseMultipleParams
  , decodeAddCustomObserversParams
  , decodeAddCustomObserversParamsWithOffset
  , encodeAddCustomObserversParams
  , decodeRemoveCustomObserversParams
  , decodeRemoveCustomObserversParamsWithOffset
  , encodeRemoveCustomObserversParams
  ) where

import MCMS.Codec
  ( extractBytes
  , encodeUint8
  , decodeUint8
  , encodeNumeric0
  , decodeNumeric0At
  )

import DA.Crypto.Text (BytesHex, toHex, fromHex, byteCount)
import DA.Optional (fromSome)

-- ===========================================================================
-- DECODE FUNCTIONS (for MCMSReceiver entrypoint)
-- ===========================================================================

-- | Decode Curse params with final offset (single subject)
-- Format: [uint8 len][bytesHex subject]
decodeCurseParamsWithOffset : BytesHex -> Optional (BytesHex, Int)
decodeCurseParamsWithOffset encoded = do
  (subject, finalOffset) <- decodeBytesHexAt encoded 0
  Some (subject, finalOffset)

-- | Decode Curse params (discards final offset)
decodeCurseParams : BytesHex -> Optional BytesHex
decodeCurseParams encoded = do
  (result, _) <- decodeCurseParamsWithOffset encoded
  Some result

-- | Decode Uncurse params with final offset (same as Curse)
decodeUncurseParamsWithOffset : BytesHex -> Optional (BytesHex, Int)
decodeUncurseParamsWithOffset = decodeCurseParamsWithOffset

-- | Decode Uncurse params (discards final offset)
decodeUncurseParams : BytesHex -> Optional BytesHex
decodeUncurseParams = decodeCurseParams

-- | Decode CurseChain params with final offset (chain selector)
-- Format: [8 bytes Numeric 0]
decodeCurseChainParamsWithOffset : BytesHex -> Optional (Numeric 0, Int)
decodeCurseChainParamsWithOffset encoded = do
  (chainSelector, finalOffset) <- decodeNumeric0At encoded 0
  Some (chainSelector, finalOffset)

-- | Decode CurseChain params (discards final offset)
decodeCurseChainParams : BytesHex -> Optional (Numeric 0)
decodeCurseChainParams encoded = do
  (result, _) <- decodeCurseChainParamsWithOffset encoded
  Some result

-- | Decode UncurseChain params with final offset (same as CurseChain)
decodeUncurseChainParamsWithOffset : BytesHex -> Optional (Numeric 0, Int)
decodeUncurseChainParamsWithOffset = decodeCurseChainParamsWithOffset

-- | Decode UncurseChain params (discards final offset)
decodeUncurseChainParams : BytesHex -> Optional (Numeric 0)
decodeUncurseChainParams = decodeCurseChainParams

-- | Decode CurseMultiple params with final offset (list of subjects)
-- Format: [uint8 count][bytesHex...]
decodeCurseMultipleParamsWithOffset : BytesHex -> Optional ([BytesHex], Int)
decodeCurseMultipleParamsWithOffset encoded = do
  (subjects, finalOffset) <- decodeBytesHexList encoded 0
  Some (subjects, finalOffset)

-- | Decode CurseMultiple params (discards final offset)
decodeCurseMultipleParams : BytesHex -> Optional [BytesHex]
decodeCurseMultipleParams encoded = do
  (result, _) <- decodeCurseMultipleParamsWithOffset encoded
  Some result

-- | Decode UncurseMultiple params with final offset (same as CurseMultiple)
decodeUncurseMultipleParamsWithOffset : BytesHex -> Optional ([BytesHex], Int)
decodeUncurseMultipleParamsWithOffset = decodeCurseMultipleParamsWithOffset

-- | Decode UncurseMultiple params (discards final offset)
decodeUncurseMultipleParams : BytesHex -> Optional [BytesHex]
decodeUncurseMultipleParams = decodeCurseMultipleParams

-- | Decode AddCustomObservers params with final offset (list of parties)
-- Format: [uint8 count][party...]
decodeAddCustomObserversParamsWithOffset : BytesHex -> Optional ([Party], Int)
decodeAddCustomObserversParamsWithOffset encoded = do
  (parties, finalOffset) <- decodePartyList encoded 0
  Some (parties, finalOffset)

-- | Decode AddCustomObservers params (discards final offset)
decodeAddCustomObserversParams : BytesHex -> Optional [Party]
decodeAddCustomObserversParams encoded = do
  (result, _) <- decodeAddCustomObserversParamsWithOffset encoded
  Some result

-- | Decode RemoveCustomObservers params with final offset (same as AddCustomObservers)
decodeRemoveCustomObserversParamsWithOffset : BytesHex -> Optional ([Party], Int)
decodeRemoveCustomObserversParamsWithOffset = decodeAddCustomObserversParamsWithOffset

-- | Decode RemoveCustomObservers params (discards final offset)
decodeRemoveCustomObserversParams : BytesHex -> Optional [Party]
decodeRemoveCustomObserversParams = decodeAddCustomObserversParams

-- ===========================================================================
-- ENCODE FUNCTIONS (for tests and Go integration)
-- ===========================================================================

-- | Encode Curse params
encodeCurseParams : BytesHex -> BytesHex
encodeCurseParams = encodeBytesHex

-- | Encode Uncurse params
encodeUncurseParams : BytesHex -> BytesHex
encodeUncurseParams = encodeBytesHex

-- | Encode CurseChain params
encodeCurseChainParams : Numeric 0 -> BytesHex
encodeCurseChainParams = encodeNumeric0

-- | Encode UncurseChain params
encodeUncurseChainParams : Numeric 0 -> BytesHex
encodeUncurseChainParams = encodeNumeric0

-- | Encode CurseMultiple params
encodeCurseMultipleParams : [BytesHex] -> BytesHex
encodeCurseMultipleParams = encodeBytesHexList

-- | Encode UncurseMultiple params
encodeUncurseMultipleParams : [BytesHex] -> BytesHex
encodeUncurseMultipleParams = encodeBytesHexList

-- | Encode AddCustomObservers params
encodeAddCustomObserversParams : [Party] -> BytesHex
encodeAddCustomObserversParams = encodePartyList

-- | Encode RemoveCustomObservers params
encodeRemoveCustomObserversParams : [Party] -> BytesHex
encodeRemoveCustomObserversParams = encodePartyList

-- ===========================================================================
-- PRIMITIVE TYPE HELPERS
-- Note: These are duplicated here to avoid circular dependency with ccip-common
-- ===========================================================================

-- | Encode BytesHex with uint8 length prefix
encodeBytesHex : BytesHex -> BytesHex
encodeBytesHex bh =
  let len = byteCount bh
  in fromSome (encodeUint8 len) <> bh

-- | Decode BytesHex with uint8 length prefix
decodeBytesHexAt : BytesHex -> Int -> Optional (BytesHex, Int)
decodeBytesHexAt encoded offset = do
  lenHex <- extractBytes encoded offset 1
  len <- decodeUint8 lenHex
  bytes <- extractBytes encoded (offset + 1) len
  Some (bytes, offset + 1 + len)

-- | Encode list of BytesHex
encodeBytesHexList : [BytesHex] -> BytesHex
encodeBytesHexList items =
  let count = length items
  in fromSome (encodeUint8 count) <> foldl (\acc bh -> acc <> encodeBytesHex bh) "" items

-- | Decode list of BytesHex
decodeBytesHexList : BytesHex -> Int -> Optional ([BytesHex], Int)
decodeBytesHexList encoded offset = do
  countHex <- extractBytes encoded offset 1
  count <- decodeUint8 countHex
  decodeBytesHexListHelper encoded (offset + 1) count []

decodeBytesHexListHelper : BytesHex -> Int -> Int -> [BytesHex] -> Optional ([BytesHex], Int)
decodeBytesHexListHelper encoded offset 0 acc = Some (reverse acc, offset)
decodeBytesHexListHelper encoded offset remaining acc = do
  (bh, newOffset) <- decodeBytesHexAt encoded offset
  decodeBytesHexListHelper encoded newOffset (remaining - 1) (bh :: acc)

-- | Encode Party with uint8 length prefix
encodeParty : Party -> BytesHex
encodeParty party =
  let partyHex = toHex (partyToText party)
      len = byteCount partyHex
  in fromSome (encodeUint8 len) <> partyHex

-- | Decode Party with uint8 length prefix
decodePartyAt : BytesHex -> Int -> Optional (Party, Int)
decodePartyAt encoded offset = do
  lenHex <- extractBytes encoded offset 1
  len <- decodeUint8 lenHex
  partyHex <- extractBytes encoded (offset + 1) len
  partyText <- fromHex partyHex
  party <- partyFromText partyText
  Some (party, offset + 1 + len)

-- | Encode list of parties
encodePartyList : [Party] -> BytesHex
encodePartyList parties =
  let count = length parties
  in fromSome (encodeUint8 count) <> foldl (\acc p -> acc <> encodeParty p) "" parties

-- | Decode list of parties
decodePartyList : BytesHex -> Int -> Optional ([Party], Int)
decodePartyList encoded offset = do
  countHex <- extractBytes encoded offset 1
  count <- decodeUint8 countHex
  decodePartyListHelper encoded (offset + 1) count []

decodePartyListHelper : BytesHex -> Int -> Int -> [Party] -> Optional ([Party], Int)
decodePartyListHelper encoded offset 0 acc = Some (reverse acc, offset)
decodePartyListHelper encoded offset remaining acc = do
  (party, newOffset) <- decodePartyAt encoded offset
  decodePartyListHelper encoded newOffset (remaining - 1) (party :: acc)

