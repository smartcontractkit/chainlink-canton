module CCIP.CoreV2.FeeQuoter(
    module CCIP.CoreV2.FeeQuoter,
    module CCIP.CoreV2.FeeQuoterTypes
) where

import DA.Crypto.Text (byteCount)
import DA.Foldable qualified as Foldable
import DA.List (unique, dedup, (\\))
import DA.Map qualified as Map
import DA.Optional
import DA.Set qualified as Set

import qualified Splice.Api.Token.HoldingV1
import qualified Splice.Api.Token.MetadataV1

import qualified Chainlink.InstanceAddress

import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiverView(..))
import MCMS.Codec (decodePartyList)

import qualified CCIP.APIV2.FeeQuoter
import qualified CCIP.CodecV2.Math
import qualified CCIP.CoreV2.SendingMessage

import CCIP.CoreV2.FeeQuoterCodecGen (
    decodeApplyPriceUpdatersUpdateParamsAt,
    decodeUpdatePricesParamsAt,
    decodeRemoveFeeTokensParamsAt,
    decodeApplyFeeQuoterDestChainConfigUpdatesParamsAt,
    )
import CCIP.CoreV2.FeeQuoterTypes (
    FeeQuoterDestChainConfigArgs(..),
    FeeQuoterDestChainConfig(..),
    PriceUpdates(..),
    TokenPriceUpdate(..),
    GasPriceUpdate(..),
    ApplyPriceUpdatersUpdateParams(..),
    UpdatePricesParams(..),
    RemoveFeeTokensParams(..),
    ApplyFeeQuoterDestChainConfigUpdatesParams(..),
    )


rawInstanceAddress : FeeQuoter -> Chainlink.InstanceAddress.RawInstanceAddress
rawInstanceAddress feeQuoter = Chainlink.InstanceAddress.make feeQuoter.instanceId feeQuoter.ccipOwner

gasCostUsdCents : Decimal -> Int -> Numeric 0
gasCostUsdCents usdPerUnitGas gasUnits =
    CCIP.CoreV2.SendingMessage.gasCostUsdCents usdPerUnitGas gasUnits

template FeeQuoter
    with
        instanceId : Text
        ccipOwner : Party

        -- | Set of fee tokens that can be used to pay for fees.
        feeTokens : Set.Set Splice.Api.Token.HoldingV1.InstrumentId
        destChainConfigs : Map.Map (Numeric 0) FeeQuoterDestChainConfig
        tokenTransferFeeConfigs : Map.Map (Numeric 0) (Map.Map Splice.Api.Token.HoldingV1.InstrumentId TokenTransferFeeConfig)

        usdPerUnitGasByDestChainSelector : Map.Map (Numeric 0) TimestampedPrice
        usdPerToken : Map.Map Splice.Api.Token.HoldingV1.InstrumentId TimestampedPrice
        linkTokenInstrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        -- | Token prices are stored as Decimal in the 10-decimal convention.
        -- | List of parties that are authorized to update prices, they'll be observers on the contract.
        priceUpdaters : [Party]
    where
        signatory ccipOwner
        observer priceUpdaters
        ensure Chainlink.InstanceAddress.assertValidInstanceId instanceId && unique priceUpdaters

        interface instance CCIP.APIV2.FeeQuoter.IFeeQuoter for FeeQuoter where
            view = CCIP.APIV2.FeeQuoter.FeeQuoterView with
                ccipOwner = ccipOwner
                instanceId = instanceId
                context = Splice.Api.Token.MetadataV1.emptyChoiceContext

            feeQuoter_publicFetchImpl self arg = do
                Chainlink.InstanceAddress.assertEqual "FeeQuoter: expected address mismatch" instanceId ccipOwner arg.expectedAddress
                pure CCIP.APIV2.FeeQuoter.FeeQuoterView with
                    ccipOwner = ccipOwner
                    instanceId = instanceId
                    context = Splice.Api.Token.MetadataV1.emptyChoiceContext

            feeQuoter_getTokenPriceImpl self arg = do
                price <- exercise (fromInterfaceContractId @FeeQuoter self) GetTokenPrice with
                    token = arg.token
                    context = arg.context
                    caller = arg.caller
                pure CCIP.APIV2.FeeQuoter.TimestampedPrice with
                    price = price.price
                    timestamp = price.timestamp
                    context = Splice.Api.Token.MetadataV1.emptyChoiceContext

            feeQuoter_getDestinationChainGasPriceImpl self arg = do
                price <- exercise (fromInterfaceContractId @FeeQuoter self) GetDestinationChainGasPrice with
                    destChainSelector = arg.destChainSelector
                    context = arg.context
                    caller = arg.caller
                pure CCIP.APIV2.FeeQuoter.TimestampedPrice with
                    price = price.price
                    timestamp = price.timestamp
                    context = Splice.Api.Token.MetadataV1.emptyChoiceContext

            feeQuoter_getTokenTransferFeeImpl self arg = do
                exercise (fromInterfaceContractId @FeeQuoter self) GetTokenTransferFee with
                    destChainSelector = arg.destChainSelector
                    token = arg.token
                    context = arg.context
                    caller = arg.caller

            feeQuoter_quoteGasForExecImpl self arg = do
                result <- exercise (fromInterfaceContractId @FeeQuoter self) QuoteGasForExec with
                    destChainSelector = arg.destChainSelector
                    nonCalldataGas = arg.nonCalldataGas
                    calldataSize = arg.calldataSize
                    feeToken = arg.feeToken
                    context = arg.context
                    caller = arg.caller
                pure CCIP.APIV2.FeeQuoter.QuoteGasForExecResult with
                    totalGas = result.totalGas
                    gasCostUSDCents = result.gasCostUSDCents
                    feeTokenPrice = result.feeTokenPrice
                    premiumMultiplier = result.premiumMultiplier
                    context = Splice.Api.Token.MetadataV1.emptyChoiceContext

            feeQuoter_getFeeTokensImpl self arg = do
                exercise (fromInterfaceContractId @FeeQuoter self) GetFeeTokens with
                    context = arg.context
                    caller = arg.caller

        nonconsuming choice Get : FeeQuoter
            with
                caller : Party
            controller caller
            do pure this

        -- ================================================================
        -- │                          Prices                              │
        -- ================================================================

        -- | Get the `tokenPrice` for a given token.
        nonconsuming choice GetTokenPrice : TimestampedPrice
            with
                token : Splice.Api.Token.HoldingV1.InstrumentId
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                caller : Party
            controller caller
            do
                return (fromSomeNote ("No price found for " <> token.id) (Map.lookup token usdPerToken))

        -- | Get the gas price for a given destination chain.
        nonconsuming choice GetDestinationChainGasPrice : TimestampedPrice
            with
                destChainSelector : Numeric 0
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                caller : Party
            controller caller
            do
                return (fromSomeNote ("No gas price found for " <> show destChainSelector) (Map.lookup destChainSelector usdPerUnitGasByDestChainSelector))

        -- Applies updates to the list of authorized price updaters.
        -- Parties are removed from the list first, then added, so a party that is both removed and added will remain in the list.
        --
        -- Params:
        -- addedPriceUpdaters: list of parties to add to the list of authorized price updaters
        -- removedPriceUpdaters: list of parties to remove from the list of authorized price updaters
        --
        -- Only callable by the ccipOwner.
        choice ApplyPriceUpdatersUpdate : ContractId FeeQuoter
            with
                addedPriceUpdaters : [Party]
                removedPriceUpdaters : [Party]
            controller ccipOwner
            do
                let newPriceUpdaters =
                        filter (/= ccipOwner) (dedup ((priceUpdaters \\ removedPriceUpdaters) ++ addedPriceUpdaters))
                create this with priceUpdaters = newPriceUpdaters

        -- Update the price for given tokens and gas prices for given chains.
        --
        -- Params:
        -- priceUpdates: The price updates to apply.
        -- caller: Listed price updater, or the contract ccipOwner (ccipOwner need not appear in priceUpdaters).
        --
        -- Callable when caller is in priceUpdaters or caller is ccipOwner.
        choice UpdatePrices : ContractId FeeQuoter
            with
                priceUpdates : PriceUpdates
                caller : Party
            controller caller
            do
                -- The caller must be an authorized price updater or the ccipOwner.
                assertMsg
                    ("Caller is not an authorized price updater or ccipOwner: " <> show caller)
                    (caller `elem` priceUpdaters || caller == ccipOwner)

                -- Validate price bounds
                Foldable.mapA_ (\tpu ->
                    assertMsg ("token price must be positive: " <> tpu.instrumentId.id) (tpu.usdPerToken > 0.0)
                    ) priceUpdates.tokenPriceUpdates
                Foldable.mapA_ (\gpu ->
                    assertMsg ("gas price must be non-negative for chain " <> show gpu.destChainSelector) (gpu.usdPerUnitGas >= 0.0)
                    ) priceUpdates.gasPriceUpdates

                now <- getTime
                let newUsdPerToken = foldl (\acc tpu -> Map.insert tpu.instrumentId (TimestampedPrice tpu.usdPerToken now) acc) usdPerToken priceUpdates.tokenPriceUpdates
                let newUsdPerUnitGasByDestChainSelector = foldl (\acc gpu -> Map.insert gpu.destChainSelector (TimestampedPrice gpu.usdPerUnitGas now) acc) usdPerUnitGasByDestChainSelector priceUpdates.gasPriceUpdates
                let newFeeTokens =
                        foldl
                            (\acc tpu -> Set.insert tpu.instrumentId acc)
                            feeTokens
                            priceUpdates.tokenPriceUpdates
                create this with
                    feeTokens = newFeeTokens
                    usdPerToken = newUsdPerToken
                    usdPerUnitGasByDestChainSelector = newUsdPerUnitGasByDestChainSelector

        choice AddPriceUpdaters : ContractId FeeQuoter
            with
                parties : [Party]
            controller ccipOwner
            do
                create this with
                    priceUpdaters =
                        filter (/= ccipOwner)
                            (dedup (priceUpdaters ++ parties))

        choice RemovePriceUpdaters : ContractId FeeQuoter
            with
                parties : [Party]
            controller ccipOwner
            do
                create this with
                    priceUpdaters = filter (`notElem` parties) priceUpdaters

        -- ================================================================
        -- │                         Fee Quoting                          │
        -- ================================================================

        nonconsuming choice GetTokenTransferFee : (Numeric 0, Int, Int)
            with
                destChainSelector : Numeric 0
                token : Splice.Api.Token.HoldingV1.InstrumentId
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                caller : Party
            controller caller
            do
                let tokenConfig = do
                        perChain <- Map.lookup destChainSelector tokenTransferFeeConfigs
                        Map.lookup token perChain
                case tokenConfig of
                    Some config | config.isEnabled ->
                        return (config.feeUSD, config.destGasOverhead, config.destBytesOverhead)
                    _ -> do
                        let defaultConfig = fromSomeNote
                                ("No dest chain config found for " <> show destChainSelector)
                                (Map.lookup destChainSelector destChainConfigs)
                        return (defaultConfig.defaultTokenFeeUSD, defaultConfig.defaultTokenDestGasOverhead, 32)

        -- Quotes the total gas and gas cost in USD cents.
        --
        -- Params:
        -- destChainSelector: The destination chain selector.
        -- nonCalldataGas: The non-calldata gas to be used for the message.
        -- calldataSize: The size of the calldata in bytes.
        -- feeToken: The fee token the message will be paid for with.
        -- caller: The party calling this function.
        --
        -- Callable by any party.
        nonconsuming choice QuoteGasForExec : QuoteGasForExecResult
            with
                destChainSelector : Numeric 0
                nonCalldataGas : Int
                calldataSize : Int
                feeToken : Splice.Api.Token.HoldingV1.InstrumentId
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                caller : Party
            controller caller
            do
                let destChainConfig = fromSomeNote
                        ("No dest chain config found for " <> show destChainSelector)
                        (Map.lookup destChainSelector destChainConfigs)
                assertMsg "feequoter: destination chain disabled" destChainConfig.isEnabled

                let totalGas =
                        nonCalldataGas + calldataSize * destChainConfig.destGasPerPayloadByteBase
                assertMsg "feequoter: message gas limit too high"
                    (totalGas <= destChainConfig.maxPerMsgGasLimit)
                assertMsg "feequoter: message too large"
                    (calldataSize <= destChainConfig.maxDataBytes)
                assertMsg ("Fee token not configured: " <> feeToken.id)
                    (Set.member feeToken feeTokens)

                gasPrice <- exercise self GetDestinationChainGasPrice with
                    destChainSelector = destChainSelector
                    context = context
                    caller = caller
                feeTokenPrice <- exercise self GetTokenPrice with
                    token = feeToken
                    context = context
                    caller = caller
                -- LINK gets a discounted multiplier (e.g. 90% → 9e9 in E10); other tokens get
                -- premiumIdentity (1e10 = 100%).
                let premiumMultiplier =
                        if feeToken == linkTokenInstrumentId
                        then CCIP.CodecV2.Math.numeric0ToDecimal (destChainConfig.linkFeeMultiplierPercent * CCIP.CodecV2.Math.e10PerPercent)
                        else CCIP.CodecV2.Math.numeric0ToDecimal CCIP.CodecV2.Math.premiumIdentity
                let gasCostUSDCents =
                        gasCostUsdCents gasPrice.price totalGas
                pure QuoteGasForExecResult with
                    totalGas
                    gasCostUSDCents
                    feeTokenPrice = feeTokenPrice.price
                    premiumMultiplier

        -- ================================================================
        -- │                         Fee Tokens                           │
        -- ================================================================

        -- | Get the list of supported fee tokens.
        nonconsuming choice GetFeeTokens : [Splice.Api.Token.HoldingV1.InstrumentId]
            with
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                caller : Party
            controller caller
            do
                return (Set.toList feeTokens)

        choice RemoveFeeTokens : ContractId FeeQuoter
            with
                feeTokensToRemove : [Splice.Api.Token.HoldingV1.InstrumentId]
            controller ccipOwner
            do
                let newFeeTokens = foldl (\acc tk -> Set.delete tk acc) feeTokens feeTokensToRemove
                let newUsdPerToken = foldl (\acc tk -> Map.delete tk acc) usdPerToken feeTokensToRemove
                create this with
                    feeTokens = newFeeTokens
                    usdPerToken = newUsdPerToken

        -- ================================================================
        -- │                           Configs                            │
        -- ================================================================

        nonconsuming choice GetDestChainConfig : FeeQuoterDestChainConfig
            with
                destChainSelector : Numeric 0
                caller : Party
            controller caller
            do
                return (fromSomeNote ("No dest chain config found for " <> show destChainSelector) (Map.lookup destChainSelector destChainConfigs))

        choice ApplyFeeQuoterDestChainConfigUpdates : ContractId FeeQuoter
            with
                destChainConfigArgs : [FeeQuoterDestChainConfigArgs]
            controller ccipOwner
            do
                -- destChainSelector must be greater than zero
                -- defaultTxGasLimit must be set, must be less than maxPerMsgGasLimit
                Foldable.mapA_ (\dcca -> do
                        assertMsg ("destChainSelector must be greater than zero: " <> show dcca.destChainSelector) (dcca.destChainSelector > 0.0)
                        assertMsg ("defaultTxGasLimit must be set (> 0) for destChainSelector: " <> show dcca.destChainSelector) (dcca.destChainConfig.defaultTxGasLimit > 0)
                        assertMsg ("defaultTxGasLimit must be less than maxPerMsgGasLimit for destChainSelector: " <> show dcca.destChainSelector) (dcca.destChainConfig.defaultTxGasLimit < dcca.destChainConfig.maxPerMsgGasLimit)
                        assertMsg ("linkFeeMultiplierPercent must be positive for destChainSelector: " <> show dcca.destChainSelector) (dcca.destChainConfig.linkFeeMultiplierPercent > 0.0)
                    ) destChainConfigArgs

                let newDestChainConfigs = foldl (\acc dcca -> Map.insert dcca.destChainSelector dcca.destChainConfig acc) destChainConfigs destChainConfigArgs
                create this with destChainConfigs = newDestChainConfigs

        interface instance MCMSReceiver for FeeQuoter where
            view = MCMSReceiverView with
                mcmsController = ccipOwner
                instanceId

            mcmsEntrypoint functionName operationData contractIds = do
                let instAddr = instanceId <> "@" <> partyToText ccipOwner
                selfCid <- case Map.lookup instAddr contractIds of
                    None -> abort $ "E_SELF_CID_NOT_IN_MAP: " <> instAddr
                    Some cid -> pure (coerceContractId cid : ContractId FeeQuoter)

                case functionName of
                    "ApplyPriceUpdatersUpdate" -> do
                        case decodeApplyPriceUpdatersUpdateParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: ApplyPriceUpdatersUpdate"
                            Some (ApplyPriceUpdatersUpdateParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: ApplyPriceUpdatersUpdate" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid ApplyPriceUpdatersUpdate with
                                    addedPriceUpdaters
                                    removedPriceUpdaters
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "UpdatePrices" -> do
                        case decodeUpdatePricesParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: UpdatePrices"
                            Some (UpdatePricesParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: UpdatePrices" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid UpdatePrices with
                                    priceUpdates
                                    caller
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "RemoveFeeTokens" -> do
                        case decodeRemoveFeeTokensParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: RemoveFeeTokens"
                            Some (RemoveFeeTokensParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: RemoveFeeTokens" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid RemoveFeeTokens with
                                    feeTokensToRemove
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "ApplyFeeQuoterDestChainConfigUpdates" -> do
                        case decodeApplyFeeQuoterDestChainConfigUpdatesParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: ApplyFeeQuoterDestChainConfigUpdates"
                            Some (ApplyFeeQuoterDestChainConfigUpdatesParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: ApplyFeeQuoterDestChainConfigUpdates" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid ApplyFeeQuoterDestChainConfigUpdates with
                                    destChainConfigArgs
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "AddPriceUpdaters" -> do
                        case decodePartyList operationData 0 of
                            None -> abort "E_INVALID_PARAMS: AddPriceUpdaters"
                            Some (parties, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: AddPriceUpdaters" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid AddPriceUpdaters with parties
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "RemovePriceUpdaters" -> do
                        case decodePartyList operationData 0 of
                            None -> abort "E_INVALID_PARAMS: RemovePriceUpdaters"
                            Some (parties, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: RemovePriceUpdaters" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid RemovePriceUpdaters with parties
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    _ -> abort $ "E_UNKNOWN_FUNCTION: " <> functionName

data TokenTransferFeeConfig = TokenTransferFeeConfig
    with
        isEnabled : Bool
        -- Legacy field name retained; value is integer USD cents.
        feeUSD : Numeric 0
        destGasOverhead : Int
        destBytesOverhead : Int
    deriving (Eq, Show)

data TimestampedPrice = TimestampedPrice
    with
        -- 10-decimal USD price, stored as Decimal.
        price : Decimal
        timestamp : Time
    deriving (Eq, Show)

data QuoteGasForExecResult = QuoteGasForExecResult
    with
        totalGas : Int
        gasCostUSDCents : Numeric 0
        feeTokenPrice : Decimal
        premiumMultiplier : Decimal
    deriving (Eq, Show)