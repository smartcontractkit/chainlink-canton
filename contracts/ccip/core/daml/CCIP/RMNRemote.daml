-- | RMN (Risk Management Network) for Canton CCIP.
-- Provides emergency stop capability via curse mechanism matching EVM RMNRemote.sol.
module CCIP.RMNRemote where

import DA.Crypto.Text (BytesHex, byteCount)
import DA.Foldable qualified as Foldable
import DA.List (dedup)
import DA.Map qualified as Map
import DA.Optional (fromSomeNote)

import qualified Splice.Api.Token.MetadataV1

import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiverView(..))

import qualified Chainlink.InstanceAddress

import qualified CCIP.API.RMNRemoteV1
import CCIP.NumericHex qualified as NumericHex

import CCIP.RMNRemoteCodecGen (
    decodeCurseParamsAt,
    decodeUncurseParamsAt,
    decodeCurseChainParamsAt,
    decodeUncurseChainParamsAt,
    decodeCurseMultipleParamsAt,
    decodeUncurseMultipleParamsAt,
    decodeAddCustomObserversParamsAt,
    decodeRemoveCustomObserversParamsAt,
    )
import CCIP.RMNRemoteTypes (
    CurseParams(..),
    UncurseParams(..),
    CurseChainParams(..),
    UncurseChainParams(..),
    CurseMultipleParams(..),
    UncurseMultipleParams(..),
    AddCustomObserversParams(..),
    RemoveCustomObserversParams(..),
    )

-- Global curse subject matching EVM: bytes16(uint128(0x01000000000000000000000000000001))
globalCurseSubject : BytesHex
globalCurseSubject = "01000000000000000000000000000001"

-- Convert chain selector to 16-byte curse subject matching EVM: bytes16(uint128(chainSelector))
chainSelectorToSubject : Numeric 0 -> BytesHex
chainSelectorToSubject chainSelector =
    let subject =
            fromSomeNote "RMNRemote: invalid chain selector"
                (NumericHex.encodeUint64 chainSelector)
    in NumericHex.padLeft 32 "0" subject

mergeCustomObservers : Party -> Party -> [Party] -> [Party] -> [Party]
mergeCustomObservers rmnOwner ccipOwner current additions =
    filter (\p -> p /= rmnOwner && p /= ccipOwner) (dedup (current ++ additions))

removeCustomObservers : [Party] -> [Party] -> [Party]
removeCustomObservers current removals =
    filter (`notElem` removals) current


-- | RMN contract providing curse capability for emergency stops.
-- Separate rmnOwner party allows independent control from ccipOwner.
template RMNRemote
    with
        instanceId : Text              -- Unique identifier for this RMN instance
        rmnOwner : Party               -- Party controlling curse operations
        ccipOwner : Party              -- For deployment association/validation
        customObservers : [Party]      -- Additional parties allowed to observe RMN state
        cursedSubjects : [BytesHex]    -- Currently cursed subjects (global or chain-specific)
    where
        signatory rmnOwner
        observer ccipOwner, customObservers
        ensure Chainlink.InstanceAddress.assertValidInstanceId instanceId

        interface instance CCIP.API.RMNRemoteV1.RMNRemote for RMNRemote where
            view = CCIP.API.RMNRemoteV1.RMNRemoteView with
                ccipOwner
                rmnOwner
                instanceId

            rmnRemote_publicFetchImpl self arg = do
                Chainlink.InstanceAddress.assertEqual "RMNRemote: expectedAddress mismatch" instanceId rmnOwner arg.expectedAddress
                pure CCIP.API.RMNRemoteV1.RMNRemoteView with
                    ccipOwner
                    rmnOwner
                    instanceId

            rmnRemote_isCursedImpl self arg = do
                exercise (fromInterfaceContractId @RMNRemote self) IsCursed
                    with
                        context = arg.context
                        caller = arg.caller

            rmnRemote_isCursedForChainImpl self arg = do
                exercise (fromInterfaceContractId @RMNRemote self) IsCursedForChain
                    with
                        chainSelector = arg.chainSelector
                        context = arg.context
                        caller = arg.caller

            rmnRemote_getCursedSubjectsImpl self arg = do
                exercise (fromInterfaceContractId @RMNRemote self) GetCursedSubjects
                    with
                        context = arg.context
                        caller = arg.caller

        -- Check if globally cursed
        nonconsuming choice IsCursed : Bool
            with
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                caller : Party
            controller caller
            do pure (globalCurseSubject `elem` cursedSubjects)

        -- Check if cursed for specific chain (global OR chain-specific)
        nonconsuming choice IsCursedForChain : Bool
            with
                chainSelector : Numeric 0
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                caller : Party
            controller caller
            do
                let chainSubject = chainSelectorToSubject chainSelector
                -- Reject any selector whose derived subject equals the global curse subject so
                -- per-chain checks stay distinct from global curse state.
                assertMsg "rmn: chain selector maps to reserved global curse subject"
                    (chainSubject /= globalCurseSubject)
                pure (globalCurseSubject `elem` cursedSubjects
                      || chainSubject `elem` cursedSubjects)

        -- Get all cursed subjects
        nonconsuming choice GetCursedSubjects : [BytesHex]
            with
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                caller : Party
            controller caller
            do pure cursedSubjects

        -- Curse a subject (only rmnOwner)
        choice Curse : ContractId RMNRemote
            with
                subject : BytesHex
            controller rmnOwner
            do
                assertMsg "rmn: subject already cursed" (subject `notElem` cursedSubjects)
                create this with cursedSubjects = subject :: cursedSubjects

        -- Uncurse a subject (only rmnOwner)
        choice Uncurse : ContractId RMNRemote
            with
                subject : BytesHex
            controller rmnOwner
            do
                assertMsg "rmn: subject not cursed" (subject `elem` cursedSubjects)
                create this with cursedSubjects = filter (/= subject) cursedSubjects

        -- Curse globally (convenience choice)
        choice CurseGlobal : ContractId RMNRemote
            controller rmnOwner
            do
                assertMsg "rmn: already globally cursed" (globalCurseSubject `notElem` cursedSubjects)
                create this with cursedSubjects = globalCurseSubject :: cursedSubjects

        -- Uncurse globally (convenience choice)
        choice UncurseGlobal : ContractId RMNRemote
            controller rmnOwner
            do
                assertMsg "rmn: not globally cursed" (globalCurseSubject `elem` cursedSubjects)
                create this with cursedSubjects = filter (/= globalCurseSubject) cursedSubjects

        -- Curse a specific chain (convenience choice)
        choice CurseChain : ContractId RMNRemote
            with
                chainSelector : Numeric 0
            controller rmnOwner
            do
                let subject = chainSelectorToSubject chainSelector
                assertMsg "rmn: chain selector maps to reserved global curse subject"
                    (subject /= globalCurseSubject)
                assertMsg "rmn: chain already cursed" (subject `notElem` cursedSubjects)
                create this with cursedSubjects = subject :: cursedSubjects

        -- Uncurse a specific chain (convenience choice)
        choice UncurseChain : ContractId RMNRemote
            with
                chainSelector : Numeric 0
            controller rmnOwner
            do
                let subject = chainSelectorToSubject chainSelector
                assertMsg "rmn: chain selector maps to reserved global curse subject"
                    (subject /= globalCurseSubject)
                assertMsg "rmn: chain not cursed" (subject `elem` cursedSubjects)
                create this with cursedSubjects = filter (/= subject) cursedSubjects

        -- Curse multiple subjects atomically
        choice CurseMultiple : ContractId RMNRemote
            with
                subjects : [BytesHex]
            controller rmnOwner
            do
                assertMsg "rmn: duplicate subjects in curse request"
                    (length subjects == length (dedup subjects))
                Foldable.forA_ subjects (\subject ->
                    assertMsg "rmn: subject already cursed" (subject `notElem` cursedSubjects))
                create this with cursedSubjects = subjects ++ cursedSubjects

        -- Uncurse multiple subjects atomically
        choice UncurseMultiple : ContractId RMNRemote
            with
                subjects : [BytesHex]
            controller rmnOwner
            do
                assertMsg "rmn: duplicate subjects in uncurse request"
                    (length subjects == length (dedup subjects))
                Foldable.forA_ subjects (\subject ->
                    assertMsg "rmn: subject not cursed" (subject `elem` cursedSubjects))
                create this with cursedSubjects = filter (`notElem` subjects) cursedSubjects

        -- Add additional observer parties managed by rmnOwner.
        choice AddCustomObservers : ContractId RMNRemote
            with
                parties : [Party]
            controller rmnOwner
            do
                create this with
                    customObservers = mergeCustomObservers rmnOwner ccipOwner customObservers parties

        -- Remove additional observer parties managed by rmnOwner.
        choice RemoveCustomObservers : ContractId RMNRemote
            with
                parties : [Party]
            controller rmnOwner
            do
                create this with
                    customObservers = removeCustomObservers customObservers parties

        -- Update ccipOwner (for deployment migrations)
        choice UpdateCCIPOwner : ContractId RMNRemote
            with
                newCCIPOwner : Party
            controller rmnOwner
            do
                create this with
                    ccipOwner = newCCIPOwner
                    customObservers = filter (/= newCCIPOwner) customObservers

        interface instance MCMSReceiver for RMNRemote where
          view = MCMSReceiverView with
            mcmsController = rmnOwner
            instanceId

          mcmsEntrypoint functionName operationData contractIds = do
            let instAddr = instanceId <> "@" <> partyToText rmnOwner
            selfCid <- case Map.lookup instAddr contractIds of
              None -> abort $ "E_SELF_CID_NOT_IN_MAP: " <> instAddr
              Some cid -> pure (coerceContractId cid : ContractId RMNRemote)

            case functionName of
              "Curse" -> do
                case decodeCurseParamsAt operationData 0 of
                  None -> abort "E_INVALID_PARAMS: Curse"
                  Some (CurseParams{..}, finalOffset) -> do
                    assertMsg "E_TRAILING_BYTES: Curse" $
                      finalOffset == byteCount operationData
                    newCid <- exercise selfCid Curse with subject
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              "Uncurse" -> do
                case decodeUncurseParamsAt operationData 0 of
                  None -> abort "E_INVALID_PARAMS: Uncurse"
                  Some (UncurseParams{..}, finalOffset) -> do
                    assertMsg "E_TRAILING_BYTES: Uncurse" $
                      finalOffset == byteCount operationData
                    newCid <- exercise selfCid Uncurse with subject
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              "CurseChain" -> do
                case decodeCurseChainParamsAt operationData 0 of
                  None -> abort "E_INVALID_PARAMS: CurseChain"
                  Some (CurseChainParams{..}, finalOffset) -> do
                    assertMsg "E_TRAILING_BYTES: CurseChain" $
                      finalOffset == byteCount operationData
                    newCid <- exercise selfCid CurseChain with chainSelector
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              "UncurseChain" -> do
                case decodeUncurseChainParamsAt operationData 0 of
                  None -> abort "E_INVALID_PARAMS: UncurseChain"
                  Some (UncurseChainParams{..}, finalOffset) -> do
                    assertMsg "E_TRAILING_BYTES: UncurseChain" $
                      finalOffset == byteCount operationData
                    newCid <- exercise selfCid UncurseChain with chainSelector
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              "CurseMultiple" -> do
                case decodeCurseMultipleParamsAt operationData 0 of
                  None -> abort "E_INVALID_PARAMS: CurseMultiple"
                  Some (CurseMultipleParams{..}, finalOffset) -> do
                    assertMsg "E_TRAILING_BYTES: CurseMultiple" $
                      finalOffset == byteCount operationData
                    newCid <- exercise selfCid CurseMultiple with subjects
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              "UncurseMultiple" -> do
                case decodeUncurseMultipleParamsAt operationData 0 of
                  None -> abort "E_INVALID_PARAMS: UncurseMultiple"
                  Some (UncurseMultipleParams{..}, finalOffset) -> do
                    assertMsg "E_TRAILING_BYTES: UncurseMultiple" $
                      finalOffset == byteCount operationData
                    newCid <- exercise selfCid UncurseMultiple with subjects
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              "AddCustomObservers" -> do
                case decodeAddCustomObserversParamsAt operationData 0 of
                  None -> abort "E_INVALID_PARAMS: AddCustomObservers"
                  Some (AddCustomObserversParams{..}, finalOffset) -> do
                    assertMsg "E_TRAILING_BYTES: AddCustomObservers" $
                      finalOffset == byteCount operationData
                    newCid <- exercise selfCid AddCustomObservers with parties
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              "RemoveCustomObservers" -> do
                case decodeRemoveCustomObserversParamsAt operationData 0 of
                  None -> abort "E_INVALID_PARAMS: RemoveCustomObservers"
                  Some (RemoveCustomObserversParams{..}, finalOffset) -> do
                    assertMsg "E_TRAILING_BYTES: RemoveCustomObservers" $
                      finalOffset == byteCount operationData
                    newCid <- exercise selfCid RemoveCustomObservers with parties
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              _ -> abort $ "E_UNKNOWN_FUNCTION: " <> functionName
