-- | Types module for TokenAdminRegistry
-- Separate module to enable auto-generated codec via go-daml
module CCIP.CoreV1.TokenAdminRegistryTypes
  ( PoolRegistration(..)
  , SetPoolParams(..)
  , SetTransferFactoryParams(..)
  , SetBurnMintFactoryParams(..)
  , ProposeAdminParams(..)
  , TransferAdminParams(..)
  , AcceptAdminParams(..)
  ) where

import qualified Splice.Api.Token.HoldingV1

import qualified Chainlink.InstanceAddress

-- | Registered pool identity for a token instrument.
data PoolRegistration = PoolRegistration
    with
        poolOwner : Party
        poolInstanceId : Text
    deriving (Eq, Show)

-- ===========================================================================
-- MCMS Choice Params Types
-- ===========================================================================

-- | Params for SetPool choice
data SetPoolParams = SetPoolParams
    with
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        tokenPool : Optional PoolRegistration
    deriving (Eq, Show)

-- | Params for SetTransferFactory choice.
--
-- MCMS operation data cannot carry arbitrary ContractIds because Daml cannot
-- decode a ContractId from bytes. The address is resolved through the
-- MCMS-provided contractIds map.
data SetTransferFactoryParams = SetTransferFactoryParams
    with
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        transferFactoryAddress : Optional Chainlink.InstanceAddress.RawInstanceAddress
    deriving (Eq, Show)

-- | Params for SetBurnMintFactory choice.
--
-- MCMS operation data cannot carry arbitrary ContractIds because Daml cannot
-- decode a ContractId from bytes. The address is resolved through the
-- MCMS-provided contractIds map.
data SetBurnMintFactoryParams = SetBurnMintFactoryParams
    with
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        burnMintFactoryAddress : Optional Chainlink.InstanceAddress.RawInstanceAddress
    deriving (Eq, Show)

-- | Params for ProposeAdmin choice
data ProposeAdminParams = ProposeAdminParams
    with
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        newAdmin : Party
    deriving (Eq, Show)

-- | Params for TransferAdmin choice (same structure as ProposeAdminParams)
data TransferAdminParams = TransferAdminParams
    with
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        newAdmin : Party
    deriving (Eq, Show)

-- | Params for AcceptAdmin choice
data AcceptAdminParams = AcceptAdminParams
    with
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
    deriving (Eq, Show)