-- | Ticket contracts for cross-participant CCIP communication.
module CCIP.Tickets where

import DA.Crypto.Text (BytesHex)
import DA.List (dedup)

import qualified CCIP.FinalityConfig
import Chainlink.InstanceAddress (RawInstanceAddress)
import qualified Splice.Api.Token.HoldingV1

-- | Ticket issued by consuming ExecutingMessageV1 after successful message verification.
-- The signatory set includes CCV-owner parties accumulated during inbound verification,
-- giving third-party pools an independent trust check beyond ccipOwner alone.
template TokenReceiveTicket
    with
        ccipOwner : Party
        -- CCV owner parties accumulated from ExecutingMessageV1's finalize choice.
        -- Mirrors the widened signatory set for deterministic pool-side validation.
        ccvOwners : [Party]
        -- Exact CCV instances that verified the message on the inbound path.
        -- Pools use these to preserve instance-level trust checks.
        verifiedCCVs : [RawInstanceAddress]
        -- Resolved inbound pool-required CCV instances captured at execute-time.
        -- Uses EVM-equivalent semantics:
        --   * empty pool list means source defaults
        --   * useDefaultCCVs sentinel expands to source defaults
        requiredInboundPoolCCVs : [RawInstanceAddress]
        tokenAdminRegistryInstanceId : Text  -- Identifies the issuing TAR
        -- Exact registered pool instance that performed inbound pool verification.
        poolAddress : RawInstanceAddress
        poolOwner : Party           -- Observer - pool that should release
        receiver : Party            -- Message receiver (observer)
        tokenReceiver : Party       -- Who gets the tokens (may differ from receiver)

        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        amount : BytesHex
        sourcePoolData : BytesHex

        messageId : BytesHex
        sourceChainSelector : Numeric 0
        finality : CCIP.FinalityConfig.FinalityConfig
    where
        signatory dedup ([ccipOwner, poolOwner] ++ ccvOwners)
        observer receiver, tokenReceiver

        -- Consume the ticket under ccipOwner and poolOwner authority.
        -- Used by TokenAdminRegistry after it validates pool/instrument/instance checks,
        -- so pool claims do not require every CCV owner to co-authorize archive.
        choice Consume : ()
            controller ccipOwner, poolOwner
            do
                pure ()
