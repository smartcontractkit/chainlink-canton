-- | Sending message contract for outbound CCIP message processing.
-- Evolves from a static container to a collecting contract. Each consuming
-- choice consumes the old contract and creates a new one with appended data.
-- The ccipOwner signatory is inherited from the consumed contract, so any
-- caller can trigger the mutation.
module CCIP.SendingMessageV1 where

import DA.Crypto.Text (BytesHex, byteCount, keccak256)
import DA.Foldable qualified as Foldable
import DA.List (dedup, unique)
import DA.Optional (isNone, isSome, fromSome, fromOptional)
import DA.Text qualified as Text

import qualified CCIP.Events
import qualified CCIP.FinalityConfig
import qualified CCIP.Internal
import qualified CCIP.Math
import qualified CCIP.MessageCodecV1
import Chainlink.InstanceAddress qualified as RawInstanceAddress
import qualified CCIP.Tickets

import MCMS.Crypto (isValidHex)

import qualified Splice.Api.Token.HoldingV1
import qualified Splice.Api.Token.MetadataV1

import qualified CCIP.API.SendingMessageV1

data CCVFee = CCVFee
    with
        ccvInstanceId : Text
        ccvOwner : Party
        feeUSDCents : Numeric 0
        destGasLimit : Int
        destBytesOverhead : Int
    deriving (Eq, Show)

data TokenSendFee = TokenSendFee
    with
        poolInstanceId : Text
        poolOwner : Party
        feeUSDCents : Numeric 0
        destGasOverhead : Int
        destBytesOverhead : Int
    deriving (Eq, Show)

data VerifierData = VerifierData
    with
        ccvInstanceId : Text
        ccvOwner : Party
        versionTag : BytesHex
        verifierBlob : BytesHex
        messageSentObservers : [Party]
    deriving (Eq, Show)

data TokenSendData = TokenSendData
    with
        poolInstanceId : Text
        poolOwner : Party
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        amount : BytesHex
        destTokenAddress : BytesHex -- Dest address, unpadded bytes
        extraData : BytesHex
    deriving (Eq, Show)

data ExecutorFee = ExecutorFee
    with
        executorInstanceId : Text
        executorOwner : Party
        -- Legacy field name retained; value is integer USD cents.
        feeUSDCents : Numeric 0
    deriving (Eq, Show)

data ExecutionMode
    = ExecutionMode_Executor
    | ExecutionMode_NoExecutor
    deriving (Eq, Show)

data SendingMessageDeps = SendingMessageDeps
    with
        router : RawInstanceAddress.RawInstanceAddress
        onRamp : RawInstanceAddress.RawInstanceAddress
        globalConfig : RawInstanceAddress.RawInstanceAddress
        rmnRemote : RawInstanceAddress.RawInstanceAddress
        tokenAdminRegistry : RawInstanceAddress.RawInstanceAddress
        feeQuoter : RawInstanceAddress.RawInstanceAddress
    deriving (Eq, Show)

data SendingMessageState
    = SendingMessageState_RequirePoolCCVs
    | SendingMessageState_Prepared
    | SendingMessageState_TokenLocked
    | SendingMessageState_ExecutorFinalized
    | SendingMessageState_FeeFinalized
    deriving (Eq, Show)

allZeroHex : BytesHex -> Bool
allZeroHex hex =
    Text.length hex == 0 || (Text.take 1 hex == "0" && allZeroHex (Text.drop 1 hex))

-- | Validates a destination-chain address to be valid hex and strips leading padding iff the destination chain uses sub-32-byte addresses and the address is 32 bytes long with leading zeros.
-- The message receiver, tokenReceiver, and destTokenAddress are all validated using this function since they're all remote chain addresses.
-- This is the equivalent of EVM's _validateDestChainAddress().
-- We must implement the same behavior here, since:
--  - Pools store the remote chain's pool and token addresses (padded, in the case of EVM)
--  - In the incoming direction (from EVM) the message's sourcePoolAddress & sourceTokenAddress will be 32-byte padded addresses
--  - In the incoming directions, the pools will validate that sourcePoolAddress === the stored remote pool address
--  - In the outgoing direction (to EVM), the pools will add this stored address to the message in destTokenAddress
--  - In the outgoing direction, EVM expects the incoming destTokenAddress the be unpadded 20 bytes, so we must strip the padding before sending the outgoing message
validateDestChainAddress : BytesHex -> Int -> BytesHex
validateDestChainAddress address addressBytesLength =
    if not (isValidHex address)
    then error ("InvalidDestChainAddress: not valid hex: " <> show address)
    else let actualLength = byteCount address
         in if addressBytesLength < 32 && actualLength == 32
            then
                let paddingHexLength = (32 - addressBytesLength) * 2
                    leftPadding = Text.take paddingHexLength address
                in if allZeroHex leftPadding
                   then Text.drop paddingHexLength address
                   else error ("InvalidDestChainAddress: non-zero ABI padding for sub-32-byte address: " <> show address)
            else if actualLength == addressBytesLength
                 then address
                 else error ("InvalidDestChainAddress: address length (" <> show actualLength <> ") does not match expected length (" <> show addressBytesLength <> ") for the destination chain: " <> show address)

-- ceil(gasUnits * usdPerUnitGas / usdPerUsdCent) → integer USD cents.
-- EVM FeeQuoter.sol line 333: (totalGas * price + (1e16 - 1)) / 1e16.
gasCostUsdCents : Decimal -> Int -> Numeric 0
gasCostUsdCents usdPerUnitGas gasUnits =
    CCIP.Math.mulDivUp (intToNumeric gasUnits) (CCIP.Math.decimalToNumeric0 usdPerUnitGas) CCIP.Math.usdPerUsdCent

sumExecutionGasLimit : [CCVFee] -> Optional TokenSendFee -> Int -> Int
sumExecutionGasLimit ccvFees tokenSendFee executorDestGasLimit =
    let
        ccvGasLimit = foldl (\acc fee -> acc + fee.destGasLimit) 0 ccvFees
        poolGasLimit = case tokenSendFee of
            Some fee -> fee.destGasOverhead
            None -> 0
    in
        ccvGasLimit + poolGasLimit + executorDestGasLimit

assertCCVInstanceId
    : Text
    -> [RawInstanceAddress.RawInstanceAddress]
    -> Optional [RawInstanceAddress.RawInstanceAddress]
    -> Text
    -> Party
    -> Update ()
assertCCVInstanceId msg requiredCCVs outboundPoolCCVs ccvInstanceId caller =
    let claimed = RawInstanceAddress.make ccvInstanceId caller
        allowedCCVs = dedup (requiredCCVs ++ fromOptional [] outboundPoolCCVs)
    in assertMsg msg (claimed `elem` allowedCCVs)

buildMessageArtifacts
    : SendingMessageV1
    -> ([RawInstanceAddress.RawInstanceAddress], BytesHex, CCIP.MessageCodecV1.MessageV1, BytesHex, BytesHex)
buildMessageArtifacts sm =
    let
        allCCVs = dedup (sm.requiredCCVs ++ fromOptional [] sm.outboundPoolCCVs)
        ccvAddrs = map RawInstanceAddress.toInstanceAddress allCCVs
        executorAddressBytes = case sm.executionMode of
            Some _ ->
                sm.executorAddress
            None ->
                error "sendingMessage: execution mode not set"
        finalHash =
            CCIP.MessageCodecV1.computeCCVAndExecutorHash ccvAddrs executorAddressBytes
        tokenTransferV1Opt = case sm.tokenSendData of
            None -> None
            Some tsd -> Some (CCIP.MessageCodecV1.TokenTransferV1 with
                sourcePoolAddress = CCIP.MessageCodecV1.encodeInstanceAddress tsd.poolInstanceId tsd.poolOwner
                sourceTokenAddress = CCIP.MessageCodecV1.encodeInstrumentId tsd.instrumentId
                destTokenAddress = tsd.destTokenAddress
                tokenReceiver = sm.tokenReceiver
                amount = tsd.amount
                extraData = tsd.extraData)
        messageV1 = CCIP.MessageCodecV1.MessageV1 with
            sourceChainSelector = sm.sourceChainSelector
            destChainSelector = sm.destChainSelector
            sequenceNumber = sm.sequenceNumber
            executionGasLimit = sm.executionGasLimit
            ccipReceiveGasLimit = sm.ccipReceiveGasLimit
            finality = CCIP.FinalityConfig.waitForFinalityDecoded
            ccvAndExecutorHash = finalHash
            onRampAddress = sm.onRampAddress
            offRampAddress = sm.offRampAddress
            sender = sm.senderAddress
            receiver = sm.receiver
            destBlob = sm.executorArgs
            tokenTransfer = tokenTransferV1Opt
            messageData = sm.payload
        encoded = CCIP.MessageCodecV1.encodeMessageV1 messageV1
        msgId = keccak256 encoded
    in
        (allCCVs, finalHash, messageV1, encoded, msgId)

template SendingMessageV1
    with
        deps : SendingMessageDeps
        -- User/OnRamp provided fields, populated at PrepareSend
        ccipOwner : Party
        sender : Party
        destChainSelector : Numeric 0
        destAddressBytesLength : Int
        sequenceNumber : Numeric 0
        -- Destination-chain defaults captured at PrepareSend, used to resolve
        -- pool-required CCV sentinel/default semantics later.
        destDefaultCCVs : [RawInstanceAddress.RawInstanceAddress]
        requiredCCVs : [RawInstanceAddress.RawInstanceAddress]
        requiredExecutor : Optional RawInstanceAddress.RawInstanceAddress
        executorAddress : BytesHex
        executionMode : Optional ExecutionMode
        sourceChainSelector : Numeric 0
        senderAddress : BytesHex
        receiver : BytesHex -- Dest address, unpadded bytes
        payload : BytesHex
        executionGasLimit : Int
        ccipReceiveGasLimit : Int
        ccvAndExecutorHash : BytesHex
        onRampAddress : BytesHex
        offRampAddress : BytesHex
        -- Token transfer receiver (populated for token transfers, "" otherwise)
        tokenReceiver : BytesHex -- Dest address, unpadded bytes
        -- Raw outbound token args provided by the sender. These are source-side
        -- pool inputs and may influence CCV selection, fee quoting, and
        -- LockOrBurn, but are not emitted directly into TokenTransferV1.
        tokenArgs : BytesHex
        feeToken : Splice.Api.Token.HoldingV1.InstrumentId
        -- Legacy field name retained; value is integer USD cents.
        networkFeeUSDCents : Numeric 0
        -- Expected token instrument for outbound TAR validation
        expectedTokenInstrumentId : Optional Splice.Api.Token.HoldingV1.InstrumentId
        -- Pool-required outbound CCVs, set via TAR authorization
        outboundPoolCCVs : Optional [RawInstanceAddress.RawInstanceAddress]
        -- Executor arguments, set during PrepareSend and validated by AddExecutorFee.
        executorArgs : BytesHex
        -- Executor flat fee, set by AddExecutorFee
        executorFee : Optional ExecutorFee
        executorDestGasLimit : Int
        executorDestBytesOverhead : Int
        executorFeeTokenAmount : Decimal
        -- Appended to by AddVerifierData
        -- TODO: also allow AddTokenSend to add their own observers
        observingParties : [Party]

        -- Populated by AddCCVFee
        ccvFees : [CCVFee]
        -- Populated by AddTokenSendFee
        tokenSendFee : Optional TokenSendFee

        -- Populated by FinalizeFee (batch conversion from USD to fee
        -- token units at a single price point)
        ccvFeeTokenAmounts : [Decimal]
        tokenSendFeeTokenAmount : Decimal
        networkFeeTokenAmount : Decimal

        -- Populated by AddTokenSend
        tokenSendData : Optional TokenSendData

        -- Populated by AddVerifierData
        verifierData : [VerifierData]

        -- CCV owner parties accumulated via AddVerifierData and AddCCVFee.
        -- Mirrors the widened signatory set for auditability.
        ccvOwners : [Party]

        -- External CCIP message, populated by BuildMessage.
        message : Optional CCIP.MessageCodecV1.MessageV1
        encodedMessage : BytesHex
        messageId : BytesHex
        -- State machine:
        --   message-only: PrepareSend -> Prepared -> ExecutorFinalized -> FeeFinalized -(FinalizeSend)-> consumed
        --   token-send: PrepareSend -> RequirePoolCCVs -> Prepared -> TokenLocked
        --               -> ExecutorFinalized -> FeeFinalized -(FinalizeSend)-> consumed
        -- `Prepared` means the full allowed CCV set is known. For token sends,
        -- TAR-mediated SetOutboundPoolCCVs is the only transition that can move
        -- the message into Prepared.
        state : SendingMessageState
    where
        signatory dedup (ccipOwner :: ccvOwners)
        observer observingParties

        -- receiver, tokenReceiver (if set), and tokenSendData.destTokenAddress (if set) must be valid hex and of destAddressBytesLength bytes.
        ensure
            isValidHex receiver && byteCount receiver == destAddressBytesLength
            && (tokenReceiver == "" || (isValidHex tokenReceiver && byteCount tokenReceiver == destAddressBytesLength))
            && (case tokenSendData of
                    None -> True
                    Some tsd -> isValidHex tsd.destTokenAddress && byteCount tsd.destTokenAddress == destAddressBytesLength)

        interface instance CCIP.API.SendingMessageV1.SendingMessage for SendingMessageV1 where
            view = CCIP.API.SendingMessageV1.SendingMessageView with
                ccipOwner = ccipOwner
                destChainSelector = destChainSelector
                sender = sender

                -- CCVs
                requiredCCVs = requiredCCVs
                outboundPoolCCVs = outboundPoolCCVs

                -- deps
                router = deps.router
                onRamp = deps.onRamp
                globalConfig = deps.globalConfig
                rmnRemote = deps.rmnRemote
                tokenAdminRegistry = deps.tokenAdminRegistry
                feeQuoter = deps.feeQuoter

                context = Splice.Api.Token.MetadataV1.emptyChoiceContext

            sendingMessage_addCCVFeeImpl self arg = do
                coerceContractId <$> exercise (fromInterfaceContractId @SendingMessageV1 self) AddCCVFee
                    with
                        ccvInstanceId = arg.ccvInstanceId
                        feeUSDCents = arg.feeUSDCents
                        destGasLimit = arg.destGasLimit
                        destBytesOverhead = arg.destBytesOverhead
                        context = arg.context
                        caller = arg.caller

            sendingMessage_addVerifierDataImpl self arg = do
                coerceContractId <$> exercise (fromInterfaceContractId @SendingMessageV1 self) AddVerifierData
                    with
                        ccvInstanceId = arg.ccvInstanceId
                        versionTag = arg.versionTag
                        verifierBlob = arg.verifierBlob
                        messageSentObservers = arg.messageSentObservers
                        context = arg.context
                        caller = arg.caller

            sendingMessage_addExecutorFeeImpl self arg = do
                coerceContractId <$> exercise (fromInterfaceContractId @SendingMessageV1 self) AddExecutorFee
                    with
                        executorInstanceId = arg.executorInstanceId
                        executorArgs = arg.executorArgs
                        feeUSDCents = arg.feeUSDCents
                        context = arg.context
                        caller = arg.caller

            sendingMessage_buildMessageImpl self arg = do
                coerceContractId <$> exercise (fromInterfaceContractId @SendingMessageV1 self) BuildMessage with
                    context = arg.context
                    caller = arg.caller

        choice AddCCVFee : ContractId SendingMessageV1
            with
                ccvInstanceId : Text
                feeUSDCents : Numeric 0
                destGasLimit : Int
                destBytesOverhead : Int
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                caller : Party
            controller caller
            do
                assertMsg "sendingMessage: AddCCVFee only allowed in Prepared" (state == SendingMessageState_Prepared)
                assertCCVInstanceId
                    "sendingMessage: caller is not an allowed CCV"
                    requiredCCVs
                    outboundPoolCCVs
                    ccvInstanceId
                    caller
                assertMsg "sendingMessage: duplicate CCV fee"
                    (all (\fee -> not (fee.ccvInstanceId == ccvInstanceId && fee.ccvOwner == caller)) ccvFees)

                let fee = CCVFee with
                        ccvInstanceId, ccvOwner = caller
                        feeUSDCents, destGasLimit, destBytesOverhead
                create this with
                    ccvFees = ccvFees ++ [fee]
                    ccvOwners = dedup (ccvOwners ++ [caller])

        choice AddTokenSendFee : ContractId SendingMessageV1
            with
                poolInstanceId : Text
                poolOwner : Party
                feeUSDCents : Numeric 0
                destGasOverhead : Int
                destBytesOverhead : Int
                context : Splice.Api.Token.MetadataV1.ChoiceContext
            controller ccipOwner
            do
                assertMsg "sendingMessage: AddTokenSendFee only allowed after pool CCVs are resolved" (state == SendingMessageState_Prepared)
                assertMsg "sendingMessage: AddTokenSendFee only valid for token sends" (isSome expectedTokenInstrumentId)
                assertMsg "token send fee already set" (isNone tokenSendFee)

                create this with
                    tokenSendFee = Some TokenSendFee with
                        poolInstanceId
                        poolOwner
                        feeUSDCents
                        destGasOverhead
                        destBytesOverhead

        -- TAR-authorized outbound pool CCV requirements.
        choice SetOutboundPoolCCVs : ContractId SendingMessageV1
            with
                poolCCVs : [RawInstanceAddress.RawInstanceAddress]
            controller ccipOwner
            do
                assertMsg "sendingMessage: SetOutboundPoolCCVs only allowed while pool CCVs are required" (state == SendingMessageState_RequirePoolCCVs)
                assertMsg "sendingMessage: outbound pool CCV resolution only valid for token sends" (isSome expectedTokenInstrumentId)
                assertMsg "setOutboundPoolCCVs: already set" (isNone outboundPoolCCVs)
                CCIP.Internal.assertMaxCCVListLength "sendingMessage: outbound pool CCVs" poolCCVs
                assertMsg "sendingMessage: outbound pool CCVs cannot contain duplicates" (unique poolCCVs)
                let resolvedPoolCCVs = CCIP.Internal.resolveRequiredCCVsWithDefaults
                        destDefaultCCVs
                        poolCCVs
                CCIP.Internal.assertMaxCCVListLength "sendingMessage: resolved outbound pool CCVs" resolvedPoolCCVs

                create this with
                    outboundPoolCCVs = Some resolvedPoolCCVs
                    state = SendingMessageState_Prepared

        -- Record the executor-selected flat fee. OnRamp computes execution
        -- gas/bytes during fee finalization.
        choice AddExecutorFee : ContractId SendingMessageV1
            with
                executorInstanceId : Text
                executorArgs : BytesHex
                feeUSDCents : Numeric 0
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                caller : Party
            controller caller
            do
                assertMsg "sendingMessage: invalid state for AddExecutorFee" (state == SendingMessageState_Prepared)
                assertMsg "addExecutorFee: already set" (isNone executorFee)
                assertMsg "sendingMessage: token sends require outbound pool CCVs to be resolved" (isNone expectedTokenInstrumentId || isSome outboundPoolCCVs)
                assertMsg "sendingMessage: executor mode already fixed to no executor"
                    (executionMode == Some ExecutionMode_Executor)

                requiredExecutor <- case requiredExecutor of
                    Some executor -> pure executor
                    None -> abort "sendingMessage: required executor missing"
                RawInstanceAddress.assertEqual
                    "sendingMessage: caller is not the required executor"
                    executorInstanceId
                    caller
                    requiredExecutor
                assertMsg
                    "sendingMessage: executor address mismatch"
                    (executorAddress == RawInstanceAddress.toInstanceAddress requiredExecutor)

                let ef = ExecutorFee with
                        executorInstanceId = executorInstanceId
                        executorOwner = caller
                        feeUSDCents = feeUSDCents
                create this with
                    executorAddress = RawInstanceAddress.toInstanceAddress requiredExecutor
                    executorArgs = executorArgs
                    executorFee = Some ef

        -- Finalize the execution receipt metadata. This happens before the
        -- outbound message is constructed.
        choice FinalizeFee : ContractId SendingMessageV1
            with
                feeTokenPrice : Decimal
                premiumMultiplier : Decimal
                totalExecutionGasLimit : Int
                executorDestGasLimit : Int
                executorDestBytesOverhead : Int
                executionCostUSDCents : Numeric 0
            controller ccipOwner
            do
                assertMsg "sendingMessage: FinalizeFee only allowed after executor selection" (state == SendingMessageState_Prepared)
                assertMsg "sendingMessage: execution mode not set" (isSome executionMode)
                case executionMode of
                    Some ExecutionMode_Executor -> do
                        assertMsg "sendingMessage: executor fee not set" (isSome executorFee)
                        assertMsg "sendingMessage: executor address not set" (executorAddress /= "")
                    _ -> pure ()
                assertMsg "fee token price must be positive" (feeTokenPrice > 0.0)
                assertMsg "premium multiplier must be positive" (premiumMultiplier > 0.0)

                -- All math in Numeric 0 to avoid Canton's banker's rounding.
                -- EVM FeeQuoter.sol line 750:
                --   fee = (totalGas * gasPrice * 1e18 + premiumUSD) / feeTokenPrice
                -- Canton analog (per-component):
                --   fee = floor(cents * usdPerUsdCent * multiplier / feeTokenPrice)
                -- where usdPerUsdCent (1e8) promotes cents back to E10, and
                -- multiplier/price are both E10-scaled so the ratio preserves units.
                let feeTokenPriceN = CCIP.Math.decimalToNumeric0 feeTokenPrice
                let premiumMultiplierN = CCIP.Math.decimalToNumeric0 premiumMultiplier
                let promoteUsdCentsToUsd10 feeUSDCents =
                        CCIP.Math.mulDivDown feeUSDCents CCIP.Math.usdPerUsdCent 1.0
                -- Applies the premium multiplier (e.g. LINK discount) to a
                -- USD-cents fee and converts to fee token smallest units.
                let convertWithPremium feeUSDCents =
                        let feeUsd10 = promoteUsdCentsToUsd10 feeUSDCents
                        in CCIP.Math.numeric0ToDecimal (CCIP.Math.mulDivDown feeUsd10 premiumMultiplierN feeTokenPriceN)
                -- Identity conversion (no premium): used for gas execution cost
                -- and executor flat fees, matching EVM where the gas term in the
                -- numerator uses 1e18 (identity) rather than the multiplier.
                let convertDirect feeUSDCents =
                        let feeUsd10 = promoteUsdCentsToUsd10 feeUSDCents
                        in CCIP.Math.numeric0ToDecimal (CCIP.Math.mulDivDown feeUsd10 CCIP.Math.premiumIdentity feeTokenPriceN)
                let executionCostAmount =
                        if executionMode == Some ExecutionMode_NoExecutor
                        then 0.0
                        else convertDirect executionCostUSDCents

                let ccvAmounts = map (\fee -> convertWithPremium fee.feeUSDCents) ccvFees
                let poolAmount = case tokenSendFee of
                        None -> 0.0
                        Some fee -> convertWithPremium fee.feeUSDCents
                let executorAmount = case executorFee of
                        None -> 0.0
                        Some fee ->
                            if executionMode == Some ExecutionMode_NoExecutor
                            then 0.0
                            else convertDirect fee.feeUSDCents
                let networkAmount = convertWithPremium networkFeeUSDCents

                create this with
                    executionGasLimit = totalExecutionGasLimit
                    executorDestGasLimit = executorDestGasLimit
                    executorDestBytesOverhead = executorDestBytesOverhead
                    ccvFeeTokenAmounts = ccvAmounts
                    tokenSendFeeTokenAmount = poolAmount
                    executorFeeTokenAmount = executorAmount + executionCostAmount
                    networkFeeTokenAmount = networkAmount
                    state = SendingMessageState_FeeFinalized

        choice BuildMessage : ContractId SendingMessageV1
            with
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                caller : Party
            controller caller
            do
                assertMsg "sendingMessage: BuildMessage only allowed after fee finalization" (state == SendingMessageState_FeeFinalized)
                assertMsg "sendingMessage: message already built" (isNone message)
                assertMsg "sendingMessage: execution mode not set" (isSome executionMode)
                assertMsg "sendingMessage: token sends require token data before message build" (isNone expectedTokenInstrumentId || isSome tokenSendData)

                let (finalCCVs, finalHash, messageV1, encoded, msgId) =
                        buildMessageArtifacts this
                CCIP.Internal.assertMaxCCVListLength "sendingMessage: final CCVs" finalCCVs
                create this with
                    requiredCCVs = finalCCVs
                    ccvAndExecutorHash = finalHash
                    message = Some messageV1
                    encodedMessage = encoded
                    messageId = msgId

        choice AddVerifierData : ContractId SendingMessageV1
            with
                ccvInstanceId : Text
                versionTag : BytesHex
                verifierBlob : BytesHex
                messageSentObservers : [Party]
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                caller : Party
            controller caller
            do
                assertMsg "sendingMessage: AddVerifierData only allowed after fee finalization" (state == SendingMessageState_FeeFinalized)
                assertCCVInstanceId
                    "sendingMessage: caller is not an allowed CCV"
                    requiredCCVs
                    outboundPoolCCVs
                    ccvInstanceId
                    caller
                assertMsg "version tag must be 4 bytes" (byteCount versionTag == 4)
                assertMsg "sendingMessage: duplicate verifier data for CCV"
                    (all (\v -> not (v.ccvInstanceId == ccvInstanceId && v.ccvOwner == caller)) verifierData)

                let vd = VerifierData with
                        ccvInstanceId
                        ccvOwner = caller
                        versionTag, verifierBlob, messageSentObservers
                create this with
                    verifierData = verifierData ++ [vd]
                    ccvOwners = dedup (ccvOwners ++ [caller])
                    observingParties =
                        dedup (observingParties ++ messageSentObservers)

        -- Stores token send data. If fees are already finalized, this also
        -- finalizes the outbound message.
        choice AddTokenSend : ContractId SendingMessageV1
            with
                poolInstanceId : Text
                poolOwner : Party
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                amount : BytesHex
                destTokenAddress : BytesHex
                extraData : BytesHex
                context : Splice.Api.Token.MetadataV1.ChoiceContext
            controller ccipOwner
            do
                assertMsg "sendingMessage: AddTokenSend only allowed after pool CCVs are resolved" (state == SendingMessageState_FeeFinalized)
                assertMsg "sendingMessage: token send requires expected instrument" (isSome expectedTokenInstrumentId)
                assertMsg "sendingMessage: token send requires token send fee" (isSome tokenSendFee)
                assertMsg "token send already set" (isNone tokenSendData)
                quotedTokenSendFee <- case tokenSendFee of
                    None -> abort "sendingMessage: token send fee must be finalized before token data"
                    Some fee -> pure fee
                assertMsg "sendingMessage: token amount must be 32 bytes" (byteCount amount == 32)
                assertMsg "sendingMessage: pool extraData exceeds quoted destBytesOverhead"
                    (byteCount extraData <= quotedTokenSendFee.destBytesOverhead)

                -- Enforce that the token pool payload (extraData) is not larger than the destBytesOverhead that's been quoted as part of AddTokenSendFee
                assertMsg "SourceTokenDataTooLarge: extraData size exceeds destBytesOverhead" (byteCount extraData <= (fromSome tokenSendFee).destBytesOverhead)

                let tsd = TokenSendData with
                        poolInstanceId, poolOwner, instrumentId, amount
                        destTokenAddress = validateDestChainAddress destTokenAddress destAddressBytesLength
                        extraData

                let updated = this with tokenSendData = Some tsd
                let (finalCCVs, finalHash, messageV1, encoded, msgId) =
                        buildMessageArtifacts updated
                CCIP.Internal.assertMaxCCVListLength "sendingMessage: final CCVs" finalCCVs
                create updated with
                    requiredCCVs = finalCCVs
                    ccvAndExecutorHash = finalHash
                    message = Some messageV1
                    encodedMessage = encoded
                    messageId = msgId

        choice FinalizeSend : FinalizeSendResult
            with
                messageSender : Party
                messageSentObservers : [Party]
                verifierBlobs : [BytesHex]
                receipts : [CCIP.Tickets.Receipt]
            controller ccipOwner
            do
                assertMsg "finalizeSend: only allowed after fee finalization" (state == SendingMessageState_FeeFinalized)
                assertMsg "finalizeSend: message not yet constructed" (isSome message)
                assertMsg "finalizeSend: sender mismatch" (messageSender == sender)

                eventCid <- create CCIP.Events.CCIPMessageSent with
                    ccipOwner = ccipOwner
                    ccvOwners = ccvOwners
                    sender = messageSender
                    observers = messageSentObservers
                    event = CCIP.Events.CCIPMessageSentEvent with
                        destChainSelector = destChainSelector
                        sequenceNumber = sequenceNumber
                        messageId = messageId
                        encodedMessage = encodedMessage
                        verifierBlobs = verifierBlobs
                        receipts = receipts
                pure FinalizeSendResult with
                    ccipMessageSent = eventCid

        -- Total fee in fee token units. Matches EVM where
        -- forwardToVerifier receives the total feeTokenAmount.
        -- Requires FinalizeFee to have been called.
        nonconsuming choice FeeTokenAmount : Decimal
            with
                caller : Party
            controller caller
            do
                assertMsg "sendingMessage: FeeTokenAmount only allowed after fee finalization" (state == SendingMessageState_FeeFinalized)

                pure (Foldable.sum ccvFeeTokenAmounts
                    + tokenSendFeeTokenAmount
                    + executorFeeTokenAmount
                    + networkFeeTokenAmount)

data FinalizeSendResult = FinalizeSendResult
    with
        ccipMessageSent : ContractId CCIP.Events.CCIPMessageSent
    deriving (Eq, Show)
