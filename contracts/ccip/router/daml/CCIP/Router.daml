module CCIP.Router where

import DA.Time

import Splice.Api.Token.HoldingV1
import qualified Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.TransferInstructionV1

import CCIP.Client (Canton2AnyMessage)
import CCIP.FeeQuoter qualified as FeeQuoter
import CCIP.OnRamp qualified as OnRamp

template Router
    with
        owner : Party
    where
        signatory owner

        -- ================================================================
        -- │                       Message sending                        │
        -- ================================================================

        nonconsuming choice CCIPSend : CCIPSendResult
            with 
                destChainSelector : Numeric 0
                message : Canton2AnyMessage
                feeInput : FeeInput
                caller : Party
                onRamp : ContractId OnRamp.OnRamp
                feeQuoter : ContractId FeeQuoter.FeeQuoter
            controller caller
            do
                -- Use OnRamp to calculate Fees
                feeAmount <- exercise onRamp OnRamp.GetFee
                    with
                        destChainSelector = destChainSelector
                        message = message
                        caller = caller
                        feeQuoter = feeQuoter

                -- use TransferFactory to create a transfer instruction to the owner party
                now <- getTime
                transferResult <- exercise feeInput.transferFactory Splice.Api.Token.TransferInstructionV1.TransferFactory_Transfer
                    with
                        expectedAdmin = message.feeToken.admin
                        transfer = Splice.Api.Token.TransferInstructionV1.Transfer
                            with
                                sender = caller
                                receiver = owner
                                amount = feeAmount
                                instrumentId = message.feeToken
                                requestedAt = now
                                executeBefore = addRelTime now (seconds 600) -- 10 minutes
                                inputHoldingCids = feeInput.inputHoldingCids
                                meta = Splice.Api.Token.MetadataV1.emptyMetadata
                        extraArgs = feeInput.extraArgs

                case transferResult.output of
                    Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Pending ti -> do
                        -- use OnRamp to send the CCIP message
                        ccipSendResult <- exercise onRamp OnRamp.CCIPSend
                            with
                                destChainSelector = destChainSelector
                                message = message
                                feeInput = OnRamp.FeeInput
                                    with
                                        transfer = ti
                                        extraArgs = feeInput.extraArgs
                                caller = caller
                                feeQuoter = feeQuoter

                        pure CCIPSendResult
                            with
                                onRamp = ccipSendResult.onRamp
                                ccipMessageSent = ccipSendResult.ccipMessageSent
                                senderChangeCids = transferResult.senderChangeCids

                    Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Completed _ -> abort "Transfer should be pending"
                    Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Failed -> abort "Transfer failed"

data FeeInput = FeeInput
    with
        transferFactory : ContractId Splice.Api.Token.TransferInstructionV1.TransferFactory
        inputHoldingCids : [ContractId Splice.Api.Token.HoldingV1.Holding]
        extraArgs : Splice.Api.Token.MetadataV1.ExtraArgs
    deriving (Eq, Show)

data CCIPSendResult = CCIPSendResult
    with
        onRamp : ContractId OnRamp.OnRamp
        ccipMessageSent : ContractId OnRamp.CCIPMessageSent
        senderChangeCids : [ContractId Splice.Api.Token.HoldingV1.Holding]
    deriving (Eq, Show)