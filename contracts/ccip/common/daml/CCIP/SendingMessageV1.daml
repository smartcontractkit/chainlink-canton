-- | Sending message contract for outbound CCIP message processing.
-- Evolves from a static container to a collecting contract. Each consuming
-- choice consumes the old contract and creates a new one with appended data.
-- The ccipOwner signatory is inherited from the consumed contract, so any
-- caller can trigger the mutation.
module CCIP.SendingMessageV1 where

import DA.Crypto.Text (BytesHex, keccak256, byteCount)
import DA.Foldable qualified as Foldable
import DA.List (dedup)
import DA.Optional (isNone, fromOptional)

import qualified CCIP.Events
import qualified CCIP.Math
import qualified CCIP.MessageCodecV1
import qualified CCIP.RawInstanceAddress
import qualified CCIP.Tickets

import qualified Splice.Api.Token.HoldingV1

data CCVFee = CCVFee
    with
        ccvInstanceId : Text
        ccvOwner : Party
        -- Legacy field name retained; value is integer USD cents.
        feeUSDCents : Numeric 0
        destGasLimit : Int
        destBytesOverhead : Int
    deriving (Eq, Show)

data TokenSendFee = TokenSendFee
    with
        poolInstanceId : Text
        poolOwner : Party
        -- Legacy field name retained; value is integer USD cents.
        feeUSDCents : Numeric 0
        destGasOverhead : Int
        destBytesOverhead : Int
    deriving (Eq, Show)

data VerifierData = VerifierData
    with
        ccvInstanceId : Text
        ccvOwner : Party
        versionTag : BytesHex
        verifierBlob : BytesHex
        messageSentObservers : [Party]
    deriving (Eq, Show)

data TokenSendData = TokenSendData
    with
        poolInstanceId : Text
        poolOwner : Party
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        amount : Numeric 0
        destTokenAddress : BytesHex
        extraData : BytesHex
    deriving (Eq, Show)

data ExecutorFee = ExecutorFee
    with
        executorInstanceId : Text
        executorOwner : Party
        -- Legacy field name retained; value is integer USD cents.
        feeUSDCents : Numeric 0
        destGasLimit : Int
        destBytesOverhead : Int
    deriving (Eq, Show)

data SendingMessageDeps = SendingMessageDeps
    with
        router : CCIP.RawInstanceAddress.RawInstanceAddress
        onRamp : CCIP.RawInstanceAddress.RawInstanceAddress
        globalConfig : CCIP.RawInstanceAddress.RawInstanceAddress
        rmnRemote : CCIP.RawInstanceAddress.RawInstanceAddress
        tokenAdminRegistry : CCIP.RawInstanceAddress.RawInstanceAddress
        feeQuoter : CCIP.RawInstanceAddress.RawInstanceAddress
    deriving (Eq, Show)

data SendingMessageState
    = SendingMessageState_Prepared
    | SendingMessageState_PoolVerified
    | SendingMessageState_TokenLocked
    | SendingMessageState_ExecutorFinalized
    | SendingMessageState_FeeFinalized
    deriving (Eq, Show)

-- 1e8: the "100%" identity value in the Canton E8 premium convention.
premiumIdentity : Numeric 0
premiumIdentity = 100000000.0

-- 1e6 converts integer USD cents into the Canton usd8 domain.
usd8PerUsdCent : Numeric 0
usd8PerUsdCent = 1000000.0

sumExecutionGasLimit : [CCVFee] -> Optional TokenSendFee -> Int -> Int
sumExecutionGasLimit ccvFees tokenSendFee executorDestGasLimit =
    let
        ccvGasLimit = foldl (\acc fee -> acc + fee.destGasLimit) 0 ccvFees
        poolGasLimit = case tokenSendFee of
            Some fee -> fee.destGasOverhead
            None -> 0
    in
        ccvGasLimit + poolGasLimit + executorDestGasLimit

template SendingMessageV1
    with
        deps : SendingMessageDeps
        -- User/OnRamp provided fields, populated at PrepareSend
        ccipOwner : Party
        sender : Party
        destChainSelector : Numeric 0
        sequenceNumber : Numeric 0
        requiredCCVs : [CCIP.RawInstanceAddress.RawInstanceAddress]
        executorAddress : CCIP.RawInstanceAddress.RawInstanceAddress
        sourceChainSelector : Numeric 0
        senderAddress : BytesHex
        receiver : BytesHex
        payload : BytesHex
        executionGasLimit : Int
        ccipReceiveGasLimit : Int
        ccvAndExecutorHash : BytesHex
        onRampAddress : BytesHex
        offRampAddress : BytesHex
        -- Token transfer receiver (populated for token transfers, "" otherwise)
        tokenReceiver : BytesHex
        -- Raw outbound token args provided by the sender. These are source-side
        -- pool inputs and may influence CCV selection, fee quoting, and
        -- LockOrBurn, but are not emitted directly into TokenTransferV1.
        tokenArgs : BytesHex
        feeToken : Splice.Api.Token.HoldingV1.InstrumentId
        -- Legacy field name retained; value is integer USD cents.
        networkFeeUSDCents : Numeric 0
        -- Expected token instrument for outbound TAR validation
        expectedTokenInstrumentId : Optional Splice.Api.Token.HoldingV1.InstrumentId
        -- Pool-required outbound CCVs, set via TAR authorization
        outboundPoolCCVs : Optional [CCIP.RawInstanceAddress.RawInstanceAddress]
        -- Executor arguments, set by AddExecutorWithFee
        executorArgs : BytesHex
        -- Executor fee, set by AddExecutorWithFee
        executorFee : Optional ExecutorFee
        executorFeeTokenAmount : Numeric 0
        -- Appended to by AddVerifierData
        -- TODO: also allow AddTokenSend to add their own observers
        observingParties : [Party]

        -- Populated by AddCCVFee
        ccvFees : [CCVFee]
        -- Populated by AddTokenSendFee
        tokenSendFee : Optional TokenSendFee

        -- Populated by FinalizeFee (batch conversion from USD to fee
        -- token units at a single price point)
        ccvFeeTokenAmounts : [Numeric 0]
        tokenSendFeeTokenAmount : Numeric 0
        networkFeeTokenAmount : Numeric 0

        -- Populated by AddTokenSend
        tokenSendData : Optional TokenSendData

        -- Populated by AddVerifierData
        verifierData : [VerifierData]

        -- CCV owner parties accumulated via AddVerifierData and AddCCVFee.
        -- Mirrors the widened signatory set for auditability.
        ccvOwners : [Party]

        -- External CCIP message, populated by AddExecutorWithFee.
        message : Optional CCIP.MessageCodecV1.MessageV1
        encodedMessage : BytesHex
        messageId : BytesHex
        -- State machine:
        --   message-only: Prepared -> ExecutorFinalized -> FeeFinalized -(FinalizeSend)-> consumed
        --   token-send: Prepared -> PoolVerified -> TokenLocked -> ExecutorFinalized -> FeeFinalized -(FinalizeSend)-> consumed
        state : SendingMessageState
    where
        signatory dedup (ccipOwner :: ccvOwners)
        observer observingParties

        choice AddCCVFee : ContractId SendingMessageV1
            with
                ccvInstanceId : Text
                feeUSDCents : Numeric 0
                destGasLimit : Int
                destBytesOverhead : Int
                caller : Party
            controller caller
            do
                assertMsg "sendingMessage: AddCCVFee only allowed in Prepared"
                    (state == SendingMessageState_Prepared)
                assertMsg "sendingMessage: duplicate CCV fee"
                    (all (\fee -> fee.ccvInstanceId /= ccvInstanceId) ccvFees)
                let fee = CCVFee with
                        ccvInstanceId, ccvOwner = caller
                        feeUSDCents, destGasLimit, destBytesOverhead
                create this with
                    ccvFees = ccvFees ++ [fee]
                    ccvOwners = dedup (ccvOwners ++ [caller])

        choice AddTokenSendFee : ContractId SendingMessageV1
            with
                poolInstanceId : Text
                poolOwner : Party
                feeUSDCents : Numeric 0
                destGasOverhead : Int
                destBytesOverhead : Int
                caller : Party
            controller caller
            do
                assertMsg "sendingMessage: AddTokenSendFee only allowed in Prepared"
                    (state == SendingMessageState_Prepared)
                assertMsg "token send fee already set"
                    (isNone tokenSendFee)
                let fee = TokenSendFee with
                        poolInstanceId, poolOwner
                        feeUSDCents, destGasOverhead, destBytesOverhead
                create this with tokenSendFee = Some fee

        -- TAR-authorized outbound pool CCV requirements.
        choice SetOutboundPoolCCVs : ContractId SendingMessageV1
            with
                poolCCVs : [CCIP.RawInstanceAddress.RawInstanceAddress]
            controller ccipOwner
            do
                assertMsg "sendingMessage: SetOutboundPoolCCVs only allowed in Prepared"
                    (state == SendingMessageState_Prepared)
                assertMsg "sendingMessage: outbound pool verification only valid for token sends"
                    (expectedTokenInstrumentId /= None)
                assertMsg "setOutboundPoolCCVs: already set" (outboundPoolCCVs == None)
                create this with
                    outboundPoolCCVs = Some poolCCVs
                    state = SendingMessageState_PoolVerified

        -- Executor fee, final CCV/executor hash computation, and message finalization.
        -- Merges outbound pool CCVs into requiredCCVs, derives executor address from
        -- (executorInstanceId, caller), computes ccvAndExecutorHash, and builds MessageV1.
        choice AddExecutorWithFee : ContractId SendingMessageV1
            with
                executorInstanceId : Text
                executorArgs : BytesHex
                feeUSDCents : Numeric 0
                destGasLimit : Int
                destBytesOverhead : Int
                caller : Party
            controller caller
            do
                let isTokenSend = expectedTokenInstrumentId /= None
                assertMsg "sendingMessage: invalid state for AddExecutorWithFee"
                    (if isTokenSend
                        then state == SendingMessageState_TokenLocked
                        else state == SendingMessageState_Prepared)
                assertMsg "addExecutorWithFee: already set" (executorFee == None)
                assertMsg "sendingMessage: token sends require outbound pool verification"
                    (if isTokenSend then outboundPoolCCVs /= None else True)

                let poolCCVs = fromOptional [] outboundPoolCCVs
                let finalCCVs = dedup (requiredCCVs ++ poolCCVs)
                let derivedExecutor = CCIP.RawInstanceAddress.make executorInstanceId caller

                let ccvAddrs = map CCIP.RawInstanceAddress.toInstanceAddress finalCCVs
                let execAddr = CCIP.RawInstanceAddress.toInstanceAddress derivedExecutor
                let finalHash = CCIP.MessageCodecV1.computeCCVAndExecutorHash ccvAddrs execAddr

                let ef = ExecutorFee with
                        executorInstanceId = executorInstanceId
                        executorOwner = caller
                        feeUSDCents = feeUSDCents
                        destGasLimit = destGasLimit
                        destBytesOverhead = destBytesOverhead
                let finalExecutionGasLimit =
                        sumExecutionGasLimit ccvFees tokenSendFee destGasLimit

                let tokenTransferV1Opt = case tokenSendData of
                        None -> None
                        Some tsd -> Some (CCIP.MessageCodecV1.TokenTransferV1 with
                            sourcePoolAddress = CCIP.MessageCodecV1.encodeInstanceAddress tsd.poolInstanceId tsd.poolOwner
                            sourceTokenAddress = CCIP.MessageCodecV1.encodeInstrumentId tsd.instrumentId
                            destTokenAddress = tsd.destTokenAddress
                            tokenReceiver = tokenReceiver
                            amount = tsd.amount
                            extraData = tsd.extraData)

                let messageV1 = CCIP.MessageCodecV1.MessageV1 with
                        sourceChainSelector
                        destChainSelector
                        sequenceNumber
                        executionGasLimit = finalExecutionGasLimit
                        ccipReceiveGasLimit
                        finality = 0
                        ccvAndExecutorHash = finalHash
                        onRampAddress
                        offRampAddress
                        sender = senderAddress
                        receiver
                        destBlob = executorArgs
                        tokenTransfer = tokenTransferV1Opt
                        messageData = payload

                let encoded = CCIP.MessageCodecV1.encodeMessageV1 messageV1
                let msgId = keccak256 encoded

                create this with
                    requiredCCVs = finalCCVs
                    executorAddress = derivedExecutor
                    executorArgs = executorArgs
                    executionGasLimit = finalExecutionGasLimit
                    ccvAndExecutorHash = finalHash
                    executorFee = Some ef
                    message = Some messageV1
                    encodedMessage = encoded
                    messageId = msgId
                    state = SendingMessageState_ExecutorFinalized

        choice AddVerifierData : ContractId SendingMessageV1
            with
                ccvInstanceId : Text
                versionTag : BytesHex
                verifierBlob : BytesHex
                messageSentObservers : [Party]
                caller : Party
            controller caller
            do
                assertMsg "sendingMessage: AddVerifierData only allowed after fee finalization"
                    (state == SendingMessageState_FeeFinalized)
                assertMsg "version tag must be 4 bytes"
                    (byteCount versionTag == 4)
                assertMsg "sendingMessage: duplicate verifier data for CCV"
                    (all (\v -> v.ccvInstanceId /= ccvInstanceId) verifierData)
                let vd = VerifierData with
                        ccvInstanceId
                        ccvOwner = caller
                        versionTag, verifierBlob, messageSentObservers
                create this with
                    verifierData = verifierData ++ [vd]
                    ccvOwners = dedup (ccvOwners ++ [caller])
                    observingParties =
                        dedup (observingParties ++ messageSentObservers)

        -- Stores token send data only. Final message is built in AddExecutorWithFee.
        choice AddTokenSend : ContractId SendingMessageV1
            with
                poolInstanceId : Text
                poolOwner : Party
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                amount : Numeric 0
                destTokenAddress : BytesHex
                extraData : BytesHex
                caller : Party
            controller caller
            do
                assertMsg "sendingMessage: AddTokenSend only allowed after pool verification"
                    (state == SendingMessageState_PoolVerified)
                assertMsg "sendingMessage: token send requires expected instrument"
                    (expectedTokenInstrumentId /= None)
                assertMsg "token send already set" (isNone tokenSendData)

                let tsd = TokenSendData with
                        poolInstanceId, poolOwner, instrumentId, amount
                        destTokenAddress, extraData

                create this with
                    tokenSendData = Some tsd
                    state = SendingMessageState_TokenLocked

        -- Batch-converts all USD fees to fee token units at a single price point.
        -- CCV, pool, and network fees get the premium multiplier applied; executor
        -- fees convert at par (EVM separates gas costs from premium costs).
        -- Only exercisable by ccipOwner (via FeeQuoter).
        choice FinalizeFee : ContractId SendingMessageV1
            with
                feeTokenPrice : Numeric 0
                premiumMultiplier : Numeric 0
            controller ccipOwner
            do
                assertMsg "sendingMessage: FinalizeFee only allowed after executor finalization"
                    (state == SendingMessageState_ExecutorFinalized)
                assertMsg "fee token price must be positive"
                    (feeTokenPrice > 0.0)
                assertMsg "premium multiplier must be positive"
                    (premiumMultiplier > 0.0)

                -- Fee config values stay in integer USD cents. Canton promotes
                -- them into the usd8 pricing domain via * 1e6 before converting
                -- into fee-token local smallest units.
                let promoteUsdCentsToUsd8 feeUSDCents =
                        CCIP.Math.mulDivDown feeUSDCents usd8PerUsdCent 1.0
                let convertWithPremium feeUSDCents =
                        let feeUsd8 = promoteUsdCentsToUsd8 feeUSDCents
                        in CCIP.Math.mulDivDown feeUsd8 premiumMultiplier feeTokenPrice
                let convertDirect feeUSDCents =
                        let feeUsd8 = promoteUsdCentsToUsd8 feeUSDCents
                        in CCIP.Math.mulDivDown feeUsd8 premiumIdentity feeTokenPrice

                let ccvAmounts = map
                        (\fee -> convertWithPremium fee.feeUSDCents) ccvFees
                let poolAmount = case tokenSendFee of
                        None -> 0.0
                        Some fee -> convertWithPremium fee.feeUSDCents
                let executorAmount = case executorFee of
                        None -> 0.0
                        Some fee -> convertDirect fee.feeUSDCents
                let networkAmount = convertWithPremium networkFeeUSDCents

                create this with
                    ccvFeeTokenAmounts = ccvAmounts
                    tokenSendFeeTokenAmount = poolAmount
                    executorFeeTokenAmount = executorAmount
                    networkFeeTokenAmount = networkAmount
                    state = SendingMessageState_FeeFinalized

        choice FinalizeSend : FinalizeSendResult
            with
                messageSender : Party
                messageSentObservers : [Party]
                verifierBlobs : [BytesHex]
                receipts : [CCIP.Tickets.Receipt]
            controller ccipOwner
            do
                assertMsg "finalizeSend: only allowed after fee finalization"
                    (state == SendingMessageState_FeeFinalized)
                assertMsg "finalizeSend: message not yet constructed" (message /= None)
                assertMsg "finalizeSend: sender mismatch" (messageSender == sender)
                eventCid <- create CCIP.Events.CCIPMessageSent with
                    ccipOwner = ccipOwner
                    ccvOwners = ccvOwners
                    sender = messageSender
                    observers = messageSentObservers
                    event = CCIP.Events.CCIPMessageSentEvent with
                        destChainSelector = destChainSelector
                        sequenceNumber = sequenceNumber
                        messageId = messageId
                        encodedMessage = encodedMessage
                        verifierBlobs = verifierBlobs
                        receipts = receipts
                pure FinalizeSendResult with
                    ccipMessageSent = eventCid

        -- Total fee in fee token units. Matches EVM where
        -- forwardToVerifier receives the total feeTokenAmount.
        -- Requires FinalizeFee to have been called.
        nonconsuming choice FeeTokenAmount : Numeric 0
            with
                caller : Party
            controller caller
            do
                assertMsg "sendingMessage: FeeTokenAmount only allowed after fee finalization"
                    (state == SendingMessageState_FeeFinalized)
                pure (Foldable.sum ccvFeeTokenAmounts
                    + tokenSendFeeTokenAmount
                    + executorFeeTokenAmount
                    + networkFeeTokenAmount)

data FinalizeSendResult = FinalizeSendResult
    with
        ccipMessageSent : ContractId CCIP.Events.CCIPMessageSent
    deriving (Eq, Show)
