-- | Sending message contract for outbound CCIP message processing.
-- Evolves from a static container to a collecting contract. Each consuming
-- choice consumes the old contract and creates a new one with appended data.
-- The ccipOwner signatory is inherited from the consumed contract, so any
-- caller can trigger the mutation.
module CCIP.SendingMessageV1 where

import DA.Crypto.Text (BytesHex, keccak256, byteCount)
import DA.Foldable qualified as Foldable
import DA.List (dedup)
import DA.Optional (isNone, fromOptional)

import qualified CCIP.MessageCodecV1
import qualified CCIP.RawInstanceAddress

import qualified Splice.Api.Token.HoldingV1

data CCVFee = CCVFee
    with
        ccvInstanceId : Text
        ccvOwner : Party
        feeUSDCents : Decimal
        destGasLimit : Int
        destBytesOverhead : Int
    deriving (Eq, Show)

data TokenSendFee = TokenSendFee
    with
        poolInstanceId : Text
        poolOwner : Party
        feeUSDCents : Decimal
        destGasOverhead : Int
        destBytesOverhead : Int
    deriving (Eq, Show)

data VerifierData = VerifierData
    with
        ccvInstanceId : Text
        ccvOwner : Party
        versionTag : BytesHex
        verifierBlob : BytesHex
        messageSentObservers : [Party]
    deriving (Eq, Show)

data TokenSendData = TokenSendData
    with
        poolInstanceId : Text
        poolOwner : Party
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        amount : Numeric 0
        destTokenAddress : BytesHex
        extraData : BytesHex
    deriving (Eq, Show)

data ExecutorFee = ExecutorFee
    with
        executorInstanceId : Text
        executorOwner : Party
        feeUSDCents : Decimal
        destGasLimit : Int
        destBytesOverhead : Int
    deriving (Eq, Show)

template SendingMessageV1
    with
        routerInstanceAddress : CCIP.RawInstanceAddress.RawInstanceAddress
        onRampInstanceAddress : CCIP.RawInstanceAddress.RawInstanceAddress
        tokenAdminRegistryInstanceAddress : CCIP.RawInstanceAddress.RawInstanceAddress
        -- User/OnRamp provided fields, populated at PrepareSend
        ccipOwner : Party
        sender : Party
        destChainSelector : Numeric 0
        sequenceNumber : Numeric 0
        requiredCCVs : [CCIP.RawInstanceAddress.RawInstanceAddress]
        executorAddress : CCIP.RawInstanceAddress.RawInstanceAddress
        sourceChainSelector : Numeric 0
        senderAddress : BytesHex
        receiver : BytesHex
        payload : BytesHex
        executionGasLimit : Int
        ccipReceiveGasLimit : Int
        finality : Int
        ccvAndExecutorHash : BytesHex
        onRampAddress : BytesHex
        offRampAddress : BytesHex
        -- Token transfer receiver (populated for token transfers, "" otherwise)
        tokenReceiver : BytesHex
        feeToken : Splice.Api.Token.HoldingV1.InstrumentId
        networkFeeUSDCents : Decimal
        -- Expected token instrument for outbound TAR validation
        expectedTokenInstrumentId : Optional Splice.Api.Token.HoldingV1.InstrumentId
        -- Pool-required outbound CCVs, set via TAR authorization
        outboundPoolCCVs : Optional [CCIP.RawInstanceAddress.RawInstanceAddress]
        -- Executor arguments from extra args
        executorArgs : BytesHex
        -- Executor fee, set by AddExecutorFee
        executorFee : Optional ExecutorFee
        executorFeeTokenAmount : Numeric 0
        -- Appended to by AddVerifierData
        -- TODO: also allow AddTokenSend to add their own observers
        observingParties : [Party]

        -- Populated by AddCCVFee
        ccvFees : [CCVFee]
        -- Populated by AddTokenSendFee
        tokenSendFee : Optional TokenSendFee

        -- Populated by FinalizeFee (batch conversion from USD to fee
        -- token units at a single price point)
        feesFinalized : Bool
        ccvFeeTokenAmounts : [Numeric 0]
        tokenSendFeeTokenAmount : Numeric 0
        networkFeeTokenAmount : Numeric 0

        -- Populated by AddTokenSend
        tokenSendData : Optional TokenSendData

        -- Populated by AddVerifierData
        verifierData : [VerifierData]

        -- External CCIP message
        -- For message-only: populated at PrepareSend.
        -- For token transfers: None/"" until AddTokenSend.
        message : Optional CCIP.MessageCodecV1.MessageV1
        encodedMessage : BytesHex
        messageId : BytesHex
    where
        signatory ccipOwner
        observer observingParties

        choice AddCCVFee : ContractId SendingMessageV1
            with
                ccvInstanceId : Text
                feeUSDCents : Decimal
                destGasLimit : Int
                destBytesOverhead : Int
                caller : Party
            controller caller
            do
                assertMsg "cannot add CCV fee after fees finalized"
                    (not feesFinalized)
                let fee = CCVFee with
                        ccvInstanceId, ccvOwner = caller
                        feeUSDCents, destGasLimit, destBytesOverhead
                create this with ccvFees = ccvFees ++ [fee]

        choice AddTokenSendFee : ContractId SendingMessageV1
            with
                poolInstanceId : Text
                poolOwner : Party
                feeUSDCents : Decimal
                destGasOverhead : Int
                destBytesOverhead : Int
                caller : Party
            controller caller
            do
                assertMsg "cannot add token send fee after fees finalized"
                    (not feesFinalized)
                assertMsg "token send fee already set"
                    (isNone tokenSendFee)
                let fee = TokenSendFee with
                        poolInstanceId, poolOwner
                        feeUSDCents, destGasOverhead, destBytesOverhead
                create this with tokenSendFee = Some fee

        -- TAR-authorized outbound pool CCV requirements.
        choice SetOutboundPoolCCVs : ContractId SendingMessageV1
            with
                poolCCVs : [CCIP.RawInstanceAddress.RawInstanceAddress]
            controller ccipOwner
            do
                assertMsg "setOutboundPoolCCVs: already set" (outboundPoolCCVs == None)
                create this with outboundPoolCCVs = Some poolCCVs

        -- Executor fee and final CCV/executor hash computation.
        -- Merges outbound pool CCVs into requiredCCVs, computes ccvAndExecutorHash.
        -- For message-only sends (message already constructed at PrepareSend), also
        -- rebuilds the message and recomputes encodedMessage/messageId with the final hash.
        choice AddExecutorFee : ContractId SendingMessageV1
            with
                executorInstanceId : Text
                feeUSDCents : Decimal
                destGasLimit : Int
                destBytesOverhead : Int
                caller : Party
            controller caller
            do
                assertMsg "addExecutorFee: fees already finalized" (not feesFinalized)
                assertMsg "addExecutorFee: already set" (executorFee == None)

                let poolCCVs = fromOptional [] outboundPoolCCVs
                let finalCCVs = dedup (requiredCCVs ++ poolCCVs)
                let ccvAddrs = map CCIP.RawInstanceAddress.toInstanceAddress finalCCVs
                let execAddr = CCIP.RawInstanceAddress.toInstanceAddress executorAddress
                let finalHash = CCIP.MessageCodecV1.computeCCVAndExecutorHash ccvAddrs execAddr

                let ef = ExecutorFee with
                        executorInstanceId = executorInstanceId
                        executorOwner = caller
                        feeUSDCents = feeUSDCents
                        destGasLimit = destGasLimit
                        destBytesOverhead = destBytesOverhead

                -- For message-only sends, update the already-constructed message
                -- with the finalized hash and recompute encoded/messageId.
                let (updatedMsg, updatedEncoded, updatedMsgId) = case message of
                        Some msg ->
                            let newMsg = msg with ccvAndExecutorHash = finalHash
                                enc = CCIP.MessageCodecV1.encodeMessageV1 newMsg
                            in (Some newMsg, enc, keccak256 enc)
                        None -> (None, encodedMessage, messageId)

                create this with
                    requiredCCVs = finalCCVs
                    ccvAndExecutorHash = finalHash
                    executorFee = Some ef
                    message = updatedMsg
                    encodedMessage = updatedEncoded
                    messageId = updatedMsgId

        choice AddVerifierData : ContractId SendingMessageV1
            with
                ccvInstanceId : Text
                versionTag : BytesHex
                verifierBlob : BytesHex
                messageSentObservers : [Party]
                caller : Party
            controller caller
            do
                assertMsg "version tag must be 4 bytes"
                    (byteCount versionTag == 4)
                let vd = VerifierData with
                        ccvInstanceId
                        ccvOwner = caller
                        versionTag, verifierBlob, messageSentObservers
                create this with
                    verifierData = verifierData ++ [vd]
                    observingParties =
                        dedup (observingParties ++ messageSentObservers)

        -- Constructs MessageV1 from SendingMessageV1 fields with pool-provided
        -- destTokenAddress and extraData (destPoolData). Requires ccvAndExecutorHash
        -- to be finalized by AddExecutorFee before this step.
        choice AddTokenSend : ContractId SendingMessageV1
            with
                poolInstanceId : Text
                poolOwner : Party
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                amount : Numeric 0
                destTokenAddress : BytesHex
                extraData : BytesHex
                caller : Party
            controller caller
            do
                assertMsg "token send already set" (isNone tokenSendData)
                assertMsg "message already constructed" (isNone message)
                assertMsg "addTokenSend: ccvAndExecutorHash not finalized" (ccvAndExecutorHash /= "")

                let tsd = TokenSendData with
                        poolInstanceId, poolOwner, instrumentId, amount
                        destTokenAddress, extraData

                let sourcePoolAddr = CCIP.MessageCodecV1.encodeInstanceAddress
                        poolInstanceId poolOwner
                let sourceTokenAddr = CCIP.MessageCodecV1.encodeInstrumentId
                        instrumentId
                let tokenTransferV1 = CCIP.MessageCodecV1.TokenTransferV1 with
                        sourcePoolAddress = sourcePoolAddr
                        sourceTokenAddress = sourceTokenAddr
                        destTokenAddress, tokenReceiver, amount, extraData
                let messageV1 = CCIP.MessageCodecV1.MessageV1 with
                        sourceChainSelector, destChainSelector, sequenceNumber
                        executionGasLimit, ccipReceiveGasLimit
                        finality
                        ccvAndExecutorHash
                        onRampAddress, offRampAddress
                        sender = senderAddress
                        receiver
                        destBlob = ""
                        tokenTransfer = Some tokenTransferV1
                        messageData = payload

                let encoded = CCIP.MessageCodecV1.encodeMessageV1 messageV1
                let msgId = keccak256 encoded

                create this with
                    tokenSendData = Some tsd
                    message = Some messageV1
                    encodedMessage = encoded
                    messageId = msgId

        -- Batch-converts all USD fees to fee token units at a single
        -- price point, applying the fee token's premium multiplier.
        -- Only exercisable by ccipOwner (via FeeQuoter) to prevent
        -- untrusted callers from fabricating fee token prices.
        choice FinalizeFee : ContractId SendingMessageV1
            with
                feeTokenPrice : Decimal
                premiumMultiplier : Decimal
            controller ccipOwner
            do
                assertMsg "fees already finalized" (not feesFinalized)
                assertMsg "fee token price must be positive"
                    (feeTokenPrice > 0.0)
                assertMsg "premium multiplier must be positive"
                    (premiumMultiplier > 0.0)

                let convertUSD usdCents = intToNumeric
                        (truncate (usdCents * premiumMultiplier
                            / feeTokenPrice))

                let ccvAmounts = map
                        (\fee -> convertUSD fee.feeUSDCents) ccvFees
                let poolAmount = case tokenSendFee of
                        None -> 0.0
                        Some fee -> convertUSD fee.feeUSDCents
                let executorAmount = case executorFee of
                        None -> 0.0
                        Some fee -> convertUSD fee.feeUSDCents
                let networkAmount = convertUSD networkFeeUSDCents

                create this with
                    feesFinalized = True
                    ccvFeeTokenAmounts = ccvAmounts
                    tokenSendFeeTokenAmount = poolAmount
                    executorFeeTokenAmount = executorAmount
                    networkFeeTokenAmount = networkAmount

        -- Total fee in fee token units. Matches EVM where
        -- forwardToVerifier receives the total feeTokenAmount.
        -- Requires FinalizeFee to have been called.
        nonconsuming choice FeeTokenAmount : Numeric 0
            with
                caller : Party
            controller caller
            do
                assertMsg "fees not finalized" feesFinalized
                pure (Foldable.sum ccvFeeTokenAmounts
                    + tokenSendFeeTokenAmount
                    + executorFeeTokenAmount
                    + networkFeeTokenAmount)
