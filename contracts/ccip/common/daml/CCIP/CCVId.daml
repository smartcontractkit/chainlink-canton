-- | CCV identifier combining version tag and party.
module CCIP.CCVId where

import DA.Text qualified as Text
import DA.Optional (fromSomeNote)


-- | CCV identifier in format "<versionTag>@<partyId>"
-- Example: "49ff34ed@participant1::ccv-owner"
type CCVId = Text

-- | Version tag (4 bytes hex, e.g., "49ff34ed")
type VersionTag = Text


-- | Create a CCVId from version tag and party.
makeCCVId : VersionTag -> Party -> CCVId
makeCCVId versionTag party = versionTag <> "@" <> partyToText party


-- | Parse a CCVId into (versionTag, party).
-- Returns None if format is invalid.
parseCCVId : CCVId -> Optional (VersionTag, Party)
parseCCVId ccvId =
    case Text.splitOn "@" ccvId of
        [versionTag, partyText] ->
            case partyFromText partyText of
                Some party -> Some (versionTag, party)
                None -> None
        _ -> None


-- | Extract version tag from CCVId.
-- Aborts if CCVId is invalid.
getVersionTag : CCVId -> VersionTag
getVersionTag ccvId =
    let (versionTag, _) = fromSomeNote "Invalid CCVId format" (parseCCVId ccvId)
    in versionTag


-- | Extract party from CCVId.
-- Aborts if CCVId is invalid.
getCCVOwner : CCVId -> Party
getCCVOwner ccvId =
    let (_, party) = fromSomeNote "Invalid CCVId format" (parseCCVId ccvId)
    in party


-- | Validate CCVId format.
isValidCCVId : CCVId -> Bool
isValidCCVId ccvId =
    case parseCCVId ccvId of
        Some _ -> True
        None -> False


-- | Check if two CCVIds match.
ccvIdEquals : CCVId -> CCVId -> Bool
ccvIdEquals = (==)


-- | Check if a CCVId is in a list.
ccvIdElem : CCVId -> [CCVId] -> Bool
ccvIdElem ccvId ccvIds = ccvId `elem` ccvIds


-- | Remove duplicates from a list of CCVIds.
dedupCCVIds : [CCVId] -> [CCVId]
dedupCCVIds [] = []
dedupCCVIds (x :: xs) =
    if x `elem` xs
    then dedupCCVIds xs
    else x :: dedupCCVIds xs
