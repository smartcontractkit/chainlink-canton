-- | Ticket contracts for cross-participant CCIP communication.
module CCIP.Tickets where

import DA.Crypto.Text (BytesHex)

import qualified Splice.Api.Token.HoldingV1

import qualified CCIP.ExecutingMessageV1


-- | Issuer type for receipts.
data IssuerType
    = IssuerType_CCV      -- Cross-chain verifier
    | IssuerType_Pool     -- Token pool
    | IssuerType_Network  -- Network/protocol fee
    deriving (Eq, Show)

-- | Fee/gas accounting for a single entity (CCV, pool, executor, or network).
data Receipt = Receipt
    with
        issuerType : IssuerType        -- Type of issuer
        issuerAddress : BytesHex       -- 32-byte instance address
        versionTag : Optional BytesHex -- 4-byte version tag for CCVs, None for pools/network
        destGasLimit : Int             -- Gas allocated for dest chain execution
        destBytesOverhead : Int        -- Data availability overhead in bytes
        feeTokenAmount : Numeric 0     -- Fee amount in fee token units
        extraArgs : BytesHex           -- Entity-specific arguments
    deriving (Eq, Show)

-- | Ticket issued by the CCV (via CCVRegistry) for outbound attestation.
-- Stakeholders can read all fields directly; instance address computed as needed.
template CCVTicket
    with
        ccvInstanceId : Text
        ccvOwner : Party
        versionTag : BytesHex          -- 4-byte version tag (e.g., "49ff34ed")
        ccvRegistryInstanceId : Text   -- Identifies the issuing CCVRegistry
        ccvRegistryOwner : Party       -- CCVRegistry's signatory party
        sender : Party

        verifierBlob : BytesHex
        messageSentObservers : [Party]
        receipt : Receipt              -- Fee/gas contribution from this CCV
    where
        signatory ccvRegistryOwner
        observer ccvOwner, sender

        choice CCVTicket_Archive : ()
            with
                caller : Party
            controller caller
            do
                assertMsg "CCVTicket_Archive: caller must be sender or ccvRegistryOwner"
                    (caller == sender || caller == ccvRegistryOwner)


-- | Ticket issued by CCV (via CCVRegistry) after verifying an inbound message.
-- References the ExecutingMessageV1 that was verified against.
template CCVVerifyTicket
    with
        ccvInstanceId : Text           -- CCV's instanceId
        ccvOwner : Party
        versionTag : BytesHex          -- 4-byte version tag
        ccvRegistryInstanceId : Text   -- Identifies the issuing CCVRegistry
        ccvRegistryOwner : Party       -- CCVRegistry's signatory party
        receiver : Party               -- Message receiver
        executor : Party               -- Executor party (may differ from receiver)
        executingMessageCid : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
    where
        signatory ccvRegistryOwner
        observer ccvOwner, receiver, executor

        choice CCVVerifyTicket_Archive : ()
            with
                caller : Party
            controller caller
            do
                assertMsg "CCVVerifyTicket_Archive: caller must be receiver, ccvRegistryOwner, or executor"
                    (caller == receiver || caller == ccvRegistryOwner || caller == executor)

-- | Ticket issued by TokenAdminRegistry after pool locks tokens for outbound transfer.
-- Stakeholders can read all fields directly; pool address computed by OnRamp.
-- Archived by TokenAdminRegistry_ConsumeSendTicket.
template TokenSendTicket
    with
        ccipOwner : Party      -- TAR's signatory party
        tokenAdminRegistryInstanceId : Text  -- Identifies the issuing TAR
        poolInstanceId : Text          -- Pool's instanceId for address computation
        poolOwner : Party
        sender : Party

        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId

        sourceTokenAddress : BytesHex
        amount : Numeric 0
        destTokenAddress : BytesHex
        tokenReceiver : BytesHex
        extraData : BytesHex
        receipt : Receipt              -- Fee/gas contribution from pool
    where
        signatory ccipOwner
        observer poolOwner, sender

-- | Ticket issued by tokenpool after verifying its required CCVs for inbound transfer.
-- Passed to PerPartyRouter.Execute to prove pool's CCV requirements are satisfied.
-- Contains the CCV tickets that satisfy the pool's per-chain requirements.
template TokenPoolCCVVerifiedTicket
    with
        poolOwner : Party
        poolInstanceId : Text
        ccipOwner : Party
        receiver : Party
        tokenReceiver : Party
        executor : Party
        executingMessageCid : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
        ccvVerifyTicketCids : [ContractId CCVVerifyTicket]
    where
        signatory poolOwner
        observer ccipOwner, receiver, tokenReceiver, executor

        choice TokenPoolCCVVerifiedTicket_Archive : ()
            with
                caller : Party
            controller caller
            do
                assertMsg "TokenPoolCCVVerifiedTicket_Archive: caller must be receiver, ccipOwner, or executor"
                    (caller == receiver || caller == ccipOwner || caller == executor)

-- | Ticket issued by OffRamp (via TokenAdminRegistry) after successful message verification.
template TokenReceiveTicket
    with
        ccipOwner : Party
        tokenAdminRegistryInstanceId : Text  -- Identifies the issuing TAR
        poolOwner : Party           -- Observer - pool that should release
        receiver : Party            -- Message receiver (observer)
        tokenReceiver : Party       -- Who gets the tokens (may differ from receiver)

        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        amount : Numeric 0

        messageHash : BytesHex
        sourceChainSelector : Numeric 0
    where
        signatory ccipOwner
        observer poolOwner, receiver, tokenReceiver
