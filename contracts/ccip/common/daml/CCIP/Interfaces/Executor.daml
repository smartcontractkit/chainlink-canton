module CCIP.Interfaces.Executor where

import MCMS.RawInstanceAddress (RawInstanceAddress)

interface IExecutor where
    viewtype ExecutorView

    executor_getFeeImpl :
        ContractId IExecutor ->
        Executor_GetFee ->
        Update ExecutorFeeQuote

    nonconsuming choice Executor_GetFee : ExecutorFeeQuote
        with
            destChainSelector : Numeric 0
            requiredCCVs : [RawInstanceAddress]
            caller : Party
        controller caller
        do executor_getFeeImpl this self arg

data ExecutorView = ExecutorView
    with
        owner : Party
    deriving (Eq, Show)

data ExecutorFeeQuote = ExecutorFeeQuote
    with
        executorInstanceId : Text
        executorOwner : Party
        feeUSDCents : Numeric 0
    deriving (Eq, Show)
