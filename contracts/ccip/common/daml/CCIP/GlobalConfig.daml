-- | Global configuration for CCIP, shared across all PerPartyRouters.
module CCIP.GlobalConfig
  ( module CCIP.GlobalConfig
  , module CCIP.GlobalConfigTypes
  ) where

import DA.Crypto.Text (byteCount)
import DA.Foldable (forA_)
import DA.List qualified as List
import DA.Map qualified as Map

import Splice.Api.Token.MetadataV1 (ChoiceContext)

import qualified CCIP.Context
import CCIP.GlobalConfigTypes (
    DestChainConfig(..),
    DestChainConfigArgs(..),
    SourceChainConfig(..),
    SourceChainConfigArgs(..),
    ApplyDestChainConfigUpdatesParams(..),
    ApplySourceChainConfigUpdatesParams(..),
    )
import CCIP.GlobalConfigCodecGen (decodeApplyDestChainConfigUpdatesParamsAt, decodeApplySourceChainConfigUpdatesParamsAt)
import MCMS.RawInstanceAddress (RawInstanceAddress(..), assertValidInstanceId)

import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiverView(..))
import MCMS.Crypto (assertValidHex)

validateDefaultAndMandatedCCVs : [RawInstanceAddress] -> [RawInstanceAddress] -> Update ()
validateDefaultAndMandatedCCVs defaultCCV laneMandatedCCVs = do
  let totalLength = length defaultCCV + length laneMandatedCCVs
  assertMsg "MustSpecifyDefaultOrRequiredCCVs: at least one CCV must be specified" (totalLength > 0)
  let combined = defaultCCV <> laneMandatedCCVs
  assertNoDuplicates combined
  validateNoEmptyAddresses combined

assertNoDuplicates : [RawInstanceAddress] -> Update ()
assertNoDuplicates addresses = do
  let duplicateCandidates =
        List.filter
          (\address -> length (List.filter (== address) addresses) > 1)
          addresses
  case duplicateCandidates of
    duplicateAddress :: _ ->
      assertMsg ("DuplicateCCVNotAllowed: " <> show duplicateAddress) False
    [] -> pure ()

validateNoEmptyAddresses : [RawInstanceAddress] -> Update ()
validateNoEmptyAddresses addresses = do
  let emptyAddresses = List.filter (\address -> address == RawInstanceAddress "") addresses
  case emptyAddresses of
    emptyAddress :: _ ->
      assertMsg ("ZeroAddressNotAllowed") False
    [] -> pure ()

template GlobalConfig
    with
        instanceId : Text
        ccipOwner : Party

        chainSelector : Numeric 0

        destChainConfigs : Map.Map (Numeric 0) DestChainConfig
        sourceChainConfigs : Map.Map (Numeric 0) SourceChainConfig
    where
        signatory ccipOwner

        ensure assertValidInstanceId instanceId
            && chainSelector > 0.0
            && all (\destChainSelector -> destChainSelector > 0.0 && destChainSelector /= chainSelector) (Map.keys destChainConfigs)
            && all (\sourceChainSelector -> sourceChainSelector > 0.0 && sourceChainSelector /= chainSelector) (Map.keys sourceChainConfigs)

        nonconsuming choice GetDestChainConfig : Optional DestChainConfig
            with
                destChainSelector : Numeric 0
                caller : Party
            controller caller
            do pure (Map.lookup destChainSelector destChainConfigs)

        nonconsuming choice GetSourceChainConfig : Optional SourceChainConfig
            with
                sourceChainSelector : Numeric 0
                caller : Party
            controller caller
            do pure (Map.lookup sourceChainSelector sourceChainConfigs)

        choice ApplyDestChainConfigUpdates : ContractId GlobalConfig
            with
              destChainConfigUpdates : [DestChainConfigArgs]
            controller ccipOwner
            do
                -- Validate
                forA_ destChainConfigUpdates $ \DestChainConfigArgs{destChainSelector, addressBytesLength, baseExecutionGasCost, offRampAddress, defaultCCVs, laneMandatedCCVs} -> do
                    assertMsg "InvalidChainSelector: destination chain selector must be greater than zero" (destChainSelector > 0.0)
                    assertMsg "InvalidChainSelector: destination chain selector must not be the same as the local chain selector" (destChainSelector /= chainSelector)
                    assertMsg "InvalidAddressByteLength: address byte length must be greater than zero" (addressBytesLength > 0)
                    assertMsg "InvalidBaseExecutionGasCost: base execution gas cost must be non-negative" (baseExecutionGasCost >= 0)
                    assertValidHex "offRampAddress" offRampAddress
                    assertMsg ("InvalidDestChainAddress: addressByteLength is " <> show addressBytesLength <> " but offRampAddress has byte length " <> show (byteCount offRampAddress) <> " for destination chain selector " <> show destChainSelector) (byteCount offRampAddress == addressBytesLength)
                    validateDefaultAndMandatedCCVs defaultCCVs laneMandatedCCVs

                -- Update
                let newConfigs = foldl
                        (\configs DestChainConfigArgs{destChainSelector, isEnabled, addressBytesLength, baseExecutionGasCost, tokenReceiverAllowed, offRampAddress, defaultExecutor, laneMandatedCCVs, defaultCCVs, messageNetworkFeeUSDCents, tokenNetworkFeeUSDCents} ->
                            Map.insert destChainSelector DestChainConfig with
                                isEnabled,
                                 addressBytesLength,
                                 baseExecutionGasCost,
                                 tokenReceiverAllowed,
                                 offRampAddress,
                                 defaultExecutor,
                                 laneMandatedCCVs,
                                 defaultCCVs,
                                 messageNetworkFeeUSDCents,
                                 tokenNetworkFeeUSDCents
                            configs)
                        destChainConfigs
                        destChainConfigUpdates
                create this with destChainConfigs = newConfigs

        choice ApplySourceChainConfigUpdates : ContractId GlobalConfig
            with
              sourceChainConfigUpdates : [SourceChainConfigArgs]
            controller ccipOwner
            do
                -- Validate
                forA_ sourceChainConfigUpdates $ \SourceChainConfigArgs{sourceChainSelector, onRampAddresses, defaultCCVs, laneMandatedCCVs} -> do
                    assertMsg "InvalidChainSelector: source chain selector must be greater than zero" (sourceChainSelector > 0.0)
                    assertMsg "InvalidChainSelector: source chain selector must not be the same as the local chain selector" (sourceChainSelector /= chainSelector)
                    forA_ onRampAddresses $ \addr -> assertValidHex "onRampAddress" addr
                    validateDefaultAndMandatedCCVs defaultCCVs laneMandatedCCVs
                    assertMsg "laneMandatedCCVs: at least one lane-mandated CCV required for source chain" (not (null laneMandatedCCVs))

                -- Update
                let newConfigs = foldl
                        (\configs SourceChainConfigArgs{sourceChainSelector, isEnabled, onRampAddresses, defaultCCVs, laneMandatedCCVs} ->
                            Map.insert sourceChainSelector SourceChainConfig{isEnabled, onRampAddresses, defaultCCVs, laneMandatedCCVs} configs)
                        sourceChainConfigs
                        sourceChainConfigUpdates
                create this with sourceChainConfigs = newConfigs

        -- ==========================================
        -- |         MCMSReceiver Interface         |
        -- ==========================================

        interface instance MCMSReceiver for GlobalConfig where
            view = MCMSReceiverView with
                mcmsController = ccipOwner
                instanceId

            mcmsEntrypoint functionName operationData contractIds = do
                let instAddr = instanceId <> "@" <> partyToText ccipOwner
                selfCid <- case Map.lookup instAddr contractIds of
                    None -> abort $ "E_SELF_CID_NOT_IN_MAP: " <> instAddr
                    Some cid -> pure (coerceContractId cid : ContractId GlobalConfig)

                case functionName of
                    "ApplyDestChainConfigUpdates" -> do
                        case decodeApplyDestChainConfigUpdatesParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: ApplyDestChainConfigUpdates"
                            Some (ApplyDestChainConfigUpdatesParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: ApplyDestChainConfigUpdates" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid ApplyDestChainConfigUpdates with
                                    destChainConfigUpdates = destChainConfigArgs
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "ApplySourceChainConfigUpdates" -> do
                        case decodeApplySourceChainConfigUpdatesParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: ApplySourceChainConfigUpdates"
                            Some (ApplySourceChainConfigUpdatesParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: ApplySourceChainConfigUpdates" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid ApplySourceChainConfigUpdates with
                                    sourceChainConfigUpdates = sourceChainConfigArgs
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    _ -> abort $ "E_UNKNOWN_FUNCTION: " <> functionName

globalConfigKey : Text
globalConfigKey = "global-config"

lookupGlobalConfigCid : ChoiceContext -> Update (ContractId GlobalConfig)
lookupGlobalConfigCid ctx = CCIP.Context.getFromContextU ctx globalConfigKey
