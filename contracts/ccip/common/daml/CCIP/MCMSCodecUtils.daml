-- | Shared MCMS-compatible codec utilities for CCIP contracts.
-- Re-exports primitives from MCMS.Codec and adds CCIP-specific type encoders
-- (Party, InstrumentId, Bool-at-offset).
-- Any CCIP contract integrating MCMS should import from here rather than
-- duplicating the low-level encoding functions.
module CCIP.MCMSCodecUtils
  ( -- Re-exported MCMS.Codec primitives
    extractBytes
  , encodeUint8
  , decodeUint8
  , encodeUint16
  , decodeUint16
  , encodeUint32
  , decodeUint32
  , encodeText
  , decodeText
  , decodeTextAt
  , encodeBool
  , decodeBool
  , encodeList
  , decodeList
  -- CCIP-specific type helpers
  , encodeParty
  , decodePartyAt
  , encodeInstrumentId
  , decodeInstrumentId
  , decodeBoolAt
  ) where

import MCMS.Codec
  ( extractBytes
  , encodeUint8
  , decodeUint8
  , encodeUint16
  , decodeUint16
  , encodeUint32
  , decodeUint32
  , encodeText
  , decodeText
  , encodeBool
  , decodeBool
  , encodeList
  , decodeList
  )

import DA.Crypto.Text (BytesHex, toHex, fromHex, byteCount)
import DA.Optional (fromSome)
import qualified Splice.Api.Token.HoldingV1

-- | Alias for MCMS.Codec.decodeText (same signature: BytesHex -> Int -> Optional (Text, Int))
decodeTextAt : BytesHex -> Int -> Optional (Text, Int)
decodeTextAt = decodeText

-- ===========================================================================
-- PARTY ENCODING/DECODING
-- Format: [uint8 len][party text as hex]
-- ===========================================================================

encodeParty : Party -> BytesHex
encodeParty party =
  let
    partyHex = toHex (partyToText party)
    len = byteCount partyHex
  in
    fromSome (encodeUint8 len) <> partyHex

decodePartyAt : BytesHex -> Int -> Optional (Party, Int)
decodePartyAt encoded offset = do
  lenHex <- extractBytes encoded offset 1
  len <- decodeUint8 lenHex
  partyHex <- extractBytes encoded (offset + 1) len
  partyText <- fromHex partyHex
  party <- partyFromText partyText
  Some (party, offset + 1 + len)

-- ===========================================================================
-- INSTRUMENT ID ENCODING/DECODING
-- Format: [uint8 adminLen][admin party text as hex][uint8 idLen][id text as hex]
-- ===========================================================================

encodeInstrumentId : Splice.Api.Token.HoldingV1.InstrumentId -> BytesHex
encodeInstrumentId instrumentId =
  let
    adminHex = toHex (partyToText instrumentId.admin)
    adminLen = byteCount adminHex
    idHex = toHex instrumentId.id
    idLen = byteCount idHex
  in
    fromSome (encodeUint8 adminLen) <> adminHex <> fromSome (encodeUint8 idLen) <> idHex

decodeInstrumentId : BytesHex -> Int -> Optional (Splice.Api.Token.HoldingV1.InstrumentId, Int)
decodeInstrumentId encoded offset = do
  adminLenHex <- extractBytes encoded offset 1
  adminLen <- decodeUint8 adminLenHex
  adminHex <- extractBytes encoded (offset + 1) adminLen
  adminText <- fromHex adminHex
  admin <- partyFromText adminText
  idLenHex <- extractBytes encoded (offset + 1 + adminLen) 1
  idLen <- decodeUint8 idLenHex
  idHex <- extractBytes encoded (offset + 2 + adminLen) idLen
  idText <- fromHex idHex
  let newOffset = offset + 2 + adminLen + idLen
  Some (Splice.Api.Token.HoldingV1.InstrumentId admin idText, newOffset)

-- ===========================================================================
-- BOOL-AT-OFFSET DECODING
-- MCMS.Codec.decodeBool takes raw hex; this variant works at an offset.
-- ===========================================================================

decodeBoolAt : BytesHex -> Int -> Optional (Bool, Int)
decodeBoolAt encoded offset = do
  boolHex <- extractBytes encoded offset 1
  if boolHex == "01" then Some (True, offset + 1)
  else if boolHex == "00" then Some (False, offset + 1)
  else None
