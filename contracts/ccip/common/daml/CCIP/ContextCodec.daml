-- | Codec module for CCIPContext and AnyValue encoding/decoding
-- Used by pool contracts for MCMS operations that need to set poolReceiveContext
module CCIP.ContextCodec
  ( -- CCIPContext encoding
    encodeCCIPContext
  , decodeCCIPContextAt
  -- AnyValue encoding (for extensibility)
  , encodeAnyValue
  , decodeAnyValueAt
  -- TextMap encoding
  , encodeTextMapAnyValue
  , decodeTextMapAnyValueAt
  ) where

import DA.Time (RelTime, subTime, addRelTime, convertMicrosecondsToRelTime, convertRelTimeToMicroseconds, time)
import DA.Date (date, Month(..), subDate, addDays)
import DA.TextMap (TextMap)
import DA.TextMap qualified as TextMap
import DA.Crypto.Text (BytesHex)
import DA.Optional (fromSome)

import CCIP.Context (CCIPContext(..), AnyValue(..))

import MCMS.Codec
  ( extractBytes
  , encodeUint8
  , decodeUint8
  , encodeInt64
  , decodeInt64At
  , encodeText
  , decodeTextAt
  , encodeBool
  , decodeBoolAt
  , encodeDecimal
  , decodeDecimalAt
  , encodeList
  , decodeList
  )

-- ===========================================================================
-- CCIPCONTEXT ENCODING/DECODING
-- CCIPContext is a wrapper around TextMap AnyValue
-- ===========================================================================

-- | Encode CCIPContext as TextMap AnyValue
encodeCCIPContext : CCIPContext -> BytesHex
encodeCCIPContext (CCIPContext values) = encodeTextMapAnyValue values

-- | Decode CCIPContext from bytes
decodeCCIPContextAt : BytesHex -> Int -> Optional (CCIPContext, Int)
decodeCCIPContextAt encoded offset = do
  (values, newOffset) <- decodeTextMapAnyValueAt encoded offset
  Some (CCIPContext values, newOffset)

-- ===========================================================================
-- TEXTMAP ANYVALUE ENCODING/DECODING
-- Format: [uint8 count][(text key)(anyvalue value)]*
-- ===========================================================================

-- | Encode TextMap AnyValue
encodeTextMapAnyValue : TextMap AnyValue -> BytesHex
encodeTextMapAnyValue m =
  let entries = TextMap.toList m
      count = length entries
      encodeEntry (k, v) = encodeText k <> encodeAnyValue v
  in fromSome (encodeUint8 count) <> foldl (\acc entry -> acc <> encodeEntry entry) "" entries

-- | Decode TextMap AnyValue
decodeTextMapAnyValueAt : BytesHex -> Int -> Optional (TextMap AnyValue, Int)
decodeTextMapAnyValueAt encoded offset = do
  countHex <- extractBytes encoded offset 1
  count <- decodeUint8 countHex
  decodeTextMapEntries encoded (offset + 1) count []

-- | Helper to decode TextMap entries
decodeTextMapEntries : BytesHex -> Int -> Int -> [(Text, AnyValue)] -> Optional (TextMap AnyValue, Int)
decodeTextMapEntries _ offset 0 acc = Some (TextMap.fromList (reverse acc), offset)
decodeTextMapEntries encoded offset remaining acc = do
  (key, offset1) <- decodeTextAt encoded offset
  (value, offset2) <- decodeAnyValueAt encoded offset1
  decodeTextMapEntries encoded offset2 (remaining - 1) ((key, value) :: acc)

-- ===========================================================================
-- ANYVALUE ENCODING/DECODING
-- Format: [tag byte][variant data]
-- Tags:
--   0x00 = AV_Text
--   0x01 = AV_Int
--   0x02 = AV_Decimal
--   0x03 = AV_Bool
--   0x04 = AV_Date
--   0x05 = AV_Time
--   0x06 = AV_RelTime
--   0x07 = AV_Party
--   0x08 = AV_ContractId
--   0x09 = AV_List
--   0x0A = AV_Map
-- ===========================================================================

-- | Encode AnyValue with tag byte
encodeAnyValue : AnyValue -> BytesHex
encodeAnyValue (AV_Text t) = "00" <> encodeText t
encodeAnyValue (AV_Int i) = "01" <> fromSome (encodeInt64 i)
encodeAnyValue (AV_Decimal d) = "02" <> encodeDecimal d
encodeAnyValue (AV_Bool b) = "03" <> encodeBool b
encodeAnyValue (AV_Date d) = "04" <> encodeDate d
encodeAnyValue (AV_Time t) = "05" <> encodeTime t
encodeAnyValue (AV_RelTime r) = "06" <> encodeRelTime r
encodeAnyValue (AV_Party p) = "07" <> encodePartyValue p
encodeAnyValue (AV_ContractId cid) = "08" <> encodeContractIdValue cid
encodeAnyValue (AV_List items) = "09" <> encodeList items encodeAnyValue
encodeAnyValue (AV_Map m) = "0a" <> encodeTextMapAnyValue m

-- | Decode AnyValue based on tag byte
decodeAnyValueAt : BytesHex -> Int -> Optional (AnyValue, Int)
decodeAnyValueAt encoded offset = do
  tagHex <- extractBytes encoded offset 1
  let tagOffset = offset + 1
  case tagHex of
    "00" -> do  -- AV_Text
      (t, newOffset) <- decodeTextAt encoded tagOffset
      Some (AV_Text t, newOffset)
    "01" -> do  -- AV_Int
      (i, newOffset) <- decodeInt64At encoded tagOffset
      Some (AV_Int i, newOffset)
    "02" -> do  -- AV_Decimal
      (d, newOffset) <- decodeDecimalAt encoded tagOffset
      Some (AV_Decimal d, newOffset)
    "03" -> do  -- AV_Bool
      (b, newOffset) <- decodeBoolAt encoded tagOffset
      Some (AV_Bool b, newOffset)
    "04" -> do  -- AV_Date
      (d, newOffset) <- decodeDateAt encoded tagOffset
      Some (AV_Date d, newOffset)
    "05" -> do  -- AV_Time
      (t, newOffset) <- decodeTimeAt encoded tagOffset
      Some (AV_Time t, newOffset)
    "06" -> do  -- AV_RelTime
      (r, newOffset) <- decodeRelTimeAt encoded tagOffset
      Some (AV_RelTime r, newOffset)
    "07" -> do  -- AV_Party
      (p, newOffset) <- decodePartyValueAt encoded tagOffset
      Some (AV_Party p, newOffset)
    "08" -> do  -- AV_ContractId
      (cid, newOffset) <- decodeContractIdValueAt encoded tagOffset
      Some (AV_ContractId cid, newOffset)
    "09" -> do  -- AV_List
      (items, newOffset) <- decodeList encoded tagOffset decodeAnyValueAt
      Some (AV_List items, newOffset)
    "0a" -> do  -- AV_Map
      (m, newOffset) <- decodeTextMapAnyValueAt encoded tagOffset
      Some (AV_Map m, newOffset)
    _ -> None

-- ===========================================================================
-- DATE ENCODING/DECODING
-- Format: int64 representing days since epoch (1970-01-01)
-- ===========================================================================

-- | Reference epoch for date encoding
epochDate : Date
epochDate = date 1970 Jan 1

-- | Encode Date as days since epoch
encodeDate : Date -> BytesHex
encodeDate d =
  let days = subDate d epochDate
  in fromSome (encodeInt64 days)

-- | Decode Date from days since epoch
decodeDateAt : BytesHex -> Int -> Optional (Date, Int)
decodeDateAt encoded offset = do
  (days, newOffset) <- decodeInt64At encoded offset
  let resultDate = addDays epochDate days
  Some (resultDate, newOffset)

-- ===========================================================================
-- TIME ENCODING/DECODING
-- Format: int64 representing microseconds since Unix epoch
-- ===========================================================================

-- | Reference epoch for time encoding
epochTime : Time
epochTime = time (date 1970 Jan 1) 0 0 0

-- | Encode Time as microseconds since epoch
encodeTime : Time -> BytesHex
encodeTime t =
  let relTime = subTime t epochTime
      micros = convertRelTimeToMicroseconds relTime
  in fromSome (encodeInt64 micros)

-- | Decode Time from microseconds since epoch
decodeTimeAt : BytesHex -> Int -> Optional (Time, Int)
decodeTimeAt encoded offset = do
  (micros, newOffset) <- decodeInt64At encoded offset
  let resultTime = addRelTime epochTime (convertMicrosecondsToRelTime micros)
  Some (resultTime, newOffset)

-- ===========================================================================
-- RELTIME ENCODING/DECODING
-- Format: int64 representing microseconds
-- ===========================================================================

-- | Encode RelTime as microseconds (int64)
encodeRelTime : RelTime -> BytesHex
encodeRelTime r =
  let micros = convertRelTimeToMicroseconds r
  in fromSome (encodeInt64 micros)

-- | Decode RelTime from microseconds (int64)
decodeRelTimeAt : BytesHex -> Int -> Optional (RelTime, Int)
decodeRelTimeAt encoded offset = do
  (micros, newOffset) <- decodeInt64At encoded offset
  Some (convertMicrosecondsToRelTime micros, newOffset)

-- ===========================================================================
-- PARTY ENCODING/DECODING
-- Format: length-prefixed party text
-- ===========================================================================

-- | Encode Party as text
encodePartyValue : Party -> BytesHex
encodePartyValue p = encodeText (partyToText p)

-- | Decode Party from text
decodePartyValueAt : BytesHex -> Int -> Optional (Party, Int)
decodePartyValueAt encoded offset = do
  (text, newOffset) <- decodeTextAt encoded offset
  party <- partyFromText text
  Some (party, newOffset)

-- ===========================================================================
-- CONTRACTID ENCODING/DECODING
-- Format: length-prefixed contract ID text
-- LIMITATION: Encode-only. Daml has no contractIdFromText, so decoding
-- always returns None. Use AV_Text for contract IDs that need round-trip.
-- ===========================================================================

-- | Encode ContractId as text (encode-only)
encodeContractIdValue : ContractId () -> BytesHex
encodeContractIdValue cid = encodeText (show cid)

-- | Decode ContractId - ALWAYS RETURNS NONE
-- Daml has no contractIdFromText. Use AV_Text for contract IDs instead.
decodeContractIdValueAt : BytesHex -> Int -> Optional (ContractId (), Int)
decodeContractIdValueAt encoded offset = do
  -- Skip the text bytes to advance offset correctly
  (_cidText, newOffset) <- decodeTextAt encoded offset
  -- Cannot reconstruct ContractId - return None
  None
