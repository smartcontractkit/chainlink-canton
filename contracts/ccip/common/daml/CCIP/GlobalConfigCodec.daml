-- | Codec module for GlobalConfig MCMS parameter encoding/decoding
-- Used by the MCMSReceiver interface implementation to decode operationData
module CCIP.GlobalConfigCodec (
    decodeApplyDestChainConfigUpdatesParams,
    encodeApplyDestChainConfigUpdatesParams,
    decodeApplySourceChainConfigUpdatesParams,
    encodeApplySourceChainConfigUpdatesParams,
    ) where

import DA.Crypto.Text (BytesHex)
import DA.Optional (fromSome)

import CCIP.GlobalConfigTypes (DestChainConfigArgs(..), SourceChainConfigArgs(..))

import MCMS.Codec (
    encodeBool,
    decodeBoolAt,
    encodeNumeric0,
    decodeNumeric0At,
    encodeBytesHex,
    decodeBytesHexAt,
    encodeBytesHexList,
    decodeBytesHexList,
    encodeInt64,
    decodeInt64At,
    encodeList,
    decodeList,
    )
import CCIP.Codec (
    encodeRawInstanceAddressList,
    decodeRawInstanceAddressList
    )


-- ===============================================
-- |         ApplyDestChainConfigUpdates         |
-- ===============================================

encodeApplyDestChainConfigUpdatesParams : ([DestChainConfigArgs]) -> BytesHex
encodeApplyDestChainConfigUpdatesParams (destChainConfigUpdates) =
    encodeList destChainConfigUpdates encodeDestChainConfigArgs

encodeDestChainConfigArgs : DestChainConfigArgs -> BytesHex
encodeDestChainConfigArgs dcc =
    encodeNumeric0 dcc.destChainSelector <>
    encodeBool dcc.isEnabled <>
    fromSome (encodeInt64 dcc.addressBytesLength) <>
    fromSome (encodeInt64 dcc.baseExecutionGasCost) <>
    encodeBytesHex dcc.offRampAddress <>
    encodeRawInstanceAddressList dcc.laneMandatedCCVs <>
    encodeRawInstanceAddressList dcc.defaultCCVs <>
    encodeNumeric0 dcc.messageNetworkFeeUSDCents <>
    encodeNumeric0 dcc.tokenNetworkFeeUSDCents

decodeApplyDestChainConfigUpdatesParams : BytesHex -> Optional (([DestChainConfigArgs]), Int)
decodeApplyDestChainConfigUpdatesParams encoded = do
    (destChainConfigArgs, finalOffset) <- decodeList encoded 0 decodeDestChainConfigArgsAt
    Some (destChainConfigArgs, finalOffset)

decodeDestChainConfigArgsAt : BytesHex -> Int -> Optional (DestChainConfigArgs, Int)
decodeDestChainConfigArgsAt encoded offset = do
    (destChainSelector, offset1) <- decodeNumeric0At encoded offset
    (isEnabled, offset2) <- decodeBoolAt encoded offset1
    (addressBytesLength, offset3) <- decodeInt64At encoded offset2
    (baseExecutionGasCost, offset4) <- decodeInt64At encoded offset3
    (offRampAddress, offset5) <- decodeBytesHexAt encoded offset4
    (laneMandatedCCVs, offset6) <- decodeRawInstanceAddressList encoded offset5
    (defaultCCVs, offset7) <- decodeRawInstanceAddressList encoded offset6
    (messageNetworkFeeUSDCents, offset8) <- decodeNumeric0At encoded offset7
    (tokenNetworkFeeUSDCents, finalOffset) <- decodeNumeric0At encoded offset8
    Some ( DestChainConfigArgs with
            destChainSelector = destChainSelector
            isEnabled = isEnabled
            addressBytesLength = addressBytesLength
            baseExecutionGasCost = baseExecutionGasCost
            offRampAddress = offRampAddress
            laneMandatedCCVs = laneMandatedCCVs
            defaultCCVs = defaultCCVs
            messageNetworkFeeUSDCents = messageNetworkFeeUSDCents
            tokenNetworkFeeUSDCents = tokenNetworkFeeUSDCents
        ,finalOffset)

-- ===============================================
-- |        ApplySourceChainConfigUpdates        |
-- ===============================================

encodeApplySourceChainConfigUpdatesParams : ([SourceChainConfigArgs]) -> BytesHex
encodeApplySourceChainConfigUpdatesParams sourceChainConfigUpdates =
    encodeList sourceChainConfigUpdates encodeSourceChainConfigArgs

encodeSourceChainConfigArgs : SourceChainConfigArgs -> BytesHex
encodeSourceChainConfigArgs scc =
    encodeNumeric0 scc.sourceChainSelector <>
    encodeBool scc.isEnabled <>
    encodeBytesHexList scc.onRampAddresses <>
    encodeRawInstanceAddressList scc.laneMandatedCCVs <>
    encodeRawInstanceAddressList scc.defaultCCVs

decodeApplySourceChainConfigUpdatesParams : BytesHex -> Optional (([SourceChainConfigArgs]), Int)
decodeApplySourceChainConfigUpdatesParams encoded = do
    (sourceChainConfigArgs, finalOffset) <- decodeList encoded 0 decodeSourceChainConfigArgsAt
    Some (sourceChainConfigArgs, finalOffset)

decodeSourceChainConfigArgsAt : BytesHex -> Int -> Optional (SourceChainConfigArgs, Int)
decodeSourceChainConfigArgsAt encoded offset = do
    (sourceChainSelector, offset1) <- decodeNumeric0At encoded offset
    (isEnabled, offset2) <- decodeBoolAt encoded offset1
    (onRampAddresses, offset3) <- decodeBytesHexList encoded offset2
    (laneMandatedCCVs, offset4) <- decodeRawInstanceAddressList encoded offset3
    (defaultCCVs, finalOffset) <- decodeRawInstanceAddressList encoded offset4
    Some ( SourceChainConfigArgs with
            sourceChainSelector = sourceChainSelector
            isEnabled = isEnabled
            onRampAddresses = onRampAddresses
            laneMandatedCCVs = laneMandatedCCVs
            defaultCCVs = defaultCCVs
        , finalOffset)
