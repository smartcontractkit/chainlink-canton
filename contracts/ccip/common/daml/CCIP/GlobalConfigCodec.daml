-- | Codec module for GlobalConfig MCMS parameter encoding/decoding
-- Used by the MCMSReceiver interface implementation to decode operationData
module CCIP.GlobalConfigCodec (
    decodeApplyDestChainConfigUpdatesParams,
    encodeApplyDestChainConfigUpdatesParams,
    decodeApplySourceChainConfigUpdatesParams,
    encodeApplySourceChainConfigUpdatesParams,
    ) where

import DA.Crypto.Text (BytesHex)

import CCIP.GlobalConfigTypes (DestChainConfigArgs, SourceChainConfigArgs)

import MCMS.Codec (
    encodeList,
    decodeList,
    )
import CCIP.GlobalConfigCodecGen (
    encodeDestChainConfigArgs,
    decodeDestChainConfigArgsAt,
    encodeSourceChainConfigArgs,
    decodeSourceChainConfigArgsAt,
    )


-- ===============================================
-- |         ApplyDestChainConfigUpdates         |
-- ===============================================

encodeApplyDestChainConfigUpdatesParams : ([DestChainConfigArgs]) -> BytesHex
encodeApplyDestChainConfigUpdatesParams (destChainConfigUpdates) =
    encodeList destChainConfigUpdates encodeDestChainConfigArgs

decodeApplyDestChainConfigUpdatesParams : BytesHex -> Optional (([DestChainConfigArgs]), Int)
decodeApplyDestChainConfigUpdatesParams encoded = do
    (destChainConfigArgs, finalOffset) <- decodeList encoded 0 decodeDestChainConfigArgsAt
    Some (destChainConfigArgs, finalOffset)

-- ===============================================
-- |        ApplySourceChainConfigUpdates        |
-- ===============================================

encodeApplySourceChainConfigUpdatesParams : ([SourceChainConfigArgs]) -> BytesHex
encodeApplySourceChainConfigUpdatesParams sourceChainConfigUpdates =
    encodeList sourceChainConfigUpdates encodeSourceChainConfigArgs

decodeApplySourceChainConfigUpdatesParams : BytesHex -> Optional (([SourceChainConfigArgs]), Int)
decodeApplySourceChainConfigUpdatesParams encoded = do
    (sourceChainConfigArgs, finalOffset) <- decodeList encoded 0 decodeSourceChainConfigArgsAt
    Some (sourceChainConfigArgs, finalOffset)
