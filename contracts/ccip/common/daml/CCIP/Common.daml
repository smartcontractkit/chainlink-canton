module CCIP.Common
    ( isKnownChainFamilySelector
    ) where

import DA.Crypto.Text (BytesHex)

chainFamilySelectorEVM : BytesHex
chainFamilySelectorEVM = "2812d52c"

chainFamilySelectorSVM : BytesHex
chainFamilySelectorSVM = "1e10bdc4"

chainFamilySelectorAPTOS : BytesHex
chainFamilySelectorAPTOS = "ac77ffec"

chainFamilySelectorSUI : BytesHex
chainFamilySelectorSUI = "c4e05953"

chainFamilySelectorTVM : BytesHex
chainFamilySelectorTVM = "647e2ba9"

knownChainFamilySelectors : [BytesHex]
knownChainFamilySelectors =
    [ chainFamilySelectorEVM
    , chainFamilySelectorSVM
    , chainFamilySelectorAPTOS
    , chainFamilySelectorSUI
    , chainFamilySelectorTVM
    ]

isKnownChainFamilySelector : BytesHex -> Bool
isKnownChainFamilySelector selector =
    any (\known -> selector == known) knownChainFamilySelectors
