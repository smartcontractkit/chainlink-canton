-- | Executing message contract for inbound CCIP message processing.
-- Created by PrepareExecute, acts as a collecting contract: CCVs and pools
-- exercise choices directly on it to record verification state.
-- Consumed by OffRamp.ExecuteFromRouter after successful execution.
module CCIP.ExecutingMessageV1 where

import DA.Crypto.Text (BytesHex)
import DA.List (dedup)

import qualified CCIP.MessageCodecV1

-- | Record of a CCV verification appended via AddCCVVerification.
-- The ccvOwner is authenticated by Daml's controller mechanism.
data CCVVerification = CCVVerification
    with
        ccvInstanceId : Text
        ccvOwner : Party
        versionTag : BytesHex
    deriving (Eq, Show)

-- | Build the observer list from receiver, optional token receiver, and executor.
buildObservingParties : Party -> Optional Party -> Party -> [Party]
buildObservingParties receiver tokenReceiver executor =
    dedup $
        [receiver, executor]
        ++ case tokenReceiver of
            Some p -> [p]
            None -> []

template ExecutingMessageV1
    with
        ccipOwner : Party
        message : CCIP.MessageCodecV1.MessageV1
        messageId : BytesHex
        receiver : Party
        tokenReceiver : Optional Party
        executor : Party
        observingParties : [Party]
        ccvVerifications : [CCVVerification]
        poolCCVsVerified : Bool
    where
        signatory ccipOwner
        observer observingParties

        -- Consumed by OffRamp.ExecuteFromRouter after successful execution,
        -- or for cleanup if Execute never completed.
        choice ExecutingMessageV1_Archive : ()
            with
                caller : Party
            controller caller
            do
                assertMsg "executingMessage: caller must be ccipOwner, receiver, or executor"
                    (caller == ccipOwner || caller `elem` observingParties)

        -- Append a CCV verification record. CCV exercises this after successful
        -- signature verification; ccvOwner = caller is Daml-authenticated.
        choice AddCCVVerification : ContractId ExecutingMessageV1
            with
                ccvInstanceId : Text
                versionTag : BytesHex
                caller : Party
            controller caller
            do
                create this with
                    ccvVerifications = ccvVerifications ++ [CCVVerification with
                        ccvInstanceId
                        ccvOwner = caller
                        versionTag]

        -- Mark pool CCV requirements as satisfied. Only exercisable by ccipOwner,
        -- which is authorized through TAR's signatory context when pool calls
        -- TokenAdminRegistry_MarkPoolCCVsVerified.
        choice MarkPoolCCVsVerified : ContractId ExecutingMessageV1
            controller ccipOwner
            do
                create this with poolCCVsVerified = True
