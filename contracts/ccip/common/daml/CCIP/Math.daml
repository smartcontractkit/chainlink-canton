-- | Exact arithmetic helpers for CCIP fee math and Splice boundary conversions.
--
-- CCIP fee quoting needs exact integer semantics for operations such as:
--
--   floor(feeUsdScale * premiumMultiplier / feeTokenPrice)
--
-- and cap checks such as:
--
--   floor(feeTokenAmount * feeTokenPrice / linkTokenPrice) <= maxFeeJuelsPerMsg
--
-- Solidity uses uint256 for these operations. Daml's Numeric 0 has much less
-- headroom, so naive `a * b / c` can overflow, and `a / c * b` is not parity
-- safe because it rounds too early.
--
-- This module therefore performs exact integer arithmetic using base-1e8 limbs.
-- A limb is one chunk of a larger integer. For example, the integer
-- `12345678901234567890` is represented as little-endian limbs:
--
--   [34567890, 56789012, 1234]
--
-- Base-1e8 is a good fit here because:
-- - it matches the fee path's E8 scale,
-- - each limb product fits comfortably inside Int64,
-- - a 38-digit Numeric 0 needs only about five limbs,
-- - exact multiplication/division stays fast enough on-ledger.
--
-- This module is intentionally narrow. It exists to support CCIP's exact fee
-- arithmetic, Decimal/Numeric0 boundary shifts, and protocol-side amount
-- normalization, not as a general math library.
module CCIP.Math
  ( integerAmountWithinCap
  , normalizedFeeWithinCap
  , mulDivDown
  , mulDivUp
  , calculateLocalAmountChecked
  , decimalToNumeric0
  , numeric0ToDecimal
  , premiumIdentity
  , e10PerPercent
  , usdPerUsdCent
  ) where

import DA.Numeric qualified as Numeric
import DA.Text qualified as Text

baseInt : Int
baseInt = 100000000

baseNumeric : Numeric 0
baseNumeric = 100000000.0

juelsPerLocalLink : Numeric 0
juelsPerLocalLink = 10000000000.0

calculateLocalAmountChecked : Text -> Numeric 0 -> Int -> Int -> Numeric 0
calculateLocalAmountChecked label remoteAmount remoteDecimals localDecimals =
    if remoteAmount < 0.0 then error (label <> ": negative remote amount")
    else
        let validateDecimals fieldName decimals =
                if decimals < 0 || decimals > 37
                then error (label <> ": unsupported " <> fieldName)
                else decimals
            remoteDecimals' = validateDecimals "remote decimals" remoteDecimals
            localDecimals' = validateDecimals "local decimals" localDecimals
            diff = localDecimals' - remoteDecimals'
        in if diff == 0 then remoteAmount
           else
               let scale = checkedPow10Numeric0 (label <> ": scale factor") (abs diff)
               in if diff > 0
                  then mulDivDown remoteAmount scale 1.0
                  else mulDivDown remoteAmount 1.0 scale

checkedPow10Numeric0 : Text -> Int -> Numeric 0
checkedPow10Numeric0 label exponent
    | exponent < 0 = error (label <> ": negative exponent")
    | exponent > 37 = error (label <> ": scale factor exceeds Numeric 0 range")
    | otherwise = checkedPow10Numeric0Go exponent 1.0

checkedPow10Numeric0Go : Int -> Numeric 0 -> Numeric 0
checkedPow10Numeric0Go remaining acc =
    if remaining == 0 then acc
    else checkedPow10Numeric0Go (remaining - 1) (acc * 10.0)

decimalToNumeric0 : Decimal -> Numeric 0
decimalToNumeric0 = Numeric.shift @0

numeric0ToDecimal : Numeric 0 -> Decimal
numeric0ToDecimal = Numeric.shift @10

-- 1e10: identity multiplier (100%) in E10 scale.
premiumIdentity : Numeric 0
premiumIdentity = 10000000000.0

-- 1e8: converts a percentage (e.g. 90) to E10 scale (e.g. 9e9).
-- (`linkFeeMultiplierPercent * 1e16` converts percent → E18).
e10PerPercent : Numeric 0
e10PerPercent = 100000000.0

-- 1e8: one USD cent in E10 scale. Dividing an E10 price by this
-- yields integer USD cents; multiplying cents by this promotes
-- back to E10.
-- (`gasCostInUsdCents = ... / 1e16`).
usdPerUsdCent : Numeric 0
usdPerUsdCent = 100000000.0

-- | Check whether a LINK-denominated fee amount in local LINK smallest units
-- is within the juels-denominated cap.
integerAmountWithinCap : Numeric 0 -> Numeric 0 -> Bool
integerAmountWithinCap feeAmount maxFeeJuelsPerMsg =
    feeAmount <= juelsCapToLocalLinkCap maxFeeJuelsPerMsg

-- | Check whether a fee amount in a non-LINK token is within the juels cap.
-- The non-LINK amount is first converted into local LINK smallest units using
-- exact floor(a*b/c), then compared against the juels cap converted into local
-- LINK units.
normalizedFeeWithinCap : Numeric 0 -> Numeric 0 -> Numeric 0 -> Numeric 0 -> Bool
normalizedFeeWithinCap feeTokenAmount feeTokenPrice linkTokenPrice maxFeeJuelsPerMsg =
    convertTokenAmountLocal feeTokenAmount feeTokenPrice linkTokenPrice
        <= juelsCapToLocalLinkCap maxFeeJuelsPerMsg

-- | Exact floor(a * b / c) over integer-valued Numeric 0 inputs.
mulDivDown : Numeric 0 -> Numeric 0 -> Numeric 0 -> Numeric 0
mulDivDown a b c =
    if c <= 0.0 then error "mulDivDown: denominator must be positive"
    else if a < 0.0 || b < 0.0 then error "mulDivDown: negative input"
    else if a == 0.0 || b == 0.0 then 0.0
    else
        let numerator = mulLimbs (toLimbs "mulDivDown a" a) (toLimbs "mulDivDown b" b)
            denominator = toLimbs "mulDivDown c" c
            (quotient, _) = divModLimbs numerator denominator
        in fromLimbs "mulDivDown result" quotient

-- | Exact ceil(a * b / c) over integer-valued Numeric 0 inputs.
mulDivUp : Numeric 0 -> Numeric 0 -> Numeric 0 -> Numeric 0
mulDivUp a b c =
    if c <= 0.0 then error "mulDivUp: denominator must be positive"
    else if a < 0.0 || b < 0.0 then error "mulDivUp: negative input"
    else if a == 0.0 || b == 0.0 then 0.0
    else
        let numerator = mulLimbs (toLimbs "mulDivUp a" a) (toLimbs "mulDivUp b" b)
            denominator = toLimbs "mulDivUp c" c
            (quotient, remainder) = divModLimbs numerator denominator
            needsRoundUp = not (isZeroLimbs remainder)
            rounded = if needsRoundUp then addLimbs quotient [1] else quotient
        in fromLimbs "mulDivUp result" rounded

convertTokenAmountLocal : Numeric 0 -> Numeric 0 -> Numeric 0 -> Numeric 0
convertTokenAmountLocal amount fromPrice toPrice = mulDivDown amount fromPrice toPrice

juelsCapToLocalLinkCap : Numeric 0 -> Numeric 0
juelsCapToLocalLinkCap maxFeeJuelsPerMsg = mulDivDown maxFeeJuelsPerMsg 1.0 juelsPerLocalLink

-- -----------------------------------------------------------------------------
-- Exact base-1e8 integer arithmetic
-- -----------------------------------------------------------------------------

-- Little-endian limbs: least-significant chunk first.
toLimbs : Text -> Numeric 0 -> [Int]
toLimbs label n =
    if n < 0.0 then error (label <> ": negative integer")
    else
        let digits = numeric0IntegerText label n
        in if digits == "0" then [] else normalizeLimbs (reverse (map parseChunk (chunkTexts digits)))

fromLimbs : Text -> [Int] -> Numeric 0
fromLimbs _ [] = 0.0
fromLimbs label limbs =
    foldl
        (\acc limb -> acc * baseNumeric + intToNumeric limb)
        0.0
        (reverse (normalizeLimbs limbs))

normalizeLimbs : [Int] -> [Int]
normalizeLimbs [] = []
normalizeLimbs xs = reverse (dropLeadingZeroInts (reverse xs))

isZeroLimbs : [Int] -> Bool
isZeroLimbs xs = case normalizeLimbs xs of
    [] -> True
    _ -> False

compareLimbs : [Int] -> [Int] -> Ordering
compareLimbs a b =
    let na = normalizeLimbs a
        nb = normalizeLimbs b
        la = length na
        lb = length nb
    in if la < lb then LT
       else if la > lb then GT
       else compareBigEndian (reverse na) (reverse nb)

compareBigEndian : [Int] -> [Int] -> Ordering
compareBigEndian [] [] = EQ
compareBigEndian (x :: xs) (y :: ys) =
    if x < y then LT
    else if x > y then GT
    else compareBigEndian xs ys
compareBigEndian _ _ = error "compareBigEndian: length mismatch"

addLimbs : [Int] -> [Int] -> [Int]
addLimbs a b = normalizeLimbs (addLimbsGo a b 0)

addLimbsGo : [Int] -> [Int] -> Int -> [Int]
addLimbsGo [] [] 0 = []
addLimbsGo [] [] carry = [carry]
addLimbsGo (x :: xs) [] carry =
    let total = x + carry
    in intMod total baseInt :: addLimbsGo xs [] (intDiv total baseInt)
addLimbsGo [] (y :: ys) carry =
    let total = y + carry
    in intMod total baseInt :: addLimbsGo [] ys (intDiv total baseInt)
addLimbsGo (x :: xs) (y :: ys) carry =
    let total = x + y + carry
    in intMod total baseInt :: addLimbsGo xs ys (intDiv total baseInt)

subLimbs : [Int] -> [Int] -> [Int]
subLimbs a b = normalizeLimbs (subLimbsGo (normalizeLimbs a) (normalizeLimbs b) 0)

subLimbsGo : [Int] -> [Int] -> Int -> [Int]
subLimbsGo [] [] 0 = []
subLimbsGo [] [] _ = error "subLimbs: negative result"
subLimbsGo (x :: xs) [] borrow =
    let diff = x - borrow
    in if diff < 0
       then (diff + baseInt) :: subLimbsGo xs [] 1
       else diff :: subLimbsGo xs [] 0
subLimbsGo (x :: xs) (y :: ys) borrow =
    let diff = x - y - borrow
    in if diff < 0
       then (diff + baseInt) :: subLimbsGo xs ys 1
       else diff :: subLimbsGo xs ys 0
subLimbsGo [] (_ :: _) _ = error "subLimbs: negative result"

mulByDigit : [Int] -> Int -> [Int]
mulByDigit _ 0 = []
mulByDigit xs d = normalizeLimbs (mulByDigitGo (normalizeLimbs xs) d 0)

mulByDigitGo : [Int] -> Int -> Int -> [Int]
mulByDigitGo [] _ 0 = []
mulByDigitGo [] _ carry = [carry]
mulByDigitGo (x :: rest) d carry =
    let total = x * d + carry
    in intMod total baseInt :: mulByDigitGo rest d (intDiv total baseInt)

shiftLimbs : Int -> [Int] -> [Int]
shiftLimbs 0 xs = xs
shiftLimbs n xs = 0 :: shiftLimbs (n - 1) xs

mulLimbs : [Int] -> [Int] -> [Int]
mulLimbs a b =
    let na = normalizeLimbs a
        nb = normalizeLimbs b
    in if isZeroLimbs na || isZeroLimbs nb then []
       else foldl
            (\acc (offset, digit) -> addLimbs acc (shiftLimbs offset (mulByDigit na digit)))
            []
            (indexed nb 0)

indexed : [a] -> Int -> [(Int, a)]
indexed [] _ = []
indexed (x :: xs) i = (i, x) :: indexed xs (i + 1)

divModLimbs : [Int] -> [Int] -> ([Int], [Int])
divModLimbs numerator denominator =
    let den = normalizeLimbs denominator
    in if isZeroLimbs den then error "divModLimbs: denominator must be positive"
       else if compareLimbs numerator den == LT then ([], normalizeLimbs numerator)
       else divModLimbsGo [] [] (reverse (normalizeLimbs numerator)) den

divModLimbsGo : [Int] -> [Int] -> [Int] -> [Int] -> ([Int], [Int])
divModLimbsGo quotientRev remainder [] _ = (normalizeLimbs quotientRev, normalizeLimbs remainder)
divModLimbsGo quotientRev remainder (digit :: rest) den =
    let remainder' = normalizeLimbs (digit :: remainder)
        qDigit = quotientDigit remainder' den 0 (baseInt - 1)
        remainder'' = subLimbs remainder' (mulByDigit den qDigit)
    in divModLimbsGo (qDigit :: quotientRev) remainder'' rest den

quotientDigit : [Int] -> [Int] -> Int -> Int -> Int
quotientDigit remainder denominator low high =
    if low > high then high
    else
        let mid = intDiv (low + high) 2
            probe = mulByDigit denominator mid
        in case compareLimbs probe remainder of
            GT -> quotientDigit remainder denominator low (mid - 1)
            _ -> quotientDigit remainder denominator (mid + 1) high

numeric0IntegerText : Text -> Numeric 0 -> Text
numeric0IntegerText label n =
    let str = show n
    in if Text.isSuffixOf ".0" str
       then Text.take (Text.length str - 2) str
       else error (label <> ": expected integer-valued Numeric 0")

chunkTexts : Text -> [Text]
chunkTexts digits = chunkTextsGo digits []

chunkTextsGo : Text -> [Text] -> [Text]
chunkTextsGo digits acc =
    let len = Text.length digits
    in if len <= 8 then digits :: acc
       else chunkTextsGo (Text.take (len - 8) digits) (Text.drop (len - 8) digits :: acc)

parseChunk : Text -> Int
parseChunk chunk = case Text.parseInt chunk of
    Some n -> n
    None -> error ("Invalid digit chunk: " <> chunk)

dropLeadingZeroInts : [Int] -> [Int]
dropLeadingZeroInts [] = []
dropLeadingZeroInts (0 :: xs) = dropLeadingZeroInts xs
dropLeadingZeroInts xs = xs

intDiv : Int -> Int -> Int
intDiv a b = a / b

intMod : Int -> Int -> Int
intMod a b = a - intDiv a b * b
