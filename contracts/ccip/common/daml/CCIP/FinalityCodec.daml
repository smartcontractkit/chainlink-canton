module CCIP.FinalityCodec where

import DA.Crypto.Text (BytesHex, byteCount)
import DA.Optional (fromSomeNote)
import qualified DA.Crypto.Text
import qualified DA.Text as Text

data RequestedFinality
    = WaitForFinality
    | WaitForSafe
    | BlockDepth Int
    deriving (Eq, Show)

data DecodedFinality = DecodedFinality
    with
        raw : BytesHex
        requested : RequestedFinality
    deriving (Eq, Show)

finalityConfigByteLength : Int
finalityConfigByteLength = 4

-- EVM-compatible layout:
--   bytes 0-1 = flags (upper 16 bits)
--   bytes 2-3 = block depth (lower 16 bits)
waitForFinalityFlagBits : Int
waitForFinalityFlagBits = 0

-- Raw flag bits stored in the upper 16-bit flag field on the wire.
waitForSafeFlagBits : Int
waitForSafeFlagBits = 1

waitForFinalityFlag : BytesHex
waitForFinalityFlag = "00000000"

waitForSafeFlag : BytesHex
waitForSafeFlag = "00010000"

waitForFinalityConfig : BytesHex
waitForFinalityConfig = waitForFinalityFlag

waitForSafeConfig : BytesHex
waitForSafeConfig = waitForSafeFlag

waitForFinalityDecoded : DecodedFinality
waitForFinalityDecoded = fromSomeNote "waitForFinalityDecoded: invalid config" (decodeRequestedFinality waitForFinalityConfig)

waitForSafeDecoded : DecodedFinality
waitForSafeDecoded = fromSomeNote "waitForSafeDecoded: invalid config" (decodeRequestedFinality waitForSafeConfig)

extractBytes : BytesHex -> Int -> Int -> Optional BytesHex
extractBytes bs start len =
    let totalLen = byteCount bs
        endPos = start + len
    in
        if start >= 0 && len >= 0 && start <= totalLen && endPos <= totalLen
        then Some (Text.take (len * 2) (Text.drop (start * 2) bs))
        else None

decodeUint16 : BytesHex -> Optional Int
decodeUint16 hex =
    if byteCount hex /= 2 then None
    else DA.Crypto.Text.fromHex hex

decodeFlags : BytesHex -> Optional Int
decodeFlags finalityConfig = do
    if byteCount finalityConfig /= finalityConfigByteLength then None else do
        flagsHex <- extractBytes finalityConfig 0 2
        decodeUint16 flagsHex

decodeBlockConfirmations : BytesHex -> Optional Int
decodeBlockConfirmations finalityConfig = do
    if byteCount finalityConfig /= finalityConfigByteLength then None else do
        blockConfirmationsHex <- extractBytes finalityConfig 2 2
        decodeUint16 blockConfirmationsHex

isOdd : Int -> Bool
isOdd n = n /= 2 * (n / 2)

-- Count how many flag bits are turned on in the upper 16-bit flags field.
-- We use this to enforce that a requested finality picks only one mode.
countSetBits : Int -> Int
countSetBits n =
    if n <= 0 then 0
    else (if isOdd n then 1 else 0) + countSetBits (n / 2)

-- Walk both flag bitsets from lowest bit to highest bit and return True
-- as soon as the same flag bit is set in both values.
flagsOverlap : Int -> Int -> Bool
flagsOverlap requestedFlags allowedFlags =
    let noBitsLeft = requestedFlags <= 0 || allowedFlags <= 0
        currentBitMatches = isOdd requestedFlags && isOdd allowedFlags
    in if noBitsLeft then False
       else currentBitMatches || flagsOverlap (requestedFlags / 2) (allowedFlags / 2)

-- A requested finality must choose exactly one mode:
--   * finalized-only, or
--   * one flag like safe, or
--   * a positive block depth.
-- Mixed requests like "safe + 12 blocks" are invalid.
validateRequestedFinality : BytesHex -> Bool
validateRequestedFinality finalityConfig =
    case (decodeFlags finalityConfig, decodeBlockConfirmations finalityConfig) of
        (Some flags, Some blockConfirmations) ->
            let isFinalizedOnly = flags == 0 && blockConfirmations == 0
                hasBlockDepth = blockConfirmations > 0
                activeModes = (if hasBlockDepth then 1 else 0) + countSetBits flags
            -- Valid requests are either finalized-only (00000000),
            -- or exactly one active mode: one flag or a positive block depth.
            in isFinalizedOnly || activeModes == 1
        _ -> False

-- Decode only well-formed requested finality values.
-- Mapping:
--   * flags 0, block depth 0 -> WaitForFinality
--   * flags = safe bit, block depth 0 -> WaitForSafe
--   * flags 0, block depth > 0 -> BlockDepth n
-- Invalid combinations are rejected with None.
decodeRequestedFinality : BytesHex -> Optional DecodedFinality
decodeRequestedFinality finalityConfig =
    if not (validateRequestedFinality finalityConfig) then None else
        case (decodeFlags finalityConfig, decodeBlockConfirmations finalityConfig) of
            (Some 0, Some 0) ->
                Some (DecodedFinality with raw = finalityConfig, requested = WaitForFinality)
            (Some flags, Some 0) ->
                if flags == waitForSafeFlagBits
                then Some (DecodedFinality with raw = finalityConfig, requested = WaitForSafe)
                else None
            (Some 0, Some blockDepth) ->
                Some (DecodedFinality with raw = finalityConfig, requested = BlockDepth blockDepth)
            _ ->
                None

-- Check whether a requested finality is allowed by a receiver/pool config.
-- Rules:
--   * finalized-only is always allowed
--   * flag modes require at least one matching allowed flag
--   * block-depth mode requires requestedDepth >= allowedDepth
requestedFinalityAllowed : BytesHex -> BytesHex -> Bool
requestedFinalityAllowed requestedFinalityConfig allowedFinalityConfig =
    if requestedFinalityConfig == waitForFinalityFlag then True else
        if not (validateRequestedFinality requestedFinalityConfig) then False else
            case
                ( decodeFlags requestedFinalityConfig
                , decodeBlockConfirmations requestedFinalityConfig
                , decodeFlags allowedFinalityConfig
                , decodeBlockConfirmations allowedFinalityConfig
                ) of
                (Some requestedFlags, Some requestedBlockDepth, Some allowedFlags, Some allowedBlockDepth) ->
                    if flagsOverlap requestedFlags allowedFlags
                    then requestedBlockDepth == 0
                    else allowedBlockDepth > 0 && requestedBlockDepth >= allowedBlockDepth
                _ -> False

-- Any config other than finalized-only needs the custom-finality limiter path.
customFinalityRateLimiterRequired : BytesHex -> Bool
customFinalityRateLimiterRequired allowedFinalityConfig = allowedFinalityConfig /= waitForFinalityFlag
