-- | CCIP-specific codec utilities.
-- Contains Splice-specific (InstrumentId) and CCIP-specific (RawInstanceAddress) encoders.
-- For generic primitives, import from MCMS.Codec directly.
module CCIP.Codec
  ( -- InstrumentId encoding (Splice-specific)
    encodeInstrumentId
  , decodeInstrumentId
  , encodeInstrumentIdList
  , decodeInstrumentIdList
  -- RawInstanceAddress encoding (CCIP-specific)
  , encodeRawInstanceAddress
  , decodeRawInstanceAddressAt
  , encodeRawInstanceAddressList
  , decodeRawInstanceAddressList
  -- RequestedFinality encoding for MCMS/config codecs
  , encodeRequestedFinality
  , decodeRequestedFinalityAt
  -- Optional RawInstanceAddress encoding
  , encodeOptionalRawInstanceAddress
  , decodeOptionalRawInstanceAddressAt
  ) where

import MCMS.Codec
  ( extractBytes
  , encodeInt64
  , encodeUint8
  , decodeInt64At
  , decodeUint8
  , encodeText
  , decodeText
  )

import DA.Crypto.Text (BytesHex, toHex, fromHex, byteCount)
import DA.Optional (fromSome)
import qualified Splice.Api.Token.HoldingV1
import qualified CCIP.FinalityCodec as FinalityCodec
import MCMS.RawInstanceAddress (RawInstanceAddress(..))

-- ===========================================================================
-- INSTRUMENT ID ENCODING/DECODING (Splice-specific)
-- Format: [uint8 adminLen][admin party text as hex][uint8 idLen][id text as hex]
-- ===========================================================================

encodeInstrumentId : Splice.Api.Token.HoldingV1.InstrumentId -> BytesHex
encodeInstrumentId instrumentId =
  let
    adminHex = toHex (partyToText instrumentId.admin)
    adminLen = byteCount adminHex
    idHex = toHex instrumentId.id
    idLen = byteCount idHex
  in
    fromSome (encodeUint8 adminLen) <> adminHex <> fromSome (encodeUint8 idLen) <> idHex

decodeInstrumentId : BytesHex -> Int -> Optional (Splice.Api.Token.HoldingV1.InstrumentId, Int)
decodeInstrumentId encoded offset = do
  adminLenHex <- extractBytes encoded offset 1
  adminLen <- decodeUint8 adminLenHex
  adminHex <- extractBytes encoded (offset + 1) adminLen
  adminText <- fromHex adminHex
  admin <- partyFromText adminText
  idLenHex <- extractBytes encoded (offset + 1 + adminLen) 1
  idLen <- decodeUint8 idLenHex
  idHex <- extractBytes encoded (offset + 2 + adminLen) idLen
  idText <- fromHex idHex
  let newOffset = offset + 2 + adminLen + idLen
  Some (Splice.Api.Token.HoldingV1.InstrumentId admin idText, newOffset)

-- ===========================================================================
-- INSTRUMENT ID LIST ENCODING/DECODING
-- Format: [uint8 count][instrumentId...]
-- ===========================================================================

encodeInstrumentIdList : [Splice.Api.Token.HoldingV1.InstrumentId] -> BytesHex
encodeInstrumentIdList ids =
  let count = length ids
  in fromSome (encodeUint8 count) <> foldl (\acc iid -> acc <> encodeInstrumentId iid) "" ids

decodeInstrumentIdList : BytesHex -> Int -> Optional ([Splice.Api.Token.HoldingV1.InstrumentId], Int)
decodeInstrumentIdList encoded offset = do
  countHex <- extractBytes encoded offset 1
  count <- decodeUint8 countHex
  decodeInstrumentIdListHelper encoded (offset + 1) count []

decodeInstrumentIdListHelper : BytesHex -> Int -> Int -> [Splice.Api.Token.HoldingV1.InstrumentId] -> Optional ([Splice.Api.Token.HoldingV1.InstrumentId], Int)
decodeInstrumentIdListHelper _ offset 0 acc = Some (reverse acc, offset)
decodeInstrumentIdListHelper encoded offset remaining acc = do
  (iid, newOffset) <- decodeInstrumentId encoded offset
  decodeInstrumentIdListHelper encoded newOffset (remaining - 1) (iid :: acc)

-- ===========================================================================
-- RAW INSTANCE ADDRESS ENCODING/DECODING (CCIP-specific)
-- RawInstanceAddress is a newtype around Text in format "instanceId@partyId"
-- Format: [text rawAddr]
-- ===========================================================================

-- | Encode RawInstanceAddress as length-prefixed text
encodeRawInstanceAddress : RawInstanceAddress -> BytesHex
encodeRawInstanceAddress (RawInstanceAddress rawText) = encodeText rawText

-- | Decode RawInstanceAddress from length-prefixed text
decodeRawInstanceAddressAt : BytesHex -> Int -> Optional (RawInstanceAddress, Int)
decodeRawInstanceAddressAt encoded offset = do
  (rawText, newOffset) <- decodeText encoded offset
  Some (RawInstanceAddress rawText, newOffset)

-- | Encode list of RawInstanceAddress
encodeRawInstanceAddressList : [RawInstanceAddress] -> BytesHex
encodeRawInstanceAddressList rias =
  let count = length rias
  in fromSome (encodeUint8 count) <> foldl (\acc ria -> acc <> encodeRawInstanceAddress ria) "" rias

-- | Decode list of RawInstanceAddress
decodeRawInstanceAddressList : BytesHex -> Int -> Optional ([RawInstanceAddress], Int)
decodeRawInstanceAddressList encoded offset = do
  countHex <- extractBytes encoded offset 1
  count <- decodeUint8 countHex
  decodeRawInstanceAddressListHelper encoded (offset + 1) count []

decodeRawInstanceAddressListHelper : BytesHex -> Int -> Int -> [RawInstanceAddress] -> Optional ([RawInstanceAddress], Int)
decodeRawInstanceAddressListHelper _ offset 0 acc = Some (reverse acc, offset)
decodeRawInstanceAddressListHelper encoded offset remaining acc = do
  (ria, newOffset) <- decodeRawInstanceAddressAt encoded offset
  decodeRawInstanceAddressListHelper encoded newOffset (remaining - 1) (ria :: acc)

-- ===========================================================================
-- REQUESTED FINALITY ENCODING/DECODING
-- Format: [uint8 tag] for nullary constructors, [uint8 tag][int64 depth]
-- Tags:
--   0 = WaitForFinality
--   1 = WaitForSafe
--   2 = BlockDepth
-- ===========================================================================

encodeRequestedFinality : FinalityCodec.RequestedFinality -> BytesHex
encodeRequestedFinality requestedFinality =
  case requestedFinality of
    FinalityCodec.WaitForFinality -> fromSome (encodeUint8 0)
    FinalityCodec.WaitForSafe -> fromSome (encodeUint8 1)
    FinalityCodec.BlockDepth depth ->
      fromSome (encodeUint8 2) <> fromSome (encodeInt64 depth)

decodeRequestedFinalityAt : BytesHex -> Int -> Optional (FinalityCodec.RequestedFinality, Int)
decodeRequestedFinalityAt encoded offset = do
  tagHex <- extractBytes encoded offset 1
  tag <- decodeUint8 tagHex
  case tag of
    0 -> Some (FinalityCodec.WaitForFinality, offset + 1)
    1 -> Some (FinalityCodec.WaitForSafe, offset + 1)
    2 -> do
      (depth, newOffset) <- decodeInt64At encoded (offset + 1)
      Some (FinalityCodec.BlockDepth depth, newOffset)
    _ -> None

-- ===========================================================================
-- OPTIONAL RAW INSTANCE ADDRESS ENCODING/DECODING
-- Format: [00] for None, [01][RawInstanceAddress] for Some
-- ===========================================================================

encodeOptionalRawInstanceAddress : Optional RawInstanceAddress -> BytesHex
encodeOptionalRawInstanceAddress None = "00"
encodeOptionalRawInstanceAddress (Some ria) = "01" <> encodeRawInstanceAddress ria

decodeOptionalRawInstanceAddressAt : BytesHex -> Int -> Optional (Optional RawInstanceAddress, Int)
decodeOptionalRawInstanceAddressAt encoded offset = do
  tagHex <- extractBytes encoded offset 1
  if tagHex == "00" then Some (None, offset + 1)
  else if tagHex == "01" then do
    (ria, newOffset) <- decodeRawInstanceAddressAt encoded (offset + 1)
    Some (Some ria, newOffset)
  else None
