module CCIP.Client(
    Canton2AnyMessage(..),
    Any2CantonMessage(..),
    TokenAmount(..)
) where

import DA.Crypto.Text (BytesHex)

import Splice.Api.Token.HoldingV1

data Canton2AnyMessage = Canton2AnyMessage
    with
        receiver : BytesHex
        payload : BytesHex
        feeToken : Splice.Api.Token.HoldingV1.InstrumentId
        extraArgs : BytesHex
        tokenAmounts : [TokenAmount]
    deriving (Eq, Show)

data Any2CantonMessage = Any2CantonMessage
    with
        messageId : BytesHex
        sourceChainSelector : Numeric 0
        sender : BytesHex
        payload : BytesHex
        tokenAmounts : [TokenAmount]
    deriving (Eq, Show)

data TokenAmount = TokenAmount
    with
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        amount : Numeric 0
    deriving (Eq, Show)