-- | Types for GlobalConfig, extracted to avoid circular dependencies
module CCIP.GlobalConfigTypes where

import DA.Crypto.Text (BytesHex)

import MCMS.RawInstanceAddress (RawInstanceAddress(..))

data DestChainConfigArgs = DestChainConfigArgs
    with
        destChainSelector : Numeric 0           -- Destination chain selector of the config to update.
        isEnabled : Bool                        -- Flag whether this destination chain is enabled or not.
        addressBytesLength : Int                -- The length of an address on this chain in bytes, e.g. 20 for EVM, 32 for SVM.
        tokenReceiverAllowed : Bool             -- Whether specifying `tokenReceiver` in extraArgs is allowed. Must be set to false for all EVM chains.
        baseExecutionGasCost : Int              -- Base destination-chain gas cost added to ccipReceiveGasLimit for execution pricing.
        offRampAddress : BytesHex               -- OffRamp address on the destination chain.
        defaultExecutor : Optional RawInstanceAddress -- Default executor to use for messages to this destination chain. `None` means no executor.
        laneMandatedCCVs : [RawInstanceAddress] -- Required CCVs to use for all messages to this destination chain.
        defaultCCVs : [RawInstanceAddress]      -- Default CCVs to use for messages to this destination chain.
        messageNetworkFeeUSDCents : Numeric 0   -- Network fee in USD cents for messages without token transfers.
        tokenNetworkFeeUSDCents : Numeric 0     -- Network fee in USD cents for messages with token transfers.
    deriving (Eq, Show)

-- | Configuration for a destination chain.
data DestChainConfig = DestChainConfig
    with
        isEnabled : Bool                        -- Flag whether this destination chain is enabled or not.
        addressBytesLength : Int                -- The length of an address on this chain in bytes, e.g. 20 for EVM, 32 for SVM.
        tokenReceiverAllowed : Bool             -- Whether specifying `tokenReceiver` in extraArgs is allowed. Must be set to false for all EVM chains.
        baseExecutionGasCost : Int              -- Base destination-chain gas cost added to ccipReceiveGasLimit for execution pricing.
        offRampAddress : BytesHex               -- OffRamp address on the destination chain.
        defaultExecutor : Optional RawInstanceAddress -- Default executor to use for messages to this destination chain. `None` means no executor.
        laneMandatedCCVs : [RawInstanceAddress] -- Required CCVs to use for all messages to this destination chain.
        defaultCCVs : [RawInstanceAddress]      -- Default CCVs to use for messages to this destination chain.
        messageNetworkFeeUSDCents : Numeric 0   -- Network fee in USD cents for messages without token transfers.
        tokenNetworkFeeUSDCents : Numeric 0     -- Network fee in USD cents for messages with token transfers.
    deriving (Eq, Show)

-- | Same as SourceChainConfig but with source chain selector so that a list of these
-- | can be passed in as a parameter when updating the source chain config using the ApplySourceChainConfigUpdate choice.
data SourceChainConfigArgs = SourceChainConfigArgs
    with
        sourceChainSelector : Numeric 0         -- Source chain selector of the config to update.
        isEnabled : Bool                        -- Flag whether the source chain is enabled or not.
        onRampAddresses : [BytesHex]            -- OnRamp addresses on the source chain.
        defaultCCVs : [RawInstanceAddress]      -- Default CCVs to use for messages from this source chain.
        laneMandatedCCVs : [RawInstanceAddress] -- Required CCVs to use for all messages from this source chain.
    deriving (Eq, Show)

-- | Configuration for a source chain.
data SourceChainConfig = SourceChainConfig
    with
        isEnabled : Bool                        -- Flag whether the source chain is enabled or not.
        onRampAddresses : [BytesHex]            -- OnRamp addresses on the source chain.
        defaultCCVs : [RawInstanceAddress]      -- Default CCVs to use for messages from this source chain.
        laneMandatedCCVs : [RawInstanceAddress] -- Required CCVs to use for all messages from this source chain.
    deriving (Eq, Show)

-- ===========================================================================
-- MCMS Choice Params Types
-- ===========================================================================

-- | Params for ApplyDestChainConfigUpdates choice
data ApplyDestChainConfigUpdatesParams = ApplyDestChainConfigUpdatesParams
    with
        destChainConfigArgs : [DestChainConfigArgs]
    deriving (Eq, Show)

-- | Params for ApplySourceChainConfigUpdates choice
data ApplySourceChainConfigUpdatesParams = ApplySourceChainConfigUpdatesParams
    with
        sourceChainConfigArgs : [SourceChainConfigArgs]
    deriving (Eq, Show)
