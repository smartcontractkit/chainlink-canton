-- | Types for GlobalConfig, extracted to avoid circular dependencies
module CCIP.GlobalConfigTypes where

import DA.Crypto.Text (BytesHex)
import DA.List qualified as List

import MCMS.RawInstanceAddress (RawInstanceAddress(..))

data DestChainConfigArgs = DestChainConfigArgs
    with
        destChainSelector : Numeric 0           -- Destination chain selector of the config to update.
        isEnabled : Bool                        -- Flag whether this destination chain is enabled or not.
        addressBytesLength : Int                -- The length of an address on this chain in bytes, e.g. 20 for EVM, 32 for SVM.
        baseExecutionGasCost : Int              -- Base destination-chain gas cost added to ccipReceiveGasLimit for execution pricing.
        offRampAddress : BytesHex               -- OffRamp address on the destination chain.
        laneMandatedCCVs : [RawInstanceAddress] -- Required CCVs to use for all messages to this destination chain.
        defaultCCVs : [RawInstanceAddress]      -- Default CCVs to use for messages to this destination chain.
        messageNetworkFeeUSDCents : Numeric 0   -- Network fee in USD cents for messages without token transfers.
        tokenNetworkFeeUSDCents : Numeric 0     -- Network fee in USD cents for messages with token transfers.
    deriving (Eq, Show)

-- | Configuration for a destination chain.
data DestChainConfig = DestChainConfig
    with
        isEnabled : Bool                        -- Flag whether this destination chain is enabled or not.
        addressBytesLength : Int                -- The length of an address on this chain in bytes, e.g. 20 for EVM, 32 for SVM.
        baseExecutionGasCost : Int              -- Base destination-chain gas cost added to ccipReceiveGasLimit for execution pricing.
        offRampAddress : BytesHex               -- OffRamp address on the destination chain.
        -- TODO: Add default executor
        laneMandatedCCVs : [RawInstanceAddress] -- Required CCVs to use for all messages to this destination chain.
        defaultCCVs : [RawInstanceAddress]      -- Default CCVs to use for messages to this destination chain.
        messageNetworkFeeUSDCents : Numeric 0   -- Network fee in USD cents for messages without token transfers.
        tokenNetworkFeeUSDCents : Numeric 0     -- Network fee in USD cents for messages with token transfers.
    deriving (Eq, Show)

-- | Same as SourceChainConfig but with source chain selector so that a list of these
-- | can be passed in as a parameter when updating the source chain config using the ApplySourceChainConfigUpdate choice.
data SourceChainConfigArgs = SourceChainConfigArgs
    with
        sourceChainSelector : Numeric 0         -- Source chain selector of the config to update.
        isEnabled : Bool                        -- Flag whether the source chain is enabled or not.
        onRampAddresses : [BytesHex]            -- OnRamp addresses on the source chain.
        defaultCCVs : [RawInstanceAddress]      -- Default CCVs to use for messages from this source chain.
        laneMandatedCCVs : [RawInstanceAddress] -- Required CCVs to use for all messages from this source chain.
    deriving (Eq, Show)

-- | Configuration for a source chain.
data SourceChainConfig = SourceChainConfig
    with
        isEnabled : Bool                        -- Flag whether the source chain is enabled or not.
        onRampAddresses : [BytesHex]            -- OnRamp addresses on the source chain.
        defaultCCVs : [RawInstanceAddress]      -- Default CCVs to use for messages from this source chain.
        laneMandatedCCVs : [RawInstanceAddress] -- Required CCVs to use for all messages from this source chain.
    deriving (Eq, Show)

-- | Ensures at least one CCV combined, no zero addresses, no duplicates within or across both sets.
-- | The default CCVs and lane mandated CCVs are validated together: at least one must be present,
-- | no empty addresses are allowed, and no duplicates are permitted within or across both lists.
validateDefaultAndMandatedCCVs : [RawInstanceAddress] -> [RawInstanceAddress] -> Update ()
validateDefaultAndMandatedCCVs defaultCCV laneMandatedCCVs = do
  let defaultLength = length defaultCCV
  let mandatedLength = length laneMandatedCCVs
  let totalLength = defaultLength + mandatedLength

  -- There must always be at least one default or mandated CCV. This ensures that any receiver who does not
  -- specify CCVs will always have at least one CCV to validate the message.
  assertMsg "MustSpecifyDefaultOrRequiredCCVs: at least one CCV must be specified" (totalLength > 0)

  -- Check for duplicates and empty addresses in the default and mandated CCVs. We need to check for duplicates
  -- between the two sets of CCVs as well as within each set. Doing these checks here means we can assume there are
  -- no duplicates or empty addresses in the rest of the code.
  let combined = defaultCCV <> laneMandatedCCVs
  assertNoDuplicates combined
  validateNoEmptyAddresses combined

-- | Asserts that there are no duplicate addresses within a list of RawInstanceAddresses.
assertNoDuplicates : [RawInstanceAddress] -> Update ()
assertNoDuplicates addresses = do
  let duplicateCandidates =
        List.filter
          (\address -> length (List.filter (== address) addresses) > 1)
          addresses
  case duplicateCandidates of
    duplicateAddress :: _ ->
      assertMsg ("DuplicateCCVNotAllowed: " <> show duplicateAddress) False
    [] -> pure ()

-- | Helper function to validate that no CCV addresses are empty strings.
validateNoEmptyAddresses : [RawInstanceAddress] -> Update ()
validateNoEmptyAddresses addresses = do
  let emptyAddresses = List.filter (\address -> address == RawInstanceAddress "") addresses
  case emptyAddresses of
    emptyAddress :: _ ->
      assertMsg ("ZeroAddressNotAllowed") False
    [] -> pure ()
