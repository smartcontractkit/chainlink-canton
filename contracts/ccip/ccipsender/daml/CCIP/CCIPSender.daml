-- | Sender-side orchestrator for CCIP message sending.
-- Executes the full outbound flow in a single atomic Daml transaction.
-- Only `owner` is a signatory; ccipOwner is not a party on this contract.
module CCIP.CCIPSender where

import DA.Action (foldlA)
import DA.Crypto.Text (BytesHex)
import DA.Optional (fromOptional)

import qualified CCIP.Context
import qualified CCIP.FeeQuoter
import CCIP.Interfaces.CrossChainVerifier qualified as ICCV
import qualified CCIP.Interfaces.Executor
import qualified CCIP.Interfaces.TokenPool
import qualified CCIP.PerPartyRouter
import CCIP.RawInstanceAddress (RawInstanceAddress)
import qualified CCIP.SendingMessageV1

import qualified Splice.Api.Token.HoldingV1
import qualified Splice.Api.Token.MetadataV1

-- | Per-CCV send input. Pairs a verifier contract (via interface)
-- with optional per-CCV forwarding arguments.
data CCVSendInput = CCVSendInput
    with
        ccvCid : ContractId ICCV.ICrossChainVerifier
        verifierArgs : BytesHex
    deriving (Eq, Show)

-- | Token transfer input for outbound sends.
data TokenTransferInput = TokenTransferInput
    with
        tokenPoolCid : ContractId CCIP.Interfaces.TokenPool.ITokenPool
        tokenInput : CCIP.Interfaces.TokenPool.TokenInput
        senderInputCids : [ContractId Splice.Api.Token.HoldingV1.Holding]
        amount : Numeric 0
        tokenInstrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        tokenReceiver : Optional BytesHex
        tokenArgs : BytesHex
    deriving (Eq, Show)

template CCIPSender
    with
        instanceId : Text
        owner : Party
    where
        signatory owner

        -- | Sends an outbound CCIP message end-to-end.
        nonconsuming choice Send : CCIP.PerPartyRouter.CCIPSendResult
            with
                -- CCIP Choice Context
                context : Splice.Api.Token.MetadataV1.ChoiceContext

                -- CCIP contract IDs
                routerCid : ContractId CCIP.PerPartyRouter.PerPartyRouter
                executorCid : ContractId CCIP.Interfaces.Executor.IExecutor

                destChainSelector : Numeric 0
                receiver : BytesHex
                payload : BytesHex
                ccipReceiveGasLimit : Int
                blockConfirmations : Optional Int
                executorArgs : Optional BytesHex
                senderRequiredCCVs : [RawInstanceAddress]

                feeToken : Splice.Api.Token.HoldingV1.InstrumentId
                feeTokenInput : CCIP.Interfaces.TokenPool.TokenInput
                feeTokenHoldingCids : [ContractId Splice.Api.Token.HoldingV1.Holding]

                tokenTransfer : Optional TokenTransferInput
                ccvSendInputs : [CCVSendInput]
            controller owner
            do
                feeQuoterCid <- CCIP.Context.getFromContextU @(ContractId CCIP.FeeQuoter.FeeQuoter) context CCIP.Context.feeQuoterKey

                let tokenInstrumentId = case tokenTransfer of
                        Some tt -> Some tt.tokenInstrumentId
                        None -> None

                let tokenReceiver = case tokenTransfer of
                        Some tt -> tt.tokenReceiver
                        None -> None

                -- PrepareSend
                smCid <- exercise routerCid CCIP.PerPartyRouter.PrepareSend with
                    context
                    destChainSelector
                    receiver
                    payload
                    ccipReceiveGasLimit
                    blockConfirmations
                    senderRequiredCCVs
                    tokenInstrumentId
                    tokenReceiver
                    feeToken

                -- CalculateFee (CCV + pool, USD cents only)
                smCid <- foldlA (\cid input ->
                    exercise input.ccvCid
                        ICCV.CrossChainVerifier_CalculateFee with
                            sendingMessageCid = cid
                            caller = owner
                    ) smCid ccvSendInputs

                smCid <- case tokenTransfer of
                    None -> pure smCid
                    Some tt -> exercise tt.tokenPoolCid
                        CCIP.Interfaces.TokenPool.TokenPool_CalculateFee with
                            sendingMessageCid = smCid
                            caller = owner

                -- Outbound pool CCV verification via TAR
                smCid <- case tokenTransfer of
                    None -> pure smCid
                    Some tt -> exercise tt.tokenPoolCid
                        CCIP.Interfaces.TokenPool.TokenPool_VerifyOutboundCCVs with
                            context = context
                            sendingMessageCid = smCid
                            amount = tt.amount
                            tokenArgs = tt.tokenArgs
                            caller = owner

                -- LockOrBurn (stores token data before executor finalization)
                smCid <- case tokenTransfer of
                    None -> pure smCid
                    Some tt -> do
                        lockResult <- exercise tt.tokenPoolCid
                            CCIP.Interfaces.TokenPool.TokenPool_LockOrBurn with
                                context = context
                                sendingMessageCid = smCid
                                tokenInput = tt.tokenInput
                                senderInputCids = tt.senderInputCids
                                amount = tt.amount
                                caller = owner
                        pure lockResult.sendingMessageCid

                -- Executor computes fee and finalizes message via AddExecutorWithFee.
                let resolvedExecutorArgs = fromOptional "" executorArgs
                smCid <- exercise executorCid
                    CCIP.Interfaces.Executor.Executor_CalculateFee with
                        sendingMessageCid = smCid
                        executorArgs = resolvedExecutorArgs
                        caller = owner

                -- FinalizeFee (FeeQuoter looks up price internally)
                smCid <- exercise feeQuoterCid
                    CCIP.FeeQuoter.FeeQuoter_FinalizeFee with
                        sendingMessageCid = smCid
                        caller = owner

                -- ForwardToVerifier (verifiers see committed token state)
                smCid <- foldlA (\cid input ->
                    exercise input.ccvCid
                        ICCV.CrossChainVerifier_ForwardToVerifier with
                            context = context
                            sendingMessageCid = cid
                            verifierArgs = input.verifierArgs
                            caller = owner
                    ) smCid ccvSendInputs

                -- CCIPSend (collects total fee from sender)
                exercise routerCid CCIP.PerPartyRouter.CCIPSend with
                    context
                    sendingMessageCid = smCid
                    feeTokenInput
                    feeTokenHoldingCids
