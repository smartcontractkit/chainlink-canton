-- | Sender-side orchestrator for CCIP message sending.
-- Executes the full outbound flow in a single atomic Daml transaction.
-- Only `owner` is a signatory; ccipOwner is not a party on this contract.
module CCIP.CCIPSender where

import DA.Action (foldlA)
import DA.Crypto.Text (BytesHex)
import DA.List (zip)
import DA.Optional (fromSome, fromSomeNote, isSome)

import qualified CCIP.Client
import qualified CCIP.Context
import qualified CCIP.ExtraArgsCodec
import qualified CCIP.FeeQuoter
import CCIP.Interfaces.CrossChainVerifier qualified as ICCV
import qualified CCIP.Interfaces.Executor
import qualified CCIP.Interfaces.TokenPool
import qualified CCIP.PerPartyRouter
import qualified CCIP.SendingMessageV1
import qualified CCIP.TokenAdminRegistry

import MCMS.RawInstanceAddress (assertValidInstanceId)

import qualified Splice.Api.Token.HoldingV1

-- | Per-CCV send input. Pairs a verifier contract (via interface)
-- with per-CCV forwarding args and extra context.
data CCVSendInput = CCVSendInput
    with
        ccvCid : ContractId ICCV.ICrossChainVerifier
        ccvExtraContext : CCIP.Context.CCIPContext
    deriving (Eq, Show)

-- | Token transfer input for outbound sends.
data TokenTransferInput = TokenTransferInput
    with
        tokenPoolCid : ContractId CCIP.Interfaces.TokenPool.ITokenPool
        tokenInput : CCIP.Interfaces.TokenPool.TokenInput
        poolExtraContext : CCIP.Context.CCIPContext
    deriving (Eq, Show)

template CCIPSender
    with
        instanceId : Text
        owner : Party
    where
        signatory owner
        ensure assertValidInstanceId instanceId

        -- | Sends an outbound CCIP message end-to-end.
        nonconsuming choice Send : CCIP.PerPartyRouter.CCIPSendResult
            with
                destinationChainSelector : Numeric 0
                message : CCIP.Client.Canton2AnyMessage

                -- CCIP context for internal orchestration (PerPartyRouter calls).
                context : CCIP.Context.CCIPContext

                -- CCIP contract IDs
                routerCid : ContractId CCIP.PerPartyRouter.PerPartyRouter

                -- fees
                feeTokenInput : CCIP.Interfaces.TokenPool.TokenInput
                feeTokenHoldingCids : [ContractId Splice.Api.Token.HoldingV1.Holding]

                -- token transfer
                tokenTransfer : Optional TokenTransferInput

                -- CCVs
                ccvSendInputs : [CCVSendInput]

                -- Executor
                executorCid : Optional (ContractId CCIP.Interfaces.Executor.IExecutor)
            controller owner
            do
                -- Extract CIDs from context using typed accessors for pool/CCV calls.
                feeQuoterCid <- CCIP.FeeQuoter.lookupFeeQuoterCid context
                rmnRemoteCid <- CCIP.Context.lookupRmnRemoteCid context
                tokenAdminRegistryCid <- CCIP.TokenAdminRegistry.lookupTokenAdminRegistryCid context

                -- Validate message fields
                case message.tokenAmount of
                    None -> pure ()
                    Some tt -> do
                        assertMsg "tokenTransfer must be provided if tokenAmount is specified" (isSome tokenTransfer)

                -- Decode and validate extraArgs
                -- TODO: parse with defaults
                let resolvedExtraArgs = fromSomeNote "onramp: invalid extraArgs format" (CCIP.ExtraArgsCodec.decodeGenericExtraArgsV3 message.extraArgs)
                -- TODO: Validate that ccvs are passed in in the correct order
                -- TODO: Validate that the executor that's been passed in matches the executor specified in extraArgs (if any)

                let tokenInstrumentId = case message.tokenAmount of
                        Some tt -> Some tt.token
                        None -> None

                -- PrepareSend
                smCid <- exercise routerCid CCIP.PerPartyRouter.PrepareSend with
                    destinationChainSelector = destinationChainSelector
                    message = message
                    context

                -- Outbound pool CCV verification via TAR happens first for token sends.
                smCid <- case tokenTransfer of
                    None -> pure smCid
                    Some tt -> exercise tt.tokenPoolCid
                        CCIP.Interfaces.TokenPool.TokenPool_VerifyOutboundCCVs with
                            tokenAdminRegistryCid = tokenAdminRegistryCid
                            extraContext = tt.poolExtraContext
                            sendingMessageCid = smCid
                            amount = (fromSome message.tokenAmount).amount
                            caller = owner

                -- CalculateFee (CCV + pool, USD cents only)
                smCid <- foldlA (\cid input ->
                    exercise input.ccvCid
                        ICCV.CrossChainVerifier_CalculateFee with
                            sendingMessageCid = cid
                            caller = owner
                    ) smCid ccvSendInputs

                smCid <- case tokenTransfer of
                    None -> pure smCid
                    Some tt -> exercise tt.tokenPoolCid
                        CCIP.Interfaces.TokenPool.TokenPool_CalculateFee with
                            tokenAdminRegistryCid = tokenAdminRegistryCid
                            sendingMessageCid = smCid
                            feeQuoterCid = feeQuoterCid
                            tokenInstrumentId = (fromSome message.tokenAmount).token
                            caller = owner

                -- Executor contributes its flat fee, or the message is marked as
                -- explicitly no-exec.
                smCid <- case resolvedExtraArgs.executor of
                    "eba517d2" -> exercise smCid -- no-exec tag
                        CCIP.SendingMessageV1.SetNoExecutor with
                            executorArgs = resolvedExtraArgs.executorArgs
                            caller = owner
                    executorInstanceAddress -> do -- executor specified
                        exercise (fromSomeNote "executorCid required when executor is specified in extraArgs" executorCid) CCIP.Interfaces.Executor.Executor_CalculateFee with
                            sendingMessageCid = smCid
                            executorArgs = resolvedExtraArgs.executorArgs
                            caller = owner

                smCid <- exercise routerCid CCIP.PerPartyRouter.FinalizeFee with
                    context
                    sendingMessageCid = smCid

                -- LockOrBurn records token send data after fees are finalized.
                smCid <- case tokenTransfer of
                    None -> pure smCid
                    Some tt -> do
                        lockResult <- exercise tt.tokenPoolCid
                            CCIP.Interfaces.TokenPool.TokenPool_LockOrBurn with
                                tokenAdminRegistryCid = tokenAdminRegistryCid
                                rmnRemoteCid = rmnRemoteCid
                                extraContext = tt.poolExtraContext
                                sendingMessageCid = smCid
                                tokenInput = tt.tokenInput
                                senderInputCids = (fromSome message.tokenAmount).senderInputCids
                                amount = (fromSome message.tokenAmount).amount
                                caller = owner
                        pure lockResult.sendingMessageCid

                -- ForwardToVerifier (verifiers see committed token state)
                smCid <- foldlA (\cid (input, args) ->
                    exercise input.ccvCid
                        ICCV.CrossChainVerifier_ForwardToVerifier with
                            rmnRemoteCid = rmnRemoteCid
                            extraContext = input.ccvExtraContext
                            sendingMessageCid = cid
                            verifierArgs = args
                            caller = owner
                    ) smCid (zip ccvSendInputs resolvedExtraArgs.ccvArgs)

                -- CCIPSend (collects total fee from sender)
                exercise routerCid CCIP.PerPartyRouter.CCIPSend with
                    context
                    sendingMessageCid = smCid
                    feeTokenInput
                    feeTokenHoldingCids
