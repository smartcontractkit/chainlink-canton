-- | OnRamp for CCIP message sending, called by PerPartyRouter.
module CCIP.OnRamp where

import DA.Crypto.Text (BytesHex, keccak256)
import DA.Foldable qualified as Foldable
import DA.List (dedup)
import DA.Optional (isSome, catOptionals)

import qualified CCIP.GlobalConfig
import qualified CCIP.MessageCodecV1
import qualified CCIP.RawInstanceAddress
import qualified CCIP.RMNRemote
import qualified CCIP.Tickets
import qualified CCIP.TokenAdminRegistry

import qualified Splice.Api.Token.HoldingV1


template OnRamp
    with
        instanceId : Text
        ccipOwner : Party
        globalConfigInstanceAddress : CCIP.RawInstanceAddress.RawInstanceAddress
        rmnRemoteInstanceAddress : CCIP.RawInstanceAddress.RawInstanceAddress
        tokenAdminRegistryInstanceAddress : CCIP.RawInstanceAddress.RawInstanceAddress
    where
        signatory ccipOwner

        -- | Get required CCV raw instance addresses for outbound message.
        -- Controller is ccipOwner - users access via PerPartyRouter wrapper.
        -- Does NOT include sender's router CCVs - we don't know what the receiver requires.
        -- Note: pool CCVs are now managed by pools themselves via TokenPool_GetRequiredCCVs.
        nonconsuming choice GetRequiredCCVsForSend : [CCIP.RawInstanceAddress.RawInstanceAddress]
            with
                globalConfigCid : ContractId CCIP.GlobalConfig.GlobalConfig
                tokenAdminRegistryCid : ContractId CCIP.TokenAdminRegistry.TokenAdminRegistry
                destChainSelector : Numeric 0
                hasTokenTransfer : Bool
                instrumentId : Optional Splice.Api.Token.HoldingV1.InstrumentId
            controller ccipOwner
            do
                -- Get lane-mandated CCVs from GlobalConfig
                destConfigOpt <- exercise globalConfigCid
                    CCIP.GlobalConfig.GetDestChainConfig with
                        destChainSelector = destChainSelector
                        caller = ccipOwner
                let laneMandatedCCVs = case destConfigOpt of
                        None -> []
                        Some config -> config.laneMandatedCCVs

                -- Get default CCVs (if no lane-mandated CCVs specified)
                let defaultCCVs = case destConfigOpt of
                        None -> []
                        Some config ->
                            if null laneMandatedCCVs
                            then config.defaultCCVs
                            else []

                -- Combine and dedupe
                pure (dedup (laneMandatedCCVs ++ defaultCCVs))

        -- | Process a CCIP send request from a PerPartyRouter.
        -- Note: tokenSendTicket was already validated at issuance via TokenAdminRegistry_IssueSendTicket
        nonconsuming choice CCIPSendFromRouter : CCIPSendFromRouterResult
            with
                routerPartyOwner : Party

                rmnRemoteCid : ContractId CCIP.RMNRemote.RMNRemote
                globalConfigCid : ContractId CCIP.GlobalConfig.GlobalConfig
                tokenAdminRegistryCid : ContractId CCIP.TokenAdminRegistry.TokenAdminRegistry

                destChainSelector : Numeric 0
                receiver : BytesHex
                payload : BytesHex
                executionGasLimit : Int
                ccipReceiveGasLimit : Int

                currentSequenceNumber : Numeric 0

                tokenSendTicket : Optional (ContractId CCIP.Tickets.TokenSendTicket)
                ccvTickets : [ContractId CCIP.Tickets.CCVTicket]

            controller ccipOwner
            do

                -- Validate dependency instance addresses
                globalConfig <- fetch globalConfigCid
                CCIP.RawInstanceAddress.assertEqual "onramp: globalconfig instance address mismatch"
                    globalConfig.instanceId globalConfig.ccipOwner globalConfigInstanceAddress

                rmnRemote <- fetch rmnRemoteCid
                CCIP.RawInstanceAddress.assertEqual "onramp: rmn instance address mismatch"
                    rmnRemote.instanceId rmnRemote.rmnOwner rmnRemoteInstanceAddress

                tokenAdminRegistry <- fetch tokenAdminRegistryCid
                CCIP.RawInstanceAddress.assertEqual "onramp: tokenadminregistry instance address mismatch"
                    tokenAdminRegistry.instanceId tokenAdminRegistry.owner tokenAdminRegistryInstanceAddress

                -- Check RMN curse for destination chain
                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = ccipOwner
                    chainSelector = destChainSelector
                assertMsg "onramp: destination chain is cursed" (not isCursed)

                destConfigOpt <- exercise globalConfigCid
                    CCIP.GlobalConfig.GetDestChainConfig with
                        destChainSelector = destChainSelector
                        caller = ccipOwner
                destConfig <- case destConfigOpt of
                    None -> abort "onramp: unknown destination chain"
                    Some c -> do
                        assertMsg "onramp: destination chain disabled" c.isEnabled
                        pure c

                -- Process optional token transfer ticket: read fields, build TokenTransferV1, archive
                (tokenTransfer, instrumentId, poolReceipt) <- case tokenSendTicket of
                    None -> pure (None, None, None)
                    Some ticketCid -> do
                        ticket <- fetch ticketCid
                        assertMsg "onramp: tokensendticket ccipowner mismatch"
                            (ticket.ccipOwner == ccipOwner)
                        assertMsg "onramp: tokensendticket sender mismatch"
                            (ticket.sender == routerPartyOwner)
                        -- Compute pool address from (instanceId, owner)
                        let poolAddr = CCIP.MessageCodecV1.encodeInstanceAddress ticket.poolInstanceId ticket.poolOwner
                        -- Build TokenTransferV1 directly
                        let tt = CCIP.MessageCodecV1.TokenTransferV1 with
                                amount = ticket.amount
                                sourcePoolAddress = poolAddr
                                sourceTokenAddress = ticket.sourceTokenAddress
                                destTokenAddress = ticket.destTokenAddress
                                tokenReceiver = ticket.tokenReceiver
                                extraData = ticket.extraData
                        -- Archive the ticket
                        exercise ticketCid CCIP.Tickets.TokenSendTicket_Archive
                        pure (Some tt, Some ticket.instrumentId, Some ticket.receipt)

                -- Get required CCV addresses for this send
                let hasTokenTransfer = isSome tokenTransfer
                requiredCCVsRaw <- exercise self GetRequiredCCVsForSend with
                    globalConfigCid = globalConfigCid
                    tokenAdminRegistryCid = tokenAdminRegistryCid
                    destChainSelector = destChainSelector
                    hasTokenTransfer = hasTokenTransfer
                    instrumentId = instrumentId

                -- Process CCV tickets: read fields, compute instance addresses, archive
                ccvData <- forA ccvTickets $ \ticketCid -> do
                    ticket <- fetch ticketCid
                    assertMsg "onramp: ccvticket ccipowner mismatch"
                        (ticket.ccipOwner == ccipOwner)
                    assertMsg "onramp: ccvticket sender mismatch"
                        (ticket.sender == routerPartyOwner)
                    -- Compute instance address from (instanceId, owner)
                    let ccvAddr = CCIP.MessageCodecV1.encodeInstanceAddress ticket.ccvInstanceId ticket.ccvOwner
                    -- Archive the ticket
                    exercise ticketCid CCIP.Tickets.CCVTicket_Archive with caller = ccipOwner
                    pure (ccvAddr, ticket.verifierBlob, ticket.messageSentObservers, ticket.receipt)

                let providedCCVAddresses = map (\(addr, _, _, _) -> addr) ccvData
                let verifierBlobs = map (\(_, blob, _, _) -> blob) ccvData
                let allMessageSentObservers = concatMap (\(_, _, obs, _) -> obs) ccvData
                let ccvReceipts = map (\(_, _, _, receipt) -> receipt) ccvData

                -- Validate all required CCVs are covered (convert raw to hashed for comparison)
                let requiredCCVAddresses = map CCIP.RawInstanceAddress.toInstanceAddress requiredCCVsRaw
                Foldable.forA_ requiredCCVAddresses $ \requiredAddr ->
                    assertMsg ("onramp: missing required CCV address " <> requiredAddr)
                        (requiredAddr `elem` providedCCVAddresses)

                -- Collect all receipts (CCV receipts + pool receipt)
                let allReceipts = ccvReceipts ++ catOptionals [poolReceipt]

                -- Compute ccvAndExecutorHash from 32-byte instance addresses
                let executorAddr = CCIP.RawInstanceAddress.toInstanceAddress destConfig.defaultExecutor
                let ccvAndExecutorHash = CCIP.MessageCodecV1.computeCCVAndExecutorHash
                        providedCCVAddresses
                        executorAddr

                let newSequenceNumber = currentSequenceNumber + 1.0

                -- Compute addresses for message
                let onRampAddr = CCIP.MessageCodecV1.encodeInstanceAddress instanceId ccipOwner
                let senderAddr = CCIP.MessageCodecV1.encodePartyAddress routerPartyOwner

                -- Build message with 32-byte addresses
                let messageV1 = CCIP.MessageCodecV1.MessageV1 with
                        sourceChainSelector = globalConfig.chainSelector
                        destChainSelector = destChainSelector
                        sequenceNumber = newSequenceNumber
                        executionGasLimit = executionGasLimit
                        ccipReceiveGasLimit = ccipReceiveGasLimit
                        finality = 2000
                        ccvAndExecutorHash = ccvAndExecutorHash
                        onRampAddress = onRampAddr
                        offRampAddress = destConfig.offRampAddress
                        sender = senderAddr
                        receiver = receiver
                        destBlob = ""
                        tokenTransfer = tokenTransfer
                        messageData = payload

                let encodedMessage = CCIP.MessageCodecV1.encodeMessageV1 messageV1
                let messageId = keccak256 encodedMessage

                pure CCIPSendFromRouterResult with
                    messageId = messageId
                    encodedMessage = encodedMessage
                    newSequenceNumber = newSequenceNumber
                    destChainSelector = destChainSelector
                    verifierBlobs = verifierBlobs
                    messageSentObservers = allMessageSentObservers
                    receipts = allReceipts


data CCIPSendFromRouterResult = CCIPSendFromRouterResult
    with
        messageId : BytesHex
        encodedMessage : BytesHex
        newSequenceNumber : Numeric 0
        destChainSelector : Numeric 0
        verifierBlobs : [BytesHex]
        messageSentObservers : [Party]
        receipts : [CCIP.Tickets.Receipt]
    deriving (Eq, Show)
