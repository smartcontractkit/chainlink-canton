-- | OnRamp for CCIP message sending, called by PerPartyRouter.
module CCIP.OnRamp where

import DA.Crypto.Text (BytesHex, byteCount)
import DA.Foldable qualified as Foldable
import DA.List (dedup, unique)
import DA.Map qualified as Map
import DA.Optional (fromOptional, fromSomeNote, isNone, isSome)

import qualified CCIP.Client
import qualified CCIP.Events
import qualified CCIP.FeeQuoter
import qualified CCIP.GlobalConfig
import CCIP.Interfaces.CrossChainVerifier qualified as ICCV
import qualified CCIP.Interfaces.Executor
import qualified CCIP.Interfaces.TokenPool
import qualified CCIP.Math
import qualified CCIP.MessageCodecV1
import qualified CCIP.Context
import qualified CCIP.Internal
import qualified Splice.Api.Token.HoldingV1
import MCMS.RawInstanceAddress qualified as RawInstanceAddress
import MCMS.RawInstanceAddress (assertValidInstanceId)
import qualified CCIP.RMNRemote
import qualified CCIP.SendingMessageV1
import qualified CCIP.Tickets
import qualified CCIP.TokenAdminRegistry
import CCIP.Codec
  ( encodeRawInstanceAddress
  , decodeRawInstanceAddressAt
  , encodeOptionalRawInstanceAddress
  , decodeOptionalRawInstanceAddressAt
  )
import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiverView(..))
import MCMS.Crypto (assertValidHex, isValidHex)

messageStaticSize : Int
messageStaticSize = 67

tokenTransferBaseSizeWithoutExtraData : Int -> Int
tokenTransferBaseSizeWithoutExtraData remoteAddressBytes =
    1 + 32 + (1 + 32) + (1 + 32) + (1 + remoteAddressBytes) + (1 + remoteAddressBytes) + 2

computeExecutorDestBytesOverhead : Int -> Int -> Int -> Int
computeExecutorDestBytesOverhead remoteAddressBytes payloadBytes executorArgsBytes =
    messageStaticSize
    + (1 + 32) -- onRampAddress
    + (1 + remoteAddressBytes) -- offRampAddress
    + (1 + 32) -- sender
    + (1 + remoteAddressBytes) -- receiver
    + (2 + executorArgsBytes) -- destBlob
    + 2 -- tokenTransfer length prefix, no token transfer payload for message-only sends
    + (2 + payloadBytes) -- messageData

computeExecutorDestBytesOverheadWithToken : Int -> Int -> Int -> Int
computeExecutorDestBytesOverheadWithToken remoteAddressBytes payloadBytes executorArgsBytes =
    messageStaticSize
    + (1 + 32) -- onRampAddress
    + (1 + remoteAddressBytes) -- offRampAddress
    + (1 + 32) -- sender
    + (1 + remoteAddressBytes) -- receiver
    + (2 + executorArgsBytes) -- destBlob
    + (2 + tokenTransferBaseSizeWithoutExtraData remoteAddressBytes) -- tokenTransfer without pool extraData
    + (2 + payloadBytes) -- messageData

noExecutionAddressBytes : BytesHex
noExecutionAddressBytes =
    "eba517d200000000000000000000000000000000000000000000000000000000"

onRampKey : Text
onRampKey = "on-ramp"

lookupOnRampCid : CCIP.Context.CCIPContext -> Update (ContractId OnRamp)
lookupOnRampCid ctx = CCIP.Context.getFromContextU ctx onRampKey

rawInstanceAddress : OnRamp -> RawInstanceAddress.RawInstanceAddress
rawInstanceAddress onRamp = RawInstanceAddress.make onRamp.instanceId onRamp.ccipOwner

data OnRampDeps = OnRampDeps
    with
        globalConfig : RawInstanceAddress.RawInstanceAddress
        rmnRemote : RawInstanceAddress.RawInstanceAddress
        tokenAdminRegistry : RawInstanceAddress.RawInstanceAddress
        feeQuoter : RawInstanceAddress.RawInstanceAddress
        ccvRegistry : RawInstanceAddress.RawInstanceAddress
    deriving (Eq, Show)

data SetDepsParams = SetDepsParams
    with
        globalConfig : Optional RawInstanceAddress.RawInstanceAddress
        rmnRemote : Optional RawInstanceAddress.RawInstanceAddress
        tokenAdminRegistry : Optional RawInstanceAddress.RawInstanceAddress
        feeQuoter : Optional RawInstanceAddress.RawInstanceAddress
        ccvRegistry : Optional RawInstanceAddress.RawInstanceAddress
    deriving (Eq, Show)

computeRequiredCCVsForSend
    : CCIP.GlobalConfig.DestChainConfig
    -> CCIP.Client.Canton2AnyMessage
    -> CCIP.Client.GenericExtraArgsV3
    -> [RawInstanceAddress.RawInstanceAddress]
    -> [RawInstanceAddress.RawInstanceAddress]
computeRequiredCCVsForSend destConfig message extraArgs tokenPoolRequiredCCVs =
    let hasTokenTransfer = isSome message.tokenTransfer
        isTokenOnlyTransfer = hasTokenTransfer
            && message.payload == ""
            && extraArgs.gasLimit == 0
        resolvedSenderRequiredCCVs = case tokenPoolRequiredCCVs of
            [] ->
                if isTokenOnlyTransfer
                then []
                else destConfig.defaultCCVs
            _ -> CCIP.Internal.resolveDefaultCCVs
                destConfig.defaultCCVs
                CCIP.Internal.useDefaultCCVs
                tokenPoolRequiredCCVs
    in dedup (resolvedSenderRequiredCCVs ++ destConfig.laneMandatedCCVs)

data GetFeeFromRouterResult = GetFeeFromRouterResult
    with
        -- Final amount payable in the selected fee token, including CCV fees,
        -- token-pool fee, CCIP network fee, executor flat fee, and execution gas cost.
        feeTokenAmount : Numeric 0
    deriving (Eq, Show)

data FeeCalculationResult = FeeCalculationResult
    with
        totalFeeTokenAmount : Numeric 0
        totalUSDCents : Numeric 0
        executionCostUSDCents : Numeric 0
        executorDestGasLimit : Int
        executorDestBytesOverhead : Int
        totalExecutionGasLimit : Int
        premiumMultiplier : Decimal
        feeTokenPrice : Decimal
    deriving (Eq, Show)

calculateFeeResult
    : Party
    -> Numeric 0
    -> ContractId CCIP.FeeQuoter.FeeQuoter
    -> Numeric 0
    -> CCIP.GlobalConfig.DestChainConfig
    -> CCIP.FeeQuoter.DestChainConfig
    -> Splice.Api.Token.HoldingV1.InstrumentId
    -> BytesHex
    -> Int
    -> [ICCV.CrossChainVerifierFeeQuote]
    -> Optional CCIP.Interfaces.TokenPool.TokenPoolFeeQuote
    -> BytesHex
    -> Optional CCIP.Interfaces.Executor.ExecutorFeeQuote
    -> Update FeeCalculationResult
calculateFeeResult ccipOwner maxUSDCentsPerMsg feeQuoterCid destChainSelector destConfig feeDestConfig feeToken payload ccipReceiveGasLimit ccvFeeQuotes tokenPoolFeeQuote executorArgs executorFeeQuote = do
    let executorFlatUSDCents = case executorFeeQuote of
            None -> 0.0
            Some q -> q.feeUSDCents
    let hasTokenTransfer = isSome tokenPoolFeeQuote
    let ccvFeeUSDCents = foldl (+) 0.0 (map (.feeUSDCents) ccvFeeQuotes)
    let ccvGasSum = foldl (+) 0 (map (.gasForVerification) ccvFeeQuotes)
    let ccvBytesSum = foldl (+) 0 (map (.payloadSizeBytes) ccvFeeQuotes)
    let (poolFeeUSDCents, poolGas, poolBytes) = case tokenPoolFeeQuote of
            None -> (0.0, 0, 0)
            Some q -> (q.feeUSDCents, q.destGasOverhead, q.destBytesOverhead)
    let executorDestGasLimit = destConfig.baseExecutionGasCost + ccipReceiveGasLimit
    let executorDestBytesOverhead = if hasTokenTransfer
            then computeExecutorDestBytesOverheadWithToken
                destConfig.addressBytesLength
                (byteCount payload)
                (byteCount executorArgs)
            else computeExecutorDestBytesOverhead
                destConfig.addressBytesLength
                (byteCount payload)
                (byteCount executorArgs)

    let nonCalldataGas =
            feeDestConfig.destGasOverhead
            + ccvGasSum
            + poolGas
            + executorDestGasLimit
    let calldataSize =
            byteCount payload
            + ccvBytesSum
            + poolBytes
            + executorDestBytesOverhead
    quote <- exercise feeQuoterCid CCIP.FeeQuoter.QuoteGasForExec with
        destChainSelector = destChainSelector
        nonCalldataGas
        calldataSize
        feeToken = feeToken
        caller = ccipOwner

    -- Apply the premium multiplier to USD-cent fees for the cap check.
    -- EVM FeeQuoter.sol line 728: premiumFeeUSDWei *= multiplier.
    let premiumMultiplierN = CCIP.Math.decimalToNumeric0 quote.premiumMultiplier
    let premiumize feeUSDCents =
            CCIP.Math.mulDivDown feeUSDCents premiumMultiplierN CCIP.Math.premiumIdentity
    let networkFeeUSDCents = if hasTokenTransfer
            then destConfig.tokenNetworkFeeUSDCents
            else destConfig.messageNetworkFeeUSDCents
    let networkPremiumUSDCents = premiumize networkFeeUSDCents
    let ccvPremiumUSDCents = premiumize ccvFeeUSDCents
    let poolPremiumUSDCents = premiumize poolFeeUSDCents
    let executionCostUSDCents = if isSome executorFeeQuote
            then quote.gasCostUSDCents
            else 0.0
    let totalUSDCents =
            ccvPremiumUSDCents
            + poolPremiumUSDCents
            + networkPremiumUSDCents
            + executorFlatUSDCents
            + executionCostUSDCents
    assertMsg "onramp: message fee exceeds maxUSDCentsPerMsg"
        (totalUSDCents <= maxUSDCentsPerMsg)

    -- Convert per-component USD-cent fees into fee token smallest units.
    -- See SendingMessageV1.FinalizeFee for the detailed EVM mapping.
    let feeTokenPriceN = CCIP.Math.decimalToNumeric0 quote.feeTokenPrice
    let promoteUsdCentsToUsd10 feeUSDCents =
            CCIP.Math.mulDivDown feeUSDCents CCIP.Math.usdPerUsdCent 1.0
    let convertWithPremium feeUSDCents =
            let feeUsd10 = promoteUsdCentsToUsd10 feeUSDCents
            in CCIP.Math.mulDivDown feeUsd10 premiumMultiplierN feeTokenPriceN
    let convertDirect feeUSDCents =
            let feeUsd10 = promoteUsdCentsToUsd10 feeUSDCents
            in CCIP.Math.mulDivDown feeUsd10 CCIP.Math.premiumIdentity feeTokenPriceN
    let totalFeeTokenAmount =
            convertWithPremium ccvFeeUSDCents
            + convertWithPremium poolFeeUSDCents
            + convertWithPremium networkFeeUSDCents
            + convertDirect executorFlatUSDCents
            + convertDirect executionCostUSDCents

    pure FeeCalculationResult with
        totalFeeTokenAmount = totalFeeTokenAmount
        totalUSDCents = totalUSDCents
        executionCostUSDCents = executionCostUSDCents
        executorDestGasLimit = executorDestGasLimit
        executorDestBytesOverhead = executorDestBytesOverhead
        totalExecutionGasLimit = quote.totalGas
        premiumMultiplier = quote.premiumMultiplier
        feeTokenPrice = quote.feeTokenPrice

template OnRamp
    with
        instanceId : Text
        ccipOwner : Party
        maxUSDCentsPerMsg : Numeric 0
        deps : OnRampDeps
    where
        signatory ccipOwner
        ensure assertValidInstanceId instanceId

        choice SetDeps : ContractId OnRamp
            with
                newDeps : SetDepsParams
            controller ccipOwner
            do
                let mergedDeps = OnRampDeps with
                        globalConfig = fromOptional deps.globalConfig newDeps.globalConfig
                        rmnRemote = fromOptional deps.rmnRemote newDeps.rmnRemote
                        tokenAdminRegistry = fromOptional deps.tokenAdminRegistry newDeps.tokenAdminRegistry
                        feeQuoter = fromOptional deps.feeQuoter newDeps.feeQuoter
                        ccvRegistry = fromOptional deps.ccvRegistry newDeps.ccvRegistry
                create this with deps = mergedDeps

        -- | Get required CCV raw instance addresses for outbound message.
        -- TODO: this should not concat default and lane mandated CCVs and return
        nonconsuming choice GetRequiredCCVsForSendFromRouter : [RawInstanceAddress.RawInstanceAddress]
            with
                globalConfigCid : ContractId CCIP.GlobalConfig.GlobalConfig
                destChainSelector : Numeric 0
                message : CCIP.Client.Canton2AnyMessage
                tokenPoolRequiredCCVs : [RawInstanceAddress.RawInstanceAddress]
            controller ccipOwner
            do
                globalConfig <- fetch globalConfigCid
                RawInstanceAddress.assertEqual "onramp: globalconfig instance address mismatch"
                    globalConfig.instanceId globalConfig.ccipOwner deps.globalConfig

                destConfigOpt <- exercise globalConfigCid
                    CCIP.GlobalConfig.GetDestChainConfig with
                        destChainSelector = destChainSelector
                        caller = ccipOwner
                case destConfigOpt of
                    None -> pure []
                    Some config -> do
                        extraArgs <- case message.extraArgs of
                                CCIP.Client.V3 v3 -> pure v3
                                _ -> abort "onramp: unsupported extraArgs version"
                        pure (computeRequiredCCVsForSend config message extraArgs tokenPoolRequiredCCVs)

        -- | Build SendingMessageV1 for outbound message.
        -- Validates fee token is accepted, reads network fee from DestChainConfig.
        -- Message construction is deferred until execution metadata is finalized.
        nonconsuming choice PrepareSendFromRouter : ContractId CCIP.SendingMessageV1.SendingMessageV1
            with
                destChainSelector : Numeric 0
                message : CCIP.Client.Canton2AnyMessage

                routerPartyOwner : Party
                routerInstanceId : Text
                globalConfigCid : ContractId CCIP.GlobalConfig.GlobalConfig
                tokenAdminRegistryCid : ContractId CCIP.TokenAdminRegistry.TokenAdminRegistry
                feeQuoterCid : ContractId CCIP.FeeQuoter.FeeQuoter
                rmnRemoteCid : ContractId CCIP.RMNRemote.RMNRemote
                currentSequenceNumber : Numeric 0
            controller ccipOwner
            do
                -- Fetch dependencies
                globalConfig <- fetch globalConfigCid
                RawInstanceAddress.assertEqual "onramp: globalconfig instance address mismatch"
                    globalConfig.instanceId globalConfig.ccipOwner deps.globalConfig

                rmnRemote <- fetch rmnRemoteCid
                RawInstanceAddress.assertEqual "onramp: rmn mismatch"
                    rmnRemote.instanceId rmnRemote.rmnOwner deps.rmnRemote

                tokenAdminRegistry <- fetch tokenAdminRegistryCid
                RawInstanceAddress.assertEqual "onramp: tokenadminregistry instance address mismatch"
                    tokenAdminRegistry.instanceId tokenAdminRegistry.owner deps.tokenAdminRegistry

                feeQuoter <- fetch feeQuoterCid
                RawInstanceAddress.assertEqual "onramp: feequoter instance address mismatch"
                    feeQuoter.instanceId feeQuoter.owner deps.feeQuoter

                -- RMN curse check
                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = ccipOwner
                    chainSelector = destChainSelector
                assertMsg "onramp: destination chain is cursed" (not isCursed)

                destConfigOpt <- exercise globalConfigCid
                    CCIP.GlobalConfig.GetDestChainConfig with
                        destChainSelector = destChainSelector
                        caller = ccipOwner
                destConfig <- case destConfigOpt of
                    None -> abort "onramp: unknown destination chain"
                    Some c -> do
                        assertMsg "onramp: destination chain disabled" c.isEnabled
                        pure c

                -- Validate message fields
                assertValidHex "receiver" message.receiver
                assertValidHex "payload" message.payload

                -- Parse extraArgs and validate fields
                extraArgs <- case message.extraArgs of
                        CCIP.Client.V3 v3 -> pure v3
                        _ -> abort "onramp: unsupported extraArgs version" -- exhaustive default match to ensure this fails if new versions of extraArgs are added without updating the onramp
                assertMsg "onramp: gas limit exceeds uint32" (extraArgs.gasLimit <= 4294967295)
                assertMsg "onramp: block confirmations not allowed from Canton" (extraArgs.blockConfirmations == 0)
                assertValidHex "tokenReceiver" extraArgs.tokenReceiver
                assertMsg "onramp: tokenReceiver not allowed" (destConfig.tokenReceiverAllowed || extraArgs.tokenReceiver == "")
                assertValidHex "tokenArgs" extraArgs.tokenArgs
                Foldable.forA_ extraArgs.ccvs (\ccvExtraArg ->
                    assertValidHex "ccvArgs" ccvExtraArg.ccvArgs)
                assertMsg "onramp: CCVs cannot contain duplicates"
                    (unique (map (.ccvAddress) extraArgs.ccvs))
                case extraArgs.executor of
                    CCIP.Client.Executor_NoExecutor -> pure ()
                    CCIP.Client.Executor_UseDefault with executorArgs ->
                        assertValidHex "executorArgs" executorArgs
                    CCIP.Client.Executor_WithAddress with executorArgs ->
                        assertValidHex "executorArgs" executorArgs

                case Map.lookup destChainSelector feeQuoter.destChainConfigs of
                    Some feeDestConfig ->
                        assertMsg "onramp: payload exceeds destination maxDataBytes"
                            (byteCount message.payload <= feeDestConfig.maxDataBytes)
                    None -> pure ()

                _ <- exercise feeQuoterCid CCIP.FeeQuoter.GetTokenPrice with
                    instrumentId = message.feeToken
                    caller = ccipOwner

                let (hasTokenTransfer, tokenInstrumentId) = case message.tokenTransfer of
                        None -> (False, None)
                        Some tt -> (True, Some tt.token)
                let resolvedCCVs =
                        computeRequiredCCVsForSend
                            destConfig
                            message
                            extraArgs
                            (map (.ccvAddress) extraArgs.ccvs)

                let newSequenceNumber = currentSequenceNumber + 1.0
                assertMsg "onramp: sequence number exceeds uint64"
                    (newSequenceNumber <= 18446744073709551615.0)
                let onRampAddr = CCIP.MessageCodecV1.encodeInstanceAddress instanceId ccipOwner
                let senderAddr = CCIP.MessageCodecV1.encodePartyAddress routerPartyOwner
                let resolvedTokenReceiver = if hasTokenTransfer
                        then validateDestChainAddress (if extraArgs.tokenReceiver /= "" then extraArgs.tokenReceiver else message.receiver) destConfig.addressBytesLength
                        else ""
                let networkFeeUSD = if hasTokenTransfer
                        then destConfig.tokenNetworkFeeUSDCents
                        else destConfig.messageNetworkFeeUSDCents
                let initialState = if hasTokenTransfer
                        then CCIP.SendingMessageV1.SendingMessageState_RequirePoolCCVs
                        else CCIP.SendingMessageV1.SendingMessageState_Prepared
                let (resolvedRequiredExecutor, resolvedExecutorAddress, executionMode) = case extraArgs.executor of
                        CCIP.Client.Executor_UseDefault with
                            executorArgs = _ ->
                            case destConfig.defaultExecutor of
                                Some defaultExecutor ->
                                    ( Some defaultExecutor
                                    , RawInstanceAddress.toInstanceAddress defaultExecutor
                                    , Some CCIP.SendingMessageV1.ExecutionMode_Executor
                                    )
                                None ->
                                    (None, noExecutionAddressBytes, Some CCIP.SendingMessageV1.ExecutionMode_NoExecutor)
                        CCIP.Client.Executor_NoExecutor ->
                            (None, noExecutionAddressBytes, Some CCIP.SendingMessageV1.ExecutionMode_NoExecutor)
                        CCIP.Client.Executor_WithAddress with
                            executorAddress
                            executorArgs = _ ->
                            ( Some executorAddress
                            , RawInstanceAddress.toInstanceAddress executorAddress
                            , Some CCIP.SendingMessageV1.ExecutionMode_Executor
                            )

                create CCIP.SendingMessageV1.SendingMessageV1 with
                    ccipOwner = ccipOwner
                    sender = routerPartyOwner
                    deps = CCIP.SendingMessageV1.SendingMessageDeps with
                        router = RawInstanceAddress.make routerInstanceId routerPartyOwner
                        onRamp = rawInstanceAddress this
                        globalConfig = deps.globalConfig
                        rmnRemote = deps.rmnRemote
                        tokenAdminRegistry = deps.tokenAdminRegistry
                        feeQuoter = deps.feeQuoter
                    destChainSelector
                    sequenceNumber = newSequenceNumber
                    requiredCCVs = resolvedCCVs
                    requiredExecutor = resolvedRequiredExecutor
                    sourceChainSelector = globalConfig.chainSelector
                    senderAddress = senderAddr
                    receiver = validateDestChainAddress message.receiver destConfig.addressBytesLength
                    payload = message.payload
                    executionGasLimit = 0
                    ccipReceiveGasLimit = extraArgs.gasLimit -- TODO: does this default to default gas limit if 0?
                    ccvAndExecutorHash = ""
                    onRampAddress = onRampAddr
                    offRampAddress = destConfig.offRampAddress
                    tokenReceiver = resolvedTokenReceiver
                    tokenArgs = extraArgs.tokenArgs
                    message = None
                    encodedMessage = ""
                    messageId = ""
                    feeToken = message.feeToken
                    networkFeeUSDCents = networkFeeUSD
                    expectedTokenInstrumentId = tokenInstrumentId
                    outboundPoolCCVs = None
                    executorAddress = resolvedExecutorAddress
                    executionMode = executionMode
                    executorArgs = ""
                    executorFee = None
                    executorDestGasLimit = 0
                    executorDestBytesOverhead = 0
                    executorFeeTokenAmount = 0.0
                    ccvFees = []
                    tokenSendFee = None
                    ccvFeeTokenAmounts = []
                    tokenSendFeeTokenAmount = 0.0
                    networkFeeTokenAmount = 0.0
                    verifierData = []
                    ccvOwners = []
                    tokenSendData = None
                    observingParties = [routerPartyOwner]
                    state = initialState

        -- | Quote the fee for an outbound message without creating a SendingMessageV1.
        nonconsuming choice GetFeeFromRouter : GetFeeFromRouterResult
            with
                routerPartyOwner : Party
                routerInstanceId : Text
                globalConfigCid : ContractId CCIP.GlobalConfig.GlobalConfig
                feeQuoterCid : ContractId CCIP.FeeQuoter.FeeQuoter
                destChainSelector : Numeric 0
                feeToken : Splice.Api.Token.HoldingV1.InstrumentId
                payload : BytesHex
                ccipReceiveGasLimit : Int
                ccvFeeQuotes : [ICCV.CrossChainVerifierFeeQuote]
                tokenPoolFeeQuote : Optional CCIP.Interfaces.TokenPool.TokenPoolFeeQuote
                executorArgs : BytesHex
                executorFeeQuote : Optional CCIP.Interfaces.Executor.ExecutorFeeQuote
            controller ccipOwner
            do
                assertValidHex "payload" payload
                assertValidHex "executorArgs" executorArgs
                assertMsg "onramp: executor quote/args mismatch"
                    (case executorFeeQuote of
                        None -> executorArgs == ""
                        Some _ -> True)

                globalConfig <- fetch globalConfigCid
                RawInstanceAddress.assertEqual "onramp: globalconfig instance address mismatch"
                    globalConfig.instanceId globalConfig.ccipOwner deps.globalConfig

                feeQuoter <- fetch feeQuoterCid
                RawInstanceAddress.assertEqual "onramp: feequoter instance address mismatch"
                    feeQuoter.instanceId feeQuoter.owner deps.feeQuoter

                destConfigOpt <- exercise globalConfigCid
                    CCIP.GlobalConfig.GetDestChainConfig with
                        destChainSelector = destChainSelector
                        caller = ccipOwner
                destConfig <- case destConfigOpt of
                    None -> abort "onramp: unknown destination chain"
                    Some cfg -> do
                        assertMsg "onramp: destination chain disabled" cfg.isEnabled
                        pure cfg

                feeDestConfig <- exercise feeQuoterCid
                    CCIP.FeeQuoter.GetDestChainConfig with
                        destChainSelector = destChainSelector
                        caller = ccipOwner

                feeResult <- calculateFeeResult
                    ccipOwner
                    maxUSDCentsPerMsg
                    feeQuoterCid
                    destChainSelector
                    destConfig
                    feeDestConfig
                    feeToken
                    payload
                    ccipReceiveGasLimit
                    ccvFeeQuotes
                    tokenPoolFeeQuote
                    executorArgs
                    executorFeeQuote

                pure GetFeeFromRouterResult with
                    feeTokenAmount = feeResult.totalFeeTokenAmount

        -- | Finalize execution metadata and fees from the router. Message
        -- construction remains a separate state-machine transition.
        nonconsuming choice FinalizeFeeFromRouter : ContractId CCIP.SendingMessageV1.SendingMessageV1
            with
                routerPartyOwner : Party
                routerInstanceId : Text
                globalConfigCid : ContractId CCIP.GlobalConfig.GlobalConfig
                feeQuoterCid : ContractId CCIP.FeeQuoter.FeeQuoter
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
            controller ccipOwner
            do
                sendingMsg <- fetch sendingMessageCid
                assertMsg "sendingMessage ccipOwner mismatch"
                    (sendingMsg.ccipOwner == ccipOwner)
                assertMsg "sendingMessage sender mismatch"
                    (sendingMsg.sender == routerPartyOwner)
                RawInstanceAddress.assertEqual "router instance mismatch"
                    routerInstanceId routerPartyOwner sendingMsg.deps.router
                RawInstanceAddress.assertEqual "onramp instance mismatch"
                    instanceId ccipOwner sendingMsg.deps.onRamp
                assertMsg "sendingMessage feeQuoter mismatch"
                    (sendingMsg.deps.feeQuoter == deps.feeQuoter)
                assertMsg "sendingMessage globalConfig mismatch"
                    (sendingMsg.deps.globalConfig == deps.globalConfig)

                globalConfig <- fetch globalConfigCid
                RawInstanceAddress.assertEqual "onramp: globalconfig instance address mismatch"
                    globalConfig.instanceId globalConfig.ccipOwner deps.globalConfig

                feeQuoter <- fetch feeQuoterCid
                RawInstanceAddress.assertEqual "onramp: feequoter instance address mismatch"
                    feeQuoter.instanceId feeQuoter.owner deps.feeQuoter

                destConfigOpt <- exercise globalConfigCid
                    CCIP.GlobalConfig.GetDestChainConfig with
                        destChainSelector = sendingMsg.destChainSelector
                        caller = ccipOwner
                destConfig <- case destConfigOpt of
                    None -> abort "onramp: unknown destination chain"
                    Some cfg -> do
                        assertMsg "onramp: destination chain disabled" cfg.isEnabled
                        pure cfg

                feeDestConfig <- exercise feeQuoterCid
                    CCIP.FeeQuoter.GetDestChainConfig with
                        destChainSelector = sendingMsg.destChainSelector
                        caller = ccipOwner

                let tokenPrice = fromSomeNote
                        ("No price found for " <> sendingMsg.feeToken.id)
                        (Map.lookup sendingMsg.feeToken feeQuoter.usdPerToken)
                let ccvFeeQuotes = map (\fee -> ICCV.CrossChainVerifierFeeQuote with
                        ccv = RawInstanceAddress.make fee.ccvInstanceId fee.ccvOwner
                        feeUSDCents = fee.feeUSDCents
                        gasForVerification = fee.destGasLimit
                        payloadSizeBytes = fee.destBytesOverhead
                    ) sendingMsg.ccvFees
                let tokenPoolFeeQuote = case sendingMsg.tokenSendFee of
                        None -> None
                        Some fee -> Some (CCIP.Interfaces.TokenPool.TokenPoolFeeQuote with
                            pool = RawInstanceAddress.make fee.poolInstanceId fee.poolOwner
                            feeUSDCents = fee.feeUSDCents
                            destGasOverhead = fee.destGasOverhead
                            destBytesOverhead = fee.destBytesOverhead
                            tokenFeeBps = 0.0
                            isEnabled = True)
                let executorFeeQuote = case sendingMsg.executionMode of
                        Some CCIP.SendingMessageV1.ExecutionMode_NoExecutor -> None
                        _ -> case sendingMsg.executorFee of
                            None -> None
                            Some fee -> Some (CCIP.Interfaces.Executor.ExecutorFeeQuote with
                                executor = RawInstanceAddress.make fee.executorInstanceId fee.executorOwner
                                feeUSDCents = fee.feeUSDCents)
                feeResult <- calculateFeeResult
                    ccipOwner
                    maxUSDCentsPerMsg
                    feeQuoterCid
                    sendingMsg.destChainSelector
                    destConfig
                    feeDestConfig
                    sendingMsg.feeToken
                    sendingMsg.payload
                    sendingMsg.ccipReceiveGasLimit
                    ccvFeeQuotes
                    tokenPoolFeeQuote
                    sendingMsg.executorArgs
                    executorFeeQuote

                finalizedCid <- exercise sendingMessageCid
                    CCIP.SendingMessageV1.FinalizeFee with
                        feeTokenPrice = tokenPrice.price
                        premiumMultiplier = feeResult.premiumMultiplier
                        totalExecutionGasLimit = feeResult.totalExecutionGasLimit
                        executorDestGasLimit = feeResult.executorDestGasLimit
                        executorDestBytesOverhead = feeResult.executorDestBytesOverhead
                        executionCostUSDCents = feeResult.executionCostUSDCents

                finalizedMsg <- fetch finalizedCid
                assertMsg "onramp: execution gas exceeds destination maxPerMsgGasLimit"
                    (finalizedMsg.executionGasLimit <= feeDestConfig.maxPerMsgGasLimit)

                pure finalizedCid

        -- | Validate and finalize a CCIP send.
        -- Reads accumulated data from SendingMessageV1. Fee collection happens
        -- in PerPartyRouter, not here.
        nonconsuming choice CCIPSendFromRouter : CCIPSendFromRouterResult
            with
                routerPartyOwner : Party
                routerInstanceId : Text
                currentSequenceNumber : Numeric 0
                rmnRemoteCid : ContractId CCIP.RMNRemote.RMNRemote
                globalConfigCid : ContractId CCIP.GlobalConfig.GlobalConfig
                tokenAdminRegistryCid : ContractId CCIP.TokenAdminRegistry.TokenAdminRegistry
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
            controller ccipOwner
            do
                sendingMsg <- fetch sendingMessageCid
                assertMsg "sendingMessage ccipOwner mismatch"
                    (sendingMsg.ccipOwner == ccipOwner)
                assertMsg "sendingMessage sender mismatch"
                    (sendingMsg.sender == routerPartyOwner)
                RawInstanceAddress.assertEqual "router instance mismatch"
                    routerInstanceId routerPartyOwner sendingMsg.deps.router
                RawInstanceAddress.assertEqual "onramp instance mismatch"
                    instanceId ccipOwner sendingMsg.deps.onRamp
                assertMsg "sendingMessage globalConfig mismatch"
                    (sendingMsg.deps.globalConfig == deps.globalConfig)
                assertMsg "sendingMessage rmnRemote mismatch"
                    (sendingMsg.deps.rmnRemote == deps.rmnRemote)
                assertMsg "sendingMessage tokenAdminRegistry mismatch"
                    (sendingMsg.deps.tokenAdminRegistry == deps.tokenAdminRegistry)
                assertMsg "sendingMessage feeQuoter mismatch"
                    (sendingMsg.deps.feeQuoter == deps.feeQuoter)

                theMessage <- case sendingMsg.message of
                    None -> abort "message not yet constructed"
                    Some m -> pure m

                assertMsg "sendingMessage not fee-finalized"
                    (sendingMsg.state == CCIP.SendingMessageV1.SendingMessageState_FeeFinalized)

                assertMsg "sequence number mismatch"
                    (sendingMsg.sequenceNumber == currentSequenceNumber + 1.0)

                globalConfig <- fetch globalConfigCid
                RawInstanceAddress.assertEqual "globalconfig mismatch"
                    globalConfig.instanceId globalConfig.ccipOwner
                    sendingMsg.deps.globalConfig

                rmnRemote <- fetch rmnRemoteCid
                RawInstanceAddress.assertEqual "onramp: rmn mismatch"
                    rmnRemote.instanceId rmnRemote.rmnOwner sendingMsg.deps.rmnRemote

                tokenAdminRegistry <- fetch tokenAdminRegistryCid
                RawInstanceAddress.assertEqual "tar mismatch"
                    tokenAdminRegistry.instanceId tokenAdminRegistry.owner
                    sendingMsg.deps.tokenAdminRegistry

                -- Authoritative RMN curse check
                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = ccipOwner
                    chainSelector = sendingMsg.destChainSelector
                assertMsg "dest chain is cursed" (not isCursed)

                destConfigOpt <- exercise globalConfigCid
                    CCIP.GlobalConfig.GetDestChainConfig with
                        destChainSelector = sendingMsg.destChainSelector
                        caller = ccipOwner
                destConfig <- case destConfigOpt of
                    None -> abort "unknown destination chain"
                    Some c -> do
                        assertMsg "destination chain disabled" c.isEnabled
                        pure c

                -- Validate required CCVs covered by verifierData
                let verifierRawAddrs = map
                        (\vd -> RawInstanceAddress.make vd.ccvInstanceId vd.ccvOwner)
                        sendingMsg.verifierData
                Foldable.forA_ sendingMsg.requiredCCVs $ \requiredCCV ->
                    assertMsg ("missing required CCV " <> show requiredCCV)
                        (requiredCCV `elem` verifierRawAddrs)

                let ccvFeeRawAddrs = map
                        (\fee -> RawInstanceAddress.make fee.ccvInstanceId fee.ccvOwner)
                        sendingMsg.ccvFees
                Foldable.forA_ sendingMsg.requiredCCVs $ \requiredCCV ->
                    assertMsg ("missing CCV fee for " <> show requiredCCV)
                        (requiredCCV `elem` ccvFeeRawAddrs)

                case (sendingMsg.tokenSendData, sendingMsg.tokenSendFee) of
                    (Some _, None) -> abort "missing token pool fee"
                    _ -> pure ()

                -- Cross-validate tokenSendData against message.tokenTransfer via TAR
                case (theMessage.tokenTransfer, sendingMsg.tokenSendData) of
                    (Some tt, Some tsd) -> do
                        configOpt <- exercise tokenAdminRegistryCid
                            CCIP.TokenAdminRegistry.TokenAdminRegistry_GetTokenConfig with
                                instrumentId = tsd.instrumentId
                                caller = ccipOwner
                        pool <- case configOpt of
                            None -> abort "no token config for instrument"
                            Some config -> case config.tokenPool of
                                None -> abort "no pool registered"
                                Some p -> pure p
                        let expectedPoolAddr = CCIP.MessageCodecV1.encodeInstanceAddress
                                pool.poolInstanceId pool.poolOwner
                        let expectedTokenAddr = CCIP.MessageCodecV1.encodeInstrumentId
                                tsd.instrumentId
                        assertMsg "sourcePoolAddress mismatch"
                            (tt.sourcePoolAddress == expectedPoolAddr)
                        assertMsg "sourceTokenAddress mismatch"
                            (tt.sourceTokenAddress == expectedTokenAddr)
                        assertMsg "token amount mismatch"
                            (tt.amount == tsd.amount)
                        let _ = validateDestChainAddress tsd.destTokenAddress destConfig.addressBytesLength
                        pure()
                    (None, None) -> pure ()
                    _ -> abort "token transfer / token send data mismatch"

                let receipts = assembleReceipts sendingMsg
                let finalVerifierData = orderedVerifierData sendingMsg
                finalizeResult <- exercise sendingMessageCid CCIP.SendingMessageV1.FinalizeSend with
                    messageSender = routerPartyOwner
                    messageSentObservers = concatMap (.messageSentObservers) finalVerifierData
                    verifierBlobs = map (.verifierBlob) finalVerifierData
                    receipts = receipts

                pure CCIPSendFromRouterResult with
                    ccipMessageSent = finalizeResult.ccipMessageSent
                    verifierBlobs =
                        map (.verifierBlob) finalVerifierData
                    messageSentObservers =
                        concatMap (.messageSentObservers) finalVerifierData
                    receipts

        interface instance MCMSReceiver for OnRamp where
          view = MCMSReceiverView with
            mcmsController = ccipOwner
            instanceId

          mcmsEntrypoint functionName operationData contractIds = do
            let instAddr = instanceId <> "@" <> partyToText ccipOwner
            selfCid <- case Map.lookup instAddr contractIds of
              None -> abort $ "E_SELF_CID_NOT_IN_MAP: " <> instAddr
              Some cid -> pure (coerceContractId cid : ContractId OnRamp)

            case functionName of
              "SetDeps" -> do
                case decodeSetDepsParamsWithOffset operationData of
                  None -> abort "E_INVALID_PARAMS: SetDeps"
                  Some (newDeps, finalOffset) -> do
                    assertMsg "E_TRAILING_BYTES: SetDeps" $
                      finalOffset == byteCount operationData
                    newCid <- exercise selfCid SetDeps with newDeps
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              _ -> abort $ "E_UNKNOWN_FUNCTION: " <> functionName

data CCIPSendFromRouterResult = CCIPSendFromRouterResult
    with
        ccipMessageSent : ContractId CCIP.Events.CCIPMessageSent
        verifierBlobs : [BytesHex]
        messageSentObservers : [Party]
        receipts : [CCIP.Tickets.Receipt]
    deriving (Eq, Show)

orderedVerifierDataByCCVs
    : [BytesHex]
    -> [CCIP.SendingMessageV1.VerifierData]
    -> [CCIP.SendingMessageV1.VerifierData]
orderedVerifierDataByCCVs finalCCVs verifierData =
    let
        lookupVerifier ccvAddr =
            case filter
                (\vd -> CCIP.MessageCodecV1.encodeInstanceAddress vd.ccvInstanceId vd.ccvOwner == ccvAddr)
                verifierData of
                [vd] -> vd
                [] -> error ("missing verifier data for CCV address " <> ccvAddr)
                _ -> error ("duplicate verifier data for CCV address " <> ccvAddr)
    in
        map (\ccv -> lookupVerifier ccv) finalCCVs

orderedVerifierData : CCIP.SendingMessageV1.SendingMessageV1 -> [CCIP.SendingMessageV1.VerifierData]
orderedVerifierData sendingMsg =
    let
        finalCCVs = map RawInstanceAddress.toInstanceAddress
            (dedup (sendingMsg.requiredCCVs ++ fromOptional [] sendingMsg.outboundPoolCCVs))
    in
        orderedVerifierDataByCCVs finalCCVs sendingMsg.verifierData

-- | Assemble final receipts from the separated fee fields, verifier data,
-- token send data, executor fee, and the network fee. Receipt order matches
-- EVM: CCV receipts, pool receipt, executor receipt, network fee receipt.
assembleReceipts : CCIP.SendingMessageV1.SendingMessageV1 -> [CCIP.Tickets.Receipt]
assembleReceipts sendingMsg =
    let
        finalVerifierData = orderedVerifierData sendingMsg
        ccvReceipts = map
            (assembleCCVReceipt sendingMsg.ccvFees
                sendingMsg.ccvFeeTokenAmounts)
            finalVerifierData

        poolReceipt = case (sendingMsg.tokenSendData, sendingMsg.tokenSendFee) of
            (Some tsd, Some fee) ->
                let poolAddr = CCIP.MessageCodecV1.encodeInstanceAddress
                        tsd.poolInstanceId tsd.poolOwner
                in [CCIP.Tickets.Receipt with
                    issuerType = CCIP.Tickets.IssuerType_Pool
                    issuerAddress = poolAddr
                    versionTag = None
                    destGasLimit = fee.destGasOverhead
                    destBytesOverhead = fee.destBytesOverhead
                    feeTokenAmount = CCIP.Math.decimalToNumeric0 sendingMsg.tokenSendFeeTokenAmount
                    extraArgs = ""]
            _ -> []

        executorReceipt = case sendingMsg.executionMode of
            None -> []
            Some execMode ->
                let execAddr = case execMode of
                        CCIP.SendingMessageV1.ExecutionMode_Executor ->
                            case sendingMsg.executorFee of
                                Some fee -> CCIP.MessageCodecV1.encodeInstanceAddress
                                    fee.executorInstanceId fee.executorOwner
                                None -> error "missing executor fee"
                        CCIP.SendingMessageV1.ExecutionMode_NoExecutor ->
                            noExecutionAddressBytes
                in [CCIP.Tickets.Receipt with
                    issuerType = CCIP.Tickets.IssuerType_Executor
                    issuerAddress = execAddr
                    versionTag = None
                    destGasLimit = sendingMsg.executorDestGasLimit
                    destBytesOverhead = sendingMsg.executorDestBytesOverhead
                    feeTokenAmount = CCIP.Math.decimalToNumeric0 sendingMsg.executorFeeTokenAmount
                    extraArgs = sendingMsg.executorArgs]

        networkReceipt = CCIP.Tickets.Receipt with
            issuerType = CCIP.Tickets.IssuerType_Network
            issuerAddress = ""
            versionTag = None
            destGasLimit = 0
            destBytesOverhead = 0
            feeTokenAmount = CCIP.Math.decimalToNumeric0 sendingMsg.networkFeeTokenAmount
            extraArgs = ""

    in ccvReceipts ++ poolReceipt ++ executorReceipt ++ [networkReceipt]

-- | Finds the matching ccvFee by (ccvInstanceId, ccvOwner) and looks up
-- the corresponding feeTokenAmount from the parallel ccvFeeTokenAmounts list.
assembleCCVReceipt : [CCIP.SendingMessageV1.CCVFee] -> [Decimal] -> CCIP.SendingMessageV1.VerifierData -> CCIP.Tickets.Receipt
assembleCCVReceipt ccvFees ccvFeeTokenAmounts vd =
    let ccvAddr = CCIP.MessageCodecV1.encodeInstanceAddress vd.ccvInstanceId vd.ccvOwner
        (fee, feeTokenAmt) = findFeeWithAmount ccvFees ccvFeeTokenAmounts
            (\q -> q.ccvInstanceId == vd.ccvInstanceId
                && q.ccvOwner == vd.ccvOwner)
    in CCIP.Tickets.Receipt with
        issuerType = CCIP.Tickets.IssuerType_CCV
        issuerAddress = ccvAddr
        versionTag = Some vd.versionTag
        destGasLimit = fee.destGasLimit
        destBytesOverhead = fee.destBytesOverhead
        feeTokenAmount = CCIP.Math.decimalToNumeric0 feeTokenAmt
        extraArgs = ""

-- | Find a matching fee entry and its corresponding token amount from parallel lists.
findFeeWithAmount : [CCIP.SendingMessageV1.CCVFee] -> [Decimal] -> (CCIP.SendingMessageV1.CCVFee -> Bool) -> (CCIP.SendingMessageV1.CCVFee, Decimal)
findFeeWithAmount [] _ _ = error "missing CCV fee"
findFeeWithAmount _ [] _ = error "missing CCV fee token amount"
findFeeWithAmount (f :: fs) (a :: as) pred =
    if pred f then (f, a)
    else findFeeWithAmount fs as pred

-- | Validates a destination-chain address against the chain's expected address length and hex validity.
-- The message receiver, tokenReceiver, and destTokenAddress are all validated using this function since they're all remote chain addresses.
validateDestChainAddress : BytesHex -> Int -> BytesHex
validateDestChainAddress address addressBytesLength =
    if not (isValidHex address)
    then error ("InvalidDestChainAddress: not valid hex: " <> show address)
    else let actualLength = byteCount address
         in if actualLength == addressBytesLength
            then address
            else error ("InvalidDestChainAddress: address length (" <> show actualLength <> ") does not match expected length (" <> show addressBytesLength <> ") for the destination chain: " <> show address)

-- ===========================================================================
-- CODEC: SetDeps parameter encoding/decoding for MCMSReceiver entrypoint
-- ===========================================================================

-- | Decode SetDeps params with final offset (Optional fields)
-- Format: [OptRIA globalConfig][OptRIA rmnRemote][OptRIA tokenAdminRegistry][OptRIA feeQuoter][OptRIA ccvRegistry]
decodeSetDepsParamsWithOffset : BytesHex -> Optional (SetDepsParams, Int)
decodeSetDepsParamsWithOffset encoded = do
  (globalConfig, offset1) <- decodeOptionalRawInstanceAddressAt encoded 0
  (rmnRemote, offset2) <- decodeOptionalRawInstanceAddressAt encoded offset1
  (tokenAdminRegistry, offset3) <- decodeOptionalRawInstanceAddressAt encoded offset2
  (feeQuoter, offset4) <- decodeOptionalRawInstanceAddressAt encoded offset3
  (ccvRegistry, finalOffset) <- decodeOptionalRawInstanceAddressAt encoded offset4
  Some (SetDepsParams globalConfig rmnRemote tokenAdminRegistry feeQuoter ccvRegistry, finalOffset)

-- | Decode SetDeps params (discards final offset)
decodeSetDepsParams : BytesHex -> Optional SetDepsParams
decodeSetDepsParams encoded = do
  (result, _) <- decodeSetDepsParamsWithOffset encoded
  Some result

-- | Encode SetDeps params (Optional fields)
encodeSetDepsParams : SetDepsParams -> BytesHex
encodeSetDepsParams params =
  encodeOptionalRawInstanceAddress params.globalConfig <>
  encodeOptionalRawInstanceAddress params.rmnRemote <>
  encodeOptionalRawInstanceAddress params.tokenAdminRegistry <>
  encodeOptionalRawInstanceAddress params.feeQuoter <>
  encodeOptionalRawInstanceAddress params.ccvRegistry

-- | Decode OnRampDeps at offset (full, non-optional)
-- Format: [RIA globalConfig][RIA rmnRemote][RIA tokenAdminRegistry][RIA feeQuoter][RIA ccvRegistry]
decodeOnRampDepsAt : BytesHex -> Int -> Optional (OnRampDeps, Int)
decodeOnRampDepsAt encoded offset = do
  (globalConfig, offset1) <- decodeRawInstanceAddressAt encoded offset
  (rmnRemote, offset2) <- decodeRawInstanceAddressAt encoded offset1
  (tokenAdminRegistry, offset3) <- decodeRawInstanceAddressAt encoded offset2
  (feeQuoter, offset4) <- decodeRawInstanceAddressAt encoded offset3
  (ccvRegistry, offset5) <- decodeRawInstanceAddressAt encoded offset4
  Some (OnRampDeps globalConfig rmnRemote tokenAdminRegistry feeQuoter ccvRegistry, offset5)

-- | Encode OnRampDeps (full, non-optional)
encodeOnRampDeps : OnRampDeps -> BytesHex
encodeOnRampDeps deps =
  encodeRawInstanceAddress deps.globalConfig <>
  encodeRawInstanceAddress deps.rmnRemote <>
  encodeRawInstanceAddress deps.tokenAdminRegistry <>
  encodeRawInstanceAddress deps.feeQuoter <>
  encodeRawInstanceAddress deps.ccvRegistry
