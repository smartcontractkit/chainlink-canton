-- | Codec module for PerPartyRouter MCMS parameter encoding/decoding
-- Used by the MCMSReceiver interface implementation to decode operationData
module CCIP.PerPartyRouterCodec
  ( encodePerPartyRouterDeps
  , decodePerPartyRouterDepsAt
  , encodeSetDepsParams
  , decodeSetDepsParams
  ) where

import CCIP.MCMSCodecUtils
  ( encodeRawInstanceAddress
  , decodeRawInstanceAddressAt
  )

import DA.Crypto.Text (BytesHex)
import CCIP.PerPartyRouterTypes (PerPartyRouterDeps(..))

-- ===========================================================================
-- DECODE FUNCTIONS (for MCMSReceiver entrypoint)
-- ===========================================================================

-- | Decode SetDeps params
-- Format: [PerPartyRouterDeps]
decodeSetDepsParams : BytesHex -> Optional PerPartyRouterDeps
decodeSetDepsParams encoded = do
  (deps, _) <- decodePerPartyRouterDepsAt encoded 0
  Some deps

-- | Decode PerPartyRouterDeps at offset
-- Format: [RIA onRamp][RIA offRamp][RIA globalConfig][RIA tokenAdminRegistry][RIA feeQuoter][RIA rmnRemote]
decodePerPartyRouterDepsAt : BytesHex -> Int -> Optional (PerPartyRouterDeps, Int)
decodePerPartyRouterDepsAt encoded offset = do
  (onRamp, offset1) <- decodeRawInstanceAddressAt encoded offset
  (offRamp, offset2) <- decodeRawInstanceAddressAt encoded offset1
  (globalConfig, offset3) <- decodeRawInstanceAddressAt encoded offset2
  (tokenAdminRegistry, offset4) <- decodeRawInstanceAddressAt encoded offset3
  (feeQuoter, offset5) <- decodeRawInstanceAddressAt encoded offset4
  (rmnRemote, offset6) <- decodeRawInstanceAddressAt encoded offset5
  Some (PerPartyRouterDeps onRamp offRamp globalConfig tokenAdminRegistry feeQuoter rmnRemote, offset6)

-- ===========================================================================
-- ENCODE FUNCTIONS (for tests and Go integration)
-- ===========================================================================

-- | Encode SetDeps params
encodeSetDepsParams : PerPartyRouterDeps -> BytesHex
encodeSetDepsParams = encodePerPartyRouterDeps

-- | Encode PerPartyRouterDeps
encodePerPartyRouterDeps : PerPartyRouterDeps -> BytesHex
encodePerPartyRouterDeps deps =
  encodeRawInstanceAddress deps.onRamp <>
  encodeRawInstanceAddress deps.offRamp <>
  encodeRawInstanceAddress deps.globalConfig <>
  encodeRawInstanceAddress deps.tokenAdminRegistry <>
  encodeRawInstanceAddress deps.feeQuoter <>
  encodeRawInstanceAddress deps.rmnRemote
