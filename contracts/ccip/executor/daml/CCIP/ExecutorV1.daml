module CCIP.ExecutorV1 (
    module CCIP.ExecutorV1,
    module CCIP.ExecutorV1.ExecutorTypes,
) where

import DA.Crypto.Text (BytesHex, byteCount)
import DA.Foldable (forA_)
import DA.Foldable qualified as Foldable
import DA.List (dedup)
import DA.Optional (fromOptional, fromSomeNote)
import qualified DA.Map as Map

import qualified Splice.Api.Token.MetadataV1

import qualified Chainlink.InstanceAddress

import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiverView(..))

import qualified CCIP.APIV1.SendingMessage
import qualified CCIP.CodecV1.FinalityConfig
import qualified CCIP.CodecV1.CCVCodec
import qualified CCIP.InterfacesV1.Executor

import CCIP.ExecutorV1.ExecutorTypes (RemoteChainConfig(..), RemoteChainConfigArgs(..), DynamicConfig(..), ApplyDestChainUpdatesParams(..), SetDynamicConfigParams(..), ApplyAllowedCCVUpdatesParams(..))
import CCIP.ExecutorV1.ExecutorCodecGen (decodeApplyDestChainUpdatesParamsAt, decodeSetDynamicConfigParamsAt, decodeApplyAllowedCCVUpdatesParamsAt)

template Executor
    with
        instanceId : Text
        owner : Party
        maxCCVsPerMsg : Int
        dynamicConfig : DynamicConfig
        allowedCCVs : [Chainlink.InstanceAddress.RawInstanceAddress]
        remoteChainConfigs : Map.Map (Numeric 0) RemoteChainConfig
    where
        signatory owner
        ensure Chainlink.InstanceAddress.assertValidInstanceId instanceId
            && maxCCVsPerMsg > 0
            && maxCCVsPerMsg <= CCIP.CodecV1.CCVCodec.maxCCVsPerMessage
            && CCIP.CodecV1.FinalityConfig.isValidFinalityConfig dynamicConfig.allowedFinalityConfig

        interface instance CCIP.InterfacesV1.Executor.IExecutor for Executor where
            view = CCIP.InterfacesV1.Executor.ExecutorView with
                instanceId = instanceId
                owner = owner
                context = Splice.Api.Token.MetadataV1.emptyChoiceContext

            executor_calculateFeeImpl self arg = do
                exercise (fromInterfaceContractId @Executor self) CalculateFee with
                    expectedExecutor = arg.expectedExecutor
                    sendingMessageCid = arg.sendingMessageCid
                    executorArgs = arg.executorArgs
                    context = arg.context
                    caller = arg.caller

            executor_getFeeImpl self arg = do
                exercise (fromInterfaceContractId @Executor self) GetFee with
                    expectedExecutor = arg.expectedExecutor
                    destChainSelector = arg.destChainSelector
                    requiredCCVs = arg.requiredCCVs
                    context = arg.context
                    caller = arg.caller

        choice ApplyDestChainUpdates : ContractId Executor
            with
                destChainSelectorsToRemove : [Numeric 0]
                destChainSelectorsToAdd : [RemoteChainConfigArgs]
            controller owner
            do
                forA_ destChainSelectorsToAdd $ \cfg ->
                    assertMsg ("ApplyDestChainUpdates: invalid fee: " <> show cfg.config.feeUSDCents)
                        (cfg.config.feeUSDCents >= 0.0)
                let pruned = foldr Map.delete remoteChainConfigs destChainSelectorsToRemove
                let addConfig acc cfg = Map.insert cfg.destChainSelector cfg.config acc
                let merged = foldl addConfig pruned destChainSelectorsToAdd
                create this with remoteChainConfigs = merged

        choice SetDynamicConfig : ContractId Executor
            with
                newDynamicConfig : DynamicConfig
            controller owner
            do
                assertMsg "SetDynamicConfig: BlockDepth finality must be positive"
                    (CCIP.CodecV1.FinalityConfig.isValidFinalityConfig newDynamicConfig.allowedFinalityConfig)
                create this with dynamicConfig = newDynamicConfig

        choice ApplyAllowedCCVUpdates : ContractId Executor
            with
                ccvsToRemove : [Chainlink.InstanceAddress.RawInstanceAddress]
                ccvsToAdd : [Chainlink.InstanceAddress.RawInstanceAddress]
                ccvAllowlistEnabled : Bool
            controller owner
            do
                let kept = filter ((`notElem` ccvsToRemove)) allowedCCVs
                let merged = dedup (kept ++ ccvsToAdd)
                create this with
                    allowedCCVs = merged
                    dynamicConfig = dynamicConfig with
                        ccvAllowlistEnabled = ccvAllowlistEnabled

        nonconsuming choice GetDestChains : [RemoteChainConfigArgs]
            with
                caller : Party
            controller caller
            do
                pure (map (\entry -> RemoteChainConfigArgs with
                        destChainSelector = fst entry
                        config = snd entry
                    ) (Map.toList remoteChainConfigs))

        nonconsuming choice GetDynamicConfig : DynamicConfig
            with
                caller : Party
            controller caller
            do
                pure dynamicConfig

        nonconsuming choice GetAllowedCCVs : [Chainlink.InstanceAddress.RawInstanceAddress]
            with
                caller : Party
            controller caller
            do
                pure allowedCCVs

        nonconsuming choice GetMaxCCVsPerMessage : Int
            with
                caller : Party
            controller caller
            do
                pure maxCCVsPerMsg

        nonconsuming choice GetAllowedFinalityConfig : CCIP.CodecV1.FinalityConfig.FinalityConfig
            with
                caller : Party
            controller caller
            do
                pure dynamicConfig.allowedFinalityConfig

        -- Calculates the executor flat fee and validates the message.
        nonconsuming choice CalculateFee : ContractId CCIP.APIV1.SendingMessage.ISendingMessage
            with
                expectedExecutor : Chainlink.InstanceAddress.RawInstanceAddress
                sendingMessageCid : ContractId CCIP.APIV1.SendingMessage.ISendingMessage
                executorArgs : BytesHex
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                caller : Party
            controller caller
            do
                Chainlink.InstanceAddress.assertEqual "executor: expected executor mismatch"
                    instanceId owner expectedExecutor

                sendingMsg <- fetch sendingMessageCid
                let sendingMsgView = view sendingMsg

                let remoteCfg = fromSomeNote "executor: unsupported destination chain" (Map.lookup sendingMsgView.destChainSelector remoteChainConfigs)
                assertMsg "executor: destination chain disabled" remoteCfg.enabled

                let canonicalCCVs = dedup (sendingMsgView.requiredCCVs ++ fromOptional [] sendingMsgView.outboundPoolCCVs)

                if dynamicConfig.ccvAllowlistEnabled
                    then Foldable.forA_ canonicalCCVs (\ccv ->
                        assertMsg "executor: CCV not allowed" (ccv `elem` allowedCCVs)
                        )
                    else pure ()

                assertMsg "executor: too many CCVs in message"
                    (length canonicalCCVs <= maxCCVsPerMsg)

                exercise sendingMessageCid CCIP.APIV1.SendingMessage.SendingMessage_AddExecutorFee with
                    executorInstanceId = instanceId
                    executorArgs = executorArgs
                    feeUSDCents = remoteCfg.feeUSDCents
                    context = Splice.Api.Token.MetadataV1.emptyChoiceContext
                    caller = owner

        -- Quote-only fee path for executor.
        nonconsuming choice GetFee : CCIP.InterfacesV1.Executor.ExecutorFeeQuote
            with
                expectedExecutor : Chainlink.InstanceAddress.RawInstanceAddress
                destChainSelector : Numeric 0
                requiredCCVs : [Chainlink.InstanceAddress.RawInstanceAddress]
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                caller : Party
            controller caller
            do
                Chainlink.InstanceAddress.assertEqual "executor: expected executor mismatch"
                    instanceId owner expectedExecutor

                let remoteCfg = fromSomeNote "executor: unsupported destination chain"
                        (Map.lookup destChainSelector remoteChainConfigs)
                assertMsg "executor: destination chain disabled" remoteCfg.enabled

                let canonicalCCVs = dedup requiredCCVs

                if dynamicConfig.ccvAllowlistEnabled
                    then Foldable.forA_ canonicalCCVs (\ccv ->
                        assertMsg "executor: CCV not allowed" (ccv `elem` allowedCCVs)
                        )
                    else pure ()

                assertMsg "executor: too many CCVs in message"
                    (length canonicalCCVs <= maxCCVsPerMsg)

                pure CCIP.InterfacesV1.Executor.ExecutorFeeQuote with
                    executorInstanceId = instanceId
                    executorOwner = owner
                    feeUSDCents = remoteCfg.feeUSDCents
                    context = Splice.Api.Token.MetadataV1.emptyChoiceContext

        interface instance MCMSReceiver for Executor where
            view = MCMSReceiverView with
                mcmsController = owner
                instanceId = instanceId
            mcmsEntrypoint functionName operationData contractIds = do
                let instAddr = instanceId <> "@" <> partyToText owner
                selfCid <- case Map.lookup instAddr contractIds of
                    None -> abort ("E_SELF_CID_NOT_IN_MAP: " <> instAddr)
                    Some cid -> pure (coerceContractId cid : ContractId Executor)
                
                case functionName of
                    "ApplyDestChainUpdates" -> do
                        case decodeApplyDestChainUpdatesParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: ApplyDestChainUpdates"
                            Some (ApplyDestChainUpdatesParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: ApplyDestChainUpdates" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid ApplyDestChainUpdates with
                                    destChainSelectorsToRemove
                                    destChainSelectorsToAdd
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "SetDynamicConfig" -> do
                        case decodeSetDynamicConfigParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: SetDynamicConfig"
                            Some (SetDynamicConfigParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: SetDynamicConfig" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid SetDynamicConfig with
                                    newDynamicConfig
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "ApplyAllowedCCVUpdates" -> do
                        case decodeApplyAllowedCCVUpdatesParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: ApplyAllowedCCVUpdates"
                            Some (ApplyAllowedCCVUpdatesParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: ApplyAllowedCCVUpdates" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid ApplyAllowedCCVUpdates with
                                    ccvsToRemove
                                    ccvsToAdd
                                    ccvAllowlistEnabled
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    _ -> abort $ "E_UNKNOWN_FUNCTION: " <> functionName
