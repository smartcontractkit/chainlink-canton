module CCIP.ExecutorTypes where

import qualified CCIP.FinalityCodec
import MCMS.RawInstanceAddress (RawInstanceAddress)

data RemoteChainConfig = RemoteChainConfig
    with
        feeUSDCents : Numeric 0
        enabled : Bool
    deriving (Eq, Show)

data RemoteChainConfigArgs = RemoteChainConfigArgs
    with
        destChainSelector : Numeric 0
        config : RemoteChainConfig
    deriving (Eq, Show)

data DynamicConfig = DynamicConfig
    with
        feeAggregator : Optional Party
        allowedFinalityConfig : CCIP.FinalityCodec.FinalityConfig
        ccvAllowlistEnabled : Bool
    deriving (Eq, Show)

data ApplyDestChainUpdatesParams = ApplyDestChainUpdatesParams
    with
        destChainSelectorsToRemove : [Numeric 0]
        destChainSelectorsToAdd : [RemoteChainConfigArgs]
    deriving (Eq, Show)

data SetDynamicConfigParams = SetDynamicConfigParams
    with
        newDynamicConfig : DynamicConfig
    deriving (Eq, Show)

data ApplyAllowedCCVUpdatesParams = ApplyAllowedCCVUpdatesParams
    with
        ccvsToRemove : [RawInstanceAddress]
        ccvsToAdd : [RawInstanceAddress]
        ccvAllowlistEnabled : Bool
    deriving (Eq, Show)
