module CCIP.Executor where

import DA.Crypto.Text (BytesHex)
import DA.Foldable qualified as Foldable
import DA.List (dedup)
import DA.Optional (fromSomeNote, fromOptional)
import qualified DA.Map as Map

import CCIP.RawInstanceAddress (RawInstanceAddress)
import qualified CCIP.Interfaces.Executor
import qualified CCIP.SendingMessageV1

-- Per-destination-chain executor fee config.
-- Mirrors EVM Executor.RemoteChainConfig.
data RemoteChainConfig = RemoteChainConfig
    with
        feeUSDCents : Numeric 0
        enabled : Bool
    deriving (Eq, Show)

data RemoteChainConfigArgs = RemoteChainConfigArgs
    with
        destChainSelector : Numeric 0
        config : RemoteChainConfig
    deriving (Eq, Show)

-- Dynamic executor settings.
-- feeAggregator is retained for parity but not yet used on Canton.
data DynamicConfig = DynamicConfig
    with
        feeAggregator : Optional Party
        minBlockConfirmations : Int
        ccvAllowlistEnabled : Bool
    deriving (Eq, Show)

template Executor
    with
        instanceId : Text
        owner : Party
        maxCCVsPerMsg : Int
        dynamicConfig : DynamicConfig
        allowedCCVs : [RawInstanceAddress]
        remoteChainConfigs : Map.Map (Numeric 0) RemoteChainConfig
    where
        signatory owner
        ensure maxCCVsPerMsg > 0 && dynamicConfig.minBlockConfirmations >= 0

        interface instance CCIP.Interfaces.Executor.IExecutor for Executor where
            view = CCIP.Interfaces.Executor.ExecutorView with
                owner = owner

            executor_calculateFeeImpl self arg = do
                exercise (fromInterfaceContractId @Executor self) Executor_CalculateFee with
                    sendingMessageCid = arg.sendingMessageCid
                    executorArgs = arg.executorArgs
                    caller = arg.caller

        choice Executor_ApplyDestChainUpdates : ContractId Executor
            with
                destChainSelectorsToRemove : [Numeric 0]
                destChainSelectorsToAdd : [RemoteChainConfigArgs]
            controller owner
            do
                let pruned = foldr Map.delete remoteChainConfigs destChainSelectorsToRemove
                let addConfig acc cfg = Map.insert cfg.destChainSelector cfg.config acc
                let merged = foldl addConfig pruned destChainSelectorsToAdd
                create this with remoteChainConfigs = merged

        choice Executor_SetDynamicConfig : ContractId Executor
            with
                newDynamicConfig : DynamicConfig
            controller owner
            do
                assertMsg "executor: minBlockConfirmations must be >= 0"
                    (newDynamicConfig.minBlockConfirmations >= 0)
                create this with dynamicConfig = newDynamicConfig

        choice Executor_ApplyAllowedCCVUpdates : ContractId Executor
            with
                ccvsToRemove : [RawInstanceAddress]
                ccvsToAdd : [RawInstanceAddress]
                ccvAllowlistEnabled : Bool
            controller owner
            do
                let kept = filter (\ccv -> not (ccv `elem` ccvsToRemove)) allowedCCVs
                let merged = dedup (kept ++ ccvsToAdd)
                create this with
                    allowedCCVs = merged
                    dynamicConfig = dynamicConfig with
                        ccvAllowlistEnabled = ccvAllowlistEnabled

        nonconsuming choice Executor_GetDestChains : [RemoteChainConfigArgs]
            with
                caller : Party
            controller caller
            do
                pure (map (\entry -> RemoteChainConfigArgs with
                        destChainSelector = fst entry
                        config = snd entry
                    ) (Map.toList remoteChainConfigs))

        nonconsuming choice Executor_GetDynamicConfig : DynamicConfig
            with
                caller : Party
            controller caller
            do
                pure dynamicConfig

        nonconsuming choice Executor_GetAllowedCCVs : [RawInstanceAddress]
            with
                caller : Party
            controller caller
            do
                pure allowedCCVs

        nonconsuming choice Executor_GetMaxCCVsPerMessage : Int
            with
                caller : Party
            controller caller
            do
                pure maxCCVsPerMsg

        nonconsuming choice Executor_GetMinBlockConfirmations : Int
            with
                caller : Party
            controller caller
            do
                pure dynamicConfig.minBlockConfirmations

        -- Calculates executor fee and finalizes message state via SendingMessageV1.
        nonconsuming choice Executor_CalculateFee : ContractId CCIP.SendingMessageV1.SendingMessageV1
            with
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
                executorArgs : BytesHex
                caller : Party
            controller caller
            do
                sm <- fetch sendingMessageCid

                let remoteCfg = fromSomeNote "executor: unsupported destination chain"
                        (Map.lookup sm.destChainSelector remoteChainConfigs)
                assertMsg "executor: destination chain disabled" remoteCfg.enabled

                let canonicalCCVs = dedup (sm.requiredCCVs ++ fromOptional [] sm.outboundPoolCCVs)

                assertMsg "executor: requested block confirmations too low"
                    (sm.blockConfirmations == 0
                        || sm.blockConfirmations >= dynamicConfig.minBlockConfirmations)

                if dynamicConfig.ccvAllowlistEnabled
                    then Foldable.forA_ canonicalCCVs (\ccv ->
                        assertMsg "executor: CCV not allowed" (ccv `elem` allowedCCVs)
                        )
                    else pure ()

                assertMsg "executor: too many CCVs in message"
                    (length canonicalCCVs <= maxCCVsPerMsg)

                exercise sendingMessageCid CCIP.SendingMessageV1.AddExecutorWithFee with
                    executorInstanceId = instanceId
                    executorArgs = executorArgs
                    blockConfirmations = sm.blockConfirmations
                    feeUSDCents = remoteCfg.feeUSDCents
                    destGasLimit = 0
                    destBytesOverhead = 0
                    caller = owner
