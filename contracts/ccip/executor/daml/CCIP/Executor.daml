module CCIP.Executor where

import DA.Crypto.Text (BytesHex, byteCount)
import DA.Foldable qualified as Foldable
import DA.List (dedup)
import DA.Optional (fromOptional, fromSome, fromSomeNote)
import qualified DA.Map as Map

import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiverView(..))
import MCMS.RawInstanceAddress (RawInstanceAddress, assertValidInstanceId)
import MCMS.Codec (
    encodeBool,
    decodeBoolAt,
    encodeUint16,
    decodeUint16At,
    encodeOptional,
    decodeOptional,
    encodeList,
    decodeList,
    encodeParty,
    decodePartyAt,
    encodeNumeric0,
    decodeNumeric0At,
    )

import qualified CCIP.Context
import qualified CCIP.Interfaces.Executor
import qualified CCIP.SendingMessageV1
import CCIP.Codec(
    encodeRawInstanceAddress,
    decodeRawInstanceAddressAt,
    )
import CCIP.ExecutorTypes (RemoteChainConfig(..), RemoteChainConfigArgs(..), DynamicConfig(..))
import CCIP.ExecutorCodecGen (encodeRemoteChainConfigArgs, decodeRemoteChainConfigArgsAt)

template Executor
    with
        instanceId : Text
        owner : Party
        maxCCVsPerMsg : Int
        dynamicConfig : DynamicConfig
        allowedCCVs : [RawInstanceAddress]
        remoteChainConfigs : Map.Map (Numeric 0) RemoteChainConfig
    where
        signatory owner
        ensure assertValidInstanceId instanceId && maxCCVsPerMsg > 0 && dynamicConfig.minBlockConfirmations >= 0

        interface instance CCIP.Interfaces.Executor.IExecutor for Executor where
            view = CCIP.Interfaces.Executor.ExecutorView with
                instanceId = instanceId
                owner = owner

            executor_calculateFeeImpl self arg = do
                exercise (fromInterfaceContractId @Executor self) CalculateFee with
                    sendingMessageCid = arg.sendingMessageCid
                    executorArgs = arg.executorArgs
                    extraContext = arg.extraContext
                    caller = arg.caller

            executor_getFeeImpl self arg = do
                exercise (fromInterfaceContractId @Executor self) Executor_GetFee with
                    destChainSelector = arg.destChainSelector
                    requiredCCVs = arg.requiredCCVs
                    caller = arg.caller

        choice ApplyDestChainUpdates : ContractId Executor
            with
                destChainSelectorsToRemove : [Numeric 0]
                destChainSelectorsToAdd : [RemoteChainConfigArgs]
            controller owner
            do
                let pruned = foldr Map.delete remoteChainConfigs destChainSelectorsToRemove
                let addConfig acc cfg = Map.insert cfg.destChainSelector cfg.config acc
                let merged = foldl addConfig pruned destChainSelectorsToAdd
                create this with remoteChainConfigs = merged

        choice SetDynamicConfig : ContractId Executor
            with
                newDynamicConfig : DynamicConfig
            controller owner
            do
                assertMsg "executor: minBlockConfirmations must be >= 0"
                    (newDynamicConfig.minBlockConfirmations >= 0)
                create this with dynamicConfig = newDynamicConfig

        choice ApplyAllowedCCVUpdates : ContractId Executor
            with
                ccvsToRemove : [RawInstanceAddress]
                ccvsToAdd : [RawInstanceAddress]
                ccvAllowlistEnabled : Bool
            controller owner
            do
                let kept = filter (\ccv -> not (ccv `elem` ccvsToRemove)) allowedCCVs
                let merged = dedup (kept ++ ccvsToAdd)
                create this with
                    allowedCCVs = merged
                    dynamicConfig = dynamicConfig with
                        ccvAllowlistEnabled = ccvAllowlistEnabled

        nonconsuming choice GetDestChains : [RemoteChainConfigArgs]
            with
                caller : Party
            controller caller
            do
                pure (map (\entry -> RemoteChainConfigArgs with
                        destChainSelector = fst entry
                        config = snd entry
                    ) (Map.toList remoteChainConfigs))

        nonconsuming choice GetDynamicConfig : DynamicConfig
            with
                caller : Party
            controller caller
            do
                pure dynamicConfig

        nonconsuming choice GetAllowedCCVs : [RawInstanceAddress]
            with
                caller : Party
            controller caller
            do
                pure allowedCCVs

        nonconsuming choice GetMaxCCVsPerMessage : Int
            with
                caller : Party
            controller caller
            do
                pure maxCCVsPerMsg

        nonconsuming choice GetMinBlockConfirmations : Int
            with
                caller : Party
            controller caller
            do
                pure dynamicConfig.minBlockConfirmations

        -- Calculates the executor flat fee and validates the message.
        nonconsuming choice CalculateFee : ContractId CCIP.SendingMessageV1.SendingMessageV1
            with
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
                executorArgs : BytesHex
                extraContext : CCIP.Context.CCIPContext
                caller : Party
            controller caller
            do
                sm <- fetch sendingMessageCid

                let remoteCfg = fromSomeNote "executor: unsupported destination chain"
                        (Map.lookup sm.destChainSelector remoteChainConfigs)
                assertMsg "executor: destination chain disabled" remoteCfg.enabled

                let canonicalCCVs = dedup (sm.requiredCCVs ++ fromOptional [] sm.outboundPoolCCVs)

                if dynamicConfig.ccvAllowlistEnabled
                    then Foldable.forA_ canonicalCCVs (\ccv ->
                        assertMsg "executor: CCV not allowed" (ccv `elem` allowedCCVs)
                        )
                    else pure ()

                assertMsg "executor: too many CCVs in message"
                    (length canonicalCCVs <= maxCCVsPerMsg)

                exercise sendingMessageCid CCIP.SendingMessageV1.AddExecutorFee with
                    executorInstanceId = instanceId
                    executorArgs = executorArgs
                    feeUSDCents = remoteCfg.feeUSDCents
                    caller = owner

        -- Quote-only fee path for executor.
        nonconsuming choice Executor_GetFee : CCIP.Interfaces.Executor.ExecutorFeeQuote
            with
                destChainSelector : Numeric 0
                requiredCCVs : [RawInstanceAddress]
                caller : Party
            controller caller
            do
                let remoteCfg = fromSomeNote "executor: unsupported destination chain"
                        (Map.lookup destChainSelector remoteChainConfigs)
                assertMsg "executor: destination chain disabled" remoteCfg.enabled

                let canonicalCCVs = dedup requiredCCVs

                if dynamicConfig.ccvAllowlistEnabled
                    then Foldable.forA_ canonicalCCVs (\ccv ->
                        assertMsg "executor: CCV not allowed" (ccv `elem` allowedCCVs)
                        )
                    else pure ()

                assertMsg "executor: too many CCVs in message"
                    (length canonicalCCVs <= maxCCVsPerMsg)

                pure CCIP.Interfaces.Executor.ExecutorFeeQuote with
                    executorInstanceId = instanceId
                    executorOwner = owner
                    feeUSDCents = remoteCfg.feeUSDCents

        interface instance MCMSReceiver for Executor where
            view = MCMSReceiverView with
                mcmsController = owner
                instanceId = instanceId
            mcmsEntrypoint functionName operationData contractIds = do
                let instAddr = instanceId <> "@" <> partyToText owner
                selfCid <- case Map.lookup instAddr contractIds of
                    None -> abort ("E_SELF_CID_NOT_IN_MAP: " <> instAddr)
                    Some cid -> pure (coerceContractId cid : ContractId Executor)
                
                case functionName of
                    "ApplyDestChainUpdates" -> do
                        case decodeApplyDestChainConfigUpdatesParams operationData of
                            None -> abort "E_INVALID_PARAMS: ApplyDestChainUpdates"
                            Some ((destChainSelectorsToRemove, destChainSelectorsToAdd), finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: ApplyDestChainUpdates" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid ApplyDestChainUpdates with
                                    destChainSelectorsToRemove = destChainSelectorsToRemove
                                    destChainSelectorsToAdd = destChainSelectorsToAdd
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "SetDynamicConfig" -> do
                        case decodeSetDynamicConfigParams operationData of
                            None -> abort "E_INVALID_PARAMS: SetDynamicConfig"
                            Some ((newDynamicConfig), finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: SetDynamicConfig" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid SetDynamicConfig with
                                    newDynamicConfig = newDynamicConfig
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "ApplyAllowedCCVUpdates" -> do
                        case decodeApplyAllowedCCVUpdatesParams operationData of
                            None -> abort "E_INVALID_PARAMS: ApplyAllowedCCVUpdates"
                            Some ((ccvsToRemove, ccvsToAdd, ccvAllowlistEnabled), finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: ApplyAllowedCCVUpdates" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid ApplyAllowedCCVUpdates with
                                    ccvsToRemove = ccvsToRemove
                                    ccvsToAdd = ccvsToAdd
                                    ccvAllowlistEnabled = ccvAllowlistEnabled
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    _ -> abort $ "E_UNKNOWN_FUNCTION: " <> functionName

-- ===============================================
-- |          MCMS Encoding / Decoding           |
-- ===============================================
-- Per-record codecs for RemoteChainConfig and RemoteChainConfigArgs
-- imported from ExecutorCodecGen.

-- ApplyDestChainUpdates

encodeApplyDestChainUpdatesParams : ([Numeric 0], [RemoteChainConfigArgs]) -> BytesHex
encodeApplyDestChainUpdatesParams (destChainSelectorsToRemove, destChainSelectorsToAdd) =
    encodeList destChainSelectorsToRemove encodeNumeric0
    <> encodeList destChainSelectorsToAdd encodeRemoteChainConfigArgs

decodeApplyDestChainConfigUpdatesParams : BytesHex -> Optional (([Numeric 0], [RemoteChainConfigArgs]), Int)
decodeApplyDestChainConfigUpdatesParams encoded = do
    (destChainSelectorsToRemove, offset) <- decodeList encoded 0 decodeNumeric0At
    (destChainSelectorsToAdd, offset) <- decodeList encoded offset decodeRemoteChainConfigArgsAt
    Some ((destChainSelectorsToRemove, destChainSelectorsToAdd), offset)

-- SetDynamicConfig

encodeSetDynamicConfigParams : (DynamicConfig) -> BytesHex
encodeSetDynamicConfigParams newDynamicConfig =
    encodeDynamicConfig newDynamicConfig

encodeDynamicConfig : DynamicConfig -> BytesHex
encodeDynamicConfig dynamicConfig =
    encodeOptional dynamicConfig.feeAggregator encodeParty
    <> fromSome (encodeUint16 dynamicConfig.minBlockConfirmations)
    <> encodeBool dynamicConfig.ccvAllowlistEnabled

decodeSetDynamicConfigParams : BytesHex -> Optional ((DynamicConfig), Int)
decodeSetDynamicConfigParams encoded = do
    (dynamicConfig, offset) <- decodeDynamicConfigAt encoded 0
    Some ((dynamicConfig), offset)

decodeDynamicConfigAt : BytesHex -> Int -> Optional (DynamicConfig, Int)
decodeDynamicConfigAt encoded offset = do
    (feeAggregator, offset) <- decodeOptional encoded offset decodePartyAt
    (minBlockConfirmations, offset) <- decodeUint16At encoded offset
    (ccvAllowlistEnabled, offset) <- decodeBoolAt encoded offset
    Some (DynamicConfig with
            feeAggregator = feeAggregator
            minBlockConfirmations = minBlockConfirmations
            ccvAllowlistEnabled = ccvAllowlistEnabled
        , offset)

-- ApplyAllowedCCVUpdates

encodeApplyAllowedCCVUpdatesParams : ([RawInstanceAddress], [RawInstanceAddress], Bool) -> BytesHex
encodeApplyAllowedCCVUpdatesParams (ccvsToRemove, ccvsToAdd, ccvAllowlistEnabled) =
    encodeList ccvsToRemove encodeRawInstanceAddress
    <> encodeList ccvsToAdd encodeRawInstanceAddress
    <> encodeBool ccvAllowlistEnabled

decodeApplyAllowedCCVUpdatesParams : BytesHex -> Optional (([RawInstanceAddress], [RawInstanceAddress], Bool), Int)
decodeApplyAllowedCCVUpdatesParams encoded = do
    (ccvsToRemove, offset) <- decodeList encoded 0 decodeRawInstanceAddressAt
    (ccvsToAdd, offset) <- decodeList encoded offset decodeRawInstanceAddressAt
    (ccvAllowlistEnabled, offset) <- decodeBoolAt encoded offset
    Some ((ccvsToRemove, ccvsToAdd, ccvAllowlistEnabled), offset)
