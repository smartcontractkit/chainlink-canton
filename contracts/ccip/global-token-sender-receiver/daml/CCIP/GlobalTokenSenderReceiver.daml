-- | Global, Chainlink-operated orchestrator for CCIP token transfers.
--
-- One contract (signatory ccipOwner) is used for all DA Registry token
-- transfers in both directions; users exercise its choices with
-- `caller` = their own party, driving their per-party PerPartyRouter.
-- No per-user orchestrator contract is required.
--
-- The contract only supports pure token transfers (rejects message-only and
-- payload-bearing messages in both directions), and implements the
-- ICCIPSender / ICCIPReceiver client interfaces.
--
-- The orchestration bodies mirror CCIPSender / CCIPReceiver (which are to be
-- deprecated), with the orchestrator's owner party replaced by the per-call
-- `caller` (receiver side: `receiverParty`). This package intentionally does
-- not depend on the sender/receiver packages.
module CCIP.GlobalTokenSenderReceiver where

import DA.Action (foldlA)
import DA.Crypto.Text (BytesHex)
import DA.List (unique)
import DA.Optional (fromSomeNote, isNone)

import qualified Splice.Api.Token.MetadataV1

import qualified Chainlink.InstanceAddress

import qualified CCIP.APIV2.FeeQuoter
import qualified CCIP.APIV2.GlobalConfig
import qualified CCIP.APIV2.RMNRemote
import qualified CCIP.APIV2.TokenAdminRegistry
import qualified CCIP.CodecV2.FinalityConfig
import qualified CCIP.CodecV2.Math
import qualified CCIP.CodecV2.MessageCodecV1
import qualified CCIP.CodecV2.Uint256
import qualified CCIP.Client.Receiver
import qualified CCIP.Client.Sender
import qualified CCIP.ClientV2
import qualified CCIP.InterfacesV2.CrossChainVerifier
import qualified CCIP.InterfacesV2.Executor
import qualified CCIP.InterfacesV2.TokenPool
import qualified CCIP.UtilsV2.Context

lookupVerifierArgs
    : [CCIP.ClientV2.CCVExtraArg]
    -> Chainlink.InstanceAddress.RawInstanceAddress
    -> Update BytesHex
lookupVerifierArgs ccvExtraArgs ccvAddress =
    case filter (\arg -> arg.ccvAddress == ccvAddress) ccvExtraArgs of
        [] -> pure ""
        [arg] -> pure arg.ccvArgs
        _ -> abort "sender: duplicate verifier args for CCV"

assertExactCCVSet
    : [Chainlink.InstanceAddress.RawInstanceAddress]
    -> [Chainlink.InstanceAddress.RawInstanceAddress]
    -> Update ()
assertExactCCVSet requiredCCVs providedCCVs = do
    assertMsg "sender: GetFee required CCVs cannot contain duplicates"
        (unique requiredCCVs)
    assertMsg "sender: GetFee duplicate CCV inputs"
        (unique providedCCVs)
    assertMsg "sender: GetFee missing required CCV"
        (all ((`elem` providedCCVs)) requiredCCVs)
    assertMsg "sender: GetFee unexpected CCV input"
        (all ((`elem` requiredCCVs)) providedCCVs)

validateCCVFeeQuote
    : Chainlink.InstanceAddress.RawInstanceAddress
    -> CCIP.InterfacesV2.CrossChainVerifier.CrossChainVerifierFeeQuote
    -> Update ()
validateCCVFeeQuote expectedCCV quote =
    Chainlink.InstanceAddress.assertEqual
        "sender: GetFee CCV quote address mismatch"
        quote.ccvInstanceId
        quote.ccvOwner
        expectedCCV

template GlobalTokenSenderReceiver
    with
        instanceId : Text
        ccipOwner : Party
        -- Receiver-side policy, baked in at deployment. Inert for token-only
        -- transfers: the token pool decides CCV and finality requirements.
        -- The fields remain because the router's PrepareExecute expects them;
        -- they only become meaningful for message-only executions, which this
        -- contract rejects.
        requiredCCVs : [Chainlink.InstanceAddress.RawInstanceAddress]
        optionalCCVs : [Chainlink.InstanceAddress.RawInstanceAddress]
        optionalThreshold : Int
        receiverFinalityConfig : CCIP.CodecV2.FinalityConfig.FinalityConfig
    where
        signatory ccipOwner
        ensure
            Chainlink.InstanceAddress.assertValidInstanceId instanceId
            && unique requiredCCVs
            && CCIP.CodecV2.FinalityConfig.isValidFinalityConfig receiverFinalityConfig

        -- ===================
        --   Message Sending
        -- ===================

        -- | Query the required CCVs for sending a message.
        nonconsuming choice GetRequiredCCVsForSend : [Chainlink.InstanceAddress.RawInstanceAddress]
            with
                senderParty : Party
                destinationChainSelector : Numeric 0
                message : CCIP.ClientV2.Canton2AnyMessage
                routerCid : ContractId CCIP.ClientV2.PerPartyRouter
                tokenPoolCid : Optional (ContractId CCIP.InterfacesV2.TokenPool.ITokenPool)
                context : Splice.Api.Token.MetadataV1.ChoiceContext
            controller senderParty
            do
                extraArgs <- case message.extraArgs of
                    CCIP.ClientV2.V3 v3 -> pure v3
                poolReportedCCVs <- case (message.tokenTransfer, tokenPoolCid) of
                    (None, None) -> pure []
                    (None, Some _) ->
                        abort "sender: tokenPoolCid provided without token transfer"
                    (Some _, None) ->
                        abort "sender: tokenPoolCid required for token transfer"
                    (Some tt, Some tokenPoolCid) -> do
                        let sourceAmount = fromSomeNote
                                "sender: token amount does not fit uint256"
                                (CCIP.CodecV2.Uint256.numeric0ToUint256Bytes (CCIP.CodecV2.Math.decimalToNumeric0 tt.amount))
                        exercise tokenPoolCid
                            CCIP.InterfacesV2.TokenPool.TokenPool_GetRequiredCCVs with
                                remoteChainSelector = destinationChainSelector
                                sourceAmount = sourceAmount
                                finality = CCIP.CodecV2.FinalityConfig.waitForFinalityFlag
                                extraData = extraArgs.tokenArgs
                                direction = CCIP.InterfacesV2.TokenPool.Outbound
                                context = context
                                caller = senderParty

                exercise routerCid CCIP.ClientV2.PerPartyRouter_GetRequiredCCVsForSend with
                    context = context
                    destChainSelector = destinationChainSelector
                    message = message
                    poolReportedCCVs = poolReportedCCVs

        -- | Quote the fees for sending a message.
        nonconsuming choice GetFee : CCIP.Client.Sender.SenderGetFeeResult
            with
                senderParty : Party
                destinationChainSelector : Numeric 0
                message : CCIP.ClientV2.Canton2AnyMessage
                routerCid : ContractId CCIP.ClientV2.PerPartyRouter
                ccvSendInputs : [CCIP.Client.Sender.SenderCCVSendInput]
                tokenTransferInput : Optional CCIP.Client.Sender.SenderTokenTransferInput
                executorInput : Optional CCIP.Client.Sender.SenderExecutorInput
                context : Splice.Api.Token.MetadataV1.ChoiceContext
            controller senderParty
            do
                -- Payload-bearing messages are rejected (token transfers only).
                assertMsg "sender: payload-bearing messages are rejected" (message.payload == "")

                feeQuoterCid : ContractId CCIP.APIV2.FeeQuoter.IFeeQuoter <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.FeeQuoter.feeQuoterContextKey
                globalConfigCid : ContractId CCIP.APIV2.GlobalConfig.IGlobalConfig <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.GlobalConfig.globalConfigContextKey
                extraArgs <- case message.extraArgs of
                    CCIP.ClientV2.V3 v3 -> pure v3
                destConfigOpt <- exercise globalConfigCid
                    CCIP.APIV2.GlobalConfig.GlobalConfig_GetDestChainConfig with
                        destChainSelector = destinationChainSelector
                        context = Splice.Api.Token.MetadataV1.emptyChoiceContext
                        caller = senderParty
                destConfig <- case destConfigOpt of
                    None -> abort "sender: unknown destination chain"
                    Some cfg -> pure cfg
                requiredCCVs <- exercise self GetRequiredCCVsForSend with
                    senderParty = senderParty
                    destinationChainSelector = destinationChainSelector
                    message = message
                    context = context
                    routerCid = routerCid
                    tokenPoolCid = case tokenTransferInput of
                        None -> None
                        Some input -> Some input.tokenPoolCid

                let providedCCVs = map (.ccvAddress) ccvSendInputs
                assertExactCCVSet requiredCCVs providedCCVs

                quotedCCVFees <- foldlA (\fees input -> do
                    q <- exercise input.ccvCid CCIP.InterfacesV2.CrossChainVerifier.CrossChainVerifier_GetFee with
                        destChainSelector = destinationChainSelector
                        context = Splice.Api.Token.MetadataV1.emptyChoiceContext
                        caller = senderParty
                    validateCCVFeeQuote input.ccvAddress q
                    pure (fees ++ [q])
                    ) [] ccvSendInputs

                (quotedTokenSendFee, poolFeeBps) <- case (message.tokenTransfer, tokenTransferInput) of
                    (None, None) -> pure (None, 0.0)
                    (None, Some _) ->
                        abort "sender: tokenTransferInput provided without token transfer"
                    (Some _, None) ->
                        abort "sender: tokenTransferInput required for token transfer"
                    (Some tt, Some tokenTransferInput) -> do
                        q <- exercise tokenTransferInput.tokenPoolCid CCIP.InterfacesV2.TokenPool.TokenPool_GetFee with
                            feeQuoterCid = feeQuoterCid
                            destChainSelector = destinationChainSelector
                            tokenInstrumentId = tt.token
                            context = tokenTransferInput.context
                            caller = senderParty
                        pure (Some q, q.tokenFeeBps)
                executorFeeQuote <- case extraArgs.executor of
                    CCIP.ClientV2.Executor_NoExecutor -> do
                        assertMsg "sender: executorInput not allowed for no-executor mode"
                            (isNone executorInput)
                        pure None
                    CCIP.ClientV2.Executor_UseDefault _executorArgs ->
                      case destConfig.defaultExecutor of
                        None -> do
                            assertMsg "sender: executorInput not allowed when no default executor is configured"
                                (isNone executorInput)
                            pure None
                        Some expectedExecutor -> case executorInput of
                            None -> abort "sender: executorInput required for default executor mode"
                            Some executorInput -> do
                                q <- exercise executorInput.executorCid CCIP.InterfacesV2.Executor.Executor_GetFee with
                                    expectedExecutor = expectedExecutor
                                    destChainSelector = destinationChainSelector
                                    requiredCCVs = requiredCCVs
                                    context = executorInput.context
                                    caller = senderParty
                                Chainlink.InstanceAddress.assertEqual "sender: executor fee quote executor mismatch"
                                    q.executorInstanceId q.executorOwner expectedExecutor
                                pure (Some q)
                    CCIP.ClientV2.Executor_WithAddress expectedExecutor _executorArgs ->
                      case executorInput of
                        None -> abort "sender: executorInput required for explicit executor mode"
                        Some executorInput -> do
                            q <- exercise executorInput.executorCid CCIP.InterfacesV2.Executor.Executor_GetFee with
                                expectedExecutor = expectedExecutor
                                destChainSelector = destinationChainSelector
                                requiredCCVs = requiredCCVs
                                context = executorInput.context
                                caller = senderParty
                            Chainlink.InstanceAddress.assertEqual "sender: executor fee quote executor mismatch"
                                q.executorInstanceId q.executorOwner expectedExecutor
                            pure (Some q)

                quote <- exercise routerCid CCIP.ClientV2.PerPartyRouter_GetFee with
                    context = context
                    destChainSelector = destinationChainSelector
                    message = message
                    ccvFeeQuotes = quotedCCVFees
                    tokenPoolFeeQuote = quotedTokenSendFee
                    executorFeeQuote = executorFeeQuote

                pure CCIP.Client.Sender.SenderGetFeeResult with
                    feeResult = quote
                    poolQuote = quotedTokenSendFee

        -- | Send a message. Only pure token transfers are supported.
        nonconsuming choice Send : CCIP.ClientV2.CCIPSendResult
            with
                senderParty : Party
                destinationChainSelector : Numeric 0
                message : CCIP.ClientV2.Canton2AnyMessage
                routerCid : ContractId CCIP.ClientV2.PerPartyRouter
                feeTokenInput : CCIP.Client.Sender.SenderFeeTokenInput
                ccvSendInputs : [CCIP.Client.Sender.SenderCCVSendInput]
                tokenTransferInput : Optional CCIP.Client.Sender.SenderTokenTransferInput
                executorInput : Optional CCIP.Client.Sender.SenderExecutorInput
                context : Splice.Api.Token.MetadataV1.ChoiceContext
            controller senderParty
            do
                -- Payload-bearing messages are rejected (token transfers only).
                assertMsg "sender: payload-bearing messages are rejected" (message.payload == "")

                feeQuoterCid : ContractId CCIP.APIV2.FeeQuoter.IFeeQuoter <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.FeeQuoter.feeQuoterContextKey
                globalConfigCid : ContractId CCIP.APIV2.GlobalConfig.IGlobalConfig <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.GlobalConfig.globalConfigContextKey
                rmnRemoteCid : ContractId CCIP.APIV2.RMNRemote.IRMNRemote <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.RMNRemote.rmnRemoteContextKey
                tokenAdminRegistryCid : ContractId CCIP.APIV2.TokenAdminRegistry.ITokenAdminRegistry <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.TokenAdminRegistry.tokenAdminRegistryContextKey

                extraArgs <- case message.extraArgs of
                    CCIP.ClientV2.V3 v3 -> pure v3
                destConfigOpt <- exercise globalConfigCid
                    CCIP.APIV2.GlobalConfig.GlobalConfig_GetDestChainConfig with
                        destChainSelector = destinationChainSelector
                        context = Splice.Api.Token.MetadataV1.emptyChoiceContext
                        caller = senderParty
                destConfig <- case destConfigOpt of
                    None -> abort "sender: unknown destination chain"
                    Some cfg -> pure cfg

                smCid <- exercise routerCid CCIP.ClientV2.PerPartyRouter_PrepareSend with
                        destinationChainSelector = destinationChainSelector
                        message = message
                        context = context

                smCid <- case message.tokenTransfer of
                    None -> do
                        assertMsg "sender: tokenTransferInput provided without token transfer"
                            (isNone tokenTransferInput)
                        pure smCid
                    Some tt -> case tokenTransferInput of
                        None -> abort "sender: tokenTransferInput required for token transfer"
                        Some tokenTransferInput -> do
                            tokenConfigCid <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.TokenAdminRegistry.tokenConfigContextKey
                            exercise tokenTransferInput.tokenPoolCid CCIP.InterfacesV2.TokenPool.TokenPool_VerifyOutboundCCVs with
                                tokenAdminRegistryCid = tokenAdminRegistryCid
                                tokenConfigCid = tokenConfigCid
                                context = tokenTransferInput.context
                                sendingMessageCid = smCid
                                amount = tt.amount
                                caller = senderParty

                smCid <- foldlA (\cid input -> do
                    exercise input.ccvCid
                        CCIP.InterfacesV2.CrossChainVerifier.CrossChainVerifier_CalculateFee with
                            sendingMessageCid = cid
                            context = input.context
                            caller = senderParty
                    ) smCid ccvSendInputs

                smCid <- case (message.tokenTransfer, tokenTransferInput) of
                    (None, None) -> pure smCid
                    (None, Some _) ->
                        abort "sender: tokenTransferInput provided without token transfer"
                    (Some _, None) ->
                        abort "sender: tokenTransferInput required for token transfer"
                    (Some tt, Some tokenTransferInput) -> do
                        tokenConfigCid <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.TokenAdminRegistry.tokenConfigContextKey
                        exercise tokenTransferInput.tokenPoolCid CCIP.InterfacesV2.TokenPool.TokenPool_CalculateFee with
                            tokenAdminRegistryCid = tokenAdminRegistryCid
                            tokenConfigCid = tokenConfigCid
                            context = tokenTransferInput.context
                            sendingMessageCid = smCid
                            feeQuoterCid = feeQuoterCid
                            tokenInstrumentId = tt.token
                            caller = senderParty

                smCid <- case extraArgs.executor of
                    CCIP.ClientV2.Executor_NoExecutor -> do
                        assertMsg "sender: executorInput not allowed for no-executor mode"
                            (isNone executorInput)
                        pure smCid
                    CCIP.ClientV2.Executor_UseDefault executorArgs ->
                      case destConfig.defaultExecutor of
                        None -> do
                            assertMsg "sender: executorInput not allowed when no default executor is configured"
                                (isNone executorInput)
                            pure smCid
                        Some expectedExecutor ->
                            case executorInput of
                                None -> abort "sender: executorInput required for default executor mode"
                                Some executorInput -> do
                                    exercise executorInput.executorCid
                                        CCIP.InterfacesV2.Executor.Executor_CalculateFee with
                                            expectedExecutor = expectedExecutor
                                            sendingMessageCid = smCid
                                            executorArgs = executorArgs
                                            context = executorInput.context
                                            caller = senderParty
                    CCIP.ClientV2.Executor_WithAddress expectedExecutor executorArgs ->
                      case executorInput of
                        None -> abort "sender: executorInput required for explicit executor mode"
                        Some executorInput -> do
                            exercise executorInput.executorCid
                                CCIP.InterfacesV2.Executor.Executor_CalculateFee with
                                    expectedExecutor = expectedExecutor
                                    sendingMessageCid = smCid
                                    executorArgs = executorArgs
                                    context = executorInput.context
                                    caller = senderParty

                smCid <- exercise routerCid CCIP.ClientV2.PerPartyRouter_FinalizeFee with
                    context
                    sendingMessageCid = smCid

                smCid <- case (message.tokenTransfer, tokenTransferInput) of
                    (None, None) -> pure smCid
                    (None, Some _) ->
                        abort "sender: tokenTransferInput provided without token transfer"
                    (Some _, None) ->
                        abort "sender: tokenTransferInput required for token transfer"
                    (Some tt, Some tokenTransferInput) -> do
                        tokenConfigCid <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.TokenAdminRegistry.tokenConfigContextKey
                        lockResult <- exercise tokenTransferInput.tokenPoolCid CCIP.InterfacesV2.TokenPool.TokenPool_LockOrBurn with
                            tokenAdminRegistryCid = tokenAdminRegistryCid
                            tokenConfigCid = tokenConfigCid
                            rmnRemoteCid = rmnRemoteCid
                            context = tokenTransferInput.context
                            sendingMessageCid = smCid
                            senderInputCids = tokenTransferInput.senderInputCids
                            amount = tt.amount
                            caller = senderParty
                        pure (lockResult.sendingMessageCid)

                smCid <- foldlA (\cid input -> do
                        verifierArgs <- lookupVerifierArgs extraArgs.ccvs input.ccvAddress
                        exercise input.ccvCid
                            CCIP.InterfacesV2.CrossChainVerifier.CrossChainVerifier_ForwardToVerifier with
                                rmnRemoteCid = rmnRemoteCid
                                context = input.context
                                sendingMessageCid = cid
                                verifierArgs = verifierArgs
                                caller = senderParty
                        ) (smCid) ccvSendInputs

                exercise routerCid CCIP.ClientV2.PerPartyRouter_CCIPSend with
                    context
                    sendingMessageCid = smCid
                    feeTokenHoldingCids = feeTokenInput.senderInputCids
                    feeTokenConfigCid = feeTokenInput.feeTokenConfigCid
                    feeTokenTransferFactory = feeTokenInput.feeTokenTransferFactory
                    feeTokenExtraArgs = feeTokenInput.feeTokenExtraArgs

        -- =====================
        --   Message Execution
        -- =====================

        -- | Query the final required CCVs for executing an inbound message.
        nonconsuming choice GetRequiredCCVsForExecute : [Chainlink.InstanceAddress.RawInstanceAddress]
            with
                receiverParty : Party
                routerCid : ContractId CCIP.ClientV2.PerPartyRouter
                encodedMessage : BytesHex
                tokenPoolCid : Optional (ContractId CCIP.InterfacesV2.TokenPool.ITokenPool)
                context : Splice.Api.Token.MetadataV1.ChoiceContext
            controller receiverParty
            do
                let message = fromSomeNote "receiver: failed to decode message"
                        (CCIP.CodecV2.MessageCodecV1.decodeMessageV1 encodedMessage)

                tokenPoolRequiredCCVs <- case (message.tokenTransfer, tokenPoolCid) of
                    (None, None) -> pure []
                    (None, Some _) ->
                        abort "receiver: tokenPoolCid provided without token transfer"
                    (Some _, None) ->
                        abort "receiver: tokenPoolCid required for token transfer"
                    (Some tt, Some poolCid) ->
                        let tokenExtraData : BytesHex = tt.extraData
                        in
                        exercise poolCid
                            CCIP.InterfacesV2.TokenPool.TokenPool_GetRequiredCCVs with
                                remoteChainSelector = message.sourceChainSelector
                                sourceAmount = tt.amount
                                finality = message.finality.raw
                                extraData = tokenExtraData
                                direction = CCIP.InterfacesV2.TokenPool.Inbound
                                context = context
                                caller = receiverParty

                exercise routerCid CCIP.ClientV2.PerPartyRouter_GetRequiredCCVsForExecute with
                    context = context
                    message = message
                    receiverRequiredCCVs = requiredCCVs
                    receiverOptionalCCVs = optionalCCVs
                    receiverOptionalThreshold = optionalThreshold
                    tokenPoolRequiredCCVs = tokenPoolRequiredCCVs

        -- | Execute an inbound message end-to-end. Only pure token transfers
        -- are supported; no contract is created by this choice.
        nonconsuming choice Execute : CCIP.Client.Receiver.ReceiverExecuteResult
            with
                -- Who the message is addressed to; the OffRamp asserts
                -- message.receiver == encodePartyAddress(receiverParty), so
                -- the caller cannot redirect execution to a party of their
                -- choosing.
                receiverParty : Party
                routerCid : ContractId CCIP.ClientV2.PerPartyRouter
                encodedMessage : BytesHex
                -- Includes tokenReceiverParty; also validated against the
                -- message by the OffRamp.
                tokenTransfer : Optional CCIP.Client.Receiver.ReceiverTokenTransferInput
                ccvInputs : [CCIP.Client.Receiver.ReceiverCCVInput]
                context : Splice.Api.Token.MetadataV1.ChoiceContext
            controller receiverParty
            do
                -- Message-only and payload-bearing messages are rejected
                -- (pure token transfers only).
                tokenTransfer <- pure (fromSomeNote "receiver: message-only messages are rejected"
                    tokenTransfer)
                let message = fromSomeNote "receiver: failed to decode message"
                        (CCIP.CodecV2.MessageCodecV1.decodeMessageV1 encodedMessage)
                -- Mirrors the OffRamp's definition of a pure token transfer.
                assertMsg "receiver: payload-bearing messages are rejected"
                    (message.messageData == "" && message.ccipReceiveGasLimit == 0)

                rmnRemoteCid : ContractId CCIP.APIV2.RMNRemote.IRMNRemote <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.RMNRemote.rmnRemoteContextKey
                tokenAdminRegistryCid : ContractId CCIP.APIV2.TokenAdminRegistry.ITokenAdminRegistry <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.TokenAdminRegistry.tokenAdminRegistryContextKey

                -- PrepareExecute: decode, validate, create ExecutingMessageV1
                emCid <- exercise routerCid CCIP.ClientV2.PerPartyRouter_PrepareExecute with
                    context = context
                    encodedMessage = encodedMessage
                    receiverParty = receiverParty
                    tokenReceiverParty = Some tokenTransfer.tokenReceiverParty
                    receiverRequiredCCVs = requiredCCVs
                    receiverOptionalCCVs = optionalCCVs
                    receiverOptionalThreshold = optionalThreshold
                    receiverFinalityConfig = receiverFinalityConfig
                    caller = receiverParty

                -- Token transfers must resolve pool CCVs before any CCV can contribute.
                tokenConfigCid <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.TokenAdminRegistry.tokenConfigContextKey
                emCid <- exercise tokenTransfer.tokenPoolCid
                    CCIP.InterfacesV2.TokenPool.TokenPool_VerifyInboundMessage with
                        tokenAdminRegistryCid = tokenAdminRegistryCid
                        tokenConfigCid = tokenConfigCid
                        context = tokenTransfer.context
                        executingMessageCid = emCid
                        caller = receiverParty

                -- CCV verification: thread executingMessageCid through each CCV
                emCid <- foldlA (\cid input ->
                    exercise input.ccvCid
                        CCIP.InterfacesV2.CrossChainVerifier.CrossChainVerifier_VerifyMessage with
                            rmnRemoteCid = rmnRemoteCid
                            context = input.context
                            executingMessageCid = cid
                            verifierResults = input.verifierResults
                            caller = receiverParty
                    ) emCid ccvInputs

                -- Execute with the final executingMessageCid
                result <- exercise routerCid CCIP.ClientV2.PerPartyRouter_Execute with
                    context = context
                    executingMessageCid = emCid

                -- Token release
                ticketCid <- case result.tokenReceiveTicket of
                    None -> abort "receiver: router did not return a token receive ticket for a token transfer"
                    Some ticketCid -> pure ticketCid
                tokenReleaseResult <- exercise tokenTransfer.tokenPoolCid CCIP.InterfacesV2.TokenPool.TokenPool_ReleaseFromTicket with
                    tokenAdminRegistryCid = tokenAdminRegistryCid
                    tokenConfigCid = tokenConfigCid
                    rmnRemoteCid = rmnRemoteCid
                    context = tokenTransfer.context
                    tokenReceiveTicketCid = ticketCid
                    caller = receiverParty

                pure CCIP.Client.Receiver.ReceiverExecuteResult with
                    router = result.router
                    messageId = result.messageId
                    message = result.message
                    state = result.state
                    tokenReleaseResult = Some tokenReleaseResult
                    context = context

        -- ====================
        --   Client Interfaces
        -- ====================

        interface instance CCIP.Client.Sender.ICCIPSender for GlobalTokenSenderReceiver where
            view = CCIP.Client.Sender.ICCIPSenderView with
                ccipOwner = ccipOwner

            iccipSender_getRequiredCCVsImpl self arg = exercise (fromInterfaceContractId @GlobalTokenSenderReceiver self) GetRequiredCCVsForSend with
                senderParty = arg.senderParty
                destinationChainSelector = arg.destinationChainSelector
                message = arg.message
                routerCid = arg.routerCid
                tokenPoolCid = arg.tokenPoolCid
                context = arg.context

            iccipSender_getFeeImpl self arg = exercise (fromInterfaceContractId @GlobalTokenSenderReceiver self) GetFee with
                senderParty = arg.senderParty
                destinationChainSelector = arg.destinationChainSelector
                message = arg.message
                routerCid = arg.routerCid
                ccvSendInputs = arg.ccvSendInputs
                tokenTransferInput = arg.tokenTransferInput
                executorInput = arg.executorInput
                context = arg.context

            iccipSender_sendImpl self arg = exercise (fromInterfaceContractId @GlobalTokenSenderReceiver self) Send with
                senderParty = arg.senderParty
                destinationChainSelector = arg.destinationChainSelector
                message = arg.message
                routerCid = arg.routerCid
                feeTokenInput = arg.feeTokenInput
                ccvSendInputs = arg.ccvSendInputs
                tokenTransferInput = arg.tokenTransferInput
                executorInput = arg.executorInput
                context = arg.context

        interface instance CCIP.Client.Receiver.ICCIPReceiver for GlobalTokenSenderReceiver where
            view = CCIP.Client.Receiver.ICCIPReceiverView with
                ccipOwner = ccipOwner
                requiredCCVs = requiredCCVs
                receiverFinalityConfig = receiverFinalityConfig

            iccipReceiver_getRequiredCCVsImpl self arg = exercise (fromInterfaceContractId @GlobalTokenSenderReceiver self) GetRequiredCCVsForExecute with
                receiverParty = arg.receiverParty
                routerCid = arg.routerCid
                encodedMessage = arg.encodedMessage
                tokenPoolCid = arg.tokenPoolCid
                context = arg.context

            iccipReceiver_executeImpl self arg = exercise (fromInterfaceContractId @GlobalTokenSenderReceiver self) Execute with
                receiverParty = arg.receiverParty
                routerCid = arg.routerCid
                encodedMessage = arg.encodedMessage
                tokenTransfer = arg.tokenTransfer
                ccvInputs = arg.ccvInputs
                context = arg.context
