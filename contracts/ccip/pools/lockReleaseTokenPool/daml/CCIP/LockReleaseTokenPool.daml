-- | Lock/release token pool for CCIP token transfers.
--
-- Supports Splice token standard patterns where TransferFactory implementations
-- may look up preapproval from extraArgs.context (e.g., Amulet's ExternalPartyAmuletRules
-- uses "transfer-preapproval" key). The pool stores a poolReceiveContext that gets
-- merged into extraArgs for inbound transfers, enabling direct transfers without
-- pending state when the pool has preapproval.
module CCIP.LockReleaseTokenPool where

import DA.Crypto.Text (BytesHex)
import DA.Foldable (forA_)
import qualified DA.Map as Map
import DA.Optional (fromOptional, fromSomeNote)
import qualified DA.TextMap as TextMap
import DA.Date (date, Month(Dec))
import DA.Time (time, addRelTime, hours)

import qualified Splice.Api.Token.HoldingV1
import qualified Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.TransferInstructionV1

import qualified CCIP.ExecutingMessageV1
import qualified CCIP.Interfaces.TokenPool
import qualified CCIP.MessageCodecV1
import CCIP.RawInstanceAddress (RawInstanceAddress)
import qualified CCIP.RawInstanceAddress
import qualified CCIP.RMNRemote
import qualified CCIP.SendingMessageV1
import qualified CCIP.Tickets
import qualified CCIP.TokenAdminRegistry

-- | Far-future time used as "never expires" for pending transfers.
-- Matches Splice's maxTime pattern: https://github.com/hyperledger-labs/splice/blob/139ee12335f61851d7cbf540a4b56c80622c911f/daml/splice-amulet/daml/Splice/Expiry.daml#L125
maxTime : Time
maxTime = time (date 9999 Dec 31) 23 59 59

-- | Transfer timeout configuration for pending TransferInstructions.
-- Some tokens (e.g., Amulet) have expiry constraints and reject transfers with
-- executeBefore times beyond the token's expiry. Use RelativeHours for such tokens.
-- Tokens without expiry (e.g., TestToken) can use Indefinite.
data TransferTimeout
    = Indefinite          -- Use maxTime (year 9999) - for tokens without expiry
    | RelativeHours Int   -- Use now + N hours - for tokens with expiry constraints
    deriving (Eq, Show)

-- | Per-chain CCV requirements for the pool.
-- This partially matches the EVM pattern in AdvancedPoolHooks.sol which is primarily based on chain selector:
-- https://github.com/smartcontractkit/chainlink-ccip/blob/afc2e9e58c953fbdeee724ac5fae021155ca6325/chains/evm/contracts/pools/AdvancedPoolHooks.sol#L235
data ChainCCVConfig = ChainCCVConfig
    with
        inboundCCVs : [RawInstanceAddress]   -- Required CCVs for incoming transfers
        outboundCCVs : [RawInstanceAddress]  -- Required CCVs for outgoing transfers
    deriving (Eq, Show)

-- | Per-chain fee config for outbound pool fee calculation.
data PoolFeeConfig = PoolFeeConfig
    with
        feeUSDCents : Decimal
        destGasOverhead : Int
        destBytesOverhead : Int
    deriving (Eq, Show)

-- | Lock/release token pool with dynamic CCV requirements per chain.
-- Performs best-effort RMN curse checks via disclosed RMNRemote contract.
-- The pool cannot validate the RMN instance address (not a stakeholder);
-- OnRamp/OffRamp/PrepareExecute perform the authoritative identity + curse checks.
template LockReleaseTokenPool
    with
        instanceId : Text  -- Unique identifier for this pool instance
        ccipOwner : Party
        poolOwner : Party
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        decimals : Int
        -- CCV requirements per remote chain selector
        chainCCVRequirements : Map.Map (Numeric 0) ChainCCVConfig
        -- Fee config per remote chain selector
        chainFeeConfigs : Map.Map (Numeric 0) PoolFeeConfig
        -- Destination token address per remote chain, matching EVM's getRemoteToken()
        remoteTokens : Map.Map (Numeric 0) BytesHex
        -- Context merged into extraArgs for transfers TO the pool (LockOrBurn).
        -- For tokens following Splice patterns (e.g., Amulet), this should contain
        -- the pool's preapproval CID under the key the TransferFactory expects
        -- (e.g., "transfer-preapproval"). Enables direct transfers without pending state.
        poolReceiveContext : Splice.Api.Token.MetadataV1.ChoiceContext
        -- Timeout for pending TransferInstructions created by this pool.
        transferTimeout : TransferTimeout
    where
        signatory poolOwner

        interface instance CCIP.Interfaces.TokenPool.ITokenPool for LockReleaseTokenPool where
            view = CCIP.Interfaces.TokenPool.TokenPoolView with
                owner = poolOwner
                ccipOwner = ccipOwner
                instrumentId = instrumentId

            tokenPool_getRequiredCCVsImpl self arg = do
                exercise (fromInterfaceContractId @LockReleaseTokenPool self) LockReleaseTokenPool_GetRequiredCCVs
                    with
                        remoteChainSelector = arg.remoteChainSelector
                        amount = arg.amount
                        finality = arg.finality
                        extraData = arg.extraData
                        direction = arg.direction
                        caller = arg.caller

            tokenPool_verifyInboundCCVsImpl self arg = do
                exercise (fromInterfaceContractId @LockReleaseTokenPool self) LockReleaseTokenPool_VerifyInboundCCVs
                    with
                        executingMessageCid = arg.executingMessageCid
                        tokenAdminRegistryCid = arg.tokenAdminRegistryCid
                        caller = arg.caller

            tokenPool_releaseFromTicketImpl self arg = do
                exercise (fromInterfaceContractId @LockReleaseTokenPool self) LockReleaseTokenPool_ReleaseFromTicket
                    with
                        tokenReceiveTicketCid = arg.tokenReceiveTicketCid
                        tokenAdminRegistryCid = arg.tokenAdminRegistryCid
                        rmnRemoteCid = arg.rmnRemoteCid
                        tokenInput = arg.tokenInput
                        caller = arg.caller

            tokenPool_lockOrBurnImpl self arg = do
                exercise (fromInterfaceContractId @LockReleaseTokenPool self) LockReleaseTokenPool_LockOrBurn
                    with
                        sendingMessageCid = arg.sendingMessageCid
                        tokenInput = arg.tokenInput
                        senderInputCids = arg.senderInputCids
                        amount = arg.amount
                        rmnRemoteCid = arg.rmnRemoteCid
                        caller = arg.caller

            tokenPool_calculateFeeImpl self arg = do
                exercise (fromInterfaceContractId @LockReleaseTokenPool self) LockReleaseTokenPool_CalculateFee
                    with
                        sendingMessageCid = arg.sendingMessageCid
                        caller = arg.caller

        -- Get required CCV raw instance addresses based on chain and direction.
        nonconsuming choice LockReleaseTokenPool_GetRequiredCCVs : [RawInstanceAddress]
            with
                remoteChainSelector : Numeric 0
                amount : Numeric 0
                finality : Int
                extraData : BytesHex
                direction : CCIP.Interfaces.TokenPool.TransferDirection
                caller : Party
            controller caller
            do
                case Map.lookup remoteChainSelector chainCCVRequirements of
                    None -> pure []
                    Some config -> case direction of
                        CCIP.Interfaces.TokenPool.Inbound -> pure config.inboundCCVs
                        CCIP.Interfaces.TokenPool.Outbound -> pure config.outboundCCVs

        -- Verify inbound CCVs and mark pool verification on ExecutingMessageV1.
        -- Validates that the message has a token transfer targeting this pool's instrument,
        -- then checks the ccvVerifications list against the pool's per-chain inbound CCV
        -- requirements.
        nonconsuming choice LockReleaseTokenPool_VerifyInboundCCVs : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
            with
                executingMessageCid : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
                tokenAdminRegistryCid : ContractId CCIP.TokenAdminRegistry.TokenAdminRegistry
                caller : Party
            controller caller
            do
                execMsg <- fetch executingMessageCid
                let message = execMsg.message

                -- Must have a token transfer
                tt <- case message.tokenTransfer of
                    None -> abort "pool: no token transfer in message"
                    Some t -> pure t

                -- Validate destTokenAddress matches this pool's instrumentId
                let expectedAddr = CCIP.MessageCodecV1.encodeInstrumentId instrumentId
                assertMsg "pool: destTokenAddress does not match pool instrumentId"
                    (tt.destTokenAddress == expectedAddr)

                let requiredAddrs = case Map.lookup message.sourceChainSelector chainCCVRequirements of
                        None -> []
                        Some config -> config.inboundCCVs

                -- Validate pool's required CCVs against ccvVerifications on ExecutingMessageV1
                let coveredAddrs = [CCIP.RawInstanceAddress.make v.ccvInstanceId v.ccvOwner | v <- execMsg.ccvVerifications]
                forA_ requiredAddrs $ \required ->
                    assertMsg ("pool: missing required CCV " <> show required)
                        (required `elem` coveredAddrs)

                exercise tokenAdminRegistryCid
                    CCIP.TokenAdminRegistry.TokenAdminRegistry_MarkPoolCCVsVerified with
                        executingMessageCid
                        poolInstanceId = instanceId
                        caller = poolOwner

        -- Release tokens by consuming a TokenReceiveTicket via TokenAdminRegistry.
        -- The TAR validates the ticket was issued by the correct registry instance,
        -- the pool is the registered pool for the instrument, and archives the ticket
        -- atomically. If any check fails, the entire transaction rolls back.
        nonconsuming choice LockReleaseTokenPool_ReleaseFromTicket : CCIP.Interfaces.TokenPool.ReleaseOrMintResult
            with
                tokenReceiveTicketCid : ContractId CCIP.Tickets.TokenReceiveTicket
                tokenAdminRegistryCid : ContractId CCIP.TokenAdminRegistry.TokenAdminRegistry
                rmnRemoteCid : ContractId CCIP.RMNRemote.RMNRemote
                tokenInput : CCIP.Interfaces.TokenPool.TokenInput
                caller : Party
            controller caller
            do
                -- Best-effort RMN curse check for the source chain (matches EVM
                -- TokenPool._validateReleaseOrMint). The pool cannot validate
                -- the RMN instance address (not a stakeholder); PrepareExecute
                -- performs the authoritative identity + curse check.
                ticket <- fetch tokenReceiveTicketCid
                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = poolOwner
                    chainSelector = ticket.sourceChainSelector
                assertMsg "ReleaseFromTicket: source chain is cursed" (not isCursed)

                assertMsg "ReleaseFromTicket: caller must be tokenReceiver"
                    (caller == ticket.tokenReceiver)

                -- Consume ticket via TAR. The TAR validates the ticket was issued by
                -- the correct registry instance and archives it. The TAR is not fetchable
                -- by the pool (visibility), but the caller discloses it.
                exercise tokenAdminRegistryCid
                    CCIP.TokenAdminRegistry.TokenAdminRegistry_ConsumeReceiveTicket with
                        ticketCid = tokenReceiveTicketCid
                        instrumentId = instrumentId
                        caller = poolOwner

                -- Transfer tokens from pool to receiver via TransferFactory.
                -- If receiver has preapproval, completes immediately. Otherwise creates pending
                -- TransferInstruction that receiver must accept.
                now <- getTime
                let executeBefore = case transferTimeout of
                        Indefinite -> maxTime
                        RelativeHours h -> addRelTime now (hours h)
                let amountDecimal : Decimal = intToDecimal (truncate ticket.amount)
                let transfer = Splice.Api.Token.TransferInstructionV1.Transfer with
                        sender = poolOwner
                        receiver = ticket.tokenReceiver
                        amount = amountDecimal
                        instrumentId = instrumentId
                        requestedAt = now
                        executeBefore
                        inputHoldingCids = tokenInput.tokenPoolHoldings
                        meta = Splice.Api.Token.MetadataV1.emptyMetadata

                transferResult <- exercise tokenInput.transferFactory
                    Splice.Api.Token.TransferInstructionV1.TransferFactory_Transfer with
                        expectedAdmin = instrumentId.admin
                        transfer
                        extraArgs = tokenInput.extraArgs

                case transferResult.output of
                    Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Completed receiverCids ->
                        pure CCIP.Interfaces.TokenPool.ReleaseOrMintResult with
                            output = CCIP.Interfaces.TokenPool.ReleaseOrMintResult_Completed with
                                receiverHoldingCids = receiverCids
                            poolChangeCids = transferResult.senderChangeCids
                    Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Pending instrCid ->
                        pure CCIP.Interfaces.TokenPool.ReleaseOrMintResult with
                            output = CCIP.Interfaces.TokenPool.ReleaseOrMintResult_Pending with
                                transferInstructionCid = instrCid
                            poolChangeCids = transferResult.senderChangeCids
                    _ -> abort "ReleaseFromTicket: unexpected failed transfer"

        -- Update chain CCV requirements.
        choice LockReleaseTokenPool_UpdateChainCCVRequirements : ContractId LockReleaseTokenPool
            with
                newChainCCVRequirements : Map.Map (Numeric 0) ChainCCVConfig
            controller poolOwner
            do
                create this with chainCCVRequirements = newChainCCVRequirements

        -- Calculate fee for outbound token transfer (USD cents only).
        -- Reads destChainSelector from SendingMessageV1, looks up per-chain
        -- fee config, appends fee directly to SendingMessageV1.
        nonconsuming choice LockReleaseTokenPool_CalculateFee
                : ContractId CCIP.SendingMessageV1.SendingMessageV1
            with
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
                caller : Party
            controller caller
            do
                sendingMsg <- fetch sendingMessageCid
                let feeConfig = fromSomeNote "no pool fee config for dest chain"
                        (Map.lookup sendingMsg.destChainSelector chainFeeConfigs)

                exercise sendingMessageCid
                    CCIP.SendingMessageV1.AddTokenSendFee with
                        poolInstanceId = instanceId
                        poolOwner = poolOwner
                        feeUSDCents = feeConfig.feeUSDCents
                        destGasOverhead = feeConfig.destGasOverhead
                        destBytesOverhead = feeConfig.destBytesOverhead
                        caller = poolOwner

        -- Lock tokens for outbound transfer and append token send data.
        -- Reads from SendingMessageV1 instead of taking separate params.
        -- Passes pool's outbound CCV requirements to AddTokenSend for
        -- merging into the unified requiredCCVs list.
        nonconsuming choice LockReleaseTokenPool_LockOrBurn : CCIP.Interfaces.TokenPool.LockOrBurnResult
            with
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
                tokenInput : CCIP.Interfaces.TokenPool.TokenInput
                senderInputCids : [ContractId Splice.Api.Token.HoldingV1.Holding]
                amount : Numeric 0
                rmnRemoteCid : ContractId CCIP.RMNRemote.RMNRemote
                caller : Party
            controller caller, poolOwner
            do
                sendingMsg <- fetch sendingMessageCid

                -- Best-effort RMN curse check
                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = poolOwner
                    chainSelector = sendingMsg.destChainSelector
                assertMsg "LockOrBurn: dest chain is cursed" (not isCursed)

                let poolRequiredCCVs = case Map.lookup sendingMsg.destChainSelector chainCCVRequirements of
                        None -> []
                        Some config -> config.outboundCCVs

                let destTokenAddr = fromSomeNote
                        "LockOrBurn: no remote token for dest chain"
                        (Map.lookup sendingMsg.destChainSelector remoteTokens)

                let destPoolData = CCIP.MessageCodecV1.encodeUint256 (intToNumeric decimals)

                let mergedContext = Splice.Api.Token.MetadataV1.ChoiceContext with
                        values = TextMap.union poolReceiveContext.values tokenInput.extraArgs.context.values
                let mergedExtraArgs = tokenInput.extraArgs with context = mergedContext
                now <- getTime
                let executeBefore = case transferTimeout of
                        Indefinite -> maxTime
                        RelativeHours h -> addRelTime now (hours h)
                let amountDecimal : Decimal = intToDecimal (truncate amount)
                let transfer = Splice.Api.Token.TransferInstructionV1.Transfer with
                        sender = caller
                        receiver = poolOwner
                        amount = amountDecimal
                        instrumentId = instrumentId
                        requestedAt = now
                        executeBefore
                        inputHoldingCids = senderInputCids
                        meta = Splice.Api.Token.MetadataV1.emptyMetadata

                transferResult <- exercise tokenInput.transferFactory
                    Splice.Api.Token.TransferInstructionV1.TransferFactory_Transfer with
                        expectedAdmin = instrumentId.admin
                        transfer
                        extraArgs = mergedExtraArgs

                -- AddTokenSend merges poolRequiredCCVs into the unified CCV list
                -- and constructs MessageV1 from SendingMessageV1 fields.
                -- OnRamp cross-validates pool identity against TAR at CCIPSend.
                let extraData = fromOptional "" destPoolData
                newSendingMessageCid <- exercise sendingMessageCid
                    CCIP.SendingMessageV1.AddTokenSend with
                        poolInstanceId = instanceId
                        poolOwner = poolOwner
                        instrumentId = instrumentId
                        amount = amount
                        destTokenAddress = destTokenAddr
                        extraData = extraData
                        poolRequiredCCVs = poolRequiredCCVs
                        caller = poolOwner

                case transferResult.output of
                    Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Completed
                            receiverCids ->
                        pure CCIP.Interfaces.TokenPool.LockOrBurnResult with
                            poolChangeCids = receiverCids ++ tokenInput.tokenPoolHoldings
                            senderChangeCids = transferResult.senderChangeCids
                            sendingMessageCid = newSendingMessageCid
                    _ -> abort "LockOrBurn: transfer did not complete directly"

