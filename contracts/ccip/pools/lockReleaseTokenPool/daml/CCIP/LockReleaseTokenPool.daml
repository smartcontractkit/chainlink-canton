-- | Lock/release token pool for CCIP token transfers.
--
-- Supports Splice token standard patterns where TransferFactory implementations
-- may look up preapproval from extraArgs.context (e.g., Amulet's ExternalPartyAmuletRules
-- uses "transfer-preapproval" key). The pool stores a poolReceiveContext that gets
-- merged into extraArgs for inbound transfers, enabling direct transfers without
-- pending state when the pool has preapproval.
module CCIP.LockReleaseTokenPool
  ( module CCIP.LockReleaseTokenPool
  , module CCIP.LockReleaseTokenPoolTypes
  ) where

import DA.Crypto.Text (BytesHex)
import DA.Foldable qualified as Foldable
import DA.List (dedup)
import qualified DA.Map as Map
import DA.Optional (fromOptional, fromSomeNote)
import qualified DA.TextMap as TextMap
import DA.Date (date, Month(Dec))
import DA.Time (time, addRelTime, hours)

import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiverView(..))
import CCIP.LockReleaseTokenPoolCodec (decodeUpdateChainPoolConfigsParams)
import CCIP.LockReleaseTokenPoolTypes (ChainPoolConfig(..))

import qualified Splice.Api.Token.HoldingV1
import qualified Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.TransferInstructionV1

import qualified CCIP.Context
import qualified CCIP.ExecutingMessageV1
import qualified CCIP.Interfaces.TokenPool
import qualified CCIP.MessageCodecV1
import qualified CCIP.RateLimiter
import CCIP.RawInstanceAddress (RawInstanceAddress)
import qualified CCIP.RawInstanceAddress
import qualified CCIP.RMNRemote
import qualified CCIP.SendingMessageV1
import qualified CCIP.Tickets
import qualified CCIP.TokenAdminRegistry

-- | Far-future time used as "never expires" for pending transfers.
-- Matches Splice's maxTime pattern: https://github.com/hyperledger-labs/splice/blob/139ee12335f61851d7cbf540a4b56c80622c911f/daml/splice-amulet/daml/Splice/Expiry.daml#L125
maxTime : Time
maxTime = time (date 9999 Dec 31) 23 59 59

-- | Transfer timeout configuration for pending TransferInstructions.
-- Some tokens (e.g., Amulet) have expiry constraints and reject transfers with
-- executeBefore times beyond the token's expiry. Use RelativeHours for such tokens.
-- Tokens without expiry (e.g., TestToken) can use Indefinite.
data TransferTimeout
    = Indefinite          -- Use maxTime (year 9999) - for tokens without expiry
    | RelativeHours Int   -- Use now + N hours - for tokens with expiry constraints
    deriving (Eq, Show)

-- ChainPoolConfig is imported from CCIP.LockReleaseTokenPoolTypes

-- | Per-chain fee config for outbound pool fee calculation.
data PoolFeeConfig = PoolFeeConfig
    with
        feeUSDCents : Decimal
        destGasOverhead : Int
        destBytesOverhead : Int
    deriving (Eq, Show)

parseSourcePoolDecimals : Int -> BytesHex -> Int
parseSourcePoolDecimals localDecimals sourcePoolData =
    if sourcePoolData == ""
    then localDecimals
    else
        let decoded = fromSomeNote
                "ReleaseFromTicket: invalid source pool decimals"
                (CCIP.MessageCodecV1.decodeUint256 sourcePoolData)
            remoteDecimals = truncate decoded
        in
            if decoded < 0.0 || decoded > 255.0
            then error "ReleaseFromTicket: invalid source pool decimals"
            else remoteDecimals

calculateLocalAmountDecimal : Decimal -> Int -> Int -> Decimal
calculateLocalAmountDecimal remoteAmount remoteDecimals localDecimals =
    if remoteDecimals == localDecimals
    then remoteAmount
    else
        let decimalsDiff = abs (remoteDecimals - localDecimals)
            scaleFactor = intToDecimal (10 ^ decimalsDiff)
        in
            if remoteDecimals > localDecimals
            then intToDecimal (truncate (remoteAmount / scaleFactor))
            else remoteAmount * scaleFactor

-- | Convert CCIP AnyValue to Splice AnyValue at TransferFactory boundary.
toSpliceAnyValue : CCIP.Context.AnyValue -> Splice.Api.Token.MetadataV1.AnyValue
toSpliceAnyValue (CCIP.Context.AV_Text t) = Splice.Api.Token.MetadataV1.AV_Text t
toSpliceAnyValue (CCIP.Context.AV_Int i) = Splice.Api.Token.MetadataV1.AV_Int i
toSpliceAnyValue (CCIP.Context.AV_Decimal d) = Splice.Api.Token.MetadataV1.AV_Decimal d
toSpliceAnyValue (CCIP.Context.AV_Bool b) = Splice.Api.Token.MetadataV1.AV_Bool b
toSpliceAnyValue (CCIP.Context.AV_Date d) = Splice.Api.Token.MetadataV1.AV_Date d
toSpliceAnyValue (CCIP.Context.AV_Time t) = Splice.Api.Token.MetadataV1.AV_Time t
toSpliceAnyValue (CCIP.Context.AV_RelTime r) = Splice.Api.Token.MetadataV1.AV_RelTime r
toSpliceAnyValue (CCIP.Context.AV_Party p) = Splice.Api.Token.MetadataV1.AV_Party p
toSpliceAnyValue (CCIP.Context.AV_ContractId c) = Splice.Api.Token.MetadataV1.AV_ContractId (coerceContractId c)
toSpliceAnyValue (CCIP.Context.AV_List xs) = Splice.Api.Token.MetadataV1.AV_List (map toSpliceAnyValue xs)
toSpliceAnyValue (CCIP.Context.AV_Map m) = Splice.Api.Token.MetadataV1.AV_Map (TextMap.fromList (map (\(k, v) -> (k, toSpliceAnyValue v)) (TextMap.toList m)))

-- | Convert CCIPContext to Splice ChoiceContext for TransferFactory calls.
toSpliceChoiceContext : CCIP.Context.CCIPContext -> Splice.Api.Token.MetadataV1.ChoiceContext
toSpliceChoiceContext ctx = Splice.Api.Token.MetadataV1.ChoiceContext with
    values = TextMap.fromList (map (\(k, v) -> (k, toSpliceAnyValue v)) (TextMap.toList ctx.values))

assertRateLimiter
    : Text
    -> Text
    -> Numeric 0
    -> CCIP.RateLimiter.RateLimitDirection
    -> CCIP.RateLimiter.RateLimitMode
    -> CCIP.RawInstanceAddress.RawInstanceAddress
    -> CCIP.RateLimiter.RateLimiter
    -> Update ()
assertRateLimiter prefix poolInstanceId remoteChainSelector direction mode expected limiter = do
    CCIP.RawInstanceAddress.assertEqual (prefix <> ": instance address mismatch")
        limiter.instanceId
        limiter.poolOwner
        expected
    assertMsg (prefix <> ": pool instance mismatch")
        (limiter.poolInstanceId == poolInstanceId)
    assertMsg (prefix <> ": remote chain mismatch")
        (limiter.remoteChainSelector == remoteChainSelector)
    assertMsg (prefix <> ": direction mismatch")
        (limiter.direction == direction)
    assertMsg (prefix <> ": rate limit mode mismatch")
        (limiter.mode == mode)

-- | Lock/release token pool with dynamic CCV requirements per chain.
-- Performs best-effort RMN curse checks via disclosed RMNRemote contract.
-- The pool cannot validate the RMN instance address (not a stakeholder);
-- OnRamp/OffRamp/PrepareExecute perform the authoritative identity + curse checks.
template LockReleaseTokenPool
    with
        instanceId : Text  -- Unique identifier for this pool instance
        ccipOwner : Party
        poolOwner : Party
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        decimals : Int
        -- Per-chain pool config: CCV requirements and allowed remote pools
        chainPoolConfigs : Map.Map (Numeric 0) ChainPoolConfig
        -- Fee config per remote chain selector
        chainFeeConfigs : Map.Map (Numeric 0) PoolFeeConfig
        -- Destination token address per remote chain, matching EVM's getRemoteToken()
        remoteTokens : Map.Map (Numeric 0) BytesHex
        -- Expected outbound rate limiter identity per destination chain.
        outboundRateLimiters : Map.Map (Numeric 0) RawInstanceAddress
        -- Expected inbound rate limiter identity per source chain.
        inboundRateLimiters : Map.Map (Numeric 0) RawInstanceAddress
        -- Expected inbound rate limiter identity per source chain for FTF/custom-finality transfers.
        inboundCustomRateLimiters : Map.Map (Numeric 0) RawInstanceAddress
        -- Context merged into extraArgs for transfers TO the pool (LockOrBurn).
        -- For tokens following Splice patterns (e.g., Amulet), this should contain
        -- the pool's preapproval CID under the key the TransferFactory expects
        -- (e.g., "transfer-preapproval"). Converted to Splice ChoiceContext at the
        -- TransferFactory boundary.
        poolReceiveContext : CCIP.Context.CCIPContext
        -- Timeout for pending TransferInstructions created by this pool.
        transferTimeout : TransferTimeout
    where
        signatory poolOwner

        interface instance MCMSReceiver for LockReleaseTokenPool where
          view = MCMSReceiverView with
            owner = poolOwner
            instanceId

          mcmsEntrypoint functionName operationData contractIds = do
            let instAddr = instanceId <> "@" <> partyToText poolOwner
            selfCid <- case Map.lookup instAddr contractIds of
              None -> abort $ "E_SELF_CID_NOT_IN_MAP: " <> instAddr
              Some cid -> pure (coerceContractId cid : ContractId LockReleaseTokenPool)

            case functionName of
              "UpdateChainPoolConfigs" -> do
                case decodeUpdateChainPoolConfigsParams operationData of
                  None -> abort "E_INVALID_PARAMS: UpdateChainPoolConfigs"
                  Some newChainPoolConfigs -> do
                    newCid <- exercise selfCid LockReleaseTokenPool_UpdateChainPoolConfigs with
                      newChainPoolConfigs
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              _ -> abort $ "E_UNKNOWN_FUNCTION: " <> functionName

        interface instance CCIP.Interfaces.TokenPool.ITokenPool for LockReleaseTokenPool where
            view = CCIP.Interfaces.TokenPool.TokenPoolView with
                owner = poolOwner
                ccipOwner = ccipOwner
                instrumentId = instrumentId

            tokenPool_getRequiredCCVsImpl self arg = do
                exercise (fromInterfaceContractId @LockReleaseTokenPool self) LockReleaseTokenPool_GetRequiredCCVs
                    with
                        remoteChainSelector = arg.remoteChainSelector
                        amount = arg.amount
                        finality = arg.finality
                        extraData = arg.extraData
                        direction = arg.direction
                        caller = arg.caller

            tokenPool_verifyInboundMessageImpl self arg = do
                exercise (fromInterfaceContractId @LockReleaseTokenPool self) LockReleaseTokenPool_VerifyInboundMessage
                    with
                        tokenAdminRegistryCid = arg.tokenAdminRegistryCid
                        extraContext = arg.extraContext
                        executingMessageCid = arg.executingMessageCid
                        caller = arg.caller

            tokenPool_verifyOutboundCCVsImpl self arg = do
                exercise (fromInterfaceContractId @LockReleaseTokenPool self) LockReleaseTokenPool_VerifyOutboundCCVs
                    with
                        tokenAdminRegistryCid = arg.tokenAdminRegistryCid
                        extraContext = arg.extraContext
                        sendingMessageCid = arg.sendingMessageCid
                        amount = arg.amount
                        caller = arg.caller

            tokenPool_releaseFromTicketImpl self arg = do
                exercise (fromInterfaceContractId @LockReleaseTokenPool self) LockReleaseTokenPool_ReleaseFromTicket
                    with
                        tokenAdminRegistryCid = arg.tokenAdminRegistryCid
                        rmnRemoteCid = arg.rmnRemoteCid
                        extraContext = arg.extraContext
                        tokenReceiveTicketCid = arg.tokenReceiveTicketCid
                        tokenInput = arg.tokenInput
                        caller = arg.caller

            tokenPool_lockOrBurnImpl self arg = do
                exercise (fromInterfaceContractId @LockReleaseTokenPool self) LockReleaseTokenPool_LockOrBurn
                    with
                        rmnRemoteCid = arg.rmnRemoteCid
                        extraContext = arg.extraContext
                        sendingMessageCid = arg.sendingMessageCid
                        tokenInput = arg.tokenInput
                        senderInputCids = arg.senderInputCids
                        amount = arg.amount
                        caller = arg.caller

            tokenPool_calculateFeeImpl self arg = do
                exercise (fromInterfaceContractId @LockReleaseTokenPool self) LockReleaseTokenPool_CalculateFee
                    with
                        sendingMessageCid = arg.sendingMessageCid
                        caller = arg.caller

        -- Get required CCV raw instance addresses based on chain and direction.
        nonconsuming choice LockReleaseTokenPool_GetRequiredCCVs : [RawInstanceAddress]
            with
                remoteChainSelector : Numeric 0
                amount : Numeric 0
                finality : Int
                extraData : BytesHex
                direction : CCIP.Interfaces.TokenPool.TransferDirection
                caller : Party
            controller caller
            do
                case Map.lookup remoteChainSelector chainPoolConfigs of
                    None -> pure []
                    Some config -> case direction of
                        CCIP.Interfaces.TokenPool.Inbound -> pure config.inboundCCVs
                        CCIP.Interfaces.TokenPool.Outbound -> pure config.outboundCCVs

        -- Validate inbound token transfer message and record pool CCV requirements.
        -- Validates that the message has a token transfer targeting this pool's instrument,
        -- validates the source pool address against the allowed remote pools for the source chain,
        -- looks up per-chain CCV requirements, and records them on the executing message.
        -- OffRamp performs the actual CCV coverage check.
        nonconsuming choice LockReleaseTokenPool_VerifyInboundMessage : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
            with
                tokenAdminRegistryCid : ContractId CCIP.TokenAdminRegistry.TokenAdminRegistry
                extraContext : CCIP.Context.CCIPContext
                executingMessageCid : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
                caller : Party
            controller caller
            do
                execMsg <- fetch executingMessageCid
                let message = execMsg.message

                tt <- case message.tokenTransfer of
                    None -> abort "pool: no token transfer in message"
                    Some t -> pure t

                let expectedAddr = CCIP.MessageCodecV1.encodeInstrumentId instrumentId
                assertMsg "pool: destTokenAddress does not match pool instrumentId"
                    (tt.destTokenAddress == expectedAddr)

                chainCfg <- case Map.lookup message.sourceChainSelector chainPoolConfigs of
                    None -> abort "pool: unsupported source chain"
                    Some cfg -> pure cfg

                if chainCfg.minBlockDepth == 0
                    then assertMsg "pool: finalized-only pool rejects FTF messages"
                        (message.finality == 0)
                    else assertMsg "pool: message finality below pool minBlockDepth"
                        (message.finality > 0 && message.finality >= chainCfg.minBlockDepth)

                assertMsg "pool: invalid sourcePoolAddress"
                    (tt.sourcePoolAddress `elem` chainCfg.remotePools)

                exercise tokenAdminRegistryCid
                    CCIP.TokenAdminRegistry.TokenAdminRegistry_SetInboundPoolCCVs with
                        executingMessageCid
                        poolInstanceId = instanceId
                        poolCCVs = chainCfg.inboundCCVs
                        caller = poolOwner

        -- Declare outbound CCV requirements on SendingMessageV1 via TAR.
        -- Looks up per-chain CCV requirements and records them on the sending message.
        nonconsuming choice LockReleaseTokenPool_VerifyOutboundCCVs : ContractId CCIP.SendingMessageV1.SendingMessageV1
            with
                tokenAdminRegistryCid : ContractId CCIP.TokenAdminRegistry.TokenAdminRegistry
                extraContext : CCIP.Context.CCIPContext
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
                amount : Numeric 0
                caller : Party
            controller caller
            do
                -- TODO: Replace fetch with nonconsuming getter choice on SendingMessageV1.
                sm <- fetch sendingMessageCid

                let poolCCVs = case Map.lookup sm.destChainSelector chainPoolConfigs of
                        None -> []
                        Some cfg -> cfg.outboundCCVs

                exercise tokenAdminRegistryCid
                    CCIP.TokenAdminRegistry.TokenAdminRegistry_SetOutboundPoolCCVs with
                        sendingMessageCid = sendingMessageCid
                        poolInstanceId = instanceId
                        poolCCVs = poolCCVs
                        caller = poolOwner

        -- Release tokens by consuming a TokenReceiveTicket via TokenAdminRegistry.
        -- The TAR validates the ticket was issued by the correct registry instance,
        -- the pool is the registered pool for the instrument, and archives the ticket
        -- atomically. If any check fails, the entire transaction rolls back.
        nonconsuming choice LockReleaseTokenPool_ReleaseFromTicket : CCIP.Interfaces.TokenPool.ReleaseOrMintResult
            with
                tokenAdminRegistryCid : ContractId CCIP.TokenAdminRegistry.TokenAdminRegistry
                rmnRemoteCid : ContractId CCIP.RMNRemote.RMNRemote
                extraContext : CCIP.Context.CCIPContext
                tokenReceiveTicketCid : ContractId CCIP.Tickets.TokenReceiveTicket
                tokenInput : CCIP.Interfaces.TokenPool.TokenInput
                caller : Party
            controller caller
            do
                -- Best-effort RMN curse check for the source chain (matches EVM
                -- TokenPool._validateReleaseOrMint). The pool cannot validate
                -- the RMN instance address (not a stakeholder); PrepareExecute
                -- performs the authoritative identity + curse check.
                ticket <- fetch tokenReceiveTicketCid

                -- Best-effort RMN curse check
                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = poolOwner
                    chainSelector = ticket.sourceChainSelector
                assertMsg "ReleaseFromTicket: source chain is cursed" (not isCursed)

                assertMsg "ReleaseFromTicket: caller must be tokenReceiver"
                    (caller == ticket.tokenReceiver)

                -- Validate required pool CCV owner signatories are present on the ticket.
                -- This is the pool's local security check: it rejects forged tickets
                -- that lack the CCV-owner authorization the pool requires.
                let ticketSignatories = signatory ticket
                sourceCfg <- case Map.lookup ticket.sourceChainSelector chainPoolConfigs of
                    None -> abort "ReleaseFromTicket: unsupported source chain"
                    Some cfg -> pure cfg
                let requiredPoolOwners = dedup (map CCIP.RawInstanceAddress.ownerParty sourceCfg.inboundCCVs)
                Foldable.forA_ requiredPoolOwners $ \requiredOwner ->
                    assertMsg ("ReleaseFromTicket: missing required pool CCV owner " <> show requiredOwner)
                        (requiredOwner `elem` ticketSignatories)

                let isFTF = ticket.finality > 0
                let expectedRateLimiterMap = if isFTF then inboundCustomRateLimiters else inboundRateLimiters
                let expectedRateLimitMode = if isFTF
                        then CCIP.RateLimiter.RateLimitMode_CustomFinality
                        else CCIP.RateLimiter.RateLimitMode_DefaultFinality
                expectedRateLimiter <- case Map.lookup ticket.sourceChainSelector expectedRateLimiterMap of
                    None -> abort (if isFTF
                        then "ReleaseFromTicket: no custom-finality inbound rate limiter configured for source chain"
                        else "ReleaseFromTicket: no inbound rate limiter configured for source chain")
                    Some limiter -> pure limiter
                rateLimiterCid <- CCIP.RateLimiter.lookupRateLimiterCid extraContext
                rateLimiter <- fetch rateLimiterCid
                assertRateLimiter
                    "ReleaseFromTicket: rateLimiter"
                    instanceId
                    ticket.sourceChainSelector
                    CCIP.RateLimiter.RateLimitDirection_Inbound
                    expectedRateLimitMode
                    expectedRateLimiter
                    rateLimiter
                _ <- exercise rateLimiterCid CCIP.RateLimiter.ConsumeCapacity with
                    requested = ticket.amount

                -- Consume ticket via TAR. The TAR validates the ticket was issued by
                -- the correct registry instance and archives it. The TAR is not fetchable
                -- by the pool (visibility), but the caller discloses it.
                exercise tokenAdminRegistryCid
                    CCIP.TokenAdminRegistry.TokenAdminRegistry_ConsumeReceiveTicket with
                        ticketCid = tokenReceiveTicketCid
                        instrumentId = instrumentId
                        caller = poolOwner

                -- Transfer tokens from pool to receiver via TransferFactory.
                -- If receiver has preapproval, completes immediately. Otherwise creates pending
                -- TransferInstruction that receiver must accept.
                now <- getTime
                let executeBefore = case transferTimeout of
                        Indefinite -> maxTime
                        RelativeHours h -> addRelTime now (hours h)
                let sourceDecimals = parseSourcePoolDecimals decimals ticket.sourcePoolData
                let amountDecimal = calculateLocalAmountDecimal
                        (intToDecimal (truncate ticket.amount))
                        sourceDecimals
                        decimals
                let transfer = Splice.Api.Token.TransferInstructionV1.Transfer with
                        sender = poolOwner
                        receiver = ticket.tokenReceiver
                        amount = amountDecimal
                        instrumentId = instrumentId
                        requestedAt = now
                        executeBefore
                        inputHoldingCids = tokenInput.tokenPoolHoldings
                        meta = Splice.Api.Token.MetadataV1.emptyMetadata

                transferResult <- exercise tokenInput.transferFactory
                    Splice.Api.Token.TransferInstructionV1.TransferFactory_Transfer with
                        expectedAdmin = instrumentId.admin
                        transfer
                        extraArgs = tokenInput.extraArgs

                case transferResult.output of
                    Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Completed receiverCids ->
                        pure CCIP.Interfaces.TokenPool.ReleaseOrMintResult with
                            output = CCIP.Interfaces.TokenPool.ReleaseOrMintResult_Completed with
                                receiverHoldingCids = receiverCids
                            poolChangeCids = transferResult.senderChangeCids
                    Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Pending instrCid ->
                        pure CCIP.Interfaces.TokenPool.ReleaseOrMintResult with
                            output = CCIP.Interfaces.TokenPool.ReleaseOrMintResult_Pending with
                                transferInstructionCid = instrCid
                            poolChangeCids = transferResult.senderChangeCids
                    _ -> abort "ReleaseFromTicket: unexpected failed transfer"

        -- Update per-chain pool configuration (CCV requirements and remote pools).
        choice LockReleaseTokenPool_UpdateChainPoolConfigs : ContractId LockReleaseTokenPool
            with
                newChainPoolConfigs : Map.Map (Numeric 0) ChainPoolConfig
            controller poolOwner
            do
                create this with chainPoolConfigs = newChainPoolConfigs

        choice LockReleaseTokenPool_UpdateRateLimiters : ContractId LockReleaseTokenPool
            with
                newOutboundRateLimiters : Map.Map (Numeric 0) RawInstanceAddress
                newInboundRateLimiters : Map.Map (Numeric 0) RawInstanceAddress
                newInboundCustomRateLimiters : Map.Map (Numeric 0) RawInstanceAddress
            controller poolOwner
            do
                create this with
                    outboundRateLimiters = newOutboundRateLimiters
                    inboundRateLimiters = newInboundRateLimiters
                    inboundCustomRateLimiters = newInboundCustomRateLimiters

        -- Calculate fee for outbound token transfer (USD cents only).
        -- Reads destChainSelector from SendingMessageV1, looks up per-chain
        -- fee config, appends fee directly to SendingMessageV1.
        nonconsuming choice LockReleaseTokenPool_CalculateFee
                : ContractId CCIP.SendingMessageV1.SendingMessageV1
            with
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
                caller : Party
            controller caller
            do
                -- TODO: Replace fetch with nonconsuming getter choice on SendingMessageV1.
                sendingMsg <- fetch sendingMessageCid
                let feeConfig = fromSomeNote "no pool fee config for dest chain"
                        (Map.lookup sendingMsg.destChainSelector chainFeeConfigs)

                exercise sendingMessageCid
                    CCIP.SendingMessageV1.AddTokenSendFee with
                        poolInstanceId = instanceId
                        poolOwner = poolOwner
                        feeUSDCents = feeConfig.feeUSDCents
                        destGasOverhead = feeConfig.destGasOverhead
                        destBytesOverhead = feeConfig.destBytesOverhead
                        caller = poolOwner

        -- Lock tokens for outbound transfer and append token send data.
        -- Reads from SendingMessageV1 instead of taking separate params.
        -- Requires ccvAndExecutorHash to be finalized by the executor step before this runs.
        nonconsuming choice LockReleaseTokenPool_LockOrBurn : CCIP.Interfaces.TokenPool.LockOrBurnResult
            with
                rmnRemoteCid : ContractId CCIP.RMNRemote.RMNRemote
                extraContext : CCIP.Context.CCIPContext
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
                tokenInput : CCIP.Interfaces.TokenPool.TokenInput
                senderInputCids : [ContractId Splice.Api.Token.HoldingV1.Holding]
                amount : Numeric 0
                caller : Party
            controller caller, poolOwner
            do
                -- TODO: Replace fetch with nonconsuming getter choice on SendingMessageV1.
                sendingMsg <- fetch sendingMessageCid

                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = poolOwner
                    chainSelector = sendingMsg.destChainSelector
                assertMsg "LockOrBurn: dest chain is cursed" (not isCursed)

                let destTokenAddr = fromSomeNote
                        "LockOrBurn: no remote token for dest chain"
                        (Map.lookup sendingMsg.destChainSelector remoteTokens)

                let destPoolData = CCIP.MessageCodecV1.encodeUint256 (intToNumeric decimals)

                expectedRateLimiter <- case Map.lookup sendingMsg.destChainSelector outboundRateLimiters of
                    None -> abort "LockOrBurn: no outbound rate limiter configured for dest chain"
                    Some limiter -> pure limiter
                rateLimiterCid <- CCIP.RateLimiter.lookupRateLimiterCid extraContext
                rateLimiter <- fetch rateLimiterCid
                assertRateLimiter
                    "LockOrBurn: rateLimiter"
                    instanceId
                    sendingMsg.destChainSelector
                    CCIP.RateLimiter.RateLimitDirection_Outbound
                    CCIP.RateLimiter.RateLimitMode_DefaultFinality
                    expectedRateLimiter
                    rateLimiter
                _ <- exercise rateLimiterCid CCIP.RateLimiter.ConsumeCapacity with
                    requested = amount

                -- Convert pool's CCIPContext to Splice ChoiceContext at TransferFactory boundary.
                let splicePoolCtx = toSpliceChoiceContext poolReceiveContext
                let mergedContext = Splice.Api.Token.MetadataV1.ChoiceContext with
                        values = TextMap.union splicePoolCtx.values tokenInput.extraArgs.context.values
                let mergedExtraArgs = tokenInput.extraArgs with context = mergedContext
                now <- getTime
                let executeBefore = case transferTimeout of
                        Indefinite -> maxTime
                        RelativeHours h -> addRelTime now (hours h)
                let amountDecimal : Decimal = intToDecimal (truncate amount)
                let transfer = Splice.Api.Token.TransferInstructionV1.Transfer with
                        sender = caller
                        receiver = poolOwner
                        amount = amountDecimal
                        instrumentId = instrumentId
                        requestedAt = now
                        executeBefore
                        inputHoldingCids = senderInputCids
                        meta = Splice.Api.Token.MetadataV1.emptyMetadata

                transferResult <- exercise tokenInput.transferFactory
                    Splice.Api.Token.TransferInstructionV1.TransferFactory_Transfer with
                        expectedAdmin = instrumentId.admin
                        transfer
                        extraArgs = mergedExtraArgs

                let extraData = fromOptional "" destPoolData
                newSendingMessageCid <- exercise sendingMessageCid
                    CCIP.SendingMessageV1.AddTokenSend with
                        poolInstanceId = instanceId
                        poolOwner = poolOwner
                        instrumentId = instrumentId
                        amount = amount
                        destTokenAddress = destTokenAddr
                        extraData = extraData
                        caller = poolOwner

                case transferResult.output of
                    Splice.Api.Token.TransferInstructionV1.TransferInstructionResult_Completed
                            receiverCids ->
                        pure CCIP.Interfaces.TokenPool.LockOrBurnResult with
                            poolChangeCids = receiverCids ++ tokenInput.tokenPoolHoldings
                            senderChangeCids = transferResult.senderChangeCids
                            sendingMessageCid = newSendingMessageCid
                    _ -> abort "LockOrBurn: transfer did not complete directly"
