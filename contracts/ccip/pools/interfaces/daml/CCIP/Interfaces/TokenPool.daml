module CCIP.Interfaces.TokenPool where

import DA.Crypto.Text (BytesHex)

import qualified Splice.Api.Token.HoldingV1
import qualified Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.TransferInstructionV1

import qualified CCIP.ExecutingMessageV1
import CCIP.RawInstanceAddress (RawInstanceAddress)
import qualified CCIP.RMNRemote
import qualified CCIP.SendingMessageV1
import qualified CCIP.Tickets
import qualified CCIP.TokenAdminRegistry

-- | Direction of token transfer for CCV requirement lookup.
data TransferDirection = Outbound | Inbound
    deriving (Eq, Show)


interface ITokenPool where
    viewtype TokenPoolView

    tokenPool_getRequiredCCVsImpl : ContractId ITokenPool -> TokenPool_GetRequiredCCVs -> Update [RawInstanceAddress]
    tokenPool_verifyInboundCCVsImpl : ContractId ITokenPool -> TokenPool_VerifyInboundCCVs -> Update (ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1)
    tokenPool_verifyOutboundCCVsImpl : ContractId ITokenPool -> TokenPool_VerifyOutboundCCVs -> Update (ContractId CCIP.SendingMessageV1.SendingMessageV1)
    tokenPool_releaseFromTicketImpl : ContractId ITokenPool -> TokenPool_ReleaseFromTicket -> Update ReleaseOrMintResult
    tokenPool_lockOrBurnImpl : ContractId ITokenPool -> TokenPool_LockOrBurn -> Update LockOrBurnResult
    tokenPool_calculateFeeImpl : ContractId ITokenPool -> TokenPool_CalculateFee -> Update (ContractId CCIP.SendingMessageV1.SendingMessageV1)

    -- Get required CCV raw instance addresses for a transfer based on direction, amount, finality, etc.
    nonconsuming choice TokenPool_GetRequiredCCVs : [RawInstanceAddress]
        with
            remoteChainSelector : Numeric 0
            amount : Numeric 0
            finality : Int
            extraData : BytesHex
            direction : TransferDirection
            caller : Party
        controller caller
        do tokenPool_getRequiredCCVsImpl this self arg

    -- Verify inbound CCVs and mark pool verification on ExecutingMessageV1 via TAR.
    nonconsuming choice TokenPool_VerifyInboundCCVs : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
        with
            context : Splice.Api.Token.MetadataV1.ChoiceContext
            executingMessageCid : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
            caller : Party
        controller caller
        do tokenPool_verifyInboundCCVsImpl this self arg

    -- Verify outbound CCVs and record pool-required CCVs on SendingMessageV1 via TAR.
    nonconsuming choice TokenPool_VerifyOutboundCCVs : ContractId CCIP.SendingMessageV1.SendingMessageV1
        with
            context : Splice.Api.Token.MetadataV1.ChoiceContext
            sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
            amount : Numeric 0
            tokenArgs : BytesHex
            caller : Party
        controller caller
        do tokenPool_verifyOutboundCCVsImpl this self arg

    -- Release tokens by consuming a TokenReceiveTicket issued by OffRamp.
    -- The pool should consume the ticket via TokenAdminRegistry_ConsumeReceiveTicket.
    nonconsuming choice TokenPool_ReleaseFromTicket : ReleaseOrMintResult
        with
            context : Splice.Api.Token.MetadataV1.ChoiceContext
            tokenReceiveTicketCid : ContractId CCIP.Tickets.TokenReceiveTicket
            tokenInput : TokenInput
            caller : Party
        controller caller
        do tokenPool_releaseFromTicketImpl this self arg

    -- Lock/burn tokens for outbound transfer. The pool is the source of
    -- truth for the locked amount, which it records via SendingMessageV1.AddTokenSend.
    nonconsuming choice TokenPool_LockOrBurn : LockOrBurnResult
        with
            context : Splice.Api.Token.MetadataV1.ChoiceContext
            sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
            tokenInput : TokenInput
            senderInputCids : [ContractId Splice.Api.Token.HoldingV1.Holding]
            amount : Numeric 0
            caller : Party
        controller caller
        do tokenPool_lockOrBurnImpl this self arg

    -- Calculate fee for outbound token transfer, which it records via
    -- SendingMessageV1.AddTokenFee
    nonconsuming choice TokenPool_CalculateFee
            : ContractId CCIP.SendingMessageV1.SendingMessageV1
        with
            sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
            caller : Party
        controller caller
        do tokenPool_calculateFeeImpl this self arg


-- View of the TokenPool
data TokenPoolView = TokenPoolView
    with
        owner : Party
        ccipOwner : Party
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
    deriving (Eq, Show)

-- Pool specific input data, provided by the Pool API
data TokenInput = TokenInput
    with
        -- The transfer factory CID for the pool's asset
        transferFactory : ContractId Splice.Api.Token.TransferInstructionV1.TransferFactory
        -- The extraArgs passed to the transfer factory when creating transfer instructions
        extraArgs : Splice.Api.Token.MetadataV1.ExtraArgs
        -- The holdings in the pool
        --  On Release, these holdings will be used to release tokens
        --  On Lock, these holdings are optional and will be used to combine UTXOs with the incoming locked tokens
        tokenPoolHoldings : [ContractId Splice.Api.Token.HoldingV1.Holding]
    deriving (Eq, Show)

data ReleaseOrMintResult = ReleaseOrMintResult
    with
        output : ReleaseOrMintResult_Output
        poolChangeCids : [ContractId Splice.Api.Token.HoldingV1.Holding]
    deriving (Eq, Show)

data ReleaseOrMintResult_Output
    = ReleaseOrMintResult_Pending
        with transferInstructionCid : ContractId Splice.Api.Token.TransferInstructionV1.TransferInstruction
    | ReleaseOrMintResult_Completed
        with receiverHoldingCids : [ContractId Splice.Api.Token.HoldingV1.Holding]
    deriving (Eq, Show)

data LockOrBurnResult = LockOrBurnResult
    with
        poolChangeCids : [ContractId Splice.Api.Token.HoldingV1.Holding]
        senderChangeCids : [ContractId Splice.Api.Token.HoldingV1.Holding]
        sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
    deriving (Eq, Show)
