-- | Codec module for FeeQuoter MCMS parameter encoding/decoding
-- Used by the MCMSReceiver interface implementation to decode operationData
module CCIP.FeeQuoterCodec (
    encodeApplyPriceUpdatersUpdateParams,
    decodeApplyPriceUpdatersUpdateParams,
    encodeUpdatePricesParams,
    decodeUpdatePricesParams,
    encodeApplyFeeTokenUpdatesParams,
    decodeApplyFeeTokenUpdatesParams,
    encodeApplyDestChainConfigUpdatesParams,
    decodeApplyDestChainConfigUpdatesParams,
    ) where

import DA.Crypto.Text (BytesHex)

import qualified Splice.Api.Token.HoldingV1

import CCIP.FeeQuoterTypes (
    FeeTokenArgs,
    DestChainConfigArgs,
    PriceUpdates(..),
    )

import MCMS.Codec (
    encodeList,
    decodeList,
    encodeParty,
    decodePartyAt,
    )
import CCIP.Codec (
    encodeInstrumentId,
    decodeInstrumentId,
    )
import CCIP.FeeQuoterCodecGen (
    encodePriceUpdates,
    decodePriceUpdatesAt,
    encodeFeeTokenArgs,
    decodeFeeTokenArgsAt,
    encodeDestChainConfigArgs,
    decodeDestChainConfigArgsAt,
    )

-- ===============================================
-- |          ApplyPriceUpdatersUpdate           |
-- ===============================================

encodeApplyPriceUpdatersUpdateParams : ([Party], [Party]) -> BytesHex
encodeApplyPriceUpdatersUpdateParams (addedPriceUpdaters, removedPriceUpdaters) =
    encodeList addedPriceUpdaters encodeParty <>
    encodeList removedPriceUpdaters encodeParty

decodeApplyPriceUpdatersUpdateParams : BytesHex -> Optional (([Party], [Party]), Int)
decodeApplyPriceUpdatersUpdateParams encoded = do
    (addedPriceUpdaters, offset1) <- decodeList encoded 0 decodePartyAt
    (removedPriceUpdaters, finalOffset) <- decodeList encoded offset1 decodePartyAt
    Some ((addedPriceUpdaters, removedPriceUpdaters), finalOffset)

-- ===============================================
-- |                UpdatePrices                 |
-- ===============================================

encodeUpdatePricesParams : (PriceUpdates, Party) -> BytesHex
encodeUpdatePricesParams (priceUpdates, caller) =
    encodePriceUpdates priceUpdates <>
    encodeParty caller

decodeUpdatePricesParams : BytesHex -> Optional ((PriceUpdates, Party), Int)
decodeUpdatePricesParams encoded = do
    (priceUpdates, offset) <- decodePriceUpdatesAt encoded 0
    (caller, finalOffset) <- decodePartyAt encoded offset
    Some ((priceUpdates, caller), finalOffset)

-- ===============================================
-- |            ApplyFeeTokenUpdates             |
-- ===============================================

encodeApplyFeeTokenUpdatesParams : ([Splice.Api.Token.HoldingV1.InstrumentId], [FeeTokenArgs]) -> BytesHex
encodeApplyFeeTokenUpdatesParams (feeTokensToRemove, feeTokensToAdd) =
    encodeList feeTokensToRemove encodeInstrumentId
    <> encodeList feeTokensToAdd encodeFeeTokenArgs

decodeApplyFeeTokenUpdatesParams : BytesHex -> Optional (([Splice.Api.Token.HoldingV1.InstrumentId], [FeeTokenArgs]), Int)
decodeApplyFeeTokenUpdatesParams encoded = do
    (feeTokensToRemove, offset1) <- decodeList encoded 0 decodeInstrumentId
    (feeTokensToAdd, finalOffset) <- decodeList encoded offset1 decodeFeeTokenArgsAt
    Some ((feeTokensToRemove, feeTokensToAdd), finalOffset)

-- ===============================================
-- |         ApplyDestChainConfigUpdates         |
-- ===============================================

encodeApplyDestChainConfigUpdatesParams : ([DestChainConfigArgs]) -> BytesHex
encodeApplyDestChainConfigUpdatesParams destChainConfigArgs =
    encodeList destChainConfigArgs encodeDestChainConfigArgs

decodeApplyDestChainConfigUpdatesParams : BytesHex -> Optional ([DestChainConfigArgs], Int)
decodeApplyDestChainConfigUpdatesParams encoded = do
    (destChainConfigArgs, finalOffset) <- decodeList encoded 0 decodeDestChainConfigArgsAt
    Some (destChainConfigArgs, finalOffset)
