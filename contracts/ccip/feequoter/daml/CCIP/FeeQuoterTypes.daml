-- | Types for FeeQuoter, extracted to avoid circular dependencies
module CCIP.FeeQuoterTypes where

import Splice.Api.Token.HoldingV1

data PriceUpdates = PriceUpdates
    with
        tokenPriceUpdates : [TokenPriceUpdate]
        gasPriceUpdates : [GasPriceUpdate]
    deriving (Eq, Show)

data TokenPriceUpdate = TokenPriceUpdate
    with
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId -- SourceToken
        -- 8-decimal USD price for 1e8 smallest token units.
        usdPerToken : Numeric 0
    deriving (Eq, Show)

data GasPriceUpdate = GasPriceUpdate
    with
        destChainSelector : Numeric 0
        -- 8-decimal USD price per gas unit.
        usdPerUnitGas : Numeric 0
    deriving (Eq, Show)

-- | Arguments for adding fee tokens
data FeeTokenArgs = FeeTokenArgs
    with
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
    deriving (Eq, Show)

-- | Arguments for destination chain config updates
data DestChainConfigArgs = DestChainConfigArgs
    with
        destChainSelector : Numeric 0
        destChainConfig : DestChainConfig
    deriving (Eq, Show)

-- | Configuration for a destination chain
data DestChainConfig = DestChainConfig
    with
        isEnabled : Bool -- ────────────────────╮ Whether this destination chain is enabled.
        maxDataBytes : Int --                   │ Maximum data payload size in bytes.
        maxPerMsgGasLimit : Int --              │ Maximum gas limit.
        destGasOverhead : Int --                │ Gas charged on top of the gasLimit to cover destionation chain costs.
        destGasPerPayloadByteBase : Int --      │ Default dest-chain gas charged for each byte of `data` payload.
        defaultTxGasLimit : Int --              │ Default gas limit for a tx.
        linkFeeMultiplierPercent : Numeric 0 -- │ LINK-specific percent multiplier. 90 = 10% discount.
        -- | The following two properties are defaults, they can be overridden by setting the TokenTransferFeeConfig for a token.
        defaultTokenFeeUSD : Numeric 0 --       │ Legacy field name retained; value is integer USD cents.
        defaultTokenDestGasOverhead : Int --  ──╯ Default gas charged to execute a token transfer on the destination chain.
    deriving (Eq, Show)

-- ===========================================================================
-- MCMS Choice Params Types
-- These define the full MCMS payload for each choice, enabling auto-generation
-- of encode/decode functions in FeeQuoterCodecGen.daml
-- ===========================================================================

-- | Params for ApplyPriceUpdatersUpdate choice (add/remove price updaters)
data ApplyPriceUpdatersUpdateParams = ApplyPriceUpdatersUpdateParams
    with
        addedPriceUpdaters : [Party]
        removedPriceUpdaters : [Party]
    deriving (Eq, Show)

-- | Params for UpdatePrices choice
data UpdatePricesParams = UpdatePricesParams
    with
        priceUpdates : PriceUpdates
        caller : Party
    deriving (Eq, Show)

-- | Params for ApplyFeeTokenUpdates choice
data ApplyFeeTokenUpdatesParams = ApplyFeeTokenUpdatesParams
    with
        feeTokensToRemove : [Splice.Api.Token.HoldingV1.InstrumentId]
        feeTokensToAdd : [FeeTokenArgs]
    deriving (Eq, Show)

-- | Params for ApplyDestChainConfigUpdates choice
data ApplyDestChainConfigUpdatesParams = ApplyDestChainConfigUpdatesParams
    with
        destChainConfigArgs : [DestChainConfigArgs]
    deriving (Eq, Show)
