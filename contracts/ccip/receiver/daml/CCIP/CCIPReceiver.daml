-- | Receiver-side entry point for CCIP message execution.
-- Calls PrepareExecute to create an ExecutingMessageV1, then threads it
-- through CCV verification and pool verification via foldlA, and
-- finally calls Execute.
--
-- Only `owner` is a signatory. The CCIP participant does not need this DAR
-- because ccipOwner is not a party on this contract.
module CCIP.CCIPReceiver where

import DA.Crypto.Text (BytesHex)
import DA.Action (foldlA)
import DA.List (unique)
import DA.Optional (fromSomeNote)

import qualified Splice.Api.Token.MetadataV1

import qualified Chainlink.InstanceAddress

import qualified CCIP.APIV2.RMNRemote
import qualified CCIP.APIV2.TokenAdminRegistry
import qualified CCIP.CodecV2.FinalityConfig
import qualified CCIP.CodecV2.MessageCodecV1
import qualified CCIP.ClientV2
import qualified CCIP.InterfacesV2.CrossChainVerifier
import qualified CCIP.InterfacesV2.TokenPool
import qualified CCIP.UtilsV2.Context

-- | Per-CCV verification input. Pairs a verifier contract (via interface)
-- with the attestation data and per-CCV extra context.
data CCVInput = CCVInput
    with
        ccvCid : ContractId CCIP.InterfacesV2.CrossChainVerifier.ICrossChainVerifier
        verifierResults : BytesHex
        context : Splice.Api.Token.MetadataV1.ChoiceContext
    deriving (Eq, Show)

-- | Token transfer input, provided only when the message includes a
-- token transfer. Mirrors how TokenReceiveTicket is Optional on the OffRamp.
data TokenTransferInput = TokenTransferInput
    with
        tokenPoolCid : ContractId CCIP.InterfacesV2.TokenPool.ITokenPool
        tokenReceiverParty : Party
        context : Splice.Api.Token.MetadataV1.ChoiceContext
    deriving (Eq, Show)

template CCIPReceiver
    with
        instanceId : Text
        owner : Party
        -- Receiver's required CCV instance addresses, analogous to
        -- IAny2EVMMessageReceiverV2.getCCVs() in the EVM implementation.
        -- Passed to PerPartyRouter.Execute as receiverRequiredCCVs.
        requiredCCVs : [Chainlink.InstanceAddress.RawInstanceAddress]
        optionalCCVs : [Chainlink.InstanceAddress.RawInstanceAddress]
        optionalThreshold : Int
        -- Allowed finality policy for inbound execution.
        receiverFinalityConfig : CCIP.CodecV2.FinalityConfig.FinalityConfig
    where
        signatory owner
        -- Ensure that requiredCCVs are unique
        ensure Chainlink.InstanceAddress.assertValidInstanceId instanceId
            && unique requiredCCVs
            && CCIP.CodecV2.FinalityConfig.isValidFinalityConfig receiverFinalityConfig

        -- | Query the final required CCVs for executing an inbound message.
        -- Aggregates receiver policy with token-pool requirements and delegates
        -- protocol-level resolution to PerPartyRouter/OffRamp.
        nonconsuming choice GetRequiredCCVs : [Chainlink.InstanceAddress.RawInstanceAddress]
            with
                routerCid : ContractId CCIP.ClientV2.PerPartyRouter
                encodedMessage : BytesHex
                tokenPoolCid : Optional (ContractId CCIP.InterfacesV2.TokenPool.ITokenPool)
                context : Splice.Api.Token.MetadataV1.ChoiceContext
            controller owner
            do
                let message = fromSomeNote "receiver: failed to decode message"
                        (CCIP.CodecV2.MessageCodecV1.decodeMessageV1 encodedMessage)

                tokenPoolRequiredCCVs <- case (message.tokenTransfer, tokenPoolCid) of
                    (None, None) -> pure []
                    (None, Some _) ->
                        abort "receiver: tokenPoolCid provided without token transfer"
                    (Some _, None) ->
                        abort "receiver: tokenPoolCid required for token transfer"
                    (Some tt, Some poolCid) ->
                        let tokenExtraData : BytesHex = tt.extraData
                        in
                        exercise poolCid
                            CCIP.InterfacesV2.TokenPool.TokenPool_GetRequiredCCVs with
                                remoteChainSelector = message.sourceChainSelector
                                sourceAmount = tt.amount
                                finality = message.finality.raw
                                extraData = tokenExtraData
                                direction = CCIP.InterfacesV2.TokenPool.Inbound
                                context = context
                                caller = owner

                exercise routerCid CCIP.ClientV2.PerPartyRouter_GetRequiredCCVsForExecute with
                    context = context
                    message = message
                    receiverRequiredCCVs = requiredCCVs
                    receiverOptionalCCVs = optionalCCVs
                    receiverOptionalThreshold = optionalThreshold
                    tokenPoolRequiredCCVs = tokenPoolRequiredCCVs

        -- | Update CCV requirements.
        choice UpdateRequiredCCVs : ContractId CCIPReceiver
            with
                newRequiredCCVs : [Chainlink.InstanceAddress.RawInstanceAddress]
            controller owner
            do
                assertMsg "DuplicateCCVNotAllowed: duplicate CCVs in new required CCVs" (unique newRequiredCCVs)
                create this with requiredCCVs = newRequiredCCVs

        -- | Executes an inbound CCIP message end-to-end.
        -- TODO: consider allowing arbitrary callers
        nonconsuming choice Execute : ContractId CCIPMessageReceived
            with
                -- CCIP contract IDs
                routerCid : ContractId CCIP.ClientV2.PerPartyRouter

                -- The encoded CCIP message (hex-encoded bytes)
                encodedMessage : BytesHex

                -- None for message-only, Some for token transfers.
                tokenTransfer : Optional TokenTransferInput

                -- One entry per CCV that should verify this message.
                -- Accepts any ICrossChainVerifier implementation.
                ccvInputs : [CCVInput]

                -- CCIP context for internal orchestration (PerPartyRouter calls).
                context : Splice.Api.Token.MetadataV1.ChoiceContext
            controller owner
            do
                -- Extract CIDs from context using typed accessors for pool/CCV calls.
                rmnRemoteCid : ContractId CCIP.APIV2.RMNRemote.IRMNRemote <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.RMNRemote.rmnRemoteContextKey
                tokenAdminRegistryCid : ContractId CCIP.APIV2.TokenAdminRegistry.ITokenAdminRegistry <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.TokenAdminRegistry.tokenAdminRegistryContextKey

                -- PrepareExecute: decode, validate, create ExecutingMessageV1
                emCid <- exercise routerCid CCIP.ClientV2.PerPartyRouter_PrepareExecute with
                    context = context
                    encodedMessage = encodedMessage
                    receiverParty = owner
                    tokenReceiverParty = fmap (.tokenReceiverParty) tokenTransfer
                    receiverRequiredCCVs = requiredCCVs
                    receiverOptionalCCVs = optionalCCVs
                    receiverOptionalThreshold = optionalThreshold
                    receiverFinalityConfig = receiverFinalityConfig
                    caller = owner

                -- Token transfers must resolve pool CCVs before any CCV can contribute.
                emCid <- case tokenTransfer of
                    None -> pure emCid
                    Some tt -> do
                        tokenConfigCid <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.TokenAdminRegistry.tokenConfigContextKey
                        exercise tt.tokenPoolCid
                            CCIP.InterfacesV2.TokenPool.TokenPool_VerifyInboundMessage with
                                tokenAdminRegistryCid = tokenAdminRegistryCid
                                tokenConfigCid = tokenConfigCid
                                context = tt.context
                                executingMessageCid = emCid
                                caller = owner

                -- CCV verification: thread executingMessageCid through each CCV
                emCid <- foldlA (\cid input ->
                    exercise input.ccvCid
                        CCIP.InterfacesV2.CrossChainVerifier.CrossChainVerifier_VerifyMessage with
                            rmnRemoteCid = rmnRemoteCid
                            context = input.context
                            executingMessageCid = cid
                            verifierResults = input.verifierResults
                            caller = owner
                    ) emCid ccvInputs

                -- Execute with the final executingMessageCid
                result <- exercise routerCid CCIP.ClientV2.PerPartyRouter_Execute with
                    context = context
                    executingMessageCid = emCid

                -- Token release
                tokenReleaseResult <- case (tokenTransfer, result.tokenReceiveTicket) of
                    (Some tt, Some ticketCid) -> do
                        tokenConfigCid <- CCIP.UtilsV2.Context.getFromContextU context CCIP.APIV2.TokenAdminRegistry.tokenConfigContextKey
                        releaseResult <- exercise tt.tokenPoolCid CCIP.InterfacesV2.TokenPool.TokenPool_ReleaseFromTicket with
                            tokenAdminRegistryCid = tokenAdminRegistryCid
                            tokenConfigCid = tokenConfigCid
                            rmnRemoteCid = rmnRemoteCid
                            context = tt.context
                            tokenReceiveTicketCid = ticketCid
                            caller = owner
                        pure (Some releaseResult)
                    _ -> pure None

                -- Receivers that need custom behavior can fork this receiver and add
                -- business logic here, e.g., parse and act on the message or
                -- programmatic token transfers.

                create CCIPMessageReceived with
                    owner
                    router = result.router
                    messageId = result.messageId
                    message = result.message
                    tokenReleaseResult

-- | Record of a successfully received CCIP message.
template CCIPMessageReceived
    with
        owner : Party
        router : ContractId CCIP.ClientV2.PerPartyRouter
        messageId : BytesHex
        message : CCIP.CodecV2.MessageCodecV1.MessageV1
        tokenReleaseResult : Optional CCIP.InterfacesV2.TokenPool.ReleaseOrMintResult
    where
        signatory owner
