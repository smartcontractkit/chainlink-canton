module CCIP.CommitteeVerifier where

import DA.Crypto.Text (BytesHex, PublicKeyHex, byteCount, keccak256, secp256k1WithEcdsaOnly)
import DA.Map qualified as Map
import DA.Optional (fromSomeNote)

import qualified CCIP.Context
import qualified CCIP.ExecutingMessageV1
import qualified CCIP.MessageCodecV1
import qualified CCIP.RawInstanceAddress
import qualified CCIP.RMNRemote
import qualified CCIP.SendingMessageV1
import qualified CCIP.Interfaces.CrossChainVerifier

import qualified CCIP.Crypto.DerEncoding

import qualified Splice.Api.Token.MetadataV1

versionTagV1_7_0 : BytesHex = "49ff34ed"

signature_length : Int = 64
signature_component_length : Int = 32

-- | Per-chain fee config for outbound fee calculation.
-- Mirrors EVM's BaseVerifier.s_remoteChainConfigs.
data CCVFeeConfig = CCVFeeConfig
    with
        feeUSDCents : Decimal
        gasForVerification : Int
        payloadSizeBytes : Int
    deriving (Eq, Show)

template CommitteeVerifier
    with
        instanceId : Text
        owner : Party

        ccipOwner : Party
        versionTag : BytesHex              -- Version tag for this CCV (e.g., "49ff34ed")
        messageSentObserver : Party
        storageLocation : Text

        threshold : Int
        signers : [BytesHex]
        rmnRemoteInstanceAddress : CCIP.RawInstanceAddress.RawInstanceAddress
        remoteChainFeeConfigs : Map.Map (Numeric 0) CCVFeeConfig
    where
        signatory owner
        ensure storageLocation /= "" && threshold > 0 && length signers >= threshold && versionTag /= ""

        interface instance CCIP.Interfaces.CrossChainVerifier.ICrossChainVerifier for CommitteeVerifier where
            view = CCIP.Interfaces.CrossChainVerifier.CrossChainVerifierView with
                ccipOwner = ccipOwner
                storageLocation = storageLocation

            crossChainVerifier_verifyMessageImpl self arg = do
                exercise (fromInterfaceContractId @CommitteeVerifier self) CommitteeVerifier_VerifyMessage
                    with
                        context = arg.context
                        executingMessageCid = arg.executingMessageCid
                        verifierResults = arg.verifierResults
                        caller = arg.caller

            crossChainVerifier_calculateFeeImpl self arg = do
                exercise (fromInterfaceContractId @CommitteeVerifier self) CommitteeVerifier_CalculateFee
                    with
                        sendingMessageCid = arg.sendingMessageCid
                        caller = arg.caller

            crossChainVerifier_forwardToVerifierImpl self arg = do
                exercise (fromInterfaceContractId @CommitteeVerifier self) CommitteeVerifier_ForwardToVerifier
                    with
                        context = arg.context
                        sendingMessageCid = arg.sendingMessageCid
                        verifierArgs = arg.verifierArgs
                        caller = arg.caller

        -- | Verify an inbound message and append CCV verification to ExecutingMessageV1.
        -- Fetches ExecutingMessageV1 for decoded message content and re-encodes
        -- for signature verification (encoding is deterministic).
        nonconsuming choice CommitteeVerifier_VerifyMessage : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
            with
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                executingMessageCid : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
                verifierResults : BytesHex
                caller : Party
            controller caller
            do
                -- Get Cids from context
                rmnRemoteCid <- CCIP.Context.getFromContextU @(ContractId CCIP.RMNRemote.RMNRemote) context CCIP.Context.rmnRemoteKey

                execMsg <- fetch executingMessageCid
                let message = execMsg.message

                -- Validate RMN instance and check source chain curse
                rmnRemote <- fetch rmnRemoteCid
                CCIP.RawInstanceAddress.assertEqual "verifier: rmn instance address mismatch"
                    rmnRemote.instanceId rmnRemote.rmnOwner rmnRemoteInstanceAddress
                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = owner
                    chainSelector = message.sourceChainSelector
                assertMsg "verifier: source chain is cursed" (not isCursed)

                -- Verify version tag matches
                let verifierVersion = fromSomeNote "Failed to extract verifier version" (CCIP.MessageCodecV1.extractBytes verifierResults 0 (byteCount versionTag))
                assertMsg "Invalid CCV Version" (verifierVersion == versionTag)

                let signatureLength = fromSomeNote "Failed to extract signature length" (CCIP.MessageCodecV1.decodeUint16 (fromSomeNote "Failed to extract signature length bytes" (CCIP.MessageCodecV1.extractBytes verifierResults (byteCount versionTag) 2)))
                assertMsg "Invalid verifierResults" ((byteCount verifierResults) == ((byteCount versionTag) + 2 + signatureLength))
                let numberOfSignatures = signatureLength / signature_length
                assertMsg "Insufficient signatures provided" (numberOfSignatures >= threshold)
                let signatureData = fromSomeNote "Failed to extract signature data" (CCIP.MessageCodecV1.extractBytes verifierResults (byteCount versionTag + 2) signatureLength)
                let signatures = parseSignatures signatureData

                -- Matches EVM: signers sign keccak256(versionTag ++ messageHash)
                let signedHash = keccak256 (versionTag <> execMsg.messageId)

                -- Verify signatures
                let validSigners = findValidSigners signedHash signatures signers
                let validSignerCount = countValidSigners validSigners

                -- Check that number of valid signers == number of signatures provided
                assertMsg "Invalid signatures detected" (validSignerCount == numberOfSignatures)

                -- Check threshold requirement
                assertMsg ("Insufficient valid signatures: " <> show validSignerCount <> " < " <> show threshold)
                    (validSignerCount >= threshold)

                -- Append CCV verification to ExecutingMessageV1
                exercise executingMessageCid CCIP.ExecutingMessageV1.AddCCVVerification with
                    ccvInstanceId = instanceId
                    versionTag = versionTag
                    caller = owner

        -- | Calculate fee for outbound message (USD cents only).
        -- Reads destChainSelector from SendingMessageV1, looks up per-chain
        -- fee config, appends fee via AddCCVFee.
        nonconsuming choice CommitteeVerifier_CalculateFee
                : ContractId CCIP.SendingMessageV1.SendingMessageV1
            with
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
                caller : Party
            controller caller
            do
                sendingMsg <- fetch sendingMessageCid
                let feeConfig = fromSomeNote "no fee config for dest chain"
                        (Map.lookup sendingMsg.destChainSelector remoteChainFeeConfigs)

                exercise sendingMessageCid CCIP.SendingMessageV1.AddCCVFee with
                    ccvInstanceId = instanceId
                    feeUSDCents = feeConfig.feeUSDCents
                    destGasLimit = feeConfig.gasForVerification
                    destBytesOverhead = feeConfig.payloadSizeBytes
                    caller = owner

        -- | Forward message for verification. Exercises AddVerifierData
        -- directly on SendingMessageV1.
        nonconsuming choice CommitteeVerifier_ForwardToVerifier
                : ContractId CCIP.SendingMessageV1.SendingMessageV1
            with
                context : Splice.Api.Token.MetadataV1.ChoiceContext
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
                verifierArgs : BytesHex
                caller : Party
            controller caller
            do
                -- Get Cids from context
                rmnRemoteCid <- CCIP.Context.getFromContextU @(ContractId CCIP.RMNRemote.RMNRemote) context CCIP.Context.rmnRemoteKey

                sendingMsg <- fetch sendingMessageCid

                -- Validate RMN instance and check destination chain curse
                rmnRemote <- fetch rmnRemoteCid
                CCIP.RawInstanceAddress.assertEqual "verifier: rmn instance address mismatch"
                    rmnRemote.instanceId rmnRemote.rmnOwner rmnRemoteInstanceAddress
                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = owner
                    chainSelector = sendingMsg.destChainSelector
                assertMsg "verifier: destination chain is cursed" (not isCursed)

                let verifierBlob = versionTag

                exercise sendingMessageCid CCIP.SendingMessageV1.AddVerifierData with
                    ccvInstanceId = instanceId
                    versionTag = versionTag
                    verifierBlob = verifierBlob
                    messageSentObservers = [messageSentObserver]
                    caller = owner


parseSignatures : BytesHex -> [(BytesHex, BytesHex)]
parseSignatures signatureData =
    let dataLength = byteCount signatureData
        numSignatures = dataLength / signature_length
    in
        map (extractRSComponents signatureData) [0 .. numSignatures - 1]

extractRSComponents : BytesHex -> Int -> (BytesHex, BytesHex)
extractRSComponents signatureData index =
    let offset = index * signature_length
        r = fromSomeNote "Failed to extract r component" (CCIP.MessageCodecV1.extractBytes signatureData offset signature_component_length)
        s = fromSomeNote "Failed to extract s component" (CCIP.MessageCodecV1.extractBytes signatureData (offset + signature_component_length) signature_component_length)
    in
        (r, s)

validateSignature : BytesHex -> PublicKeyHex -> BytesHex -> BytesHex -> Bool
validateSignature messageHash publicKey r s =
  let
    derSignature = CCIP.Crypto.DerEncoding.rawToDerSignature r s
    derPublicKey = CCIP.Crypto.DerEncoding.secp256k1PublicKeyToDer publicKey
  in
    secp256k1WithEcdsaOnly derSignature messageHash derPublicKey

findValidSigners : BytesHex -> [(BytesHex, BytesHex)] -> [BytesHex] -> [(BytesHex, Bool)]
findValidSigners messageHash signatures signerKeys =
    map (\signer -> (signer, isValidSigner messageHash signatures signer)) signerKeys

isValidSigner : BytesHex -> [(BytesHex, BytesHex)] -> BytesHex -> Bool
isValidSigner messageHash signatures signerKey =
    any (uncurry (validateSignature messageHash signerKey)) signatures

countValidSigners : [(BytesHex, Bool)] -> Int
countValidSigners validSignersMap =
    length (filter snd validSignersMap)
