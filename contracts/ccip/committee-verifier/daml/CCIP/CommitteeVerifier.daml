module CCIP.CommitteeVerifier (
    module CCIP.CommitteeVerifier,
    module CCIP.CommitteeVerifierTypes,
) where

import qualified DA.Action
import DA.Crypto.Text (BytesHex, PublicKeyHex, byteCount, keccak256, secp256k1WithEcdsaOnly)
import DA.Foldable (forA_)
import DA.List (dedup, (\\))
import DA.Map qualified as Map
import DA.Optional (fromOptional, fromSomeNote)

import Splice.Api.Token.MetadataV1 (ChoiceContext)

import CCIP.CommitteeVerifierCodecGen (
    decodeApplySignatureConfigsParamsAt,
    decodeSetDynamicConfigParamsAt,
    decodeApplyRemoteChainConfigUpdatesParamsAt,
    decodeApplyAllowListUpdatesParamsAt,
    decodeTransferStorageLocationsAdminParamsAt,
    decodeUpdateStorageLocationsParamsAt,
    decodeSetDepsParamsAt,
    )
import CCIP.CommitteeVerifierTypes (
    DynamicConfig(..),
    RemoteChainConfig(..),
    RemoteChainConfigArgs(..),
    CommitteeVerifierDeps(..),
    SetDepsParams(..),
    SignatureConfig(..),
    AllowListConfigArgs(..),
    ApplySignatureConfigsParams(..),
    SetDynamicConfigParams(..),
    ApplyRemoteChainConfigUpdatesParams(..),
    ApplyAllowListUpdatesParams(..),
    TransferStorageLocationsAdminParams(..),
    UpdateStorageLocationsParams(..),
    )
import qualified CCIP.Crypto.DerEncoding
import qualified CCIP.ExecutingMessageV1
import qualified CCIP.MessageCodecV1
import Chainlink.InstanceAddress qualified as RawInstanceAddress
import Chainlink.InstanceAddress (assertValidInstanceId)
import qualified CCIP.RMNRemote
import qualified CCIP.SendingMessageV1
import qualified CCIP.Interfaces.CrossChainVerifier

import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiverView(..))

-- The preimage is bytes4(keccak256("CommitteeVerifier 2.0.0"))
versionTagV2_0_0 : BytesHex
versionTagV2_0_0 : BytesHex = "e9a05a20"

signature_length : Int
signature_length : Int = 64
signature_component_length : Int
signature_component_length : Int = 32

template CommitteeVerifier
    with
        instanceId : Text
        owner : Party

        ccipOwner : Party
        versionTag : BytesHex -- Version tag for this CCV (e.g., "e9a05a20")
        
        -- | Dynamic config
        -- Party capable of adding or removing allowed senders
        allowListAdmin : Optional Party
        -- Additional observers that will be added to CCIPMessageSent contracts
        messageSentObservers : [Party]

        -- | Storage locations for off-chain components to read from.
        storageLocations : [Text]
        -- | The current admin party that's allowed to update storage locations and transfer the admin role.
        storageLocationsAdmin : Party
        -- | The pending admin party for the two-step storage location admin role transfer process.
        -- | pendingStorageLocationsAdmin /= storageLocationsAdmin indicates that a transfer is in progress.
        pendingStorageLocationsAdmin : Party

        -- | The remote chain specific configs. Keyed by remote chain selector.
        remoteChainConfigs : Map.Map (Numeric 0) RemoteChainConfig
        -- | The signer configs for inbound message verification. Keyed by source chain selector.
        signerConfigs : Map.Map (Numeric 0) SignatureConfig

        deps : CommitteeVerifierDeps
    where
        signatory owner
        observer storageLocationsAdmin :: pendingStorageLocationsAdmin :: optional [] pure allowListAdmin

        -- Ensure signer configs have a positive threshold, enough signers,
        -- and no duplicate signer keys.
        ensure assertValidInstanceId instanceId
          && versionTag /= "" && all isValidSignatureConfig (Map.values signerConfigs)

        interface instance CCIP.Interfaces.CrossChainVerifier.ICrossChainVerifier for CommitteeVerifier where
            view = CCIP.Interfaces.CrossChainVerifier.CrossChainVerifierView with
                instanceId = instanceId
                owner = owner
                ccipOwner = ccipOwner
                storageLocations = storageLocations

            crossChainVerifier_verifyMessageImpl self arg = do
                exercise (fromInterfaceContractId @CommitteeVerifier self) VerifyMessage
                    with
                        rmnRemoteCid = arg.rmnRemoteCid
                        extraContext = arg.extraContext
                        executingMessageCid = arg.executingMessageCid
                        verifierResults = arg.verifierResults
                        caller = arg.caller

            crossChainVerifier_calculateFeeImpl self arg = do
                exercise (fromInterfaceContractId @CommitteeVerifier self) CalculateFee
                    with
                        sendingMessageCid = arg.sendingMessageCid
                        extraContext = arg.extraContext
                        caller = arg.caller

            crossChainVerifier_getFeeImpl self arg = do
                exercise (fromInterfaceContractId @CommitteeVerifier self) GetFee
                    with
                        destChainSelector = arg.destChainSelector
                        caller = arg.caller

            crossChainVerifier_forwardToVerifierImpl self arg = do
                exercise (fromInterfaceContractId @CommitteeVerifier self) ForwardToVerifier
                    with
                        rmnRemoteCid = arg.rmnRemoteCid
                        extraContext = arg.extraContext
                        sendingMessageCid = arg.sendingMessageCid
                        verifierArgs = arg.verifierArgs
                        caller = arg.caller

        -- =========================================
        -- |                Config                 |
        -- =========================================

        -- Sets the dynamic configuration
        --
        -- Params:
        -- dynamicConfig: The configuration
        --
        -- Only callable by the owner.
        choice SetDynamicConfig : ContractId CommitteeVerifier
            with
                dynamicConfig : DynamicConfig
            controller owner
            do
                create this with 
                    allowListAdmin = dynamicConfig.allowListAdmin
                    messageSentObservers = dynamicConfig.messageSentObservers

        -- Updates allowlistConfig for Senders.
        --
        -- Params:
        -- allowListConfigArgsItems: List of AllowlistConfigArguments where each item is for a destChainSelector.
        -- caller: The party initiating the update
        --
        -- Only callable by the owner or allowListAdmin (if set in dynamic config).
        choice ApplyAllowListUpdates : ContractId CommitteeVerifier
            with
                allowListConfigArgsItems : [AllowListConfigArgs]
                caller : Party
            controller caller
            do
                -- Callable by both the owner and allowListAdmin (if set in dynamicConfig)
                assertMsg "ApplyAllowListUpdates: only callable by owner or allowlist admin" (caller == owner || (allowListAdmin == Some caller))
                -- Validate
                forA_ allowListConfigArgsItems $ \args -> do
                    assertMsg ("ApplyAllowListUpdates: invalid chain selector: " <> show args.destChainSelector ) (args.destChainSelector >= 0.0)
                    DA.Action.unless args.allowListEnabled $ do
                        assertMsg "ApplyAllowListUpdates: cannot add allowed senders if allowlist is not enabled" (null args.addedAllowListedSenders)
                -- Update allow-list fields only; remote chain rows must exist (owner: ApplyRemoteChainConfigUpdates).
                let updatedRemoteChainConfigs = foldl
                        (\configs args ->
                            case Map.lookup args.destChainSelector configs of
                                Some config ->
                                    let updated = config with
                                            allowListEnabled = args.allowListEnabled
                                            allowedSendersList =
                                                dedup ((config.allowedSendersList \\ args.removedAllowListedSenders)
                                                    <> args.addedAllowListedSenders)
                                    in Map.insert args.destChainSelector updated configs
                                None ->
                                    error ("ApplyAllowListUpdates: unknown dest chain: " <> show args.destChainSelector))
                        remoteChainConfigs allowListConfigArgsItems
                create this with
                    remoteChainConfigs = updatedRemoteChainConfigs

        -- Updates remote chains specific configs.
        --
        -- Params:
        -- remoteChainConfigArgsItems: List of remote chain specific configs.
        --
        -- Only callable by the owner.
        choice ApplyRemoteChainConfigUpdates : ContractId CommitteeVerifier
            with
                remoteChainConfigArgs : [RemoteChainConfigArgs]
            controller owner
            do
                -- Validate
                forA_ remoteChainConfigArgs $ \args -> do
                    assertMsg ("ApplyRemoteChainConfigUpdates: invalid chain selector: " <> show args.remoteChainSelector ) (args.remoteChainSelector >= 0.0)
                    assertMsg ("ApplyRemoteChainConfigUpdates: invalid gas for verification: " <> show args.gasForVerification) (args.gasForVerification > 0)
                    assertMsg ("ApplyRemoteChainConfigUpdates: invalid payload size bytes: " <> show args.payloadSizeBytes) (args.payloadSizeBytes >= 0)
                -- Update
                let updatedRemoteChainConfigs = foldl
                        (\configs args -> do
                            -- don't override allowedSendersList if it already exists for the chain, otherwise set to empty list
                            let allowedSendersList = case Map.lookup args.remoteChainSelector configs of
                                    Some config -> config.allowedSendersList
                                    None -> []
                            Map.insert args.remoteChainSelector RemoteChainConfig
                                    with
                                        feeUSDCents = args.feeUSDCents
                                        gasForVerification = args.gasForVerification
                                        payloadSizeBytes = args.payloadSizeBytes
                                        allowListEnabled = args.allowListEnabled
                                        allowedSendersList = allowedSendersList
                                configs) remoteChainConfigs remoteChainConfigArgs
                create this with
                    remoteChainConfigs = updatedRemoteChainConfigs

        choice ApplySignatureConfigs : ContractId CommitteeVerifier
            with
                sourceChainSelectorsToRemove : [Numeric 0]
                signatureConfigs : [SignatureConfig]
            controller owner
            do
                -- Remove existing signer configs for specified source chains
                let signerConfigsAfterRemoval = foldr Map.delete signerConfigs sourceChainSelectorsToRemove
                -- Add new signer configs - for each config, check that threshold > 0,
                -- number of signer keys >= threshold, and signer keys are unique.
                assertMsg "invalid signature config: threshold must be > 0, signerKeys must be >= threshold, and signerKeys must be unique"
                    (all isValidSignatureConfig signatureConfigs)
                let newSignerConfigs = foldr (\config acc -> Map.insert config.sourceChainSelector config acc) signerConfigsAfterRemoval signatureConfigs
                create this with signerConfigs = newSignerConfigs

        -- | Update dependencies selectively (None = keep existing)
        choice SetDeps : ContractId CommitteeVerifier
            with
                newDeps : SetDepsParams
            controller owner
            do
                let mergedDeps = CommitteeVerifierDeps with
                        rmnRemote = fromOptional deps.rmnRemote newDeps.rmnRemote
                create this with deps = mergedDeps

        -- ==========================================
        -- |           Storage Locations            |
        -- ==========================================

        -- | Initiates the two-step transfer for the storage locations admin role.
        -- Caller must be the current storage locations admin.
        -- @param newAdmin The proposed new storage locations admin party
        choice TransferStorageLocationsAdmin : ContractId CommitteeVerifier
            with
                newAdmin : Party
            controller storageLocationsAdmin
            do
                create this with pendingStorageLocationsAdmin = newAdmin

        -- | Completes the transfer of the storage locations admin role.
        -- Caller must be the proposed new storage locations admin.
        choice AcceptStorageLocationsAdmin : ContractId CommitteeVerifier
            controller pendingStorageLocationsAdmin
            do
                assertMsg "No pending admin transfer to accept" (pendingStorageLocationsAdmin /= storageLocationsAdmin)
                create this with storageLocationsAdmin = pendingStorageLocationsAdmin

        -- | Updates the storage locations identifiers.
        -- Caller must be the storage locations admin.
        -- @param newLocations The new storage location identifiers
        choice UpdateStorageLocations : ContractId CommitteeVerifier
            with
                newLocations : [Text]
            controller storageLocationsAdmin
            do
                create this with storageLocations = newLocations

        -- ==========================================
        -- |   CrossChainVerifier implementation    |
        -- ==========================================

        -- | Verify an inbound message and append CCV verification to ExecutingMessageV1.
        -- Fetches ExecutingMessageV1 for decoded message content and re-encodes
        -- for signature verification (encoding is deterministic).
        nonconsuming choice VerifyMessage : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
            with
                rmnRemoteCid : ContractId CCIP.RMNRemote.RMNRemote
                extraContext : ChoiceContext
                executingMessageCid : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
                verifierResults : BytesHex
                caller : Party
            controller caller
            do
                execMsg <- fetch executingMessageCid
                let message = execMsg.message

                -- Get source chain signature config
                let signerConfig = fromSomeNote "source chain not configured"
                        (Map.lookup message.sourceChainSelector signerConfigs)

                -- Validate RMN instance and check source chain curse
                rmnRemote <- exercise rmnRemoteCid CCIP.RMNRemote.Get with caller
                RawInstanceAddress.assertEqual "verifier: rmn mismatch"
                    rmnRemote.instanceId rmnRemote.rmnOwner deps.rmnRemote
                assertMsg "verifier: executing message rmn mismatch"
                    (execMsg.deps.rmnRemote == deps.rmnRemote)
                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = owner
                    chainSelector = message.sourceChainSelector
                assertMsg "verifier: source chain is cursed" (not isCursed)

                -- Verify version tag matches
                let verifierVersion = fromSomeNote "Failed to extract verifier version" (CCIP.MessageCodecV1.extractBytes verifierResults 0 (byteCount versionTag))
                assertMsg "Invalid CCV Version" (verifierVersion == versionTag)

                let signatureLength = fromSomeNote "Failed to extract signature length" (CCIP.MessageCodecV1.decodeUint16 (fromSomeNote "Failed to extract signature length bytes" (CCIP.MessageCodecV1.extractBytes verifierResults (byteCount versionTag) 2)))
                assertMsg "Invalid verifierResults" ((byteCount verifierResults) == ((byteCount versionTag) + 2 + signatureLength))
                let numberOfSignatures = signatureLength / signature_length
                assertMsg "Insufficient signatures provided" (numberOfSignatures >= signerConfig.threshold)
                let signatureData = fromSomeNote "Failed to extract signature data" (CCIP.MessageCodecV1.extractBytes verifierResults (byteCount versionTag + 2) signatureLength)
                let signatures = parseSignatures signatureData

                -- Matches EVM: signers sign keccak256(versionTag ++ messageHash)
                let signedHash = keccak256 (versionTag <> execMsg.messageId)

                -- Verify signatures
                let validSigners = findValidSigners signedHash signatures signerConfig.signerKeys
                let validSignerCount = countValidSigners validSigners

                -- Check that number of valid signers == number of signatures provided
                assertMsg "Invalid signatures detected" (validSignerCount == numberOfSignatures)

                -- Check threshold requirement
                assertMsg ("Insufficient valid signatures: " <> show validSignerCount <> " < " <> show signerConfig.threshold)
                    (validSignerCount >= signerConfig.threshold)

                -- Append CCV verification to ExecutingMessageV1
                exercise executingMessageCid CCIP.ExecutingMessageV1.AddCCVVerification with
                    ccvInstanceId = instanceId
                    versionTag = versionTag
                    caller = owner

        -- | Calculate fee for outbound message (USD cents only).
        -- Reads destChainSelector from SendingMessageV1, looks up per-chain
        -- fee config, appends fee via AddCCVFee.
        nonconsuming choice CalculateFee
                : ContractId CCIP.SendingMessageV1.SendingMessageV1
            with
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
                extraContext : ChoiceContext
                caller : Party
            controller caller
            do
                sendingMsg <- fetch sendingMessageCid
                assertMsg "verifier: sending message ccipOwner mismatch"
                    (sendingMsg.ccipOwner == ccipOwner)
                let chainConfig = fromSomeNote "no fee config for dest chain"
                        (Map.lookup sendingMsg.destChainSelector remoteChainConfigs)

                exercise sendingMessageCid CCIP.SendingMessageV1.AddCCVFee with
                    ccvInstanceId = instanceId
                    feeUSDCents = chainConfig.feeUSDCents
                    destGasLimit = chainConfig.gasForVerification
                    destBytesOverhead = chainConfig.payloadSizeBytes
                    caller = owner

        -- | Quote fee for outbound message (USD cents only).
        nonconsuming choice GetFee
                : CCIP.Interfaces.CrossChainVerifier.CrossChainVerifierFeeQuote
            with
                destChainSelector : Numeric 0
                caller : Party
            controller caller
            do
                let chainConfig = fromSomeNote "no fee config for dest chain"
                        (Map.lookup destChainSelector remoteChainConfigs)

                pure CCIP.Interfaces.CrossChainVerifier.CrossChainVerifierFeeQuote with
                    ccvInstanceId = instanceId
                    ccvOwner = owner
                    feeUSDCents = chainConfig.feeUSDCents
                    gasForVerification = chainConfig.gasForVerification
                    payloadSizeBytes = chainConfig.payloadSizeBytes

        -- | Forward message for verification. Exercises AddVerifierData
        -- directly on SendingMessageV1.
        nonconsuming choice ForwardToVerifier
                : ContractId CCIP.SendingMessageV1.SendingMessageV1
            with
                rmnRemoteCid : ContractId CCIP.RMNRemote.RMNRemote
                extraContext : ChoiceContext
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
                verifierArgs : BytesHex
                caller : Party
            controller caller
            do
                sendingMsg <- fetch sendingMessageCid
                assertMsg "verifier: sending message ccipOwner mismatch"
                    (sendingMsg.ccipOwner == ccipOwner)

                -- Validate RMN instance and check destination chain curse
                rmnRemote <- exercise rmnRemoteCid CCIP.RMNRemote.Get with caller
                RawInstanceAddress.assertEqual "verifier: rmn mismatch"
                    rmnRemote.instanceId rmnRemote.rmnOwner deps.rmnRemote
                assertMsg "verifier: sending message rmn mismatch"
                    (sendingMsg.deps.rmnRemote == deps.rmnRemote)
                isCursed <- exercise rmnRemoteCid CCIP.RMNRemote.IsCursedForChain with
                    caller = owner
                    chainSelector = sendingMsg.destChainSelector
                assertMsg "verifier: destination chain is cursed" (not isCursed)

                -- Assert that the sender is allowed to send messages if allowlist is enabled for the destination chain
                let destChainConfig = fromSomeNote "no config for dest chain" (Map.lookup sendingMsg.destChainSelector remoteChainConfigs)
                DA.Action.when destChainConfig.allowListEnabled
                    $ assertMsg "Sender not allowed to send messages to destination chain" (caller `elem` destChainConfig.allowedSendersList)

                let verifierBlob = versionTag

                exercise sendingMessageCid CCIP.SendingMessageV1.AddVerifierData with
                    ccvInstanceId = instanceId
                    versionTag = versionTag
                    verifierBlob = verifierBlob
                    messageSentObservers = messageSentObservers
                    caller = owner

        -- ==========================================
        -- |         MCMSReceiver Interface         |
        -- ==========================================

        interface instance MCMSReceiver for CommitteeVerifier where
            view = MCMSReceiverView with
                mcmsController = owner
                instanceId

            mcmsEntrypoint functionName operationData contractIds = do
                let instAddr = instanceId <> "@" <> partyToText owner
                selfCid <- case Map.lookup instAddr contractIds of
                    None -> abort $ "E_SELF_CID_NOT_IN_MAP: " <> instAddr
                    Some cid -> pure (coerceContractId cid : ContractId CommitteeVerifier)

                case functionName of
                    "ApplySignatureConfigs" -> do
                        case decodeApplySignatureConfigsParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: ApplySignatureConfigs"
                            Some (ApplySignatureConfigsParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: ApplySignatureConfigs" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid ApplySignatureConfigs with
                                    sourceChainSelectorsToRemove = sourceChainSelectorsToRemove
                                    signatureConfigs = signatureConfigs
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "SetDynamicConfig" -> do
                        case decodeSetDynamicConfigParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: SetDynamicConfig"
                            Some (SetDynamicConfigParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: SetDynamicConfig" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid SetDynamicConfig with
                                    dynamicConfig = dynamicConfig
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "ApplyRemoteChainConfigUpdates" -> do
                        case decodeApplyRemoteChainConfigUpdatesParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: ApplyRemoteChainConfigUpdates"
                            Some (ApplyRemoteChainConfigUpdatesParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: ApplyRemoteChainConfigUpdates" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid ApplyRemoteChainConfigUpdates with
                                    remoteChainConfigArgs = remoteChainConfigArgs
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "SetDeps" -> do
                        case decodeSetDepsParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: SetDeps"
                            Some (newDeps, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: SetDeps" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid SetDeps with
                                    newDeps = newDeps
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "ApplyAllowListUpdates" -> do
                        case decodeApplyAllowListUpdatesParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: ApplyAllowListUpdates"
                            Some (ApplyAllowListUpdatesParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: ApplyAllowListUpdates" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid ApplyAllowListUpdates with
                                    allowListConfigArgsItems = allowListConfigArgs
                                    caller = caller
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "TransferStorageLocationsAdmin" -> do
                        case decodeTransferStorageLocationsAdminParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: TransferStorageLocationsAdmin"
                            Some (TransferStorageLocationsAdminParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: TransferStorageLocationsAdmin" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid TransferStorageLocationsAdmin with
                                    newAdmin = newAdmin
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "AcceptStorageLocationsAdmin" -> do
                        assertMsg "E_TRAILING_BYTES: AcceptStorageLocationsAdmin" (0 == byteCount operationData)
                        newCid <- exercise selfCid AcceptStorageLocationsAdmin with
                        pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    "UpdateStorageLocations" -> do
                        case decodeUpdateStorageLocationsParamsAt operationData 0 of
                            None -> abort "E_INVALID_PARAMS: UpdateStorageLocations"
                            Some (UpdateStorageLocationsParams{..}, finalOffset) -> do
                                assertMsg "E_TRAILING_BYTES: UpdateStorageLocations" (finalOffset == byteCount operationData)
                                newCid <- exercise selfCid UpdateStorageLocations with
                                    newLocations = newLocations
                                pure (Map.insert instAddr (coerceContractId newCid) contractIds)
                    _ -> abort $ "E_UNKNOWN_FUNCTION: " <> functionName

parseSignatures : BytesHex -> [(BytesHex, BytesHex)]
parseSignatures signatureData =
    let dataLength = byteCount signatureData
        numSignatures = dataLength / signature_length
    in
        map (extractRSComponents signatureData) [0 .. numSignatures - 1]

extractRSComponents : BytesHex -> Int -> (BytesHex, BytesHex)
extractRSComponents signatureData index =
    let offset = index * signature_length
        r = fromSomeNote "Failed to extract r component" (CCIP.MessageCodecV1.extractBytes signatureData offset signature_component_length)
        s = fromSomeNote "Failed to extract s component" (CCIP.MessageCodecV1.extractBytes signatureData (offset + signature_component_length) signature_component_length)
    in
        (r, s)

validateSignature : BytesHex -> PublicKeyHex -> BytesHex -> BytesHex -> Bool
validateSignature messageHash publicKey r s =
  let
    derSignature = CCIP.Crypto.DerEncoding.rawToDerSignature r s
    derPublicKey = CCIP.Crypto.DerEncoding.secp256k1PublicKeyToDer publicKey
  in
    secp256k1WithEcdsaOnly derSignature messageHash derPublicKey

findValidSigners : BytesHex -> [(BytesHex, BytesHex)] -> [BytesHex] -> [(BytesHex, Bool)]
findValidSigners messageHash signatures signerKeys =
    map (\signer -> (signer, isValidSigner messageHash signatures signer)) signerKeys

isValidSigner : BytesHex -> [(BytesHex, BytesHex)] -> BytesHex -> Bool
isValidSigner messageHash signatures signerKey =
    any (uncurry (validateSignature messageHash signerKey)) signatures

countValidSigners : [(BytesHex, Bool)] -> Int
countValidSigners validSignersMap =
    length (filter snd validSignersMap)

isValidSignatureConfig : SignatureConfig -> Bool
isValidSignatureConfig config =
    config.threshold > 0
        && length config.signerKeys >= config.threshold
        && length config.signerKeys == length (dedup config.signerKeys)
