-- | Integration tests for the Initialize choice on CCIP.Registry.BurnMintTokenPool and
-- CCIP.Registry.LockReleaseTokenPool: exercises the full deploy + configure + register flow
-- end-to-end against real templates (Daml Script, no mocking), via a single
-- createAndExerciseCmd - propose admin, accept admin, deploy pool, deploy rate limiters,
-- ApplyChainUpdates, and SetPool, all atomically in one command.
module TokenPoolInitializeTest where

import Daml.Script
import DA.Foldable (mapA_)
import DA.Assert ((===))
import DA.Map qualified as Map
import DA.TextMap qualified as TextMap

import qualified Splice.Api.Token.HoldingV1
import qualified Splice.Api.Token.MetadataV1

import qualified Chainlink.InstanceAddress

import qualified CCIP.CodecV2.FinalityConfig
import qualified CCIP.Registry.RateLimiterV2
import CCIP.Registry.BurnMintTokenPoolV2
import CCIP.Registry.LockReleaseTokenPoolV2
import qualified CCIP.CoreV2.TokenAdminRegistry as TAR

testInitializeBurnMintPool_SelfIssued : Script ()
testInitializeBurnMintPool_SelfIssued = script do
    poolOwner <- allocateParty "pool_owner"
    observerParty <- allocateParty "registry_observer"

    let instanceId = "e2e-burn-mint-pool"
        -- Self-issued: instrumentId.admin must equal the admin party for
        -- ProposeAdministrator's caller == instrumentId.admin check to pass.
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId poolOwner "E2ETOKEN"
        dummyAddr label = Chainlink.InstanceAddress.make label poolOwner

    tarCid <- submit poolOwner do
        createCmd TAR.TokenAdminRegistry with
            instanceId = "e2e-tar"
            ccipOwner = poolOwner
            entryCount = 0

    let lane = CCIP.Registry.BurnMintTokenPoolV2.LaneDeploySpec with
            remoteChainSelector = 1.0
            remotePools = ["1fb477ac89df394bead4f46ad754f8aec70cc0e4"]
            remoteTokenAddress = "cbae4ea0c4c503a582af009bb2b30b75badc1e32"
            inboundCCVs = []
            outboundCCVs = []
            finalityConfig = CCIP.CodecV2.FinalityConfig.WaitForFinality
            inbound = CCIP.Registry.BurnMintTokenPoolV2.RateLimiterDeploySpec with
                instanceId = "e2e-lane-1-in"
                isEnabled = True
                capacity = 1000.0
                rate = 10.0
            outbound = CCIP.Registry.BurnMintTokenPoolV2.RateLimiterDeploySpec with
                instanceId = "e2e-lane-1-out"
                isEnabled = True
                capacity = 1000.0
                rate = 10.0
            inboundCustomFinality = CCIP.Registry.BurnMintTokenPoolV2.RateLimiterDeploySpec with
                instanceId = "e2e-lane-1-in-custom"
                isEnabled = False
                capacity = 0.0
                rate = 0.0

    result <- submit poolOwner do
        createAndExerciseCmd
            CCIP.Registry.BurnMintTokenPoolV2.BurnMintTokenPool with
                instanceId
                poolOwner
                ccipOwner = poolOwner
                instrumentId
                decimals = 18
                rateLimitAdmin = None
                observers = [observerParty]
                remoteChainConfigs = Map.empty
                tokenTransferFeeConfigs = Map.empty
                poolReceiveContext = Splice.Api.Token.MetadataV1.emptyChoiceContext
                transferTimeout = CCIP.Registry.BurnMintTokenPoolV2.Indefinite
                deps = CCIP.Registry.BurnMintTokenPoolV2.BurnMintTokenPoolDeps with
                    tokenAdminRegistry = dummyAddr "dummy-tar"
                    feeQuoter = dummyAddr "dummy-fq"
                    rmnRemote = dummyAddr "dummy-rmn"
            CCIP.Registry.BurnMintTokenPoolV2.Initialize with
                tokenAdminRegistryCid = tarCid
                existingTokenConfigCid = None
                admin = poolOwner
                lanes = [lane]

    -- Registration landed: TokenConfig now has admin = poolOwner and points at the pool.
    Some config <- queryContractId poolOwner result.tokenConfigCid
    config.admin === Some poolOwner
    config.pendingAdmin === None
    config.tokenPool === Some (TAR.PoolRegistration poolOwner instanceId)

    -- The pool itself was deployed with the lane wired up and observer set.
    pools <- query @CCIP.Registry.BurnMintTokenPoolV2.BurnMintTokenPool poolOwner
    case filter (\(_, pool) -> pool.instanceId == instanceId) pools of
        [(_, pool)] -> do
            pool.observers === [observerParty]
            Map.size pool.remoteChainConfigs === 1
        got -> abort ("expected exactly one deployed BurnMintTokenPool, got " <> show (length got))

    -- All three rate limiters for the lane were deployed with observer set.
    length result.rateLimiterCids === 3
    rateLimiters <- query @CCIP.Registry.RateLimiterV2.RateLimiter poolOwner
    let laneRateLimiters = filter (\(_, rl) -> rl.poolInstanceId == instanceId) rateLimiters
    length laneRateLimiters === 3
    mapA_ (\(_, rl) -> rl.observers === [observerParty]) laneRateLimiters

    pure ()

testInitializeLockReleasePool_SelfIssued : Script ()
testInitializeLockReleasePool_SelfIssued = script do
    poolOwner <- allocateParty "pool_owner"
    observerParty <- allocateParty "registry_observer"

    let instanceId = "e2e-lock-release-pool"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId poolOwner "E2ELRTOKEN"
        dummyAddr label = Chainlink.InstanceAddress.make label poolOwner

    tarCid <- submit poolOwner do
        createCmd TAR.TokenAdminRegistry with
            instanceId = "e2e-lr-tar"
            ccipOwner = poolOwner
            entryCount = 0

    let lane = CCIP.Registry.LockReleaseTokenPoolV2.LaneDeploySpec with
            remoteChainSelector = 2.0
            remotePools = ["1fb477ac89df394bead4f46ad754f8aec70cc0e4"]
            remoteTokenAddress = "cbae4ea0c4c503a582af009bb2b30b75badc1e32"
            inboundCCVs = []
            outboundCCVs = []
            finalityConfig = CCIP.CodecV2.FinalityConfig.WaitForFinality
            inbound = CCIP.Registry.LockReleaseTokenPoolV2.RateLimiterDeploySpec with
                instanceId = "e2e-lr-lane-1-in"
                isEnabled = True
                capacity = 1000.0
                rate = 10.0
            outbound = CCIP.Registry.LockReleaseTokenPoolV2.RateLimiterDeploySpec with
                instanceId = "e2e-lr-lane-1-out"
                isEnabled = True
                capacity = 1000.0
                rate = 10.0
            inboundCustomFinality = CCIP.Registry.LockReleaseTokenPoolV2.RateLimiterDeploySpec with
                instanceId = "e2e-lr-lane-1-in-custom"
                isEnabled = False
                capacity = 0.0
                rate = 0.0

    result <- submit poolOwner do
        createAndExerciseCmd
            CCIP.Registry.LockReleaseTokenPoolV2.LockReleaseTokenPool with
                instanceId
                poolOwner
                ccipOwner = poolOwner
                instrumentId
                decimals = 18
                rateLimitAdmin = None
                observers = [observerParty]
                remoteChainConfigs = Map.empty
                tokenTransferFeeConfigs = Map.empty
                poolReceiveContext = Splice.Api.Token.MetadataV1.emptyChoiceContext
                poolReceiveMetadata = Splice.Api.Token.MetadataV1.Metadata with
                    values = TextMap.fromList [("cip-112/receiver.id", "ccip-public")]
                transferTimeout = CCIP.Registry.LockReleaseTokenPoolV2.Indefinite
                deps = CCIP.Registry.LockReleaseTokenPoolV2.LockReleaseTokenPoolDeps with
                    tokenAdminRegistry = dummyAddr "dummy-tar"
                    feeQuoter = dummyAddr "dummy-fq"
                    rmnRemote = dummyAddr "dummy-rmn"
            CCIP.Registry.LockReleaseTokenPoolV2.Initialize with
                tokenAdminRegistryCid = tarCid
                existingTokenConfigCid = None
                admin = poolOwner
                lanes = [lane]

    Some config <- queryContractId poolOwner result.tokenConfigCid
    config.admin === Some poolOwner
    config.tokenPool === Some (TAR.PoolRegistration poolOwner instanceId)

    pools <- query @CCIP.Registry.LockReleaseTokenPoolV2.LockReleaseTokenPool poolOwner
    case filter (\(_, pool) -> pool.instanceId == instanceId) pools of
        [(_, pool)] -> do
            pool.observers === [observerParty]
            Map.size pool.remoteChainConfigs === 1
        got -> abort ("expected exactly one deployed LockReleaseTokenPool, got " <> show (length got))

    length result.rateLimiterCids === 3

    pure ()

-- Reusing an already-registered config: the third-party-admin path. The registry
-- owner proposed the pool owner as admin and they accepted before any pool
-- existed; Initialize must reuse that config. (Previously it re-proposed
-- unconditionally and the TAR aborted: "admin already set".)
testInitializeLockReleasePool_ReusesExistingAcceptedConfig : Script ()
testInitializeLockReleasePool_ReusesExistingAcceptedConfig = script do
    issuer <- allocateParty "issuer"
    registryOwner <- allocateParty "registry_owner"
    poolOwner <- allocateParty "pool_owner" -- the accepted TAR admin (third party)
    observerParty <- allocateParty "registry_observer"

    let instanceId = "e2e-lr-reuse"
        instrumentId = Splice.Api.Token.HoldingV1.InstrumentId issuer "E2ELRREUSE"
        dummyAddr label = Chainlink.InstanceAddress.make label poolOwner

    tarCid <- submit registryOwner do
        createCmd TAR.TokenAdminRegistry with
            instanceId = "e2e-lr-tar-reuse"
            ccipOwner = registryOwner
            entryCount = 0

    -- The instrument is already registered with poolOwner as accepted admin
    -- (registry owner proposes, poolOwner accepts) — before any pool exists.
    proposeResult <- submit registryOwner do
        exerciseCmd tarCid TAR.ProposeAdministrator with
            tokenConfigCid = None
            instrumentId
            newAdmin = poolOwner
            context = Splice.Api.Token.MetadataV1.emptyChoiceContext
            caller = registryOwner
    existingConfigCid <- submit poolOwner do
        exerciseCmd tarCid TAR.AcceptAdminRole with
            tokenConfigCid = proposeResult.tokenConfigCid
            instrumentId
            context = Splice.Api.Token.MetadataV1.emptyChoiceContext
            caller = poolOwner

    result <- submit poolOwner do
        createAndExerciseCmd
            CCIP.Registry.LockReleaseTokenPoolV2.LockReleaseTokenPool with
                instanceId
                poolOwner
                ccipOwner = registryOwner
                instrumentId
                decimals = 18
                rateLimitAdmin = None
                observers = [observerParty]
                remoteChainConfigs = Map.empty
                tokenTransferFeeConfigs = Map.empty
                poolReceiveContext = Splice.Api.Token.MetadataV1.emptyChoiceContext
                poolReceiveMetadata = Splice.Api.Token.MetadataV1.Metadata with
                    values = TextMap.empty
                transferTimeout = CCIP.Registry.LockReleaseTokenPoolV2.Indefinite
                deps = CCIP.Registry.LockReleaseTokenPoolV2.LockReleaseTokenPoolDeps with
                    tokenAdminRegistry = dummyAddr "dummy-tar"
                    feeQuoter = dummyAddr "dummy-fq"
                    rmnRemote = dummyAddr "dummy-rmn"
            CCIP.Registry.LockReleaseTokenPoolV2.Initialize with
                tokenAdminRegistryCid = tarCid
                existingTokenConfigCid = Some existingConfigCid
                admin = poolOwner
                lanes = []

    Some config <- queryContractId poolOwner result.tokenConfigCid
    config.admin === Some poolOwner
    config.pendingAdmin === None
    config.tokenPool === Some (TAR.PoolRegistration poolOwner instanceId)
    pure ()

-- An existing config whose accepted admin is someone else must be rejected
-- (no silent takeover of another admin's registration).
testInitializeLockReleasePool_RejectsAdminMismatch : Script ()
testInitializeLockReleasePool_RejectsAdminMismatch = script do
    issuer <- allocateParty "issuer"
    registryOwner <- allocateParty "registry_owner"
    acceptedAdmin <- allocateParty "accepted_admin"
    poolOwner <- allocateParty "pool_owner"
    observerParty <- allocateParty "registry_observer"

    let instrumentId = Splice.Api.Token.HoldingV1.InstrumentId issuer "E2ELRMISMATCH"
        dummyAddr label = Chainlink.InstanceAddress.make label poolOwner

    tarCid <- submit registryOwner do
        createCmd TAR.TokenAdminRegistry with
            instanceId = "e2e-lr-tar-mismatch"
            ccipOwner = registryOwner
            entryCount = 0

    proposeResult <- submit registryOwner do
        exerciseCmd tarCid TAR.ProposeAdministrator with
            tokenConfigCid = None
            instrumentId
            newAdmin = acceptedAdmin
            context = Splice.Api.Token.MetadataV1.emptyChoiceContext
            caller = registryOwner
    existingConfigCid <- submit acceptedAdmin do
        exerciseCmd tarCid TAR.AcceptAdminRole with
            tokenConfigCid = proposeResult.tokenConfigCid
            instrumentId
            context = Splice.Api.Token.MetadataV1.emptyChoiceContext
            caller = acceptedAdmin

    -- poolOwner is NOT the config's accepted admin -> Initialize must abort.
    submitMustFail poolOwner do
        createAndExerciseCmd
            CCIP.Registry.LockReleaseTokenPoolV2.LockReleaseTokenPool with
                instanceId = "e2e-lr-mismatch"
                poolOwner
                ccipOwner = registryOwner
                instrumentId
                decimals = 18
                rateLimitAdmin = None
                observers = [observerParty]
                remoteChainConfigs = Map.empty
                tokenTransferFeeConfigs = Map.empty
                poolReceiveContext = Splice.Api.Token.MetadataV1.emptyChoiceContext
                poolReceiveMetadata = Splice.Api.Token.MetadataV1.Metadata with
                    values = TextMap.empty
                transferTimeout = CCIP.Registry.LockReleaseTokenPoolV2.Indefinite
                deps = CCIP.Registry.LockReleaseTokenPoolV2.LockReleaseTokenPoolDeps with
                    tokenAdminRegistry = dummyAddr "dummy-tar"
                    feeQuoter = dummyAddr "dummy-fq"
                    rmnRemote = dummyAddr "dummy-rmn"
            CCIP.Registry.LockReleaseTokenPoolV2.Initialize with
                tokenAdminRegistryCid = tarCid
                existingTokenConfigCid = Some existingConfigCid
                admin = poolOwner
                lanes = []

-- Transfer timeout validation: non-positive RelativeHours put executeBefore at
-- or before the current ledger time (factories reject those) — rejected at both
-- pool creation and SetTransferTimeout.
testTransferTimeoutValidation : Script ()
testTransferTimeoutValidation = script do
    poolOwner <- allocateParty "pool_owner"
    observerParty <- allocateParty "registry_observer"
    let instrumentId = Splice.Api.Token.HoldingV1.InstrumentId poolOwner "E2ETIMEOUT"
        dummyAddr label = Chainlink.InstanceAddress.make label poolOwner
        createArgs timeout = CCIP.Registry.LockReleaseTokenPoolV2.LockReleaseTokenPool with
            instanceId = "e2e-lr-timeout"
            poolOwner
            ccipOwner = poolOwner
            instrumentId
            decimals = 18
            rateLimitAdmin = None
            observers = [observerParty]
            remoteChainConfigs = Map.empty
            tokenTransferFeeConfigs = Map.empty
            poolReceiveContext = Splice.Api.Token.MetadataV1.emptyChoiceContext
            poolReceiveMetadata = Splice.Api.Token.MetadataV1.Metadata with
                values = TextMap.empty
            transferTimeout = timeout
            deps = CCIP.Registry.LockReleaseTokenPoolV2.LockReleaseTokenPoolDeps with
                tokenAdminRegistry = dummyAddr "dummy-tar"
                feeQuoter = dummyAddr "dummy-fq"
                rmnRemote = dummyAddr "dummy-rmn"

    -- creation rejects non-positive RelativeHours (ensure)
    submitMustFail poolOwner do
        createCmd (createArgs (CCIP.Registry.LockReleaseTokenPoolV2.RelativeHours 0))
    submitMustFail poolOwner do
        createCmd (createArgs (CCIP.Registry.LockReleaseTokenPoolV2.RelativeHours (-1)))

    poolCid <- submit poolOwner do
        createCmd (createArgs CCIP.Registry.LockReleaseTokenPoolV2.Indefinite)

    -- update path rejects non-positive RelativeHours
    submitMustFail poolOwner do
        exerciseCmd poolCid CCIP.Registry.LockReleaseTokenPoolV2.SetTransferTimeout with
            newTransferTimeout = CCIP.Registry.LockReleaseTokenPoolV2.RelativeHours 0

    -- positive + Indefinite are accepted
    submit poolOwner do
        exerciseCmd poolCid CCIP.Registry.LockReleaseTokenPoolV2.SetTransferTimeout with
            newTransferTimeout = CCIP.Registry.LockReleaseTokenPoolV2.RelativeHours 24
    pure ()

-- RateLimiter ensure: an enabled limiter must satisfy rate <= capacity at
-- creation, matching SetConfig's update-time check.
testRateLimiterEnsureRateLeCapacity : Script ()
testRateLimiterEnsureRateLeCapacity = script do
    poolOwner <- allocateParty "pool_owner"
    observerParty <- allocateParty "registry_observer"
    now <- getTime
    let mkArgs rate = CCIP.Registry.RateLimiterV2.RateLimiter with
            instanceId = "e2e-rl"
            poolInstanceId = "e2e-rl-pool"
            poolOwner
            remoteChainSelector = 1.0
            direction = CCIP.Registry.RateLimiterV2.RateLimitDirection_Inbound
            mode = CCIP.Registry.RateLimiterV2.RateLimitMode_DefaultFinality
            isEnabled = True
            capacity = 100.0
            rate = rate
            tokens = 0.0
            lastUpdated = now
            observers = [observerParty]

    submitMustFail poolOwner do
        createCmd (mkArgs 1000.0)

    submit poolOwner do
        createCmd (mkArgs 100.0)
    pure ()
