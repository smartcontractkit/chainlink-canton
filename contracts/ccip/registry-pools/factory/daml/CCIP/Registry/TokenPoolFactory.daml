-- | One-operation deploy + configure + register for Registry-issued CCIP token pools.
--
-- Deploys the Registry variants of BurnMintTokenPool/LockReleaseTokenPool/RateLimiter
-- (CCIP.Registry.*, contracts/ccip/registry-pools/) - a separate template family from the
-- shared/production ones under contracts/ccip/pools/ and contracts/ccip/rate-limiter/, kept
-- fully isolated so a bug or spam on the registry-discovery side can never affect LINK or
-- other production pool serving. FactoryV2/CCIPFactory does not reference these templates.
--
-- Bundles what is otherwise a multi-step flow (deploy pool -> deploy rate limiters ->
-- ApplyChainUpdates -> TokenAdminRegistry.SetPool) into a single atomic choice per pool
-- type. This requires poolOwner (pool + rate limiter authority) and admin (the TAR
-- instrument admin, from the shared CCIP.CoreV2.TokenAdminRegistry) to both authorize the
-- submission via actAs - for self-issued instruments these are typically the same party,
-- making this fully atomic in one transaction; for DA Registry-issued instruments
-- (admin = registrar), the registrar must co-sign the same submission for full atomicity,
-- otherwise the existing propose/accept TAR flow should be used instead.
module CCIP.Registry.TokenPoolFactory where

import DA.Action (mapA)
import DA.Crypto.Text (BytesHex)
import qualified DA.Map as Map

import qualified Chainlink.InstanceAddress

import qualified Splice.Api.Token.HoldingV1
import qualified Splice.Api.Token.MetadataV1

import qualified CCIP.CodecV2.FinalityConfig
import qualified CCIP.Registry.RateLimiterV2
import qualified CCIP.Registry.BurnMintTokenPoolV2
import qualified CCIP.Registry.BurnMintTokenPoolV2Types
import qualified CCIP.Registry.LockReleaseTokenPoolV2
import qualified CCIP.Registry.LockReleaseTokenPoolV2Types
import qualified CCIP.CoreV2.TokenAdminRegistry as TAR
import CCIP.CoreV2.TokenAdminRegistryTypes (PoolRegistration(..))

-- | Config for one RateLimiter to deploy alongside a lane. Direction/mode are implied by
-- which slot of LaneDeploySpec this occupies, not repeated here.
data RateLimiterDeploySpec = RateLimiterDeploySpec
    with
        instanceId : Text
        isEnabled : Bool
        capacity : Numeric 0
        rate : Numeric 0
    deriving (Eq, Show)

-- | Config for one remote-chain lane: routing/CCV/finality config, plus the three rate
-- limiters to deploy alongside it (matching BurnMintTokenPool/LockReleaseTokenPool's
-- ChainUpdate shape).
data LaneDeploySpec = LaneDeploySpec
    with
        remoteChainSelector : Numeric 0
        remotePools : [BytesHex]
        remoteTokenAddress : BytesHex
        inboundCCVs : [Chainlink.InstanceAddress.RawInstanceAddress]
        outboundCCVs : [Chainlink.InstanceAddress.RawInstanceAddress]
        finalityConfig : CCIP.CodecV2.FinalityConfig.FinalityConfig
        inbound : RateLimiterDeploySpec
        outbound : RateLimiterDeploySpec
        inboundCustomFinality : RateLimiterDeploySpec
    deriving (Eq, Show)

data DeployAndRegisterResult = DeployAndRegisterResult
    with
        poolInstanceAddress : Chainlink.InstanceAddress.RawInstanceAddress
        rateLimiterCids : [ContractId CCIP.Registry.RateLimiterV2.RateLimiter]
        tokenConfigCid : ContractId TAR.TokenConfig
    deriving (Eq, Show)

deployRateLimiter
    : Party
    -> Text
    -> Optional Party
    -> Numeric 0
    -> CCIP.Registry.RateLimiterV2.RateLimitDirection
    -> CCIP.Registry.RateLimiterV2.RateLimitMode
    -> Time
    -> RateLimiterDeploySpec
    -> Update (ContractId CCIP.Registry.RateLimiterV2.RateLimiter)
deployRateLimiter poolOwner poolInstanceId observer remoteChainSelector direction mode now spec =
    create CCIP.Registry.RateLimiterV2.RateLimiter with
        instanceId = spec.instanceId
        poolInstanceId
        poolOwner
        remoteChainSelector
        direction
        mode
        isEnabled = spec.isEnabled
        capacity = spec.capacity
        rate = spec.rate
        tokens = spec.capacity
        lastUpdated = now
        observer

template TokenPoolFactory
    with
        ccipOwner : Party
    where
        signatory ccipOwner

        -- Deploys a CCIP.Registry.BurnMintTokenPool with its lanes and rate limiters, sets
        -- observer on the pool and every rate limiter, proposes+accepts admin for the
        -- instrument if needed, and registers the pool with the shared TokenAdminRegistry -
        -- all as one atomic operation. See module comment for the authorization requirement
        -- (poolOwner + admin must both actAs this submission).
        --
        -- Only supports the self-issued/self-serve admin path: instrumentId.admin must
        -- equal admin, since ProposeAdministrator requires caller == ccipOwner (the
        -- registry's own owner, not available here) or caller == instrumentId.admin, and
        -- this choice calls it with caller = admin. For instruments where the registry
        -- owner must co-sign admin assignment, propose/accept admin separately first, then
        -- call this with existingTokenConfigCid = Some (the resulting cid).
        nonconsuming choice DeployAndRegisterBurnMintPool : DeployAndRegisterResult
            with
                instanceId : Text
                poolOwner : Party
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                decimals : Int
                rateLimitAdmin : Optional Party
                observer : Optional Party
                tokenAdminRegistry : Chainlink.InstanceAddress.RawInstanceAddress
                feeQuoter : Chainlink.InstanceAddress.RawInstanceAddress
                rmnRemote : Chainlink.InstanceAddress.RawInstanceAddress
                poolReceiveContext : Splice.Api.Token.MetadataV1.ChoiceContext
                transferTimeout : CCIP.Registry.BurnMintTokenPoolV2.TransferTimeout
                lanes : [LaneDeploySpec]
                tokenAdminRegistryCid : ContractId TAR.TokenAdminRegistry
                existingTokenConfigCid : Optional (ContractId TAR.TokenConfig)
                admin : Party
            controller poolOwner, admin
            do
                proposeResult <- exercise tokenAdminRegistryCid TAR.ProposeAdministrator with
                    tokenConfigCid = existingTokenConfigCid
                    instrumentId
                    newAdmin = admin
                    context = Splice.Api.Token.MetadataV1.emptyChoiceContext
                    caller = admin
                acceptedTokenConfigCid <- exercise proposeResult.tokenAdminRegistryCid TAR.AcceptAdminRole with
                    tokenConfigCid = proposeResult.tokenConfigCid
                    instrumentId
                    context = Splice.Api.Token.MetadataV1.emptyChoiceContext
                    caller = admin

                now <- getTime
                chainUpdatesAndCids <- mapA (\lane -> do
                    inboundCid <- deployRateLimiter poolOwner instanceId observer
                        lane.remoteChainSelector CCIP.Registry.RateLimiterV2.RateLimitDirection_Inbound
                        CCIP.Registry.RateLimiterV2.RateLimitMode_DefaultFinality now lane.inbound
                    outboundCid <- deployRateLimiter poolOwner instanceId observer
                        lane.remoteChainSelector CCIP.Registry.RateLimiterV2.RateLimitDirection_Outbound
                        CCIP.Registry.RateLimiterV2.RateLimitMode_DefaultFinality now lane.outbound
                    inboundCustomFinalityCid <- deployRateLimiter poolOwner instanceId observer
                        lane.remoteChainSelector CCIP.Registry.RateLimiterV2.RateLimitDirection_Inbound
                        CCIP.Registry.RateLimiterV2.RateLimitMode_CustomFinality now lane.inboundCustomFinality
                    let chainUpdate = CCIP.Registry.BurnMintTokenPoolV2Types.ChainUpdate with
                            remoteChainSelector = lane.remoteChainSelector
                            remotePools = lane.remotePools
                            remoteTokenAddress = lane.remoteTokenAddress
                            inboundCCVs = lane.inboundCCVs
                            outboundCCVs = lane.outboundCCVs
                            finalityConfig = lane.finalityConfig
                            inboundRateLimiter = Chainlink.InstanceAddress.make lane.inbound.instanceId poolOwner
                            inboundCustomBlockConfirmationsRateLimiter = Chainlink.InstanceAddress.make lane.inboundCustomFinality.instanceId poolOwner
                            outboundRateLimiter = Chainlink.InstanceAddress.make lane.outbound.instanceId poolOwner
                    pure (chainUpdate, [inboundCid, outboundCid, inboundCustomFinalityCid])
                    ) lanes

                let chainUpdates = map fst chainUpdatesAndCids
                    rateLimiterCids = concat (map snd chainUpdatesAndCids)

                poolCid <- create CCIP.Registry.BurnMintTokenPoolV2.BurnMintTokenPool with
                    instanceId
                    poolOwner
                    ccipOwner
                    instrumentId
                    decimals
                    rateLimitAdmin
                    observer
                    remoteChainConfigs = Map.empty
                    tokenTransferFeeConfigs = Map.empty
                    poolReceiveContext
                    transferTimeout
                    deps = CCIP.Registry.BurnMintTokenPoolV2.BurnMintTokenPoolDeps with
                        tokenAdminRegistry
                        rmnRemote
                        feeQuoter

                _ <- exercise poolCid CCIP.Registry.BurnMintTokenPoolV2.ApplyChainUpdates with
                    remoteChainSelectorsToRemove = []
                    chainsToAdd = chainUpdates

                newTokenConfigCid <- exercise proposeResult.tokenAdminRegistryCid TAR.SetPool with
                    tokenConfigCid = acceptedTokenConfigCid
                    instrumentId
                    tokenPool = Some PoolRegistration with
                        poolOwner
                        poolInstanceId = instanceId
                    context = Splice.Api.Token.MetadataV1.emptyChoiceContext
                    caller = admin

                pure DeployAndRegisterResult with
                    poolInstanceAddress = Chainlink.InstanceAddress.make instanceId poolOwner
                    rateLimiterCids
                    tokenConfigCid = newTokenConfigCid

        -- Same as DeployAndRegisterBurnMintPool, for CCIP.Registry.LockReleaseTokenPool.
        -- See that choice's comment for the propose/accept-admin authorization requirement.
        nonconsuming choice DeployAndRegisterLockReleasePool : DeployAndRegisterResult
            with
                instanceId : Text
                poolOwner : Party
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                decimals : Int
                rateLimitAdmin : Optional Party
                observer : Optional Party
                tokenAdminRegistry : Chainlink.InstanceAddress.RawInstanceAddress
                feeQuoter : Chainlink.InstanceAddress.RawInstanceAddress
                rmnRemote : Chainlink.InstanceAddress.RawInstanceAddress
                poolReceiveContext : Splice.Api.Token.MetadataV1.ChoiceContext
                transferTimeout : CCIP.Registry.LockReleaseTokenPoolV2.TransferTimeout
                lanes : [LaneDeploySpec]
                tokenAdminRegistryCid : ContractId TAR.TokenAdminRegistry
                existingTokenConfigCid : Optional (ContractId TAR.TokenConfig)
                admin : Party
            controller poolOwner, admin
            do
                proposeResult <- exercise tokenAdminRegistryCid TAR.ProposeAdministrator with
                    tokenConfigCid = existingTokenConfigCid
                    instrumentId
                    newAdmin = admin
                    context = Splice.Api.Token.MetadataV1.emptyChoiceContext
                    caller = admin
                acceptedTokenConfigCid <- exercise proposeResult.tokenAdminRegistryCid TAR.AcceptAdminRole with
                    tokenConfigCid = proposeResult.tokenConfigCid
                    instrumentId
                    context = Splice.Api.Token.MetadataV1.emptyChoiceContext
                    caller = admin

                now <- getTime
                chainUpdatesAndCids <- mapA (\lane -> do
                    inboundCid <- deployRateLimiter poolOwner instanceId observer
                        lane.remoteChainSelector CCIP.Registry.RateLimiterV2.RateLimitDirection_Inbound
                        CCIP.Registry.RateLimiterV2.RateLimitMode_DefaultFinality now lane.inbound
                    outboundCid <- deployRateLimiter poolOwner instanceId observer
                        lane.remoteChainSelector CCIP.Registry.RateLimiterV2.RateLimitDirection_Outbound
                        CCIP.Registry.RateLimiterV2.RateLimitMode_DefaultFinality now lane.outbound
                    inboundCustomFinalityCid <- deployRateLimiter poolOwner instanceId observer
                        lane.remoteChainSelector CCIP.Registry.RateLimiterV2.RateLimitDirection_Inbound
                        CCIP.Registry.RateLimiterV2.RateLimitMode_CustomFinality now lane.inboundCustomFinality
                    let chainUpdate = CCIP.Registry.LockReleaseTokenPoolV2Types.ChainUpdate with
                            remoteChainSelector = lane.remoteChainSelector
                            remotePools = lane.remotePools
                            remoteTokenAddress = lane.remoteTokenAddress
                            inboundCCVs = lane.inboundCCVs
                            outboundCCVs = lane.outboundCCVs
                            finalityConfig = lane.finalityConfig
                            inboundRateLimiter = Chainlink.InstanceAddress.make lane.inbound.instanceId poolOwner
                            inboundCustomBlockConfirmationsRateLimiter = Chainlink.InstanceAddress.make lane.inboundCustomFinality.instanceId poolOwner
                            outboundRateLimiter = Chainlink.InstanceAddress.make lane.outbound.instanceId poolOwner
                    pure (chainUpdate, [inboundCid, outboundCid, inboundCustomFinalityCid])
                    ) lanes

                let chainUpdates = map fst chainUpdatesAndCids
                    rateLimiterCids = concat (map snd chainUpdatesAndCids)

                poolCid <- create CCIP.Registry.LockReleaseTokenPoolV2.LockReleaseTokenPool with
                    instanceId
                    poolOwner
                    ccipOwner
                    instrumentId
                    decimals
                    rateLimitAdmin
                    observer
                    remoteChainConfigs = Map.empty
                    tokenTransferFeeConfigs = Map.empty
                    poolReceiveContext
                    transferTimeout
                    deps = CCIP.Registry.LockReleaseTokenPoolV2.LockReleaseTokenPoolDeps with
                        tokenAdminRegistry
                        rmnRemote
                        feeQuoter

                _ <- exercise poolCid CCIP.Registry.LockReleaseTokenPoolV2.ApplyChainUpdates with
                    remoteChainSelectorsToRemove = []
                    chainsToAdd = chainUpdates

                newTokenConfigCid <- exercise proposeResult.tokenAdminRegistryCid TAR.SetPool with
                    tokenConfigCid = acceptedTokenConfigCid
                    instrumentId
                    tokenPool = Some PoolRegistration with
                        poolOwner
                        poolInstanceId = instanceId
                    context = Splice.Api.Token.MetadataV1.emptyChoiceContext
                    caller = admin

                pure DeployAndRegisterResult with
                    poolInstanceAddress = Chainlink.InstanceAddress.make instanceId poolOwner
                    rateLimiterCids
                    tokenConfigCid = newTokenConfigCid
