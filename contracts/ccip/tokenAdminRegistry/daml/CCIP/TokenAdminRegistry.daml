module CCIP.TokenAdminRegistry where

import DA.Map qualified as Map
import DA.Optional qualified as Optional
import DA.Crypto.Text (BytesHex)

import qualified Splice.Api.Token.HoldingV1

import qualified CCIP.Tickets

template TokenAdminRegistry
    with
        owner : Party
        instanceId : Text

        tokenConfigs : Map.Map Splice.Api.Token.HoldingV1.InstrumentId TokenConfig
    where
        signatory owner

        nonconsuming choice TokenAdminRegistry_GetTokenConfig : Optional TokenConfig
            with
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                caller : Party
            controller caller
            do
                case Map.lookup instrumentId tokenConfigs of
                    None -> return None
                    Some config ->
                        return (Some config)

        choice TokenAdminRegistry_SetPool : ContractId TokenAdminRegistry
            with
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                optTokenPoolOwner : Optional Party
                caller : Party
            controller caller
            do
                case Map.lookup instrumentId tokenConfigs of
                    None ->
                        abort "TokenAdminRegistry_SetPool: No config for instrument"
                    Some config ->
                        case config.admin of
                            None ->
                                abort "TokenAdminRegistry_SetPool: No admin set for instrument"
                            Some admin ->
                                if admin /= caller then
                                    abort "TokenAdminRegistry_SetPool: Caller is not the admin"
                                else do
                                    let updatedConfig = config
                                            with
                                                tokenPoolOwner = optTokenPoolOwner
                                        updatedMap = Map.insert instrumentId updatedConfig tokenConfigs
                                    create this with tokenConfigs = updatedMap

        choice TokenAdminRegistry_AcceptAdminRole : ContractId TokenAdminRegistry
            with
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                caller : Party
            controller caller
            do
                case Map.lookup instrumentId tokenConfigs of
                    None ->
                        abort "TokenAdminRegistry_AcceptAdminRole: No config for instrument"
                    Some config ->
                        case config.pendingAdmin of
                            None ->
                                abort "TokenAdminRegistry_AcceptAdminRole: No pending admin to accept"
                            Some pendingAdmin ->
                                if pendingAdmin /= caller then
                                    abort "TokenAdminRegistry_AcceptAdminRole: Caller is not the pending admin"
                                else do
                                    let updatedConfig = config with
                                            admin = Some pendingAdmin
                                            pendingAdmin = None
                                        updatedMap = Map.insert instrumentId updatedConfig tokenConfigs
                                    create this with tokenConfigs = updatedMap

        choice TokenAdminRegistry_TransferAdminRole : ContractId TokenAdminRegistry
            with
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                newAdmin : Party
                caller : Party
            controller caller
            do
                case Map.lookup instrumentId tokenConfigs of
                    None ->
                        abort "TokenAdminRegistry_TransferAdminRole: No config for instrument"
                    Some config ->
                        case config.admin of
                            None ->
                                abort "TokenAdminRegistry_TransferAdminRole: No admin to transfer"
                            Some currentAdmin ->
                                if currentAdmin /= caller then
                                    abort "TokenAdminRegistry_TransferAdminRole: Caller is not the current admin"
                                else do
                                    let updatedConfig = config with admin = Some newAdmin
                                        updatedMap = Map.insert instrumentId updatedConfig tokenConfigs
                                    create this with tokenConfigs = updatedMap

        nonconsuming choice TokenAdminRegistry_IsAdministrator : Bool
            with
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                administrator : Party
                caller : Party
            controller caller
            do
                case Map.lookup instrumentId tokenConfigs of
                    None -> return False
                    Some config ->
                        return (config.admin == Some administrator)

        -- Propose a new administrator for a token.
        -- Can only be called if no admin is currently set.
        -- Can be called by the admin of the instrument, or the CCIP owner/owner of this registry.
        choice TokenAdminRegistry_ProposeAdministrator : ContractId TokenAdminRegistry
            with
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                newAdmin : Party
                caller : Party
            controller caller
            do
                -- Authorization check: caller must be either the owner or the admin of the instrument
                let isOwner = caller == owner
                    isAdmin = caller == instrumentId.admin
                if not (isOwner || isAdmin) then
                    abort "TokenAdminRegistry_ProposeAdministrator: Caller must be either the registry owner or the token admin"
                else
                    case Map.lookup instrumentId tokenConfigs of
                        None -> do
                            -- Config doesn't exist, create new entry
                            let newConfig = TokenConfig with
                                    admin = None
                                    pendingAdmin = Some newAdmin
                                    tokenPoolOwner = None
                                updatedMap = Map.insert instrumentId newConfig tokenConfigs
                            create this with tokenConfigs = updatedMap
                        Some config ->
                            if Optional.isSome config.admin then
                                abort "TokenAdminRegistry_ProposeAdministrator: Admin already set"
                            else do
                                -- Config exists but admin is not set, update it
                                let updatedConfig = config with pendingAdmin = Some newAdmin
                                    updatedMap = Map.insert instrumentId updatedConfig tokenConfigs
                                create this with tokenConfigs = updatedMap

        -- | Issue a token send ticket for outbound token transfer.
        -- Called by tokenpool after locking tokens.
        -- Validates that caller is the registered pool for the instrument.
        nonconsuming choice TokenAdminRegistry_IssueSendTicket : ContractId CCIP.Tickets.TokenSendTicket
            with
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                poolInstanceId : Text  -- Pool's instanceId for address computation
                sender : Party
                amount : Numeric 0
                sourceTokenAddress : BytesHex
                destTokenAddress : BytesHex
                tokenReceiver : BytesHex
                extraData : BytesHex
                receipt : CCIP.Tickets.Receipt
                poolOwner : Party  -- controller - must be registered pool
            controller poolOwner
            do
                -- Validate poolOwner is the registered pool for this instrument
                case Map.lookup instrumentId tokenConfigs of
                    None ->
                        abort "TokenAdminRegistry_IssueSendTicket: No config for instrument"
                    Some config ->
                        case config.tokenPoolOwner of
                            None ->
                                abort "TokenAdminRegistry_IssueSendTicket: No pool registered for instrument"
                            Some registeredPool ->
                                if registeredPool /= poolOwner then
                                    abort "TokenAdminRegistry_IssueSendTicket: Caller is not the registered pool"
                                else
                                    create CCIP.Tickets.TokenSendTicket with
                                        poolInstanceId = poolInstanceId
                                        poolOwner = poolOwner
                                        ccipOwner = owner
                                        sender = sender
                                        instrumentId = instrumentId
                                        sourceTokenAddress = sourceTokenAddress
                                        amount = amount
                                        destTokenAddress = destTokenAddress
                                        tokenReceiver = tokenReceiver
                                        extraData = extraData
                                        receipt = receipt

        -- | Issue a token receive ticket for inbound token transfer.
        -- Called by OffRamp after successful message verification.
        -- Caller must be ccipOwner (same as registry owner).
        nonconsuming choice TokenAdminRegistry_IssueReceiveTicket : ContractId CCIP.Tickets.TokenReceiveTicket
            with
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                poolOwner : Party
                receiver : Party
                tokenReceiver : Party
                amount : Numeric 0
                messageHash : BytesHex
                sourceChainSelector : Numeric 0
                caller : Party  -- should be ccipOwner (offramp)
            controller caller
            do
                -- Validate caller is the ccipOwner
                assertMsg "TokenAdminRegistry_IssueReceiveTicket: Caller must be ccipOwner"
                    (caller == owner)
                create CCIP.Tickets.TokenReceiveTicket with
                    ccipOwner = owner
                    poolOwner = poolOwner
                    receiver = receiver
                    tokenReceiver = tokenReceiver
                    instrumentId = instrumentId
                    amount = amount
                    messageHash = messageHash
                    sourceChainSelector = sourceChainSelector

        -- | Consume a token receive ticket to authorize token release.
        -- Called by tokenpool when releasing tokens to receiver.
        -- Validates that caller is the registered pool for the destination token.
        choice TokenAdminRegistry_ConsumeReceiveTicket : ConsumeReceiveTicketResult
            with
                ticketCid : ContractId CCIP.Tickets.TokenReceiveTicket
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                poolOwner : Party  -- controller - must be registered pool
            controller poolOwner
            do
                -- Validate poolOwner is the registered pool for this instrument
                case Map.lookup instrumentId tokenConfigs of
                    None ->
                        abort "TokenAdminRegistry_ConsumeReceiveTicket: No config for instrument"
                    Some config ->
                        case config.tokenPoolOwner of
                            None ->
                                abort "TokenAdminRegistry_ConsumeReceiveTicket: No pool registered for instrument"
                            Some registeredPool ->
                                if registeredPool /= poolOwner then
                                    abort "TokenAdminRegistry_ConsumeReceiveTicket: Caller is not the registered pool"
                                else do
                                    -- Fetch and archive the ticket
                                    ticket <- fetch ticketCid
                                    exercise ticketCid CCIP.Tickets.TokenReceiveTicket_Consume
                                    pure ConsumeReceiveTicketResult with
                                        instrumentId = ticket.instrumentId
                                        amount = ticket.amount
                                        receiver = ticket.receiver
                                        tokenReceiver = ticket.tokenReceiver
                                        messageHash = ticket.messageHash
                                        sourceChainSelector = ticket.sourceChainSelector


data TokenConfig = TokenConfig
    with
        admin : Optional Party
        pendingAdmin : Optional Party
        tokenPoolOwner : Optional Party
    deriving (Eq, Show)


data ConsumeReceiveTicketResult = ConsumeReceiveTicketResult
    with
        instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
        amount : Numeric 0
        receiver : Party
        tokenReceiver : Party
        messageHash : BytesHex
        sourceChainSelector : Numeric 0
    deriving (Eq, Show)
