module CCIP.TokenAdminRegistry where

import DA.Map qualified as Map
import DA.Optional (isSome, fromSomeNote)
import DA.Crypto.Text (BytesHex)

import qualified Splice.Api.Token.HoldingV1

import qualified CCIP.Context
import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiverView(..))
import CCIP.TokenAdminRegistryCodec (decodeSetPoolParams, decodeProposeAdminParams, decodeTransferAdminParams, decodeAcceptAdminParams)
import CCIP.TokenAdminRegistryTypes (PoolRegistration(..), TokenConfig(..))

import qualified CCIP.ExecutingMessageV1
import qualified CCIP.MessageCodecV1
import CCIP.RawInstanceAddress (RawInstanceAddress)
import qualified CCIP.RawInstanceAddress
import qualified CCIP.SendingMessageV1
import qualified CCIP.Tickets

tokenAdminRegistryKey : Text
tokenAdminRegistryKey = "token-admin-registry"

lookupTokenAdminRegistryCid : CCIP.Context.CCIPContext -> Update (ContractId TokenAdminRegistry)
lookupTokenAdminRegistryCid ctx =
    CCIP.Context.getFromContextU ctx tokenAdminRegistryKey

template TokenAdminRegistry
    with
        instanceId : Text
        -- owner has to be ccipOwner (ie, the owner of the OffRamp) in order to be able to consume
        -- send tickets
        -- TODO: rename to ccipOwner to be explicit
        owner : Party

        -- | Maps keccak256(InstrumentId) to token configuration
        tokenConfigs : Map.Map BytesHex TokenConfig
    where
        signatory owner

        nonconsuming choice Get : TokenAdminRegistry
            with
                caller : Party
            controller caller
            do pure this

        nonconsuming choice TokenAdminRegistry_GetTokenConfig : Optional TokenConfig
            with
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                caller : Party
            controller caller
            do pure (Map.lookup (CCIP.MessageCodecV1.encodeInstrumentId instrumentId) tokenConfigs)

        choice TokenAdminRegistry_SetPool : ContractId TokenAdminRegistry
            with
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                tokenPool : Optional PoolRegistration
                caller : Party
            controller caller
            do
                case Map.lookup (CCIP.MessageCodecV1.encodeInstrumentId instrumentId) tokenConfigs of
                    None ->
                        abort "TokenAdminRegistry_SetPool: No config for instrument"
                    Some config ->
                        case config.admin of
                            None ->
                                abort "TokenAdminRegistry_SetPool: No admin set for instrument"
                            Some admin ->
                                if admin /= caller then
                                    abort "TokenAdminRegistry_SetPool: Caller is not the admin"
                                else do
                                    let updatedConfig = config with tokenPool
                                        updatedMap = Map.insert (CCIP.MessageCodecV1.encodeInstrumentId instrumentId) updatedConfig tokenConfigs
                                    create this with tokenConfigs = updatedMap

        choice TokenAdminRegistry_AcceptAdminRole : ContractId TokenAdminRegistry
            with
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                caller : Party
            controller caller
            do
                case Map.lookup (CCIP.MessageCodecV1.encodeInstrumentId instrumentId) tokenConfigs of
                    None ->
                        abort "TokenAdminRegistry_AcceptAdminRole: No config for instrument"
                    Some config ->
                        case config.pendingAdmin of
                            None ->
                                abort "TokenAdminRegistry_AcceptAdminRole: No pending admin to accept"
                            Some pendingAdmin ->
                                if pendingAdmin /= caller then
                                    abort "TokenAdminRegistry_AcceptAdminRole: Caller is not the pending admin"
                                else do
                                    let updatedConfig = config with
                                            admin = Some pendingAdmin
                                            pendingAdmin = None
                                        updatedMap = Map.insert (CCIP.MessageCodecV1.encodeInstrumentId instrumentId) updatedConfig tokenConfigs
                                    create this with tokenConfigs = updatedMap

        choice TokenAdminRegistry_TransferAdminRole : ContractId TokenAdminRegistry
            with
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                newAdmin : Party
                caller : Party
            controller caller
            do
                case Map.lookup (CCIP.MessageCodecV1.encodeInstrumentId instrumentId) tokenConfigs of
                    None ->
                        abort "TokenAdminRegistry_TransferAdminRole: No config for instrument"
                    Some config ->
                        case config.admin of
                            None ->
                                abort "TokenAdminRegistry_TransferAdminRole: No admin to transfer"
                            Some currentAdmin ->
                                if currentAdmin /= caller then
                                    abort "TokenAdminRegistry_TransferAdminRole: Caller is not the current admin"
                                else do
                                    let updatedConfig = config with admin = Some newAdmin
                                        updatedMap = Map.insert (CCIP.MessageCodecV1.encodeInstrumentId instrumentId) updatedConfig tokenConfigs
                                    create this with tokenConfigs = updatedMap

        nonconsuming choice TokenAdminRegistry_IsAdministrator : Bool
            with
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                administrator : Party
                caller : Party
            controller caller
            do pure (case Map.lookup (CCIP.MessageCodecV1.encodeInstrumentId instrumentId) tokenConfigs of
                    None -> False
                    Some config -> config.admin == Some administrator)

        -- Propose a new administrator for a token.
        -- Can only be called if no admin is currently set.
        -- Can be called by the admin of the instrument, or the CCIP owner/owner of this registry.
        choice TokenAdminRegistry_ProposeAdministrator : ContractId TokenAdminRegistry
            with
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                newAdmin : Party
                caller : Party
            controller caller
            do
                -- Authorization check: caller must be either the owner or the admin of the instrument
                let isOwner = caller == owner
                    isAdmin = caller == instrumentId.admin
                if not (isOwner || isAdmin) then
                    abort "TokenAdminRegistry_ProposeAdministrator: Caller must be either the registry owner or the token admin"
                else
                    case Map.lookup (CCIP.MessageCodecV1.encodeInstrumentId instrumentId) tokenConfigs of
                        None -> do
                            -- Config doesn't exist, create new entry
                            let newConfig = TokenConfig with
                                    instrumentId = instrumentId
                                    admin = None
                                    pendingAdmin = Some newAdmin
                                    tokenPool = None
                                updatedMap = Map.insert (CCIP.MessageCodecV1.encodeInstrumentId instrumentId) newConfig tokenConfigs
                            create this with tokenConfigs = updatedMap
                        Some config ->
                            if isSome config.admin then
                                abort "TokenAdminRegistry_ProposeAdministrator: Admin already set"
                            else do
                                -- Config exists but admin is not set, update it
                                let updatedConfig = config with pendingAdmin = Some newAdmin
                                    updatedMap = Map.insert (CCIP.MessageCodecV1.encodeInstrumentId instrumentId) updatedConfig tokenConfigs
                                create this with tokenConfigs = updatedMap

        -- | Consume a token receive ticket to authorize token release.
        -- Validates caller is the registered pool owner, ticket was issued by this TAR,
        -- then archives the ticket. Callers should fetch the ticket beforehand to read
        -- its fields (poolOwner is an observer on TokenReceiveTicket).
        nonconsuming choice TokenAdminRegistry_ConsumeReceiveTicket : ()
            with
                ticketCid : ContractId CCIP.Tickets.TokenReceiveTicket
                instrumentId : Splice.Api.Token.HoldingV1.InstrumentId
                caller : Party
            controller caller
            do
                case Map.lookup (CCIP.MessageCodecV1.encodeInstrumentId instrumentId) tokenConfigs of
                    None ->
                        abort "TokenAdminRegistry_ConsumeReceiveTicket: No config for instrument"
                    Some config ->
                        case config.tokenPool of
                            None ->
                                abort "TokenAdminRegistry_ConsumeReceiveTicket: No pool registered for instrument"
                            Some pool ->
                                if pool.poolOwner /= caller then
                                    abort "TokenAdminRegistry_ConsumeReceiveTicket: Caller is not the registered pool owner"
                                else do
                                    ticket <- fetch ticketCid
                                    assertMsg "TokenAdminRegistry_ConsumeReceiveTicket: instanceId mismatch"
                                        (ticket.tokenAdminRegistryInstanceId == instanceId)
                                    assertMsg "TokenAdminRegistry_ConsumeReceiveTicket: owner mismatch"
                                        (ticket.ccipOwner == owner)
                                    assertMsg "TokenAdminRegistry_ConsumeReceiveTicket: ticket instrument must match requested instrument"
                                        (ticket.instrumentId == instrumentId)
                                    archive ticketCid

        -- | Record pool's outbound CCV requirements on a SendingMessageV1.
        -- Validates the caller is the registered pool for the expected token instrument,
        -- then exercises SetOutboundPoolCCVs (authorized via TAR's signatory = ccipOwner).
        nonconsuming choice TokenAdminRegistry_SetOutboundPoolCCVs : ContractId CCIP.SendingMessageV1.SendingMessageV1
            with
                sendingMessageCid : ContractId CCIP.SendingMessageV1.SendingMessageV1
                poolInstanceId : Text
                poolCCVs : [RawInstanceAddress]
                caller : Party
            controller caller
            do
                sm <- fetch sendingMessageCid
                -- Trust model: TAR is currently a concrete trusted internal
                -- dependency chosen by `owner`/`ccipOwner`, not an adversarial
                -- extension point. That is why this code relies on TAR's own
                -- tokenConfigs plus the message-carried TAR snapshot before
                -- mutating SendingMessageV1 under TAR's authority.
                -- TODO: investigate whether we can/should ever have a TAR
                -- interface with this code here. If TAR becomes interface-backed,
                -- re-check whether these mapping reads and snapshot checks are
                -- still the right trust boundary.
                assertMsg "TAR outbound: sendingMessage ccipOwner mismatch" (sm.ccipOwner == owner)
                CCIP.RawInstanceAddress.assertEqual "TAR outbound: instance address mismatch"
                    instanceId owner sm.deps.tokenAdminRegistry

                instrumentId <- case sm.expectedTokenInstrumentId of
                    None -> abort "TAR outbound: missing expected token instrument"
                    Some iid -> pure iid

                config <- case Map.lookup (CCIP.MessageCodecV1.encodeInstrumentId instrumentId) tokenConfigs of
                    None -> abort "TAR outbound: no config for instrument"
                    Some c -> pure c

                pool <- case config.tokenPool of
                    None -> abort "TAR outbound: no pool registered for instrument"
                    Some p -> pure p

                assertMsg "TAR outbound: caller is not registered pool"
                    (caller == pool.poolOwner && poolInstanceId == pool.poolInstanceId)

                exercise sendingMessageCid CCIP.SendingMessageV1.SetOutboundPoolCCVs with
                    poolCCVs

        -- | Record pool's inbound CCV requirements on an ExecutingMessageV1.
        -- Validates the caller is the registered pool for the token in the message,
        -- then exercises SetInboundPoolCCVs (authorized via TAR's signatory = ccipOwner).
        nonconsuming choice TokenAdminRegistry_SetInboundPoolCCVs : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
            with
                executingMessageCid : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
                poolInstanceId : Text
                poolCCVs : [RawInstanceAddress]
                caller : Party
            controller caller
            do
                execMsg <- fetch executingMessageCid
                -- Same trust model as outbound: this is written for concrete TAR
                -- implementations today, and assumes the TAR selected by
                -- `owner`/`ccipOwner` is honest about its mappings and preserves
                -- the snapshot-checking invariants before updating the message.
                assertMsg "TAR: executingMessage ccipOwner mismatch" (execMsg.ccipOwner == owner)
                CCIP.RawInstanceAddress.assertEqual "TAR: instance address mismatch"
                    instanceId owner execMsg.deps.tokenAdminRegistry

                let tt = fromSomeNote
                        "TokenAdminRegistry_SetInboundPoolCCVs: no token transfer in message"
                        execMsg.message.tokenTransfer
                config <- case Map.lookup tt.destTokenAddress tokenConfigs of
                    None -> abort "TokenAdminRegistry_SetInboundPoolCCVs: no config for instrument"
                    Some c -> pure c
                pool <- case config.tokenPool of
                    None -> abort "TokenAdminRegistry_SetInboundPoolCCVs: no pool registered for instrument"
                    Some p -> pure p
                assertMsg "TokenAdminRegistry_SetInboundPoolCCVs: caller is not the registered pool"
                    (caller == pool.poolOwner && poolInstanceId == pool.poolInstanceId)
                exercise executingMessageCid CCIP.ExecutingMessageV1.SetInboundPoolCCVs with
                    poolCCVs

        -- | Resolve token-side finalization data for an inbound token transfer and
        -- exercise ExecutingMessageV1.FinalizeExecute under TAR's signatory context.
        -- OffRamp remains the authority that decides execution is valid and complete.
        nonconsuming choice TokenAdminRegistry_FinalizeExecute : CCIP.ExecutingMessageV1.FinalizeExecuteResult
            with
                executingMessageCid : ContractId CCIP.ExecutingMessageV1.ExecutingMessageV1
                ticketReceiver : Party
                returnData : BytesHex
                caller : Party
            controller caller
            do
                execMsg <- fetch executingMessageCid
                assertMsg "TAR finalize: executingMessage ccipOwner mismatch" (execMsg.ccipOwner == owner)
                CCIP.RawInstanceAddress.assertEqual "TAR finalize: instance address mismatch"
                    instanceId owner execMsg.deps.tokenAdminRegistry

                resolvedTokenReceiver <- case execMsg.tokenReceiver of
                    None -> abort "TAR finalize: expected token transfer"
                    Some p -> pure p

                let tt = fromSomeNote
                        "TAR finalize: tokenReceiver set but no tokenTransfer in message"
                        execMsg.message.tokenTransfer

                config <- case Map.lookup tt.destTokenAddress tokenConfigs of
                    None -> abort "TAR finalize: no config for instrument"
                    Some c -> pure c
                pool <- case config.tokenPool of
                    None -> abort "TAR finalize: no pool registered for instrument"
                    Some p -> pure p

                exercise executingMessageCid CCIP.ExecutingMessageV1.FinalizeExecute with
                    tokenAdminRegistryInstanceId = instanceId
                    maybePoolOwner = Some pool.poolOwner
                    maybeTicketReceiver = Some ticketReceiver
                    maybeTokenReceiver = Some resolvedTokenReceiver
                    maybeInstrumentId = Some config.instrumentId
                    maybeAmount = Some tt.amount
                    returnData = returnData

        interface instance MCMSReceiver for TokenAdminRegistry where
          view = MCMSReceiverView with
            mcmsController = owner
            instanceId

          mcmsEntrypoint functionName operationData contractIds = do
            let instAddr = instanceId <> "@" <> partyToText owner
            selfTarCid <- case Map.lookup instAddr contractIds of
              None -> abort $ "E_SELF_CID_NOT_IN_MAP: " <> instAddr
              Some cid -> pure (coerceContractId cid : ContractId TokenAdminRegistry)

            case functionName of
              "SetPool" -> do
                case decodeSetPoolParams operationData of
                  None -> abort "E_INVALID_PARAMS: SetPool"
                  Some (instrumentId, optPool) -> do
                    newCid <- exercise selfTarCid TokenAdminRegistry_SetPool with
                      instrumentId
                      tokenPool = optPool
                      caller = owner
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              "ProposeAdministrator" -> do
                case decodeProposeAdminParams operationData of
                  None -> abort "E_INVALID_PARAMS: ProposeAdministrator"
                  Some (instrumentId, newAdmin) -> do
                    newCid <- exercise selfTarCid TokenAdminRegistry_ProposeAdministrator with
                      instrumentId
                      newAdmin
                      caller = owner
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              "TransferAdminRole" -> do
                case decodeTransferAdminParams operationData of
                  None -> abort "E_INVALID_PARAMS: TransferAdminRole"
                  Some (instrumentId, newAdmin) -> do
                    newCid <- exercise selfTarCid TokenAdminRegistry_TransferAdminRole with
                      instrumentId
                      newAdmin
                      caller = owner
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              "AcceptAdminRole" -> do
                case decodeAcceptAdminParams operationData of
                  None -> abort "E_INVALID_PARAMS: AcceptAdminRole"
                  Some instrumentId -> do
                    newCid <- exercise selfTarCid TokenAdminRegistry_AcceptAdminRole with
                      instrumentId
                      caller = owner
                    pure (Map.insert instAddr (coerceContractId newCid) contractIds)

              _ -> abort $ "E_UNKNOWN_FUNCTION: " <> functionName
