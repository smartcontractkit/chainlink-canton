module CCIP.Utils.Context where

import DA.Date (date, Month(..), subDate, addDays)
import DA.Time
import DA.TextMap qualified as TextMap
import DA.Crypto.Text (BytesHex)
import DA.Optional (fromSome)

import Splice.Api.Token.MetadataV1

import MCMS.Codec
  ( extractBytes
  , encodeUint8
  , decodeUint8
  , encodeInt64
  , decodeInt64At
  , encodeText
  , decodeTextAt
  , encodeBool
  , decodeBoolAt
  , encodeDecimal
  , decodeDecimalAt
  , encodeList
  , decodeList
  )

-- Choice context creation and parsing
--------------------------------------

-- | Values that can be converted to AnyValue
class ToAnyValue a where
  toAnyValue : a -> AnyValue

-- | Convenience function to create maps that contain an optional value if it is
-- set. See its use sites for examples.
addOptionalAnyValue : ToAnyValue a => Text -> Optional a -> TextMap.TextMap AnyValue -> TextMap.TextMap AnyValue
addOptionalAnyValue _k None m = m
addOptionalAnyValue k (Some value) m = TextMap.insert k (toAnyValue value) m

-- | Attempt to parse a value from AnyValue.
--
-- If a type implements both `ToAnyValue` and `FromAnyValue` then it must hold that
-- `fromAnyValue (toAnyValue x) = Right x` for all `x`.
class FromAnyValue a where
  fromAnyValue : AnyValue -> Either Text a

-- | Lookup and decode a value within a choice context.
lookupFromContext : FromAnyValue a => ChoiceContext -> Text -> Either Text (Optional a)
lookupFromContext context k = do
  case TextMap.lookup k context.values of
    None -> pure None
    Some av -> case fromAnyValue av of
      Left err -> fail $ "Failed to decode context value for '" <> k <> "': " <> err
      Right v -> pure (Some v)

-- | Get a value from a choice context, failing if it is not present or fails to parse.
getFromContext : FromAnyValue a => ChoiceContext -> Text -> Either Text a
getFromContext context k = do
  optValue <- lookupFromContext context k
  case optValue of
    None -> fail $ "Missing context entry for: " <> k
    Some v -> pure v

-- | Convenience version of `lookupFromContext` that raises the failure within the `Update`.
lookupFromContextU : FromAnyValue a => ChoiceContext -> Text -> Update (Optional a)
lookupFromContextU context k = either fail pure $ lookupFromContext context k

-- | Convenience version of `getFromContext` that raises the failure within the `Update`.
getFromContextU : FromAnyValue a => ChoiceContext -> Text -> Update a
getFromContextU context k = either fail pure $ getFromContext context k


-- instances for ToAnyValue
---------------------------

instance ToAnyValue Text where
  toAnyValue t = AV_Text t

instance ToAnyValue Int where
  toAnyValue x = AV_Int x

instance ToAnyValue Decimal where
  toAnyValue t = AV_Decimal t

instance ToAnyValue Bool where
  toAnyValue x = AV_Bool x

instance ToAnyValue Date where
  toAnyValue x = AV_Date x

instance ToAnyValue Time where
  toAnyValue x = AV_Time x

instance ToAnyValue RelTime where
  toAnyValue x = AV_RelTime x
instance ToAnyValue Party where
  toAnyValue p = AV_Party p

instance ToAnyValue (ContractId t) where
  toAnyValue x = AV_ContractId $ coerceContractId x

instance ToAnyValue a => ToAnyValue [a] where
  toAnyValue = AV_List . map toAnyValue

instance ToAnyValue ChoiceContext where
  toAnyValue (ChoiceContext values) = AV_Map values


-- FromAnyValue instances
-------------------------

instance FromAnyValue Text where
  fromAnyValue (AV_Text t) = Right t
  fromAnyValue av = Left $ "expected Text, got: " <> show av

instance FromAnyValue Int where
  fromAnyValue (AV_Int i) = Right i
  fromAnyValue av = Left $ "expected Int, got: " <> show av

instance FromAnyValue Decimal where
  fromAnyValue (AV_Decimal i) = Right i
  fromAnyValue av = Left $ "expected Decimal, got: " <> show av

instance FromAnyValue Bool where
  fromAnyValue (AV_Bool b) = Right b
  fromAnyValue av = Left $ "expected bool, got: " <> show av

instance FromAnyValue Date where
  fromAnyValue (AV_Date p) = Right p
  fromAnyValue av = Left $ "expected Date, got: " <> show av

instance FromAnyValue Time where
  fromAnyValue (AV_Time t) = Right t
  fromAnyValue av = Left $ "expected Time, got: " <> show av
instance FromAnyValue RelTime where
  fromAnyValue (AV_RelTime t) = Right t
  fromAnyValue av = Left $ "expected RelTime, got: " <> show av

instance FromAnyValue Party where
  fromAnyValue (AV_Party p) = Right p
  fromAnyValue av = Left $ "expected Party, got: " <> show av

instance Template t => FromAnyValue (ContractId t) where
  fromAnyValue (AV_ContractId av) = Right (coerceContractId av)
  fromAnyValue av = Left $ "expected contract id, got: " <> show av

instance FromAnyValue a => FromAnyValue [a] where
  fromAnyValue (AV_List avs) = mapA fromAnyValue avs
  fromAnyValue av = Left $ "expected list, got: " <> show av

instance FromAnyValue ChoiceContext where
  fromAnyValue (AV_Map values) = Right $ ChoiceContext with values
  fromAnyValue av = Left $ "expected map, got: " <> show av

instance FromAnyValue AnyValue where
  fromAnyValue av = Right av

instance FromAnyValue (TextMap.TextMap AnyValue) where
  fromAnyValue (AV_Map values) = Right values
  fromAnyValue av = Left $ "expected map, got: " <> show av

instance FromAnyValue (TextMap.TextMap Text) where
  fromAnyValue (AV_Map values) = do
    let kvs = TextMap.toList values
    results <- mapA (\(k, av) -> do
      txt <- fromAnyValue av
      pure (k, txt)) kvs
    pure $ TextMap.fromList results
  fromAnyValue av = Left $ "expected map, got: " <> show av

-- ===========================================================================
-- CHOICECONTEXT ENCODING/DECODING
-- ChoiceContext is a wrapper around TextMap AnyValue
-- ===========================================================================

-- | Encode ChoiceContext as TextMap AnyValue
encodeChoiceContext : ChoiceContext -> BytesHex
encodeChoiceContext (ChoiceContext values) = encodeTextMapAnyValue values

-- | Decode ChoiceContext from bytes
decodeChoiceContextAt : BytesHex -> Int -> Optional (ChoiceContext, Int)
decodeChoiceContextAt encoded offset = do
  (values, newOffset) <- decodeTextMapAnyValueAt encoded offset
  Some (ChoiceContext values, newOffset)

-- ===========================================================================
-- TEXTMAP ANYVALUE ENCODING/DECODING
-- Format: [uint8 count][(text key)(anyvalue value)]*
-- ===========================================================================

-- | Encode TextMap AnyValue
encodeTextMapAnyValue : TextMap.TextMap AnyValue -> BytesHex
encodeTextMapAnyValue m =
  let entries = TextMap.toList m
      count = length entries
      encodeEntry (k, v) = encodeText k <> encodeAnyValue v
  in fromSome (encodeUint8 count) <> foldl (\acc entry -> acc <> encodeEntry entry) "" entries

-- | Decode TextMap AnyValue
decodeTextMapAnyValueAt : BytesHex -> Int -> Optional (TextMap.TextMap AnyValue, Int)
decodeTextMapAnyValueAt encoded offset = do
  countHex <- extractBytes encoded offset 1
  count <- decodeUint8 countHex
  decodeTextMapEntries encoded (offset + 1) count []

-- | Helper to decode TextMap entries
decodeTextMapEntries : BytesHex -> Int -> Int -> [(Text, AnyValue)] -> Optional (TextMap.TextMap AnyValue, Int)
decodeTextMapEntries _ offset 0 acc = Some (TextMap.fromList (reverse acc), offset)
decodeTextMapEntries encoded offset remaining acc = do
  (key, offset1) <- decodeTextAt encoded offset
  (value, offset2) <- decodeAnyValueAt encoded offset1
  decodeTextMapEntries encoded offset2 (remaining - 1) ((key, value) :: acc)

-- ===========================================================================
-- ANYVALUE ENCODING/DECODING
-- Format: [tag byte][variant data]
-- Tags:
--   0x00 = AV_Text
--   0x01 = AV_Int
--   0x02 = AV_Decimal
--   0x03 = AV_Bool
--   0x04 = AV_Date
--   0x05 = AV_Time
--   0x06 = AV_RelTime
--   0x07 = AV_Party
--   0x08 = AV_ContractId
--   0x09 = AV_List
--   0x0A = AV_Map
-- ===========================================================================

-- | Encode AnyValue with tag byte
encodeAnyValue : AnyValue -> BytesHex
encodeAnyValue (AV_Text t) = "00" <> encodeText t
encodeAnyValue (AV_Int i) = "01" <> fromSome (encodeInt64 i)
encodeAnyValue (AV_Decimal d) = "02" <> encodeDecimal d
encodeAnyValue (AV_Bool b) = "03" <> encodeBool b
encodeAnyValue (AV_Date d) = "04" <> encodeDate d
encodeAnyValue (AV_Time t) = "05" <> encodeTime t
encodeAnyValue (AV_RelTime r) = "06" <> encodeRelTime r
encodeAnyValue (AV_Party p) = "07" <> encodePartyValue p
encodeAnyValue (AV_ContractId _) = error "AV_ContractId cannot be encoded: use AddPoolReceiveContextContractValue to pass contract IDs via the MCMS contractIds map"
encodeAnyValue (AV_List items) = "09" <> encodeList items encodeAnyValue
encodeAnyValue (AV_Map m) = "0a" <> encodeTextMapAnyValue m

-- | Decode AnyValue based on tag byte
decodeAnyValueAt : BytesHex -> Int -> Optional (AnyValue, Int)
decodeAnyValueAt encoded offset = do
  tagHex <- extractBytes encoded offset 1
  let tagOffset = offset + 1
  case tagHex of
    "00" -> do  -- AV_Text
      (t, newOffset) <- decodeTextAt encoded tagOffset
      Some (AV_Text t, newOffset)
    "01" -> do  -- AV_Int
      (i, newOffset) <- decodeInt64At encoded tagOffset
      Some (AV_Int i, newOffset)
    "02" -> do  -- AV_Decimal
      (d, newOffset) <- decodeDecimalAt encoded tagOffset
      Some (AV_Decimal d, newOffset)
    "03" -> do  -- AV_Bool
      (b, newOffset) <- decodeBoolAt encoded tagOffset
      Some (AV_Bool b, newOffset)
    "04" -> do  -- AV_Date
      (d, newOffset) <- decodeDateAt encoded tagOffset
      Some (AV_Date d, newOffset)
    "05" -> do  -- AV_Time
      (t, newOffset) <- decodeTimeAt encoded tagOffset
      Some (AV_Time t, newOffset)
    "06" -> do  -- AV_RelTime
      (r, newOffset) <- decodeRelTimeAt encoded tagOffset
      Some (AV_RelTime r, newOffset)
    "07" -> do  -- AV_Party
      (p, newOffset) <- decodePartyValueAt encoded tagOffset
      Some (AV_Party p, newOffset)
    "08" -> None  -- AV_ContractId: not decodable (Daml has no contractIdFromText)
    "09" -> do  -- AV_List
      (items, newOffset) <- decodeList encoded tagOffset decodeAnyValueAt
      Some (AV_List items, newOffset)
    "0a" -> do  -- AV_Map
      (m, newOffset) <- decodeTextMapAnyValueAt encoded tagOffset
      Some (AV_Map m, newOffset)
    _ -> None

-- ===========================================================================
-- DATE ENCODING/DECODING
-- Format: int64 representing days since epoch (1970-01-01)
-- ===========================================================================

-- | Reference epoch for date encoding
epochDate : Date
epochDate = date 1970 Jan 1

-- | Encode Date as days since epoch
encodeDate : Date -> BytesHex
encodeDate d =
  let days = subDate d epochDate
  in fromSome (encodeInt64 days)

-- | Decode Date from days since epoch
decodeDateAt : BytesHex -> Int -> Optional (Date, Int)
decodeDateAt encoded offset = do
  (days, newOffset) <- decodeInt64At encoded offset
  let resultDate = addDays epochDate days
  Some (resultDate, newOffset)

-- ===========================================================================
-- TIME ENCODING/DECODING
-- Format: int64 representing microseconds since Unix epoch
-- ===========================================================================

-- | Reference epoch for time encoding
epochTime : Time
epochTime = time (date 1970 Jan 1) 0 0 0

-- | Encode Time as microseconds since epoch
encodeTime : Time -> BytesHex
encodeTime t =
  let relTime = subTime t epochTime
      micros = convertRelTimeToMicroseconds relTime
  in fromSome (encodeInt64 micros)

-- | Decode Time from microseconds since epoch
decodeTimeAt : BytesHex -> Int -> Optional (Time, Int)
decodeTimeAt encoded offset = do
  (micros, newOffset) <- decodeInt64At encoded offset
  let resultTime = addRelTime epochTime (convertMicrosecondsToRelTime micros)
  Some (resultTime, newOffset)

-- ===========================================================================
-- RELTIME ENCODING/DECODING
-- Format: int64 representing microseconds
-- ===========================================================================

-- | Encode RelTime as microseconds (int64)
encodeRelTime : RelTime -> BytesHex
encodeRelTime r =
  let micros = convertRelTimeToMicroseconds r
  in fromSome (encodeInt64 micros)

-- | Decode RelTime from microseconds (int64)
decodeRelTimeAt : BytesHex -> Int -> Optional (RelTime, Int)
decodeRelTimeAt encoded offset = do
  (micros, newOffset) <- decodeInt64At encoded offset
  Some (convertMicrosecondsToRelTime micros, newOffset)

-- ===========================================================================
-- PARTY ENCODING/DECODING
-- Format: length-prefixed party text
-- ===========================================================================

-- | Encode Party as text
encodePartyValue : Party -> BytesHex
encodePartyValue p = encodeText (partyToText p)

-- | Decode Party from text
decodePartyValueAt : BytesHex -> Int -> Optional (Party, Int)
decodePartyValueAt encoded offset = do
  (text, newOffset) <- decodeTextAt encoded offset
  party <- partyFromText text
  Some (party, newOffset)
