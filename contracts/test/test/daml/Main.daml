module Main where

import DA.Optional

import Daml.Script

import qualified Interface
import qualified Proxy
import qualified Receiver

template DisclosedTarget
  with
    owner : Party
    label : Text
  where
    signatory owner

template ArbitraryCaller
  with
    owner : Party
  where
    signatory owner

    nonconsuming choice Ping : Text
      with
        caller : Party
      controller caller
      do
        pure "pong"

    nonconsuming choice FetchTarget : Text
      with
        caller : Party
        targetCid : ContractId DisclosedTarget
      controller caller
      do
        target <- fetch targetCid
        pure target.label

setup = script do
  ccipOwner <- allocateParty "ccipOwner"
  ccipUser <- allocateParty "ccipUser"

  receiver <- submit ccipUser do
    createCmd Receiver.ReceiverImplementation with
      owner = ccipUser
      value = 42

  _ <- submit ccipUser do
    exerciseCmd (toInterfaceContractId @Interface.IReceiver receiver) Interface.Receiver_EmitEvent with
      eventValue = 123
      caller = ccipUser

  proxy <- submit ccipOwner do
    createCmd Proxy.Proxy with
      owner = ccipOwner

  proxyDisclosure <- fromSome <$> queryDisclosure ccipOwner proxy

  _ <- submit (actAs ccipUser <> disclose proxyDisclosure) do
    exerciseCmd proxy Proxy.Proxy_EmitEvent with
      receiver = toInterfaceContractId @Interface.IReceiver receiver
      eventValue = 456
      caller = ccipUser

  _ <- submit (actAs ccipUser <> disclose proxyDisclosure) do
    exerciseCmd proxy Proxy.Proxy_EmitValue with
      receiver = toInterfaceContractId @Interface.IReceiver receiver
      caller = ccipUser
  

  pure()

testDisclosedExerciseDoesNotAuthorizeDownstreamFetch = script do
  ownerA <- allocateParty "ownerA"
  ownerB <- allocateParty "ownerB"
  caller <- allocateParty "caller"

  targetCid <- submit ownerA do
    createCmd DisclosedTarget with
      owner = ownerA
      label = "secret"

  arbitraryCallerCid <- submit ownerB do
    createCmd ArbitraryCaller with
      owner = ownerB

  targetDisclosure <- fromSome <$> queryDisclosure ownerA targetCid
  arbitraryCallerDisclosure <- fromSome <$> queryDisclosure ownerB arbitraryCallerCid

  pong <- submit (actAs caller <> disclose arbitraryCallerDisclosure) do
    exerciseCmd arbitraryCallerCid Ping with
      caller = caller
  if pong /= "pong"
    then abort "expected disclosed arbitrary-caller exercise to succeed"
    else pure ()

  submit (actAs caller <> disclose arbitraryCallerDisclosure <> disclose targetDisclosure) do
    exerciseCmd arbitraryCallerCid FetchTarget with
      caller = caller
      targetCid = targetCid
