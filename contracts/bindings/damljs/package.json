{
  "name": "@chainlink/canton-contracts",
  "version": "2.3.0",
  "description": "TypeScript bindings for the Chainlink Canton contracts, generated by `dpm codegen-js`",
  "license": "BUSL-1.1",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./*": {
      "types": "./*/index.d.ts",
      "default": "./*/index.js"
    }
  },
  "files": [
    "*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartcontractkit/chainlink-canton.git",
    "directory": "contracts/bindings/damljs"
  },
  "dependencies": {
    "@mojotech/json-type-validation": "^3.1.0"
  },
  "peerDependencies": {
    "@daml/types": "^3.7.3"
  }
}
