-- Uses native keccak256 and secp256k1 for on-chain verification
--
-- ARCHITECTURE:
--   MCMS verifies signatures and merkle proofs, then calls target contracts directly.
--   Target contracts implement MCMSReceiver interface with stable instanceId.
--
-- Direct Invocation Pattern:
--   1. Anyone submits: proofs + signatures + targetCid
--   2. MCMS validates proofs and signatures on-chain
--   3. MCMS verifies target's instanceId matches op.targetInstanceId
--   4. MCMS parses partyId from instanceId (format: baseId@partyId) and verifies signatory
--   5. MCMS calls target.mcmsEntrypoint(functionName, operationData, contractIds)
--   6. ccip_owner authority flows through the call chain
module MCMS.Main where

import DA.Map qualified as Map
import DA.List ((!!))
import DA.Action (unless)
import DA.Foldable (forA_)
import DA.Time (RelTime, seconds, addRelTime)
import DA.Text (parseInt)
import DA.Crypto.Text (BytesHex)
import MCMS.Types
  ( Role(..)
  , roleToText
  , SignerInfo(..)
  , MultisigConfig(..)
  , Op(..)
  , RootMetadata(..)
  , ExpiringRoot(..)
  , RoleState(..)
  , emptyRoleState
  , numGroups
  , maxNumSigners
  , zeroHash
  , doneTimestamp
  , TimelockCall(..)
  , BlockedFunction(..)
  )
import MCMS.GroupVoting
import MCMS.Crypto
import MCMS.MCMSReceiver (MCMSReceiver, MCMSReceiver_Entrypoint(..), parsePartyIdText)
import MCMS.Codec
  ( decodeSetConfigParams
  , decodeBlockedFunction
  , decodeSelfDispatchSetConfig
  , decodeScheduleBatchParams
  , decodeBypasserExecuteBatchParams
  , decodeCancelBatchParams
  )

template MCMS
  with
    owner : Party                              -- ccip_owner party
    instanceId : Text                          -- Stable identifier that doesn't change on updates
    chainId : Int                              -- Chain ID for validation
    proposer : RoleState
    canceller : RoleState
    bypasser : RoleState
    -- Timelock configuration
    minDelay : RelTime                         -- Minimum delay for scheduled operations
    blockedFunctions : [BlockedFunction]         -- Functions that cannot be scheduled (per-target)
    timelockTimestamps : Map.Map Text Time     -- opId -> readyTime (or doneTimestamp if done)
  where
    signatory owner

    -- | Set signer configuration
    -- Validates the configuration and optionally clears the root
    choice SetConfig : ContractId MCMS
      with
        targetRole : Role
        newSigners : [SignerInfo]
        newGroupQuorums : [Int]
        newGroupParents : [Int]
        clearRoot : Bool
      controller owner
      do
        let newConfig = MultisigConfig newSigners newGroupQuorums newGroupParents

        -- Basic validation
        assertMsg "E_TOO_MANY_SIGNERS" $ length newSigners <= maxNumSigners
        assertMsg "E_WRONG_QUORUM_LENGTH" $ length newGroupQuorums == numGroups
        assertMsg "E_WRONG_PARENTS_LENGTH" $ length newGroupParents == numGroups

        -- Validate group tree structure
        assertMsg "E_ROOT_NOT_SELF_PARENT" $ (newGroupParents !! 0) == 0

        let rs = getRoleState targetRole this

        -- Optionally clear the root for the selected role
        let newExpiringRoot = if clearRoot
              then rs.expiringRoot with root = ""
              else rs.expiringRoot

        let newRs = rs with
              config = newConfig
              expiringRoot = newExpiringRoot

        create (setRoleState targetRole newRs this)

    -- | Set new merkle root with on-chain signature verification
    -- All verification happens on-chain using native keccak256 and secp256k1
    -- ANYONE can submit - security comes from signature verification
    choice SetRoot : ContractId MCMS
      with
        targetRole : Role
        submitter : Party                      -- Anyone can submit
        newRoot : BytesHex                     -- New merkle root hash
        validUntil : Time                      -- Expiration time
        metadata : RootMetadata                -- Root metadata
        metadataProof : [BytesHex]             -- Merkle proof for metadata leaf
        signatures : [RawSignature]            -- Raw ECDSA signatures
      controller submitter
      do
        now <- getTime
        let rs = getRoleState targetRole this

        -- 1. Compute signed hash ON-CHAIN using keccak256
        let signedHash = computeSignedHashNative newRoot validUntil

        -- 2. Check not seen before (replay prevention)
        assertMsg ("E_ALREADY_SEEN_HASH: " <> signedHash) $
          not $ Map.member signedHash rs.seenHashes

        -- 3. Validate timestamps
        assertMsg "E_ROOT_EXPIRED" $ now < validUntil

        -- 4. Validate metadata matches this role
        assertMsg ("E_WRONG_CHAIN_ID: expected " <> show chainId) $
          metadata.chainId == chainId
        let expectedMultisigId = makeMcmsId instanceId targetRole
        assertMsg ("E_WRONG_MULTISIG: expected " <> expectedMultisigId) $
          metadata.multisigId == expectedMultisigId
        assertMsg ("E_WRONG_PRE_OP_COUNT: expected " <> show rs.expiringRoot.opCount) $
          metadata.preOpCount == rs.expiringRoot.opCount

        -- 5. Validate op counts
        assertMsg "E_INVALID_OP_COUNTS" $
          metadata.preOpCount <= metadata.postOpCount

        -- 6. Check pending operations
        unless metadata.overridePreviousRoot $
          assertMsg "E_PENDING_OPS" $
            rs.expiringRoot.opCount == rs.rootMetadata.postOpCount

        -- 7. Verify ALL signatures ON-CHAIN using secp256k1
        let validSignerAddrs = verifySignatures signedHash signatures
        assertMsg "E_NO_VALID_SIGNATURES" $
          not $ null validSignerAddrs

        -- 8. Verify metadata Merkle proof ON-CHAIN using keccak256
        let metadataLeaf = hashMetadataLeafNative metadata
        assertMsg "E_INVALID_MERKLE_PROOF" $
          verifyMerkleProof newRoot metadataLeaf metadataProof

        -- 9. Verify group voting with validated signer addresses
        let sortedSignerAddrs = sortAddresses validSignerAddrs
        case verifyGroupVoting sortedSignerAddrs rs.config of
          Left err -> abort err
          Right () -> pure ()

        -- 10. Update per-role state
        let newRs = rs with
              seenHashes = Map.insert signedHash True rs.seenHashes
              expiringRoot = ExpiringRoot newRoot validUntil rs.expiringRoot.opCount
              rootMetadata = metadata

        create (setRoleState targetRole newRs this)

    -- =========================================================================
    -- EXECUTE OPERATION (Main Entry Point - Dispatcher)
    -- Like Aptos execute() - single entry point that dispatches to timelock functions
    -- =========================================================================

    -- | Execute an operation (like Aptos's execute() - single entry point)
    -- This is the main execution flow that dispatches to timelock functions:
    --   1. Validate merkle proof against the root set by SetRoot
    --   2. Decode parameters from op.operationData (like Aptos BCS deserialization)
    --   3. Dispatch based on op.functionName:
    --      - "schedule_batch" → schedule with delay (Proposer role)
    --      - "bypasser_execute_batch" → immediate execution (Bypasser role)
    --      - "cancel_batch" → cancel pending operation (Canceller role)
    --      - "set_config", "clear_root" → MCMS self-dispatch
    --
    -- ANYONE CAN EXECUTE (with disclosures) - Security comes from:
    --   1. Merkle proof verification (operation was approved by signers)
    --   2. Parameters decoded from op.operationData (cryptographically bound)
    --   3. Role validation (each function requires specific role)
    --
    -- Note: targetCids must be passed separately since ContractIds cannot be serialized.
    --       The calls themselves are validated from op.operationData.
    choice ExecuteOp : ContractId MCMS
      with
        targetRole : Role
        submitter : Party                                         -- Anyone can submit
        op : Op                                                   -- Operation details (params in operationData)
        opProof : [BytesHex]                                      -- Merkle proof
        targetCids : Map.Map Text (ContractId MCMSReceiver)       -- Map from instanceId to contract ID
      controller submitter
      do
        now <- getTime
        let rs = getRoleState targetRole this

        -- 1. Validate operation targets this MCMS
        assertMsg ("E_WRONG_CHAIN_ID: op targets " <> show op.chainId) $
          op.chainId == chainId
        assertMsg ("E_WRONG_MULTISIG: op targets " <> op.multisigId) $
          op.multisigId == makeMcmsId instanceId targetRole

        -- 2. Check nonce matches current opCount
        assertMsg ("E_WRONG_NONCE: expected " <> show rs.expiringRoot.opCount <> " got " <> show op.nonce) $
          op.nonce == rs.expiringRoot.opCount

        -- 3. Check root not expired
        assertMsg "E_ROOT_EXPIRED" $ now <= rs.expiringRoot.validUntil

        -- 4. Check we haven't executed all ops for this root
        assertMsg "E_NO_MORE_OPS" $ rs.expiringRoot.opCount < rs.rootMetadata.postOpCount

        -- 5. Verify merkle proof ON-CHAIN using keccak256
        let opLeaf = hashOpLeafNative op
        assertMsg "E_INVALID_OP_MERKLE_PROOF" $
          verifyMerkleProof rs.expiringRoot.root opLeaf opProof

        -- 6. Dispatch based on functionName (like Aptos dispatch_to_timelock)
        --    Parameters are decoded from op.operationData (like Aptos BCS deserialization)
        case op.functionName of
          "ScheduleBatch" -> do
            assertMsg "E_WRONG_ROLE_FOR_SCHEDULE: must use Proposer" $ targetRole == Proposer
            assertMsg "E_NOT_SELF_DISPATCH: targetInstanceId must match instanceId" $
              op.targetInstanceId == instanceId
            case decodeScheduleBatchParams op.operationData of
              None -> abort "E_INVALID_OPERATION_DATA: failed to decode ScheduleBatch params"
              Some params ->
                scheduleBatchInternal now this rs params.calls params.predecessor params.salt (seconds params.delaySecs)

          "BypasserExecuteBatch" -> do
            assertMsg "E_WRONG_ROLE_FOR_BYPASS: must use Bypasser" $ targetRole == Bypasser
            assertMsg "E_NOT_SELF_DISPATCH: targetInstanceId must match instanceId" $
              op.targetInstanceId == instanceId
            case decodeBypasserExecuteBatchParams op.operationData of
              None -> abort "E_INVALID_OPERATION_DATA: failed to decode BypasserExecuteBatch params"
              Some params ->
                bypasserExecuteBatchInternal owner this rs params.calls targetCids

          "CancelBatch" -> do
            assertMsg "E_WRONG_ROLE_FOR_CANCEL: must use Canceller" $ targetRole == Canceller
            assertMsg "E_NOT_SELF_DISPATCH: targetInstanceId must match instanceId" $
              op.targetInstanceId == instanceId
            case decodeCancelBatchParams op.operationData of
              None -> abort "E_INVALID_OPERATION_DATA: failed to decode CancelBatch params"
              Some params ->
                cancelBatchInternal this rs params.opId

          -- Self-dispatch: MCMS configuration changes (admin operations)
          "SetConfig" -> do
            assertMsg "E_NOT_SELF_DISPATCH: targetInstanceId must match instanceId" $
              op.targetInstanceId == instanceId
            case decodeSetConfigParams op.operationData of
              None -> abort "E_INVALID_OPERATION_DATA: failed to decode SetConfig params"
              Some params -> do
                let newConfig = MultisigConfig params.signers params.groupQuorums params.groupParents
                assertMsg "E_TOO_MANY_SIGNERS" $ length newConfig.signers <= maxNumSigners
                assertMsg "E_WRONG_QUORUM_LENGTH" $ length newConfig.groupQuorums == numGroups
                assertMsg "E_WRONG_PARENTS_LENGTH" $ length newConfig.groupParents == numGroups
                assertMsg "E_ROOT_NOT_SELF_PARENT" $ (newConfig.groupParents !! 0) == 0
                let clearedRoot = if params.clearRoot
                      then rs.expiringRoot with root = ""
                      else rs.expiringRoot
                let newExpiringRoot = clearedRoot with opCount = rs.expiringRoot.opCount + 1
                let newRs = rs with config = newConfig, expiringRoot = newExpiringRoot
                create (setRoleState targetRole newRs this)

          "ClearRoot" -> do
            assertMsg "E_NOT_SELF_DISPATCH: targetInstanceId must match instanceId" $
              op.targetInstanceId == instanceId
            let newRs = rs with
                  expiringRoot = rs.expiringRoot with root = "", opCount = rs.expiringRoot.opCount + 1
            create (setRoleState targetRole newRs this)

          _ -> abort $ "E_UNKNOWN_FUNCTION: " <> op.functionName

    -- =========================================================================
    -- TIMELOCK EXECUTION (Post-delay execution)
    -- =========================================================================

    -- | Execute a scheduled batch after delay has passed
    -- This is a public entry point - anyone can execute once ready
    -- (matches Aptos timelock_execute_batch which is also public)
    choice ExecuteScheduledBatch : ContractId MCMS
      with
        submitter : Party                                         -- Anyone can execute
        opId : Text                                               -- Operation ID to execute
        calls : [TimelockCall]                                    -- Caller provides (for execution)
        predecessor : Text                                        -- For validation
        salt : Text                                               -- For opId verification
        targetCids : Map.Map Text (ContractId MCMSReceiver)       -- Map from instanceId to contract ID
      controller submitter
      do
        now <- getTime

        -- 1. Verify opId matches provided data
        let computedOpId = hashTimelockOpId calls predecessor salt
        assertMsg "E_OPID_MISMATCH" $ computedOpId == opId

        -- 2. Lookup in timelockTimestamps
        case Map.lookup opId timelockTimestamps of
          None -> abort "E_OPERATION_NOT_FOUND"
          Some readyTime -> do
            -- 3. Check not already done
            assertMsg "E_ALREADY_EXECUTED" $ readyTime /= doneTimestamp

            -- 4. Check ready time has passed
            assertMsg ("E_NOT_READY: must wait until " <> show readyTime) $
              now >= readyTime

            -- 5. Check predecessor done (if any)
            unless (predecessor == zeroHash) $ do
              case Map.lookup predecessor timelockTimestamps of
                None -> abort "E_PREDECESSOR_NOT_FOUND"
                Some predTime ->
                  assertMsg "E_PREDECESSOR_NOT_DONE" $ predTime == doneTimestamp

            -- 6. Process all calls (self-dispatch inline, external via MCMSReceiver)
            (_, finalMcms) <- processCallsLoop owner targetCids this calls

            -- 7. Mark as done (set to doneTimestamp)
            create (finalMcms with
              timelockTimestamps = Map.insert opId doneTimestamp finalMcms.timelockTimestamps)

    -- =========================================================================
    -- View Functions
    -- =========================================================================

    -- | Check if an operation can be executed
    nonconsuming choice CanExecuteOp : Bool
      with
        submitter : Party                      -- Anyone can query
        targetRole : Role
        op : Op
      controller submitter
      do
        now <- getTime
        let rs = getRoleState targetRole this
        pure $
          op.chainId == chainId &&
          op.multisigId == makeMcmsId instanceId targetRole &&
          op.nonce == rs.expiringRoot.opCount &&
          now <= rs.expiringRoot.validUntil &&
          rs.expiringRoot.opCount < rs.rootMetadata.postOpCount

    -- | Get current state
    nonconsuming choice GetState : MCMSState
      with
        submitter : Party                      -- Anyone can query
        targetRole : Role
      controller submitter
      do
        let rs = getRoleState targetRole this
        pure MCMSState with
          role = targetRole
          opCount = rs.expiringRoot.opCount
          postOpCount = rs.rootMetadata.postOpCount
          validUntil = rs.expiringRoot.validUntil
          hasActiveRoot = rs.expiringRoot.root /= ""
          numSigners = length rs.config.signers

    -- =========================================================================
    -- Timelock View Functions
    -- =========================================================================

    -- | Check if operation exists in timelockTimestamps
    nonconsuming choice IsOperation : Bool
      with
        submitter : Party
        opId : Text
      controller submitter
      do pure $ Map.member opId timelockTimestamps

    -- | Check if operation is pending (scheduled but not done)
    nonconsuming choice IsOperationPending : Bool
      with
        submitter : Party
        opId : Text
      controller submitter
      do
        case Map.lookup opId timelockTimestamps of
          None -> pure False
          Some t -> pure $ t /= doneTimestamp

    -- | Check if operation is ready (delay passed, not done)
    nonconsuming choice IsOperationReady : Bool
      with
        submitter : Party
        opId : Text
      controller submitter
      do
        now <- getTime
        case Map.lookup opId timelockTimestamps of
          None -> pure False
          Some t -> pure $ t /= doneTimestamp && now >= t

    -- | Check if operation is done
    nonconsuming choice IsOperationDone : Bool
      with
        submitter : Party
        opId : Text
      controller submitter
      do
        case Map.lookup opId timelockTimestamps of
          None -> pure False
          Some t -> pure $ t == doneTimestamp

    -- | Get operation timestamp (None if not found)
    nonconsuming choice GetTimestamp : Optional Time
      with
        submitter : Party
        opId : Text
      controller submitter
      do pure $ Map.lookup opId timelockTimestamps

    -- | Get minimum delay
    nonconsuming choice GetMinDelay : RelTime
      with
        submitter : Party
      controller submitter
      do pure minDelay

    nonconsuming choice GetBlockedFunctions : [BlockedFunction]
      with
        submitter : Party
      controller submitter
      do pure blockedFunctions

    nonconsuming choice GetBlockedFunctionsCount : Int
      with
        submitter : Party
      controller submitter
      do pure $ length blockedFunctions

-- ===========================================================================
-- VIEW TYPES
-- ===========================================================================

-- | View of MCMS state
data MCMSState = MCMSState
  with
    role : Role
    opCount : Int
    postOpCount : Int
    validUntil : Time
    hasActiveRoot : Bool
    numSigners : Int
  deriving (Show, Eq)

-- ===========================================================================
-- HELPER FUNCTIONS
-- ===========================================================================

-- | Create multisigId from base ID and role
-- e.g., makeMcmsId "mcms@mcmsPartyId" Proposer = "mcms@mcmsPartyId-proposer"
makeMcmsId : Text -> Role -> Text
makeMcmsId baseId r = baseId <> "-" <> roleToText r

-- | Alias emphasizing role-suffixed multisig ids.
roleMultisigId : Text -> Role -> Text
roleMultisigId = makeMcmsId

getRoleState : Role -> MCMS -> RoleState
getRoleState Proposer m = m.proposer
getRoleState Canceller m = m.canceller
getRoleState Bypasser m = m.bypasser

setRoleState : Role -> RoleState -> MCMS -> MCMS
setRoleState Proposer rs m = m with proposer = rs
setRoleState Canceller rs m = m with canceller = rs
setRoleState Bypasser rs m = m with bypasser = rs

-- | Execute a self-dispatch call (admin operations routed through timelock)
-- This function does NOT perform role checks. This is intentional and safe because:
-- This function is only reachable via two validated paths:
--
--    Path A (Scheduled Execution):
--      ExecuteOp(Proposer, "schedule_batch") → scheduleBatchInternal → [delay passes]
--      → ExecuteScheduledBatch → processCallsLoop → executeSelfDispatch
--      Security: Proposer's merkle proof validated the calls at schedule time.
--
--    Path B (Bypasser Immediate Execution):
--      ExecuteOp(Bypasser, "bypasser_execute_batch") → bypasserExecuteBatchInternal
--      → processCallsLoop → executeSelfDispatch
--      Security: Bypasser's merkle proof validated the calls.
--
-- Supported functions: UpdateMinDelay, BlockFunction, UnblockFunction,
--                      SetConfig, ScheduleBatch, CancelBatch
executeSelfDispatch : MCMS -> TimelockCall -> Update MCMS
executeSelfDispatch mcms call =
  case call.functionName of
    "UpdateMinDelay" ->
      case parseInt call.operationData of
        None -> abort "E_INVALID_DELAY: operationData must be integer seconds"
        Some secs -> pure $ mcms with minDelay = seconds secs

    "BlockFunction" ->
      case decodeBlockedFunction call.operationData of
        None -> abort "E_INVALID_OPERATION_DATA: failed to decode blocked function"
        Some bf ->
          if bf `notElem` mcms.blockedFunctions
          then pure $ mcms with blockedFunctions = bf :: mcms.blockedFunctions
          else pure mcms

    "UnblockFunction" ->
      case decodeBlockedFunction call.operationData of
        None -> abort "E_INVALID_OPERATION_DATA: failed to decode blocked function"
        Some bf -> pure $ mcms with blockedFunctions = filter (/= bf) mcms.blockedFunctions

    "SetConfig" ->
      case decodeSelfDispatchSetConfig call.operationData of
        None -> abort "E_INVALID_OPERATION_DATA: failed to decode SetConfig params"
        Some (targetRole, params) -> do
          let rs = getRoleState targetRole mcms
          let newConfig = MultisigConfig params.signers params.groupQuorums params.groupParents
          assertMsg "E_TOO_MANY_SIGNERS" $ length newConfig.signers <= maxNumSigners
          assertMsg "E_WRONG_QUORUM_LENGTH" $ length newConfig.groupQuorums == numGroups
          assertMsg "E_WRONG_PARENTS_LENGTH" $ length newConfig.groupParents == numGroups
          assertMsg "E_ROOT_NOT_SELF_PARENT" $ (newConfig.groupParents !! 0) == 0
          let clearedRoot = if params.clearRoot
                then rs.expiringRoot with root = ""
                else rs.expiringRoot
          let newRs = rs with config = newConfig, expiringRoot = clearedRoot
          pure $ setRoleState targetRole newRs mcms

    "ScheduleBatch" ->
      case decodeScheduleBatchParams call.operationData of
        None -> abort "E_INVALID_OPERATION_DATA: failed to decode ScheduleBatch params"
        Some params -> do
          now <- getTime
          let delay = seconds params.delaySecs
          assertMsg "E_DELAY_TOO_SHORT" $ delay >= mcms.minDelay
          forA_ params.calls $ \c ->
            assertMsg ("E_FUNCTION_BLOCKED: " <> c.targetInstanceId <> ":" <> c.functionName) $
              BlockedFunction c.targetInstanceId c.functionName `notElem` mcms.blockedFunctions
          let opId = hashTimelockOpId params.calls params.predecessor params.salt
          assertMsg "E_ALREADY_SCHEDULED" $
            not $ Map.member opId mcms.timelockTimestamps
          let readyTime = addRelTime now delay
          pure $ mcms with timelockTimestamps = Map.insert opId readyTime mcms.timelockTimestamps

    "CancelBatch" ->
      case decodeCancelBatchParams call.operationData of
        None -> abort "E_INVALID_OPERATION_DATA: failed to decode CancelBatch params"
        Some params -> do
          case Map.lookup params.opId mcms.timelockTimestamps of
            None -> abort "E_OPERATION_NOT_FOUND"
            Some readyTime -> do
              assertMsg "E_ALREADY_EXECUTED" $ readyTime /= doneTimestamp
              pure $ mcms with timelockTimestamps = Map.delete params.opId mcms.timelockTimestamps

    _ -> abort $ "E_UNKNOWN_SELF_DISPATCH: " <> call.functionName

-- ===========================================================================
-- INTERNAL DISPATCH HELPERS (called by ExecuteOp)
-- These perform the core logic without merkle proof verification
-- (proof is already validated by ExecuteOp before dispatching)
-- ===========================================================================

-- | Schedule a batch of operations (called by ExecuteOp for Proposer role)
-- Does NOT verify merkle proof - ExecuteOp already did that
scheduleBatchInternal : Time -> MCMS -> RoleState -> [TimelockCall] -> Text -> Text -> RelTime -> Update (ContractId MCMS)
scheduleBatchInternal now mcms rs calls predecessor salt delay = do
  -- 1. Validate delay meets minimum
  assertMsg "E_DELAY_TOO_SHORT" $ delay >= mcms.minDelay

  -- 2. Validate no blocked functions in calls (per-target, matching Aptos)
  forA_ calls $ \call ->
    assertMsg ("E_FUNCTION_BLOCKED: " <> call.targetInstanceId <> ":" <> call.functionName) $
      BlockedFunction call.targetInstanceId call.functionName `notElem` mcms.blockedFunctions

  -- 3. Compute opId
  let opId = hashTimelockOpId calls predecessor salt

  -- 4. Check not already scheduled (on-chain duplicate prevention)
  assertMsg "E_ALREADY_SCHEDULED" $
    not $ Map.member opId mcms.timelockTimestamps

  -- 5. Add to map with readyTime + increment proposer opCount
  let readyTime = addRelTime now delay
  let newRs = rs with
        expiringRoot = rs.expiringRoot with opCount = rs.expiringRoot.opCount + 1
  let updated = setRoleState Proposer newRs mcms
  create (updated with timelockTimestamps = Map.insert opId readyTime mcms.timelockTimestamps)

-- | Execute a batch immediately via Bypasser (called by ExecuteOp for Bypasser role)
-- Does NOT verify merkle proof - ExecuteOp already did that
bypasserExecuteBatchInternal : Party -> MCMS -> RoleState -> [TimelockCall] -> Map.Map Text (ContractId MCMSReceiver) -> Update (ContractId MCMS)
bypasserExecuteBatchInternal ownerParty mcms rs calls targetCids = do
  -- 1. Process all calls (self-dispatch inline, external via MCMSReceiver)
  (_, finalMcms) <- processCallsLoop ownerParty targetCids mcms calls

  -- 2. Increment bypasser opCount
  let finalRs = getRoleState Bypasser finalMcms
  let newRs = finalRs with
        expiringRoot = finalRs.expiringRoot with opCount = finalRs.expiringRoot.opCount + 1
  create (setRoleState Bypasser newRs finalMcms)

-- | Cancel a pending operation (called by ExecuteOp for Canceller role)
-- Does NOT verify merkle proof - ExecuteOp already did that
cancelBatchInternal : MCMS -> RoleState -> Text -> Update (ContractId MCMS)
cancelBatchInternal mcms rs opIdToCancel = do
  -- 1. Check operation exists and is pending
  case Map.lookup opIdToCancel mcms.timelockTimestamps of
    None -> abort "E_OPERATION_NOT_FOUND"
    Some readyTime ->
      assertMsg "E_ALREADY_EXECUTED" $ readyTime /= doneTimestamp

  -- 2. Remove from map (cancel) + increment canceller opCount
  let newRs = rs with
        expiringRoot = rs.expiringRoot with opCount = rs.expiringRoot.opCount + 1
  let updated = setRoleState Canceller newRs mcms
  create (updated with timelockTimestamps = Map.delete opIdToCancel mcms.timelockTimestamps)

-- | Process timelock calls: self-dispatch inline, external via MCMSReceiver
-- Uses a map keyed by instanceId to support multiple calls to the same contract.
-- After each external call, the map is updated with the new CID returned from MCMSReceiver_Entrypoint.
processCallsLoop : Party -> Map.Map Text (ContractId MCMSReceiver) -> MCMS -> [TimelockCall] -> Update (Map.Map Text (ContractId MCMSReceiver), MCMS)
processCallsLoop _ cidMap mcms [] = pure (cidMap, mcms)
processCallsLoop ownerParty cidMap mcms (call :: rest)
  | call.targetInstanceId == mcms.instanceId = do
      -- Self-dispatch: no CID lookup needed
      newMcms <- executeSelfDispatch mcms call
      processCallsLoop ownerParty cidMap newMcms rest
  | otherwise = do
      -- External call: look up CID from map by instanceId
      targetCid <- case Map.lookup call.targetInstanceId cidMap of
        None -> abort $ "E_NO_CID_FOR_INSTANCE: " <> call.targetInstanceId
        Some cid -> pure cid

      -- Validate target
      target <- fetch targetCid
      let targetView = view target
      assertMsg ("E_WRONG_TARGET: expected " <> call.targetInstanceId <> " got " <> targetView.instanceId) $
        targetView.instanceId == call.targetInstanceId
      case parsePartyIdText targetView.instanceId of
        None -> abort "E_INVALID_INSTANCE_ID_FORMAT: expected baseId@partyId"
        Some partyIdText ->
          assertMsg "E_TARGET_SIGNATORY_MISMATCH" $
            any (\s -> partyToText s == partyIdText) (signatory target)

      -- Convert typed map to untyped for interface
      let untypedCidMap = Map.fromList [(k, coerceContractId v) | (k, v) <- Map.toList cidMap]

      -- Execute call and get updated map from entrypoint
      -- The entrypoint returns a Map with all updated CIDs (including self)
      returnedCidMap <- exercise targetCid MCMSReceiver_Entrypoint with
        caller = ownerParty
        functionName = call.functionName
        operationData = call.operationData
        contractIds = untypedCidMap

      -- Convert returned map back to typed for next iteration
      let updatedCidMap = Map.fromList [(k, coerceContractId v) | (k, v) <- Map.toList returnedCidMap]

      -- Continue with merged map
      processCallsLoop ownerParty updatedCidMap mcms rest
