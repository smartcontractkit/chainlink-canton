module MCMS.Counter where

import MCMS.MCMSReceiver

-- ===========================================================================
-- MCMS ENTRYPOINT EVENT (Emitted when mcmsEntrypoint is called)
-- ===========================================================================

-- | Event emitted when Counter receives an MCMS call
-- This contract is created and immediately archived to emit an event
-- that can be observed in transaction trees
template MCMSEntrypointEvent
  with
    owner : Party
    instanceId : Text
    functionName : Text
    operationData : Text
    contractIdsAsText : [Text]  -- Contract IDs converted to Text via show
  where
    signatory owner

    -- Immediately archive after creation to make it a pure event
    choice Archive_MCMSEntrypointEvent : ()
      controller owner
      do pure ()

-- ===========================================================================
-- COUNTER CONTRACT (Implements MCMSReceiver)
-- ===========================================================================

-- | Simple counter contract that can be controlled by MCMS
-- Demonstrates the MCMSReceiver interface for direct MCMS calls
--
-- Key fields:
--   - instanceId: Stable identifier in the format "baseId@partyId"
--     This doesn't change when contract state updates (unlike ContractId)
--   - MCMS validates: op.targetInstanceId == instanceId
template Counter
  with
    owner : Party                              -- Same ccip_owner party as MCMS
    instanceId : Text                          -- Stable identifier for MCMS targeting (baseId@partyId)
    value : Int                                -- Current counter value
  where
    signatory owner

    -- Implement MCMSReceiver interface
    interface instance MCMSReceiver for Counter where
      view = MCMSReceiverView with
        owner
        instanceId = instanceId

      mcmsEntrypoint functionName operationData contractIds = do
        -- Emit event with contractIds as text (can be verified in transaction events)
        let contractIdsAsText = map show contractIds
        _ <- create MCMSEntrypointEvent with
          owner
          instanceId
          functionName
          operationData
          contractIdsAsText
        -- Note: Event contract is left active so it appears in flat transaction events
        -- In production, could be archived later or use a different event pattern

        -- Log contractIds to demonstrate they were received and can be coerced
        -- Note: We can't fetch `self` during a consuming choice (it's already being consumed)
        -- In real usage, contractIds would contain OTHER contracts to interact with
        case contractIds of
          [] -> debug "Counter: no contractIds passed"
          cids -> do
            -- Demonstrate coerceContractId works by casting each to ContractId Counter
            -- In production, you'd cast to the appropriate type for each contract
            let counterCids : [ContractId Counter] = map coerceContractId cids
            debug $ "Counter: received " <> show (length counterCids) <> " contractIds (coerced to Counter type)"

        -- Dispatch to the appropriate function
        case functionName of
          "Increment" -> do
            -- Increment counter (operationData ignored)
            debug $ "Counter: incrementing value from " <> show value <> " to " <> show (value + 1)
            newCid <- create this with value = value + 1
            pure (toInterfaceContractId @MCMSReceiver newCid)

          "SetValue" -> do
            -- Set value from operationData
            -- Format: just the integer as decimal string
            let newValue = parseDecimalToInt operationData
            newCid <- create this with value = newValue
            pure (toInterfaceContractId @MCMSReceiver newCid)

          "Reset" -> do
            -- Reset to zero
            newCid <- create this with value = 0
            pure (toInterfaceContractId @MCMSReceiver newCid)

          _ -> abort $ "E_UNKNOWN_FUNCTION: " <> functionName

    -- =========================================================================
    -- QUERIES (Anyone can call with contract disclosure)
    -- =========================================================================

    -- | Get current value (non-consuming query)
    -- Anyone with contract visibility can query
    nonconsuming choice GetValue : Int
      with
        viewer : Party
      controller viewer
      do pure value

    -- | Get instance ID (non-consuming query)
    -- Anyone with contract visibility can query
    nonconsuming choice GetInstanceIdChoice : Text
      with
        viewer : Party
      controller viewer
      do pure instanceId

-- ===========================================================================
-- HELPER FUNCTIONS
-- ===========================================================================

-- | Simple decimal string to int parser for POC
-- In production, use proper parsing
parseDecimalToInt : Text -> Int
parseDecimalToInt t =
  -- For POC, default to 0 if can't parse
  -- In real implementation, would properly parse decimal string
  0
