module MCMS.Counter where

import DA.Map qualified as Map
import DA.Text qualified as T
import MCMS.MCMSReceiver

-- ===========================================================================
-- COUNTER CONTRACT (Implements MCMSReceiver)
-- ===========================================================================

-- | Simple counter contract that can be controlled by MCMS
-- Demonstrates the MCMSReceiver interface for direct MCMS calls
--
-- Key fields:
--   - instanceId: Stable identifier in the format "baseId@partyId"
--     This doesn't change when contract state updates (unlike ContractId)
--   - MCMS validates: op.targetInstanceId == instanceId
template Counter
  with
    owner : Party                              -- Same ccip_owner party as MCMS
    instanceId : Text                          -- Stable identifier for MCMS targeting (baseId@partyId)
    value : Int                                -- Current counter value
  where
    signatory owner

    -- Implement MCMSReceiver interface
    interface instance MCMSReceiver for Counter where
      view = MCMSReceiverView with
        owner
        instanceId = instanceId

      mcmsEntrypoint selfCid functionName operationData contractIds = do
        let selfCounterCid : ContractId Counter = coerceContractId selfCid
        case functionName of
          "Increment" -> do
            newCid <- exercise selfCounterCid Increment
            pure (Map.insert instanceId (coerceContractId newCid) contractIds)

          "SetValue" -> do
            case T.parseInt operationData of
              Some newValue -> do
                newCid <- exercise selfCounterCid (SetValue newValue)
                pure (Map.insert instanceId (coerceContractId newCid) contractIds)
              None -> abort $ "E_INVALID_INT: " <> operationData

          "Reset" -> do
            newCid <- exercise selfCounterCid Reset
            pure (Map.insert instanceId (coerceContractId newCid) contractIds)

          _ -> abort $ "E_UNKNOWN_FUNCTION: " <> functionName

    -- =========================================================================
    -- PUBLIC CHOICES (controlled by owner, callable directly or via MCMS)
    -- =========================================================================

    choice Increment : ContractId Counter
      controller owner
      do create this with value = value + 1

    choice SetValue : ContractId Counter
      with
        newValue : Int
      controller owner
      do create this with value = newValue

    choice Reset : ContractId Counter
      controller owner
      do create this with value = 0

    -- =========================================================================
    -- QUERIES (Anyone can call with contract disclosure)
    -- =========================================================================

    nonconsuming choice GetValue : Int
      with
        viewer : Party
      controller viewer
      do pure value

    nonconsuming choice GetInstanceIdChoice : Text
      with
        viewer : Party
      controller viewer
      do pure instanceId

