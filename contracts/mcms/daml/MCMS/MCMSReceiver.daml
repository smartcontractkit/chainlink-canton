-- | MCMSReceiver Interface for MCMS
-- Target contracts implement this interface to receive calls from MCMS
module MCMS.MCMSReceiver where

import DA.Map qualified as Map
import DA.Text qualified as T

-- ===========================================================================
-- ARGUMENT VALUE TYPE
-- ===========================================================================

-- | Argument value sum type for passing different value types
data ArgValue
  = AV_Text Text
  | AV_Int Int
  | AV_Bool Bool
  | AV_Party Party
  | AV_Time Time
  deriving (Show, Eq)

-- ===========================================================================
-- MCMS RECEIVER INTERFACE
-- ===========================================================================

-- | View for MCMSReceiver interface
data MCMSReceiverView = MCMSReceiverView
  with
    owner : Party
    instanceId : Text  -- Stable identifier that doesn't change when contract updates
  deriving (Show, Eq)

-- | MCMSReceiver interface
-- Target contracts implement this to receive direct calls from MCMS
--
-- Key design:
--   - instanceId: Stable identifier (e.g., "onramp-mainnet-v1")
--   - MCMS validates instanceId matches op.targetInstanceId in the Merkle proof
--   - Delegation pattern: ccip_owner authority flows from MCMS to target
interface MCMSReceiver where
  viewtype MCMSReceiverView

  -- | Entry point for MCMS to call with verified operation
  -- MCMS has already verified the Merkle proof and signatures
  --
  -- Parameters:
  --   selfCid: The contract ID of this MCMSReceiver (passed automatically
  --            by the choice body via `self`; implementors receive it as a parameter)
  --   functionName: The function to call (e.g., "increment", "setConfig")
  --   operationData: Serialized parameters (hex) - contract decodes this
  --   contractIds: Map of instanceId → contractId for any contracts the implementer might need
  --                Receiving contract uses coerceContractId to cast to specific types
  --
  -- Returns: Map of ALL updated CIDs (including self under own instanceId key)
  --          Implementer is responsible for adding their own updated CID to the returned map
  mcmsEntrypoint : ContractId MCMSReceiver -> Text -> Text -> Map.Map Text (ContractId ()) -> Update (Map.Map Text (ContractId ()))

  -- | Non-consuming choice to get instance ID (for validation)
  nonconsuming choice MCMSReceiver_GetInstanceId : Text
    with
      c : Party  -- Controller (anyone can query)
    controller c
    do
      let v = view this
      pure v.instanceId

  -- | Non-consuming choice for MCMS to call with verified operation
  -- Only ccip_owner can call this (MCMS has ccip_owner as signatory)
  -- The implementation dispatches based on functionName by exercising
  -- consuming sub-choices on the implementing template.
  -- Uses `self` (available in all choice bodies) to pass own CID to mcmsEntrypoint.
  nonconsuming choice MCMSReceiver_Entrypoint : Map.Map Text (ContractId ())
    with
      caller : Party                              -- Must be ccip_owner (MCMS passes this through)
      functionName : Text                         -- Function to execute
      operationData : Text                        -- Serialized parameters (hex)
      contractIds : Map.Map Text (ContractId ())  -- Map of instanceId → contractId for target to use
    controller caller
    do
      ((((this `mcmsEntrypoint` self) functionName) operationData) contractIds)

-- ===========================================================================
-- HELPER FUNCTIONS
-- ===========================================================================

-- | Parse partyId from instanceId format "baseId@partyId"
-- Returns the partyId text after the @ separator
parsePartyIdText : Text -> Optional Text
parsePartyIdText instanceId =
  case T.splitOn "@" instanceId of
    [_baseId, partyId] -> Some partyId
    _ -> None
