-- | MCMSReceiver Interface for MCMS
-- Target contracts implement this interface to receive calls from MCMS
module MCMS.MCMSReceiver where

import DA.Map qualified as Map
import DA.Crypto.Text (BytesHex)

-- ===========================================================================
-- ARGUMENT VALUE TYPE
-- ===========================================================================

-- | Argument value sum type for passing different value types
data ArgValue
  = AV_Text Text
  | AV_Int Int
  | AV_Bool Bool
  | AV_Party Party
  | AV_Time Time
  deriving (Show, Eq)

-- ===========================================================================
-- MCMS RECEIVER INTERFACE
-- ===========================================================================

-- | View data for MCMSReceiver interface
--
-- instanceId: A unique, immutable identifier for the contract (e.g., "onramp-mainnet-v1")
--             This NEVER changes, even when the contract is updated or signatory changes.
--
-- instanceAddress: CALCULATED as "instanceId@partyId" (follows MCMS.RawInstanceAddress pattern)
--   - Created using: RawInstanceAddress.makeText instanceId owner
--   - The caller can calculate the full instanceAddress using the view's instanceId and owner
--
-- IMPORTANT: Implementers of MCMSReceiver MUST:
--   1. Store instanceId (stable identifier) in the template, NOT the full instanceAddress
--   2. Calculate instanceAddress = RawInstanceAddress.makeText instanceId owner when needed
--   3. Look up their own ContractId from the contractIds map using the calculated instanceAddress
--   4. After exercising any consuming choice, insert the NEW ContractId into the map
--      under the instanceAddress key before returning
--   5. Return the updated contractIds map from mcmsEntrypoint
--
-- Example implementation pattern:
--   mcmsEntrypoint functionName operationData contractIds = do
--     let instanceAddress = RawInstanceAddress.makeText instanceId owner
--     selfCid <- case Map.lookup instanceAddress contractIds of
--       None -> abort "E_SELF_CID_NOT_IN_MAP"
--       Some cid -> pure (coerceContractId cid)
--     case functionName of
--       "DoSomething" -> do
--         newCid <- exercise selfCid DoSomething
--         pure (Map.insert instanceAddress (coerceContractId newCid) contractIds)
--
data MCMSReceiverView = MCMSReceiverView
  with
    mcmsController : Party  -- Party authorized to invoke MCMSReceiver_Entrypoint
    instanceId : Text       -- Stable identifier (without @partyId suffix)
  deriving (Show, Eq)

-- | MCMSReceiver interface
-- Target contracts implement this to receive direct calls from MCMS
--
-- Key design:
--   - instanceId: Stable identifier stored in template (does NOT contain @partyId)
--   - instanceAddress: CALCULATED as RawInstanceAddress.makeText instanceId owner
--   - MCMS parses instanceId from call.targetInstanceAddress (merkle leaf)
--   - MCMS validates instanceId matches targetView.instanceId
--   - MCMS validates the signatory matches the partyId parsed from call.targetInstanceAddress
--   - Delegation pattern: ccip_owner authority flows from MCMS to target
interface MCMSReceiver where
  viewtype MCMSReceiverView

  -- | Entry point for MCMS to call with verified operation
  -- MCMS has already verified the Merkle proof and signatures
  --
  -- Parameters:
  --   functionName: The function to call (e.g., "Increment", "SetConfig")
  --   operationData: Serialized parameters (BytesHex) - contract decodes this (uint16 length prefix)
  --   contractIds: Map of instanceAddress → contractId for any contracts the implementer might need
  --                Receiving contract uses coerceContractId to cast to specific types
  --                IMPORTANT: This map includes the receiver's own CID under its calculated instanceAddress
  --
  -- Returns: Map of ALL updated CIDs (including self under own instanceAddress key)
  --          Implementer is responsible for adding their own updated CID to the returned map
  mcmsEntrypoint : Text -> BytesHex -> Map.Map Text (ContractId ()) -> Update (Map.Map Text (ContractId ()))

  -- | Non-consuming choice for MCMS to call with verified operation
  -- Only ccip_owner can call this (MCMS has ccip_owner as signatory)
  -- The implementation dispatches based on functionName by exercising
  -- consuming sub-choices on the implementing template.
  -- The implementer looks up their own CID from contractIds map.
  nonconsuming choice MCMSReceiver_Entrypoint : Map.Map Text (ContractId ())
    with
      functionName : Text                         -- Function to execute
      operationData : BytesHex                    -- Serialized parameters (hex) - uint16 length prefix
      contractIds : Map.Map Text (ContractId ())  -- Map of instanceAddress → contractId for target to use
    controller (view this).mcmsController
    do
      (((this `mcmsEntrypoint` functionName) operationData) contractIds)


