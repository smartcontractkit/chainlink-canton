import DA.Crypto.Text (BytesHex, toHex, fromHex, byteCount, packHexBytes)
import qualified DA.Text as Text
import DA.Optional (fromSome)
import DA.Foldable ()
import DA.Numeric (shift)
import MCMS.Types (SignerInfo(..), Role(..), BlockedFunction(..), TimelockCall(..), intToRole)

-- ===========================================================================
-- SET CONFIG PARAMETERS
-- ===========================================================================

-- | Parameters for set_config admin operation
-- Encoded format:
--   numSigners (1 byte)
--   for each signer:
--     addressLen (1 byte) + address (variable)
--     signerIndex (4 bytes)
--     signerGroup (4 bytes)
--   numQuorums (1 byte) + quorums (numQuorums * 4 bytes)
--   numParents (1 byte) + parents (numParents * 4 bytes)
--   clearRoot (1 byte)
data SetConfigParams = SetConfigParams
  with
    signers : [SignerInfo]
    groupQuorums : [Int]
    groupParents : [Int]
    clearRoot : Bool
  deriving (Show, Eq)

-- | Encode SetConfigParams to bytes
encodeSetConfigParams : SetConfigParams -> BytesHex
encodeSetConfigParams params =
  let
    -- Encode signers
    signersEncoded = encodeList params.signers encodeSignerInfo

    -- Encode quorums
    quorumsEncoded = encodeList params.groupQuorums (fromSome . encodeUint32)

    -- Encode parents
    parentsEncoded = encodeList params.groupParents (fromSome . encodeUint32)

    -- Encode clearRoot
    clearRootEncoded = encodeBool params.clearRoot
  in
    signersEncoded <> quorumsEncoded <> parentsEncoded <> clearRootEncoded

-- | Decode SetConfigParams from bytes
decodeSetConfigParams : BytesHex -> Optional SetConfigParams
decodeSetConfigParams encoded = decodeSetConfigParamsAtOffset encoded 0

-- | Decode SetConfigParams starting at a byte offset
decodeSetConfigParamsAtOffset : BytesHex -> Int -> Optional SetConfigParams
decodeSetConfigParamsAtOffset encoded startOffset = do
  (params, _) <- decodeSetConfigParamsAtOffsetWithFinal encoded startOffset
  Some params

-- | Decode SetConfigParams starting at a byte offset, returning final offset
decodeSetConfigParamsAtOffsetWithFinal : BytesHex -> Int -> Optional (SetConfigParams, Int)
decodeSetConfigParamsAtOffsetWithFinal encoded startOffset = do
  (signers, offset1) <- decodeList encoded startOffset decodeSignerInfo
  (quorums, offset2) <- decodeList encoded offset1 decodeUint32WithOffset
  (parents, offset3) <- decodeList encoded offset2 decodeUint32WithOffset
  clearRootHex <- extractBytes encoded offset3 1
  clearRoot <- decodeBool clearRootHex
  let finalOffset = offset3 + 1
  return (SetConfigParams
    { signers = signers
    , groupQuorums = quorums
    , groupParents = parents
    , clearRoot = clearRoot
    }, finalOffset)

-- ===========================================================================
-- SIGNER INFO ENCODING
-- ===========================================================================

-- | Encode a single SignerInfo
-- Format: addressLen (1 byte) + address (raw bytes) + signerIndex (4 bytes) + signerGroup (4 bytes)
-- Note: signerAddress is already hex (e.g., "1375dc8a..."), so we use it directly
-- The addressLen is the number of BYTES (not hex chars), so 40 hex chars = 20 bytes
encodeSignerInfo : SignerInfo -> BytesHex
encodeSignerInfo si =
  let
    -- signerAddress is already a hex string like "1375dc8a4c1476e6628b03216545e5cdcbff3f84"
    -- byteCount gives us the number of bytes this hex represents
    addressLen = byteCount si.signerAddress
  in
    fromSome (encodeUint8 addressLen)
    <> si.signerAddress  -- Already hex, use directly
    <> fromSome (encodeUint32 si.signerIndex)
    <> fromSome (encodeUint32 si.signerGroup)

-- | Decode a SignerInfo starting at offset, returns (SignerInfo, newOffset)
decodeSignerInfo : BytesHex -> Int -> Optional (SignerInfo, Int)
decodeSignerInfo encoded offset = do
  -- Decode address length (in bytes)
  addrLenHex <- extractBytes encoded offset 1
  addrLen <- decodeUint8 addrLenHex

  -- Decode address - the extracted bytes ARE the hex address string
  -- addrLen is in bytes, so we extract addrLen bytes (= addrLen * 2 hex chars)
  addrHex <- extractBytes encoded (offset + 1) addrLen
  -- addrHex IS the address - no further conversion needed

  -- Decode signerIndex
  indexHex <- extractBytes encoded (offset + 1 + addrLen) 4
  index <- decodeUint32 indexHex

  -- Decode signerGroup
  groupHex <- extractBytes encoded (offset + 1 + addrLen + 4) 4
  group <- decodeUint32 groupHex

  let newOffset = offset + 1 + addrLen + 4 + 4
  return (SignerInfo addrHex index group, newOffset)

-- ===========================================================================
-- PRIMITIVE ENCODING/DECODING (from MessageCodecV1 patterns)
-- ===========================================================================

-- | Extract bytes from a hex string
extractBytes : BytesHex -> Int -> Int -> Optional BytesHex
extractBytes bs start len =
  let totalLen = byteCount bs
      endPos = start + len
  in
    if start >= 0 && len >= 0 && start <= totalLen && endPos <= totalLen
    then Some(Text.take (len*2) (Text.drop (start*2) bs))
    else None

-- | Encode uint8 (1 byte)
encodeUint8 : Int -> Optional BytesHex
encodeUint8 n =
  if n < 0 || n > 255 then None
  else packHexBytes (toHex n) 1

-- | Decode uint8 (1 byte)
decodeUint8 : BytesHex -> Optional Int
decodeUint8 hex =
  if byteCount hex /= 1 then None
  else fromHex hex

-- | Encode uint32 (4 bytes)
encodeUint32 : Int -> Optional BytesHex
encodeUint32 n =
  if n < 0 || n > 4294967295 then None
  else packHexBytes (toHex n) 4

-- | Decode uint32 (4 bytes)
decodeUint32 : BytesHex -> Optional Int
decodeUint32 hex =
  if byteCount hex /= 4 then None
  else fromHex hex

-- | Decode uint32 with offset, returns (value, newOffset)
decodeUint32WithOffset : BytesHex -> Int -> Optional (Int, Int)
decodeUint32WithOffset encoded offset = do
  hex <- extractBytes encoded offset 4
  value <- decodeUint32 hex
  return (value, offset + 4)

-- | Encode uint16 (2 bytes) - for long fields like operationData
encodeUint16 : Int -> Optional BytesHex
encodeUint16 n =
  if n < 0 || n > 65535 then None
  else packHexBytes (toHex n) 2

-- | Decode uint16 (2 bytes)
decodeUint16 : BytesHex -> Optional Int
decodeUint16 hex =
  if byteCount hex /= 2 then None
  else fromHex hex

-- | Decode uint16 with offset, returns (value, newOffset)
decodeUint16At : BytesHex -> Int -> Optional (Int, Int)
decodeUint16At encoded offset = do
  hex <- extractBytes encoded offset 2
  value <- decodeUint16 hex
  return (value, offset + 2)

-- | Encode int64 (8 bytes) as big-endian two's complement.
-- Negative values use nibble-flip: encode |n|-1, then flip every hex digit.
-- This avoids 64-bit overflow and matches Go's binary.Write(BigEndian, int64)
-- which casts int64→uint64 (bit-preserving) then writes 8 bytes MSB-first:
-- https://github.com/golang/go/blob/3c4102bfd4dc/src/encoding/binary/binary.go#L561-L562
-- https://github.com/golang/go/blob/3c4102bfd4dc/src/encoding/binary/binary.go#L207-L218
encodeInt64 : Int -> Optional BytesHex
encodeInt64 n
  | n >= 0    = Some (toHex n)
  | otherwise = Some (flipHexString (toHex (negate (n + 1))))

-- | Decode int64 (8 bytes) from big-endian two's complement.
-- High nibble >= 8 indicates a negative value; flip and negate to recover.
-- Inverse of encodeInt64; matches Go's binary.Read which reads 8 bytes as
-- uint64 then casts back to int64:
-- https://github.com/golang/go/blob/3c4102bfd4dc/src/encoding/binary/binary.go#L201-L205
-- https://github.com/golang/go/blob/3c4102bfd4dc/src/encoding/binary/binary.go#L346-L347
decodeInt64 : BytesHex -> Optional Int
decodeInt64 hex
  | byteCount hex /= 8 = None
  | Text.take 1 hex >= "8" = do
      k <- fromHex (flipHexString hex)
      Some (negate k - 1)
  | otherwise = fromHex hex

-- | Decode int64 at offset, returns (value, newOffset)
decodeInt64At : BytesHex -> Int -> Optional (Int, Int)
decodeInt64At encoded offset = do
  hex <- extractBytes encoded offset 8
  value <- decodeInt64 hex
  return (value, offset + 8)

-- | Encode text as length-prefixed bytes
encodeText : Text -> BytesHex
encodeText t =
  let hex = toHex t
      len = byteCount hex
  in fromSome (encodeUint8 len) <> hex

-- | Decode length-prefixed text starting at offset
decodeText : BytesHex -> Int -> Optional (Text, Int)
decodeText encoded offset = do
  lenHex <- extractBytes encoded offset 1
  len <- decodeUint8 lenHex
  if len == 0
    then return ("", offset + 1)
    else do
      textHex <- extractBytes encoded (offset + 1) len
      text <- fromHex textHex
      return (text, offset + 1 + len)

-- | Alias for decodeText (same signature: BytesHex -> Int -> Optional (Text, Int))
decodeTextAt : BytesHex -> Int -> Optional (Text, Int)
decodeTextAt = decodeText

-- | Encode bool (1 byte: 0 = False, 1 = True)
encodeBool : Bool -> BytesHex
encodeBool b = if b then "01" else "00"

-- | Decode bool (1 byte)
decodeBool : BytesHex -> Optional Bool
decodeBool hex
  | hex == "01" = Some True
  | hex == "00" = Some False
  | otherwise = None

-- | Decode bool at offset, returns (value, newOffset)
decodeBoolAt : BytesHex -> Int -> Optional (Bool, Int)
decodeBoolAt encoded offset = do
  boolHex <- extractBytes encoded offset 1
  if boolHex == "01" then Some (True, offset + 1)
  else if boolHex == "00" then Some (False, offset + 1)
  else None

-- | Encode a list with length prefix
encodeList : [a] -> (a -> BytesHex) -> BytesHex
encodeList items encoder =
  let
    lenEncoded = fromSome (encodeUint8 (length items))
    itemsEncoded = foldl (\acc item -> acc <> encoder item) "" items
  in
    lenEncoded <> itemsEncoded

-- | Decode a list with length prefix
decodeList : BytesHex -> Int -> (BytesHex -> Int -> Optional (a, Int)) -> Optional ([a], Int)
decodeList encoded offset decoder = do
  lenHex <- extractBytes encoded offset 1
  len <- decodeUint8 lenHex
  decodeListItems encoded (offset + 1) len decoder []

-- | Helper to decode list items
decodeListItems : BytesHex -> Int -> Int -> (BytesHex -> Int -> Optional (a, Int)) -> [a] -> Optional ([a], Int)
decodeListItems encoded offset 0 _ acc = Some (reverse acc, offset)
decodeListItems encoded offset remaining decoder acc = do
  (item, newOffset) <- decoder encoded offset
  decodeListItems encoded newOffset (remaining - 1) decoder (item :: acc)

encodeOptional : Optional a -> (a -> BytesHex) -> BytesHex
encodeOptional None _ = "00"
encodeOptional (Some x) encoder = "01" <> encoder x

decodeOptional : BytesHex -> Int -> (BytesHex -> Int -> Optional (a, Int)) -> Optional (Optional a, Int)
decodeOptional encoded offset decoder = do
  tagHex <- extractBytes encoded offset 1
  if tagHex == "00" then Some (None, offset + 1)
  else if tagHex == "01" then do
    (value, newOffset) <- decoder encoded (offset + 1)
    Some (Some value, newOffset)
  else None

-- ===========================================================================
-- HELPERS
-- ===========================================================================

-- Two's complement helpers: flip each hex nibble (0↔f, 1↔e, ..., 7↔8)
-- Used to compute bitwise NOT without exceeding 64-bit Int range.
-- For negative n: encode |n|-1 then flip all nibbles = two's complement.
flipHexChar : Text -> Text
flipHexChar "0" = "f"
flipHexChar "1" = "e"
flipHexChar "2" = "d"
flipHexChar "3" = "c"
flipHexChar "4" = "b"
flipHexChar "5" = "a"
flipHexChar "6" = "9"
flipHexChar "7" = "8"
flipHexChar "8" = "7"
flipHexChar "9" = "6"
flipHexChar "a" = "5"
flipHexChar "b" = "4"
flipHexChar "c" = "3"
flipHexChar "d" = "2"
flipHexChar "e" = "1"
flipHexChar "f" = "0"
flipHexChar c = c

flipHexString : Text -> Text
flipHexString t = foldl (<>) "" (map flipHexChar (Text.explode t))

encodeBlockedFunction : BlockedFunction -> BytesHex
encodeBlockedFunction bf = encodeText bf.targetInstanceAddress <> encodeText bf.functionName

decodeBlockedFunction : BytesHex -> Optional BlockedFunction
decodeBlockedFunction encoded = do
  (bf, _) <- decodeBlockedFunctionWithOffset encoded
  Some bf

-- | Decode BlockedFunction and return final offset for buffer consumption validation
decodeBlockedFunctionWithOffset : BytesHex -> Optional (BlockedFunction, Int)
decodeBlockedFunctionWithOffset encoded = do
  (targetInstanceAddress, offset1) <- decodeText encoded 0
  (functionName, finalOffset) <- decodeText encoded offset1
  Some (BlockedFunction targetInstanceAddress functionName, finalOffset)

-- ===========================================================================
-- SELF-DISPATCH SET CONFIG ENCODING
-- Format: role (1 byte) + SetConfigParams
-- ===========================================================================

roleToInt : Role -> Int
roleToInt Proposer = 0
roleToInt Canceller = 1
roleToInt Bypasser = 2

encodeSelfDispatchSetConfig : Role -> SetConfigParams -> BytesHex
encodeSelfDispatchSetConfig role params =
  fromSome (encodeUint8 (roleToInt role)) <> encodeSetConfigParams params

encodePruneSeenHashesParams : Role -> BytesHex
encodePruneSeenHashesParams role = fromSome (encodeUint8 (roleToInt role))

decodeSelfDispatchSetConfig : BytesHex -> Optional (Role, SetConfigParams)
decodeSelfDispatchSetConfig encoded = do
  (result, _) <- decodeSelfDispatchSetConfigWithOffset encoded
  Some result

-- | Decode self-dispatch SetConfig and return final offset for buffer consumption validation
decodeSelfDispatchSetConfigWithOffset : BytesHex -> Optional ((Role, SetConfigParams), Int)
decodeSelfDispatchSetConfigWithOffset encoded = do
  roleHex <- extractBytes encoded 0 1
  roleInt <- decodeUint8 roleHex
  role <- intToRole roleInt
  (params, finalOffset) <- decodeSetConfigParamsAtOffsetWithFinal encoded 1
  Some ((role, params), finalOffset)

-- ===========================================================================
-- TIMELOCK CALL ENCODING (for schedule_batch self-dispatch)
-- ===========================================================================

-- | Encode TimelockCall with uint16 length prefix for operationData (supports >255 bytes)
encodeTimelockCall : TimelockCall -> BytesHex
encodeTimelockCall tc =
  encodeText tc.targetInstanceAddress                      -- uint8 length (short)
  <> encodeText tc.functionName                            -- uint8 length (short)
  <> fromSome (encodeUint16 (byteCount tc.operationData))  -- uint16 length prefix
  <> tc.operationData                                      -- raw BytesHex data

-- | Decode TimelockCall with uint16 length prefix for operationData
decodeTimelockCall : BytesHex -> Int -> Optional (TimelockCall, Int)
decodeTimelockCall encoded offset = do
  (targetInstanceAddress, offset1) <- decodeText encoded offset
  (functionName, offset2) <- decodeText encoded offset1
  -- Decode operationData with uint16 length prefix
  opLenHex <- extractBytes encoded offset2 2
  opLen <- decodeUint16 opLenHex
  operationData <- extractBytes encoded (offset2 + 2) opLen
  Some (TimelockCall targetInstanceAddress functionName operationData, offset2 + 2 + opLen)

-- ===========================================================================
-- SCHEDULE BATCH PARAMS (for schedule_batch self-dispatch)
-- Format: numCalls (1 byte) + calls + predecessor (BytesHex) + salt (BytesHex) + delay (8 bytes)
-- ===========================================================================

data ScheduleBatchParams = ScheduleBatchParams
  with
    calls : [TimelockCall]
    predecessor : BytesHex  -- Hex hash (already hex-encoded)
    salt : BytesHex         -- Hex value (already hex-encoded)
    delaySecs : Int
  deriving (Show, Eq)

-- | Encode ScheduleBatchParams with uint16 length prefix for predecessor and salt
encodeScheduleBatchParams : ScheduleBatchParams -> BytesHex
encodeScheduleBatchParams params =
  let
    callsEncoded = encodeList params.calls encodeTimelockCall
    -- Use uint16 for predecessor and salt (BytesHex, no toHex conversion needed)
    predecessorEncoded = fromSome (encodeUint16 (byteCount params.predecessor)) <> params.predecessor
    saltEncoded = fromSome (encodeUint16 (byteCount params.salt)) <> params.salt
    delayEncoded = fromSome (encodeInt64 params.delaySecs)
  in
    callsEncoded <> predecessorEncoded <> saltEncoded <> delayEncoded

-- | Decode ScheduleBatchParams with uint16 length prefix for predecessor and salt
decodeScheduleBatchParams : BytesHex -> Optional ScheduleBatchParams
decodeScheduleBatchParams encoded = do
  (params, _) <- decodeScheduleBatchParamsWithOffset encoded
  Some params

-- | Decode ScheduleBatchParams and return final offset for buffer consumption validation
decodeScheduleBatchParamsWithOffset : BytesHex -> Optional (ScheduleBatchParams, Int)
decodeScheduleBatchParamsWithOffset encoded = do
  (calls, offset1) <- decodeList encoded 0 decodeTimelockCall
  -- Decode predecessor with uint16 length prefix (BytesHex, no fromHex needed)
  predLenHex <- extractBytes encoded offset1 2
  predLen <- decodeUint16 predLenHex
  predecessor <- extractBytes encoded (offset1 + 2) predLen
  let offset2 = offset1 + 2 + predLen
  -- Decode salt with uint16 length prefix (BytesHex, no fromHex needed)
  saltLenHex <- extractBytes encoded offset2 2
  saltLen <- decodeUint16 saltLenHex
  salt <- extractBytes encoded (offset2 + 2) saltLen
  let offset3 = offset2 + 2 + saltLen
  -- Decode delay
  delayHex <- extractBytes encoded offset3 8
  delaySecs <- decodeInt64 delayHex
  let finalOffset = offset3 + 8
  Some (ScheduleBatchParams
    { calls = calls
    , predecessor = predecessor
    , salt = salt
    , delaySecs = delaySecs
    }, finalOffset)

-- ===========================================================================
-- BYPASSER EXECUTE PARAMS (for bypasser_execute_batch)
-- Format: numCalls (1 byte) + calls
-- Note: targetCids are provided externally, not in operationData
-- ===========================================================================

data BypasserExecuteBatchParams = BypasserExecuteBatchParams
  with
    calls : [TimelockCall]
  deriving (Show, Eq)

encodeBypasserExecuteBatchParams : BypasserExecuteBatchParams -> BytesHex
encodeBypasserExecuteBatchParams params = encodeList params.calls encodeTimelockCall

decodeBypasserExecuteBatchParams : BytesHex -> Optional BypasserExecuteBatchParams
decodeBypasserExecuteBatchParams encoded = do
  (params, _) <- decodeBypasserExecuteBatchParamsWithOffset encoded
  Some params

-- | Decode BypasserExecuteBatchParams and return final offset for buffer consumption validation
decodeBypasserExecuteBatchParamsWithOffset : BytesHex -> Optional (BypasserExecuteBatchParams, Int)
decodeBypasserExecuteBatchParamsWithOffset encoded = do
  (calls, finalOffset) <- decodeList encoded 0 decodeTimelockCall
  Some (BypasserExecuteBatchParams { calls = calls }, finalOffset)

-- ===========================================================================
-- CANCEL BATCH PARAMS (for cancel_batch self-dispatch)
-- Format: opId (text)
-- ===========================================================================

data CancelBatchParams = CancelBatchParams
  with
    opId : Text
  deriving (Show, Eq)

encodeCancelBatchParams : CancelBatchParams -> BytesHex
encodeCancelBatchParams params = encodeText params.opId

decodeCancelBatchParams : BytesHex -> Optional CancelBatchParams
decodeCancelBatchParams encoded = do
  (params, _) <- decodeCancelBatchParamsWithOffset encoded
  Some params

-- | Decode CancelBatchParams and return final offset for buffer consumption validation
decodeCancelBatchParamsWithOffset : BytesHex -> Optional (CancelBatchParams, Int)
decodeCancelBatchParamsWithOffset encoded = do
  (opId, finalOffset) <- decodeText encoded 0
  Some (CancelBatchParams { opId = opId }, finalOffset)

-- ===========================================================================
-- NUMERIC 0 (UINT64 CHAIN SELECTOR) ENCODING/DECODING
-- Encodes Numeric 0 as length-prefixed decimal string (matches Go HexCodec)
-- ===========================================================================

-- | Encode Numeric 0 as text (length-prefixed decimal string)
-- Matches Go HexCodec's encoding: encodeText(string(v))
encodeNumeric0 : Numeric 0 -> BytesHex
encodeNumeric0 n = encodeText (numeric0ToDecimalString n)

-- | Decode Numeric 0 from text encoding
decodeNumeric0At : BytesHex -> Int -> Optional (Numeric 0, Int)
decodeNumeric0At encoded offset = do
  (text, newOffset) <- decodeText encoded offset
  numeric <- parseNumeric0 text
  Some (numeric, newOffset)

-- | Convert Numeric 0 to decimal string (removes .0 suffix)
numeric0ToDecimalString : Numeric 0 -> Text
numeric0ToDecimalString n =
  let str = show n
  in if Text.isSuffixOf ".0" str
     then Text.take (Text.length str - 2) str
     else str

-- | Parse decimal string to Numeric 0
parseNumeric0 : Text -> Optional (Numeric 0)
parseNumeric0 = Text.parseNumeric

-- ===========================================================================
-- BYTES HEX ENCODING/DECODING
-- Format: [uint8 len][raw bytes]
-- ===========================================================================

-- | Encode BytesHex with uint8 length prefix
encodeBytesHex : BytesHex -> BytesHex
encodeBytesHex bh =
  let len = byteCount bh
  in fromSome (encodeUint8 len) <> bh

-- | Decode BytesHex with uint8 length prefix
decodeBytesHexAt : BytesHex -> Int -> Optional (BytesHex, Int)
decodeBytesHexAt encoded offset = do
  lenHex <- extractBytes encoded offset 1
  len <- decodeUint8 lenHex
  bytes <- extractBytes encoded (offset + 1) len
  Some (bytes, offset + 1 + len)

-- | Encode list of BytesHex
encodeBytesHexList : [BytesHex] -> BytesHex
encodeBytesHexList items =
  let count = length items
  in fromSome (encodeUint8 count) <> foldl (\acc bh -> acc <> encodeBytesHex bh) "" items

-- | Decode list of BytesHex
decodeBytesHexList : BytesHex -> Int -> Optional ([BytesHex], Int)
decodeBytesHexList encoded offset = do
  countHex <- extractBytes encoded offset 1
  count <- decodeUint8 countHex
  decodeBytesHexListHelper encoded (offset + 1) count []

decodeBytesHexListHelper : BytesHex -> Int -> Int -> [BytesHex] -> Optional ([BytesHex], Int)
decodeBytesHexListHelper _ offset 0 acc = Some (reverse acc, offset)
decodeBytesHexListHelper encoded offset remaining acc = do
  (bh, newOffset) <- decodeBytesHexAt encoded offset
  decodeBytesHexListHelper encoded newOffset (remaining - 1) (bh :: acc)

-- ===========================================================================
-- DECIMAL ENCODING/DECODING
-- Format: [1 byte sign] [encodeNumeric0 of abs(d) shifted to Numeric 0]
-- Encoding is lossless: shift multiplies by 10^10, packing all 10 fractional
-- digits into the integer, which then round-trips through encodeNumeric0.
-- ===========================================================================

-- | Encode Decimal as sign byte followed by shift-based Numeric 0 encoding
encodeDecimal : Decimal -> BytesHex
encodeDecimal d =
  let sign = if d < 0.0 then "01" else "00"
      magnitude = shift (if d < 0.0 then negate d else d) : Numeric 0
  in sign <> encodeNumeric0 magnitude

-- | Decode Decimal from sign byte followed by shift-based Numeric 0 encoding
decodeDecimalAt : BytesHex -> Int -> Optional (Decimal, Int)
decodeDecimalAt encoded offset = do
  signHex <- extractBytes encoded offset 1
  isNegative <- decodeBool signHex
  (magnitude, newOffset) <- decodeNumeric0At encoded (offset + 1)
  let d = shift magnitude : Decimal
  Some (if isNegative then negate d else d, newOffset)

-- ===========================================================================
-- PARTY ENCODING/DECODING
-- Format: [uint8 len][party text as hex]
-- ===========================================================================

encodeParty : Party -> BytesHex
encodeParty party =
  let
    partyHex = toHex (partyToText party)
    len = byteCount partyHex
  in
    fromSome (encodeUint8 len) <> partyHex

decodePartyAt : BytesHex -> Int -> Optional (Party, Int)
decodePartyAt encoded offset = do
  lenHex <- extractBytes encoded offset 1
  len <- decodeUint8 lenHex
  partyHex <- extractBytes encoded (offset + 1) len
  partyText <- fromHex partyHex
  party <- partyFromText partyText
  Some (party, offset + 1 + len)

-- ===========================================================================
-- PARTY LIST ENCODING/DECODING
-- Format: [uint8 count][party...]
-- ===========================================================================

-- | Encode list of parties
encodePartyList : [Party] -> BytesHex
encodePartyList parties =
  let count = length parties
  in fromSome (encodeUint8 count) <> foldl (\acc p -> acc <> encodeParty p) "" parties

-- | Decode list of parties
decodePartyList : BytesHex -> Int -> Optional ([Party], Int)
decodePartyList encoded offset = do
  countHex <- extractBytes encoded offset 1
  count <- decodeUint8 countHex
  decodePartyListHelper encoded (offset + 1) count []

decodePartyListHelper : BytesHex -> Int -> Int -> [Party] -> Optional ([Party], Int)
decodePartyListHelper _ offset 0 acc = Some (reverse acc, offset)
decodePartyListHelper encoded offset remaining acc = do
  (party, newOffset) <- decodePartyAt encoded offset
  decodePartyListHelper encoded newOffset (remaining - 1) (party :: acc)

