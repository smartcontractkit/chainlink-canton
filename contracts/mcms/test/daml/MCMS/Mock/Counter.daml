module MCMS.Mock.Counter where

import DA.Map qualified as Map
import DA.Text qualified as T
import MCMS.MCMSReceiver
import MCMS.RawInstanceAddress (assertValidInstanceId)
import MCMS.RawInstanceAddress qualified as RawInstanceAddress

-- ===========================================================================
-- COUNTER CONTRACT (Implements MCMSReceiver)
-- ===========================================================================

-- | Simple counter contract that can be controlled by MCMS
-- Demonstrates the MCMSReceiver interface for direct MCMS calls
--
-- Key fields:
--   - instanceId: Stable identifier (without @partyId suffix)
--     This NEVER changes, even when contract state updates or signatory changes.
--   - instanceAddress: CALCULATED as instanceId <> "@" <> partyToText owner
--   - MCMS validates: call.targetInstanceAddress == calculated instanceAddress
template Counter
  with
    owner : Party                              -- Same ccip_owner party as MCMS
    instanceId : Text                          -- Stable identifier for MCMS targeting (no @partyId)
    value : Int                                -- Current counter value
  where
    signatory owner
    ensure assertValidInstanceId instanceId

    -- Implement MCMSReceiver interface
    interface instance MCMSReceiver for Counter where
      view = MCMSReceiverView with
        mcmsController = owner
        instanceId = instanceId

      mcmsEntrypoint functionName operationData contractIds = do
        -- Calculate full instanceAddress for map lookup
        let instanceAddress = RawInstanceAddress.makeText instanceId owner

        -- Look up self CID from map using full address
        selfCid <- case Map.lookup instanceAddress contractIds of
          None -> abort $ "counter: contract ID not found in map: " <> instanceAddress
          Some cid -> pure (coerceContractId cid : ContractId Counter)

        case functionName of
          "Increment" -> do
            newCid <- exercise selfCid Increment
            pure (Map.insert instanceAddress (coerceContractId newCid) contractIds)

          "SetValue" -> do
            case T.parseInt operationData of
              Some newValue -> do
                newCid <- exercise selfCid (SetValue newValue)
                pure (Map.insert instanceAddress (coerceContractId newCid) contractIds)
              None -> abort $ "counter: invalid integer value: " <> operationData

          "Reset" -> do
            newCid <- exercise selfCid Reset
            pure (Map.insert instanceAddress (coerceContractId newCid) contractIds)

          _ -> abort $ "counter: unknown function: " <> functionName

    -- =========================================================================
    -- PUBLIC CHOICES (controlled by owner, callable directly or via MCMS)
    -- =========================================================================

    choice Increment : ContractId Counter
      controller owner
      do create this with value = value + 1

    choice SetValue : ContractId Counter
      with
        newValue : Int
      controller owner
      do create this with value = newValue

    choice Reset : ContractId Counter
      controller owner
      do create this with value = 0

    -- =========================================================================
    -- QUERIES (Anyone can call with contract disclosure)
    -- =========================================================================

    nonconsuming choice GetValue : Int
      with
        viewer : Party
      controller viewer
      do pure value

    nonconsuming choice GetInstanceIdChoice : Text
      with
        viewer : Party
      controller viewer
      do pure instanceId

    nonconsuming choice GetInstanceAddressChoice : Text
      with
        viewer : Party
      controller viewer
      do pure (RawInstanceAddress.makeText instanceId owner)

