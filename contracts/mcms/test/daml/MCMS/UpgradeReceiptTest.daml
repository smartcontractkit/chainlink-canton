-- | Upgrade Receipt Tests for MCMS Contract Upgrade Flow
--
-- Tests for UpgradeReceipt verification during CompleteUpgrade:
--   - CompleteUpgrade without receipt fails
--   - CompleteUpgrade with wrong receipt fails
--   - Receipt cannot be reused for another upgrade
--
-- With embedded registry, these tests use MCMS directly with registry state.
--
module MCMS.UpgradeReceiptTest where

import DA.Map qualified as Map
import DA.Time (seconds, addRelTime)
import Daml.Script
import MCMS.Main (MCMS(..), ExecuteScheduledBatch(..))
import MCMS.MCMSReceiver (UpgradeReceipt(..))
import MCMS.MCMSRegistry
import MCMS.RegistryCodec
import MCMS.TestHelpers (mkInstanceId)
import MCMS.Types (TimelockCall(..), zeroHash, emptyRoleState)
import MCMS.Crypto (hashTimelockOpId)

-- ===========================================================================
-- RECEIPT VERIFICATION TESTS (Using Embedded Registry)
-- ===========================================================================

-- | Test: CompleteUpgrade without receipt fails with E_MISSING_UPGRADE_RECEIPT
testCompleteUpgradeWithoutReceipt : Script ()
testCompleteUpgradeWithoutReceipt = script do
  owner <- allocateParty "ccip_owner"
  now <- getTime
  let mcmsInstanceId = mkInstanceId "mcms" owner
  let counterInstanceId = mkInstanceId "counter" owner

  -- Create registry with counter registered and UpgradePending
  let counterReg = ContractRegistration with
        instanceId = counterInstanceId
        version = "1.0.0"
        status = UpgradePending
        deployedAt = now
        contractType = "Counter"
        metadata = Map.empty
  let pendingUpgrade = PendingUpgrade with
        instanceId = counterInstanceId
        fromVersion = "1.0.0"
        toVersion = "2.0.0"
        initiatedAt = now
        migrationParams = ""
  let registryState = emptyRegistryState with
        registrations = Map.fromList [(counterInstanceId, counterReg)]
        pendingUpgrades = Map.fromList [(counterInstanceId, pendingUpgrade)]

  -- Create CompleteUpgrade call
  let completeCall = TimelockCall mcmsInstanceId "CompleteUpgrade"
        (encodeCompleteUpgradeParams $ CompleteUpgradeParams
          { instanceId = counterInstanceId
          , newVersion = "2.0.0"
          })
  let completeOpId = hashTimelockOpId [completeCall] zeroHash "complete-salt"
  let readyTime = addRelTime now (seconds (-1))

  -- Create MCMS with pending upgrade and scheduled CompleteUpgrade
  mcmsCid <- submit owner do
    createCmd MCMS with
      owner
      instanceId = mcmsInstanceId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.fromList [(completeOpId, readyTime)]
      registry = registryState

  -- Try to complete upgrade WITHOUT receipt - should fail
  submitMustFail owner do
    exerciseCmd mcmsCid ExecuteScheduledBatch with
      submitter = owner
      opId = completeOpId
      calls = [completeCall]
      predecessor = zeroHash
      salt = "complete-salt"
      targetCids = []
      perCallContractIds = []  -- No receipt!

  debug "testCompleteUpgradeWithoutReceipt PASSED!"
  pure ()

-- | Test: CompleteUpgrade with wrong receipt fails validation
testCompleteUpgradeWithWrongReceipt : Script ()
testCompleteUpgradeWithWrongReceipt = script do
  owner <- allocateParty "ccip_owner"
  now <- getTime
  let mcmsInstanceId = mkInstanceId "mcms" owner
  let counterInstanceId = mkInstanceId "counter" owner
  let wrongInstanceId = mkInstanceId "wrong-counter" owner
  let serviceInstanceId = mkInstanceId "upgrade-service" owner

  -- Create registry with counter registered and UpgradePending
  let counterReg = ContractRegistration with
        instanceId = counterInstanceId
        version = "1.0.0"
        status = UpgradePending
        deployedAt = now
        contractType = "Counter"
        metadata = Map.empty
  let pendingUpgrade = PendingUpgrade with
        instanceId = counterInstanceId
        fromVersion = "1.0.0"
        toVersion = "2.0.0"
        initiatedAt = now
        migrationParams = ""
  let registryState = emptyRegistryState with
        registrations = Map.fromList [(counterInstanceId, counterReg)]
        pendingUpgrades = Map.fromList [(counterInstanceId, pendingUpgrade)]

  -- Create CompleteUpgrade call
  let completeCall = TimelockCall mcmsInstanceId "CompleteUpgrade"
        (encodeCompleteUpgradeParams $ CompleteUpgradeParams
          { instanceId = counterInstanceId
          , newVersion = "2.0.0"
          })
  let completeOpId = hashTimelockOpId [completeCall] zeroHash "complete-salt"
  let readyTime = addRelTime now (seconds (-1))

  -- Create MCMS
  mcmsCid <- submit owner do
    createCmd MCMS with
      owner
      instanceId = mcmsInstanceId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.fromList [(completeOpId, readyTime)]
      registry = registryState

  -- Create receipt with WRONG instanceId
  wrongReceiptCid <- submit owner do
    createCmd UpgradeReceipt with
      owner
      instanceId = wrongInstanceId  -- Wrong!
      fromVersion = "1.0.0"
      toVersion = "2.0.0"
      newContractCid = coerceContractId mcmsCid
      executedAt = now
      serviceInstanceId

  -- Try to complete upgrade with wrong receipt - should fail
  let wrongReceiptCidUntyped : ContractId () = coerceContractId wrongReceiptCid
  submitMustFail owner do
    exerciseCmd mcmsCid ExecuteScheduledBatch with
      submitter = owner
      opId = completeOpId
      calls = [completeCall]
      predecessor = zeroHash
      salt = "complete-salt"
      targetCids = []
      perCallContractIds = [[wrongReceiptCidUntyped]]

  debug "testCompleteUpgradeWithWrongReceipt PASSED!"
  pure ()

-- | Test: Receipt cannot be reused for another upgrade
testReceiptCannotBeReused : Script ()
testReceiptCannotBeReused = script do
  owner <- allocateParty "ccip_owner"
  now <- getTime
  let mcmsInstanceId = mkInstanceId "mcms" owner
  let counterInstanceId = mkInstanceId "counter" owner
  let serviceInstanceId = mkInstanceId "upgrade-service" owner

  -- Create registry with counter registered and UpgradePending (first upgrade)
  let counterReg = ContractRegistration with
        instanceId = counterInstanceId
        version = "1.0.0"
        status = UpgradePending
        deployedAt = now
        contractType = "Counter"
        metadata = Map.empty
  let pendingUpgrade = PendingUpgrade with
        instanceId = counterInstanceId
        fromVersion = "1.0.0"
        toVersion = "2.0.0"
        initiatedAt = now
        migrationParams = ""
  let registryState = emptyRegistryState with
        registrations = Map.fromList [(counterInstanceId, counterReg)]
        pendingUpgrades = Map.fromList [(counterInstanceId, pendingUpgrade)]

  -- Create CompleteUpgrade call
  let completeCall = TimelockCall mcmsInstanceId "CompleteUpgrade"
        (encodeCompleteUpgradeParams $ CompleteUpgradeParams
          { instanceId = counterInstanceId
          , newVersion = "2.0.0"
          })
  let completeOpId = hashTimelockOpId [completeCall] zeroHash "complete-salt"
  let readyTime = addRelTime now (seconds (-1))

  -- Create MCMS
  mcmsCid <- submit owner do
    createCmd MCMS with
      owner
      instanceId = mcmsInstanceId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.fromList [(completeOpId, readyTime)]
      registry = registryState

  -- Create receipt for first upgrade
  receiptCid <- submit owner do
    createCmd UpgradeReceipt with
      owner
      instanceId = counterInstanceId
      fromVersion = "1.0.0"
      toVersion = "2.0.0"
      newContractCid = coerceContractId mcmsCid
      executedAt = now
      serviceInstanceId

  -- Complete first upgrade (consumes receipt)
  let receiptCidUntyped : ContractId () = coerceContractId receiptCid
  mcmsCid2 <- submit owner do
    exerciseCmd mcmsCid ExecuteScheduledBatch with
      submitter = owner
      opId = completeOpId
      calls = [completeCall]
      predecessor = zeroHash
      salt = "complete-salt"
      targetCids = []
      perCallContractIds = [[receiptCidUntyped]]

  -- Verify receipt is consumed
  receiptAfter <- queryContractId owner receiptCid
  assertMsg "Receipt should be consumed" $ receiptAfter == None

  -- Second upgrade: 2.0.0 -> 3.0.0 (need to set up new pending upgrade)
  -- Use pure functions to prepare the expected state
  let Right afterComplete = completeUpgrade registryState (CompleteUpgradeParams counterInstanceId "2.0.0") now
  let initiateParams = InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "2.0.0"
        , toVersion = "3.0.0"
        , migrationParams = ""
        }
  let Right registryAfterInitiate2 = initiateUpgrade afterComplete initiateParams now

  -- Create second CompleteUpgrade call
  let completeCall2 = TimelockCall mcmsInstanceId "CompleteUpgrade"
        (encodeCompleteUpgradeParams $ CompleteUpgradeParams
          { instanceId = counterInstanceId
          , newVersion = "3.0.0"
          })
  let completeOpId2 = hashTimelockOpId [completeCall2] zeroHash "complete-salt-2"

  -- Archive old MCMS and create new one with second upgrade state
  mcmsData <- queryContractId owner mcmsCid2
  case mcmsData of
    None -> abort "MCMS should exist"
    Some mcms -> do
      submit owner do archiveCmd mcmsCid2

      mcmsCid3 <- submit owner do
        createCmd mcms with
          registry = registryAfterInitiate2
          timelockTimestamps = Map.fromList [(completeOpId2, readyTime)]

      -- Try to reuse the consumed receipt - should fail (contract doesn't exist)
      submitMustFail owner do
        exerciseCmd mcmsCid3 ExecuteScheduledBatch with
          submitter = owner
          opId = completeOpId2
          calls = [completeCall2]
          predecessor = zeroHash
          salt = "complete-salt-2"
          targetCids = []
          perCallContractIds = [[receiptCidUntyped]]  -- Trying to reuse consumed receipt

      debug "testReceiptCannotBeReused PASSED!"
      pure ()
