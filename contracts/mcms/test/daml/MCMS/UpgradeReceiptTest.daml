-- | Upgrade Receipt Tests for MCMS Contract Upgrade Flow
--
-- Tests for UpgradeReceipt verification during CompleteUpgrade:
--   - CompleteUpgrade without receipt fails
--   - CompleteUpgrade with wrong receipt fails
--   - Receipt cannot be reused for another upgrade
--
module MCMS.UpgradeReceiptTest where

import DA.Map qualified as Map
import Daml.Script
import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiver_Entrypoint(..), UpgradeReceipt(..))
import MCMS.MCMSRegistry
import MCMS.RegistryCodec
import MCMS.TestHelpers (mkInstanceId)

-- ===========================================================================
-- RECEIPT VERIFICATION TESTS
-- ===========================================================================

-- | Test: CompleteUpgrade without receipt fails with E_MISSING_UPGRADE_RECEIPT
testCompleteUpgradeWithoutReceipt : Script ()
testCompleteUpgradeWithoutReceipt = script do
  owner <- allocateParty "ccip_owner"
  let registryInstanceId = mkInstanceId "registry" owner
  let counterInstanceId = mkInstanceId "counter" owner

  -- Create registry and register contract
  registryCid <- submit owner do
    createCmd MCMSRegistry with
      owner
      instanceId = registryInstanceId
      registrations = Map.empty
      pendingUpgrades = Map.empty
      upgradeHistory = Map.empty

  let regIfaceCid = toInterfaceContractId @MCMSReceiver registryCid
  result1 <- submit owner do
    exerciseCmd regIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "RegisterContract"
      operationData = encodeRegisterContractParams $ RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
      contractIds = []

  -- Initiate upgrade
  let regIfaceCid2 = toInterfaceContractId @MCMSReceiver (coerceContractId result1.selfCid : ContractId MCMSRegistry)
  result2 <- submit owner do
    exerciseCmd regIfaceCid2 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "InitiateUpgrade"
      operationData = encodeInitiateUpgradeParams $ InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "1.0.0"
        , toVersion = "2.0.0"
        , migrationParams = ""
        }
      contractIds = []

  -- Try to complete upgrade WITHOUT receipt - should fail
  let regIfaceCid3 = toInterfaceContractId @MCMSReceiver (coerceContractId result2.selfCid : ContractId MCMSRegistry)
  submitMustFail owner do
    exerciseCmd regIfaceCid3 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "CompleteUpgrade"
      operationData = encodeCompleteUpgradeParams $ CompleteUpgradeParams
        { instanceId = counterInstanceId
        , newVersion = "2.0.0"
        }
      contractIds = []  -- No receipt!

  debug "testCompleteUpgradeWithoutReceipt PASSED!"
  pure ()

-- | Test: CompleteUpgrade with wrong receipt fails validation
testCompleteUpgradeWithWrongReceipt : Script ()
testCompleteUpgradeWithWrongReceipt = script do
  owner <- allocateParty "ccip_owner"
  let registryInstanceId = mkInstanceId "registry" owner
  let counterInstanceId = mkInstanceId "counter" owner
  let wrongInstanceId = mkInstanceId "wrong-counter" owner
  let serviceInstanceId = mkInstanceId "upgrade-service" owner

  -- Create registry, register, and initiate upgrade
  registryCid <- submit owner do
    createCmd MCMSRegistry with
      owner
      instanceId = registryInstanceId
      registrations = Map.empty
      pendingUpgrades = Map.empty
      upgradeHistory = Map.empty

  let regIfaceCid = toInterfaceContractId @MCMSReceiver registryCid
  result1 <- submit owner do
    exerciseCmd regIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "RegisterContract"
      operationData = encodeRegisterContractParams $ RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
      contractIds = []

  let regIfaceCid2 = toInterfaceContractId @MCMSReceiver (coerceContractId result1.selfCid : ContractId MCMSRegistry)
  result2 <- submit owner do
    exerciseCmd regIfaceCid2 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "InitiateUpgrade"
      operationData = encodeInitiateUpgradeParams $ InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "1.0.0"
        , toVersion = "2.0.0"
        , migrationParams = ""
        }
      contractIds = []

  -- Create receipt with WRONG instanceId
  now <- getTime
  wrongReceiptCid <- submit owner do
    createCmd UpgradeReceipt with
      owner
      instanceId = wrongInstanceId  -- Wrong!
      fromVersion = "1.0.0"
      toVersion = "2.0.0"
      newContractCid = coerceContractId registryCid
      executedAt = now
      serviceInstanceId

  -- Try to complete upgrade with wrong receipt - should fail
  let regIfaceCid3 = toInterfaceContractId @MCMSReceiver (coerceContractId result2.selfCid : ContractId MCMSRegistry)
  let wrongReceiptCidUntyped : ContractId () = coerceContractId wrongReceiptCid
  submitMustFail owner do
    exerciseCmd regIfaceCid3 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "CompleteUpgrade"
      operationData = encodeCompleteUpgradeParams $ CompleteUpgradeParams
        { instanceId = counterInstanceId
        , newVersion = "2.0.0"
        }
      contractIds = [wrongReceiptCidUntyped]

  debug "testCompleteUpgradeWithWrongReceipt PASSED!"
  pure ()

-- | Test: Receipt cannot be reused for another upgrade
testReceiptCannotBeReused : Script ()
testReceiptCannotBeReused = script do
  owner <- allocateParty "ccip_owner"
  let registryInstanceId = mkInstanceId "registry" owner
  let counterInstanceId = mkInstanceId "counter" owner
  let serviceInstanceId = mkInstanceId "upgrade-service" owner

  -- Create registry and register contract
  registryCid <- submit owner do
    createCmd MCMSRegistry with
      owner
      instanceId = registryInstanceId
      registrations = Map.empty
      pendingUpgrades = Map.empty
      upgradeHistory = Map.empty

  let regIfaceCid = toInterfaceContractId @MCMSReceiver registryCid
  result1 <- submit owner do
    exerciseCmd regIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "RegisterContract"
      operationData = encodeRegisterContractParams $ RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
      contractIds = []

  -- First upgrade: 1.0.0 -> 2.0.0
  let regIfaceCid2 = toInterfaceContractId @MCMSReceiver (coerceContractId result1.selfCid : ContractId MCMSRegistry)
  result2 <- submit owner do
    exerciseCmd regIfaceCid2 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "InitiateUpgrade"
      operationData = encodeInitiateUpgradeParams $ InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "1.0.0"
        , toVersion = "2.0.0"
        , migrationParams = ""
        }
      contractIds = []

  -- Create receipt for first upgrade
  now <- getTime
  receiptCid <- submit owner do
    createCmd UpgradeReceipt with
      owner
      instanceId = counterInstanceId
      fromVersion = "1.0.0"
      toVersion = "2.0.0"
      newContractCid = coerceContractId registryCid
      executedAt = now
      serviceInstanceId

  -- Complete first upgrade (consumes receipt)
  let regIfaceCid3 = toInterfaceContractId @MCMSReceiver (coerceContractId result2.selfCid : ContractId MCMSRegistry)
  let receiptCidUntyped : ContractId () = coerceContractId receiptCid
  result3 <- submit owner do
    exerciseCmd regIfaceCid3 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "CompleteUpgrade"
      operationData = encodeCompleteUpgradeParams $ CompleteUpgradeParams
        { instanceId = counterInstanceId
        , newVersion = "2.0.0"
        }
      contractIds = [receiptCidUntyped]

  -- Verify receipt is consumed
  receiptAfter <- queryContractId owner receiptCid
  assertMsg "Receipt should be consumed" $ receiptAfter == None

  -- Second upgrade: 2.0.0 -> 3.0.0
  let regIfaceCid4 = toInterfaceContractId @MCMSReceiver (coerceContractId result3.selfCid : ContractId MCMSRegistry)
  result4 <- submit owner do
    exerciseCmd regIfaceCid4 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "InitiateUpgrade"
      operationData = encodeInitiateUpgradeParams $ InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "2.0.0"
        , toVersion = "3.0.0"
        , migrationParams = ""
        }
      contractIds = []

  -- Try to reuse the consumed receipt - should fail (contract doesn't exist)
  let regIfaceCid5 = toInterfaceContractId @MCMSReceiver (coerceContractId result4.selfCid : ContractId MCMSRegistry)
  submitMustFail owner do
    exerciseCmd regIfaceCid5 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "CompleteUpgrade"
      operationData = encodeCompleteUpgradeParams $ CompleteUpgradeParams
        { instanceId = counterInstanceId
        , newVersion = "3.0.0"
        }
      contractIds = [receiptCidUntyped]  -- Trying to reuse consumed receipt

  debug "testReceiptCannotBeReused PASSED!"
  pure ()
