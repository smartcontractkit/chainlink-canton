module MCMS.GroupVotingTest where

import Daml.Script
import MCMS.Types
import MCMS.GroupVoting
import MCMS.TestHelpers

-- | Test the group voting algorithm with simple 2-of-3 config
testGroupVoting : Script ()
testGroupVoting = script do
  -- Test 1: Simple 2-of-3 passes with 2 signatures
  let config = make2of3Config
  let signers2 =
        [ "1111111111111111111111111111111111111111"
        , "2222222222222222222222222222222222222222"
        ]
  case verifyGroupVoting signers2 config of
    Left err -> abort $ "Should pass with 2 signers: " <> err
    Right () -> pure ()

  -- Test 2: Simple 2-of-3 fails with 1 signature
  let signers1 = ["1111111111111111111111111111111111111111"]
  case verifyGroupVoting signers1 config of
    Left _ -> pure ()  -- Expected to fail
    Right () -> abort "Should fail with only 1 signer"

  -- Test 3: Fails with unknown signer
  let unknownSigner = ["9999999999999999999999999999999999999999"]
  case verifyGroupVoting unknownSigner config of
    Left _ -> pure ()  -- Expected to fail
    Right () -> abort "Should fail with unknown signer"

  -- Test 4: Fails with unsorted signers
  let unsortedSigners =
        [ "2222222222222222222222222222222222222222"
        , "1111111111111111111111111111111111111111"
        ]
  case verifyGroupVoting unsortedSigners config of
    Left _ -> pure ()  -- Expected to fail
    Right () -> abort "Should fail with unsorted signers"

  debug "✓ Group voting test passed"
  pure ()

-- | Test hierarchical group voting with 2 departments
-- Engineering (group 1) and Security (group 2) each need 1
-- Root (group 0) needs 2 department approvals
testHierarchicalGroups : Script ()
testHierarchicalGroups = script do
  let config = MultisigConfig
        { signers =
            [ SignerInfo "1111111111111111111111111111111111111111" 0 1  -- Eng
            , SignerInfo "2222222222222222222222222222222222222222" 1 1  -- Eng
            , SignerInfo "3333333333333333333333333333333333333333" 2 2  -- Sec
            , SignerInfo "4444444444444444444444444444444444444444" 3 2  -- Sec
            ]
        , groupQuorums = [2, 1, 1] <> replicate 29 0  -- Root=2, Eng=1, Sec=1
        , groupParents = [0, 0, 0] <> replicate 29 0  -- Groups 1,2 -> Root
        }

  -- Test: 1 from each department passes
  let crossDeptSigners =
        [ "1111111111111111111111111111111111111111"  -- Eng
        , "3333333333333333333333333333333333333333"  -- Sec
        ]
  case verifyGroupVoting crossDeptSigners config of
    Left err -> abort $ "Should pass with cross-dept: " <> err
    Right () -> pure ()

  -- Test: 2 from same department fails
  let sameDeptSigners =
        [ "1111111111111111111111111111111111111111"  -- Eng
        , "2222222222222222222222222222222222222222"  -- Eng
        ]
  case verifyGroupVoting sameDeptSigners config of
    Left _ -> pure ()  -- Expected to fail
    Right () -> abort "Should fail with same department signers"

  debug "✓ Hierarchical groups test passed"
  pure ()

-- | Test edge cases for group voting
testGroupVotingEdgeCases : Script ()
testGroupVotingEdgeCases = script do
  -- Test: 1-of-1 config
  let singleSignerConfig = MultisigConfig
        { signers = [SignerInfo "1111111111111111111111111111111111111111" 0 0]
        , groupQuorums = [1] <> replicate 31 0
        , groupParents = replicate 32 0
        }
  let singleSigner = ["1111111111111111111111111111111111111111"]
  case verifyGroupVoting singleSigner singleSignerConfig of
    Left err -> abort $ "1-of-1 should pass: " <> err
    Right () -> pure ()

  -- Test: 3-of-3 config (all signers required)
  let allSignersConfig = MultisigConfig
        { signers =
            [ SignerInfo "1111111111111111111111111111111111111111" 0 0
            , SignerInfo "2222222222222222222222222222222222222222" 1 0
            , SignerInfo "3333333333333333333333333333333333333333" 2 0
            ]
        , groupQuorums = [3] <> replicate 31 0  -- Need ALL 3
        , groupParents = replicate 32 0
        }
  let allSigners =
        [ "1111111111111111111111111111111111111111"
        , "2222222222222222222222222222222222222222"
        , "3333333333333333333333333333333333333333"
        ]
  case verifyGroupVoting allSigners allSignersConfig of
    Left err -> abort $ "3-of-3 should pass with all: " <> err
    Right () -> pure ()

  -- Test: 3-of-3 fails with 2 signers
  let twoOfThree =
        [ "1111111111111111111111111111111111111111"
        , "2222222222222222222222222222222222222222"
        ]
  case verifyGroupVoting twoOfThree allSignersConfig of
    Left _ -> pure ()  -- Expected to fail
    Right () -> abort "3-of-3 should fail with only 2"

  debug "✓ Group voting edge cases test passed"
  pure ()

-- | Test duplicate signer rejection
testDuplicateSignerRejection : Script ()
testDuplicateSignerRejection = script do
  let config = make2of3Config
  -- Duplicate signers should fail (same address twice)
  let duplicateSigners =
        [ "1111111111111111111111111111111111111111"
        , "1111111111111111111111111111111111111111"  -- Same as first!
        ]
  case verifyGroupVoting duplicateSigners config of
    Left _ -> pure ()  -- Expected to fail (addresses not strictly increasing)
    Right () -> abort "Should fail with duplicate signers"

  debug "✓ Duplicate signer rejection test passed"
  pure ()

