testUpgradeTargetVersionMismatchRejected = script do
  owner <- allocateParty "ccip_owner"
  let counterInstanceId = mkInstanceId "counter" owner
  let serviceInstanceId = mkInstanceId "upgrade-service" owner

  -- Create Counter
  counterCid <- submit owner do
    createCmd Counter with
      owner
      instanceId = counterInstanceId
      value = 42

  -- Create upgrade service
  serviceCid <- submit owner do
    createCmd CounterUpgradeService with
      owner
      serviceInstanceId

  -- Try to upgrade with wrong target version
  submitMustFail owner do
    exerciseCmd serviceCid ExecuteUpgrade with
      upgradeData = counterInstanceId <> "|1.0.0|3.0.0"  -- Wrong toVersion!
      oldCounterCidUntyped = coerceContractId counterCid

  debug "testUpgradeTargetVersionMismatchRejected PASSED!"
  pure ()

-- | Test: Instance ID mismatch rejected
testUpgradeInstanceIdMismatchRejected : Script ()
testUpgradeInstanceIdMismatchRejected = script do
  owner <- allocateParty "ccip_owner"
  let counterInstanceId = mkInstanceId "counter" owner
  let wrongInstanceId = mkInstanceId "wrong-counter" owner
  let serviceInstanceId = mkInstanceId "upgrade-service" owner

  -- Create Counter with WRONG instanceId
  counterCid <- submit owner do
    createCmd Counter with
      owner
      instanceId = wrongInstanceId  -- Wrong instanceId!
      value = 42

  -- Create upgrade service
  serviceCid <- submit owner do
    createCmd CounterUpgradeService with
      owner
      serviceInstanceId

  -- Try to upgrade with mismatched instanceId in params
  submitMustFail owner do
    exerciseCmd serviceCid ExecuteUpgrade with
      upgradeData = counterInstanceId <> "|1.0.0|2.0.0"  -- Expects counterInstanceId
      oldCounterCidUntyped = coerceContractId counterCid  -- But contract has wrongInstanceId

  debug "testUpgradeInstanceIdMismatchRejected PASSED!"
  pure ()
