-- | Registry Validation Tests for MCMS External Call Validation
--
-- Tests for MCMS registry validation during external calls:
--   - Calling unregistered contract fails
--   - Calling deprecated contract fails
--   - Calling UpgradePending contract fails
--   - Calling Active registered contract succeeds
--
-- With embedded registry, external calls MUST target registered contracts
-- with Active status. This is now mandatory (not optional).
--
module MCMS.RegistryValidationTest where

import DA.Map qualified as Map
import DA.Time (seconds, addRelTime)
import Daml.Script
import MCMS.MCMSReceiver (MCMSReceiver(..))
import MCMS.MCMSRegistry
import MCMS.Counter (Counter(..))
import MCMS.Main (MCMS(..), ExecuteScheduledBatch(..))
import MCMS.Types (TimelockCall(..), zeroHash, emptyRoleState)
import MCMS.Crypto (hashTimelockOpId)
import MCMS.RegistryCodec
import MCMS.TestHelpers (mkInstanceId)

-- ===========================================================================
-- REGISTRY VALIDATION TESTS (External Call Validation)
-- ===========================================================================

-- | Test: Calling unregistered contract via MCMS fails with E_TARGET_NOT_REGISTERED
-- With embedded registry, external calls must target registered contracts
testCallUnregisteredContractFails : Script ()
testCallUnregisteredContractFails = script do
  owner <- allocateParty "ccip_owner"
  let mcmsInstanceId = mkInstanceId "mcms" owner
  let counterInstanceId = mkInstanceId "counter" owner

  -- Create MCMS with empty registry (no contracts registered)
  now <- getTime
  let readyTime = addRelTime now (seconds (-1))  -- Already ready
  let calls = [TimelockCall with
        targetInstanceId = counterInstanceId
        functionName = "Increment"
        operationData = ""]
  let opId = hashTimelockOpId calls zeroHash "test-salt"

  mcmsCid <- submit owner do
    createCmd MCMS with
      owner
      instanceId = mcmsInstanceId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.fromList [(opId, readyTime)]
      registry = emptyRegistryState  -- No contracts registered

  -- Create Counter (NOT registered in registry)
  counterCid <- submit owner do
    createCmd Counter with
      owner
      instanceId = counterInstanceId
      value = 0

  let counterAsMcmsReceiver = toInterfaceContractId @MCMSReceiver counterCid

  -- ExecuteScheduledBatch should fail because counter is not registered
  submitMustFail owner do
    exerciseCmd mcmsCid ExecuteScheduledBatch with
      submitter = owner
      opId
      calls
      predecessor = zeroHash
      salt = "test-salt"
      perCallContractIds = []

  debug "testCallUnregisteredContractFails PASSED!"
  pure ()

-- | Test: Calling deprecated contract via MCMS fails with E_TARGET_NOT_ACTIVE
-- External calls must target Active contracts
testCallDeprecatedContractFails : Script ()
testCallDeprecatedContractFails = script do
  owner <- allocateParty "ccip_owner"
  let mcmsInstanceId = mkInstanceId "mcms" owner
  let counterInstanceId = mkInstanceId "counter" owner

  now <- getTime

  -- Create Counter FIRST (need CID for registry)
  counterCid <- submit owner do
    createCmd Counter with
      owner
      instanceId = counterInstanceId
      value = 0

  let counterAsMcmsReceiver = toInterfaceContractId @MCMSReceiver counterCid

  -- Create registry state with deprecated counter (now with CID)
  let registration = ContractRegistration with
        instanceId = counterInstanceId
        version = "1.0.0"
        status = Deprecated  -- Contract is deprecated
        deployedAt = now
        contractType = "Counter"
        metadata = Map.empty
        currentCid = counterAsMcmsReceiver
  let registryState = emptyRegistryState with
        registrations = Map.fromList [(counterInstanceId, registration)]

  -- Create MCMS with registry containing deprecated contract
  let readyTime = addRelTime now (seconds (-1))  -- Already ready
  let calls = [TimelockCall with
        targetInstanceId = counterInstanceId
        functionName = "Increment"
        operationData = ""]
  let opId = hashTimelockOpId calls zeroHash "test-salt-2"

  mcmsCid <- submit owner do
    createCmd MCMS with
      owner
      instanceId = mcmsInstanceId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.fromList [(opId, readyTime)]
      registry = registryState

  -- ExecuteScheduledBatch should fail because counter is Deprecated (not Active)
  submitMustFail owner do
    exerciseCmd mcmsCid ExecuteScheduledBatch with
      submitter = owner
      opId
      calls
      predecessor = zeroHash
      salt = "test-salt-2"
      perCallContractIds = []

  debug "testCallDeprecatedContractFails PASSED!"
  pure ()

-- | Test: Calling UpgradePending contract via MCMS fails with E_TARGET_NOT_ACTIVE
-- Contracts with pending upgrades should not be callable
testCallUpgradePendingContractFails : Script ()
testCallUpgradePendingContractFails = script do
  owner <- allocateParty "ccip_owner"
  let mcmsInstanceId = mkInstanceId "mcms" owner
  let counterInstanceId = mkInstanceId "counter" owner

  now <- getTime

  -- Create Counter FIRST (need CID for registry)
  counterCid <- submit owner do
    createCmd Counter with
      owner
      instanceId = counterInstanceId
      value = 0

  let counterAsMcmsReceiver = toInterfaceContractId @MCMSReceiver counterCid

  -- Create registry state with UpgradePending counter (now with CID)
  let registration = ContractRegistration with
        instanceId = counterInstanceId
        version = "1.0.0"
        status = UpgradePending  -- Contract has pending upgrade
        deployedAt = now
        contractType = "Counter"
        metadata = Map.empty
        currentCid = counterAsMcmsReceiver
  let pendingUpgrade = PendingUpgrade with
        instanceId = counterInstanceId
        fromVersion = "1.0.0"
        toVersion = "2.0.0"
        initiatedAt = now
        migrationParams = ""
  let registryState = emptyRegistryState with
        registrations = Map.fromList [(counterInstanceId, registration)]
        pendingUpgrades = Map.fromList [(counterInstanceId, pendingUpgrade)]

  -- Create MCMS with registry
  let readyTime = addRelTime now (seconds (-1))
  let calls = [TimelockCall with
        targetInstanceId = counterInstanceId
        functionName = "Increment"
        operationData = ""]
  let opId = hashTimelockOpId calls zeroHash "test-salt-3"

  mcmsCid <- submit owner do
    createCmd MCMS with
      owner
      instanceId = mcmsInstanceId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.fromList [(opId, readyTime)]
      registry = registryState

  -- ExecuteScheduledBatch should fail because counter is UpgradePending (not Active)
  submitMustFail owner do
    exerciseCmd mcmsCid ExecuteScheduledBatch with
      submitter = owner
      opId
      calls
      predecessor = zeroHash
      salt = "test-salt-3"
      perCallContractIds = []

  debug "testCallUpgradePendingContractFails PASSED!"
  pure ()

-- | Test: Calling Active registered contract succeeds
-- Positive test to ensure registry validation allows Active contracts
testCallActiveRegisteredContractSucceeds : Script ()
testCallActiveRegisteredContractSucceeds = script do
  owner <- allocateParty "ccip_owner"
  let mcmsInstanceId = mkInstanceId "mcms" owner
  let counterInstanceId = mkInstanceId "counter" owner

  now <- getTime

  -- Create Counter FIRST (need CID for registry)
  counterCid <- submit owner do
    createCmd Counter with
      owner
      instanceId = counterInstanceId
      value = 0

  let counterAsMcmsReceiver = toInterfaceContractId @MCMSReceiver counterCid

  -- Create registry state with Active counter (now with CID)
  let registration = ContractRegistration with
        instanceId = counterInstanceId
        version = "1.0.0"
        status = Active  -- Contract is active
        deployedAt = now
        contractType = "Counter"
        metadata = Map.empty
        currentCid = counterAsMcmsReceiver
  let registryState = emptyRegistryState with
        registrations = Map.fromList [(counterInstanceId, registration)]

  -- Create MCMS with registry containing active contract
  let readyTime = addRelTime now (seconds (-1))
  let calls = [TimelockCall with
        targetInstanceId = counterInstanceId
        functionName = "Increment"
        operationData = ""]
  let opId = hashTimelockOpId calls zeroHash "test-salt-4"

  mcmsCid <- submit owner do
    createCmd MCMS with
      owner
      instanceId = mcmsInstanceId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.fromList [(opId, readyTime)]
      registry = registryState

  -- ExecuteScheduledBatch should succeed because counter is Active
  -- CID is looked up from registry, no targetCids needed
  submit owner do
    exerciseCmd mcmsCid ExecuteScheduledBatch with
      submitter = owner
      opId
      calls
      predecessor = zeroHash
      salt = "test-salt-4"
      perCallContractIds = []

  -- Verify counter was incremented
  counterContracts <- query @Counter owner
  let activeCounters = filter (\(_, c) -> c.instanceId == counterInstanceId) counterContracts
  case activeCounters of
    [(_, counter)] -> assertMsg "Counter should be incremented to 1" $ counter.value == 1
    _ -> abort "Expected exactly one Counter contract"

  debug "testCallActiveRegisteredContractSucceeds PASSED!"
  pure ()
