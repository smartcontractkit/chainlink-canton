-- | Test: Complete upgrade, verify version updated, status=Active, history added
-- This test creates a mock receipt to simulate what ExecuteUpgrade would produce
testRegistryCompleteUpgrade : Script ()
testRegistryCompleteUpgrade = script do
  owner <- allocateParty "ccip_owner"
  let registryInstanceId = mkInstanceId "registry" owner
  let counterInstanceId = mkInstanceId "counter" owner
  let serviceInstanceId = mkInstanceId "upgrade-service" owner

  -- Create registry, register contract, initiate upgrade
  registryCid <- submit owner do
    createCmd MCMSRegistry with
      owner
      instanceId = registryInstanceId
      registrations = Map.empty
      pendingUpgrades = Map.empty
      upgradeHistory = Map.empty

  let regIfaceCid = toInterfaceContractId @MCMSReceiver registryCid
  result1 <- submit owner do
    exerciseCmd regIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "RegisterContract"
      operationData = encodeRegisterContractParams $ RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
      contractIds = []

  let regIfaceCid2 = toInterfaceContractId @MCMSReceiver (coerceContractId result1.selfCid : ContractId MCMSRegistry)
  result2 <- submit owner do
    exerciseCmd regIfaceCid2 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "InitiateUpgrade"
      operationData = encodeInitiateUpgradeParams $ InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "1.0.0"
        , toVersion = "2.0.0"
        , migrationParams = ""
        }
      contractIds = []

  -- Create mock UpgradeReceipt (simulating what ExecuteUpgrade would produce)
  now <- getTime
  receiptCid <- submit owner do
    createCmd UpgradeReceipt with
      owner
      instanceId = counterInstanceId
      fromVersion = "1.0.0"
      toVersion = "2.0.0"
      newContractCid = coerceContractId registryCid  -- Placeholder CID
      executedAt = now
      serviceInstanceId

  -- Complete upgrade with receipt
  let regIfaceCid3 = toInterfaceContractId @MCMSReceiver (coerceContractId result2.selfCid : ContractId MCMSRegistry)
  let receiptCidUntyped : ContractId () = coerceContractId receiptCid
  result3 <- submit owner do
    exerciseCmd regIfaceCid3 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "CompleteUpgrade"
      operationData = encodeCompleteUpgradeParams $ CompleteUpgradeParams
        { instanceId = counterInstanceId
        , newVersion = "2.0.0"
        }
      contractIds = [receiptCidUntyped]

  -- Verify status is Active and version is 2.0.0
  let afterCompleteCid : ContractId MCMSRegistry = coerceContractId result3.selfCid
  regInfo <- submit owner do
    exerciseCmd afterCompleteCid GetContractInfo with
      viewer = owner
      targetInstanceId = counterInstanceId

  case regInfo of
    None -> abort "Registration should exist"
    Some reg -> do
      assertMsg "Status should be Active" $ reg.status == Active
      assertMsg "Version should be 2.0.0" $ reg.version == "2.0.0"

  -- Verify no pending upgrade
  hasPending <- submit owner do
    exerciseCmd afterCompleteCid HasPendingUpgrade with
      viewer = owner
      targetInstanceId = counterInstanceId
  assertMsg "Should not have pending upgrade" $ not hasPending

  -- Verify history entry
  history <- submit owner do
    exerciseCmd afterCompleteCid GetUpgradeHistory with
      viewer = owner
      targetInstanceId = counterInstanceId
  assertMsg "History should have 1 entry" $ length history == 1
  let entry = head history
  assertMsg "fromVersion should be 1.0.0" $ entry.fromVersion == "1.0.0"
  assertMsg "toVersion should be 2.0.0" $ entry.toVersion == "2.0.0"

  -- Verify receipt was consumed (archived)
  receiptAfter <- queryContractId owner receiptCid
  assertMsg "Receipt should be consumed (archived)" $ receiptAfter == None

  debug "testRegistryCompleteUpgrade PASSED!"
  pure ()

