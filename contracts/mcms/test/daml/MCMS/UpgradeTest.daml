testRegistryDeprecateContract = script do
  owner <- allocateParty "ccip_owner"
  let registryInstanceId = mkInstanceId "registry" owner
  let counterInstanceId = mkInstanceId "counter" owner

  -- Create registry and register contract
  registryCid <- submit owner do
    createCmd MCMSRegistry with
      owner
      instanceId = registryInstanceId
      registrations = Map.empty
      pendingUpgrades = Map.empty
      upgradeHistory = Map.empty

  let regIfaceCid = toInterfaceContractId @MCMSReceiver registryCid
  result1 <- submit owner do
    exerciseCmd regIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "RegisterContract"
      operationData = encodeRegisterContractParams $ RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
      contractIds = []

  -- Deprecate contract (using simple text encoding for instanceId)
  let regIfaceCid2 = toInterfaceContractId @MCMSReceiver (coerceContractId result1.selfCid : ContractId MCMSRegistry)
  result2 <- submit owner do
    exerciseCmd regIfaceCid2 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "DeprecateContract"
      operationData = encodeCancelUpgradeParams $ CancelUpgradeParams { instanceId = counterInstanceId }
      contractIds = []

  -- Verify status is Deprecated
  let afterDeprecateCid : ContractId MCMSRegistry = coerceContractId result2.selfCid
  regInfo <- submit owner do
    exerciseCmd afterDeprecateCid GetContractInfo with
      viewer = owner
      targetInstanceId = counterInstanceId

  case regInfo of
    None -> abort "Registration should exist"
    Some reg -> do
      assertMsg "Status should be Deprecated" $ reg.status == Deprecated

  debug "testRegistryDeprecateContract PASSED!"
  pure ()

-- | Test: View functions (GetContractInfo, GetPendingUpgrade, GetUpgradeHistory, IsRegistered, HasPendingUpgrade)
testRegistryViewFunctions : Script ()
testRegistryViewFunctions = script do
  owner <- allocateParty "ccip_owner"
  let registryInstanceId = mkInstanceId "registry" owner
  let counterInstanceId = mkInstanceId "counter" owner
  let nonExistentId = mkInstanceId "nonexistent" owner

  -- Create registry and register contract
  registryCid <- submit owner do
    createCmd MCMSRegistry with
      owner
      instanceId = registryInstanceId
      registrations = Map.empty
      pendingUpgrades = Map.empty
      upgradeHistory = Map.empty

  let regIfaceCid = toInterfaceContractId @MCMSReceiver registryCid
  result1 <- submit owner do
    exerciseCmd regIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "RegisterContract"
      operationData = encodeRegisterContractParams $ RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
      contractIds = []

  let regCid : ContractId MCMSRegistry = coerceContractId result1.selfCid

  -- Test IsRegistered
  isReg <- submit owner do exerciseCmd regCid IsRegistered with viewer = owner, targetInstanceId = counterInstanceId
  assertMsg "counter should be registered" isReg

  isRegNonExistent <- submit owner do exerciseCmd regCid IsRegistered with viewer = owner, targetInstanceId = nonExistentId
  assertMsg "nonexistent should not be registered" $ not isRegNonExistent

  -- Test HasPendingUpgrade (should be false initially)
  hasPending <- submit owner do exerciseCmd regCid HasPendingUpgrade with viewer = owner, targetInstanceId = counterInstanceId
  assertMsg "Should not have pending upgrade initially" $ not hasPending

  -- Test GetContractInfo
  info <- submit owner do exerciseCmd regCid GetContractInfo with viewer = owner, targetInstanceId = counterInstanceId
  assertMsg "GetContractInfo should return Some" $ isSome info

  infoNonExistent <- submit owner do exerciseCmd regCid GetContractInfo with viewer = owner, targetInstanceId = nonExistentId
  assertMsg "GetContractInfo should return None for nonexistent" $ not (isSome infoNonExistent)

  -- Test GetUpgradeHistory (should be empty initially)
  history <- submit owner do exerciseCmd regCid GetUpgradeHistory with viewer = owner, targetInstanceId = counterInstanceId
  assertMsg "History should be empty initially" $ null history

  debug "testRegistryViewFunctions PASSED!"
  pure ()


-- ===========================================================================
-- COUNTER UPGRADE SERVICE TESTS (Simplified 1-step pattern)
-- ===========================================================================

-- | Test: ExecuteUpgrade via direct choice
-- Single atomic operation: fetch -> validate -> archive -> create -> receipt
testUpgradeServiceExecute : Script ()
testUpgradeServiceExecute = script do
  owner <- allocateParty "ccip_owner"
  let counterInstanceId = mkInstanceId "counter" owner
  let serviceInstanceId = mkInstanceId "upgrade-service" owner

  -- Create Counter with value=100
  counterCid <- submit owner do
    createCmd Counter with
      owner
      instanceId = counterInstanceId
      value = 100

  -- Create upgrade service
  serviceCid <- submit owner do
    createCmd CounterUpgradeService with
      owner
      serviceInstanceId

  -- Execute upgrade via direct choice
  (newServiceCid, newCounterV2Cid, receiptCid) <- submit owner do
    exerciseCmd serviceCid ExecuteUpgrade with
      upgradeData = counterInstanceId <> "|1.0.0|2.0.0"
      oldCounterCidUntyped = coerceContractId counterCid

  -- Verify new CounterV2 has correct state
  newCounter <- queryContractId owner newCounterV2Cid
  case newCounter of
    None -> abort "New CounterV2 should exist"
    Some c -> do
      assertMsg "Value should be 100" $ c.value == 100
      assertMsg "migratedFrom should be Some 1.0.0" $ c.migratedFrom == Some "1.0.0"
      assertMsg "instanceId should match" $ c.instanceId == counterInstanceId

  -- Verify UpgradeReceipt was created
  receipt <- queryContractId owner receiptCid
  case receipt of
    None -> abort "UpgradeReceipt should exist"
    Some r -> do
      assertMsg "Receipt instanceId should match" $ r.instanceId == counterInstanceId
      assertMsg "Receipt fromVersion should be 1.0.0" $ r.fromVersion == "1.0.0"
      assertMsg "Receipt toVersion should be 2.0.0" $ r.toVersion == "2.0.0"

  debug "testUpgradeServiceExecute PASSED!"
  pure ()

-- | Test: ExecuteUpgrade via MCMSReceiver interface
testUpgradeServiceExecuteViaMCMS : Script ()
testUpgradeServiceExecuteViaMCMS = script do
  owner <- allocateParty "ccip_owner"
  let counterInstanceId = mkInstanceId "counter" owner
  let serviceInstanceId = mkInstanceId "upgrade-service" owner

  -- Create Counter
  counterCid <- submit owner do
    createCmd Counter with
      owner
      instanceId = counterInstanceId
      value = 42

  -- Create upgrade service
  serviceCid <- submit owner do
    createCmd CounterUpgradeService with
      owner
      serviceInstanceId

  -- Execute upgrade via MCMSReceiver interface
  let serviceIfaceCid = toInterfaceContractId @MCMSReceiver serviceCid
  let counterCidUntyped : ContractId () = coerceContractId counterCid

  result <- submit owner do
    exerciseCmd serviceIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "ExecuteUpgrade"
      operationData = counterInstanceId <> "|1.0.0|2.0.0"
      contractIds = [counterCidUntyped]

  -- Verify outputCids contains UpgradeReceipt and CounterV2
  assertMsg "Should have 2 outputCids (receipt, CounterV2)" $ length result.outputCids == 2

  debug "testUpgradeServiceExecuteViaMCMS PASSED!"
  pure ()

-- | Test: Call ExecuteUpgrade with empty contractIds, expect E_MISSING_CONTRACT_ID
testUpgradeServiceMissingContractIds : Script ()
testUpgradeServiceMissingContractIds = script do
  owner <- allocateParty "ccip_owner"
  let counterInstanceId = mkInstanceId "counter" owner
  let serviceInstanceId = mkInstanceId "upgrade-service" owner

  -- Create upgrade service
  serviceCid <- submit owner do
    createCmd CounterUpgradeService with
      owner
      serviceInstanceId

  -- Try to execute upgrade with empty contractIds
  let serviceIfaceCid = toInterfaceContractId @MCMSReceiver serviceCid
  submitMustFail owner do
    exerciseCmd serviceIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "ExecuteUpgrade"
      operationData = counterInstanceId <> "|1.0.0|2.0.0"
      contractIds = []

  debug "testUpgradeServiceMissingContractIds PASSED!"
  pure ()

-- | Test: Upgrade fails on stale ContractId
-- If counter is modified after getting its CID, upgrade should fail
testUpgradeFailsOnStaleContractId : Script ()
testUpgradeFailsOnStaleContractId = script do
  owner <- allocateParty "ccip_owner"
  let counterInstanceId = mkInstanceId "counter" owner
  let serviceInstanceId = mkInstanceId "upgrade-service" owner

  -- Create Counter
  counterCid <- submit owner do
    createCmd Counter with
      owner
      instanceId = counterInstanceId
      value = 42

  -- Create upgrade service
  serviceCid <- submit owner do
    createCmd CounterUpgradeService with
      owner
      serviceInstanceId

  -- Modify the counter (this archives the old CID and creates a new one)
  newCounterCid <- submit owner do
    exerciseCmd counterCid Counter.Increment

  -- Try to upgrade with the OLD (stale) CID - should fail
  submitMustFail owner do
    exerciseCmd serviceCid ExecuteUpgrade with
      upgradeData = counterInstanceId <> "|1.0.0|2.0.0"
      oldCounterCidUntyped = coerceContractId counterCid  -- This CID is now stale!

  debug "testUpgradeFailsOnStaleContractId PASSED!"
  pure ()

