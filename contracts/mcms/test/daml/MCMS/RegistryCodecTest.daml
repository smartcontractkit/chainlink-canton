-- ===========================================================================
-- EDGE CASE TESTS
-- ===========================================================================

-- | Test: Empty strings in RegisterContractParams
testRegisterContractParamsCodecEmpty : Script ()
testRegisterContractParamsCodecEmpty = script do
  let params = RegisterContractParams
        { instanceId = ""
        , version = ""
        , contractType = ""
        , metadataKeys = []
        , metadataValues = []
        }

  let encoded = encodeRegisterContractParams params
  let decoded = decodeRegisterContractParams encoded

  case decoded of
    None -> abort "Failed to decode empty RegisterContractParams"
    Some p -> do
      assertMsg "instanceId should be empty" $ p.instanceId == ""
      assertMsg "version should be empty" $ p.version == ""
      assertMsg "contractType should be empty" $ p.contractType == ""

  debug "testRegisterContractParamsCodecEmpty PASSED!"
  pure ()

-- | Test: Special characters in instanceId
testRegisterContractParamsCodecSpecialChars : Script ()
testRegisterContractParamsCodecSpecialChars = script do
  let params = RegisterContractParams
        { instanceId = "counter-v1@party::namespace-12345"
        , version = "1.0.0-beta.1"
        , contractType = "Counter_V1"
        , metadataKeys = []
        , metadataValues = []
        }

  let encoded = encodeRegisterContractParams params
  let decoded = decodeRegisterContractParams encoded

  case decoded of
    None -> abort "Failed to decode RegisterContractParams with special chars"
    Some p -> do
      assertMsg "instanceId should match" $ p.instanceId == params.instanceId
      assertMsg "version should match" $ p.version == params.version
      assertMsg "contractType should match" $ p.contractType == params.contractType

  debug "testRegisterContractParamsCodecSpecialChars PASSED!"
  pure ()
