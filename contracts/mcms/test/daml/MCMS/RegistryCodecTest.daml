-- | Test: Encode/decode InitiateUpgradeParams roundtrip
testInitiateUpgradeParamsCodec : Script ()
testInitiateUpgradeParamsCodec = script do
  let params = InitiateUpgradeParams
        { instanceId = "counter@ccip_owner"
        , fromVersion = "1.0.0"
        , toVersion = "2.0.0"
        , migrationParams = ""
        }

  let encoded = encodeInitiateUpgradeParams params
  let decoded = decodeInitiateUpgradeParams encoded

  case decoded of
    None -> abort "Failed to decode InitiateUpgradeParams"
    Some p -> do
      assertMsg "instanceId should match" $ p.instanceId == params.instanceId
      assertMsg "fromVersion should match" $ p.fromVersion == params.fromVersion
      assertMsg "toVersion should match" $ p.toVersion == params.toVersion
      assertMsg "migrationParams should match" $ p.migrationParams == params.migrationParams

  debug "testInitiateUpgradeParamsCodec PASSED!"
  pure ()

-- | Test: Encode/decode InitiateUpgradeParams with migration params
testInitiateUpgradeParamsCodecWithMigration : Script ()
testInitiateUpgradeParamsCodecWithMigration = script do
  let params = InitiateUpgradeParams
        { instanceId = "feequoter@ccip_owner"
        , fromVersion = "1.5.0"
        , toVersion = "2.0.0"
        , migrationParams = "deadbeef"
        }

  let encoded = encodeInitiateUpgradeParams params
  let decoded = decodeInitiateUpgradeParams encoded

  case decoded of
    None -> abort "Failed to decode InitiateUpgradeParams with migration"
    Some p -> do
      assertMsg "instanceId should match" $ p.instanceId == params.instanceId
      assertMsg "fromVersion should match" $ p.fromVersion == params.fromVersion
      assertMsg "toVersion should match" $ p.toVersion == params.toVersion
      assertMsg "migrationParams should match" $ p.migrationParams == params.migrationParams

  debug "testInitiateUpgradeParamsCodecWithMigration PASSED!"
  pure ()

