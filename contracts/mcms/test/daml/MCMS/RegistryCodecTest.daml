-- | Registry Codec Tests
-- Roundtrip encode/decode tests for RegistryCodec operations
module MCMS.RegistryCodecTest where

import Daml.Script
import MCMS.RegistryCodec

-- ===========================================================================
-- REGISTER CONTRACT PARAMS TESTS
-- ===========================================================================

-- | Test: Encode/decode RegisterContractParams roundtrip
testRegisterContractParamsCodec : Script ()
testRegisterContractParamsCodec = script do
  let params = RegisterContractParams
        { instanceId = "counter@ccip_owner"
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }

  let encoded = encodeRegisterContractParams params
  let decoded = decodeRegisterContractParams encoded

  case decoded of
    None -> abort "Failed to decode RegisterContractParams"
    Some p -> do
      assertMsg "instanceId should match" $ p.instanceId == params.instanceId
      assertMsg "version should match" $ p.version == params.version
      assertMsg "contractType should match" $ p.contractType == params.contractType
      assertMsg "metadataKeys should match" $ p.metadataKeys == params.metadataKeys
      assertMsg "metadataValues should match" $ p.metadataValues == params.metadataValues

  debug "testRegisterContractParamsCodec PASSED!"
  pure ()

-- | Test: Encode/decode RegisterContractParams with metadata
testRegisterContractParamsCodecWithMetadata : Script ()
testRegisterContractParamsCodecWithMetadata = script do
  let params = RegisterContractParams
        { instanceId = "onramp@ccip_owner"
        , version = "2.0.0"
        , contractType = "OnRamp"
        , metadataKeys = ["chain", "env"]
        , metadataValues = ["canton", "prod"]
        }

  let encoded = encodeRegisterContractParams params
  let decoded = decodeRegisterContractParams encoded

  case decoded of
    None -> abort "Failed to decode RegisterContractParams with metadata"
    Some p -> do
      assertMsg "instanceId should match" $ p.instanceId == params.instanceId
      assertMsg "version should match" $ p.version == params.version
      assertMsg "contractType should match" $ p.contractType == params.contractType
      assertMsg "metadataKeys should match" $ p.metadataKeys == params.metadataKeys
      assertMsg "metadataValues should match" $ p.metadataValues == params.metadataValues

  debug "testRegisterContractParamsCodecWithMetadata PASSED!"
  pure ()

