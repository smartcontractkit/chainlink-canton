-- | Full Upgrade Flow Tests for MCMS Contract Upgrade Pattern
--
-- These tests demonstrate the complete MCMS contract upgrade workflow:
--
-- INITIAL DEPLOYMENT (Day 1):
--   - Deploy V1 contracts (Counter, MCMSRegistry)
--   - Register V1 with registry
--   - No upgrade service exists yet
--
-- UPGRADE TIME (Day 30):
--   - Deploy V2 additions (CounterV2, CounterUpgradeService)
--   - Create upgrade service instance
--   - Execute 3-step upgrade:
--     1. InitiateUpgrade on Registry
--     2. ExecuteUpgrade on Service (fetches state, archives V1, creates V2)
--     3. CompleteUpgrade on Registry
--
-- Key design: The upgrade service is created at upgrade time, not during initial deployment.
-- This avoids circular dependencies - V1 doesn't know V2.
--
module MCMS.UpgradeFlowTest where

import DA.Map qualified as Map
import Daml.Script
import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiver_Entrypoint(..))
import MCMS.MCMSRegistry
import MCMS.Counter (Counter(..))
import MCMS.CounterV2
import MCMS.RegistryCodec
import MCMS.TestHelpers (mkInstanceId)

-- ===========================================================================
-- FULL UPGRADE FLOW TESTS (Realistic Timeline)
-- ===========================================================================

-- | Test: Complete upgrade flow with realistic timeline
--
-- This test demonstrates the actual workflow for upgrading contracts:
--
-- === INITIAL DEPLOYMENT (Day 1) ===
-- At this point, only V1 exists. No upgrade service, no V2.
--   1. Deploy mcms.dar (contains MCMS, MCMSRegistry, Counter V1)
--   2. Create MCMSRegistry contract
--   3. Create Counter contract with initial value
--   4. Register Counter with registry (version=1.0.0, status=Active)
--
-- === UPGRADE TIME (Day 30) ===
-- When ready to upgrade, deploy V2 additions and execute upgrade.
--   5. Deploy updated mcms.dar (now includes CounterV2, CounterUpgradeService)
--   6. Create CounterUpgradeService contract (the upgrade executor)
--   7. Execute 3-step upgrade via MCMS:
--      a. InitiateUpgrade on Registry -> status=UpgradePending
--      b. ExecuteUpgrade on Service with [oldCounterCid] -> archives V1, creates V2
--      c. CompleteUpgrade on Registry -> status=Active, version=2.0.0
--
-- Key insight: The upgrade service is created at upgrade time, not during
-- initial deployment. Counter V1 doesn't know about V2 or the upgrade service.
--
testFullUpgradeFlow : Script ()
testFullUpgradeFlow = script do
  owner <- allocateParty "ccip_owner"
  let registryInstanceId = mkInstanceId "registry" owner
  let counterInstanceId = mkInstanceId "counter" owner
  let serviceInstanceId = mkInstanceId "upgrade-service" owner

  -- =========================================================================
  -- INITIAL DEPLOYMENT (Day 1)
  -- Only V1 contracts exist. No upgrade service yet.
  -- =========================================================================
  debug "=== INITIAL DEPLOYMENT (Day 1) ==="

  -- 1. Create MCMSRegistry
  debug "Creating MCMSRegistry..."
  registryCid <- submit owner do
    createCmd MCMSRegistry with
      owner
      instanceId = registryInstanceId
      registrations = Map.empty
      pendingUpgrades = Map.empty
      upgradeHistory = Map.empty

  -- 2. Create Counter V1 with initial value
  debug "Creating Counter V1 with value=100..."
  counterV1Cid <- submit owner do
    createCmd Counter with
      owner
      instanceId = counterInstanceId
      value = 100

  -- 3. Register Counter with registry
  debug "Registering Counter with registry (version=1.0.0)..."
  let regIfaceCid = toInterfaceContractId @MCMSReceiver registryCid
  result1 <- submit owner do
    exerciseCmd regIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "RegisterContract"
      operationData = encodeRegisterContractParams $ RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
      contractIds = []

  -- At this point, Counter V1 is operational. The registry tracks it.
  -- No CounterUpgradeService exists. No CounterV2 exists.
  debug "Initial deployment complete. Counter V1 is operational."

  -- =========================================================================
  -- UPGRADE TIME (Day 30)
  -- Now we want to upgrade. Deploy V2 and create upgrade service.
  -- =========================================================================
  debug "=== UPGRADE TIME (Day 30) ==="

  -- 4. Create CounterUpgradeService (deployed with V2 additions)
  -- In reality, this comes from an updated DAR that includes CounterV2.
  debug "Creating CounterUpgradeService (upgrade executor)..."
  serviceCid <- submit owner do
    createCmd CounterUpgradeService with
      owner
      serviceInstanceId

  -- 5. Execute 3-step upgrade
  debug "Executing 3-step upgrade..."

  -- Step 5a: InitiateUpgrade on Registry
  debug "  Step 1/3: InitiateUpgrade on Registry"
  let regIfaceCid2 = toInterfaceContractId @MCMSReceiver (coerceContractId result1.selfCid : ContractId MCMSRegistry)
  result2 <- submit owner do
    exerciseCmd regIfaceCid2 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "InitiateUpgrade"
      operationData = encodeInitiateUpgradeParams $ InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "1.0.0"
        , toVersion = "2.0.0"
        , migrationParams = ""
        }
      contractIds = []

  -- Step 5b: ExecuteUpgrade on UpgradeService
  -- This is the atomic operation: fetch state -> validate -> archive V1 -> create V2 -> receipt
  debug "  Step 2/3: ExecuteUpgrade on UpgradeService"
  let serviceIfaceCid = toInterfaceContractId @MCMSReceiver serviceCid
  let counterV1CidUntyped : ContractId () = coerceContractId counterV1Cid

  executeResult <- submit owner do
    exerciseCmd serviceIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "ExecuteUpgrade"
      operationData = counterInstanceId <> "|1.0.0|2.0.0"
      contractIds = [counterV1CidUntyped]

  -- ExecuteUpgrade returns [receiptCid, newCounterV2Cid] in outputCids
  assertMsg "ExecuteUpgrade should return 2 outputCids" $ length executeResult.outputCids == 2

  -- Step 5c: CompleteUpgrade on Registry
  -- Pass the receipt (first outputCid) from ExecuteUpgrade
  debug "  Step 3/3: CompleteUpgrade on Registry"
  let regIfaceCid3 = toInterfaceContractId @MCMSReceiver (coerceContractId result2.selfCid : ContractId MCMSRegistry)
  result3 <- submit owner do
    exerciseCmd regIfaceCid3 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "CompleteUpgrade"
      operationData = encodeCompleteUpgradeParams $ CompleteUpgradeParams
        { instanceId = counterInstanceId
        , newVersion = "2.0.0"
        }
      contractIds = executeResult.outputCids  -- Pass receipt from ExecuteUpgrade

  -- =========================================================================
  -- VERIFICATION
  -- =========================================================================
  debug "=== VERIFICATION ==="

  let finalRegCid : ContractId MCMSRegistry = coerceContractId result3.selfCid

  -- Verify registry shows version=2.0.0, status=Active
  regInfo <- submit owner do
    exerciseCmd finalRegCid GetContractInfo with
      viewer = owner
      targetInstanceId = counterInstanceId

  case regInfo of
    None -> abort "Registration should exist"
    Some reg -> do
      assertMsg "Status should be Active" $ reg.status == Active
      assertMsg "Version should be 2.0.0" $ reg.version == "2.0.0"
      debug $ "  Registry: version=" <> reg.version <> ", status=Active"

  -- Verify upgrade history has 1 entry
  history <- submit owner do
    exerciseCmd finalRegCid GetUpgradeHistory with
      viewer = owner
      targetInstanceId = counterInstanceId
  assertMsg "History should have 1 entry" $ length history == 1
  debug "  Upgrade history: 1 entry (1.0.0 -> 2.0.0)"

  debug "testFullUpgradeFlow PASSED!"
  pure ()

-- | Test: State migration preserves counter value
--
-- This test verifies that the upgrade service correctly reads state from
-- the old contract and transfers it to the new contract.
--
-- The key insight: State is read directly from the old contract at execution
-- time (zero staleness). The upgrade service calls `fetch oldCounterCid` and
-- reads `oldCounter.value` directly.
--
testUpgradeWithNonZeroValue : Script ()
testUpgradeWithNonZeroValue = script do
  owner <- allocateParty "ccip_owner"
  let counterInstanceId = mkInstanceId "counter" owner
  let serviceInstanceId = mkInstanceId "upgrade-service" owner

  -- Initial deployment: Counter V1 with value=42
  counterCid <- submit owner do
    createCmd Counter with
      owner
      instanceId = counterInstanceId
      value = 42

  -- Upgrade time: Create service and execute upgrade
  serviceCid <- submit owner do
    createCmd CounterUpgradeService with
      owner
      serviceInstanceId

  (_, newCounterV2Cid, _receiptCid) <- submit owner do
    exerciseCmd serviceCid ExecuteUpgrade with
      upgradeData = counterInstanceId <> "|1.0.0|2.0.0"
      oldCounterCidUntyped = coerceContractId counterCid

  -- Verify: CounterV2 has the migrated value
  newCounter <- queryContractId owner newCounterV2Cid
  case newCounter of
    None -> abort "New CounterV2 should exist"
    Some c -> do
      assertMsg "Value should be 42" $ c.value == 42
      assertMsg "migratedFrom should be Some 1.0.0" $ c.migratedFrom == Some "1.0.0"
      assertMsg "instanceId preserved" $ c.instanceId == counterInstanceId

  debug "testUpgradeWithNonZeroValue PASSED!"
  pure ()

-- | Test: Start upgrade, cancel before completion, verify contract still Active
testUpgradeCancelMidway : Script ()
testUpgradeCancelMidway = script do
  owner <- allocateParty "ccip_owner"
  let registryInstanceId = mkInstanceId "registry" owner
  let counterInstanceId = mkInstanceId "counter" owner

  -- Create registry and register contract
  registryCid <- submit owner do
    createCmd MCMSRegistry with
      owner
      instanceId = registryInstanceId
      registrations = Map.empty
      pendingUpgrades = Map.empty
      upgradeHistory = Map.empty

  let regIfaceCid = toInterfaceContractId @MCMSReceiver registryCid
  result1 <- submit owner do
    exerciseCmd regIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "RegisterContract"
      operationData = encodeRegisterContractParams $ RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
      contractIds = []

  -- Initiate upgrade
  let regIfaceCid2 = toInterfaceContractId @MCMSReceiver (coerceContractId result1.selfCid : ContractId MCMSRegistry)
  result2 <- submit owner do
    exerciseCmd regIfaceCid2 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "InitiateUpgrade"
      operationData = encodeInitiateUpgradeParams $ InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "1.0.0"
        , toVersion = "2.0.0"
        , migrationParams = ""
        }
      contractIds = []

  -- Cancel upgrade (before ExecuteUpgrade or CompleteUpgrade)
  let regIfaceCid3 = toInterfaceContractId @MCMSReceiver (coerceContractId result2.selfCid : ContractId MCMSRegistry)
  result3 <- submit owner do
    exerciseCmd regIfaceCid3 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "CancelUpgrade"
      operationData = encodeCancelUpgradeParams $ CancelUpgradeParams
        { instanceId = counterInstanceId
        }
      contractIds = []

  -- Verify contract is still Active with original version
  let finalRegCid : ContractId MCMSRegistry = coerceContractId result3.selfCid
  regInfo <- submit owner do
    exerciseCmd finalRegCid GetContractInfo with
      viewer = owner
      targetInstanceId = counterInstanceId

  case regInfo of
    None -> abort "Registration should exist"
    Some reg -> do
      assertMsg "Status should be Active" $ reg.status == Active
      assertMsg "Version should still be 1.0.0" $ reg.version == "1.0.0"

  debug "testUpgradeCancelMidway PASSED!"
  pure ()
