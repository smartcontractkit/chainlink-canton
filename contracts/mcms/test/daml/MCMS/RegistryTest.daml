-- | Registry Tests for MCMS Contract Registry
--
-- Tests for MCMSRegistry CRUD operations and view functions:
--   - Contract registration and duplicate detection
--   - Upgrade lifecycle (initiate, complete, cancel)
--   - Contract deprecation
--   - View functions (GetContractInfo, IsRegistered, etc.)
--
module MCMS.RegistryTest where

import DA.Map qualified as Map
import DA.List (head)
import DA.Optional (isSome)
import Daml.Script
import MCMS.MCMSReceiver (MCMSReceiver(..), MCMSReceiver_Entrypoint(..), UpgradeReceipt(..))
import MCMS.MCMSRegistry
import MCMS.RegistryCodec
import MCMS.TestHelpers (mkInstanceId)

-- ===========================================================================
-- REGISTRY TESTS
-- ===========================================================================

-- | Test: Register a contract, verify it appears in ListRegistrations with status=Active
testRegistryRegisterContract : Script ()
testRegistryRegisterContract = script do
  owner <- allocateParty "ccip_owner"
  let registryInstanceId = mkInstanceId "registry" owner
  let counterInstanceId = mkInstanceId "counter" owner

  -- Create registry
  registryCid <- submit owner do
    createCmd MCMSRegistry with
      owner
      instanceId = registryInstanceId
      registrations = Map.empty
      pendingUpgrades = Map.empty
      upgradeHistory = Map.empty

  -- Register contract via MCMSReceiver interface
  let regIfaceCid = toInterfaceContractId @MCMSReceiver registryCid
  result <- submit owner do
    exerciseCmd regIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "RegisterContract"
      operationData = encodeRegisterContractParams $ RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
      contractIds = []

  -- Coerce back to MCMSRegistry to verify
  let newRegCid : ContractId MCMSRegistry = coerceContractId result.selfCid
  registrations <- submit owner do
    exerciseCmd newRegCid ListRegistrations with viewer = owner
  assertMsg "Should have 1 registration" $ length registrations == 1

  -- Verify registration details
  let reg = head registrations
  assertMsg "InstanceId should match" $ reg.instanceId == counterInstanceId
  assertMsg "Version should be 1.0.0" $ reg.version == "1.0.0"
  assertMsg "Status should be Active" $ reg.status == Active
  assertMsg "ContractType should be Counter" $ reg.contractType == "Counter"

  debug "testRegistryRegisterContract PASSED!"
  pure ()

-- | Test: Attempt to register same instanceId twice, expect failure
testRegistryRegisterDuplicate : Script ()
testRegistryRegisterDuplicate = script do
  owner <- allocateParty "ccip_owner"
  let registryInstanceId = mkInstanceId "registry" owner
  let counterInstanceId = mkInstanceId "counter" owner

  -- Create registry
  registryCid <- submit owner do
    createCmd MCMSRegistry with
      owner
      instanceId = registryInstanceId
      registrations = Map.empty
      pendingUpgrades = Map.empty
      upgradeHistory = Map.empty

  -- Register contract first time
  let regIfaceCid = toInterfaceContractId @MCMSReceiver registryCid
  result <- submit owner do
    exerciseCmd regIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "RegisterContract"
      operationData = encodeRegisterContractParams $ RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
      contractIds = []

  -- Try to register same instanceId again - should fail
  let newRegIfaceCid2 = toInterfaceContractId @MCMSReceiver (coerceContractId result.selfCid : ContractId MCMSRegistry)
  submitMustFail owner do
    exerciseCmd newRegIfaceCid2 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "RegisterContract"
      operationData = encodeRegisterContractParams $ RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.1.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
      contractIds = []

  debug "testRegistryRegisterDuplicate PASSED!"
  pure ()

-- | Test: Initiate upgrade, verify status=UpgradePending, PendingUpgrade created
testRegistryInitiateUpgrade : Script ()
testRegistryInitiateUpgrade = script do
  owner <- allocateParty "ccip_owner"
  let registryInstanceId = mkInstanceId "registry" owner
  let counterInstanceId = mkInstanceId "counter" owner

  -- Create registry and register contract
  registryCid <- submit owner do
    createCmd MCMSRegistry with
      owner
      instanceId = registryInstanceId
      registrations = Map.empty
      pendingUpgrades = Map.empty
      upgradeHistory = Map.empty

  let regIfaceCid = toInterfaceContractId @MCMSReceiver registryCid
  result1 <- submit owner do
    exerciseCmd regIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "RegisterContract"
      operationData = encodeRegisterContractParams $ RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
      contractIds = []

  -- Initiate upgrade
  let regIfaceCid2 = toInterfaceContractId @MCMSReceiver (coerceContractId result1.selfCid : ContractId MCMSRegistry)
  result2 <- submit owner do
    exerciseCmd regIfaceCid2 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "InitiateUpgrade"
      operationData = encodeInitiateUpgradeParams $ InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "1.0.0"
        , toVersion = "2.0.0"
        , migrationParams = ""
        }
      contractIds = []

  -- Verify status is UpgradePending
  let afterUpgradeCid : ContractId MCMSRegistry = coerceContractId result2.selfCid
  regInfo <- submit owner do
    exerciseCmd afterUpgradeCid GetContractInfo with
      viewer = owner
      targetInstanceId = counterInstanceId

  case regInfo of
    None -> abort "Registration should exist"
    Some reg -> do
      assertMsg "Status should be UpgradePending" $ reg.status == UpgradePending

  -- Verify pending upgrade exists
  pendingUpgrade <- submit owner do
    exerciseCmd afterUpgradeCid GetPendingUpgrade with
      viewer = owner
      targetInstanceId = counterInstanceId

  case pendingUpgrade of
    None -> abort "PendingUpgrade should exist"
    Some pending -> do
      assertMsg "fromVersion should be 1.0.0" $ pending.fromVersion == "1.0.0"
      assertMsg "toVersion should be 2.0.0" $ pending.toVersion == "2.0.0"

  debug "testRegistryInitiateUpgrade PASSED!"
  pure ()

-- | Test: InitiateUpgrade on non-Active contract, expect failure
testRegistryInitiateUpgradeNotActive : Script ()
testRegistryInitiateUpgradeNotActive = script do
  owner <- allocateParty "ccip_owner"
  let registryInstanceId = mkInstanceId "registry" owner
  let counterInstanceId = mkInstanceId "counter" owner

  -- Create registry and register contract
  registryCid <- submit owner do
    createCmd MCMSRegistry with
      owner
      instanceId = registryInstanceId
      registrations = Map.empty
      pendingUpgrades = Map.empty
      upgradeHistory = Map.empty

  let regIfaceCid = toInterfaceContractId @MCMSReceiver registryCid
  result1 <- submit owner do
    exerciseCmd regIfaceCid MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "RegisterContract"
      operationData = encodeRegisterContractParams $ RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
      contractIds = []

  -- Initiate upgrade first time (this works)
  let regIfaceCid2 = toInterfaceContractId @MCMSReceiver (coerceContractId result1.selfCid : ContractId MCMSRegistry)
  result2 <- submit owner do
    exerciseCmd regIfaceCid2 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "InitiateUpgrade"
      operationData = encodeInitiateUpgradeParams $ InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "1.0.0"
        , toVersion = "2.0.0"
        , migrationParams = ""
        }
      contractIds = []

  -- Try to initiate upgrade again when already UpgradePending - should fail
  let regIfaceCid3 = toInterfaceContractId @MCMSReceiver (coerceContractId result2.selfCid : ContractId MCMSRegistry)
  submitMustFail owner do
    exerciseCmd regIfaceCid3 MCMSReceiver_Entrypoint with
      caller = owner
      functionName = "InitiateUpgrade"
      operationData = encodeInitiateUpgradeParams $ InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "2.0.0"
        , toVersion = "3.0.0"
        , migrationParams = ""
        }
      contractIds = []

  debug "testRegistryInitiateUpgradeNotActive PASSED!"
  pure ()

