-- | Registry Tests for MCMS Embedded Registry
--
-- Tests for registry state transition functions:
--   - Contract registration and duplicate detection
--   - Upgrade lifecycle (initiate, complete, cancel)
--   - Contract deprecation
--   - Query functions (getContractInfo, isRegistered, etc.)
--
-- With embedded registry, these are now pure function tests
-- rather than template choice tests.
--
module MCMS.RegistryTest where

import DA.Map qualified as Map
import DA.List (head)
import DA.Optional (isSome)
import DA.Date (datetime, Month(..))
import Daml.Script
import MCMS.MCMSRegistry
import MCMS.MCMSReceiver (MCMSReceiver)
import MCMS.RegistryCodec
import MCMS.Counter (Counter(..))
import DA.Text qualified
import DA.Time (seconds, addRelTime)

-- | Helper to create a mock contract CID for testing registerContract
-- Creates a Counter and returns its CID coerced to MCMSReceiver
createMockContractCid : Party -> Text -> Script (ContractId MCMSReceiver)
createMockContractCid owner instanceId = do
  counterCid <- submit owner do
    createCmd Counter with
      owner = owner
      instanceId = instanceId
      value = 0
  pure $ toInterfaceContractId @MCMSReceiver counterCid

-- ===========================================================================
-- PURE FUNCTION TESTS (RegistryState transitions)
-- ===========================================================================

-- | Test: Register a contract, verify it appears with status=Active
testRegistryRegisterContract : Script ()
testRegistryRegisterContract = script do
  ccipOwner <- allocateParty "ccip_owner"
  let counterInstanceId = "counter@" <> partyToText ccipOwner
  now <- getTime

  -- Create mock contract to get a CID
  mockCid <- createMockContractCid ccipOwner counterInstanceId

  -- Register contract using pure function
  let params = RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
  let result = registerContract emptyRegistryState params mockCid now

  case result of
    Left err -> abort $ "Expected success, got error: " <> err
    Right newState -> do
      -- Verify registration exists
      let registrations = listRegistrations newState
      assertMsg "Should have 1 registration" $ length registrations == 1

      -- Verify registration details
      let reg = head registrations
      assertMsg "InstanceId should match" $ reg.instanceId == counterInstanceId
      assertMsg "Version should be 1.0.0" $ reg.version == "1.0.0"
      assertMsg "Status should be Active" $ reg.status == Active
      assertMsg "ContractType should be Counter" $ reg.contractType == "Counter"

  debug "testRegistryRegisterContract PASSED!"
  pure ()

-- | Test: Attempt to register same instanceId twice, expect failure
testRegistryRegisterDuplicate : Script ()
testRegistryRegisterDuplicate = script do
  ccipOwner <- allocateParty "ccip_owner"
  let counterInstanceId = "counter@" <> partyToText ccipOwner
  now <- getTime

  -- Create mock contract to get a CID
  mockCid <- createMockContractCid ccipOwner counterInstanceId

  let params = RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }

  -- Register first time
  let result1 = registerContract emptyRegistryState params mockCid now
  case result1 of
    Left err -> abort $ "First registration should succeed: " <> err
    Right state1 -> do
      -- Try to register same instanceId again
      let params2 = params with version = "1.1.0"
      let result2 = registerContract state1 params2 mockCid now

      case result2 of
        Left err -> do
          assertMsg "Error should mention already registered" $
            "E_ALREADY_REGISTERED" `DA.Text.isInfixOf` err
          debug "testRegistryRegisterDuplicate PASSED!"
        Right _ -> abort "Second registration should have failed"

  pure ()

-- | Test: Initiate upgrade, verify status=UpgradePending, PendingUpgrade created
testRegistryInitiateUpgrade : Script ()
testRegistryInitiateUpgrade = script do
  ccipOwner <- allocateParty "ccip_owner"
  let counterInstanceId = "counter@" <> partyToText ccipOwner
  now <- getTime

  -- Create mock contract to get a CID
  mockCid <- createMockContractCid ccipOwner counterInstanceId

  -- First register the contract
  let regParams = RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
  let Right state1 = registerContract emptyRegistryState regParams mockCid now

  -- Initiate upgrade
  let upgradeParams = InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "1.0.0"
        , toVersion = "2.0.0"
        , migrationParams = ""
        }
  let result = initiateUpgrade state1 upgradeParams now

  case result of
    Left err -> abort $ "Expected success, got error: " <> err
    Right state2 -> do
      -- Verify status is UpgradePending
      case getContractInfo state2 counterInstanceId of
        None -> abort "Registration should exist"
        Some reg -> do
          assertMsg "Status should be UpgradePending" $ reg.status == UpgradePending

      -- Verify pending upgrade exists
      case getPendingUpgrade state2 counterInstanceId of
        None -> abort "PendingUpgrade should exist"
        Some pending -> do
          assertMsg "fromVersion should be 1.0.0" $ pending.fromVersion == "1.0.0"
          assertMsg "toVersion should be 2.0.0" $ pending.toVersion == "2.0.0"

  debug "testRegistryInitiateUpgrade PASSED!"
  pure ()

-- | Test: InitiateUpgrade on non-Active contract, expect failure
testRegistryInitiateUpgradeNotActive : Script ()
testRegistryInitiateUpgradeNotActive = script do
  ccipOwner <- allocateParty "ccip_owner"
  let counterInstanceId = "counter@" <> partyToText ccipOwner
  now <- getTime

  -- Create mock contract to get a CID
  mockCid <- createMockContractCid ccipOwner counterInstanceId

  -- Register and initiate first upgrade
  let regParams = RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
  let Right state1 = registerContract emptyRegistryState regParams mockCid now

  let upgrade1Params = InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "1.0.0"
        , toVersion = "2.0.0"
        , migrationParams = ""
        }
  let Right state2 = initiateUpgrade state1 upgrade1Params now

  -- Try to initiate another upgrade while one is pending
  let upgrade2Params = InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "2.0.0"
        , toVersion = "3.0.0"
        , migrationParams = ""
        }
  let result = initiateUpgrade state2 upgrade2Params now

  case result of
    Left err -> do
      assertMsg "Error should mention not active" $
        "E_NOT_ACTIVE" `DA.Text.isInfixOf` err
      debug "testRegistryInitiateUpgradeNotActive PASSED!"
    Right _ -> abort "Second upgrade should have failed"

  pure ()

-- | Test: InitiateUpgrade with wrong fromVersion, expect failure
testRegistryInitiateUpgradeVersionMismatch : Script ()
testRegistryInitiateUpgradeVersionMismatch = script do
  ccipOwner <- allocateParty "ccip_owner"
  let counterInstanceId = "counter@" <> partyToText ccipOwner
  now <- getTime

  -- Create mock contract to get a CID
  mockCid <- createMockContractCid ccipOwner counterInstanceId

  -- Register contract at version 1.0.0
  let regParams = RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
  let Right state1 = registerContract emptyRegistryState regParams mockCid now

  -- Try to initiate upgrade with wrong fromVersion
  let upgradeParams = InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "0.9.0"  -- Wrong version
        , toVersion = "2.0.0"
        , migrationParams = ""
        }
  let result = initiateUpgrade state1 upgradeParams now

  case result of
    Left err -> do
      assertMsg "Error should mention version mismatch" $
        "E_VERSION_MISMATCH" `DA.Text.isInfixOf` err
      debug "testRegistryInitiateUpgradeVersionMismatch PASSED!"
    Right _ -> abort "Upgrade with wrong version should have failed"

  pure ()

-- | Test: Complete upgrade, verify version updated, status=Active, history added
testRegistryCompleteUpgrade : Script ()
testRegistryCompleteUpgrade = script do
  ccipOwner <- allocateParty "ccip_owner"
  let counterInstanceId = "counter@" <> partyToText ccipOwner
  now <- getTime
  let later = addRelTime now (seconds 3600)

  -- Create mock contract to get a CID
  mockCid <- createMockContractCid ccipOwner counterInstanceId

  -- Register and initiate upgrade
  let regParams = RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
  let Right state1 = registerContract emptyRegistryState regParams mockCid now

  let upgradeParams = InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "1.0.0"
        , toVersion = "2.0.0"
        , migrationParams = ""
        }
  let Right state2 = initiateUpgrade state1 upgradeParams now

  -- Complete upgrade
  let completeParams = CompleteUpgradeParams
        { instanceId = counterInstanceId
        , newVersion = "2.0.0"
        }
  let result = completeUpgrade state2 completeParams later

  case result of
    Left err -> abort $ "Expected success, got error: " <> err
    Right state3 -> do
      -- Verify status is Active and version is 2.0.0
      case getContractInfo state3 counterInstanceId of
        None -> abort "Registration should exist"
        Some reg -> do
          assertMsg "Status should be Active" $ reg.status == Active
          assertMsg "Version should be 2.0.0" $ reg.version == "2.0.0"

      -- Verify no pending upgrade
      assertMsg "Should not have pending upgrade" $
        not $ hasPendingUpgrade state3 counterInstanceId

      -- Verify history entry
      let history = getUpgradeHistory state3 counterInstanceId
      assertMsg "History should have 1 entry" $ length history == 1
      let entry = head history
      assertMsg "fromVersion should be 1.0.0" $ entry.fromVersion == "1.0.0"
      assertMsg "toVersion should be 2.0.0" $ entry.toVersion == "2.0.0"

  debug "testRegistryCompleteUpgrade PASSED!"
  pure ()

-- | Test: CompleteUpgrade without pending upgrade, expect failure
testRegistryCompleteUpgradeNoPending : Script ()
testRegistryCompleteUpgradeNoPending = script do
  ccipOwner <- allocateParty "ccip_owner"
  let counterInstanceId = "counter@" <> partyToText ccipOwner
  now <- getTime

  -- Create mock contract to get a CID
  mockCid <- createMockContractCid ccipOwner counterInstanceId

  -- Register contract (no upgrade initiated)
  let regParams = RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
  let Right state1 = registerContract emptyRegistryState regParams mockCid now

  -- Try to complete upgrade without initiating
  let completeParams = CompleteUpgradeParams
        { instanceId = counterInstanceId
        , newVersion = "2.0.0"
        }
  let result = completeUpgrade state1 completeParams now

  case result of
    Left err -> do
      assertMsg "Error should mention no pending upgrade" $
        "E_NO_PENDING_UPGRADE" `DA.Text.isInfixOf` err
      debug "testRegistryCompleteUpgradeNoPending PASSED!"
    Right _ -> abort "Complete without pending should have failed"

  pure ()

-- | Test: Cancel pending upgrade, verify status restored to Active
testRegistryCancelUpgrade : Script ()
testRegistryCancelUpgrade = script do
  ccipOwner <- allocateParty "ccip_owner"
  let counterInstanceId = "counter@" <> partyToText ccipOwner
  now <- getTime

  -- Create mock contract to get a CID
  mockCid <- createMockContractCid ccipOwner counterInstanceId

  -- Register and initiate upgrade
  let regParams = RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
  let Right state1 = registerContract emptyRegistryState regParams mockCid now

  let upgradeParams = InitiateUpgradeParams
        { instanceId = counterInstanceId
        , fromVersion = "1.0.0"
        , toVersion = "2.0.0"
        , migrationParams = ""
        }
  let Right state2 = initiateUpgrade state1 upgradeParams now

  -- Cancel upgrade
  let result = cancelUpgrade state2 counterInstanceId

  case result of
    Left err -> abort $ "Expected success, got error: " <> err
    Right state3 -> do
      -- Verify status is Active
      case getContractInfo state3 counterInstanceId of
        None -> abort "Registration should exist"
        Some reg -> do
          assertMsg "Status should be Active" $ reg.status == Active
          assertMsg "Version should still be 1.0.0" $ reg.version == "1.0.0"

      -- Verify no pending upgrade
      assertMsg "Should not have pending upgrade" $
        not $ hasPendingUpgrade state3 counterInstanceId

  debug "testRegistryCancelUpgrade PASSED!"
  pure ()

-- | Test: Deprecate contract, verify status=Deprecated
testRegistryDeprecateContract : Script ()
testRegistryDeprecateContract = script do
  ccipOwner <- allocateParty "ccip_owner"
  let counterInstanceId = "counter@" <> partyToText ccipOwner
  now <- getTime

  -- Create mock contract to get a CID
  mockCid <- createMockContractCid ccipOwner counterInstanceId

  -- Register contract
  let regParams = RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
  let Right state1 = registerContract emptyRegistryState regParams mockCid now

  -- Deprecate contract
  let result = deprecateContract state1 counterInstanceId

  case result of
    Left err -> abort $ "Expected success, got error: " <> err
    Right state2 -> do
      -- Verify status is Deprecated
      case getContractInfo state2 counterInstanceId of
        None -> abort "Registration should exist"
        Some reg -> do
          assertMsg "Status should be Deprecated" $ reg.status == Deprecated

  debug "testRegistryDeprecateContract PASSED!"
  pure ()

-- | Test: Query functions (getContractInfo, isRegistered, etc.)
testRegistryQueryFunctions : Script ()
testRegistryQueryFunctions = script do
  ccipOwner <- allocateParty "ccip_owner"
  let counterInstanceId = "counter@" <> partyToText ccipOwner
  let nonExistentId = "nonexistent@" <> partyToText ccipOwner
  now <- getTime

  -- Create mock contract to get a CID
  mockCid <- createMockContractCid ccipOwner counterInstanceId

  -- Register contract
  let regParams = RegisterContractParams
        { instanceId = counterInstanceId
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
  let Right state = registerContract emptyRegistryState regParams mockCid now

  -- Test isRegistered
  assertMsg "counter should be registered" $ isRegistered state counterInstanceId
  assertMsg "nonexistent should not be registered" $ not $ isRegistered state nonExistentId

  -- Test isRegisteredAndActive
  assertMsg "counter should be registered and active" $ isRegisteredAndActive state counterInstanceId
  assertMsg "nonexistent should not be registered and active" $ not $ isRegisteredAndActive state nonExistentId

  -- Test hasPendingUpgrade (should be false initially)
  assertMsg "Should not have pending upgrade initially" $ not $ hasPendingUpgrade state counterInstanceId

  -- Test getContractInfo
  assertMsg "GetContractInfo should return Some" $ isSome (getContractInfo state counterInstanceId)
  assertMsg "GetContractInfo should return None for nonexistent" $ not (isSome (getContractInfo state nonExistentId))

  -- Test getUpgradeHistory (should be empty initially)
  assertMsg "History should be empty initially" $ null (getUpgradeHistory state counterInstanceId)

  -- Test listRegistrations
  let registrations = listRegistrations state
  assertMsg "Should have 1 registration" $ length registrations == 1

  debug "testRegistryQueryFunctions PASSED!"
  pure ()

-- | Test: Multiple contracts and operations
testRegistryMultipleContracts : Script ()
testRegistryMultipleContracts = script do
  ccipOwner <- allocateParty "ccip_owner"
  let counter1Id = "counter1@" <> partyToText ccipOwner
  let counter2Id = "counter2@" <> partyToText ccipOwner
  now <- getTime

  -- Create mock contracts to get CIDs
  mockCid1 <- createMockContractCid ccipOwner counter1Id
  mockCid2 <- createMockContractCid ccipOwner counter2Id

  -- Register two contracts
  let regParams1 = RegisterContractParams
        { instanceId = counter1Id
        , version = "1.0.0"
        , contractType = "Counter"
        , metadataKeys = []
        , metadataValues = []
        }
  let regParams2 = RegisterContractParams
        { instanceId = counter2Id
        , version = "2.0.0"
        , contractType = "Counter"
        , metadataKeys = ["env"]
        , metadataValues = ["prod"]
        }

  let Right state1 = registerContract emptyRegistryState regParams1 mockCid1 now
  let Right state2 = registerContract state1 regParams2 mockCid2 now

  -- Verify both registrations
  let registrations = listRegistrations state2
  assertMsg "Should have 2 registrations" $ length registrations == 2

  -- Initiate upgrade on counter1 only
  let upgradeParams = InitiateUpgradeParams
        { instanceId = counter1Id
        , fromVersion = "1.0.0"
        , toVersion = "1.1.0"
        , migrationParams = ""
        }
  let Right state3 = initiateUpgrade state2 upgradeParams now

  -- Verify counter1 is UpgradePending, counter2 is still Active
  assertMsg "counter1 should have pending upgrade" $ hasPendingUpgrade state3 counter1Id
  assertMsg "counter2 should NOT have pending upgrade" $ not $ hasPendingUpgrade state3 counter2Id
  assertMsg "counter2 should still be active" $ isRegisteredAndActive state3 counter2Id

  debug "testRegistryMultipleContracts PASSED!"
  pure ()
