-- | Main test module for MCMS
-- Re-exports all test modules for easy execution
--
-- Test organization:
--   - CryptoTest.daml             : Cryptographic function verification (keccak256, merkle proofs, etc.)
--   - GroupVotingTest.daml        : Group voting algorithm tests (2-of-3, hierarchical groups)
--   - FlowTest.daml               : Full MCMS flow tests (SetRoot, replay protection)
--   - RegistryTest.daml           : Registry CRUD operations and view functions
--   - UpgradeServiceTest.daml     : UpgradeService contract execution tests
--   - UpgradeFlowTest.daml        : Full upgrade flow scenarios
--   - UpgradeReceiptTest.daml     : Receipt verification tests
--   - RegistryValidationTest.daml : MCMS registry validation during external calls
--   - RegistryCodecTest.daml      : Codec roundtrip tests for registry operations
--   - TestHelpers.daml            : Shared test utilities
module MCMS.Test where

import Daml.Script

-- Import all test modules
import MCMS.CryptoTest
import MCMS.GroupVotingTest
import MCMS.FlowTest
import MCMS.RegistryTest qualified as RegistryTest
import MCMS.UpgradeServiceTest qualified as UpgradeServiceTest
import MCMS.UpgradeFlowTest qualified as UpgradeFlowTest
import MCMS.UpgradeReceiptTest qualified as UpgradeReceiptTest
import MCMS.RegistryValidationTest qualified as RegistryValidationTest
import MCMS.RegistryCodecTest

-- ===========================================================================
-- MASTER TEST RUNNER
-- ===========================================================================

-- | Convenience runner for local/manual use.
-- Like `MCMS.FlowTest.runFlowTests`, we make this a *function* (not a top-level
-- `Script ()` value) so `daml test` doesn't execute it as part of the suite.
-- Aggregating multiple tests in one script shares a single ledger and can
-- introduce collisions (e.g. party allocation / contract keys).
testAll : () -> Script ()
testAll () = script do
  debug "=========================================="
  debug "MCMS POC - Running All Tests"
  debug "=========================================="

  -- Crypto tests
  debug ""
  debug "--- Crypto Tests ---"
  testAllCrypto

  -- Group voting tests
  debug ""
  debug "--- Group Voting Tests ---"
  testGroupVoting
  testHierarchicalGroups
  testGroupVotingEdgeCases
  testDuplicateSignerRejection

  -- Flow tests
  debug ""
  debug "--- Flow Tests ---"
  testFullFlow
  testFullFlowWithRealSignatures
  testReplayProtection
  testNonceOrdering
  testRootExpiry

  -- Note: Signatory check tests are in ExternalTargetTest.daml

  -- Registry tests
  debug ""
  debug "--- Registry Tests ---"
  RegistryTest.testRegistryRegisterContract
  RegistryTest.testRegistryRegisterDuplicate
  RegistryTest.testRegistryInitiateUpgrade
  RegistryTest.testRegistryInitiateUpgradeNotActive
  RegistryTest.testRegistryInitiateUpgradeVersionMismatch
  RegistryTest.testRegistryCompleteUpgrade
  RegistryTest.testRegistryCompleteUpgradeNoPending
  RegistryTest.testRegistryCancelUpgrade
  RegistryTest.testRegistryDeprecateContract
  RegistryTest.testRegistryViewFunctions

  -- Upgrade service tests
  debug ""
  debug "--- Upgrade Service Tests ---"
  UpgradeServiceTest.testUpgradeServiceExecute
  UpgradeServiceTest.testUpgradeServiceExecuteViaMCMS
  UpgradeServiceTest.testUpgradeServiceMissingContractIds
  UpgradeServiceTest.testUpgradeFailsOnStaleContractId
  UpgradeServiceTest.testUpgradeVersionMismatchRejected
  UpgradeServiceTest.testUpgradeTargetVersionMismatchRejected
  UpgradeServiceTest.testUpgradeInstanceIdMismatchRejected

  -- Full upgrade flow tests
  debug ""
  debug "--- Upgrade Flow Tests ---"
  UpgradeFlowTest.testFullUpgradeFlow
  UpgradeFlowTest.testUpgradeWithNonZeroValue
  UpgradeFlowTest.testUpgradeCancelMidway

  -- Receipt verification tests
  debug ""
  debug "--- Receipt Verification Tests ---"
  UpgradeReceiptTest.testCompleteUpgradeWithoutReceipt
  UpgradeReceiptTest.testCompleteUpgradeWithWrongReceipt
  UpgradeReceiptTest.testReceiptCannotBeReused

  -- Registry validation tests (MCMS external call validation)
  debug ""
  debug "--- Registry Validation Tests ---"
  RegistryValidationTest.testCallUnregisteredContractFails
  RegistryValidationTest.testCallDeprecatedContractFails
  RegistryValidationTest.testCallUpgradePendingContractFails
  RegistryValidationTest.testCallActiveRegisteredContractSucceeds

  -- Registry codec tests
  debug ""
  debug "--- Registry Codec Tests ---"
  testRegisterContractParamsCodec
  testRegisterContractParamsCodecWithMetadata
  testInitiateUpgradeParamsCodec
  testInitiateUpgradeParamsCodecWithMigration
  testCompleteUpgradeParamsCodec
  testCompleteUpgradeParamsCodecLongVersion
  testCancelUpgradeParamsCodec
  testCancelUpgradeParamsCodecLongId
  testRegisterContractParamsCodecEmpty
  testRegisterContractParamsCodecSpecialChars

  debug ""
  debug "=========================================="
  debug "All MCMS POC tests completed!"
  debug "=========================================="
