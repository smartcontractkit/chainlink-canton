-- | Main test module for MCMS
-- Re-exports all test modules for easy execution
--
-- Test organization:
--   - CryptoTest.daml        : Cryptographic function verification (keccak256, merkle proofs, etc.)
--   - GroupVotingTest.daml   : Group voting algorithm tests (2-of-3, hierarchical groups)
--   - FlowTest.daml          : Full MCMS flow tests (SetRoot, replay protection)
--   - UpgradeTest.daml       : Contract upgrade flow tests (MCMSRegistry, StateMigrationTicket)
--   - RegistryCodecTest.daml : Codec roundtrip tests for registry operations
--   - TestHelpers.daml       : Shared test utilities
module MCMS.Test where

import Daml.Script

-- Import all test modules
import MCMS.CryptoTest
import MCMS.GroupVotingTest
import MCMS.FlowTest
import MCMS.UpgradeTest
import MCMS.RegistryCodecTest

-- ===========================================================================
-- MASTER TEST RUNNER
-- ===========================================================================

-- | Convenience runner for local/manual use.
-- Like `MCMS.FlowTest.runFlowTests`, we make this a *function* (not a top-level
-- `Script ()` value) so `daml test` doesn't execute it as part of the suite.
-- Aggregating multiple tests in one script shares a single ledger and can
-- introduce collisions (e.g. party allocation / contract keys).
testAll : () -> Script ()
testAll () = script do
  debug "=========================================="
  debug "MCMS POC - Running All Tests"
  debug "=========================================="

  -- Crypto tests
  debug ""
  debug "--- Crypto Tests ---"
  testAllCrypto

  -- Group voting tests
  debug ""
  debug "--- Group Voting Tests ---"
  testGroupVoting
  testHierarchicalGroups
  testGroupVotingEdgeCases
  testDuplicateSignerRejection

  -- Flow tests
  debug ""
  debug "--- Flow Tests ---"
  testFullFlow
  testFullFlowWithRealSignatures
  testReplayProtection
  testNonceOrdering
  testRootExpiry

  -- Note: Signatory check tests are in ExternalTargetTest.daml

  -- Upgrade tests
  debug ""
  debug "--- Upgrade Tests ---"
  -- Registry tests
  testRegistryRegisterContract
  testRegistryRegisterDuplicate
  testRegistryInitiateUpgrade
  testRegistryInitiateUpgradeNotActive
  testRegistryInitiateUpgradeVersionMismatch
  testRegistryCompleteUpgrade
  testRegistryCompleteUpgradeNoPending
  testRegistryCancelUpgrade
  testRegistryDeprecateContract
  testRegistryViewFunctions
  -- Upgrade service tests (simplified 1-step pattern)
  testUpgradeServiceExecute
  testUpgradeServiceExecuteViaMCMS
  testUpgradeServiceMissingContractIds
  testUpgradeFailsOnStaleContractId
  testUpgradeVersionMismatchRejected
  testUpgradeTargetVersionMismatchRejected
  testUpgradeInstanceIdMismatchRejected
  -- Full upgrade flow tests
  testFullUpgradeFlow
  testUpgradeWithNonZeroValue
  testUpgradeCancelMidway

  -- Registry codec tests
  debug ""
  debug "--- Registry Codec Tests ---"
  testRegisterContractParamsCodec
  testRegisterContractParamsCodecWithMetadata
  testInitiateUpgradeParamsCodec
  testInitiateUpgradeParamsCodecWithMigration
  testCompleteUpgradeParamsCodec
  testCompleteUpgradeParamsCodecLongVersion
  testCancelUpgradeParamsCodec
  testCancelUpgradeParamsCodecLongId
  testRegisterContractParamsCodecEmpty
  testRegisterContractParamsCodecSpecialChars

  debug ""
  debug "=========================================="
  debug "All MCMS POC tests completed!"
  debug "=========================================="
