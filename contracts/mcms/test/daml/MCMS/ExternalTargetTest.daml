-- ===========================================================================
-- BYPASSER EXTERNAL CALL TESTS
-- ===========================================================================

-- | Test that bypasser can execute calls to external MCMSReceiver contracts
-- This is the main test for the external dispatch path in processCallsLoop
--
-- Flow: SetRoot(Bypasser) -> ExecuteOp(bypasser_execute_batch) -> Counter.increment
testBypasserExternalCall : Script ()
testBypasserExternalCall = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  let mcmsInstanceAddr = mkInstanceAddress externalTestBaseMcmsId ccipOwner
  let counterInstanceAddr = "counter@" <> partyToText ccipOwner

  -- Create MCMS with bypasser config
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = externalTestBaseMcmsId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState with config = externalTestConfig
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- Create Counter (external MCMSReceiver target)
  counterCid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = "counter"
      value = 0

  -- Verify initial counter value
  initialValue <- submit ccipOwner do
    exerciseCmd counterCid GetValue with viewer = ccipOwner
  assertMsg "Counter should start at 0" $ initialValue == 0

  -- SetRoot for bypasser
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Bypasser
      submitter = ccipOwner
      newRoot = externalBypasserRoot
      validUntil = externalTestValidUntil
      metadata = externalBypasserMetadata
      metadataProof = externalBypasserMetadataProof
      signatures = externalBypasserSignatures

  -- Coerce Counter to MCMSReceiver interface
  let counterAsMcmsReceiver = toInterfaceContractId @MCMSReceiver counterCid

  -- ExecuteOp with bypasser_execute_batch (targets Counter.increment)
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid ExecuteOp with
      targetRole = Bypasser
      submitter = ccipOwner
      op = externalBypasserOp
      opProof = externalBypasserOpProof
      targetCids = Map.fromList [(counterInstanceAddr, counterAsMcmsReceiver)]

  -- Verify counter was incremented
  -- Note: Counter is archived after MCMSReceiver_Entrypoint, need to query new one
  -- Actually Counter creates a new contract via archive+create pattern
  counterContracts <- query @Counter ccipOwner
  let activeCounters = filter (\(_, c) -> c.instanceId == "counter") counterContracts
  case activeCounters of
    [(_, counter)] -> do
      assertMsg "Counter should be incremented to 1" $ counter.value == 1
      debug "testBypasserExternalCall PASSED!"
    _ -> abort "Expected exactly one Counter contract"
  pure ()

-- | Test scheduled external call flow:
-- 1. Proposer schedules a batch targeting Counter
-- 2. Wait for delay to pass
-- 3. Execute the scheduled batch via ExecuteScheduledBatch
testScheduledExternalCall : Script ()
testScheduledExternalCall = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  let mcmsInstanceAddr = mkInstanceAddress externalTestBaseMcmsId ccipOwner
  let counterInstanceAddr = "counter@" <> partyToText ccipOwner

  -- Create MCMS with proposer config
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = externalTestBaseMcmsId
      chainId = 1
      proposer = emptyRoleState with config = externalTestConfig
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0  -- No delay for testing
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- Create Counter
  counterCid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = "counter"
      value = 0

  -- Verify initial counter value
  initialValue <- submit ccipOwner do
    exerciseCmd counterCid GetValue with viewer = ccipOwner
  assertMsg "Counter should start at 0" $ initialValue == 0

  -- SetRoot for proposer (schedule_batch authorization)
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Proposer
      submitter = ccipOwner
      newRoot = externalScheduleRoot
      validUntil = externalTestValidUntil
      metadata = externalScheduleMetadata
      metadataProof = externalScheduleMetadataProof
      signatures = externalScheduleSignatures

  -- ExecuteOp with schedule_batch (this schedules the Counter.increment call)
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid ExecuteOp with
      targetRole = Proposer
      submitter = ccipOwner
      op = externalScheduleOp
      opProof = externalScheduleOpProof
      targetCids = Map.empty

  -- Compute the opId for the scheduled batch
  let calls = [TimelockCall counterInstanceAddr "Increment" ""]
  let opId = hashTimelockOpId calls zeroHash externalScheduleSalt

  -- Verify operation was scheduled
  isOp <- submit ccipOwner do
    exerciseCmd mcmsCid IsOperation with
      submitter = ccipOwner
      opId

  assertMsg "Operation should be scheduled" isOp

  -- Set time to after the delay
  setTime (addRelTime externalTestValidUntil (seconds (-3600)))

  -- Coerce Counter to MCMSReceiver interface
  let counterAsMcmsReceiver = toInterfaceContractId @MCMSReceiver counterCid

  -- ExecuteScheduledBatch (this executes the Counter.increment call)
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid ExecuteScheduledBatch with
      submitter = ccipOwner
      opId
      calls
      predecessor = zeroHash
      salt = externalScheduleSalt
      targetCids = Map.fromList [(counterInstanceAddr, counterAsMcmsReceiver)]

  -- Verify counter was incremented
  counterContracts <- query @Counter ccipOwner
  let activeCounters = filter (\(_, c) -> c.instanceId == "counter") counterContracts
  case activeCounters of
    [(_, counter)] -> do
      assertMsg "Counter should be incremented to 1" $ counter.value == 1
      debug "testScheduledExternalCall PASSED!"
    _ -> abort "Expected exactly one Counter contract"
  pure ()

-- | Test that external call fails if targetInstanceAddress doesn't match
-- The op expects "counter@ccip_owner-9cefe94d" but we provide a different counter
testExternalCallWrongInstanceId : Script ()
testExternalCallWrongInstanceId = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  let mcmsInstanceAddr = mkInstanceAddress externalTestBaseMcmsId ccipOwner
  -- Create Counter with WRONG instanceId (doesn't match what's in the signed op)
  let wrongCounterInstanceId = "different-counter"

  -- Create MCMS with bypasser config
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = externalTestBaseMcmsId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState with config = externalTestConfig
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- Create Counter with wrong instanceId
  counterCid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = wrongCounterInstanceId  -- This doesn't match "counter" in the op
      value = 0

  -- SetRoot for bypasser
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Bypasser
      submitter = ccipOwner
      newRoot = externalBypasserRoot
      validUntil = externalTestValidUntil
      metadata = externalBypasserMetadata
      metadataProof = externalBypasserMetadataProof
      signatures = externalBypasserSignatures

  -- Coerce Counter to MCMSReceiver interface
  let counterAsMcmsReceiver = toInterfaceContractId @MCMSReceiver counterCid

  -- The operationData encodes calls to "counter@ccip_owner-9cefe94d" so use that as the key
  let expectedCounterInstanceId = "counter@" <> partyToText ccipOwner

  -- ExecuteOp should fail because the Counter's instanceAddress doesn't match
  -- what's encoded in the operationData ("counter@ccip_owner-9cefe94d")
  submitMustFail ccipOwner do
    exerciseCmd mcmsCid ExecuteOp with
      targetRole = Bypasser
      submitter = ccipOwner
      op = externalBypasserOp
      opProof = externalBypasserOpProof
      targetCids = Map.fromList [(expectedCounterInstanceId, counterAsMcmsReceiver)]

  debug "testExternalCallWrongInstanceId PASSED!"
  pure ()

-- | Test that external call fails if partyId in instanceAddress is not a signatory
-- Counter owned by malicious party but claiming ccipOwner's instanceAddress
testExternalCallForgedSignatory : Script ()
testExternalCallForgedSignatory = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")
  maliciousParty <- allocateParty "malicious"

  let mcmsInstanceAddr = mkInstanceAddress externalTestBaseMcmsId ccipOwner
  -- Counter owned by malicious party but with correct instanceId (the forgery is in ownership)
  let forgedInstanceAddr = "counter@" <> partyToText ccipOwner

  -- Create MCMS owned by ccipOwner
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = externalTestBaseMcmsId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState with config = externalTestConfig
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- Create Counter owned by malicious party (ccipOwner is NOT a signatory)
  -- The instanceId matches, but the owner/signatory is different
  counterCid <- submit maliciousParty do
    createCmd Counter with
      owner = maliciousParty  -- Different owner!
      instanceId = "counter"  -- Correct instanceId, but wrong owner
      value = 0

  -- SetRoot for bypasser
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Bypasser
      submitter = ccipOwner
      newRoot = externalBypasserRoot
      validUntil = externalTestValidUntil
      metadata = externalBypasserMetadata
      metadataProof = externalBypasserMetadataProof
      signatures = externalBypasserSignatures

  -- Coerce Counter to MCMSReceiver interface
  let counterAsMcmsReceiver = toInterfaceContractId @MCMSReceiver counterCid

  -- ExecuteOp should fail because:
  -- 1. The instanceAddress in operationData is "counter@ccip_owner-9cefe94d"
  -- 2. The Counter's instanceAddress matches that
  -- 3. BUT ccip_owner is NOT a signatory of the Counter contract
  -- This tests E_TARGET_SIGNATORY_MISMATCH
  submitMustFail ccipOwner do
    exerciseCmd mcmsCid ExecuteOp with
      targetRole = Bypasser
      submitter = ccipOwner
      op = externalBypasserOp
      opProof = externalBypasserOpProof
      targetCids = Map.fromList [(forgedInstanceAddr, counterAsMcmsReceiver)]

  debug "testExternalCallForgedSignatory PASSED!"
  pure ()

-- | Test execution of batch with multiple external targets
-- A single bypasser_execute_batch can call multiple MCMSReceiver contracts
testMultipleExternalTargets : Script ()
testMultipleExternalTargets = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  let mcmsInstanceAddr = mkInstanceAddress externalTestBaseMcmsId ccipOwner
  let counter1InstanceAddr = "counter1@" <> partyToText ccipOwner
  let counter2InstanceAddr = "counter2@" <> partyToText ccipOwner

  -- Create MCMS
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = externalTestBaseMcmsId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState with config = externalTestConfig
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- Create two Counter targets
  counter1Cid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = "counter1"
      value = 0

  counter2Cid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = "counter2"
      value = 10

  -- Note: This test requires vectors for a batch with 2 external calls.
  -- The current vectors only have 1 call. Would need to generate new vectors
  -- with: operationData encoding [counter1.increment, counter2.increment]
  -- For now, testBypasserExternalCall covers the single-target case.
  debug "testMultipleExternalTargets: Requires multi-call vectors (see testBypasserExternalCall for single-target)"
  pure ()

-- | Test mixed batch with both self-dispatch and external calls
-- A single batch can contain calls to both MCMS (self) and external contracts
testMixedSelfDispatchAndExternal : Script ()
testMixedSelfDispatchAndExternal = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  let mcmsInstanceAddr = mkInstanceAddress externalTestBaseMcmsId ccipOwner
  let counterInstanceAddr = "counter@" <> partyToText ccipOwner

  -- Create MCMS with minDelay = 0
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = externalTestBaseMcmsId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState with config = externalTestConfig
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- Create Counter target
  counterCid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = "counter"
      value = 0

  -- Note: This test requires vectors for a mixed batch with both self-dispatch
  -- and external calls. The current vectors have either self-dispatch OR external.
  -- Would need vectors with: [update_min_delay, counter.increment]
  -- Self-dispatch is tested in SelfDispatchTest.daml
  -- External dispatch is tested in testBypasserExternalCall/testScheduledExternalCall
  debug "testMixedSelfDispatchAndExternal: Requires mixed vectors (see SelfDispatchTest + testBypasserExternalCall)"
  pure ()

-- ===========================================================================
-- UNIT TESTS (no cryptographic signatures required)
-- ===========================================================================

-- | Test that Counter implements MCMSReceiver interface correctly
testCounterMcmsReceiverInterface : Script ()
testCounterMcmsReceiverInterface = script do
  ccipOwner <- allocateParty "ccip_owner"

  let counterInstanceAddr = "counter@" <> partyToText ccipOwner

  -- Create Counter
  counterCid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = "counter"
      value = 0

  -- Query counter value
  val <- submit ccipOwner do
    exerciseCmd counterCid GetValue with viewer = ccipOwner

  assertMsg "Counter value should be 0" $ val == 0

  -- Query instanceAddress
  instId <- submit ccipOwner do
    exerciseCmd counterCid GetInstanceAddressChoice with viewer = ccipOwner

  assertMsg "InstanceId should match" $ instId == counterInstanceAddr

  debug "testCounterMcmsReceiverInterface PASSED!"
  pure ()

-- | Test that Counter.mcmsEntrypoint dispatches correctly
-- (Would need to call through MCMSReceiver interface in production)
testCounterIncrementDirect : Script ()
testCounterIncrementDirect = script do
  ccipOwner <- allocateParty "ccip_owner"

  let counterInstanceAddr = "counter@" <> partyToText ccipOwner

  counterCid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = "counter"
      value = 5

  -- Verify value via query
  val <- submit ccipOwner do
    exerciseCmd counterCid GetValue with viewer = ccipOwner

  assertMsg "Counter should be 5" $ val == 5

  debug "testCounterIncrementDirect PASSED!"
  pure ()
