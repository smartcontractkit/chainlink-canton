-- | Test timelock schedule adds to map
testTimelockSchedule : Script ()
testTimelockSchedule = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  -- Create MCMS with test config
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = mkInstanceId timelockTestBaseMcmsId ccipOwner
      chainId = realTestChainId
      proposer = emptyRoleState with config = realTestConfig
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- SetRoot first
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Proposer
      submitter = ccipOwner
      newRoot = realTestRoot
      validUntil = realTestValidUntil
      metadata = realTestMetadata
      metadataProof = realTestMetadataProof
      signatures = realTestSignatures

  -- Check initial state - no timelock operations
  isOp <- submit ccipOwner do
    exerciseCmd mcmsCid IsOperation with
      submitter = ccipOwner
      opId = "test-op-id"

  assertMsg "Should not have operation initially" $ not isOp

  debug "Timelock schedule test PASSED!"
  pure ()

-- | Test timelock view functions
testTimelockViewFunctions : Script ()
testTimelockViewFunctions = script do
  ccipOwner <- allocateParty "ccip_owner"

  -- Create MCMS
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = mkInstanceId timelockTestBaseMcmsId ccipOwner
      chainId = realTestChainId
      proposer = emptyRoleState with config = realTestConfig
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- Test GetMinDelay (starts at 0 for testing)
  minDelayVal <- submit ccipOwner do
    exerciseCmd mcmsCid GetMinDelay with
      submitter = ccipOwner

  assertMsg "MinDelay should be 0 seconds" $ minDelayVal == seconds 0

  -- Test GetTimestamp for non-existent operation
  ts <- submit ccipOwner do
    exerciseCmd mcmsCid GetTimestamp with
      submitter = ccipOwner
      opId = "nonexistent"

  assertMsg "Timestamp should be None for nonexistent op" $ ts == None

  debug "Timelock view functions test PASSED!"
  pure ()

-- ===========================================================================
-- SELF-DISPATCH & BLOCKED FUNCTION TESTS
-- ===========================================================================

testBlockedFunctionCodec : Script ()
testBlockedFunctionCodec = script do
  let bf = BlockedFunction "counter@ccip_owner" "reset"
  let encoded = encodeBlockedFunction bf
  case decodeBlockedFunction encoded of
    None -> abort "Failed to decode BlockedFunction"
    Some decoded -> do
      assertMsg "targetInstanceId mismatch" $ decoded.targetInstanceId == bf.targetInstanceId
      assertMsg "functionName mismatch" $ decoded.functionName == bf.functionName
  debug "BlockedFunction codec roundtrip PASSED!"
  pure ()

testSelfDispatchSetConfigCodec : Script ()
testSelfDispatchSetConfigCodec = script do
  let params = SetConfigParams
        { signers = [SignerInfo "aabbccdd" 0 0]
        , groupQuorums = [1] <> replicate 31 0
        , groupParents = replicate 32 0
        , clearRoot = True
        }
  let encoded = encodeSelfDispatchSetConfig Proposer params
  case decodeSelfDispatchSetConfig encoded of
    None -> abort "Failed to decode self-dispatch set_config"
    Some (role, decoded) -> do
      assertMsg "Role should be Proposer" $ role == Proposer
      assertMsg "Signers mismatch" $ decoded.signers == params.signers
      assertMsg "Quorums mismatch" $ decoded.groupQuorums == params.groupQuorums
      assertMsg "ClearRoot mismatch" $ decoded.clearRoot == True
  let encodedBypasser = encodeSelfDispatchSetConfig Bypasser params
  case decodeSelfDispatchSetConfig encodedBypasser of
    None -> abort "Failed to decode bypasser set_config"
    Some (role2, _) ->
      assertMsg "Role should be Bypasser" $ role2 == Bypasser
  debug "SelfDispatchSetConfig codec roundtrip PASSED!"
  pure ()

testBlockedFunctionOnMCMS : Script ()
testBlockedFunctionOnMCMS = script do
  ccipOwner <- allocateParty "ccip_owner"
  let bf1 = BlockedFunction "counter@ccip_owner" "reset"
  let bf2 = BlockedFunction "counter@ccip_owner" "set_value"
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = mkInstanceId "test-blocked" ccipOwner
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = [bf1, bf2]
      timelockTimestamps = Map.empty
  blocked <- submit ccipOwner do
    exerciseCmd mcmsCid GetBlockedFunctions with submitter = ccipOwner
  assertMsg "Should have 2 blocked functions" $ length blocked == 2
  assertMsg "First blocked function mismatch" $ (blocked !! 0) == bf1
  cnt <- submit ccipOwner do
    exerciseCmd mcmsCid GetBlockedFunctionsCount with submitter = ccipOwner
  assertMsg "Count should be 2" $ cnt == 2
  debug "BlockedFunction on MCMS test PASSED!"
  pure ()

