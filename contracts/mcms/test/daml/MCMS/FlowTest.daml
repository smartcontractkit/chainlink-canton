-- Signer config (2-of-3 quorum)
-- Signers sorted by address (generated from deterministic seeds 42001, 42002, 42003)
realTestSigners : [SignerInfo]
realTestSigners =
  [ SignerInfo "629f74657968bf4ea61fbddfbd261b92b0131a33" 0 0
  , SignerInfo "6d04eabf05ea3cee980fa6983e8878ba7e60a7a3" 1 0
  , SignerInfo "d4da36bf6d1e1971ff224db91724cdc6117d117d" 2 0
  ]

realTestConfig : MultisigConfig
realTestConfig = MultisigConfig
  { signers = realTestSigners
  , groupQuorums = [2] <> replicate 31 0  -- 2-of-3 quorum in group 0
  , groupParents = replicate 32 0
  }

realTestChainId : Int
realTestChainId = 1

realTestMcmsId : Text
realTestMcmsId = "mcms-daml-test"

realTestInstanceId : Text
realTestInstanceId = "mcms-daml-test@ccip_owner-9cefe94d"

realTestProposerMultisigId : Text
realTestProposerMultisigId = makeMcmsId realTestInstanceId Proposer

-- targetInstanceAddress includes @partyId matching Daml sandbox partyToText
-- We allocate the party by a fixed PartyIdHint so the real signature vectors stay valid.
-- (These test vectors include partyToText in targetInstanceAddress via "baseId@partyId".)
realTestOp : Op
realTestOp = Op
  { chainId = 1
  , multisigId = realTestProposerMultisigId
  , nonce = 0
  , targetInstanceAddress = "counter@ccip_owner-9cefe94d"
  , functionName = "Increment"
  , operationData = ""
  }

realTestMetadata : RootMetadata
realTestMetadata = RootMetadata
  { chainId = 1
  , multisigId = realTestProposerMultisigId
  , preOpCount = 0
  , postOpCount = 1
  , overridePreviousRoot = False
  }

realTestRoot : Text
realTestRoot = "b0c24fb52e41bd7c57349d687756d479dddb29f08f5d6926ab12ad51a88b6345"

realTestMetadataProof : [Text]
realTestMetadataProof =
  [ "fde5f82373423a46a09dcbafe6f5a253226a22ba0f623731b49347f28fc067ad"
  ]

realTestOpProof : [Text]
realTestOpProof =
  [ "0a1c782dfb71499f99ede0c2fd8b57302deb3225d41832158af0e03171c71ffc"
  ]

-- Real ECDSA secp256k1 signatures (ValidUntil: 2030-01-01T00:00:00Z)
-- Signatures are from the first 2 signers (sorted by address)
realTestSignatures : [RawSignature]
realTestSignatures =
  [ RawSignature
      { publicKey = "04c170cfd2dfedf29d6dc68f57205d5b2a182dfbf0ae5fc4f6d9cb3382e6ab194e5e236469efad820ecceb3c474be2657747ea6d947fd79cb73f1834b45911cc2e"
      , r = "62053ea4227be80f8addbe603860a01fb4cbff3d909a7584e5306ceaeeb49bc5"
      , s = "362dbb73e126a9f2f3cc6b921f2ad8a1526cca0f27c5459baec39c2b4b29448c"
      }
  , RawSignature
      { publicKey = "04be6d6382ad269cab52671739bb27d4b3ac087c46c7956324810dee6fa311ef8eb1065e376017fe4a8d3d5ee0e86f837f9bb69f22331c1828e5521765f2cdee31"
      , r = "50d9449c84ca5f372841b68a2b16ca076a5cf5e84461242ddc9b8b738ec0ff4d"
      , s = "02f92d1233043f0890b44d0e0581276e283d9a93c3a2bb07fe63d1252ff7b83c"
      }
  ]

realTestValidUntil : Time
realTestValidUntil = datetime 2030 Jan 1 0 0 0

mkInstanceAddress : Text -> Party -> Text
mkInstanceAddress base party = base <> "@" <> partyToText party

-- ===========================================================================
-- TESTS
-- ===========================================================================

-- | Test the full MCMS flow with placeholder values
testFullFlow : Script ()
testFullFlow = script do
  -- Setup
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")
  let
    chainId = 1
    mcmsId = "test-mcms"
    mcmsInstanceAddr = mkInstanceAddress mcmsId ccipOwner

  -- Step 1: Create MCMS
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = mcmsId
      chainId
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- Step 2: Create Counter with instanceId (stable identifier)
  let counterInstId = "counter-v1"
  let counterId = counterInstId <> "@" <> partyToText ccipOwner
  counterCid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = counterInstId
      value = 0

  -- Step 3: Configure signers (2-of-3)
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetConfig with
      targetRole = Proposer
      newSigners = make2of3Config.signers
      newGroupQuorums = make2of3Config.groupQuorums
      newGroupParents = make2of3Config.groupParents
      clearRoot = False

  -- Step 4: Prepare operation and metadata
  let 
    op = Op chainId (makeMcmsId mcmsInstanceAddr Proposer) 0 counterId "Increment" ""
    metadata = RootMetadata chainId (makeMcmsId mcmsInstanceAddr Proposer) 0 1 False

  debug "Flow test setup complete"
  pure ()

-- | Test full flow with real ECDSA signatures
testFullFlowWithRealSignatures : Script ()
testFullFlowWithRealSignatures = script do
  -- Setup
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  -- Step 1: Create MCMS with real config
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = realTestMcmsId
      chainId = realTestChainId
      proposer = emptyRoleState with config = realTestConfig
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- Step 2: Create Counter (instanceId = "counter", full address = "counter@ccip_owner")
  let counterId = realTestOp.targetInstanceAddress
  counterCid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = "counter"
      value = 0

  -- Step 3: SetRoot with REAL signatures
  debug "Calling SetRoot with real ECDSA signatures..."
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Proposer
      submitter = ccipOwner
      newRoot = realTestRoot
      validUntil = realTestValidUntil
      metadata = realTestMetadata
      metadataProof = realTestMetadataProof
      signatures = realTestSignatures

  debug "SetRoot with real signatures PASSED!"
  pure ()

-- | Test replay protection - same signed hash should be rejected
testReplayProtection : Script ()
testReplayProtection = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  -- Create MCMS
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = realTestMcmsId
      chainId = realTestChainId
      proposer = emptyRoleState with config = realTestConfig
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- First SetRoot should succeed
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Proposer
      submitter = ccipOwner
      newRoot = realTestRoot
      validUntil = realTestValidUntil
      metadata = realTestMetadata
      metadataProof = realTestMetadataProof
      signatures = realTestSignatures

  -- Second SetRoot with same hash should fail
  submitMustFail ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Proposer
      submitter = ccipOwner
      newRoot = realTestRoot
      validUntil = realTestValidUntil
      metadata = realTestMetadata with overridePreviousRoot = True
      metadataProof = realTestMetadataProof
      signatures = realTestSignatures

  debug "Replay protection test PASSED!"
  pure ()

-- | Test nonce ordering - operations must be executed in order
testNonceOrdering : Script ()
testNonceOrdering = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  -- Create MCMS with initial opCount = 0
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = realTestMcmsId
      chainId = realTestChainId
      proposer = emptyRoleState with config = realTestConfig
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- SetRoot
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Proposer
      submitter = ccipOwner
      newRoot = realTestRoot
      validUntil = realTestValidUntil
      metadata = realTestMetadata
      metadataProof = realTestMetadataProof
      signatures = realTestSignatures

  -- Try to use op with nonce=5 (should fail, expected 0)
  let wrongNonceOp = realTestOp with nonce = 5

  debug "Testing wrong nonce rejection..."
  -- This should fail at CanExecuteOp check
  canExec <- submit ccipOwner do
    exerciseCmd mcmsCid CanExecuteOp with
      submitter = ccipOwner
      targetRole = Proposer
      op = wrongNonceOp

  assertMsg "Should not be able to execute op with wrong nonce" $ not canExec

  debug "Nonce ordering test PASSED!"
  pure ()

-- | Test root expiry - verify CanExecuteOp returns false for expired roots
testRootExpiry : Script ()
testRootExpiry = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  -- Create MCMS
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = realTestMcmsId
      chainId = realTestChainId
      proposer = emptyRoleState with config = realTestConfig
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- CanExecuteOp should return false because no root is set
  canExec <- submit ccipOwner do
    exerciseCmd mcmsCid CanExecuteOp with
      submitter = ccipOwner
      targetRole = Proposer
      op = realTestOp

  assertMsg "Should not be able to execute op with empty root" $ not canExec

  debug "Root expiry test PASSED!"
  pure ()

-- ===========================================================================
-- DISCLOSURE TESTS
-- ===========================================================================
-- Note: Signatory check tests (wrong instanceAddress, forged partyId, correct owner)
-- are in ExternalTargetTest.daml to avoid duplication.

-- | Test that a non-stakeholder CAN call ExecuteOp when disclosures are provided
-- This tests that third parties can submit ExecuteOp with proper disclosure
testNonStakeholderCanExecuteWithDisclosures : Script ()
testNonStakeholderCanExecuteWithDisclosures = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")
  thirdParty <- allocateParty "third_party"

  let mcmsInstanceAddr = mkInstanceAddress realTestMcmsId ccipOwner
  let counterInstanceAddr = "counter@" <> partyToText ccipOwner

  -- Create MCMS owned by ccipOwner
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = realTestMcmsId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState with config = realTestConfig
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- Create Counter owned by ccipOwner
  counterCid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = "counter"
      value = 0

  -- Use the external bypasser vectors
  let externalBypasserOp = Op
        { chainId = 1
        , multisigId = "mcms-daml-test@ccip_owner-9cefe94d-bypasser"
        , nonce = 0
        , targetInstanceAddress = "mcms-daml-test@ccip_owner-9cefe94d"
        , functionName = "BypasserExecuteBatch"
        , operationData = "011b636f756e74657240636369705f6f776e65722d396365666539346409496e6372656d656e740000"
        }
  let externalBypasserRoot = "a7457c6333efe2b0a43ac802b44ddd48e2eac8546a2f38eb618919baf72c1fcf"
  let externalBypasserMetadata = RootMetadata
        { chainId = 1
        , multisigId = "mcms-daml-test@ccip_owner-9cefe94d-bypasser"
        , preOpCount = 0
        , postOpCount = 1
        , overridePreviousRoot = False
        }
  let externalBypasserMetadataProof = ["4b3ccda2feecd6d800d30e85da902b0bc01c57d49c52d1106ce937aeb315159a"]
  let externalBypasserOpProof = ["66b94efb8d25d22230621e135eb2a7aac11336162aaf2d9643d09f5eafa3d7be"]
  let externalBypasserSignatures =
        [ RawSignature
            { publicKey = "04c170cfd2dfedf29d6dc68f57205d5b2a182dfbf0ae5fc4f6d9cb3382e6ab194e5e236469efad820ecceb3c474be2657747ea6d947fd79cb73f1834b45911cc2e"
            , r = "48e2ce205c50d6aa60aad325feeff55b397e5d8416d621e388ae7316748f71ff"
            , s = "0195474bb1dcffaf2a85a3725c26b29e1b6a3861d2a10c9a822714aa326e9fee"
            }
        , RawSignature
            { publicKey = "04be6d6382ad269cab52671739bb27d4b3ac087c46c7956324810dee6fa311ef8eb1065e376017fe4a8d3d5ee0e86f837f9bb69f22331c1828e5521765f2cdee31"
            , r = "aa30172bf05fac994d350b3e4ecae513cfb3c8eae3fd835d6fd91c7f0b79891d"
            , s = "279c483361a1b5ccb6727962592d236dde0d4021c4787c3a7190ef3d7b7ebcd7"
            }
        ]

  -- SetRoot for bypasser (submitted by owner)
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Bypasser
      submitter = ccipOwner
      newRoot = externalBypasserRoot
      validUntil = realTestValidUntil
      metadata = externalBypasserMetadata
      metadataProof = externalBypasserMetadataProof
      signatures = externalBypasserSignatures

  -- Coerce Counter to MCMSReceiver interface
  let counterAsMcmsReceiver = toInterfaceContractId @MCMSReceiver counterCid

  -- Third party submits ExecuteOp with ccipOwner as actAs party (disclosure)
  -- This tests that anyone with proper disclosure can submit the transaction
  mcmsCid <- submit (actAs ccipOwner <> actAs thirdParty) do
    exerciseCmd mcmsCid ExecuteOp with
      targetRole = Bypasser
      submitter = ccipOwner  -- The submitter in the choice is still ccipOwner
      op = externalBypasserOp
      opProof = externalBypasserOpProof
      targetCids = Map.fromList [(counterInstanceAddr, counterAsMcmsReceiver)]

  -- Verify counter was incremented
  counterContracts <- query @Counter ccipOwner
  let activeCounters = filter (\(_, c) -> c.instanceId == "counter") counterContracts
  case activeCounters of
    [(_, counter)] -> do
      assertMsg "Counter should be incremented to 1" $ counter.value == 1
      debug "testNonStakeholderCanExecuteWithDisclosures PASSED!"
    _ -> abort "Expected exactly one Counter contract"
  pure ()

-- ===========================================================================
-- CODEC TESTS
-- ===========================================================================

-- | Test SetConfigParams encoding/decoding roundtrip
testCodecRoundtrip : Script ()
testCodecRoundtrip = script do
  let testSigners =
        [ SignerInfo "aabbccdd" 0 0
        , SignerInfo "11223344" 1 0
        ]
  let testQuorums = [2] <> replicate 31 0
  let testParents = replicate 32 0

  let params = SetConfigParams
        { signers = testSigners
        , groupQuorums = testQuorums
        , groupParents = testParents
        , clearRoot = True
        }

  -- Encode
  let encoded = encodeSetConfigParams params

  debug $ "Encoded SetConfigParams: " <> encoded

  -- Decode
  case decodeSetConfigParams encoded of
    None -> abort "Failed to decode SetConfigParams"
    Some decoded -> do
      assertMsg "Signers should match" $ decoded.signers == testSigners
      assertMsg "GroupQuorums should match" $ decoded.groupQuorums == testQuorums
      assertMsg "GroupParents should match" $ decoded.groupParents == testParents
      assertMsg "ClearRoot should match" $ decoded.clearRoot == True

  debug "Codec roundtrip test PASSED!"
  pure ()

-- ===========================================================================
-- MCMS OP TESTS (Self-Dispatch)
-- Note: Full integration tests with real signatures are in Go tests
-- These tests verify the Daml logic and codec functionality
-- ===========================================================================

-- | Test ExecuteMcmsOp with encoded operationData
-- This tests the codec decoding path (like Aptos BCS deserialization)
testExecuteMcmsOp : Script ()
testExecuteMcmsOp = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  -- Create MCMS with test config
  let testChainId = 1
  let testMcmsId = "test-mcmsop-mcms"
  let testSigners = realTestSigners
  let testConfig = realTestConfig

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = testMcmsId
      chainId = testChainId
      proposer = emptyRoleState with config = testConfig  -- 2-of-3 config
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- Encode new config params (change from 2-of-3 to 1-of-3)
  let newParams = SetConfigParams
        { signers = testSigners
        , groupQuorums = [1] <> replicate 31 0  -- Changed from 2 to 1
        , groupParents = replicate 32 0
        , clearRoot = False
        }
  let encodedParams = encodeSetConfigParams newParams

  debug $ "Encoded MCMS params: " <> encodedParams

  -- Test that we can decode it
  case decodeSetConfigParams encodedParams of
    None -> abort "Failed to decode MCMS params"
    Some decoded -> do
      assertMsg "Decoded quorum should be 1" $ (decoded.groupQuorums !! 0) == 1

  debug "MCMS op encoding test PASSED!"
  debug "Full ExecuteMcmsOp flow is tested in Go integration tests"
  pure ()

-- | Test that decoding rejects truncated/malformed data
testMcmsOpInvalidData : Script ()
testMcmsOpInvalidData = script do
  -- Test with truncated data (claims 3 signers but has no data)
  let truncatedData = "03"  -- Just the length byte claiming 3 signers, no actual data
  case decodeSetConfigParams truncatedData of
    None -> debug "Truncated data correctly rejected"
    Some _ -> abort "Should have rejected truncated data"

  -- Test with empty data
  let emptyData = ""
  case decodeSetConfigParams emptyData of
    None -> debug "Empty data correctly rejected"
    Some _ -> abort "Should have rejected empty data"

  debug "MCMS op invalid data test PASSED!"
  pure ()

-- | Test clear_root MCMS operation decoding
testMcmsOpClearRoot : Script ()
testMcmsOpClearRoot = script do
  -- Encode with clearRoot = True
  let params = SetConfigParams
        { signers = []
        , groupQuorums = replicate 32 0
        , groupParents = replicate 32 0
        , clearRoot = True
        }
  let encoded = encodeSetConfigParams params

  case decodeSetConfigParams encoded of
    None -> abort "Failed to decode clearRoot params"
    Some decoded -> do
      assertMsg "ClearRoot should be True" $ decoded.clearRoot

  debug "Clear root encoding test PASSED!"
  pure ()

-- ===========================================================================
-- TIMELOCK TESTS
-- ===========================================================================

-- | Test timelock schedule adds to map
testTimelockSchedule : Script ()
testTimelockSchedule = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  -- Create MCMS with test config
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = realTestMcmsId
      chainId = realTestChainId
      proposer = emptyRoleState with config = realTestConfig
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- SetRoot first
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Proposer
      submitter = ccipOwner
      newRoot = realTestRoot
      validUntil = realTestValidUntil
      metadata = realTestMetadata
      metadataProof = realTestMetadataProof
      signatures = realTestSignatures

  -- Check initial state - no timelock operations
  isOp <- submit ccipOwner do
    exerciseCmd mcmsCid IsOperation with
      submitter = ccipOwner
      opId = "test-op-id"

  assertMsg "Should not have operation initially" $ not isOp

  debug "Timelock schedule test PASSED!"
  pure ()

-- | Test timelock view functions
testTimelockViewFunctions : Script ()
testTimelockViewFunctions = script do
  ccipOwner <- allocateParty "ccip_owner"

  -- Create MCMS
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = realTestMcmsId
      chainId = realTestChainId
      proposer = emptyRoleState with config = realTestConfig
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- Test GetMinDelay (starts at 0 for testing)
  minDelayVal <- submit ccipOwner do
    exerciseCmd mcmsCid GetMinDelay with
      submitter = ccipOwner

  assertMsg "MinDelay should be 0 seconds" $ minDelayVal == seconds 0

  -- Test GetTimestamp for non-existent operation
  ts <- submit ccipOwner do
    exerciseCmd mcmsCid GetTimestamp with
      submitter = ccipOwner
      opId = "nonexistent"

  assertMsg "Timestamp should be None for nonexistent op" $ ts == None

  debug "Timelock view functions test PASSED!"
  pure ()

-- ===========================================================================
-- SELF-DISPATCH & BLOCKED FUNCTION TESTS
-- ===========================================================================

testBlockedFunctionCodec : Script ()
testBlockedFunctionCodec = script do
  let bf = BlockedFunction "counter@ccip_owner" "reset"
  let encoded = encodeBlockedFunction bf
  case decodeBlockedFunction encoded of
    None -> abort "Failed to decode BlockedFunction"
    Some decoded -> do
      assertMsg "targetInstanceAddress mismatch" $ decoded.targetInstanceAddress == bf.targetInstanceAddress
      assertMsg "functionName mismatch" $ decoded.functionName == bf.functionName
  debug "BlockedFunction codec roundtrip PASSED!"
  pure ()

testSelfDispatchSetConfigCodec : Script ()
testSelfDispatchSetConfigCodec = script do
  let params = SetConfigParams
        { signers = [SignerInfo "aabbccdd" 0 0]
        , groupQuorums = [1] <> replicate 31 0
        , groupParents = replicate 32 0
        , clearRoot = True
        }
  let encoded = encodeSelfDispatchSetConfig Proposer params
  case decodeSelfDispatchSetConfig encoded of
    None -> abort "Failed to decode self-dispatch set_config"
    Some (role, decoded) -> do
      assertMsg "Role should be Proposer" $ role == Proposer
      assertMsg "Signers mismatch" $ decoded.signers == params.signers
      assertMsg "Quorums mismatch" $ decoded.groupQuorums == params.groupQuorums
      assertMsg "ClearRoot mismatch" $ decoded.clearRoot == True
  let encodedBypasser = encodeSelfDispatchSetConfig Bypasser params
  case decodeSelfDispatchSetConfig encodedBypasser of
    None -> abort "Failed to decode bypasser set_config"
    Some (role2, _) ->
      assertMsg "Role should be Bypasser" $ role2 == Bypasser
  debug "SelfDispatchSetConfig codec roundtrip PASSED!"
  pure ()

testBlockedFunctionOnMCMS : Script ()
testBlockedFunctionOnMCMS = script do
  ccipOwner <- allocateParty "ccip_owner"
  let bf1 = BlockedFunction "counter@ccip_owner" "Reset"
  let bf2 = BlockedFunction "counter@ccip_owner" "SetValue"
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = "test-blocked"
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = [bf1, bf2]
      timelockTimestamps = Map.empty
  blocked <- submit ccipOwner do
    exerciseCmd mcmsCid GetBlockedFunctions with submitter = ccipOwner
  assertMsg "Should have 2 blocked functions" $ length blocked == 2
  assertMsg "First blocked function mismatch" $ (blocked !! 0) == bf1
  cnt <- submit ccipOwner do
    exerciseCmd mcmsCid GetBlockedFunctionsCount with submitter = ccipOwner
  assertMsg "Count should be 2" $ cnt == 2
  debug "BlockedFunction on MCMS test PASSED!"
  pure ()

-- ===========================================================================
-- RUN ALL TESTS
-- ===========================================================================

-- NOTE: This is a convenience runner for local/manual use.
-- We intentionally make it a *function* (not a top-level `Script ()` value),
-- so `daml test` doesn't execute it. Running multiple flow tests in one
-- script shares a single ledger, which can cause collisions (e.g. fixed party
-- ids used by real-signature vectors).
runFlowTests : () -> Script ()
runFlowTests () = script do
  debug "Running MCMS flow tests..."
  testFullFlow
  testFullFlowWithRealSignatures
  testReplayProtection
  testNonceOrdering
  testRootExpiry
  -- Disclosure test (signatory checks are in ExternalTargetTest.daml)
  testNonStakeholderCanExecuteWithDisclosures
  -- Codec tests
  testCodecRoundtrip
  testExecuteMcmsOp
  testMcmsOpInvalidData
  testMcmsOpClearRoot
  -- Timelock tests
