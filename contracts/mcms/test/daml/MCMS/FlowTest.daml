-- | Test the full MCMS flow with placeholder values
testFullFlow : Script ()
testFullFlow = script do
  -- Setup
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")
  let 
    chainId = 1
    mcmsId = "test-mcms-proposer"
    
  -- Step 1: Create MCMS
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      role = Proposer
      chainId
      mcmsId
      config = emptyConfig
      seenHashes = Map.empty
      expiringRoot = emptyExpiringRoot
      rootMetadata = emptyRootMetadata

  -- Step 2: Create Counter with instanceId (stable identifier)
  let counterId = "counter-v1"
  counterCid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = counterId
      value = 0

  -- Step 3: Configure signers (2-of-3)
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetConfig with
      newSigners = make2of3Config.signers
      newGroupQuorums = make2of3Config.groupQuorums
      newGroupParents = make2of3Config.groupParents
      clearRoot = False

  -- Step 4: Prepare operation and metadata
  let 
    op = Op chainId mcmsId 0 counterId "increment" ""
    metadata = RootMetadata chainId mcmsId 0 1 False

  debug "Flow test setup complete"
  pure ()

-- | Test full flow with real ECDSA signatures
testFullFlowWithRealSignatures : Script ()
testFullFlowWithRealSignatures = script do
  -- Setup
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  -- Step 1: Create MCMS with real config
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      role = Proposer
      chainId = realTestChainId
      mcmsId = realTestMcmsId
      config = realTestConfig
      seenHashes = Map.empty
      expiringRoot = emptyExpiringRoot
      rootMetadata = emptyRootMetadata

  -- Step 2: Create Counter (view returns "counter@ccip_owner")
  counterCid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = "counter"
      value = 0

  -- Step 3: SetRoot with REAL signatures
  debug "Calling SetRoot with real ECDSA signatures..."
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      submitter = ccipOwner
      newRoot = realTestRoot
      validUntil = realTestValidUntil
      metadata = realTestMetadata
      metadataProof = realTestMetadataProof
      signatures = realTestSignatures

  debug "SetRoot with real signatures PASSED!"
  pure ()

-- | Test replay protection - same signed hash should be rejected
testReplayProtection : Script ()
testReplayProtection = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  -- Create MCMS
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      role = Proposer
      chainId = realTestChainId
      mcmsId = realTestMcmsId
      config = realTestConfig
      seenHashes = Map.empty
      expiringRoot = emptyExpiringRoot
      rootMetadata = emptyRootMetadata

  -- First SetRoot should succeed
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      submitter = ccipOwner
      newRoot = realTestRoot
      validUntil = realTestValidUntil
      metadata = realTestMetadata
      metadataProof = realTestMetadataProof
      signatures = realTestSignatures

  -- Second SetRoot with same hash should fail
  submitMustFail ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      submitter = ccipOwner
      newRoot = realTestRoot
      validUntil = realTestValidUntil
      metadata = realTestMetadata with overridePreviousRoot = True
      metadataProof = realTestMetadataProof
      signatures = realTestSignatures

  debug "Replay protection test PASSED!"
  pure ()

-- | Test nonce ordering - operations must be executed in order
testNonceOrdering : Script ()
testNonceOrdering = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  -- Create MCMS with initial opCount = 0
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      role = Proposer
      chainId = realTestChainId
      mcmsId = realTestMcmsId
      config = realTestConfig
      seenHashes = Map.empty
      expiringRoot = emptyExpiringRoot
      rootMetadata = emptyRootMetadata

  -- SetRoot
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      submitter = ccipOwner
      newRoot = realTestRoot
      validUntil = realTestValidUntil
      metadata = realTestMetadata
      metadataProof = realTestMetadataProof
      signatures = realTestSignatures

  -- Try to use op with nonce=5 (should fail, expected 0)
  let wrongNonceOp = realTestOp with nonce = 5

  debug "Testing wrong nonce rejection..."
  -- This should fail at CanExecuteOp check
  canExec <- submit ccipOwner do
    exerciseCmd mcmsCid CanExecuteOp with
      submitter = ccipOwner
      op = wrongNonceOp

  assertMsg "Should not be able to execute op with wrong nonce" $ not canExec

  debug "Nonce ordering test PASSED!"
  pure ()

-- | Test root expiry - verify CanExecuteOp returns false for expired roots
testRootExpiry : Script ()
testRootExpiry = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  -- Create MCMS
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      role = Proposer
      chainId = realTestChainId
      mcmsId = realTestMcmsId
      config = realTestConfig
      seenHashes = Map.empty
      expiringRoot = emptyExpiringRoot
      rootMetadata = emptyRootMetadata

  -- CanExecuteOp should return false because no root is set
  canExec <- submit ccipOwner do
    exerciseCmd mcmsCid CanExecuteOp with
      submitter = ccipOwner
      op = realTestOp

  assertMsg "Should not be able to execute op with empty root" $ not canExec

  debug "Root expiry test PASSED!"
  pure ()

-- ===========================================================================
-- SIGNATORY CHECK TESTS
-- ===========================================================================

-- | Test that ExecuteOp rejects targets whose instanceId doesn't match the approved op.
-- The attacker's Counter has owner=attacker, so its view returns
-- "counter@attacker" which doesn't match realTestOp.targetInstanceId ("counter@ccip_owner").
-- Fails at step 6 (E_WRONG_TARGET: instanceId mismatch).
testSignatoryCheckRejectsWrongOwner : Script ()
testSignatoryCheckRejectsWrongOwner = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")
  attacker <- allocateParty "attacker"

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      role = Proposer
      chainId = realTestChainId
      mcmsId = realTestMcmsId
      config = realTestConfig
      seenHashes = Map.empty
      expiringRoot = emptyExpiringRoot
      rootMetadata = emptyRootMetadata

  -- Attacker's Counter view returns "counter@attacker" ≠ "counter@ccip_owner"
  attackerCounterCid <- submit attacker do
    createCmd Counter with
      owner = attacker
      instanceId = "counter"
      value = 999

  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      submitter = ccipOwner
      newRoot = realTestRoot
      validUntil = realTestValidUntil
      metadata = realTestMetadata
      metadataProof = realTestMetadataProof
      signatures = realTestSignatures

  -- ExecuteOp fails: Counter view returns "counter@attacker" ≠ op.targetInstanceId "counter@ccip_owner"
  let attackerCounterAsMcmsReceiver = toInterfaceContractId @MCMSReceiver attackerCounterCid

  submitMustFail ccipOwner do
    exerciseCmd mcmsCid ExecuteOp with
      submitter = ccipOwner
      targetCid = attackerCounterAsMcmsReceiver
      op = realTestOp
      opProof = realTestOpProof
      contractIds = []

  debug "Signatory check test PASSED - correctly rejected target with mismatched instanceId!"
  pure ()

-- | Test that ExecuteOp succeeds when target's instanceId@partyId matches the op
-- and the parsed partyId is a signatory of the target.
testSignatoryCheckAcceptsCorrectOwner : Script ()
testSignatoryCheckAcceptsCorrectOwner = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      role = Proposer
      chainId = realTestChainId
      mcmsId = realTestMcmsId
      config = realTestConfig
      seenHashes = Map.empty
      expiringRoot = emptyExpiringRoot
      rootMetadata = emptyRootMetadata

  -- Counter instanceId = "counter", view returns "counter@ccip_owner"
  counterCid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = "counter"
      value = 0

  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      submitter = ccipOwner
      newRoot = realTestRoot
      validUntil = realTestValidUntil
      metadata = realTestMetadata
      metadataProof = realTestMetadataProof
      signatures = realTestSignatures

  let counterAsMcmsReceiver = toInterfaceContractId @MCMSReceiver counterCid

  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid ExecuteOp with
      submitter = ccipOwner
      targetCid = counterAsMcmsReceiver
      op = realTestOp
      opProof = realTestOpProof
      contractIds = []

  debug "Signatory check test PASSED - correctly accepted target with matching instanceId@partyId!"
  pure ()

-- | Test that ExecuteOp rejects a target that forges its view.instanceId to
-- match "counter@ccip_owner-..." even though ccip_owner is NOT a signatory of
-- the target contract. This should fail at step 7 with
-- E_TARGET_SIGNATORY_MISMATCH.
testSignatoryCheckRejectsForgedPartyId : Script ()
testSignatoryCheckRejectsForgedPartyId = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")
  attacker <- allocateParty "attacker"

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      role = Proposer
      chainId = realTestChainId
      mcmsId = realTestMcmsId
      config = realTestConfig
      seenHashes = Map.empty
      expiringRoot = emptyExpiringRoot
      rootMetadata = emptyRootMetadata

  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      submitter = ccipOwner
      newRoot = realTestRoot
      validUntil = realTestValidUntil
      metadata = realTestMetadata
      metadataProof = realTestMetadataProof
      signatures = realTestSignatures

  -- Create a target signed only by attacker, but whose view.instanceId is forged
  -- to claim it is controlled by ccip_owner.
  forgedCid <- submit attacker do
    createCmd MockForgedReceiver.ForgedReceiver with
      owner = attacker
      baseId = "counter"
      forgedPartyIdText = partyToText ccipOwner

  -- Disclose the forged contract to ccipOwner so MCMS can fetch it in ExecuteOp.
  forgedDisclosure <- fromSome <$> queryDisclosure attacker forgedCid

  let forgedAsMcmsReceiver = toInterfaceContractId @MCMSReceiver forgedCid

  submitMustFail (actAs ccipOwner <> discloseMany [forgedDisclosure]) do
    exerciseCmd mcmsCid ExecuteOp with
      submitter = ccipOwner
      targetCid = forgedAsMcmsReceiver
      op = realTestOp
      opProof = realTestOpProof
      contractIds = []

  debug "Forged partyId test PASSED - correctly rejected target with mismatched signatory!"
  pure ()

-- | Test that a non-stakeholder CAN call ExecuteOp when disclosures are provided.
-- Security model:
--   - Disclosures provide visibility (contract data for interpretation)
--   - MCMS owner's signatory authority propagates into the ExecuteOp choice body
--     (authorizers = actingParties ∪ signatories = {randomParty} ∪ {ccipOwner})
--   - fetch targetCid authorized: stakeholders ∩ authorizers ≠ ∅
--   - The partyId parsed from instanceId@partyId must be a signatory of the target
testNonStakeholderCanExecuteWithDisclosures : Script ()
testNonStakeholderCanExecuteWithDisclosures = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")
  randomParty <- allocateParty "random_party"

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      role = Proposer
      chainId = realTestChainId
      mcmsId = realTestMcmsId
      config = realTestConfig
      seenHashes = Map.empty
      expiringRoot = emptyExpiringRoot
      rootMetadata = emptyRootMetadata

  counterCid <- submit ccipOwner do
    createCmd Counter with
      owner = ccipOwner
      instanceId = "counter"
      value = 0

  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      submitter = ccipOwner
      newRoot = realTestRoot
      validUntil = realTestValidUntil
      metadata = realTestMetadata
      metadataProof = realTestMetadataProof
      signatures = realTestSignatures

  mcmsDisclosure <- fromSome <$> queryDisclosure ccipOwner mcmsCid
  counterDisclosure <- fromSome <$> queryDisclosure ccipOwner counterCid

  let counterAsMcmsReceiver = toInterfaceContractId @MCMSReceiver counterCid

  submit (actAs randomParty <> discloseMany [mcmsDisclosure, counterDisclosure]) do
    exerciseCmd mcmsCid ExecuteOp with
      submitter = randomParty
      targetCid = counterAsMcmsReceiver
      op = realTestOp
      opProof = realTestOpProof
      contractIds = []

  debug "Non-stakeholder with disclosures test PASSED!"
  pure ()

-- ===========================================================================
-- CODEC TESTS
-- ===========================================================================

-- | Test SetConfigParams encoding/decoding roundtrip
testCodecRoundtrip : Script ()
testCodecRoundtrip = script do
  let testSigners =
        [ SignerInfo "aabbccdd" 0 0
        , SignerInfo "11223344" 1 0
        ]
  let testQuorums = [2] <> replicate 31 0
  let testParents = replicate 32 0

  let params = SetConfigParams
        { signers = testSigners
        , groupQuorums = testQuorums
        , groupParents = testParents
        , clearRoot = True
        }

  -- Encode
  let encoded = encodeSetConfigParams params

  debug $ "Encoded SetConfigParams: " <> encoded

  -- Decode
  case decodeSetConfigParams encoded of
    None -> abort "Failed to decode SetConfigParams"
    Some decoded -> do
      assertMsg "Signers should match" $ decoded.signers == testSigners
      assertMsg "GroupQuorums should match" $ decoded.groupQuorums == testQuorums
      assertMsg "GroupParents should match" $ decoded.groupParents == testParents
      assertMsg "ClearRoot should match" $ decoded.clearRoot == True

  debug "Codec roundtrip test PASSED!"
  pure ()

-- ===========================================================================
-- MCMS OP TESTS (Self-Dispatch)
-- Note: Full integration tests with real signatures are in Go tests
-- These tests verify the Daml logic and codec functionality
-- ===========================================================================

-- | Test ExecuteMcmsOp with encoded operationData
-- This tests the codec decoding path (like Aptos BCS deserialization)
testExecuteMcmsOp : Script ()
testExecuteMcmsOp = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  -- Create MCMS with test config
  let testChainId = 1
  let testMcmsId = "test-mcmsop-mcms"
  let testSigners = realTestSigners
  let testConfig = realTestConfig

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      role = Proposer
      chainId = testChainId
      mcmsId = testMcmsId
      config = testConfig  -- 2-of-3 config
      seenHashes = Map.empty
      expiringRoot = emptyExpiringRoot
      rootMetadata = emptyRootMetadata

  -- Encode new config params (change from 2-of-3 to 1-of-3)
  let newParams = SetConfigParams
        { signers = testSigners
        , groupQuorums = [1] <> replicate 31 0  -- Changed from 2 to 1
        , groupParents = replicate 32 0
        , clearRoot = False
        }
  let encodedParams = encodeSetConfigParams newParams

  debug $ "Encoded MCMS params: " <> encodedParams

  -- Test that we can decode it
  case decodeSetConfigParams encodedParams of
    None -> abort "Failed to decode MCMS params"
    Some decoded -> do
      assertMsg "Decoded quorum should be 1" $ (decoded.groupQuorums !! 0) == 1

  debug "MCMS op encoding test PASSED!"
  debug "Full ExecuteMcmsOp flow is tested in Go integration tests"
  pure ()

-- | Test that decoding rejects truncated/malformed data
testMcmsOpInvalidData : Script ()
testMcmsOpInvalidData = script do
  -- Test with truncated data (claims 3 signers but has no data)
  let truncatedData = "03"  -- Just the length byte claiming 3 signers, no actual data
  case decodeSetConfigParams truncatedData of
    None -> debug "Truncated data correctly rejected"
    Some _ -> abort "Should have rejected truncated data"

  -- Test with empty data
  let emptyData = ""
  case decodeSetConfigParams emptyData of
    None -> debug "Empty data correctly rejected"
    Some _ -> abort "Should have rejected empty data"

  debug "MCMS op invalid data test PASSED!"
  pure ()

-- | Test clear_root MCMS operation decoding
testMcmsOpClearRoot : Script ()
testMcmsOpClearRoot = script do
  -- Encode with clearRoot = True
  let params = SetConfigParams
        { signers = []
        , groupQuorums = replicate 32 0
        , groupParents = replicate 32 0
        , clearRoot = True
        }
  let encoded = encodeSetConfigParams params

  case decodeSetConfigParams encoded of
    None -> abort "Failed to decode clearRoot params"
    Some decoded -> do
      assertMsg "ClearRoot should be True" $ decoded.clearRoot

  debug "Clear root encoding test PASSED!"
  pure ()

-- ===========================================================================
-- RUN ALL TESTS
-- ===========================================================================

-- NOTE: This is a convenience runner for local/manual use.
-- We intentionally make it a *function* (not a top-level `Script ()` value),
-- so `daml test` doesn't execute it. Running multiple flow tests in one
-- script shares a single ledger, which can cause collisions (e.g. fixed party
-- ids used by real-signature vectors).
runFlowTests : () -> Script ()
runFlowTests () = script do
  debug "Running MCMS flow tests..."
  testFullFlow
  testFullFlowWithRealSignatures
  testReplayProtection
  testNonceOrdering
  testRootExpiry
  -- Signatory check tests (security)
  testSignatoryCheckRejectsWrongOwner
  testSignatoryCheckAcceptsCorrectOwner
  testSignatoryCheckRejectsForgedPartyId
  testNonStakeholderCanExecuteWithDisclosures
  -- Codec tests
  testCodecRoundtrip
  testExecuteMcmsOp
  testMcmsOpInvalidData
  testMcmsOpClearRoot
  debug "All flow tests passed!"
