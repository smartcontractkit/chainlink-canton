realTestSigners =
  [ SignerInfo "7f6b694dd9bf3627f97b1b80f903d69cf1b566d1" 0 0
  , SignerInfo "e216a62eeb9a5a8814cf38fb655d75d18b26dd58" 1 0
  , SignerInfo "fe4b9d5e4f885d083167e8f28704851bb63bc11d" 2 0
  ]

