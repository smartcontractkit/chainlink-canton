-- ===========================================================================
-- TIMELOCK SELF-DISPATCH TESTS
-- ===========================================================================

testSelfDispatchViaTimelock : Script ()
testSelfDispatchViaTimelock = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = mkInstanceId timelockTestBaseMcmsId ccipOwner
      chainId = 1
      proposer = emptyRoleState with config = timelockTestConfig
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- SetRoot for proposer (schedule_batch authorization)
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Proposer
      submitter = ccipOwner
      newRoot = timelockScheduleRoot
      validUntil = timelockTestValidUntil
      metadata = timelockScheduleMetadata
      metadataProof = timelockScheduleMetadataProof
      signatures = timelockScheduleSignatures

  -- ScheduleBatch: self-dispatch update_min_delay to 120s
  let calls = [TimelockCall timelockTestInstanceId "update_min_delay" "120"]
  let salt = "test-salt-1"
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid ScheduleBatch with
      submitter = ccipOwner
      calls
      predecessor = zeroHash
      salt
      delay = seconds 0
      op = timelockScheduleOp
      opProof = timelockScheduleOpProof

  -- setTime to make the operation ready
  let opId = hashTimelockOpId calls zeroHash salt
  setTime (addRelTime timelockTestValidUntil (seconds (-3600)))

  -- ExecuteScheduledBatch with no external targets
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid ExecuteScheduledBatch with
      submitter = ccipOwner
      opId
      calls
      predecessor = zeroHash
      salt
      targetCids = []

  -- Verify minDelay changed
  delay <- submit ccipOwner do
    exerciseCmd mcmsCid GetMinDelay with submitter = ccipOwner
  assertMsg "minDelay should be 120s" $ delay == seconds 120

  debug "testSelfDispatchViaTimelock PASSED!"
  pure ()

testBypasserSelfDispatch : Script ()
testBypasserSelfDispatch = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = mkInstanceId timelockTestBaseMcmsId ccipOwner
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState with config = timelockTestConfig
      minDelay = seconds 0  -- Start at 0 for testing, bypasser will update it
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- SetRoot for bypasser
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Bypasser
      submitter = ccipOwner
      newRoot = timelockBypasserRoot
      validUntil = timelockTestValidUntil
      metadata = timelockBypasserMetadata
      metadataProof = timelockBypasserMetadataProof
      signatures = timelockBypasserSignatures

  -- BypasserExecuteBatch: self-dispatch update_min_delay to 300s (immediate)
  let calls = [TimelockCall timelockTestInstanceId "update_min_delay" "300"]
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid BypasserExecuteBatch with
      submitter = ccipOwner
      calls
      targetCids = []
      op = timelockBypasserOp
      opProof = timelockBypasserOpProof

  delay <- submit ccipOwner do
    exerciseCmd mcmsCid GetMinDelay with submitter = ccipOwner
  assertMsg "minDelay should be 300s" $ delay == seconds 300

  debug "testBypasserSelfDispatch PASSED!"
  pure ()

testSelfDispatchBlockFunction : Script ()
testSelfDispatchBlockFunction = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = mkInstanceId timelockTestBaseMcmsId ccipOwner
      chainId = 1
      proposer = emptyRoleState with config = timelockTestConfig
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- SetRoot for proposer (schedule_batch authorization)
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Proposer
      submitter = ccipOwner
      newRoot = timelockScheduleRoot
      validUntil = timelockTestValidUntil
      metadata = timelockScheduleMetadata
      metadataProof = timelockScheduleMetadataProof
      signatures = timelockScheduleSignatures

  -- ScheduleBatch: self-dispatch block_function
  let bf = BlockedFunction "counter@owner" "dangerous_fn"
  let calls = [TimelockCall timelockTestInstanceId "block_function" (encodeBlockedFunction bf)]
  let salt = "test-salt-2"
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid ScheduleBatch with
      submitter = ccipOwner
      calls
      predecessor = zeroHash
      salt
      delay = seconds 0
      op = timelockScheduleOp
      opProof = timelockScheduleOpProof

  -- ExecuteScheduledBatch with no external targets
  let opId = hashTimelockOpId calls zeroHash salt
  setTime (addRelTime timelockTestValidUntil (seconds (-3600)))
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid ExecuteScheduledBatch with
      submitter = ccipOwner
      opId
      calls
      predecessor = zeroHash
      salt
      targetCids = []

  blocked <- submit ccipOwner do
    exerciseCmd mcmsCid GetBlockedFunctions with submitter = ccipOwner
  assertMsg "Should have 1 blocked function" $ length blocked == 1
  assertMsg "Blocked function mismatch" $ (blocked !! 0) == bf

  debug "testSelfDispatchBlockFunction PASSED!"
  pure ()

-- ===========================================================================
-- RUN ALL TESTS
-- ===========================================================================

-- NOTE: This is a convenience runner for local/manual use.
-- We intentionally make it a *function* (not a top-level `Script ()` value),
-- so `daml test` doesn't execute it. Running multiple flow tests in one
-- script shares a single ledger, which can cause collisions (e.g. fixed party
-- ids used by real-signature vectors).
runFlowTests : () -> Script ()
runFlowTests () = script do
  debug "Running MCMS flow tests..."
  testFullFlow
  testFullFlowWithRealSignatures
  testReplayProtection
  testNonceOrdering
  testRootExpiry
  -- Signatory check tests (security)
  testSignatoryCheckRejectsWrongOwner
  testSignatoryCheckAcceptsCorrectOwner
  testSignatoryCheckRejectsForgedPartyId
  testNonStakeholderCanExecuteWithDisclosures
  -- Codec tests
  testCodecRoundtrip
  testExecuteMcmsOp
  testMcmsOpInvalidData
  testMcmsOpClearRoot
  -- Timelock tests
  testTimelockSchedule
  testTimelockViewFunctions
  -- Self-dispatch & blocked function tests
  testBlockedFunctionCodec
  testSelfDispatchSetConfigCodec
  testBlockedFunctionOnMCMS
  debug "All flow tests passed!"
