selfDispatchTestSigners : [SignerInfo]
selfDispatchTestSigners =
  [ SignerInfo "629f74657968bf4ea61fbddfbd261b92b0131a33" 0 0
  , SignerInfo "6d04eabf05ea3cee980fa6983e8878ba7e60a7a3" 1 0
  , SignerInfo "d4da36bf6d1e1971ff224db91724cdc6117d117d" 2 0
  ]

selfDispatchTestConfig : MultisigConfig
selfDispatchTestConfig = MultisigConfig
  { signers = selfDispatchTestSigners
  , groupQuorums = [2] <> replicate 31 0
  , groupParents = replicate 32 0
  }

selfDispatchTestValidUntil : Time
selfDispatchTestValidUntil = datetime 2030 Jan 1 0 0 0

selfDispatchTestBaseMcmsId : Text
selfDispatchTestBaseMcmsId = "mcms-daml-test"

-- Helper to create instanceAddress from instanceId and owner
mkInstanceAddress : Text -> Party -> Text
mkInstanceAddress instId party = instId <> "@" <> partyToText party

