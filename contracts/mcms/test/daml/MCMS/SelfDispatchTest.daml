-- ===========================================================================
-- SELF-DISPATCH VIA TIMELOCK TESTS
-- These test the full flow: SetRoot -> ExecuteOp -> ExecuteScheduledBatch
-- ===========================================================================

-- | Test schedule_batch self-dispatch (update_min_delay via timelock)
-- Flow: Proposer signs schedule_batch -> ExecuteOp -> delay -> ExecuteScheduledBatch
testScheduleBatch : Script ()
testScheduleBatch = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = selfDispatchTestBaseMcmsId
      chainId = 1
      proposer = emptyRoleState with config = selfDispatchTestConfig
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- SetRoot for proposer (schedule_batch authorization)
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Proposer
      submitter = ccipOwner
      newRoot = timelockScheduleRoot
      validUntil = selfDispatchTestValidUntil
      metadata = timelockScheduleMetadata
      metadataProof = timelockScheduleMetadataProof
      signatures = timelockScheduleSignatures

  -- ExecuteOp with ScheduleBatch
  let calls = [TimelockCall timelockTestInstanceAddress "UpdateMinDelay" "0000000000000078"]
  let salt = "7363686564756c652d73616c742d31"
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid ExecuteOp with
      targetRole = Proposer
      submitter = ccipOwner
      op = timelockScheduleOp
      opProof = timelockScheduleOpProof
      targetCids = Map.empty

  -- Verify operation was scheduled
  let opId = hashTimelockOpId calls zeroHash salt
  isOp <- submit ccipOwner do
    exerciseCmd mcmsCid IsOperation with
      submitter = ccipOwner
      opId

  assertMsg "Operation should be scheduled" isOp

  -- Set time to after the delay
  setTime (addRelTime selfDispatchTestValidUntil (seconds (-3600)))

  -- ExecuteScheduledBatch
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid ExecuteScheduledBatch with
      submitter = ccipOwner
      opId
      calls
      predecessor = zeroHash
      salt
      targetCids = Map.empty

  -- Verify minDelay was updated
  delay <- submit ccipOwner do
    exerciseCmd mcmsCid GetMinDelay with submitter = ccipOwner
  assertMsg "minDelay should be 120s" $ delay == seconds 120

  -- Verify operation is marked as done
  isDone <- submit ccipOwner do
    exerciseCmd mcmsCid IsOperationDone with
      submitter = ccipOwner
      opId

  assertMsg "Operation should be done" isDone

  debug "testScheduleBatch PASSED!"
  pure ()

testExecuteScheduledBatchRejectsMissingOpId : Script ()
testExecuteScheduledBatchRejectsMissingOpId = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-missing-op")
  let instanceAddress = "mcms-missing-op@" <> partyToText ccipOwner

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = "mcms-missing-op"
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  submitMustFail ccipOwner do
    exerciseCmd mcmsCid ExecuteScheduledBatch with
      submitter = ccipOwner
      opId = "missing-op-id"
      calls = [TimelockCall with
        targetInstanceAddress = instanceAddress
        functionName = "UpdateMinDelay"
        operationData = "0000000000000001"]
      predecessor = zeroHash
      salt = "73616c74"
      targetCids = Map.empty

  timestamp <- submit ccipOwner do
    exerciseCmd mcmsCid GetTimestamp with
      submitter = ccipOwner
      opId = "missing-op-id"

  assertMsg "Missing operation should remain absent after failed execution" $ isNone timestamp

-- | Test bypasser_execute_batch self-dispatch (immediate update_min_delay)
-- Flow: Bypasser signs bypasser_execute_batch -> ExecuteOp (immediate execution)
testBypasserExecuteBatch : Script ()
testBypasserExecuteBatch = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = selfDispatchTestBaseMcmsId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState with config = selfDispatchTestConfig
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- SetRoot for bypasser
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetRoot with
      targetRole = Bypasser
      submitter = ccipOwner
      newRoot = timelockBypasserRoot
      validUntil = selfDispatchTestValidUntil
      metadata = timelockBypasserMetadata
      metadataProof = timelockBypasserMetadataProof
      signatures = timelockBypasserSignatures

  -- ExecuteOp with bypasser_execute_batch (immediate execution)
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid ExecuteOp with
      targetRole = Bypasser
      submitter = ccipOwner
      op = timelockBypasserOp
      opProof = timelockBypasserOpProof
      targetCids = Map.empty

  -- Verify minDelay was immediately updated to 300s
  delay <- submit ccipOwner do
    exerciseCmd mcmsCid GetMinDelay with submitter = ccipOwner
  assertMsg "minDelay should be 300s" $ delay == seconds 300

  debug "testBypasserExecuteBatch PASSED!"
  pure ()

