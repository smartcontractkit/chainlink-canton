-- | Test update_min_delay self-dispatch function
testUpdateMinDelay : Script ()
testUpdateMinDelay = script do
  ccipOwner <- allocatePartyByHint (PartyIdHint "ccip_owner-9cefe94d")

  -- This is tested via testBypasserExecuteBatch with real signatures
  -- Here we verify the initial state

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = mkInstanceId selfDispatchTestBaseMcmsId ccipOwner
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 60
      blockedFunctions = []
      timelockTimestamps = Map.empty

  delay <- submit ccipOwner do
    exerciseCmd mcmsCid GetMinDelay with submitter = ccipOwner

  assertMsg "Initial minDelay should be 60s" $ delay == seconds 60

  debug "testUpdateMinDelay (initial state) PASSED!"
  pure ()

-- | Test block_function and unblock_function
testBlockUnblockFunction : Script ()
testBlockUnblockFunction = script do
  ccipOwner <- allocateParty "ccip_owner"

  let bf = BlockedFunction "counter@ccip_owner" "reset"

  -- Create MCMS with one blocked function
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = mkInstanceId "test-block" ccipOwner
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = [bf]
      timelockTimestamps = Map.empty

  -- Query blocked functions
  blocked <- submit ccipOwner do
    exerciseCmd mcmsCid GetBlockedFunctions with submitter = ccipOwner

  assertMsg "Should have 1 blocked function" $ length blocked == 1
  assertMsg "Blocked function should match" $ head blocked == bf

  cnt <- submit ccipOwner do
    exerciseCmd mcmsCid GetBlockedFunctionsCount with submitter = ccipOwner

  assertMsg "Count should be 1" $ cnt == 1

  debug "testBlockUnblockFunction PASSED!"
  pure ()

-- | Test SetConfig choice directly (not via timelock)
testSetConfigDirect : Script ()
testSetConfigDirect = script do
  ccipOwner <- allocateParty "ccip_owner"

  -- Create MCMS with empty config
  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = mkInstanceId "test-setconfig" ccipOwner
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.empty

  -- SetConfig on proposer role
  mcmsCid <- submit ccipOwner do
    exerciseCmd mcmsCid SetConfig with
      targetRole = Proposer
      newSigners = selfDispatchTestSigners
      newGroupQuorums = [2] <> replicate 31 0
      newGroupParents = replicate 32 0
      clearRoot = False

  -- Verify config was set (query state)
  state <- submit ccipOwner do
    exerciseCmd mcmsCid GetState with
      submitter = ccipOwner
      targetRole = Proposer

  assertMsg "Should have 3 signers" $ state.numSigners == 3

  debug "testSetConfigDirect PASSED!"
  pure ()

-- ===========================================================================
-- CANCEL BATCH TESTS
-- ===========================================================================

-- | Test cancel_batch via Canceller role
-- Note: This requires specific test vectors for cancel_batch operation
testCancelBatch : Script ()
testCancelBatch = script do
  ccipOwner <- allocateParty "ccip_owner"

  let mcmsInstanceId = mkInstanceId "test-cancel" ccipOwner

  -- Create MCMS with a pre-scheduled operation
  let testOpId = "test-op-id-to-cancel"
  let futureTime = datetime 2030 Jan 2 0 0 0

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = mcmsInstanceId
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState with config = selfDispatchTestConfig
      bypasser = emptyRoleState
      minDelay = seconds 0
      blockedFunctions = []
      timelockTimestamps = Map.fromList [(testOpId, futureTime)]

  -- Verify operation exists and is pending
  isOp <- submit ccipOwner do
    exerciseCmd mcmsCid IsOperation with
      submitter = ccipOwner
      opId = testOpId

  assertMsg "Operation should exist" isOp

  isPending <- submit ccipOwner do
    exerciseCmd mcmsCid IsOperationPending with
      submitter = ccipOwner
      opId = testOpId

  assertMsg "Operation should be pending" isPending

  debug "testCancelBatch: Operation is scheduled"
  debug "Full cancel flow requires Canceller signature vectors"
  debug "testCancelBatch (partial) PASSED!"
  pure ()

-- ===========================================================================
-- TIMELOCK VIEW FUNCTION TESTS
-- ===========================================================================

-- | Test all timelock view functions
testTimelockViewFunctions : Script ()
testTimelockViewFunctions = script do
  ccipOwner <- allocateParty "ccip_owner"

  let testOpId = "test-op-123"
  let doneOpId = "done-op-456"
  let readyTime = datetime 2020 Jan 1 0 0 0  -- In the past

  mcmsCid <- submit ccipOwner do
    createCmd MCMS with
      owner = ccipOwner
      instanceId = mkInstanceId "test-views" ccipOwner
      chainId = 1
      proposer = emptyRoleState
      canceller = emptyRoleState
      bypasser = emptyRoleState
      minDelay = seconds 120
      blockedFunctions = []
      timelockTimestamps = Map.fromList
        [ (testOpId, readyTime)
        , (doneOpId, doneTimestamp)
        ]

  -- Test GetMinDelay
  minDelayVal <- submit ccipOwner do
    exerciseCmd mcmsCid GetMinDelay with submitter = ccipOwner

  assertMsg "MinDelay should be 120s" $ minDelayVal == seconds 120

  -- Test GetTimestamp for existing operation
  ts <- submit ccipOwner do
    exerciseCmd mcmsCid GetTimestamp with
      submitter = ccipOwner
      opId = testOpId

  assertMsg "Timestamp should exist" $ ts == Some readyTime

  -- Test GetTimestamp for non-existent operation
  tsNone <- submit ccipOwner do
    exerciseCmd mcmsCid GetTimestamp with
      submitter = ccipOwner
      opId = "nonexistent"

  assertMsg "Timestamp should be None" $ tsNone == None

  -- Test IsOperation
  isOp <- submit ccipOwner do
    exerciseCmd mcmsCid IsOperation with
      submitter = ccipOwner
      opId = testOpId

  assertMsg "Operation should exist" isOp

  isOpNone <- submit ccipOwner do
    exerciseCmd mcmsCid IsOperation with
      submitter = ccipOwner
      opId = "nonexistent"

  assertMsg "Nonexistent operation should not exist" $ not isOpNone

  -- Test IsOperationPending
  isPending <- submit ccipOwner do
    exerciseCmd mcmsCid IsOperationPending with
      submitter = ccipOwner
      opId = testOpId

  assertMsg "Operation should be pending" isPending

  isPendingDone <- submit ccipOwner do
    exerciseCmd mcmsCid IsOperationPending with
      submitter = ccipOwner
      opId = doneOpId

  assertMsg "Done operation should not be pending" $ not isPendingDone

  -- Test IsOperationReady
  setTime (datetime 2025 Jan 1 0 0 0)  -- After readyTime
  isReady <- submit ccipOwner do
    exerciseCmd mcmsCid IsOperationReady with
      submitter = ccipOwner
      opId = testOpId

  assertMsg "Operation should be ready (time passed)" isReady

  -- Test IsOperationDone
  isDone <- submit ccipOwner do
    exerciseCmd mcmsCid IsOperationDone with
      submitter = ccipOwner
      opId = doneOpId

  assertMsg "Done operation should show as done" isDone

  isDoneNot <- submit ccipOwner do
    exerciseCmd mcmsCid IsOperationDone with
      submitter = ccipOwner
      opId = testOpId

  assertMsg "Pending operation should not show as done" $ not isDoneNot

  debug "testTimelockViewFunctions PASSED!"
  pure ()
