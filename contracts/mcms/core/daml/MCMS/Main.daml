-- Uses native keccak256 and secp256k1 for on-chain verification
--
-- ARCHITECTURE:
--   MCMS verifies signatures and merkle proofs, then calls target contracts directly.
--   Target contracts implement MCMSReceiver interface with stable instanceAddress.
--
-- Direct Invocation Pattern:
--   1. Anyone submits: proofs + signatures + targetCids (ALL contract CIDs including MCMS)
--   2. MCMS validates proofs and signatures on-chain
--   3. MCMS verifies target's instanceAddress matches call.targetInstanceAddress
--   4. MCMS parses partyId from instanceAddress (format: instanceId@partyId) and verifies signatory
--   5. MCMS calls target.mcmsEntrypoint(functionName, operationData, contractIds)
--   6. ccip_owner authority flows through the call chain
module MCMS.Main where

import DA.Map qualified as Map
import DA.List ((!!), dedup)
import DA.Action (unless)
import DA.Foldable (forA_)
import DA.Text qualified as Text
import DA.Time (RelTime, seconds, addRelTime, time)
import DA.Date (date, Month(..))
import DA.Crypto.Text (BytesHex)
import MCMS.Types
  ( Role(..)
  , roleToText
  , SignerInfo(..)
  , MultisigConfig(..)
  , Op(..)
  , RootMetadata(..)
  , ExpiringRoot(..)
  , RoleState(..)
  , numGroups
  , maxNumSigners
  , zeroHash
  , doneTimestamp
  , TimelockCall(..)
  , BlockedFunction(..)
  , intToRole
  )
import MCMS.GroupVoting
import MCMS.Crypto
import MCMS.MCMSReceiver (MCMSReceiver, MCMSReceiver_Entrypoint(..))
import Chainlink.InstanceAddress (assertValidInstanceId)
import Chainlink.InstanceAddress qualified as RawInstanceAddress
import MCMS.Codec
  ( decodeBlockedFunctionWithOffset
  , decodeSelfDispatchSetConfigWithOffset
  , decodeScheduleBatchParamsWithOffset
  , decodeBypasserExecuteBatchParamsWithOffset
  , decodeCancelBatchParamsWithOffset
  , decodeInt64At
  , extractBytes
  , decodeUint8
  )
import DA.Crypto.Text (byteCount)

-- | Validate MultisigConfig structure
-- Shared validation for SetConfig choice and executeSelfDispatch handler
validateMultisigConfig : MultisigConfig -> Update ()
validateMultisigConfig config = do
  assertMsg "mcms: signer count exceeds maximum allowed" $
    length config.signers <= maxNumSigners
  assertMsg "mcms: must have at least one signer" $
    not (null config.signers)
  assertMsg "mcms: group quorums array must have 32 entries" $
    length config.groupQuorums == numGroups
  assertMsg "mcms: group parents array must have 32 entries" $
    length config.groupParents == numGroups
  -- Validate groupQuorums are non-negative
  forA_ (zip [0..(numGroups - 1)] config.groupQuorums) $ \(idx, quorum) ->
    assertMsg ("mcms: groupQuorum[" <> show idx <> "] must be non-negative, got " <> show quorum) $
      quorum >= 0
  assertMsg "mcms: root group must be its own parent" $
    (config.groupParents !! 0) == 0
  -- Validate signerGroup bounds [0, 31] for all signers
  forA_ config.signers $ \signer ->
    assertMsg ("mcms: signerGroup out of bounds [0,31]: " <> show signer.signerGroup) $
      signer.signerGroup >= 0 && signer.signerGroup < numGroups
  -- Disabled group children check (signers cannot be in disabled groups)
  forA_ config.signers $ \signer -> do
    let groupQuorum = config.groupQuorums !! signer.signerGroup
    assertMsg ("mcms: signer in disabled group " <> show signer.signerGroup) $
      groupQuorum > 0
  -- Validate groupParents bounds and DAG structure (parent index < self index for non-root)
  forA_ (zip [0..(numGroups - 1)] config.groupParents) $ \(idx, parentIdx) ->
    if idx == 0
      then assertMsg "mcms: root group must be its own parent" $ parentIdx == 0
      else assertMsg ("mcms: group " <> show idx <> " parent must be < " <> show idx <> " (DAG constraint), got " <> show parentIdx) $
        parentIdx >= 0 && parentIdx < idx
  -- Quorum reachability validation
  -- Count children per group (signers + enabled child groups)
  let signerCounts = countSignersPerGroup config.signers
  let childCounts = computeChildCounts signerCounts config.groupQuorums config.groupParents
  forA_ (zip3 [0..(numGroups - 1)] config.groupQuorums childCounts) $ \(idx, quorum, children) ->
    if quorum > 0
      then assertMsg ("mcms: group " <> show idx <> " quorum " <> show quorum <> " exceeds children count " <> show children) $
             children >= quorum
      else assertMsg ("mcms: disabled group " <> show idx <> " has children") $
             children == 0
  -- Validate signer addresses are unique
  let signerAddrs = map (\s -> s.signerAddress) config.signers
  assertMsg "mcms: duplicate signer addresses" $
    length (dedup signerAddrs) == length signerAddrs
  -- Validate signer addresses are valid hex, correct length, and lowercase
  forA_ config.signers $ \signer -> do
    assertValidHex "signerAddress" signer.signerAddress
    assertMsg ("mcms: signerAddress must be 20 bytes, got " <> show (byteCount signer.signerAddress)) $
      byteCount signer.signerAddress == 20
    assertMsg "mcms: signerAddress must be lowercase" $
      signer.signerAddress == Text.asciiToLower signer.signerAddress

template MCMS
  with
    owner : Party                              -- ccip_owner party
    instanceId : Text                          -- Stable identifier (without @partyId suffix)
    chainId : Int                              -- Chain ID for validation
    proposer : RoleState
    canceller : RoleState
    bypasser : RoleState
    -- Timelock configuration
    minDelay : RelTime                         -- Minimum delay for scheduled operations
    blockedFunctions : [BlockedFunction]       -- Functions that cannot be scheduled (per-target)
    timelockTimestamps : Map.Map Text Time     -- opId -> readyTime (or doneTimestamp if done)
  where
    signatory owner
    ensure assertValidInstanceId instanceId

    -- | Set signer configuration
    -- Validates the configuration and optionally clears the root
    choice SetConfig : ContractId MCMS
      with
        targetRole : Role
        newSigners : [SignerInfo]
        newGroupQuorums : [Int]
        newGroupParents : [Int]
        clearRoot : Bool
      controller owner
      do
        let newConfig = MultisigConfig newSigners newGroupQuorums newGroupParents
        validateMultisigConfig newConfig

        let rs = getRoleState targetRole this
        let (newExpiringRoot, newRootMetadata) = if clearRoot
              then
                let opCount = rs.expiringRoot.opCount
                    instanceAddress = RawInstanceAddress.makeText instanceId owner
                    epoch = time (date 1970 Jan 1) 0 0 0
                in ( ExpiringRoot "" epoch opCount
                   , RootMetadata chainId (makeMcmsId instanceAddress targetRole)
                       opCount opCount True
                   )
              else (rs.expiringRoot, rs.rootMetadata)
        let newRs = rs with
              config = newConfig
              expiringRoot = newExpiringRoot
              rootMetadata = newRootMetadata

        create (setRoleState targetRole newRs this)

    -- | Set new merkle root with on-chain signature verification
    -- All verification happens on-chain using native keccak256 and secp256k1
    -- ANYONE can submit - security comes from signature verification
    choice SetRoot : ContractId MCMS
      with
        targetRole : Role
        submitter : Party                      -- Anyone can submit
        newRoot : BytesHex                     -- New merkle root hash
        validUntil : Time                      -- Expiration time
        metadata : RootMetadata                -- Root metadata
        metadataProof : [BytesHex]             -- Merkle proof for metadata leaf
        signatures : [RawSignature]            -- Raw ECDSA signatures
      controller submitter
      do
        -- 0. Validate BytesHex inputs
        assertValidHex "newRoot" newRoot
        forA_ metadataProof $ \p -> assertValidHex "metadataProof" p
        forA_ signatures $ \sig -> do
          assertValidHex "signature.publicKey" sig.publicKey
          assertValidHex "signature.r" sig.r
          assertValidHex "signature.s" sig.s

        now <- getTime
        let rs = getRoleState targetRole this

        -- 1. Compute signed hash ON-CHAIN using keccak256
        let signedHash = computeSignedHashNative newRoot validUntil

        -- 2. Check not seen before (replay prevention)
        assertMsg ("mcms: signed hash already used: " <> signedHash) $
          not $ Map.member signedHash rs.seenHashes

        -- 3. Validate timestamps
        assertMsg "mcms: root has expired" $ now <= validUntil

        -- 4. Validate metadata matches this role
        assertMsg ("mcms: chain ID mismatch, expected " <> show chainId) $
          metadata.chainId == chainId
        let instanceAddress = RawInstanceAddress.makeText instanceId owner
        let expectedMultisigId = makeMcmsId instanceAddress targetRole
        assertMsg ("mcms: multisig ID mismatch, expected " <> expectedMultisigId) $
          metadata.multisigId == expectedMultisigId
        assertMsg ("mcms: pre-operation count mismatch, expected " <> show rs.expiringRoot.opCount) $
          metadata.preOpCount == rs.expiringRoot.opCount

        -- 5. Validate op counts
        assertMsg "mcms: preOpCount cannot exceed postOpCount" $
          metadata.preOpCount <= metadata.postOpCount

        -- 6. Check pending operations
        unless metadata.overridePreviousRoot $
          assertMsg "mcms: cannot override root with pending operations" $
            rs.expiringRoot.opCount == rs.rootMetadata.postOpCount

        -- 7. Verify ALL signatures ON-CHAIN using secp256k1
        let validSignerAddrs = verifySignatures signedHash signatures
        assertMsg "mcms: no valid signatures provided" $
          not $ null validSignerAddrs

        -- 8. Verify metadata Merkle proof ON-CHAIN using keccak256
        let metadataLeaf = hashMetadataLeafNative metadata
        assertMsg "mcms: metadata merkle proof verification failed" $
          verifyMerkleProof newRoot metadataLeaf metadataProof

        -- 9. Verify group voting with validated signer addresses
        let sortedSignerAddrs = sortAddresses validSignerAddrs
        case verifyGroupVoting sortedSignerAddrs rs.config of
          Left err -> abort err
          Right () -> pure ()

        -- 10. Update per-role state
        let newRs = rs with
              seenHashes = Map.insert signedHash validUntil rs.seenHashes
              expiringRoot = ExpiringRoot newRoot validUntil rs.expiringRoot.opCount
              rootMetadata = metadata
        let staged = setRoleState targetRole newRs this
        -- Clear pending timelock ops when overriding root so stale ops
        -- from the previous quorum cannot execute under the new root.
        let finalMcms = if metadata.overridePreviousRoot
              then staged with timelockTimestamps = Map.filter (== doneTimestamp) staged.timelockTimestamps
              else staged
        create finalMcms

    -- =========================================================================
    -- EXECUTE OPERATION (Main Entry Point - Dispatcher)
    -- Like Aptos execute() - single entry point that dispatches to timelock functions
    -- =========================================================================

    -- | Execute an operation (like Aptos's execute() - single entry point)
    -- This is the main execution flow that dispatches to timelock functions:
    --   1. Validate merkle proof against the root set by SetRoot
    --   2. Decode parameters from op.operationData (like Aptos BCS deserialization)
    --   3. Dispatch based on op.functionName:
    --      - "ScheduleBatch" → schedule with delay (Proposer role)
    --      - "BypasserExecuteBatch" → immediate execution (Bypasser role)
    --      - "CancelBatch" → cancel pending operation (Canceller role)
    --
    -- Note: SetConfig/ClearRoot are NOT handled here - they go through the timelock
    -- flow via ScheduleBatch → delay → ExecuteScheduledBatch → executeSelfDispatch.
    --
    -- ANYONE CAN EXECUTE (with disclosures) - Security comes from:
    --   1. Merkle proof verification (operation was approved by signers)
    --   2. Parameters decoded from op.operationData (cryptographically bound)
    --   3. Role validation (each function requires specific role)
    --
    -- Note: targetCids must be passed separately since ContractIds cannot be serialized.
    --       The calls themselves are validated from op.operationData.
    choice ExecuteOp : ContractId MCMS
      with
        targetRole : Role
        submitter : Party                                         -- Anyone can submit
        op : Op                                                   -- Operation details (params in operationData)
        opProof : [BytesHex]                                      -- Merkle proof
        targetCids : Map.Map Text (ContractId MCMSReceiver)       -- Map from instanceAddress to contract ID
      controller submitter
      do
        -- 0. Validate BytesHex inputs
        forA_ opProof $ \p -> assertValidHex "opProof" p
        assertValidHex "op.operationData" op.operationData

        now <- getTime
        let rs = getRoleState targetRole this

        -- 1. Validate operation targets this MCMS
        let instanceAddress = RawInstanceAddress.makeText instanceId owner
        assertMsg ("mcms: chain ID mismatch, expected " <> show chainId) $
          op.chainId == chainId
        assertMsg ("mcms: multisig ID mismatch, expected " <> makeMcmsId instanceAddress targetRole) $
          op.multisigId == makeMcmsId instanceAddress targetRole

        -- 2. Check nonce matches current opCount
        assertMsg ("mcms: nonce mismatch, expected " <> show rs.expiringRoot.opCount <> " but got " <> show op.nonce) $
          op.nonce == rs.expiringRoot.opCount

        -- 3. Check root not expired
        assertMsg "mcms: root has expired" $ now <= rs.expiringRoot.validUntil

        -- 4. Check we haven't executed all ops for this root
        assertMsg "mcms: all operations for this root have been executed" $ rs.expiringRoot.opCount < rs.rootMetadata.postOpCount

        -- 5. Verify merkle proof ON-CHAIN using keccak256
        let opLeaf = hashOpLeafNative op
        assertMsg "mcms: operation merkle proof verification failed" $
          verifyMerkleProof rs.expiringRoot.root opLeaf opProof

        -- 6. Dispatch based on functionName (like Aptos dispatch_to_timelock)
        --    Parameters are decoded from op.operationData (like Aptos BCS deserialization)
        case op.functionName of
          "ScheduleBatch" -> do
            assertMsg "mcms: ScheduleBatch requires Proposer role" $ targetRole == Proposer
            assertMsg "mcms: self-dispatch must target own instance address" $
              op.targetInstanceAddress == instanceAddress
            case decodeScheduleBatchParamsWithOffset op.operationData of
              None -> abort "mcms: failed to decode ScheduleBatch parameters"
              Some (params, finalOffset) -> do
                assertMsg "mcms: trailing bytes in ScheduleBatch operationData" $
                  finalOffset == byteCount op.operationData
                scheduleBatchInternal now this rs params.calls params.predecessor params.salt (seconds params.delaySecs)

          "BypasserExecuteBatch" -> do
            assertMsg "mcms: BypasserExecuteBatch requires Bypasser role" $ targetRole == Bypasser
            assertMsg "mcms: self-dispatch must target own instance address" $
              op.targetInstanceAddress == instanceAddress
            case decodeBypasserExecuteBatchParamsWithOffset op.operationData of
              None -> abort "mcms: failed to decode BypasserExecuteBatch parameters"
              Some (params, finalOffset) -> do
                assertMsg "mcms: trailing bytes in BypasserExecuteBatch operationData" $
                  finalOffset == byteCount op.operationData
                -- Validate targetCids size to prevent DoS via inflated maps
                validateTargetCidsSize instanceAddress params.calls targetCids
                bypasserExecuteBatchInternal owner this rs params.calls targetCids

          "CancelBatch" -> do
            assertMsg "mcms: CancelBatch requires Canceller role" $ targetRole == Canceller
            assertMsg "mcms: self-dispatch must target own instance address" $
              op.targetInstanceAddress == instanceAddress
            case decodeCancelBatchParamsWithOffset op.operationData of
              None -> abort "mcms: failed to decode CancelBatch parameters"
              Some (params, finalOffset) -> do
                assertMsg "mcms: trailing bytes in CancelBatch operationData" $
                  finalOffset == byteCount op.operationData
                cancelBatchInternal this rs params.opId

          -- SetConfig and ClearRoot are NOT handled here - they must go through the proper
          -- timelock flow via ScheduleBatch → delay → ExecuteScheduledBatch → executeSelfDispatch.

          _ -> abort $ "mcms: unknown function: " <> op.functionName

    -- =========================================================================
    -- TIMELOCK EXECUTION (Post-delay execution)
    -- =========================================================================

    -- | Execute a scheduled batch after delay has passed
    -- This is a public entry point - anyone can execute once ready
    -- (matches Aptos timelock_execute_batch which is also public)
    choice ExecuteScheduledBatch : ContractId MCMS
      with
        submitter : Party                                         -- Anyone can execute
        opId : Text                                               -- Operation ID to execute
        calls : [TimelockCall]                                    -- Caller provides (for execution)
        predecessor : BytesHex                                    -- For validation (hex hash)
        salt : BytesHex                                           -- For opId verification (hex value)
        targetCids : Map.Map Text (ContractId MCMSReceiver)       -- Map from instanceAddress to contract ID
      controller submitter
      do
        -- 0. Validate BytesHex inputs
        assertValidHex "predecessor" predecessor
        assertValidHex "salt" salt
        forA_ calls $ \call -> assertValidHex "call.operationData" call.operationData

        now <- getTime

        -- 1. Lookup in timelockTimestamps before hashing caller-controlled call data.
        case Map.lookup opId timelockTimestamps of
          None -> abort "mcms: operation not found in timelock"
          Some readyTime -> do
            -- 2. Verify opId matches provided data
            let computedOpId = hashTimelockOpId calls predecessor salt
            assertMsg "mcms: computed operation ID does not match" $ computedOpId == opId

            -- 3. Check not already done
            assertMsg "mcms: operation already executed" $ readyTime /= doneTimestamp

            -- 4. Check ready time has passed
            assertMsg ("mcms: operation not ready, wait until " <> show readyTime) $
              now >= readyTime

            -- 5. Check predecessor done (if any)
            unless (predecessor == zeroHash) $ do
              case Map.lookup predecessor timelockTimestamps of
                None -> abort "mcms: predecessor operation not found"
                Some predTime ->
                  assertMsg "mcms: predecessor operation not complete" $ predTime == doneTimestamp

            -- 6. Validate targetCids size to prevent DoS via inflated maps
            let mcmsInstanceAddress = RawInstanceAddress.makeText instanceId owner
            validateTargetCidsSize mcmsInstanceAddress calls targetCids

            -- 7. Process all calls (self-dispatch inline, external via MCMSReceiver)
            (_, finalMcms) <- processCallsLoop owner targetCids this calls

            -- 8. Mark as done (set to doneTimestamp)
            create (finalMcms with
              timelockTimestamps = Map.insert opId doneTimestamp finalMcms.timelockTimestamps)

    -- =========================================================================
    -- View Functions
    -- =========================================================================

    -- | Check if an operation can be executed
    nonconsuming choice CanExecuteOp : Bool
      with
        submitter : Party                      -- Anyone can query
        targetRole : Role
        op : Op
      controller submitter
      do
        now <- getTime
        let rs = getRoleState targetRole this
        let instanceAddress = RawInstanceAddress.makeText instanceId owner
        pure $
          op.chainId == chainId &&
          op.multisigId == makeMcmsId instanceAddress targetRole &&
          op.nonce == rs.expiringRoot.opCount &&
          now <= rs.expiringRoot.validUntil &&
          rs.expiringRoot.opCount < rs.rootMetadata.postOpCount

    -- | Get current state
    nonconsuming choice GetState : MCMSState
      with
        submitter : Party                      -- Anyone can query
        targetRole : Role
      controller submitter
      do
        let rs = getRoleState targetRole this
        pure MCMSState with
          role = targetRole
          opCount = rs.expiringRoot.opCount
          postOpCount = rs.rootMetadata.postOpCount
          validUntil = rs.expiringRoot.validUntil
          hasActiveRoot = rs.expiringRoot.root /= ""
          numSigners = length rs.config.signers

    -- =========================================================================
    -- Timelock View Functions
    -- =========================================================================

    -- | Check if operation exists in timelockTimestamps
    nonconsuming choice IsOperation : Bool
      with
        submitter : Party
        opId : Text
      controller submitter
      do pure $ Map.member opId timelockTimestamps

    -- | Check if operation is pending (scheduled but not done)
    nonconsuming choice IsOperationPending : Bool
      with
        submitter : Party
        opId : Text
      controller submitter
      do
        case Map.lookup opId timelockTimestamps of
          None -> pure False
          Some t -> pure $ t /= doneTimestamp

    -- | Check if operation is ready (delay passed, not done)
    nonconsuming choice IsOperationReady : Bool
      with
        submitter : Party
        opId : Text
      controller submitter
      do
        now <- getTime
        case Map.lookup opId timelockTimestamps of
          None -> pure False
          Some t -> pure $ t /= doneTimestamp && now >= t

    -- | Check if operation is done
    nonconsuming choice IsOperationDone : Bool
      with
        submitter : Party
        opId : Text
      controller submitter
      do
        case Map.lookup opId timelockTimestamps of
          None -> pure False
          Some t -> pure $ t == doneTimestamp

    -- | Get operation timestamp (None if not found)
    nonconsuming choice GetTimestamp : Optional Time
      with
        submitter : Party
        opId : Text
      controller submitter
      do pure $ Map.lookup opId timelockTimestamps

    -- | Get minimum delay
    nonconsuming choice GetMinDelay : RelTime
      with
        submitter : Party
      controller submitter
      do pure minDelay

    nonconsuming choice GetBlockedFunctions : [BlockedFunction]
      with
        submitter : Party
      controller submitter
      do pure blockedFunctions

    nonconsuming choice GetBlockedFunctionsCount : Int
      with
        submitter : Party
      controller submitter
      do pure $ length blockedFunctions

    -- Remove seenHashes entries whose validUntil has passed.
    -- Safe to prune: expired roots are independently rejected by the validUntil check in SetRoot,
    -- so removing a hash entry after expiry cannot re-enable replay.
    choice PruneSeenHashes : ContractId MCMS
      with
        targetRole : Role
      controller owner
      do
        now <- getTime
        let rs = getRoleState targetRole this
            pruned = Map.filter (> now) rs.seenHashes
            newRs = rs with seenHashes = pruned
        create (setRoleState targetRole newRs this)

    -- Remove timelockTimestamps entries that equal doneTimestamp (already executed).
    -- Pending and ready entries are preserved so they can still be executed or cancelled.
    choice PruneTimelockTimestamps : ContractId MCMS
      controller owner
      do
        let pruned = Map.filter (/= doneTimestamp) timelockTimestamps
        create this with timelockTimestamps = pruned

-- ===========================================================================
-- VIEW TYPES
-- ===========================================================================

-- | View of MCMS state
data MCMSState = MCMSState
  with
    role : Role
    opCount : Int
    postOpCount : Int
    validUntil : Time
    hasActiveRoot : Bool
    numSigners : Int
  deriving (Show, Eq)

-- ===========================================================================
-- HELPER FUNCTIONS
-- ===========================================================================

-- | Create multisigId from instanceAddress and role
-- e.g., makeMcmsId "mcms@mcmsPartyId" Proposer = "mcms@mcmsPartyId-proposer"
makeMcmsId : Text -> Role -> Text
makeMcmsId instanceAddr r = instanceAddr <> "-" <> roleToText r

-- | Alias emphasizing role-suffixed multisig ids.
roleMultisigId : Text -> Role -> Text
roleMultisigId instanceAddr = makeMcmsId instanceAddr

getRoleState : Role -> MCMS -> RoleState
getRoleState Proposer m = m.proposer
getRoleState Canceller m = m.canceller
getRoleState Bypasser m = m.bypasser

setRoleState : Role -> RoleState -> MCMS -> MCMS
setRoleState Proposer rs m = m with proposer = rs
setRoleState Canceller rs m = m with canceller = rs
setRoleState Bypasser rs m = m with bypasser = rs

-- | Helper: Count signers per group
countSignersPerGroup : [SignerInfo] -> [Int]
countSignersPerGroup signers =
  let counts = replicate numGroups 0
  in foldl (\acc s -> MCMS.GroupVoting.incrementAt s.signerGroup acc) counts signers

-- | Helper: Compute total children counts (signers + enabled child groups)
-- Process groups from highest index to lowest (children before parents)
computeChildCounts : [Int] -> [Int] -> [Int] -> [Int]
computeChildCounts signerCounts groupQuorums groupParents =
  let initial = signerCounts
  in foldr (propagateChildCount groupQuorums groupParents) initial (reverse [1..(numGroups - 1)])

-- | Helper: Propagate enabled child group to parent's count
propagateChildCount : [Int] -> [Int] -> Int -> [Int] -> [Int]
propagateChildCount groupQuorums groupParents idx counts =
  let quorum = groupQuorums !! idx
      parentIdx = groupParents !! idx
  in if quorum > 0  -- enabled group propagates to parent
     then MCMS.GroupVoting.incrementAt parentIdx counts
     else counts

-- | Count distinct external target addresses in a list of calls
-- External = any call where targetInstanceAddress != mcmsInstanceAddress
countDistinctExternalTargets : Text -> [TimelockCall] -> Int
countDistinctExternalTargets mcmsInstanceAddress calls =
  let externalTargets = [c.targetInstanceAddress | c <- calls, c.targetInstanceAddress /= mcmsInstanceAddress]
  in length (dedup externalTargets)

-- | Validate targetCids map size against distinct external targets
-- Prevents DoS by inflating map with irrelevant entries
validateTargetCidsSize : Text -> [TimelockCall] -> Map.Map Text (ContractId MCMSReceiver) -> Update ()
validateTargetCidsSize mcmsInstanceAddress calls targetCids = do
  let distinctTargets = countDistinctExternalTargets mcmsInstanceAddress calls
  let mapSize = Map.size targetCids
  assertMsg ("mcms: targetCids size " <> show mapSize <>
             " exceeds distinct external targets " <> show distinctTargets) $
    mapSize <= distinctTargets

-- | Execute a self-dispatch call (admin operations routed through timelock)
-- This function does NOT perform role checks. This is intentional and safe because:
-- This function is only reachable via two validated paths:
--
--    Path A (Scheduled Execution):
--      ExecuteOp(Proposer, "schedule_batch") → scheduleBatchInternal → [delay passes]
--      → ExecuteScheduledBatch → processCallsLoop → executeSelfDispatch
--      Security: Proposer's merkle proof validated the calls at schedule time.
--
--    Path B (Bypasser Immediate Execution):
--      ExecuteOp(Bypasser, "bypasser_execute_batch") → bypasserExecuteBatchInternal
--      → processCallsLoop → executeSelfDispatch
--      Security: Bypasser's merkle proof validated the calls.
--
-- Supported functions: UpdateMinDelay, BlockFunction, UnblockFunction,
--                      SetConfig, ScheduleBatch, CancelBatch,
--                      PruneSeenHashes, PruneTimelockTimestamps
executeSelfDispatch : MCMS -> TimelockCall -> Update MCMS
executeSelfDispatch mcms call =
  case call.functionName of
    "UpdateMinDelay" ->
      case decodeInt64At call.operationData 0 of
        None -> abort "mcms: failed to decode UpdateMinDelay parameters"
        Some (secs, finalOffset) -> do
          assertMsg "mcms: trailing bytes in UpdateMinDelay operationData" $
            finalOffset == byteCount call.operationData
          assertMsg "mcms: delay must be positive" $ secs > 0
          pure $ mcms with minDelay = seconds secs

    "BlockFunction" ->
      case decodeBlockedFunctionWithOffset call.operationData of
        None -> abort "mcms: failed to decode blocked function parameters"
        Some (bf, finalOffset) -> do
          assertMsg "mcms: trailing bytes in BlockFunction operationData" $
            finalOffset == byteCount call.operationData
          if bf `notElem` mcms.blockedFunctions
          then pure $ mcms with blockedFunctions = bf :: mcms.blockedFunctions
          else pure mcms

    "UnblockFunction" ->
      case decodeBlockedFunctionWithOffset call.operationData of
        None -> abort "mcms: failed to decode blocked function parameters"
        Some (bf, finalOffset) -> do
          assertMsg "mcms: trailing bytes in UnblockFunction operationData" $
            finalOffset == byteCount call.operationData
          pure $ mcms with blockedFunctions = filter (/= bf) mcms.blockedFunctions

    "SetConfig" ->
      case decodeSelfDispatchSetConfigWithOffset call.operationData of
        None -> abort "mcms: failed to decode SetConfig parameters"
        Some ((targetRole, params), finalOffset) -> do
          assertMsg "mcms: trailing bytes in SetConfig operationData" $
            finalOffset == byteCount call.operationData
          let newConfig = MultisigConfig params.signers params.groupQuorums params.groupParents
          validateMultisigConfig newConfig
          let rs = getRoleState targetRole mcms
          let (clearedRoot, clearedMetadata) = if params.clearRoot
                then
                  let opCount = rs.expiringRoot.opCount
                      instanceAddress = RawInstanceAddress.makeText mcms.instanceId mcms.owner
                      epoch = time (date 1970 Jan 1) 0 0 0
                  in ( ExpiringRoot "" epoch opCount
                     , RootMetadata mcms.chainId (makeMcmsId instanceAddress targetRole)
                         opCount opCount True
                     )
                else (rs.expiringRoot, rs.rootMetadata)
          let newRs = rs with
                config = newConfig
                expiringRoot = clearedRoot
                rootMetadata = clearedMetadata
          pure $ setRoleState targetRole newRs mcms

    "ScheduleBatch" ->
      case decodeScheduleBatchParamsWithOffset call.operationData of
        None -> abort "mcms: failed to decode ScheduleBatch parameters"
        Some (params, finalOffset) -> do
          assertMsg "mcms: trailing bytes in ScheduleBatch operationData" $
            finalOffset == byteCount call.operationData
          now <- getTime
          let delay = seconds params.delaySecs
          assertMsg "mcms: delay shorter than minimum required" $ delay >= mcms.minDelay
          forA_ params.calls $ \c ->
            assertMsg ("mcms: function blocked: " <> c.targetInstanceAddress <> ":" <> c.functionName) $
              BlockedFunction c.targetInstanceAddress c.functionName `notElem` mcms.blockedFunctions
          let opId = hashTimelockOpId params.calls params.predecessor params.salt
          assertMsg "mcms: operation already scheduled" $
            not $ Map.member opId mcms.timelockTimestamps
          let readyTime = addRelTime now delay
          pure $ mcms with timelockTimestamps = Map.insert opId readyTime mcms.timelockTimestamps

    "CancelBatch" ->
      case decodeCancelBatchParamsWithOffset call.operationData of
        None -> abort "mcms: failed to decode CancelBatch parameters"
        Some (params, finalOffset) -> do
          assertMsg "mcms: trailing bytes in CancelBatch operationData" $
            finalOffset == byteCount call.operationData
          case Map.lookup params.opId mcms.timelockTimestamps of
            None -> abort "mcms: operation not found in timelock"
            Some readyTime -> do
              assertMsg "mcms: operation already executed" $ readyTime /= doneTimestamp
              pure $ mcms with timelockTimestamps = Map.delete params.opId mcms.timelockTimestamps

    "PruneSeenHashes" ->
      case do
        roleHex <- extractBytes call.operationData 0 1
        roleInt <- decodeUint8 roleHex
        role <- intToRole roleInt
        Some (role, 1)
      of
        None -> abort "mcms: failed to decode PruneSeenHashes parameters"
        Some (targetRole, finalOffset) -> do
          assertMsg "mcms: trailing bytes in PruneSeenHashes operationData" $
            finalOffset == byteCount call.operationData
          now <- getTime
          let rs = getRoleState targetRole mcms
              pruned = Map.filter (> now) rs.seenHashes
              newRs = rs with seenHashes = pruned
          pure $ setRoleState targetRole newRs mcms

    "PruneTimelockTimestamps" -> do
      assertMsg "mcms: PruneTimelockTimestamps operationData must be empty" $
        byteCount call.operationData == 0
      let pruned = Map.filter (/= doneTimestamp) mcms.timelockTimestamps
      pure $ mcms with timelockTimestamps = pruned

    _ -> abort $ "mcms: unknown self-dispatch function: " <> call.functionName

-- ===========================================================================
-- INTERNAL DISPATCH HELPERS (called by ExecuteOp)
-- These perform the core logic without merkle proof verification
-- (proof is already validated by ExecuteOp before dispatching)
-- ===========================================================================

-- | Schedule a batch of operations (called by ExecuteOp for Proposer role)
-- Does NOT verify merkle proof - ExecuteOp already did that
scheduleBatchInternal : Time -> MCMS -> RoleState -> [TimelockCall] -> BytesHex -> BytesHex -> RelTime -> Update (ContractId MCMS)
scheduleBatchInternal now mcms rs calls predecessor salt delay = do
  -- 1. Validate delay meets minimum
  assertMsg "mcms: delay shorter than minimum required" $ delay >= mcms.minDelay

  -- 2. Validate no blocked functions in calls (per-target, matching Aptos)
  forA_ calls $ \call ->
    assertMsg ("mcms: function blocked: " <> call.targetInstanceAddress <> ":" <> call.functionName) $
      BlockedFunction call.targetInstanceAddress call.functionName `notElem` mcms.blockedFunctions

  -- 3. Compute opId
  let opId = hashTimelockOpId calls predecessor salt

  -- 4. Check not already scheduled (on-chain duplicate prevention)
  assertMsg "mcms: operation already scheduled" $
    not $ Map.member opId mcms.timelockTimestamps

  -- 5. Add to map with readyTime + increment proposer opCount
  let readyTime = addRelTime now delay
  let newRs = rs with
        expiringRoot = rs.expiringRoot with opCount = rs.expiringRoot.opCount + 1
  let updated = setRoleState Proposer newRs mcms
  create (updated with timelockTimestamps = Map.insert opId readyTime mcms.timelockTimestamps)

-- | Execute a batch immediately via Bypasser (called by ExecuteOp for Bypasser role)
-- Does NOT verify merkle proof - ExecuteOp already did that
bypasserExecuteBatchInternal : Party -> MCMS -> RoleState -> [TimelockCall] -> Map.Map Text (ContractId MCMSReceiver) -> Update (ContractId MCMS)
bypasserExecuteBatchInternal ownerParty mcms rs calls targetCids = do
  -- 1. Process all calls (self-dispatch inline, external via MCMSReceiver)
  (_, finalMcms) <- processCallsLoop ownerParty targetCids mcms calls

  -- 2. Increment bypasser opCount
  let finalRs = getRoleState Bypasser finalMcms
  let newRs = finalRs with
        expiringRoot = finalRs.expiringRoot with opCount = finalRs.expiringRoot.opCount + 1
  create (setRoleState Bypasser newRs finalMcms)

-- | Cancel a pending operation (called by ExecuteOp for Canceller role)
-- Does NOT verify merkle proof - ExecuteOp already did that
cancelBatchInternal : MCMS -> RoleState -> Text -> Update (ContractId MCMS)
cancelBatchInternal mcms rs opIdToCancel = do
  -- 1. Check operation exists and is pending
  case Map.lookup opIdToCancel mcms.timelockTimestamps of
    None -> abort "mcms: operation not found in timelock"
    Some readyTime ->
      assertMsg "mcms: operation already executed" $ readyTime /= doneTimestamp

  -- 2. Remove from map (cancel) + increment canceller opCount
  let newRs = rs with
        expiringRoot = rs.expiringRoot with opCount = rs.expiringRoot.opCount + 1
  let updated = setRoleState Canceller newRs mcms
  create (updated with timelockTimestamps = Map.delete opIdToCancel mcms.timelockTimestamps)

-- | Process timelock calls: self-dispatch inline, external via MCMSReceiver
-- Uses a map keyed by instanceAddress to support multiple calls to the same contract.
-- After each external call, the map is updated with the new CID returned from MCMSReceiver_Entrypoint.
--
-- Converts typed→untyped map once at start, carries untyped through loop,
-- Converts untyped→typed once at end. This avoids O(k*n) map conversions where k = external calls.
processCallsLoop : Party -> Map.Map Text (ContractId MCMSReceiver) -> MCMS -> [TimelockCall] -> Update (Map.Map Text (ContractId MCMSReceiver), MCMS)
processCallsLoop ownerParty typedCidMap mcms calls = do
  -- Convert typed→untyped once at start
  let untypedCidMap = Map.fromList [(k, coerceContractId v) | (k, v) <- Map.toList typedCidMap]
  -- Process all calls with untyped map
  (finalUntypedMap, finalMcms) <- processCallsLoopInternal ownerParty untypedCidMap mcms calls
  -- Convert untyped→typed once at end
  let finalTypedMap = Map.fromList [(k, coerceContractId v) | (k, v) <- Map.toList finalUntypedMap]
  pure (finalTypedMap, finalMcms)

-- | Internal loop that operates on untyped ContractId maps to avoid per-iteration conversions
processCallsLoopInternal : Party -> Map.Map Text (ContractId ()) -> MCMS -> [TimelockCall] -> Update (Map.Map Text (ContractId ()), MCMS)
processCallsLoopInternal _ cidMap mcms [] = pure (cidMap, mcms)
processCallsLoopInternal ownerParty cidMap mcms (call :: rest) = do
  -- Calculate MCMS's own instanceAddress for comparison
  let mcmsInstanceAddress = RawInstanceAddress.makeText mcms.instanceId mcms.owner

  if call.targetInstanceAddress == mcmsInstanceAddress then do
    -- Self-dispatch: execute internal function (no CID lookup needed)
    newMcms <- executeSelfDispatch mcms call
    processCallsLoopInternal ownerParty cidMap newMcms rest
  else do
    -- External call: lookup CID from map and validate
    -- Coerce untyped CID to typed for fetch/exercise
    targetCid : ContractId MCMSReceiver <- case Map.lookup call.targetInstanceAddress cidMap of
      None -> abort $ "mcms: no contract ID for instance: " <> call.targetInstanceAddress
      Some cid -> pure (coerceContractId cid)

    -- Parse instanceId from the call's targetInstanceAddress (from merkle leaf)
    expectedInstanceId <- case RawInstanceAddress.parseInstanceIdText call.targetInstanceAddress of
      None -> abort "mcms: invalid address format, expected instanceId@partyId"
      Some instId -> pure instId

    -- Parse partyId from the call's targetInstanceAddress (from merkle leaf)
    expectedPartyText <- case RawInstanceAddress.parsePartyIdText call.targetInstanceAddress of
      None -> abort "mcms: invalid address format, expected instanceId@partyId"
      Some partyId -> pure partyId

    expectedParty <- case partyFromText expectedPartyText of
      None -> abort $ "mcms: invalid party in target address: " <> expectedPartyText
      Some p -> pure p

    -- Fetch and validate target contract
    target <- fetch targetCid
    let targetView = view target

    -- Verify the instanceId matches what was signed
    -- (targetView.instanceId is just the identifier, NOT the full address)
    assertMsg ("mcms: instance ID mismatch, expected " <> expectedInstanceId <> " but got " <> targetView.instanceId) $
      targetView.instanceId == expectedInstanceId

    -- Verify fetched contract has exactly one signatory and it matches expected party
    case signatory target of
      [singleSig] ->
        assertMsg "mcms: target signatory does not match expected party" $
          singleSig == expectedParty
      _ -> abort "mcms: target must have exactly one signatory"

    -- Execute call and get updated map from entrypoint
    -- The entrypoint returns a Map with all updated CIDs (including self and any delegated calls)
    returnedCidMap <- exercise targetCid MCMSReceiver_Entrypoint with
      functionName = call.functionName
      operationData = call.operationData
      contractIds = cidMap

    -- Continue with updated map (already untyped from entrypoint)
    -- Note: We trust the returned map because the receiver is a signatory of the owner,
    -- and delegated calls (e.g., OffRamp -> CCIP) need to update multiple CIDs
    processCallsLoopInternal ownerParty returnedCidMap mcms rest
