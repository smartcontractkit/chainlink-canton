module MCMS.MCMSReceiver where

import DA.Map
import DA.Time (RelTime)

interface MCMSReceiver where
    viewtype MCMSReceiverView

    mcmsReceiver_entrypointImpl : ContractId MCMSReceiver -> MCMSReceiver_Entrypoint -> Update MCMSReceiver_EntrypointOutput

    nonconsuming choice MCMSReceiver_Entrypoint : MCMSReceiver_EntrypointOutput
        with
            function : Text
            c : Party
            input : MCMSReceiver_EntrypointInput
        controller c
        do mcmsReceiver_entrypointImpl this self arg

data MCMSReceiver_EntrypointInput = MCMSReceiver_EntrypointInput
    with
        values : Map Text AnyValue
    deriving (Show, Eq)

data MCMSReceiver_EntrypointOutput = MCMSReceiver_EntrypointOutput
    with
        success : Bool
    deriving (Show, Eq)

data MCMSReceiverView = MCMSReceiverView
    with
        owner : Party
    deriving (Show, Eq)

-- | A generic representation of serializable Daml values.
data AnyValue =
    AV_Text Text
  | AV_Int Int
  | AV_Decimal Decimal
  | AV_Bool Bool
  | AV_Date Date
  | AV_Time Time
  | AV_RelTime RelTime
  | AV_Party Party
  | AV_ContractId AnyContractId
  | AV_List [AnyValue]
  | AV_Map (Map Text AnyValue)
  deriving (Show, Eq)

interface AnyContract where viewtype AnyContractView

data AnyContractView = AnyContractView {}

type AnyContractId = ContractId AnyContract

-- Entrypoint input creation and parsing
--------------------------------------

-- | Values that can be converted to AnyValue
class ToAnyValue a where
  toAnyValue : a -> AnyValue

-- | Convenience function to create maps that contain an optional value if it is
-- set. See its use sites for examples.
addOptionalAnyValue : ToAnyValue a => Text -> Optional a -> DA.Map.Map Text AnyValue -> DA.Map.Map Text AnyValue
addOptionalAnyValue _k None m = m
addOptionalAnyValue k (Some value) m = DA.Map.insert k (toAnyValue value) m

-- | Attempt to parse a value from AnyValue.
--
-- If a type implements both `ToAnyValue` and `FromAnyValue` then it must hold that
-- `fromAnyValue (toAnyValue x) = Right x` for all `x`.
class FromAnyValue a where
  fromAnyValue : AnyValue -> Either Text a

-- | Lookup and decode a value within an entrypoint input.
lookupFromInput : FromAnyValue a => MCMSReceiver_EntrypointInput -> Text -> Either Text (Optional a)
lookupFromInput input k = do
  case DA.Map.lookup k input.values of
    None -> pure None
    Some av -> case fromAnyValue av of
      Left err -> fail $ "Failed to decode input value for '" <> k <> "': " <> err
      Right v -> pure (Some v)

-- | Get a value from an entrypoint input, failing if it is not present or fails to parse.
getFromInput : FromAnyValue a => MCMSReceiver_EntrypointInput -> Text -> Either Text a
getFromInput input k = do
  optValue <- lookupFromInput input k
  case optValue of
    None -> fail $ "Missing input entry for: " <> k
    Some v -> pure v

-- | Convenience version of `lookupFromInput` that raises the failure within the `Update`.
lookupFromInputU : FromAnyValue a => MCMSReceiver_EntrypointInput -> Text -> Update (Optional a)
lookupFromInputU input k = either fail pure $ lookupFromInput input k

-- | Convenience version of `getFromInput` that raises the failure within the `Update`.
getFromInputU : FromAnyValue a => MCMSReceiver_EntrypointInput -> Text -> Update a
getFromInputU input k = either fail pure $ getFromInput input k


-- instances for ToAnyValue
---------------------------

instance ToAnyValue Text where
  toAnyValue t = AV_Text t

instance ToAnyValue Int where
  toAnyValue x = AV_Int x

instance ToAnyValue Decimal where
  toAnyValue t = AV_Decimal t

instance ToAnyValue Bool where
  toAnyValue x = AV_Bool x

instance ToAnyValue Date where
  toAnyValue x = AV_Date x

instance ToAnyValue Time where
  toAnyValue x = AV_Time x

instance ToAnyValue RelTime where
  toAnyValue x = AV_RelTime x
instance ToAnyValue Party where
  toAnyValue p = AV_Party p

instance ToAnyValue (ContractId t) where
  toAnyValue x = AV_ContractId $ coerceContractId x

instance ToAnyValue a => ToAnyValue [a] where
  toAnyValue = AV_List . map toAnyValue

instance ToAnyValue MCMSReceiver_EntrypointInput where
  toAnyValue (MCMSReceiver_EntrypointInput values) = AV_Map values


-- FromAnyValue instances
-------------------------

instance FromAnyValue Text where
  fromAnyValue (AV_Text t) = Right t
  fromAnyValue av = Left $ "expected Text, got: " <> show av

instance FromAnyValue Int where
  fromAnyValue (AV_Int i) = Right i
  fromAnyValue av = Left $ "expected Int, got: " <> show av

instance FromAnyValue Decimal where
  fromAnyValue (AV_Decimal i) = Right i
  fromAnyValue av = Left $ "expected Decimal, got: " <> show av

instance FromAnyValue Bool where
  fromAnyValue (AV_Bool b) = Right b
  fromAnyValue av = Left $ "expected bool, got: " <> show av

instance FromAnyValue Date where
  fromAnyValue (AV_Date p) = Right p
  fromAnyValue av = Left $ "expected Date, got: " <> show av

instance FromAnyValue Time where
  fromAnyValue (AV_Time t) = Right t
  fromAnyValue av = Left $ "expected Time, got: " <> show av
instance FromAnyValue RelTime where
  fromAnyValue (AV_RelTime t) = Right t
  fromAnyValue av = Left $ "expected RelTime, got: " <> show av

instance FromAnyValue Party where
  fromAnyValue (AV_Party p) = Right p
  fromAnyValue av = Left $ "expected Party, got: " <> show av

instance Template t => FromAnyValue (ContractId t) where
  fromAnyValue (AV_ContractId av) = Right (coerceContractId av)
  fromAnyValue av = Left $ "expected contract id, got: " <> show av

instance FromAnyValue a => FromAnyValue [a] where
  fromAnyValue (AV_List avs) = mapA fromAnyValue avs
  fromAnyValue av = Left $ "expected list, got: " <> show av

instance FromAnyValue MCMSReceiver_EntrypointInput where
  fromAnyValue (AV_Map values) = Right $ MCMSReceiver_EntrypointInput with values
  fromAnyValue av = Left $ "expected map, got: " <> show av