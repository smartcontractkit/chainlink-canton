module DummyReceiver.Receiver where

import DA.List

import MCMS.MCMSReceiver

template MCMSDummyReceiver
    with 
        owner : Party
        pendingOwner : [Party]

    where
        signatory owner
        observer pendingOwner

        nonconsuming choice MCMSDummyReceiver_ChoiceA : Bool
            with
                input : Text
            controller owner
            do
                create EntrypointEventA with
                    owner = owner
                    input = input
                pure True

        nonconsuming choice MCMSDummyReceiver_ChoiceB : Bool
            with
                input : Int
            controller owner
            do
                create EntryPointEventB with
                    owner = owner
                    input = input
                pure True

        choice MCMSDummyReceiver_TransferOwnership : ContractId MCMSDummyReceiver
            with
                to : Party
            controller owner
            do
                create this with
                    pendingOwner = [to]

        choice MCMSDummyReceiver_AcceptOwnership : ContractId MCMSDummyReceiver
            controller pendingOwner
            do 
                create this with
                    owner = head pendingOwner
                    pendingOwner = []

        interface instance MCMSReceiver for MCMSDummyReceiver where
            view = MCMSReceiverView with
                owner
            
            mcmsReceiver_entrypointImpl self arg = do
                case arg.function of
                    "ChoiceA" -> do
                        -- Convert input args
                        input <- getFromInputU @(Text) arg.input "input"

                        result <- exercise (coerceContractId @_ @MCMSDummyReceiver self) MCMSDummyReceiver_ChoiceA with
                            input = input
                        pure MCMSReceiver_EntrypointOutput with
                            success = result
                    "ChoiceB" -> do
                        input <- getFromInputU @(Int) arg.input "input"

                        result <- exercise (coerceContractId @_ @MCMSDummyReceiver self) MCMSDummyReceiver_ChoiceB with
                            input = input
                        pure MCMSReceiver_EntrypointOutput with
                            success = result
                    "TransferOwnership" -> do
                        to <- getFromInputU @(Party) arg.input "to"
                        result <- exercise (coerceContractId @_ @MCMSDummyReceiver self) MCMSDummyReceiver_TransferOwnership with
                            to = to
                        pure MCMSReceiver_EntrypointOutput with
                            success = True
                    "AcceptOwnership" -> do
                        result <- exercise (coerceContractId @_ @MCMSDummyReceiver self) MCMSDummyReceiver_AcceptOwnership
                        pure MCMSReceiver_EntrypointOutput with
                            success = True
                    _ -> do
                        pure MCMSReceiver_EntrypointOutput with
                            success = False

template EntrypointEventA
    with 
        owner : Party
        input : Text
    where
        signatory owner

template EntryPointEventB
    with
        owner : Party
        input : Int
    where  
        signatory owner