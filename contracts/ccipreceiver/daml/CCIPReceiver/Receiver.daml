module CCIPReceiver.Receiver where

import CCIP.Receiver

template ReceiverImplementation
    with
        owner : Party
        ccip : Party
    where
        signatory owner

        interface instance CCIPReceiver for ReceiverImplementation where
            view = CCIPReceiverView with
                ccip

            ccipReceiver_receiveImpl _self arg = do
                pure CCIPReceiver_ReceiveResult with
                    success = True

