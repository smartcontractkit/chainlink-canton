module Main where

import Daml.Script

import DA.Optional

import CCIP.Receiver
import CCIPReceiver.Receiver

setup = script do
    ccip <- allocateParty "ccip"

    user <- allocateParty "user"

    receiver <- submit user do
        createCmd ReceiverImplementation with
            ccip = ccip
            owner = user
    receiverDisclosure <- fromSome <$> queryDisclosure user receiver

    receiveResult <- submitWithDisclosures ccip [receiverDisclosure] do
        exerciseCmd (toInterfaceContractId @CCIPReceiver receiver) CCIPReceiver_Receive with
            input = CCIPReceiver_ReceiveInput with
                ccip = ccip
                messageId = "0x1234567890"


    pure()