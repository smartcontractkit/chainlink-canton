module Coin.Transfer where

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV1

import Coin.Holding

template CoinTransferInstruction
    with
        holding     : CoinHolding
        newOwner    : Party
        requestedAt : Time
        executeBefore : Time
    where
        signatory (signatory holding)
        observer newOwner

        interface instance TransferInstruction for CoinTransferInstruction where
            view = TransferInstructionView with
                originalInstructionCid = None
                transfer = Splice.Api.Token.TransferInstructionV1.Transfer with
                    sender = holding.view.owner
                    receiver = newOwner
                    amount = holding.view.amount
                    instrumentId = holding.view.instrumentId
                    requestedAt = requestedAt
                    executeBefore = executeBefore
                    inputHoldingCids = []
                    meta = emptyMetadata
                status = TransferPendingReceiverAcceptance
                meta = Splice.Api.Token.MetadataV1.emptyMetadata

            transferInstruction_withdrawImpl _self arg = do
                newCid <- create holding
                pure TransferInstructionResult with
                    output = TransferInstructionResult_Completed with
                        receiverHoldingCids = []
                    senderChangeCids = [toInterfaceContractId newCid]
                    meta = emptyMetadata

            transferInstruction_acceptImpl _self _arg = do
                newCid <- create holding with
                    view.owner = newOwner
                pure TransferInstructionResult with
                    output = TransferInstructionResult_Completed with
                        receiverHoldingCids = [toInterfaceContractId newCid]
                    senderChangeCids = []
                    meta = emptyMetadata

            transferInstruction_updateImpl _self _arg = 
                fail "not implemented"

            transferInstruction_rejectImpl _self _arg = do
                newCid <- create holding
                pure TransferInstructionResult with
                    output = TransferInstructionResult_Completed with
                        receiverHoldingCids = []
                    senderChangeCids = [toInterfaceContractId newCid]
                    meta = emptyMetadata

